				&lt;span style="font-family:Arial"&gt;Effective March 13, 2026, Edward L. Shuttleworth was removed as Director.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:8pt"&gt;&#xD;
