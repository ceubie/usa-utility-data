dding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:1.5pt 1pt 1.5pt 12.25pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;2024 GRC retroactive impacts&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#d4f1f5;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;17&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#d4f1f5;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#d4f1f5;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;124&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#d4f1f5;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;div style="padding-left:12pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;Wildfire mitigation plan&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#ffffff;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;615&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#ffffff;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;530&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;div style="padding-left:12pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;Liability insurance premium&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#d4f1f5;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;(58)&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#d4f1f5;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#d4f1f5;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;(53)&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#d4f1f5;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:1.5pt 1pt 1.5pt 13pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;Other balancing accounts&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#ffffff;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;(219)&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#ffffff;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;4&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;Other regulatory assets, net&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:5.85pt;font-weight:400;line-height:100%;position:relative;top:-3.15pt;vertical-align:baseline"&gt;(2)&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#d4f1f5;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;59&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#d4f1f5;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#d4f1f5;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;72&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#d4f1f5;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#d4f1f5;padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#ffffff;border-bottom:2pt solid #000;padding:1.5pt 1pt 1.5pt 7.75pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;Total&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#ffffff;border-bottom:2pt solid #000000;border-top:1pt solid #000;padding:0 1pt"/&gt;&lt;td style="background-color:#ffffff;border-bottom:2pt solid #000000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;border-bottom:2pt solid #000000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;(733)&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;border-bottom:2pt solid #000000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#ffffff;border-bottom:2pt solid #000000;border-top:1pt solid #000;padding:0 1pt"/&gt;&lt;td style="background-color:#ffffff;border-bottom:2pt solid #000000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;border-bottom:2pt solid #000000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:100%"&gt;(577)&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;border-bottom:2pt solid #000000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#ffffff;border-bottom:2pt solid #000000;border-top:1pt solid #000;padding:0 1pt"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:5.85pt;font-style:italic;font-weight:400;line-height:120%;position:relative;top:-3.15pt;vertical-align:baseline"&gt;(1)&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-style:italic;font-weight:400;line-height:120%"&gt;&#160;&#160;&#160;&#160;At June 30, 2026 and December 31, 2025, the noncurrent portion of regulatory balancing accounts &#8211; net undercollected is $528 and $502, respectively.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:5.85pt;font-style:italic;font-weight:400;line-height:120%;position:relative;top:-3.15pt;vertical-align:baseline"&gt;(2)&#160;&#160;&#160;&#160;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-style:italic;font-weight:400;line-height:120%"&gt;Includes regulatory assets earning a return authorized by applicable regulators, which generally approximates the three-month commercial paper rate.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:21pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;CPUC GRC&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt"&gt;&lt;span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:125%"&gt;A CPUC GRC proceeding is designed to set authorized base revenue requirements that are sufficient to allow us to recover reasonable operating costs and to provide the opportunity to realize authorized rates of return on capital investments. &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:12pt"&gt;&lt;span style="color:#000000;font-family:'Times New Roman',serif;font-size:11pt;font-style:italic;font-weight:700;line-height:109%"&gt;2024 GRC &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt"&gt;&lt;span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:125%"&gt;In December 2024, the CPUC approved an FD in the 2024 GRC that authorizes our revenue requirements for 2024 and attrition year adjustments for 2025 through 2027, inclusively.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt"&gt;&lt;span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:125%"&gt;In December 2025, we filed a petition for modification of the 2024 GRC, seeking to modify the post-test year mechanism for capital related costs. The petition for modification seeks increases of $55 million, $87 million and $79 million to the approved revenue requirements for 2025, 2026 and 2027, respectively. There is no established timeline for the CPUC to act on this filing.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:12pt"&gt;&lt;span style="color:#000000;font-family:'Times New Roman',serif;font-size:11pt;font-style:italic;font-weight:700;line-height:109%"&gt;2024 GRC Track 3&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt"&gt;&lt;span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:125%"&gt;In April 2025, we submitted additional requests to the CPUC in the 2024 GRC, known as Track 3 requests. We submitted a request seeking review and recovery of our WMP costs incurred in 2023 that were in addition to the amounts authorized in the 2019 GRC. In March 2026 and amended in April and May of 2026, we provided supplemental testimony in our Track 3 request for drone inspection and repair program costs incurred from 2019 through 2022 that were transferred from our Track 2 request as a result of the Track 2 FD. The supplemental testimony seeks review and recovery of $659 million of direct WMP and drone inspection and repair program costs. In June 2026, we and three of four intervenors filed an offer of settlement with the CPUC addressing recovery of our 2023 WMP costs and 2019-2022 drone inspection and repair program costs. If approved, the settlement would reduce our requested revenue requirement from $766 million to $621 million. The settlement remains subject to CPUC approval, and we expect to receive an FD in the second half of 2026. Separately, we submitted a request seeking review and recovery of $240 million of PSEP costs incurred from 2014 through 2019. We expect to receive an FD for our Track 3 requests related to our PSEP costs in the second half of 2026.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt"&gt;&lt;span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:125%"&gt;Revenue requirements associated with the Track 3 requests have been recorded in regulatory accounts and any disallowances resulting from Track 3 would be recorded as an expense on the Statements of Operations. We are authorized interim rate recovery of up to 50% of the recorded PSEP regulatory account balance at the end of each year. Such interim rate recovery is subject to refund, contingent on the reasonableness review decision for our Track 3 requests.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:12pt"&gt;&lt;span style="color:#000000;font-family:'Times New Roman',serif;font-size:11pt;font-style:italic;font-weight:700;line-height:109%"&gt;2028 GRC&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt"&gt;&lt;span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:125%"&gt;In June 2026, we filed our 2028 GRC application requesting CPUC approval of test year revenue requirements for 2028 and attrition year adjustments for 2029 through 2031 as follows:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:23.756%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:9.388%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.374%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:9.388%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:9.388%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.374%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:9.388%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:9.388%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.374%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:9.388%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:9.394%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="33" style="background-color:#001689;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:9pt;font-weight:700;line-height:120%"&gt;REQUESTED REVENUE REQUIREMENTS IN 2028 GRC&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="33" style="background-color:#001689;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:8pt;font-style:italic;font-weight:400;line-height:120%"&gt;(Dollars in millions)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:1.5pt 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:115%"&gt;Test year&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="24" style="border-bottom:1pt solid #000;padding:1.5pt 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:115%"&gt;Attrition years adjustment&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="border-top:1pt solid #000;padding:1.5pt 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:115%"&gt;2028&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="6" style="border-top:1pt solid #000;padding:1.5pt 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:115%"&gt;2029&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="border-top:1pt solid #000;padding:0 1pt"/&gt;&lt;td colspan="6" style="border-top:1pt solid #000;padding:1.5pt 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sa