  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;ol style="font-size: 14px; margin: 0pt; padding-left: 0pt;" type="1"&gt;
&lt;li style="margin-left: 36pt; font-family: Arial; font-size: 12pt;"&gt;None&lt;/li&gt;
&lt;li style="margin-left: 36pt; font-family: Arial; font-size: 12pt;"&gt;None&lt;/li&gt;
&lt;li style="margin-left: 36pt; font-family: Arial; font-size: 12pt;"&gt;None&lt;/li&gt;
&lt;li style="margin-left: 36pt; font-family: Arial; font-size: 12pt;"&gt;None&lt;/li&gt;
&lt;li style="margin-left: 36pt; margin-bottom: 10.5pt; font-family: Arial; font-size: 12pt;"&gt;None&lt;/li&gt;
&lt;/ol&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;NOTE A &amp;#x2013; ORGANIZATION&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;, &lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;OPERATIONS&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt; AND BASIS OF PRESENTATION&lt;/span&gt;&lt;span style="font-family:Arial"&gt;:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Organization.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;ET Sabina Pipeline&lt;/span&gt;&lt;span style="font-family:Arial"&gt;, LLC (&amp;#x201C;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;Sabina&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#x201D;) is a &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Texas&lt;/span&gt;&lt;span style="font-family:Arial"&gt; limited liability company. &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Sabina is a&lt;/span&gt;&lt;span style="font-family:Arial"&gt;n indirect&lt;/span&gt;&lt;span style="font-family:Arial"&gt; wholly owned subsidiary of Energy Transfer LP (&amp;#x201C;Energy Transfer&amp;#x201D;).&lt;/span&gt;&lt;span style="font-family:Arial"&gt; Sabina has a 100% sole member interest in Gulf Coast/Products GP Holdings LLC (&amp;#x201C;Holdings&amp;#x201D;) and a 99% limited partnership interest in Buckeye Products Pipe Line, L.P. and Gulf Coast Pipe Line, L.P. with Holdings having an 1% general partner interest in both companies.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; &lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Operations&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;.&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Sabina&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;is &lt;/span&gt;&lt;span style="font-family:Arial"&gt;a &lt;/span&gt;&lt;span style="font-family:Arial"&gt;61&lt;/span&gt;&lt;span style="font-family:Arial"&gt;-mile&lt;/span&gt;&lt;span style="font-family:Arial"&gt; long&lt;/span&gt;&lt;span style="font-family:Arial"&gt;, &lt;/span&gt;&lt;span style="font-family:Arial"&gt;8&lt;/span&gt;&lt;span style="font-family:Arial"&gt;-inch&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;pipeline &lt;/span&gt;&lt;span style="font-family:Arial"&gt;that was placed into service in December 2024. Sabina &lt;/span&gt;&lt;span style="font-family:Arial"&gt;transports natural gas liquids (&amp;#x201C;NGL&amp;#x201D;) from &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Mont Belvieu, Texas&lt;/span&gt;&lt;span style="font-family:Arial"&gt;,&lt;/span&gt;&lt;span style="font-family:Arial"&gt; to Energy Transfer&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#x2019;s&lt;/span&gt;&lt;span style="font-family:Arial"&gt; Nederland Terminal in Jefferson County, Texas&lt;/span&gt;&lt;span style="font-family:Arial"&gt;, &lt;/span&gt;&lt;span style="font-family:Arial"&gt;and &lt;/span&gt;&lt;span style="font-family:Arial"&gt;other domestic markets in the region. &lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Regul&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;ation&lt;/span&gt;&lt;span style="font-family:Arial"&gt;. &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Sabina&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#x2019;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;s&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;NGL&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;transportation activities are subject to regulation by the Federal Energy Regulatory Commission ("FERC") and various state authorities. Regulatory bodies exercise statutory authority over matters such as rates, underlying accounting practices, and rate-making agreements with customers.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Basis of Presentation&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;. &lt;/span&gt;&lt;span style="font-family:Arial"&gt;The financial statements presented herein are prepared in accordance with the accounting requirements of the FERC, as set forth in the applicable Uniform System of Accounts and published accounting releases, which constitute a comprehensive basis of accounting other than accounting principles generally accepted in the United States of America (&amp;#x201C;GAAP&amp;#x201D;).&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;The most significant differences between GAAP and the financial statements presented herein are: &lt;/span&gt;&lt;span style="font-family:Arial"&gt;(1) subsidiaries are reflected on the equity method whereas GAAP requires that all majority-owned subsidiaries be consolidated, (2) property, plant and equipment and related depreciation are reported in accordance with FERC methodology and (3) the classification of certain accounts on the balance sheet, statement of income and &lt;/span&gt;&lt;span style="font-family:Arial"&gt;the &lt;/span&gt;&lt;span style="font-family:Arial"&gt;statement of cash flows&lt;/span&gt;&lt;span style="font-family:Arial"&gt;.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;These interim financial statements should be read in conjunction with the financial statements and notes thereto contained in&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;the&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;Sabina&amp;#x2019;s&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;FERC Form 6 for the year ended December 31, 2025. The financial statements are unaudited, but in the opinion of management, all adjustments have been made that are necessary to fairly state the financial position, results of operations and cash flows for the periods presented. Certain information and notes that would substantially duplicate the disclosures contained in the most recent FERC Form 6 have been omitted.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;NOTE &lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;B&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt; &amp;#x2013; &lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;SUPPLEMENTAL CASH FLOW INFORMATION:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;Accrued capital expenditures &lt;/span&gt;&lt;span style="font-family:Arial"&gt;as of&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;June&lt;/span&gt;&lt;span style="font-family:Arial"&gt; 3&lt;/span&gt;&lt;span style="font-family:Arial"&gt;0&lt;/span&gt;&lt;span style="font-family:Arial"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Arial"&gt;6 and 202&lt;/span&gt;&lt;span style="font-family:Arial"&gt;5&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;w&lt;/span&gt;&lt;span style="font-family:Arial"&gt;ere&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;$&lt;/span&gt;&lt;span style="font-family:Arial"&gt;1&lt;/span&gt;&lt;span style="font-family:Arial"&gt;.&lt;/span&gt;&lt;span style="font-family:Arial"&gt;8&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;million&lt;/span&gt;&lt;span style="font-family:Arial"&gt; and $&lt;/span&gt;&lt;span style="font-family:Arial"&gt;2.1&lt;/span&gt;&lt;span style="font-family:Arial"&gt; million, respectively&lt;/span&gt;&lt;span style="font-family:Arial"&gt;.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
