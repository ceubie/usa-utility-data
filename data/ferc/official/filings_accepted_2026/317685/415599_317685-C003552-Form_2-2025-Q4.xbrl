    <link:footnote xlink:type="resource" xlink:label="HH7D951823EC926EF79D04B2D6C5D732B6" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Due to the nature of the asset amounts previously reported in account 123, corporate management has reclassed these transactions to 146 to adhere to FERC rules supporting these accounts.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH442AE04A0AE7EC47072A0D99E015659E" xlink:to="HH7D951823EC926EF79D04B2D6C5D732B6" order="1" />
