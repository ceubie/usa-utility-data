    <link:footnote xlink:type="resource" xlink:label="HH7A355334260F686391117A52E02730C6" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium; white-space: pre-wrap;">Kinetica Partners, LLC directly owns 100% of the membership interest in Kinetica Energy Express, LLC</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB948FE3F04F8DEE2FC2FB2FBBF271562" xlink:to="HH7A355334260F686391117A52E02730C6" order="1" />
