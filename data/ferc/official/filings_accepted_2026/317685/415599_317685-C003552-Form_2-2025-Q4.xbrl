    <link:footnote xlink:type="resource" xlink:label="HH4156649DCAC0149A992993EF49601152" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Due to the nature of the asset amounts previously reported in account 123, corporate management has reclassed these transactions to 146 to adhere to FERC rules supporting these accounts.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH5329EB07797697EF1DFD6D210A5E73B9" xlink:to="HH4156649DCAC0149A992993EF49601152" order="1" />
