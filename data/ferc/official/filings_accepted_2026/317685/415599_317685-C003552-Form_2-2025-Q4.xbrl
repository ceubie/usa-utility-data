    <link:loc xlink:type="locator" xlink:href="#HH0B9A838EE117D41B29FA3A163DDEB588" xlink:label="HH0B9A838EE117D41B29FA3A163DDEB588" />
    <link:footnote xlink:type="resource" xlink:label="HH7DBE0465CF783245DB172D4E7B5FDF67" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">
          <span style="font-size: 11.0pt;">Amount reflects the reversal of a Q4 2024 paper entry related to linepack gas accounting that was posted in the general ledger in Q2 2025. This adjustment represents a prior-period gas cost correction and does not reflect current-period revenue from services or gas sales</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0B9A838EE117D41B29FA3A163DDEB588" xlink:to="HH7DBE0465CF783245DB172D4E7B5FDF67" order="1" />
