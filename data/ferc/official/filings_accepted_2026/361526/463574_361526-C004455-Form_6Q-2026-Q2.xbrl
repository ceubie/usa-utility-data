  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Ohio Valley Midstream LLC is 5.31% owned by Williams Ohio River Valley Corporation and 59.95% owned by Williams Ohio River Valley LLC. William Ohio Valley Corporation and Williams Ohio River Valley LLC are 100% owned by Williams MLP Operating, LLC. Williams MLP Operating, LLC is 100% owned by Williams Field Services Group, LLC, which is 100% owned by The Williams Companies, Inc.</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span>
          <br/>
        </span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">All above listed companies are incorporated in the state of Delaware.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:112%;text-decoration:underline">Account 75: Unappropriated Retained Income</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">We participate in a cash management program; thus, no cash balances are maintained. Contributions to or from affiliates have been classified as a component of members&#8217; equity because the affiliates have not historically required repayment or repaid amounts owed to us.</span>
      </div>
    </link:footnote>
    <link:loc xlink:type="locator" xlink:label="f-51" xlink:href="#f-51"/>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-51" xlink:to="fn-2" order="1"/>
  </link:footnoteLink>
