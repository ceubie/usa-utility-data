  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HHD16E9C59B43FCF1360D8E46E61230BEF" xlink:label="HHD16E9C59B43FCF1360D8E46E61230BEF" />
    <link:footnote xlink:type="resource" xlink:label="HH0DDA6AB7346AC1637291F9F0D92ABAD1" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: 'Segoe UI';">On March 2, 2026, Phillips 66 Pipeline LLC sold Line 100 California, which had been idled and reclassified to Noncarrier Property in 2024. The net book value recorded in connection with the retirement of the asset was $37,420,522.</span>
        </p>
      </div>
    </link:footnote>
