  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-1" contextRef="c-1">Jayson Antolin</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:TitleOfOfficerWithCustodyOfCorporateBooks id="f-2" contextRef="c-1">Director USPL Accounting</ferc:TitleOfOfficerWithCustodyOfCorporateBooks>
  <ferc:AddressWhereCorporateBooksAreKept id="f-3" contextRef="c-1">700 Louisiana St., Ste 700, Houston, TX 77002-2700</ferc:AddressWhereCorporateBooksAreKept>
  <ferc:StateOfIncorporation id="f-4" contextRef="c-1">DE</ferc:StateOfIncorporation>
  <ferc:IncorporationDate id="f-5" contextRef="c-1">1958-05-28</ferc:IncorporationDate>
  <ferc:GeneralInformationAboutIncorporationOfTheRespondentDescription id="f-6" contextRef="c-1">Columbia Gulf Transmission, LLC was originally incorporated in Delaware on May 28, 1958. The entity was converted to a LLC on March 1, 2013.</ferc:GeneralInformationAboutIncorporationOfTheRespondentDescription>
  <ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription id="f-7" contextRef="c-1">N/A</ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription>
  <ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered id="f-8" contextRef="c-1">The respondent was primarily engaged in the transportation of natural gas through interstate pipeline systems located in Kentucky, Louisiana, Mississippi, and Tennessee. Columbia Gulf also operates co-owned facilities in Texas and Wyoming. Classes of utility service are on page 304.</ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-9" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
