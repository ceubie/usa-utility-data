  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-1" contextRef="c-1">Donald Brown</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:TitleOfOfficerWithCustodyOfCorporateBooks id="f-2" contextRef="c-1">Chief Financial Officer</ferc:TitleOfOfficerWithCustodyOfCorporateBooks>
  <ferc:AddressWhereCorporateBooksAreKept id="f-3" contextRef="c-1">515 N. State Street Suite 1150 Chicago, IL 60654</ferc:AddressWhereCorporateBooksAreKept>
  <ferc:IncorporationDate id="f-4" contextRef="c-1">2002-10-16</ferc:IncorporationDate>
  <ferc:NameOfReceiverOrTrusteeHoldingPropertyOfTheRespondent id="f-5" contextRef="c-1">N/A</ferc:NameOfReceiverOrTrusteeHoldingPropertyOfTheRespondent>
  <ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered id="f-6" contextRef="c-1">Electric - all within the state of California</ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-7" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
