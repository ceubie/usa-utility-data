  <ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock id="HHB507706EE223692FB3CE9DE4D62FC621" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;3. None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock>
  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="HH1C967D5CB7055C23C61684D3A8ADDA65" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;4. None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
  <ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock id="HH2FB9527C1D4BB25D79F1C0C76F5BC95D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;6. &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The following occurred during Q1 2026:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&amp;#160;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;DesertLink &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Transmission,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; LLC refinanced its revolving loan facility, decreasing the revolving loan capacity from $15 million to $10 million authorized in FERC Docket No. ES25-68-000.&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;</ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock>
  <ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock id="HHDB4E63D65FD21AE5462A8FBA840EA717" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;7. &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock>
  <ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock id="HHFB056E8F64ABA7B86B31B31B7725CE20" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;12. Not Applicable &lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;13. The following occurred during Q1 2026:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Joseph Esteves removed as Executive Vice &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;President;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Andrew Groff removed as Senior Vice &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;President;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Ron Fischer removed as &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Secretary;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Richard Roloff &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;removed&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; as Managing Director and appointed Chief Financial &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Officer;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Casey Brandt &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;removed&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; as Assistant Secretary and appointed &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Secretary;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Adam Gassaway appointed Executive Vice President.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 3.7pt; margin-left: 6pt; margin-bottom: 0pt; text-align: center; line-height: 12.45pt; widows: 0; orphans: 0;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;DESERTLINK, LLC&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 3.7pt; margin-left: 6pt; margin-bottom: 0pt; text-align: center; line-height: 12.45pt; widows: 0; orphans: 0;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;NOTES TO FINANCIAL STATEMENTS&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;(1)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Organization&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt; and Basis of Presentation&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 40.5pt; margin-bottom: 7pt; text-indent: -31.5pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;(a)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;Organization&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;DesertLink,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; LLC (the&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Company) was formed on March&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;4, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;2015&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; as a Delaware limited liability company. The Company is owned by DesertLink Holdings, LLC (DesertLink Holdings). &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company was formed to develop, own, and operate transmission in the system operated by the California Independent System Operator (CAISO). On January 11, 2016, CAISO announced that the Company was the approved project sponsor for a new project in CAISO&amp;#8217;s 2013-2014 transmission plan, following a competitive solicitation under CAISO&amp;#8217;s planning process. This new project designated the Company to construct an approximately 60 miles 500-kilovolt (kV) overhead transmission line and other related facilities including a series compensation station (substation) located between a northern terminus at Nevada Power Company&amp;#8217;s &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;(NPC) &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;500 kV Harry Allen substation and a southern terminus at the 500 kV Eldorado substation, operated by Southern California Edison (SCE) (the Project). The transmission line and substation construction include the design, engineering, permitting, procurement of all materials and equipment, construction assembly, installation, commissioning, start-up, testing and completion. Total project costs include work performed by others to complete interconnection facilities at Harry Allen substation, interconnection facilities at Eldorado substation, and circuit breaker upgrades at the Marketplace and McCullough substations operated by the Department of Water and Power of the City of Los Angeles (DWP). The Project was completed and placed into commercial operations on August 12, 2020.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -45.7pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;(b)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;Basis of Presentation&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#8217;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;s financial statements and accompanying notes &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;were&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;prepared&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;in&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accordance&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;with&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;the&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accounting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;requirements&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of the Federal Energy Regulatory Commission (FERC) as set forth in its applicable Uniform System of Accounts&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.9pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;and&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.8pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;published&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.95pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accounting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.8pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;releases,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.9pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;which&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.85pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;is&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.8pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;a&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.9pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;comprehensive&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.9pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;basis&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.85pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.8pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accounting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.85pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;other&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.95pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;than U.S.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;generally&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.6pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accepted&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accounting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.6pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;principles&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;(U.S. GAAP).&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.75pt 6pt 31.5pt; text-align: justify; line-height: 108%; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The primary differences between the Company's FERC financial statements and U.S. GAAP financial statements are:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0.05pt 12.8pt 0pt 54pt; text-indent: -18pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;a)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Accumulated&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;costs&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;removal&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;are&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;reported&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;in&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accumulated&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;depreciation&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;for&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;FERC&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.6pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;reporting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;purposes (U.S. GAAP requires that cost of removal be classified as a regulatory&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;liability&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;);&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.95pt 0pt 54pt; text-indent: -18pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;b)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;There is no current liability classification of the current portion of long-term debt; and deferred financing costs are reported separately in the FERC balance&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.8pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;sheet;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.9pt 0pt 54pt; text-indent: -18pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;c)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The presentation of regulatory assets and regulatory liabilities in the balance sheet under U.S. GAAP requirements differs from FERC &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;requirements;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.9pt 0pt 54pt; text-indent: -18pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;d)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The inclusion of income taxes as a component of the FERC financial statements pursuant to the FERC&amp;#8217;s Policy Statement on Income Tax Allowances, rather than the exclusion of income taxes pursuant to U.S. GAAP due to the Company&amp;#8217;s &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;treatment as a flow through entity; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;and&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.8pt 0pt 54pt; text-indent: -18pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;e)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;A portion of Member&amp;#8217;s equity for U.S. GAAP reporting purposes is included in Accumulated Deferred Income Taxes for FERC reporting purposes. However, the Members pay income taxes on their allocated share of the Company&amp;#8217;s income and for purposes herein, those taxes are calculated using the federal corporate&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;rate.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.8pt 0pt 54pt; line-height: 108%; widows: 0; orphans: 0; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;These financial statements and notes reflect the Company&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#8217;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;s evaluation of events occurring &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;subsequent to&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; the accompanying balance sheet dates through June 1, 2026, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;the date the Company filed this report with FERC.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;(2)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Regulatory Matters&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company has received FERC approval to use a company-specific, forward-looking or projected &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;formula rate&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; framework in setting its transmission rates which are collected by CAISO on the Company&amp;#8217;s behalf. These projected rates are updated annually with forecasted information. Two reconciliations occur annually. The first, a true-up adjustment of the formula rate, calculates the revenue requirement for the prior rate year using actual data. The second, a TRBA adjustment, calculates the difference between revenues due under the effective formula rate and actual revenues received during the trailing October to September period. Both adjustments are incorporated into the projected rates in a subsequent year.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;(3)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Financing Arrangements&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company did not have any long-term debt issuances or principal repayments during the first three months of 2026.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&amp;#160;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;(4)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Member&amp;#8217;s&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt; Equity&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Profit&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, losses and distributions are allocated in accordance with the provisions of the Company&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#8217;s limited l&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;iability agreement.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; In the first quarter of 2026, total equity distributions from the Company were $2.1 million.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
