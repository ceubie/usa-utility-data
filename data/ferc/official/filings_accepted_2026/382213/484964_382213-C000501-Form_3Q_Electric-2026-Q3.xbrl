;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:700;line-height:120%"&gt;Net periodic benefit cost (credit)&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:700;line-height:115%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:700;line-height:115%"&gt;384.7&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:115%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:115%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:115%"&gt;(64.8)&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="border-bottom:1pt solid #000000;border-top:1pt solid #000;padding:0 1pt"/&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:700;line-height:115%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:700;line-height:115%"&gt;(483.7)&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:115%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:115%"&gt;(832.3)&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Prior service costs (credits) and net actuarial losses that have not yet been recognized as a component of net periodic benefit cost are recorded as net regulatory assets.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;UPPCO's funding policy is to contribute at least the minimum amounts that are required to be funded under the Employee Retirement Income Security Act, but not more than the maximum amounts that are currently deductible for income tax purposes.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;NOTE 9 - REGULATORY ENVIRONMENT&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;2026 Rate Review Proceeding&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On May 22, 2026 UPPCO filed, in Case No. U-22032, a request to increase its retail electric rates by $17,257 annually. This filing is based upon a 12-month projected test year ending December 31, 2027.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;The requested increase reflected a 10.55% return on common equity with a regulatory capital structure reflecting a common equity ratio of 50.01%. Key factors contributing to the rate filing included continued infrastructure investments and associated operating expenditures needed to improve the reliability and resiliency of UPPCO&#8217;s distribution system, and general inflation and supply chain pressures.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;An MPSC Order approving this proceeding is expected no later than March 22, 2027.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;2024 Rate Review Proceeding&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On March 21, 2024 UPPCO filed, in Case No. U-21555, a request to increase its retail electric rates by $16,913 annually. This filing is based upon a 12-month projected test year ending December 31, 2025. For the projected test year, excluding the impacts of previously approved revenue offsets of approximately $985.5, the Company proposed a jurisdictional rate relief totaling $15,928.4.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The requested increase reflects a 10.70% return on common equity with a regulatory capital structure reflecting a common equity ratio of 51.52%. Key factors contributing to the rate filing include continued infrastructure investments and associated operating expenditures needed to improve the reliability and resiliency of UPPCO&#8217;s distribution system, and general inflation and supply chain pressures.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On September 26, 2024, MPSC Order No. U-21555 approved a settlement agreement resolving all issues in the rate case. Based on a 12-month projected test year ending December 31, 2025, the Company will adjust rates by $9,000.0 beginning on January 1, 2025. The settlement agreement reflects a 9.86% return on common equity with a regulatory capital structure reflecting a common equity ratio of 50.0% and a jurisdictional rate base value of $372,100.0. &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;2022 Rate Review Proceeding&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On September 8, 2022, in Case No. U-21286, UPPCO filed with the Michigan Public Service Commission (MPSC), a request to increase its retail electric rates by $25,300.0 annually. The filing was based upon a 12-month projected test year ending June 30, 2024. For the projected test year, excluding the impacts of previously ordered revenue offsets of approximately $8,000.0, the Company proposed jurisdictional rate relief totaling $17,300.0.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The requested increase reflected a 10.80% return on common equity with a regulatory capital structure reflecting a common equity ratio of 53.96%. Key factors contributing to the rate filing include continued infrastructure investments and associated operating expenditures needed to improve the reliability and resiliency of UPPCO&#8217;s distribution system. &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On March 24, 2023, MPSC Order No. U-21286 approved the settlement agreement resolving all issues in the rate case. Based on a 12-month projected test year ending June 30, 2024, the Company will adjust rates by $10,800.0 beginning on July 1, 2023. The settlement agreement reflects a 9.9% return on common equity with a regulatory capital structure reflecting a common equity ratio of 51.5% and a jurisdictional rate base value of $334,300.0. Among other things, as part of the approved settlement agreement, the Company was authorized to establish a regulatory asset of $863.1 associated with deferred bad debt expense. UPPCO reduced this amount by $200.0 and donated $200.0 to organizations benefiting low-income customers in UPPCO's service territory. The remaining balance of the regulatory asset of $663.1 will be amortized over a two-year period ending no later than June 30, 2025.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;2023 Depreciation Rate Review&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On December 6, 2023 UPPCO filed, in Case No. U-21513, a request for accounting approval of proposed new depreciation rates that would result in a decrease in annual depreciation rates.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The proposed rates reflect a downward adjustment in depreciation expense for the Company when compared to the depreciation rates approved in its prior depreciation rate review, Case No. U-18467. On May 23, 2024, the MPSC issued an order approving a settlement agreement that resolves all issues in the case. Through this order, the Commission directed UPPCO to implement the new depreciation rates at the time that new rates for general service are implemented following the Company&#8217;s 2024 Rate Review Proceeding, Case No. U-21555. The rates from both of these proceedings took effect on January 1, 2025.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:98.900%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr style="height:12pt"&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;2019 Integrated Resource Plan (&#8220;IRP&#8221;)&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On February 6, 2020, the MPSC approved a settlement agreement in the matter of the application of UPPCO for approval of the Company&#8217;s IRP pursuant to MCL 460.6t in Case No. U-20350. Through approval of the settlement agreement, the Commission determined that the settlement agreement was in the public interest and represented a fair and reasonable resolution to the proceeding. The key terms of the settlement agreement approving a 125 Megawatt (MW) Solar Purchased Power Agreement (&#8220;Solar PPA&#8221;), as well as, two 20 MW Wind Purchased Power Agreements (&#8220;Wind PPAs&#8221;), outlined that UPPCO shall build 62.5 MW of company-owned generation and procure 22.5 MW of renewable PPA in the event that the Solar PPA is cancelled. &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On February 21, 2020, UPPCO and a third party reached a mutual understanding that the Solar PPA automatically terminated on January 8, 2020. Pursuant to the Commission Order approving the settlement &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;agreement, UPPCO issued a Request for Proposal (RFP) for 62.5 MW of company-owned solar and 22.5 MW of renewable PPA in October of 2020. On May 20, 2024, UPPCO purchased Republic Solar for $2,761.5, and intends to continue development of the project,with an expected in-service date of Q4 2027. On May 21, 2024, UPPCO signed a PPA with Copper Country Power LLC wherein a 62.5MW solar electric generating facility known as Groveland Mine Solar Project, which is under development in Dickinson County, MI. The Groveland Mine Solar Project is expected to be in-service by Q4 2028. The MPSC approved the PPA on August 22, 2024.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On November 21, 2024 UPPCO filed an application seeking MPSC approval of two Engineering, Procurement, and Construction contracts necessary to install and commission the Republic Solar Project, siting an anticipated total project cost of $154,900.0. &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On June 12, 2025 the Commission approved the Member Interest Purchase Agreement between&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Upper Peninsula Power Company and Republic Solar Power Holdings, LLC, as well as the two&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Engineering, Procurement, and Construction Agreements for the construction of the Republic&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Solar Project, and related accounting authority.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:112%"&gt;2025 Integrated Resource Plan (&#8220;IRP&#8221;) Filing&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On February 6, 2025, UPPCO filed an application with the Michigan Public Service Commission for approval of its IRP consistent with the requirements included in MCL 460.6t. The analysis and UPPCO&#8217;s preferred course of action (&#8220;PCA&#8221;) is consistent with the attributes and incremental requirements included in the new Michigan energy legislation, namely Public Act 235 and Public Act 231, both of which took effect on February 13, 2024.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;The key components of UPPCO&#8217;s PCA are:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;a&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:12.44pt"&gt;15-year power purchase agreement for 37.5MW of installed solar capacity, relating to the Groveland Mine Solar facility.&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;b&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:12.44pt"&gt;15-year power purchase agreement for 1.5MW of installed hydroelectric capacity, relating to the Cataract Hydroelectric facility.&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;c&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:13pt"&gt;Approval of the application of a financial compensation mechanism applying to all qualifying power purchase agreements, consistent with MCL 460.6t(15).&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;d&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:12.44pt"&gt;Interconnection of the existing Escanaba River hydroelectric facilities to UPPCO&#8217;s distribution system, and the inclusion of these assets within UPPCO&#8217;s rate base.&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;e&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:12.44pt"&gt;Increase energy waste reduction savings targets to 2.17% annually, or whichever savings target can be reasonably and prudently cost-justified by the end of UPPCO&#8217;s next four-year energy waste reduction plan filing.&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;f&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:15.23pt"&gt;Identification and approval of incremental renewable generation resource additions that are necessary to meet the requirements of the Renewable Energy Standard and Clean Energy Standards, both of which are identified by PA 235 of 2023.&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;g&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:12.44pt"&gt;Establishment of a regulatory asset which provides for the full recovery of all IRP-related costs, pursuant to MCL 460.6t and all other applicable laws and MPSC orders.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;On October 9, 2025, the MPSC approved a settlement agreement in the matter of the application of UPPCO for approval of the Company&#8217;s IRP pursuant to MCL 460.6t in Case No. U-21809. Through approval of the settlement agreement, the Commission determined that the settlement agreement was in the public interest and represented a fair and reasonable resolution to the proceeding. The key terms of the settlement agreement included approval of all key components of UPPCO's PCA, with the exception of item (d.), the interconnection of the existing Escanaba River hydroelectric facilities to UPPCO's distribution system, and the inclusion of these assets within UPPCO's rate base. &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;COVID-19, Case No. U-20757&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On April 15, 2020, the Michigan Public Service Commission (&#8220;Commission&#8221;) initiated proceedings in Case No. U-20757 to address pressing issues related to utility service across the state because of the novel coronavirus COVID-19. In its April 15, 2020 Order, the Commission outlined steps it has taken in response to COVID-19 and directed additional actions to protect the public and ensure continuity of service. In its April 15, 2020 Order, the &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Commission authorized rate regulated electric utilities to defer uncollectible or bad debt expense in excess of the amount used to set current rates incurred on or after March 24, 2020. As such, UPPCO is tracking all COVID-19 related costs, as well as other associated extraordinary costs and impacts in anticipation of justifying cost recovery of these items in a future regulatory proceeding, general rate case or other, which is yet to be determined by the Commission.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;In accordance with and in response to the &#8220;Stay Home, Stay Safe&#8221; orders issued by the State of Michigan, UPPCO formally filed two affidavits in Case No. U-20757 affirming compliance with these orders which avail certain protections for the Company&#8217;s various customer groups on April 20, 2020 and on May 28, 2020. More specifically, these protections include (1) temporary suspension of disconnections and late payment charges for low-income customers and seniors, as well as customers medically affected by COVID-19, (2) temporary waiver of deposits and reconnection fees for customers seeking restoration of service while enduring economic hardship due to COVID-19, and (3) offering of certain financial and customer assistance in the form of flexible payment plans while continuing to direct customers to various social service organizations providing assistance to customers.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Case No. U-20757 is a closed docket; however, pursuant to the Commission&#8217;s authorization for UPPCO to establish a regulatory asset which would record uncollectible or bad debt expense in excess of the amount used to set current rates, UPPCO also anticipates justifying for cost recovery all other reasonable and prudent extraordinary costs related to or associated with COVID-19 in a future rate proceeding.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Pursuant to the proposed settlement agreement in Case No. U-21286 filed for Commission review and final ruling, the Company is authorized to establish a regulatory asset of $863.1. UPPCO will reduce this amount by $200.0 and donate $200.0 to organizations benefiting low-income customers in UPPCO's service territory. The remaining balance of the regulatory asset of $663.1 will be amortized over a two-year period ending no later than June 30, 2025. &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;Acquisition of Xcel Energy&#8217;s Michigan Electric Operations&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On September 25, 2026 Upper Peninsula Power Company (&#8220;UPPCO&#8221;) signed a membership interest purchase agreement to acquire the Michigan electric operations of Xcel Energy. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;As described by the membership interest purchase agreement, UPPCO will prepare and file the necessary regulatory applications at the Federal Energy Regulatory Commission and the Michigan Public Service Commission within 45 days.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;If approved by regulators, Xcel Energy&#8217;s 9,000 electric customers residing within the state of Michigan will be served by UPPCO.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock>
  <ferc:DisclosureOfSignificantContingentAssetsOrLiabilitiesTextBlock id="f-36" contextRef="c-1">&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;NOTE 7 - COMMITMENTS AND CONTINGENCIES&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;Unconditional Purchase Obligations and Purchase Order Commitments&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;UPPCO routinely enters into long-term purchase and sale commitments for various quantities and lengths of time. UPPCO has obligations to distribute and sell electricity to its customers and expect to recover costs related to these obligations in future customer rates. The following table shows UPPCO&#8217;s minimum future commitments related to these purchase obligations as of September 30, 2026.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:17.947%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:10.655%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:9.465%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:9.614%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:8.275%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:8.275%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:8.126%"/&gt;&lt;td style=