    <link:footnote xlink:type="resource" xlink:label="fn-5" id="fn-5" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">Includes a credit balance of $130,210 for asset retirement obligation-related accumulated provisions.</link:footnote>
