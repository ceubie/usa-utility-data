&lt;tr style="height: 15pt;"&gt;
&lt;td style="width: 323.2pt; border-top-style: solid; border-top-width: 0.75pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
