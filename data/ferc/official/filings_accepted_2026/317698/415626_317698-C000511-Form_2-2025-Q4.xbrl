&lt;tr style="height: 15pt;"&gt;
&lt;td style="width: 323.2pt; border-top-style: solid; border-top-width: 0.75pt; border-bottom-style: solid; border-bottom-width: 0.75pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 8pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Net Utility Plant (US Dollars)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 55.2pt; border-top-style: solid; border-top-width: 0.75pt; border-bottom-style: solid; border-bottom-width: 0.75pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 8pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; -aw-import: spaces;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
