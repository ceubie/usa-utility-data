&lt;/td&gt;
&lt;td style="width: 119.4pt; padding: 1.75pt 1.25pt; vertical-align: bottom;" colspan="3"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;$&lt;/span&gt;&lt;span style="font-family: Arial;"&gt;577,388&lt;/span&gt;&lt;/p&gt;
