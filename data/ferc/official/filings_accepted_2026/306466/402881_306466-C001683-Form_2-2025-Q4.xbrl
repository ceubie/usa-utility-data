    <link:footnoteArc xlink:type="arc" xlink:from="value61" xlink:to="footnote61" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="61" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote62" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-fareast-font-family: 'Times New Roman'; color: black;">Of the $944,750 in 2025 annual charges billed by the Federal Energy Regulatory Commission this is the portion attributable to transportation services. The remainder is attributed to storage services.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value62" xlink:to="footnote62" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="62" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote64" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18pt; line-height: 115%; font-family: arial, helvetica, sans-serif;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level rather than by discounted, negotiated or recourse rate contracts; therefore, the amounts reported have been allocated to discounted, negotiated or recourse rate contracts based on reasonable assumptions.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value64" xlink:to="footnote64" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="64" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote65" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Use tax is distributed to various accounts based on the accounts charged for the originating invoice.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value65" xlink:to="footnote65" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="65" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote66" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Transferred to Account 211 "Miscellaneous Paid-in Capital." </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value66" xlink:to="footnote66" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="66" />
  </link:footnoteLink>
</xbrli:xbrl>
