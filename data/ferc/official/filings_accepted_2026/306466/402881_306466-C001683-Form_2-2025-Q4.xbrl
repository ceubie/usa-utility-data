    <link:footnoteArc xlink:type="arc" xlink:from="value35" xlink:to="footnote35" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="35" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote39" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Amounts charged by Kinder Morgan, Inc. through shared services are allocated using the modified Massachusetts Formula.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value39" xlink:to="footnote39" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="39" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote41" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">See Page 218, "General Description of Construction Overhead Procedure" for the basis of allocation.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value41" xlink:to="footnote41" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="41" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote42" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 115%; font-family: 'Arial',sans-serif;">Recorded pursuant to Docket No. AI93-5-000 issued on April 23, 1993 (Accounting for Income Taxes).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value42" xlink:to="footnote42" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="42" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote44" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">As of December 31, 2025, we estimate that the following deferred tax balance in Account 282 could be used in the development of jurisdictional recourse rates:</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal">
        </xhtml:p>
        <xhtml:table class="MsoTableGrid" style="border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; mso-yfti-lastrow: yes;">
              <xhtml:td style="width: 553.25pt; border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="738">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Property, Plant, and Equipment</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 20.85pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="28">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border: solid windowtext 1.0pt; border-left: none; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="192">
                <xhtml:p class="MsoNormal" style="text-align: right;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">9,495,719</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
          </xhtml:tbody>
        </xhtml:table>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value44" xlink:to="footnote44" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="44" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote45" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">The value of this gas is based on the current month index price and it is not adjusted to reflect a change in pricing subsequent to the month shipper supplied gas is retained. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value45" xlink:to="footnote45" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="45" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote46" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">A non-revenue recognition method for shipper supplied gas is used which results in accounting entries for net fuel over or under collected rather than separate revenue entries for shipper supplied gas and expenses for gas used in compressors. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value46" xlink:to="footnote46" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="46" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote47" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">This line includes operation and maintenance fuel and known losses due to blowdowns, emergency shut downs, compressor start-ups, flares, line purges, tube inspections and relief valves. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value47" xlink:to="footnote47" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="47" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote48" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Accounts 855, 856 and 863 are debited for gas used for other operational purposes. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value48" xlink:to="footnote48" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="48" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote49" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">Volume subject to ACA surcharge.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value49" xlink:to="footnote49" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="49" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote50" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Volume subject to ACA surcharge.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value50" xlink:to="footnote50" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="50" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote51" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Volume subject to ACA surcharge</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value51" xlink:to="footnote51" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="51" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote52" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Volumes are on a flow month basis.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value52" xlink:to="footnote52" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="52" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote54" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 24px;">Recorded pursuant to Section 6.18 of the General Terms and Conditions of our tariff.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value54" xlink:to="footnote54" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="54" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote55" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table class="MsoTableGrid" style="border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes;">
              <xhtml:td style="width: 161.75pt; border: solid windowtext 1.0pt; border-bottom: solid windowtext 3.0pt; mso-border-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext 3.0pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="216">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Account</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.75in; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 3.0pt; border-right: solid windowtext 1.0pt; mso-border-left-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" colspan="2" valign="bottom" width="264">
                <xhtml:p class="MsoNormal" style="text-align: center;" align="center">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Amount</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 1;">
              <xhtml:td style="width: 161.75pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: 3.0pt; mso-border-left-alt: .5pt; mso-border-bottom-alt: 1.0pt; mso-border-right-alt: .5pt; mso-border-color-alt: windowtext; mso-border-style-alt: solid; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="216">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">142</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 40.5pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext 3.0pt; mso-border-left-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="54">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$<xhtml:span style="mso-spacerun: yes;"></xhtml:span></xhtml:span>
