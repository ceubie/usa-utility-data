              <xhtml:td style="width: 2.0in; border: solid windowtext 1.0pt; border-left: none; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="192">
                <xhtml:p class="MsoNormal" style="text-align: right;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">35,940</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
          </xhtml:tbody>
        </xhtml:table>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value22" xlink:to="footnote22" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="22" />
