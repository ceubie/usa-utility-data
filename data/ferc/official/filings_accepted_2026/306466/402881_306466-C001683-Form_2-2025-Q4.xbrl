              <xhtml:td style="width: 134.95pt; border: solid windowtext 1.0pt; border-left: none; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="180">
                <xhtml:p class="MsoNormal" style="text-align: right;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">116,632</xhtml:span>
                </xhtml:p>
              </xhtml:td>
