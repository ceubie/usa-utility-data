  <ferc:OrderNumber id="HHEF61767369B800E920B4F801110683AD" contextRef="HH61D01FE7DFDB7CB2945ED6A05300B823" decimals="0" unitRef="HHferc_us_Pure">2</ferc:OrderNumber>
  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH46E4FB93DA16C9C89E43636486D1A0D9" xlink:label="HH46E4FB93DA16C9C89E43636486D1A0D9" />
    <link:footnote xlink:type="resource" xlink:label="HHD496695A823EAB2C90DC9C8748A714A5" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoBodyText" style="text-align: justify; line-height: 115%; margin: 8.05pt 17.85pt .0001pt 17.95pt;">On April 22, 2026, the New Jersey Board of Public Utilities ("NJBPU") issued Order 4-22-26-LSA (the &#8220;4/22/26 Order&#8221;) determining that termination of the State Agreement Approach ("SAA") arrangement with PJM was in the best interest of the State. The NJBPU authorized execution of an agreement to terminate the Amended SAA Agreement, which includes the Company&#8217;s designated transmission project.</p>
        <p class="MsoBodyText" style="text-align: justify; line-height: 115%; margin: 8.05pt 17.85pt .0001pt 17.95pt;">Upon FERC acceptance of the termination agreement, PJM terminated the Company&#8217;s Designated Entity Agreement. As a result, the the project will not be completed or placed into service under the previously contemplated development framework.</p>
        <p class="MsoBodyText" style="text-align: justify; line-height: 115%; margin: 8.05pt 17.85pt .0001pt 17.95pt;">In response to these developments, the Company expects to pursue recovery of prudently incurred development and construction costs through FERC processes applicable to transmission projects that are cancelled or abandoned due to factors outside the control of the developer. These costs include the following:</p>
        <p class="MsoBodyText" style="text-align: justify; line-height: 115%; margin: 8.05pt 17.85pt .0001pt 17.95pt;">&#160;</p>
        <table style="border-collapse: collapse; width: 69.589%; height: 120px;" border="1">
          <tbody>
            <tr>
              <td style="width: 50.0013%; text-align: right;">Construction Work in Progress</td>
              <td style="width: 50.0013%; text-align: right;">$ 40,093,595</td>
            </tr>
            <tr>
              <td style="width: 50.0013%;">AFUDC - Debt</td>
              <td style="width: 50.0013%; text-align: right;">6,405,278</td>
            </tr>
            <tr>
              <td style="width: 50.0013%;">AFUDC - Equity</td>
              <td style="width: 50.0013%; text-align: right;">11,431,868</td>
            </tr>
            <tr>
              <td style="width: 50.0013%;">Land (Held for Sale)</td>
              <td style="width: 50.0013%; text-align: right;">52,254,160</td>
            </tr>
            <tr>
              <td style="width: 50.0013%;">Unrecovered Abandoned Plant</td>
              <td style="width: 50.0013%; text-align: right;">$ 110,184,901</td>
            </tr>
          </tbody>
        </table>
        <p class="MsoBodyText" style="text-align: justify; line-height: 115%; margin: 8.05pt 17.85pt .0001pt 17.95pt;">The ultimate outcome, timing, and method of recovery are subject to regulatory proceedings and therefore involve inherent uncertainty. The Company will continue to assess these matters and will recognize any required adjustments in the period in which new information becomes available.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH46E4FB93DA16C9C89E43636486D1A0D9" xlink:to="HHD496695A823EAB2C90DC9C8748A714A5" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>