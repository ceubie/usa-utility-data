    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote3" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p style="language: en-US; line-height: normal; text-indent: 0in; direction: ltr; unicode-bidi: embed; mso-vertical-align-alt: auto; mso-line-break-override: none; word-break: normal; punctuation-wrap: hanging; margin: 0pt 0in 0pt 0in;">
          <xhtml:span style="font-size: 11pt; font-family: Calibri; vertical-align: baseline;">Current year distributions were </xhtml:span>
          <xhtml:span style="font-size: 11pt; font-family: Calibri; vertical-align: baseline;">$8,767,000</xhtml:span>
          <xhtml:span style="font-size: 11pt; font-family: Calibri; vertical-align: baseline;">, which exceeded the positive balance in unappropriated retained earnings by </xhtml:span>
          <xhtml:span style="font-size: 11pt; font-family: Calibri; vertical-align: baseline;">$2,238,329 </xhtml:span>
          <xhtml:span style="font-size: 11pt; font-family: Calibri; vertical-align: baseline;">as of June 30, 2026.  Such excess was recorded against additional paid-in capital.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
