="5" style="background-color:#00497f;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;7,828&lt;/span&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#00497f;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="5" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;7,600&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;div style="text-indent:12pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Right of use assets&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="5" style="background-color:#00497f;border-bottom:1pt solid #000000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;85&lt;/span&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#00497f;border-bottom:1pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="5" style="border-bottom:1pt solid #000000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;37&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-top:1pt solid #000000;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;div style="text-indent:6pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;Total accumulated depreciation&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="5" style="background-color:#00497f;border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;1,381,989&lt;/span&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#00497f;border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="5" style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;1,350,720&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;Total property, plant and equipment&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="5" style="background-color:#00497f;border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;592,504&lt;/span&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#00497f;border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="5" style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;605,741&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:174%"&gt;Property, plant and equipment includes an equity component of allowance for funds used during construction ("AFUDC") of $88 million (December 31, 2024 &#8211; $88.0 million) as a capitalized asset, recorded at cost at December 31, 2025. The recorded value, after accumulated amortization, is $21.4 million (December 31, 2024 &#8211; $22.7 million).&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfAssetsRetirementObligationsAROTextBlock>
  <ferc:DisclosureOfReceivedEnvironmentalCreditsTextBlock id="f-27" contextRef="c-1">&lt;span style="color:#00497f;font-family:'Arial',sans-serif;font-size:17pt;font-weight:400;line-height:115%"&gt;Loans and Borrowings&lt;/span&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:174%"&gt;As at November 28, 2025, Alliance fully repaid the outstanding loan principal of $240 million without prepayment penalty and cancelled the term loan credit facility. The interest expense on loans and borrowings, excluding deferred financing fees, for the year ended December 31, 2025 was $10.5 million (December 31, 2024 - $16.2 million).&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfReceivedEnvironmentalCreditsTextBlock>
  <ferc:DisclosureOfUnsettledRateProceedingsTextBlock id="f-28" contextRef="c-1">&lt;div style="text-align:justify"&gt;&lt;span style="color:#00497f;font-family:'Arial',sans-serif;font-size:17pt;font-weight:400;line-height:174%"&gt;Acquisition and Tax Implications&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:174%"&gt;Prior to April 1, 2024, Alliance was a limited partnership owned by three corporations - EIF US Holdings Inc. ("EIF US") and Pembina U.S. Corporation ("Pembina") each owned 49.5%, and Alliance Pipeline Inc. (&#8220;Alliance Inc.&#8221;) &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:174%"&gt;owned a 1% general partner interest. Alliance Inc. was owned 50% by EIF US and 50% Pembina. Each corporate parent filed income tax returns and paid income taxes in the United States. The corporate parent tax returns included the income tax liabilities incurred by Alliance.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:174%"&gt;On April 1, 2024, Pembina acquired EIF US&#8217;s interest in Alliance and Alliance Inc. and became the sole owner of Alliance. Following the transaction, the income tax liability related to the 49.5% interest in Alliance that was previously owned by EIF US and reported on the U.S. tax return of EIF US will be reported on the U.S. tax return of Pembina (&#8220;Current Transaction&#8221;). &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:174%"&gt;The tax effects of the Current Transaction include adjustments to Account 282 (Accumulated Deferred Income Taxes - Other Property), with an offsetting entry to Account 211 (Miscellaneous Paid-in Capital), to write-off the step-up basis balance of a prior transaction involving the previous corporate parent in 2014 and to reflect the new step-up basis of the current transaction, resulting in a net amount of $30,700,302. Approval for these adjustments was granted by the Chief Accountant on October 25th, 2024 (see Docket AC24-139-000).&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:97.619%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:82.589%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:15.211%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Account 282 ADIT Impact for removal of remaining 2014 Transaction at April 1, 2024&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:middle"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;(31,403,485)&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:middle"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Account 282 ADIT Impact of Transaction at April 1, 2024&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:middle"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;62,103,787&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:middle"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Total&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="border-top:1pt solid #000;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;30,700,302&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#00497f;font-family:'Arial',sans-serif;font-size:17pt;font-weight:400;line-height:115%"&gt;Income Taxes &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The following table reflects the components of the provision for income tax expense:&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:67.054%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:14.822%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt