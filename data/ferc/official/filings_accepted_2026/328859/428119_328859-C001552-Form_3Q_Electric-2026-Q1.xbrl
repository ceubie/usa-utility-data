    <link:footnote xlink:type="resource" xlink:label="fn-30" id="fn-30" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-top:1pt solid #000000;padding:2px 1pt;text-align:left;vertical-align:top">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The APSC approved an accounting order authorizing the Company to create a regulatory asset for certain operations and maintenance costs associated with development and implementation of software and cloud computing projects exceeding $2 million in total project costs. The accounting order allows the Company to recover these costs over the period for which the economic benefit is provided. APSC Docket No. U-5285</span>
            </td>
          </tr>
        </table>
      </div>
    </link:footnote>
