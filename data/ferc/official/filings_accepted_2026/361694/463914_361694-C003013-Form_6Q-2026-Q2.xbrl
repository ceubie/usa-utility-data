  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C003013</ferc:CompanyIdentifier>
  <ferc:ReportYearPeriod id="HH6439FA2135BC4FC31DA52CEDA67ED097" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026/Q2</ferc:ReportYearPeriod>
  <ferc:ReportYear id="HH660FC444EE17A785BFF22BCDC6434313" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4" decimals="0" unitRef="HHferc_us_Pure">2026</ferc:ReportYear>
  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q2</ferc:ReportPeriod>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-09-04</ferc:ReportDate>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p class="MsoNormal" style="line-height: normal;"&gt;1) None&lt;/p&gt;
&lt;p class="MsoNormal" style="line-height: normal;"&gt;2) None&lt;/p&gt;
&lt;p class="MsoNormal" style="line-height: normal;"&gt;3) &lt;span style="font-size: 0.9rem;"&gt;On January 1, 2026, Spire NGL LLC was acquired and became a wholly-owned subsidiary of Phillips 66 Pipeline LLC for a purchase price of $30,290,680. The entity was renamed Blue Line Extension LLC and dissolved effective March 1, 2026. As part of the acquisition, Phillips 66 Pipeline LLC obtained a high vapor liquid (HVL)/natural gas liquids (NGL) transmission pipeline, which includes a roughly 40-mile, 8- to 10-inch diameter segment connecting East St. Louis/Hartford, Illinois, to the Florissant cavern storage facility near St. Louis, Missouri. The accounting treatment of this acquisition was approved by FERC &lt;/span&gt;&lt;span style="font-size: 0.9rem;"&gt;on July 9, 2026,&lt;/span&gt;&lt;span style="font-size: 0.9rem;"&gt;&amp;#160;in Docket AC26-78-000.&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="line-height: normal;"&gt;4) None&lt;/p&gt;
&lt;p class="MsoNormal" style="line-height: normal;"&gt;5) Not Applicable&lt;/p&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p class="MsoNormal" style="font-size: 14px; line-height: normal;"&gt;&lt;strong&gt;Basis of Accounting&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="font-size: 14px; line-height: normal;"&gt;Phillips 66 Pipeline LLC (Company) is subject to regulation by the Federal Energy Regulatory Commission (FERC). The accounting policies followed in preparation of these financial statements generally conform to those required by FERC.&lt;/p&gt;
&lt;p class="MsoNormal" style="font-size: 14px; line-height: normal;"&gt;&lt;strong&gt;Participation in a Cash Management Program&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="font-size: 14px; line-height: normal;"&gt;The Respondent reports a zero cash balance on the Balance Sheet and Statement of Cash Flows due to its participation in a cash management program. Pursuant to FERC Order No. 634-A (68 FR 6 2004, October 31, 2003), as amended by 69 FR 9045 (February 26, 2004), a Cash Management Agreement has been filed with the Commission. The Treasury Services Master Agreement (TSM) became e&lt;span style="color: inherit;"&gt;f&lt;/span&gt;&lt;span style="background-color: inherit; color: inherit;"&gt;fective July 1, 2026. &lt;/span&gt;&lt;span style="background-color: inherit; color: inherit; font-size: inherit;"&gt;under Docket No RM02-14-000.&lt;/span&gt;&lt;span style="background-color: inherit; color: inherit;"&gt; &lt;/span&gt;Under the &lt;span style="font-size: inherit;"&gt;Cash Management or "money pool" programs typically concentrate affiliates' cash assets in joint accounts for the purpose of providing financial flexibility and lowering the cost of borrowing.&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="font-size: 14px; line-height: normal;"&gt;&lt;strong&gt;Asset Purchase&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="font-size: 14px; line-height: normal;"&gt;On January 1, 2026, Spire NGL LLC was acquired and became a wholly-owned subsidiary of Phillips 66 Pipeline LLC for a purchase price of $30,290,680. The entity was renamed Blue Line Extension LLC and dissolved effective March 1, 2026. At the date of acquisition, the carrying value of the assets within carrier property was approximately $6.56 million, the associated accrued depreciation balance was approximately $6.43 million, leaving a net book value of approximately $.13 million. In accordance with the instructions contained in 18 CFR 352.3-11(3 a-b), P66 Pipeline records the purchase price in excess of amounts recorded for the net assets acquired in Account 40, Organization Costs and Other Intangibles. The excess of the purchase price will be amortized through Account 660, Miscellaneous Income Charges over the life of the Carrier Property. Below is the summarized journal entry to record the acquisition and the treatment of the purchase of Spire NGL Inc approved on July 9, 2026 in Docket AC26-78-000&lt;/p&gt;
