    <link:footnote xlink:type="resource" xlink:label="HH1AEDC5E389771C178C45CE3C98DC8191" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: 'Segoe UI'; font-size: medium;">On March 2, 2026, Phillips 66 Pipeline LLC sold Line 100 California, which had been idled and reclassified to Noncarrier Property in 2024. The net book value recorded in connection with the retirement of the asset was $37,420,522.</span>
        </p>
      </div>
    </link:footnote>
