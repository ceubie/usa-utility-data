  <ferc:RespondentLegalName id="f-41" contextRef="c-1">Potomac Electric Power Company</ferc:RespondentLegalName>
  <ferc:ReportYear id="f-42" contextRef="c-1" decimals="0" unitRef="u-1">2026</ferc:ReportYear>
  <ferc:ReportPeriod id="f-43" contextRef="c-1">Q2</ferc:ReportPeriod>
  <ferc:ReportDate id="f-44" contextRef="c-1">2026-06-30</ferc:ReportDate>
  <ferc:ReportDate id="f-45" contextRef="c-1">2026-06-30</ferc:ReportDate>
