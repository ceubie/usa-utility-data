  <ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock id="f-34" contextRef="c-1">&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;14. Pepco participates in a cash management program. As of June 30, 2026, Pepco's proprietary capital ratio is greater than 30 percent.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock>
  <ferc:RespondentLegalName id="f-35" contextRef="c-1">Potomac Electric Power Company</ferc:RespondentLegalName>
  <ferc:ReportYear id="f-36" contextRef="c-1" decimals="0" unitRef="u-1">2026</ferc:ReportYear>
  <ferc:ReportPeriod id="f-37" contextRef="c-1">Q2</ferc:ReportPeriod>
