    <link:footnote xlink:type="resource" xlink:label="HHCBFECBA828FA13C84A63F15A7F5CF7C9" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="border-collapse: collapse; width: 539px; height: 87px;" border="0" width="480" cellspacing="0" cellpadding="0">
