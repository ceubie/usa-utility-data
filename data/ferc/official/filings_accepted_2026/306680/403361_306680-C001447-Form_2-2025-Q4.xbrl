    <link:footnote xlink:type="resource" xlink:label="HHAF6B3D1E425EB41699F1847A5D198D0B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>GPPL has no storage facilities, therefore account 117.4 is used to record OBA imbalances</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH9BC7D5A92B59A328BEC0774C740FDFF5" xlink:to="HHAF6B3D1E425EB41699F1847A5D198D0B" order="1" />
