row';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt; 3.6&lt;/span&gt;&lt;/p&gt;
