  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HHBFD61EBE312D5B5B0CB15B2F5EFEF4D5" xlink:label="HHBFD61EBE312D5B5B0CB15B2F5EFEF4D5" />
    <link:footnote xlink:type="resource" xlink:label="HH4BB14417F63BE33D422C6E503F06F23A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Amended to reflect 50 Year Depreciable life (2% Depreciation Rate) as approved by FERC to correct an error through the use of Account 439 Adjustments to Retained Earnings. See Note 2 - Summary of Significant Accounting Policies for more details.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHBFD61EBE312D5B5B0CB15B2F5EFEF4D5" xlink:to="HH4BB14417F63BE33D422C6E503F06F23A" order="1" />
