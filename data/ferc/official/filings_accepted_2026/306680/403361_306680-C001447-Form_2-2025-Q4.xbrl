&lt;/td&gt;
&lt;td style="width: 133.7pt; padding: 0.5pt 5.9pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 12pt;"&gt;&lt;span style="font-family: Aptos;"&gt;December 31, 2024 Prior Period Adjustment&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 19.75pt; padding: 0.5pt 5.9pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 12pt;"&gt;&lt;span style="font-family: Aptos;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 80.2pt; padding: 0.5pt 5.9pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: Aptos;"&gt;As Adjusted&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 324.6pt; padding: 0.5pt 5.9pt; vertical-align: middle; background-color: #a6c9ec;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;Accum&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;. Provision for&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;Depr&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;., Amort.,&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;Depl&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;. (108, 111)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 68.25pt; padding: 0.5pt 5.9pt; vertical-align: middle; background-color: #a6c9ec;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;$&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Aptos Narrow';"&gt; 320.9&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 133.7pt; padding: 0.5pt 5.9pt; vertical-align: middle; background-color: #a6c9ec;"&gt;
