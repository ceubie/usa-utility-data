    <link:footnote xlink:type="resource" xlink:label="fn-4" id="fn-4" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="text-align:center">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:99.702%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:18.900%"/>
            <td style="width:0.1%"/>
            <td style="width:1.0%"/>
            <td style="width:18.900%"/>
