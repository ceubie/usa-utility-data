  <ferc:DepreciationExpense id="HH75B64107107EB616E7AD7340F75D0ED1" contextRef="HH1C984E73C6B25376DEFA7AB1BF4F00EB" decimals="0" unitRef="HHferc_us_Currency">7251818</ferc:DepreciationExpense>
  <ferc:OperationExpense id="HH5AFA830980DC40FFA321A65035364270" contextRef="HH1C984E73C6B25376DEFA7AB1BF4F00EB" decimals="0" unitRef="HHferc_us_Currency">1484509</ferc:OperationExpense>
  <ferc:ProvisionForDeferredIncomeTaxesCreditUtilityOperatingIncome id="HH26F3A98DA0B37D247DC9AC12011C5B14" contextRef="HH1C984E73C6B25376DEFA7AB1BF4F00EB" decimals="0" unitRef="HHferc_us_Currency">3378297</ferc:ProvisionForDeferredIncomeTaxesCreditUtilityOperatingIncome>
  <ferc:ProvisionsForDeferredIncomeTaxesUtilityOperatingIncome id="HHF84A2CAA7C419E93C77480D5FBA7DFD9" contextRef="HH1C984E73C6B25376DEFA7AB1BF4F00EB" decimals="0" unitRef="HHferc_us_Currency">596820</ferc:ProvisionsForDeferredIncomeTaxesUtilityOperatingIncome>
