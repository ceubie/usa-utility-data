    <ferc:AccountsPayableToAssociateCompanies id="f-564" contextRef="c-207" unitRef="u-02" decimals="0">38065424</ferc:AccountsPayableToAssociateCompanies>
    <ferc:AccountsPayableToAssociateCompanies id="f-565" contextRef="c-205" unitRef="u-02" decimals="0">492453</ferc:AccountsPayableToAssociateCompanies>
    <ferc:AccountsPayableToAssociateCompanies id="f-566" contextRef="c-210" unitRef="u-02" decimals="0">62152</ferc:AccountsPayableToAssociateCompanies>
    <ferc:AccountsPayableToAssociateCompanies id="f-567" contextRef="c-204" unitRef="u-02" decimals="0">653050</ferc:AccountsPayableToAssociateCompanies>
    <ferc:AccountsPayableToAssociateCompanies id="f-568" contextRef="c-211" unitRef="u-02" decimals="0">73</ferc:AccountsPayableToAssociateCompanies>
    <ferc:MiscellaneousCurrentAndAccruedLiabilities id="f-573" contextRef="c-217" unitRef="u-02" decimals="0">949136</ferc:MiscellaneousCurrentAndAccruedLiabilities>
    <ferc:MiscellaneousCurrentAndAccruedLiabilities id="f-574" contextRef="c-215" unitRef="u-02" decimals="0">24792496</ferc:MiscellaneousCurrentAndAccruedLiabilities>
