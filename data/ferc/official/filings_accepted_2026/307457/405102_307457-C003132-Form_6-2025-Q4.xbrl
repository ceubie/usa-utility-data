    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote8" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Effective January 26, 2026, Meli Armstrong resigned as Vice President and was replaced by Howard E. Hamilton, Jr.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value8" xlink:to="footnote8" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="8" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote14" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="text-align: justify;">
          <xhtml:span style="font-size: 18.0pt; line-height: 115%; font-family: 'Arial',sans-serif;">Pursuant to the Federal Energy Regulatory Commission's Order Denying Petition and Granting Remedies issued November 20, 2025, we have included in Page 301, in revenue account 210, and on Page 700, line 10, the amount of $ 779,577 related to correcting invoices from March 1, 2022 to September 30, 2024.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
