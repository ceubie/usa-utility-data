    <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="f-338" contextRef="c-02">&lt;div class="Section_1"&gt; 			&lt;p style="margin-top: 0; margin-left: 45pt; margin-bottom: 0; text-indent: -27pt; line-height: normal; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Tahoma"&gt;1.&lt;/span&gt;&lt;span style="width: 18.51pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: Tahoma"&gt;None&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 45pt; margin-bottom: 0; text-indent: -27pt; line-height: normal; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Tahoma"&gt;2.&lt;/span&gt;&lt;span style="width: 18.51pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: Tahoma"&gt;None&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 45pt; margin-bottom: 0; text-indent: -27pt; line-height: normal; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Tahoma"&gt;3.&lt;/span&gt;&lt;span style="width: 18.51pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: Tahoma"&gt;None&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 45pt; margin-bottom: 0; text-indent: -27pt; line-height: normal; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Tahoma"&gt;4.&lt;/span&gt;&lt;span style="width: 18.51pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: Tahoma"&gt;None&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 45pt; margin-bottom: 0; text-indent: -27pt; line-height: normal; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Tahoma"&gt;5.&lt;/span&gt;&lt;span style="width: 18.51pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: Tahoma"&gt;N/A&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt; line-height: 108%; font-size: 10pt"&gt; 				&lt;span style="font-family: Tahoma"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 		&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
    <ferc:NotesToFinancialStatementsTextBlock id="f-340" contextRef="c-02">&lt;div&gt;&lt;div class="Section_1"&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal; font-size: 10pt"&gt;&lt;br /&gt;&lt;/p&gt; 		&lt;/div&gt;&lt;div class="Section_1"&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span style="font-weight: bold"&gt;The Company&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span&gt;Panola Pipeline Company, LLC (&amp;quot;Panola&amp;quot;) is a Texas limited liability company.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Panola is owned 70% by Enterprise Midstream Companies LLC (Enterprise Midstream), a Texas limited liability company, 15% by MarkWest Energy Operating Company, L.L.C., a Texas limited liability company and 15% by Voyager Panola HoldCo, LLC, a Delaware limited liability company.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Enterprise Midstream is an indirect wholly owned subsidiary of Enterprise Products Operating LLC (EPOLLC), a Texas limited liability company and the operator of Panola.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span style="font-weight: bold"&gt;Description of the Property&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span&gt;Panola is an approximately 250-mile natural gas liquids (&amp;quot;NGL&amp;quot;) pipeline located entirely within the State of Texas that provides pipeline transportation services for mixed NGLs.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The pipeline receives the NGLs at receipt points in east Texas and transports to delivery points in the Mont Belvieu, Texas area.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;An expansion project of 10&amp;quot; pipeline between Carthage and Lufkin, Texas loops the existing Panola system.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The expansion converted an existing connection with West Texas LPG Pipeline at Lufkin, Texas into a delivery point that offers access to fractionation facilities in Louisiana.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span style="font-weight: bold"&gt;Basis of Accounting&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The accounting policies followed in preparation of these financial statements conform to those required by FERC.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Financial statements are prepared on the accrual basis of accounting.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Panola property, plant and equipment assets are recorded at original cost.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span style="font-weight: bold"&gt;Revenue Recognition&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span&gt;Revenues are derived from transportation of NGLs under tariffs regulated by the FERC and the Railroad Commission of Texas.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Panola invoices shippers upon receipt of product into the pipeline but only recognizes revenues upon product delivery.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Revenues billed for product not yet delivered as of the balance sheet date are deferred until such time as the product is delivered.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span&gt;During 2025, Panola rebilled shippers for under-recovery resulting from the vacated January 20, 2022 rehearing order (Docket No. RM20-14-001) in the amount of $764,536.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt; (See Commission's order issued on November 20, 2025 (Docket No. RM93-11-003, paragraph 37, footnote 111)).&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt; These revenues are reported in account 645 &amp;quot;Unusual or Infrequent Items (credit)&amp;quot; on page 114.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span style="font-weight: bold"&gt;Income Taxes&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span&gt;Panola is a limited liability company that passes income tax liability through the company to its members and, with the exception of the Texas Franchise Tax, if applicable, does not recognize this liability on the company's financial statements.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;For purposes of calculating the income tax expense and liability for the annual cost of service (to be shown on page 700 of the Annual Report), Panola employs FERC's Policy Statement on Income Tax Allowances.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span style="font-weight: bold"&gt;Employees&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span&gt;Panola has no employees of its own.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;All operations, management and administrative functions are performed by employees of Enterprise Products Company on behalf of EPOLLC, as operator.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;EPOLLC is reimbursed for management and administrative functions under the terms of an operating agreement.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 		&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
