        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-403_lbl" order="0" xlink:to="ft-403_47153_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-450_lbl" order="0" xlink:to="ft-450_47356_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-451_lbl" order="0" xlink:to="ft-451_46978_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1220_lbl" order="0" xlink:to="ft-1220_47040_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1223_lbl" order="0" xlink:to="ft-1223_47039_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1230_lbl" order="0" xlink:to="ft-1230_47041_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1234_lbl" order="0" xlink:to="ft-1234_47038_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1303_lbl" order="0" xlink:to="ft-1303_47340_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1394_lbl" order="0" xlink:to="ft-1394_47341_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2232_lbl" order="0" xlink:to="ft-2232_47442_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2826_lbl" order="0" xlink:to="ft-2826_47145_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2827_lbl" order="0" xlink:to="ft-2827_47144_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2831_lbl" order="0" xlink:to="ft-2831_47147_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2838_lbl" order="0" xlink:to="ft-2838_47146_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2839_lbl" order="0" xlink:to="ft-2839_47148_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2840_lbl" order="0" xlink:to="ft-2840_47149_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2842_lbl" order="0" xlink:to="ft-2842_47150_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3088_lbl" order="0" xlink:to="ft-3088_47313_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3093_lbl" order="0" xlink:to="ft-3093_47315_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3201_lbl" order="0" xlink:to="ft-3201_47353_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3264_lbl" order="0" xlink:to="ft-3264_47358_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3281_lbl" order="0" xlink:to="ft-3281_47359_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3293_lbl" order="0" xlink:to="ft-3293_47369_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3372_lbl" order="0" xlink:to="ft-3372_47437_lbl" />
        <link:footnote xlink:label="ft-21_46954_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="color: rgba(0, 0, 0, 1); font-family: sans-serif; font-size: medium; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal"><b><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 278 Line No.: 2 Column: a</span></span></em></b></p><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Pursuant to Section 22 of the General Terms and Conditions of MRT's FERC Gas Tariff, Seventh Revised Volume No.1, <span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none">Docket No. RP24-1102-000, as approved by FERC's order issued on October 17, 2024 and </span>Docket No. RP26-23-000, as approved by FERC's order issued on October 20, 2025.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-205_46950_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource">Original value: N</link:footnote>
        <link:footnote xlink:label="ft-238_46951_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><b><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 278        Line No.: 1        Column: a</span></span></em></b></p><p><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Pursuant to Section 34 of the General Terms and Conditions ("GT&amp;C") of MRT's FERC Gas Tariff, Seventh Revised Volume No.1, Docket No. RP26-124-000, MRT is required to credit to eligible firm </span></span><span style="font-size: 12pt; font-family: Arial, Helvetica, sans-serif; background-color: unset; text-align: inherit">customers penalty revenues collected during the Penalty Base Period. The annual base period runs August 1 through July 31. Under the </span><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">terms of Section 34 of the GT&amp;C, MRT is not required to calculate revenue credits until the Total Penalty Crediting Revenues exceed </span></span><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">$250,000.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-373_47355_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: medium; color: rgba(51, 51, 51, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold"><em>Schedule Page: 220 Line No.: 1 Column: c</em></b></span></span></p><p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; font-family: sans-serif; font-size: medium; color: rgba(51, 51, 51, 1); background-color: rgba(255, 255, 255, 1)"><span><span style="font-size: 12pt">MRT utilizes the fixed asset method to account for system balancing gas.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-403_47153_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 350 Line No.: 1 Column: e</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Account 186, Miscellaneous deferred debits was used to record deferred charges for regulatory commission expense. This footnote applies to columns (e), (i) and (l), lines 1 and 2.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-450_47356_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: medium; color: rgba(51, 51, 51, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold"><em>Schedule Page: 220 Line No.: 5 Column: e</em></b></span></span></p><p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; font-family: sans-serif; font-size: medium; color: rgba(51, 51, 51, 1); background-color: rgba(255, 255, 255, 1)"><span><span style="font-size: 12pt">MRT utilizes the fixed asset method to account for gas owed to the system.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-451_46978_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(51, 51, 51, 1); background-color: rgba(255, 255, 255, 1); font-size: medium; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold"><em>Schedule Page: 220 Line No.: 5 Column: b</em></b></span></span></p><p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(51, 51, 51, 1); background-color: rgba(255, 255, 255, 1); font-size: medium; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Non-current inventory represents the cost of the recoverable quantity of gas necessary to maintain pressure and deliverability for each storage facility. Current inventory represents the value of company-owned gas which is in excess of the quantity classified as non-current. The fixed asset method is used to report storage.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1220_47040_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 520 Line No.: 20 Column: c</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif; font-size: 16px">For the purpose of the Annual Charge Adjustment ("ACA") calculation, the throughput volume is 349,706,326 Dth as represented on line 20. No additional volumes are needed to calculate the total volumes eligible for the ACA surcharge.</span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1223_47039_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 520 Line No.: 27 Column: c</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">This represents gas delivered to storage to support system management activity. This footnote also applies to column (d).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1230_47041_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: medium; color: rgba(51, 51, 51, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold"><em>Schedule Page: 520 Line No.: 12 Column: c</em></b></span></span></p><p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: medium; color: rgba(51, 51, 51, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">This represents gas withdrawn from storage to support system management activity. This footnote also applies to column (d).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1234_47038_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-family: sans-serif; font-size: medium; font-style: normal; text-indent: 0; white-space: normal"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 520 Line No.: 29.1 Column: c</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Other Deliveries and Gas Used for Other Operations include in-kind deliveries fuel and gas losses, shrinkage and other non-compressor fuel. This footnote also applies to line 29.1, column (d).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1303_47340_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-size: 16px; font-style: normal; text-indent: 0; white-space: normal; font-family: Arial, Helvetica, sans-serif"><em>Schedule Page: 521 Line No.: 7 Column: f</em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-size: 12pt"><em><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-size: 16px; font-style: normal; text-indent: 0; white-space: normal; font-family: Arial, Helvetica, sans-serif"><em><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; display: inline !important">The basis for valuing the gas reported on columns (f), (g) and (h) is the weighted average rate for system gas.</span></em></b></em></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1394_47341_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><em><b style="font-weight: bold">Schedule Page: 521 Line No.: 22 Column: i</b></em></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-size: 16px; font-style: normal; text-indent: 0; white-space: normal; font-family: Arial, Helvetica, sans-serif"><em><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-size: 16px; font-style: normal; text-indent: 0; white-space: normal; font-family: Arial, Helvetica, sans-serif"><em><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; display: inline !important">Gas used for other operational purposes includes blow-downs and other operational uses of gas other than compressor station fuel, and in-kind volumes of gas delivered to other pipelines in accordance with applicable transportation contracts. This footnote applies to all three months.</span></em></b></em></b></p></div></link:footnote>
        <link:footnote xlink:label="ft-2232_47442_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-style: normal; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 219 Line No.: 17.1 Column: c</span></span></em></b></p><p style="cursor: auto"><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="328" height="71" style="min-width: 0; max-width: 1023px; min-height: 0; width: 328px; height: 71px" alt="" /> </p></div></link:footnote>
        <link:footnote xlink:label="ft-2826_47145_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 336 Line No.: 10 Column: b</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">General Plant is depreciated on a straight-line basis, per assigned FERC rates.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2827_47144_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 336 Line No.: 5 Column: b</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Underground Storage Plant is depreciated on composite allocation basis, per assigned FERC rates. This footnote also applies to line 5, column (e).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2831_47147_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 338 Line No.: 7 Column: b</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">The depreciation plant basis reflects a balance as of 12/31/2025. This footnote also applies to lines 4, 8 and 9, column (b).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2838_47146_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 16px">Schedule Page: 338 Line No.: 4 Column: c</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 16px">The applied depreciation rates for Underground Gas Storage facilities range from 1.73% to 2%.<span> <span> </span></span></span></span><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Negative salvage is 0.12%.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2839_47148_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 338 Line No.: 7 Column: c</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">The applied depreciation rates for Transmission facilities range from 1.64% to 5.95%. Negative salvage is 0.3%.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2840_47149_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 338 Line No.: 8 Column: c</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">The applied rates for the General Plant facilities range from 3.75% to 25%.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2842_47150_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 338 Line No.: 9 Column: c</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">The applied depreciation rates for Intangible assets range from 6.67% to 30%.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3088_47313_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold; color: rgba(51, 51, 51, 1); font-size: 14px; text-align: inherit; text-indent: 0; white-space: normal; background-color: initial; font-style: italic"><em><span style="font-size: 12pt">Schedule Page: 120    Line No.: 16.1    Column: b</span></em></b></span></p><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1921px; min-height: 0" alt="" />   </p></div></link:footnote>
        <link:footnote xlink:label="ft-3093_47315_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 218 Line No.: 5 Column: f</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">The reported rate is a calculated black-box settlement rate from MRT's last rate case proceeding Docket No. RP18-923-000.</span></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3201_47353_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 358 Line No.: 2 Column: a</b></span></span></p><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1580px; min-height: 0" alt="" /></p><p><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3264_47358_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-style: normal; text-align: left; text-indent: 0; white-space: normal; font-family: Arial, Helvetica, sans-serif; font-size: 16px; background-color: rgba(255, 255, 255, 1)">Schedule Page: 358 Line No.: 22 Column: b</b></p><p> <img src="data:image/gif;base64," class="e-rte-image e-imginline" width="856" height="278" style="min-width: 0; max-width: 1410px; min-height: 0" alt="" /></p><p><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3281_47359_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><em><b style="font-weight: bold">Schedule Page: 521 Line No.: 43.1 Column: i</b></em></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-size: 16px; font-style: normal; text-indent: 0; white-space: normal; font-family: Arial, Helvetica, sans-serif"><em><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-size: 16px; font-style: normal; text-indent: 0; white-space: normal; font-family: Arial, Helvetica, sans-serif"><em><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; display: inline !important">Cumulative volumes of in-kind gas owed to or due from shippers are revalued to market price each month. The dollars reported on this page reflect the net valuation for the current month volumes and exclude the revaluation adjustment. This footnote also applies to line 55.1, column (i).</span></em></b></em></b></p></div></link:footnote>
        <link:footnote xlink:label="ft-3293_47369_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)">Schedule Page: 358 Line No.: 12 Column: b</b><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"><br /></b></p><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="847" height="234" style="min-width: 0; max-width: 1410px; min-height: 0" alt="" /> <br /></p><p> <br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3372_47437_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 518 Line No.: 20 Column: a</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Date range: 1/28/2026 - 1/30/2026</span></span></p></div></link:footnote>
