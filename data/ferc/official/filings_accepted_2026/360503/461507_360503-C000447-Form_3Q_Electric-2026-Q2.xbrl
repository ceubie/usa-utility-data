ottom"&gt;&lt;span style="color:#000000;font-family:'Helvetica Condensed Black',sans-serif;font-size:8pt;font-weight:700;line-height:120%"&gt;&#8212;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Helvetica Condensed Black',sans-serif;font-size:8pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="2" style="padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Helvetica Condensed Black',sans-serif;font-size:8pt;font-weight:700;line-height:120%"&gt;9,525&lt;/span&gt;&lt;span style="color:#000000;font-family:'Helvetica Condensed Black',sans-serif;font-size:8pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="2" style="padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Helvetica Condensed',sans-serif;font-size:8pt;font-weight:400;line-height:120%"&gt;&#8212;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="2" style="padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Helvetica Condensed',sans-serif;font-size:8pt;font-weight:400;line-height:120%"&gt;12,900&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Helvetica Condensed',sans-serif;font-size:8pt;font-weight:400;line-height:120%"&gt;Cleco Securitization I&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:1.5pt 0 1.5pt 1