&lt;td style="width: 7.04157%; height: 20px; text-align: center;"&gt;&lt;font style="width: 7.04157%; height: 20px; font-family: calibri; font-size: 14pt;"&gt;11.6%&lt;/font&gt;&lt;/td&gt;
&lt;td style="width: 5.92553%; height: 20px; text-align: center;"&gt;&lt;font style="width: 5.92553%; height: 20px; font-family: calibri; font-size: 14pt;"&gt;5.0%&lt;/font&gt;&lt;/td&gt;
