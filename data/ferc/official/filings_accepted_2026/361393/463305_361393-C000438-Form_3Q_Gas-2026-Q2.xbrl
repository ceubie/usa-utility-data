  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH7657DAE6E44E9662B073047DA048E4E9" xlink:label="HH7657DAE6E44E9662B073047DA048E4E9" />
    <link:footnote xlink:type="resource" xlink:label="HHC644FDCFCCE7C1BFAEC65BAB59A66353" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">Iroquois charges fuel-in-kind based on Monthly Measurement Variance/Fuel Use Factors. Over/under collections of natural gas are trued-up through adjustments to the Monthly Measurement Variance/Fuel Use Factors that Iroquois charges its customers in future months pursuant to Section 2.27 of the General Terms and Conditions of Iroquois FERC Gas Tariff. As a result, no cash is transferred between Iroquois and Iroquois shippers for fuel and measurement variances including Lost and Unaccounted for Gas.</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7657DAE6E44E9662B073047DA048E4E9" xlink:to="HHC644FDCFCCE7C1BFAEC65BAB59A66353" order="1" />
