&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: Arial;"&gt;Balance as &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;at&lt;/span&gt;&lt;span style="font-family: Arial;"&gt; December 31, 2024&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: Arial;"&gt;Balance as &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;at&lt;/span&gt;&lt;span style="font-family: Arial;"&gt; December 31, 2025&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 21.45pt; border-top-style: solid; border-top-width: 1pt; border-right-style: solid; border-right-width: 1pt; border-left-style: solid; border-left-width: 1pt; padding-right: 4.9pt; padding-left: 4.9pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: Arial; -aw-import: spaces;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
