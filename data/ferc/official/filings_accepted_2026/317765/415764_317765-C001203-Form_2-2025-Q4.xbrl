&lt;td style="width: 181.2pt; border-left-style: solid; border-left-width: 1pt; border-bottom-style: solid; border-bottom-width: 1pt; padding-right: 4.9pt; padding-left: 4.9pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 12pt;"&gt;&lt;span style="font-family: Arial;"&gt;Receivables (in millions)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 15pt;"&gt;
