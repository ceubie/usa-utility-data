&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 12pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 181.2pt; border-top-style: solid; border-top-width: 1pt; border-left-style: solid; border-left-width: 1pt; padding-right: 4.9pt; padding-left: 4.9pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 12pt;"&gt;&lt;span style="font-family: Arial;"&gt;$ 13.9&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 12pt;"&gt;&lt;span style="font-family: Arial;"&gt;$ 15.2&lt;/span&gt;&lt;/p&gt;
