  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH804E27F811FA12ABB210B316CDF7FC1C" xlink:label="HH804E27F811FA12ABB210B316CDF7FC1C" />
    <link:footnote xlink:type="resource" xlink:label="HHC040190A720C24542EB05D81D7B3EABD" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Respondent(Southeast Supply Header) estimates no deferred income taxes reported in the beginning-of-year and end-of-year balances for Accumulated Deferred Taxes (Account 190) could be included in the development of jurisdictional recourse rates. Furthermore, as stated in paragraph III G. 3 of Order No. 710, Docket No. RM07-9-00 as issued on March 21, 2008 by the Federal Energy Regulatory Commission, these estimates are not binding on the pipeline at such time as it may file a section 4 rate case.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH804E27F811FA12ABB210B316CDF7FC1C" xlink:to="HHC040190A720C24542EB05D81D7B3EABD" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH9612147A8CF48969F8AE3565031DE9DE" xlink:label="HH9612147A8CF48969F8AE3565031DE9DE" />
    <link:footnote xlink:type="resource" xlink:label="HHC64B35A79FB97FAC1AB3B425550583BD" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Respondent(Southeast Supply Header) estimates no deferred income taxes reported in the beginning-of-year and end-of-year balances for Accumulated Deferred Taxes-Other (Account 283) could be included in the development of jurisdictional recourse rates. Furthermore, as stated in paragraph III G. 3 of Order No. 710, Docket No. RM07-9-00 as issued on March 21, 2008 by the Federal Energy Regulatory Commission, these estimates are not binding on the pipeline at such time as it may file a section 4 rate case.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH9612147A8CF48969F8AE3565031DE9DE" xlink:to="HHC64B35A79FB97FAC1AB3B425550583BD" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0C3A2FD04307328532DD0B769DD5C856" xlink:label="HH0C3A2FD04307328532DD0B769DD5C856" />
    <link:footnote xlink:type="resource" xlink:label="HHFC8F379151508B6398481ADDF5625FB0" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Southeast Supply Header, LLC. estimates 100% of the deferred income taxes reported in the beginning-of-year and end-of-year balances for Accumulated Deferred Taxes-Other (Account 282) could be included in the development of jurisdictional recourse rates, with the exception that approximately $2,595,462 (end-of-year balance), which is attributable to certain recent accelerated depreciation, would be excluded. Furthermore, as stated in paragraph III G. 3 of Order No. 710, Docket No. RM07-9-000 as issued on March 21, 2008 by the Federal Energy Regulatory Commission, these estimates are not binding on the pipeline at such time as it may file a section 4 rate case.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0C3A2FD04307328532DD0B769DD5C856" xlink:to="HHFC8F379151508B6398481ADDF5625FB0" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHEB44D7F28E3F0DA256CB462932E73C43" xlink:label="HHEB44D7F28E3F0DA256CB462932E73C43" />
    <link:footnote xlink:type="resource" xlink:label="HH468763C9047DDBEDE3133979BD136C66" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 397pt;" border="0" width="529" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td class="xl55661" style="height: 15.0pt; width: 269pt;" width="359" height="20">&#160;&#160; Deemed contribution of taxes accrued&#160;</td>
