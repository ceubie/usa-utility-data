    <link:footnote xlink:type="resource" xlink:label="HH47EE71B7A913A7BEEC08EC95D222FD37" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Docket No. AI93-5-001 issued on April 23, 1993 (Accounting for Income Taxes).</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHFEBEDB6A0E34773CBE328EF63EF75824" xlink:to="HH47EE71B7A913A7BEEC08EC95D222FD37" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH33AEFA5282442DEB6197167196868C71" xlink:label="HH33AEFA5282442DEB6197167196868C71" />
    <link:footnote xlink:type="resource" xlink:label="HHAD80B8E0447A009C987CD34694FC0A5B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Docket No. RM95-4-000 Order 581 issued September 28, 1995.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH33AEFA5282442DEB6197167196868C71" xlink:to="HHAD80B8E0447A009C987CD34694FC0A5B" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH446EB75611534FBB75C7E52DF1741864" xlink:label="HH446EB75611534FBB75C7E52DF1741864" />
    <link:footnote xlink:type="resource" xlink:label="HHBB7E0FF5BAADAB2B81A567805F785F8D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Recorded pursuant to 18 CFR 154.402(a) and 18 CFR 382.202.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH446EB75611534FBB75C7E52DF1741864" xlink:to="HHBB7E0FF5BAADAB2B81A567805F785F8D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHD7D4CA7EA03AFCCE5853CF3320338DAD" xlink:label="HHD7D4CA7EA03AFCCE5853CF3320338DAD" />
    <link:footnote xlink:type="resource" xlink:label="HHE6415397673331AB8702491119E39725" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Relates to the establishment of a regulatory liability as a result of the U.S tax reform legislation dated December 22, 2017.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHD7D4CA7EA03AFCCE5853CF3320338DAD" xlink:to="HHE6415397673331AB8702491119E39725" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH01A058363243DC30D5E3E83194A8DEE9" xlink:label="HH01A058363243DC30D5E3E83194A8DEE9" />
    <link:footnote xlink:type="resource" xlink:label="HH474CC3C30506FA6C4D9DB281AAD5F36C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Southeast Supply Header estimates that the Deferred Income Tax Adjustment Gross-Up would not be included in the development of jurisdictional rates.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH01A058363243DC30D5E3E83194A8DEE9" xlink:to="HH474CC3C30506FA6C4D9DB281AAD5F36C" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHDCB3966B26B28EDD98E8F6C85B0ADB64" xlink:label="HHDCB3966B26B28EDD98E8F6C85B0ADB64" />
    <link:footnote xlink:type="resource" xlink:label="HH1805D30DA04D687136E2DC0EEA0B6F73" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">SESH used its own capital structure.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHDCB3966B26B28EDD98E8F6C85B0ADB64" xlink:to="HH1805D30DA04D687136E2DC0EEA0B6F73" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH811E9BBAB4F768E5540E877BDED1971B" xlink:label="HH811E9BBAB4F768E5540E877BDED1971B" />
    <link:footnote xlink:type="resource" xlink:label="HHFEC5DD5C3A843479750EFBABD817F37C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial; font-size: 13.3333px;">The reported rate of return was included in initial rates approved by the Commission.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH811E9BBAB4F768E5540E877BDED1971B" xlink:to="HHFEC5DD5C3A843479750EFBABD817F37C" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7DE469DC4BF9381EC20735A77DF4036F" xlink:label="HH7DE469DC4BF9381EC20735A77DF4036F" />
    <link:footnote xlink:type="resource" xlink:label="HH7403D75443B03DF228A494BBBF6B959D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All plant base amounts reported are the ending plant balances.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7DE469DC4BF9381EC20735A77DF4036F" xlink:to="HH7403D75443B03DF228A494BBBF6B959D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHB707D481BFCE62FCEF04F10BCA283E7C" xlink:label="HHB707D481BFCE62FCEF04F10BCA283E7C" />
    <link:footnote xlink:type="resource" xlink:label="HHA5ED1B0B498D6A934D2B377AB8C0E197" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All plant base amounts reported are the ending plant balances.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB707D481BFCE62FCEF04F10BCA283E7C" xlink:to="HHA5ED1B0B498D6A934D2B377AB8C0E197" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHAE37AA9D7011DAD2BEC298FC11B232EB" xlink:label="HHAE37AA9D7011DAD2BEC298FC11B232EB" />
    <link:footnote xlink:type="resource" xlink:label="HH7F583DD52245357922755BF516CD567A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All system balancing gas recorded under the fixed asset method as defined by FERC Order 581.</span>
          <br style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;" />
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">Initial line pack is recorded in the plant account 117.1 (non-current). Any additional system gas volumes needed for load balancing, no notice transportation and other operational purposes is recorded in account 117.2 (current portion).</span>
          <br style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;" />
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">For purposes of accounting for encroachment resulting from line inventory changes, we used Account 117.4 with appropriate debits to Account 808.1 and credits to Account 808.2.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAE37AA9D7011DAD2BEC298FC11B232EB" xlink:to="HH7F583DD52245357922755BF516CD567A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH381500C6DD3549BF931D4AA136546CDF" xlink:label="HH381500C6DD3549BF931D4AA136546CDF" />
