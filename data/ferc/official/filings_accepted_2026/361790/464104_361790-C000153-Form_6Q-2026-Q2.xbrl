  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="width: 36pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 36pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;During the &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;six&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;months ended &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;June 30, 2026&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, pursuant to the Cash Management Agreement among Norco Pipe Line Company, LLC and its affiliates, the Company effected a settlement of its &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;payable&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; to &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;affiliate, Buckeye &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Pipe Line Holdings&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, L.P., in the amount of $&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;0.7 million&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;previously included in &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Payable to &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Affiliated Companies, through &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;an increase&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; in its &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Additional Paid-in-Capital&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, effectively representing a non-cash &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;capital contribution from&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; Buckeye &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Pipe Line Holdings, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;L.P.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
