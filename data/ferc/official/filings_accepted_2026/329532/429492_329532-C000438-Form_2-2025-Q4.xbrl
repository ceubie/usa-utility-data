&lt;/td&gt;
&lt;td style="width: 106.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="width: 26.1pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 26.1pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;2&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;,000&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 17.3pt;"&gt;
&lt;td style="width: 70.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;2028&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 106.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;-&lt;/span&gt;&lt;/p&gt;
