&lt;p style="margin-top: 0pt; margin-bottom: 0pt; line-height: 150%; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;2025/26&lt;/span&gt;&lt;/p&gt;
