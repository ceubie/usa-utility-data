  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 9pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 9pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Effective August 26, 2025, Anne Bomar, replaced Dennis Lane as the alternate representative of BHE to the IGTS Management Committee.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 9pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Effective January 15, 2026 Michelle Wieler, Senior Director, Financial Services and Chief Financial Officer retired from Iroquois Pipeline Operating Company, agent of IGTS.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 9pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Effective January 16, 2026 Christopher Lown was appointed Director, Financial Services and Corporate Controller of Iroquois Pipeline Operating Company, agent of IGTS.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 9pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
