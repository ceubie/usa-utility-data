&lt;/td&gt;
&lt;td style="width: 29.7pt; border-bottom: 1.5pt solid #1f497d; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle;" colspan="2"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; letter-spacing: -0.6pt; color: #00b0f0;"&gt;20&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; letter-spacing: -0.6pt; color: #00b0f0;"&gt;2&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; letter-spacing: -0.6pt; color: #00b0f0;"&gt;5&lt;/span&gt;&lt;/p&gt;
