&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 14pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-variant: small-caps; letter-spacing: -0.6pt; color: #365f91;"&gt;Note 11&lt;/span&gt;&lt;/p&gt;
