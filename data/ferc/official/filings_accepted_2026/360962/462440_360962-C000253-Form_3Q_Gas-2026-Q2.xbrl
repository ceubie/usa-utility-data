  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH6D09B49321ED2F9175728B9D8D482ABE" xlink:label="HH6D09B49321ED2F9175728B9D8D482ABE" />
    <link:footnote xlink:type="resource" xlink:label="HHA9C85DEF6BC7F0AD2C169759B5B0CDCD" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong>Schedule Page: 118 Line No.: 1 Column: c</strong>
        </p>
        <p>Sea Robin Pipeline Company, LLC, as a limited liability company, records member's equity in Other Paid-In Capital.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6D09B49321ED2F9175728B9D8D482ABE" xlink:to="HHA9C85DEF6BC7F0AD2C169759B5B0CDCD" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHC88398654C4B45477DA89A5E7E505041" xlink:label="HHC88398654C4B45477DA89A5E7E505041" />
    <link:footnote xlink:type="resource" xlink:label="HH9451F55591ADD4180A4743CF2A95A546" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong>Schedule Page: 112 Line No.: 44 Column: d</strong>
        </p>
        <p>Reclassed Accumulated provision for rate refunds of $1,692,504, Account 229, line 31, column (d), to Interest accrued, Account 237, line 44, column (d), to conform to current year presentation.&#160;</p>
        <p>This footnote also applies to line 31, column (d).&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC88398654C4B45477DA89A5E7E505041" xlink:to="HH9451F55591ADD4180A4743CF2A95A546" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE5D364F3D6CB33077E062C4DE02AAFCC" xlink:label="HHE5D364F3D6CB33077E062C4DE02AAFCC" />
    <link:footnote xlink:type="resource" xlink:label="HH03F274C085822B327F7BE8436829C6B1" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong>Schedule Page: 278 Line No.: 1 Column: a </strong>
        </p>
        <p>ARO cost of service allowance established pursuant to Article IV, Section B.5.e. of the Stipulation and Agreement of Settlement in Docket No. RP14-247-000, as approved by FERC's order issued on June 26, 2015.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE5D364F3D6CB33077E062C4DE02AAFCC" xlink:to="HH03F274C085822B327F7BE8436829C6B1" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7B739F44DB28E291ACED827EB45AFD11" xlink:label="HH7B739F44DB28E291ACED827EB45AFD11" />
    <link:footnote xlink:type="resource" xlink:label="HH24042F7CD98A99533E4688A74E08F012" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong>Schedule Page: 278 Line No.: 2 Column: a&#160; </strong>
        </p>
        <p>ARO cost of service allowance established pursuant to Article IV, Section C.4.d. of the Stipulation and Agreement of Settlement in Docket No. RP19-352-000, as approved by FERC's order issued on October 17, 2019.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7B739F44DB28E291ACED827EB45AFD11" xlink:to="HH24042F7CD98A99533E4688A74E08F012" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0258AE4883BFCA77F243D2DA387A6B17" xlink:label="HH0258AE4883BFCA77F243D2DA387A6B17" />
    <link:footnote xlink:type="resource" xlink:label="HH42F4B7DB2941958DA07F1558DA5362EE" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong>Schedule Page: 278 Line No.: 3 Column: a&#160; </strong>
        </p>
        <p>Pursuant to Section 22.3 (c) of the General Terms and Conditions of Sea Robin's FERC Gas Tariff, Third Revised Volume No. 1, Docket No. RP26-302-000, as approved by FERC&#8217;s order issued on January 23, 2026.</p>
        <p class="MsoNormal">Amortization period is 12 months, beginning March 22, renewing every year in November.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0258AE4883BFCA77F243D2DA387A6B17" xlink:to="HH42F4B7DB2941958DA07F1558DA5362EE" order="1" />
