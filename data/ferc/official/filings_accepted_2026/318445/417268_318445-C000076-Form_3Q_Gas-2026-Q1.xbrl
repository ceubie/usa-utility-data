  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH6D09B49321ED2F9175728B9D8D482ABE" xlink:label="HH6D09B49321ED2F9175728B9D8D482ABE" />
    <link:footnote xlink:type="resource" xlink:label="HH46550038191528EEDDB2D0C040641CB3" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0 0 10px; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong style="font-weight: bold;">Schedule Page: 118 Line No.: 1 Column: c</strong>
            </span>
          </span>
        </p>
        <p style="margin: 0 0 10px; font-family: Roboto;">
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">Transwestern Pipeline Company, LLC, as a limited liability company, records member's equity in Other Paid-In Capital.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6D09B49321ED2F9175728B9D8D482ABE" xlink:to="HH46550038191528EEDDB2D0C040641CB3" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHC1D1C929DF6233ED19D321AB06344E63" xlink:label="HHC1D1C929DF6233ED19D321AB06344E63" />
    <link:footnote xlink:type="resource" xlink:label="HH4E60F0CA7E015EEE24ECC40EF4C28041" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <p>
            <strong>
              <span style="font-size: 12pt;">
                <span style="font-family: Arial, Helvetica, sans-serif;">Schedule Page: 278 Line No.: 1 Column: a</span>
              </span>
            </strong>
          </p>
          <div>
            <p>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">
                  <span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; display: inline !important; float: none;">Pursuant to Article VIII, Section 1 of the Stipulation and Agreement of Settlement in Docket No. RP22-1031, as approved by FERC's order issued on June 30, 2023.</span>
                </span>
              </span>
            </p>
            <p>&#160;</p>
          </div>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC1D1C929DF6233ED19D321AB06344E63" xlink:to="HH4E60F0CA7E015EEE24ECC40EF4C28041" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH2A6D94AD2CB2990D22D6AEB2FF83CA5C" xlink:label="HH2A6D94AD2CB2990D22D6AEB2FF83CA5C" />
    <link:footnote xlink:type="resource" xlink:label="HH0A0F0D1E31F70E179BCCB2E3CD7797B6" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 278 Line No.: 2 Column: a</strong>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px;">
          <span style="color: #333333; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Pursuant to Section 22.4 of the General Terms and Conditions of Transwestern's FERC Gas Tariff, Fifth Revised Volume No. 1, Docket No. RP26-368-000 filed on January 9, 2026.</span>
          <span style="color: #333333; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">&#160;&#160;</span>
        </p>
        <p style="margin: 0px 0px 10px;">
          <span style="color: #333333; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">The current annual penalty period is October 1, 2025 through September 30, 2026.</span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH2A6D94AD2CB2990D22D6AEB2FF83CA5C" xlink:to="HH0A0F0D1E31F70E179BCCB2E3CD7797B6" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0E9C904FB2C2E084EF92DB616432754F" xlink:label="HH0E9C904FB2C2E084EF92DB616432754F" />
    <link:footnote xlink:type="resource" xlink:label="HH15E9397EBBB25C688ED12D1609E08026" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Schedule Page: 520 Line No.: 29.1 Columns: c and d</strong>
        </p>
        <p>
          <img title="tw pg 520 29.1.gif" src="data:image/gif;base64," alt="" width="488" height="155" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0E9C904FB2C2E084EF92DB616432754F" xlink:to="HH15E9397EBBB25C688ED12D1609E08026" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:label="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" />
    <link:footnote xlink:type="resource" xlink:label="HHB9EE9C0703701E2805D7E747454B8C6D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">
              <span style="text-decoration: inherit;">
                <strong>Schedule Page: 521 Line No.: 7 Column: e</strong>
              </span>
            </span>
          </span>
        </p>
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">The allocation is derived by determining whether the reservation rate charged within the billing system is discounted, negotiated or recourse. This determination is applied to the retained fuel charged per contract scheduled path, and a pro rata allocation is derived and applied to all volumes and dollars.</span>
          </span>
        </p>
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span>
          </span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:to="HHB9EE9C0703701E2805D7E747454B8C6D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE42A88354FE811940E49AF98CC4875FD" xlink:label="HHE42A88354FE811940E49AF98CC4875FD" />
    <link:footnote xlink:type="resource" xlink:label="HHC2B4B436C2C3150A693D443F864AB9B6" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">
              <strong>Schedule Page: 521 Line No.: 7 Column: f</strong>
            </span>
          </span>
        </p>
        <p>
          <span style="color: #333333; font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">The basis for valuing the gas reported in columns (f), (g) and (h) is the Gas Daily monthly average index for San Juan Bondad, San Juan Non-Bondad and Transwestern Permian.</span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE42A88354FE811940E49AF98CC4875FD" xlink:to="HHC2B4B436C2C3150A693D443F864AB9B6" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHCCB08CDE937914D93DE486E9EA60E849" xlink:label="HHCCB08CDE937914D93DE486E9EA60E849" />
    <link:footnote xlink:type="resource" xlink:label="HHD433BB1949772A1E8E3FCFC5D53CE521" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong style="font-family: Roboto;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt;">Schedule Page: 120 Line No.: 5.1 Column: b</span>
            </span>
          </strong>
        </p>
        <p>
          <img title="tw cf 5.1.gif" src="data:image/gif;base64," alt="" width="480" height="149" />
        </p>
