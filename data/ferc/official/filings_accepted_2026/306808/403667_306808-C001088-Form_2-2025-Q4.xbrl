        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Salt Lake City, Utah building rent is allocated based on employee labor hours.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-54" id="fn-54" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:19pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Salt Lake City, Utah building rent is allocated based on employee labor hours.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-55" id="fn-55" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Dth calculated using the 1.065 Mcf/Dth conversion factor. Applied to line 2, 3, 4 &amp; 7 also.</span>
      </div>
    </link:footnote>
