        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Footnote to Instruction 9:</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Mountain West Pipeline had the following storage quantities at 12/31/25:</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span>
          <br/>
        </span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:64.434%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:63.565%"/>
            <td style="width:0.1%"/>
            <td style="width:1.0%"/>
            <td style="width:11.140%"/>
            <td style="width:0.1%"/>
            <td style="width:1.0%"/>
            <td style="width:21.995%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top">
              <div>
                <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Clay Basin Storage</span>
              </div>
            </td>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top">
              <div style="text-align:center">
                <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Dth</span>
              </div>
            </td>
          </tr>
          <tr>
            <td colspan="3" style="border-top:1pt solid #000000;padding:2px 1pt;text-align:left;vertical-align:top">
              <div style="text-indent:18pt">
                <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Contract Storage</span>
              </div>
            </td>
            <td colspan="3" style="padding:0 1pt"/>
