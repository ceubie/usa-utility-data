&lt;p style="margin-top: 2.75pt; margin-bottom: 1.5pt; text-align: right; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri;"&gt;$&lt;/span&gt;&lt;span style="width: 54.54pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 59.1pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri;"&gt;(3.9)&lt;/span&gt;&lt;/p&gt;
