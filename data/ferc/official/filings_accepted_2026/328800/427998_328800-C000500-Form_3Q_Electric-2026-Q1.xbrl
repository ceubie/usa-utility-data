&lt;td style="width: 77.6pt; border-top-style: solid; border-top-width: 1pt; padding-right: 2.65pt; vertical-align: bottom; background-color: #cccccc;"&gt;
&lt;p style="margin-top: 2.75pt; margin-bottom: 1.5pt; text-align: right; page-break-after: avoid; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 3.75pt; vertical-align: bottom; background-color: #cccccc;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; page-break-after: avoid; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
