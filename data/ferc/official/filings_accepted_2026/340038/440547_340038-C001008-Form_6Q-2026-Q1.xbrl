  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HHD52596F706B1CC601A58448E53FDD400" xlink:label="HHD52596F706B1CC601A58448E53FDD400" />
    <link:footnote xlink:type="resource" xlink:label="HHB7E5D18C6B8105C3034F51E0DE9CC879" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Trunk Revenues Account includes approximately $650k of revenue related to the rebilling of shippers for under-recovery resulting from the vacated 2021 FERC Rehearing Order.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHD52596F706B1CC601A58448E53FDD400" xlink:to="HHB7E5D18C6B8105C3034F51E0DE9CC879" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHDF1396D36C87B250B0DE52E68E82C523" xlink:label="HHDF1396D36C87B250B0DE52E68E82C523" />
    <link:footnote xlink:type="resource" xlink:label="HH9FE742BE326C722D73A5DCE6F4360AD6" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Includes $4.2M of revenue from forfeited Throughput &amp; Deficiency (T&amp;D) amounts from committed shippers.&#160;&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHDF1396D36C87B250B0DE52E68E82C523" xlink:to="HH9FE742BE326C722D73A5DCE6F4360AD6" order="1" />
  </link:footnoteLink>
