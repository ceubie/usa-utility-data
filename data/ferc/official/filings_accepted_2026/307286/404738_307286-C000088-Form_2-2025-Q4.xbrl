&lt;td style="border-top-style: double; border-top-width: 3pt; border-bottom-style: solid; border-bottom-width: 1pt; padding-right: 1.25pt; padding-left: 1.25pt; vertical-align: middle;" colspan="3"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Aptos Display';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-bottom-style: solid; border-bottom-width: 1pt; padding-top: 0.25pt; padding-right: 1.25pt; padding-left: 1.25pt; vertical-align: middle;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Aptos Display';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-top-style: double; border-top-width: 3pt; border-bottom-style: solid; border-bottom-width: 1pt; padding-right: 1.25pt; padding-left: 1.25pt; vertical-align: middle;" colspan="3"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Aptos Display';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
