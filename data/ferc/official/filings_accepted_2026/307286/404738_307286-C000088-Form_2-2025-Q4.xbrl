    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHBE47FE3F87AD66280543E7240A0F2E34" xlink:to="HH68BC02673252056758D90296A7A0D008" order="1" />
