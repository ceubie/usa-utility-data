    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHD22CB5BDAD9D03244E5A82FB9DA28772" xlink:to="HHC3C74D374B1A4AA60BEE777306B45E82" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHCB742C9459FDB62531A2551EAAA32080" xlink:label="HHCB742C9459FDB62531A2551EAAA32080" />
    <link:footnote xlink:type="resource" xlink:label="HHDADFC790820B006FDDE4DE91CD1B14AF" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml" />
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHCB742C9459FDB62531A2551EAAA32080" xlink:to="HHDADFC790820B006FDDE4DE91CD1B14AF" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0C3A2FD04307328532DD0B769DD5C856" xlink:label="HH0C3A2FD04307328532DD0B769DD5C856" />
    <link:footnote xlink:type="resource" xlink:label="HHE8AC6B624A9B78130F57D29AA798E8DB" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">The July 18, 2018 Commission order in Docket No. PL17-1-001 provided guidance regarding the Commission&#8217;s income tax allowance policy for pipelines owned by master limited partnerships and the related deferred tax balances, including balances in Account 282 (Accumulated Deferred Taxes-Other). The July 18 Order explained that MLP pipelines could elect to eliminate certain deferred tax balances. Maritimes&#8217; affiliate, Spectra Energy Partners, LP, has a pending request with the FERC Chief Accountant to eliminate amounts recorded in Account 282, including amounts in Account 282 for Maritimes. Certain amounts in Account 282 may be excluded in the development of jurisdictional recourse rates in the future.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0C3A2FD04307328532DD0B769DD5C856" xlink:to="HHE8AC6B624A9B78130F57D29AA798E8DB" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH9612147A8CF48969F8AE3565031DE9DE" xlink:label="HH9612147A8CF48969F8AE3565031DE9DE" />
    <link:footnote xlink:type="resource" xlink:label="HHB7F77277B8FF6C847D57932B797EB521" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">The July 18, 2018 Commission order in Docket No. PL17-1-001 provided guidance regarding the Commission&#8217;s income tax allowance policy for pipelines owned by master limited partnerships and the related deferred tax balances, including balances in Account 283 (Accumulated Deferred Taxes-Other). The July 18 Order explained that MLP pipelines could elect to eliminate certain deferred tax balances. Maritimes&#8217; affiliate, Spectra Energy Partners, LP, has a pending request with the FERC Chief Accountant to eliminate amounts recorded in Account 283, including amounts in Account 283 for Maritimes. Certain amounts in Account 283 may be excluded in the development of jurisdictional recourse rates in the future.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH9612147A8CF48969F8AE3565031DE9DE" xlink:to="HHB7F77277B8FF6C847D57932B797EB521" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHA5E87FE2E50423933672E7E28D5E198A" xlink:label="HHA5E87FE2E50423933672E7E28D5E198A" />
    <link:footnote xlink:type="resource" xlink:label="HHCC66CA5FA20DD3CFF9B2C9551D983C6C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Relates to the establishment of a regulatory liability as a result of the U.S. tax reform legislation dated December 22, 2017.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHA5E87FE2E50423933672E7E28D5E198A" xlink:to="HHCC66CA5FA20DD3CFF9B2C9551D983C6C" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH804E27F811FA12ABB210B316CDF7FC1C" xlink:label="HH804E27F811FA12ABB210B316CDF7FC1C" />
    <link:footnote xlink:type="resource" xlink:label="HH688347CBF6E41F36931C713A8E291E8B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">The July 18, 2018 Commission order in Docket No. PL17-1-001 provided guidance regarding the Commission&#8217;s income tax allowance policy for pipelines owned by master limited partnerships and the related deferred tax balances, including balances in Account 190 (Accumulated Deferred Taxes). The July 18 Order explained that MLP pipelines could elect to eliminate certain deferred tax balances. Maritimes&#8217; affiliate, Spectra Energy Partners, LP, has a pending request with the FERC Chief Accountant to eliminate amounts recorded in Account 190, including amounts in Account 190 for Maritimes. Certain amounts in Account 190 may be excluded in the development of jurisdictional recourse rates in the future.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH804E27F811FA12ABB210B316CDF7FC1C" xlink:to="HH688347CBF6E41F36931C713A8E291E8B" order="1" />
