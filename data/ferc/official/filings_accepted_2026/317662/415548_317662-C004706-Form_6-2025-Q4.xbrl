  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH61195969E8DB57EBC71E91F85A2B07CA" xlink:label="HH61195969E8DB57EBC71E91F85A2B07CA" />
    <link:footnote xlink:type="resource" xlink:label="HH390E7153D43D231481DA6DE100D47FDA" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Management believes that the information on this page has been prepared in accordance with the Commission's Opinion 154-B methodology.&#160; This presentation on page 700 is not necessarily in the form in which it would appear in connection with a challenge to a particular rate, or rates, and is therefore not intended to be binding in any specific rate litigation.</p>
        <p>Notes:</p>
        <p>Totals may not sum due to rounding</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH61195969E8DB57EBC71E91F85A2B07CA" xlink:to="HH390E7153D43D231481DA6DE100D47FDA" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0DB1D96ED958488DD1003D9190059479" xlink:label="HH0DB1D96ED958488DD1003D9190059479" />
    <link:footnote xlink:type="resource" xlink:label="HH8CC56B5EE9753B97464B58372632B114" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Aptos, Aptos_EmbeddedFont, Aptos_MSFontService, Calibri, Helvetica, sans-serif; font-size: 16px;">During the year,&#160;&#160;</span>
          <em style="color: #000000; font-family: Aptos, Aptos_EmbeddedFont, Aptos_MSFontService, Calibri, Helvetica, sans-serif; font-size: 16px;">
            <span style="font-weight: bold;">Enbridge Transportation (IL-OK) LLC</span>
          </em>
          <span style="color: #000000; font-family: Aptos, Aptos_EmbeddedFont, Aptos_MSFontService, Calibri, Helvetica, sans-serif; font-size: 16px;">&#160;recorded a one&#8209;time credit related to FERC recoupment revenue in account 645 - unusual or infrequent items. As the credit is reported after net carrier operating income (line number 3) it has not been included in page 700 annual cost of service within total interstate operating revenue.</span>
        </p>
      </div>
    </link:footnote>
