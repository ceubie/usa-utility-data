  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HHA28CF79B3FD6A978F50BB7D392220CA8" xlink:label="HHA28CF79B3FD6A978F50BB7D392220CA8" />
    <link:footnote xlink:type="resource" xlink:label="HHBB55E035FA1B000A39E31A5D2967CF5A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:99.780%">
            <tr>
              <td style="width:1.0%" />
              <td style="width:18.900%" />
              <td style="width:0.1%" />
              <td style="width:1.0%" />
              <td style="width:18.900%" />
              <td style="width:0.1%" />
              <td style="width:1.0%" />
              <td style="width:18.900%" />
              <td style="width:0.1%" />
              <td style="width:1.0%" />
              <td style="width:18.900%" />
              <td style="width:0.1%" />
              <td style="width:1.0%" />
              <td style="width:18.900%" />
              <td style="width:0.1%" />
            </tr>
            <tr>
              <td colspan="15" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
                <span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">The Commission is required by section 3401 of the Omnibus Budget Reconciliation Act of 1983 to assess and collect fees and annual charges in any fiscal year in amounts equal to all costs incurred by the Commission in a fiscal year. This allows FERC to establish an ACA unit charge applicable to all jurisdictional quantities transported which allows pipelines to recover these costs under its current rates with customers.</span>
              </td>
            </tr>
          </table>
        </div>
      </div>
    </link:footnote>
