&lt;/td&gt;
&lt;td style="width: 132.95pt; border-top: 4.5pt solid #000000; border-right: 0.75pt solid #000000; border-bottom: 4.5pt solid #000000; padding-right: 5.03pt; padding-left: 5.65pt; vertical-align: bottom; -aw-border-right: 0.5pt single;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;73&lt;/font&gt;&lt;/p&gt;
