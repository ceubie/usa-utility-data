    <link:footnoteArc xlink:type="arc" xlink:from="value90" xlink:to="footnote90" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="90" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote91" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <xhtml:span style="font-size: 24px;">In accordance with FERC Order No. 581, we use the fixed asset method.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <xhtml:span style="font-size: 24px;">For purposes of accounting for encroachment resulting from line inventory changes, we use Account 117.4 with appropriate debits to Account 808.1 and credits to Account 808.2.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value91" xlink:to="footnote91" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="91" />
