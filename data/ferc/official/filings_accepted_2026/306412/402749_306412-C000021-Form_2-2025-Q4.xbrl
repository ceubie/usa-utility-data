    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote63" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Recorded pursuant to Docket No. AI07-1-000 issued March 29, 2007.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value63" xlink:to="footnote63" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="63" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote64" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Recorded pursuant to Section 35 of the General Terms and Conditions of our tariff. Remaining balance at end of current filing period will be refunded through adjustments to future period fuel retention rates.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value64" xlink:to="footnote64" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="64" />
