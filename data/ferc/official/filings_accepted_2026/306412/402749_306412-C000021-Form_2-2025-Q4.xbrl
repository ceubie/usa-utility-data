    <link:footnoteArc xlink:type="arc" xlink:from="value135" xlink:to="footnote135" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="135" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote136" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">The Bear Creek Storage Field is owned 50 percent each by Southern Natural Gas Company, L.L.C. (SNG) and Tennessee Gas Pipeline Company, L.L.C.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value136" xlink:to="footnote136" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="136" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote137" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">450,000 Mcf (Dth equivalent 463,500 by a factor of 1.030) represents SNG's half of Bear Creek's total certified maximum daily delivery capacity.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value137" xlink:to="footnote137" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="137" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote138" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal;">
          <xhtml:span style="font-size: 18pt; font-family: Arial, sans-serif; color: black; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;">Amounts charged are based on Kinder Morgan, Inc.'s other compensation and benefit expenses and are allocated to us based on the distribution of direct labor charges (excluding overtime and special pay).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value138" xlink:to="footnote138" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="138" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote139" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">This amount would be excluded in the development of jurisdictional recourse rates.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value139" xlink:to="footnote139" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="139" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote140" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">See page 122.1, Notes to Financial Statements, Note 5 "Debt" for information regarding interest rate on credit facility borrowings.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value140" xlink:to="footnote140" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="140" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote142" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p style="text-align: justify;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-fareast-font-family: Aptos; mso-fareast-theme-font: minor-latin; mso-ligatures: standardcontextual; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">The Rose Hill Compressor Station was placed in service on January 29, 2025 under Docket No. CP20-51-000.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value142" xlink:to="footnote142" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="142" />
