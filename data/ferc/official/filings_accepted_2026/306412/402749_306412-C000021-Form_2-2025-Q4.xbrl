    <link:footnoteArc xlink:type="arc" xlink:from="value87" xlink:to="footnote87" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="87" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote90" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">A reconciliation of fuel volumes in line 28, column (c) to fuel volumes on pages 331 and 508 is as follows:</xhtml:span>
        </xhtml:p>
        <xhtml:table class="MsoNormalTable" style="width: 16.0in; margin-left: -.25pt; border-collapse: collapse; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="0" width="1536" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: .3in;">
              <xhtml:td style="width: 13.6in; border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext 1.0pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="1306">
                <xhtml:p class="MsoNormal" style="line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; margin: 0in 3.75pt 0in 0in;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Total line 28, col (c)</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: .4in; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="top" width="38">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border: solid windowtext 1.0pt; border-left: none; mso-border-top-alt: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext 1.0pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="192">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">12,249,169</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 1; height: .3in;">
              <xhtml:td style="width: 13.6in; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext 1.0pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="1306">
                <xhtml:p class="MsoNormal" style="line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; margin: 0in 3.75pt 0in 0in;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Bear Creek Fuel Refund</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: .4in; border: none; border-bottom: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext 1.0pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="top" width="38">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext 1.0pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="192">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">279,815</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 2; height: .3in;">
              <xhtml:td style="width: 13.6in; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext 1.0pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="1306">
                <xhtml:p class="MsoNormal" style="line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; margin: 0in 3.75pt 0in 0in;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Elba Express Fuel Refund</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: .4in; border: none; border-bottom: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext 1.0pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="top" width="38">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
                </xhtml:p>
