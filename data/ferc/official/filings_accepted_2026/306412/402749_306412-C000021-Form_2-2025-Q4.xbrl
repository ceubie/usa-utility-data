                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border: solid windowtext 1.0pt; border-left: none; mso-border-top-alt: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext 1.0pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="192">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">7,236,343</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 1; height: .3in;">
              <xhtml:td style="width: 13.6in; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="1306">
                <xhtml:p class="MsoNormal" style="line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; margin: 0in 3.75pt 0in 0in;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Cash distributions of earnings from Bear Creek</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: .4in; border: none; border-bottom: solid windowtext 4.5pt; mso-border-top-alt: solid windowtext 1.0pt; mso-border-left-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="38">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;" align="center">
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border-top: none; border-left: none; border-bottom: solid windowtext 4.5pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext 4.5pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="192">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">(3,450,000)</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 2; mso-yfti-lastrow: yes; height: .3in;">
              <xhtml:td style="width: 13.6in; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="1306">
                <xhtml:p class="MsoNormal" style="line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; margin: 0in 3.75pt 0in 0in;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;"> Total</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: .4in; border: none; border-bottom: solid windowtext 4.5pt; mso-border-top-alt: solid windowtext 4.5pt; mso-border-left-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="38">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;" align="center">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border-top: none; border-left: none; border-bottom: solid windowtext 4.5pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext 4.5pt; mso-border-bottom-alt: solid windowtext 4.5pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="192">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">3,786,343</xhtml:span>
                </xhtml:p>
