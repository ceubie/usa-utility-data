    <link:footnoteArc xlink:type="arc" xlink:from="value75" xlink:to="footnote75" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="75" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote76" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Operational and cashout purchases recorded in Account 803.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value76" xlink:to="footnote76" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="76" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote77" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Gas withdrawn from storage for system balancing purposes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value77" xlink:to="footnote77" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="77" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote78" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Operational and cashout sales recorded in Account 803.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value78" xlink:to="footnote78" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="78" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote79" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 24px;">Gas delivered to storage for system balancing purposes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value79" xlink:to="footnote79" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="79" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote80" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level, rather than by service type (i.e. firm transport, </xhtml:span>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">interruptible transport, etc.) or by discounted, negotiated, or recourse rate contracts. Therefore, the amounts reported have been allocated to the service types and to discounted, negotiated, or recourse rate contracts based on reasonable assumptions.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value80" xlink:to="footnote80" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="80" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote81" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Line 14 dekatherms do not include electric compressor stations. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value81" xlink:to="footnote81" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="81" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote82" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Line 18 includes compressor blowdowns, pipeline losses, and other gas used for utility operations. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value82" xlink:to="footnote82" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="82" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote83" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">The value of this gas is based on the current month cash out price provided for in our tariff. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value83" xlink:to="footnote83" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="83" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote84" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">We use a non-revenue recognition method for shipper-supplied gas which results in accounting entries for net fuel over or under-collected rather than separate revenue entries for shipper-supplied gas used in operations. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value84" xlink:to="footnote84" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="84" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote86" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Recorded pursuant to Docket No. AI93-5-000 issued April 23, 1993 (Accounting for Income Taxes). </xhtml:span>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <xhtml:span style="font-size: 18pt;">We estimate approximately </xhtml:span>
            <xhtml:span style="font-size: 18pt; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;">$2.3</xhtml:span>
            <xhtml:span style="font-size: 18pt;"> million of the ending balance is associated with the project granted non-traditional rate treatment that is reported on page 217.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value86" xlink:to="footnote86" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="86" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote87" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table class="MsoNormalTable" style="width: 16.0in; margin-left: -.25pt; border-collapse: collapse; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="0" width="1536" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: .3in;">
              <xhtml:td style="width: 13.6in; border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext 1.0pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="1306">
                <xhtml:p class="MsoNormal" style="line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; margin: 0in 3.75pt 0in 0in;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Equity in earnings of subsidiary companies</xhtml:span>
