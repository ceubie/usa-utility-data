    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote116" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">One unit at Riceboro, GA compressor station is leased from Magnolia Enterprise Holdings, Inc.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value116" xlink:to="footnote116" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="116" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote117" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">A reconciliation of fuel expenses in column (f) to fuel expenses on page 331 is as follows:</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:strong style="mso-bidi-font-weight: normal;">
            <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">
            </xhtml:span>
          </xhtml:strong>
        </xhtml:p>
        <xhtml:table class="MsoNormalTable" style="width: 16.0in; margin-left: -.25pt; border-collapse: collapse; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="0" width="1536" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: .3in;">
              <xhtml:td style="width: 13.6in; border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext 1.0pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="1306">
                <xhtml:p class="MsoNormal" style="line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; margin: 0in 3.75pt 0in 0in;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Total column (f)</xhtml:span>
                </xhtml:p>
