      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Recorded pursuant to Docket No. RP24-982. Remaining balance at end of current filing period will be refunded through adjustments to future period EPC rates.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value65" xlink:to="footnote65" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="65" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote66" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">These revenues are associated with park and loan agreements. The net monthly park and loan volume activity for the quarter is as follows:</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
        <xhtml:table class="MsoTableGrid" style="width: 16.0in; border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" width="1536" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: .3in;">
              <xhtml:td style="width: 13.6in; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="1306">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">
                  </xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.4in; border: solid windowtext 1.0pt; border-left: none; mso-border-left-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" colspan="2" valign="bottom" width="230">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center">
