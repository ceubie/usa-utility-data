        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">All volumes were converted to energy using a BTU conversion factor of 1.0323.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value67" xlink:to="footnote67" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="67" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote68" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Cushion gas consists of 45,400,107 Dth of recoverable volumes included in Account 117.1 and 12,102,793 Dth of non-recoverable volumes included in Account 101. Also, 1,021,700 Dth of third party parked gas is serving a cushion gas function. All volumes were converted to energy using a BTU conversion factor of 1.03.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value68" xlink:to="footnote68" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="68" />
