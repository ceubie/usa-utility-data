  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:label="value3" xlink:href="#Tag132" />
    <link:loc xlink:type="locator" xlink:label="value4" xlink:href="#Tag134" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote3" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">Pursuant to the Federal Energy Regulatory Commission's Order Denying Petition and Granting Remedies issued November 20, 2025, we have included in Page 300, in revenue account 200, the amount of $6,016,599 related to correcting invoices from March 1, 2022 to September 30, 2024.</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal">
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value3" xlink:to="footnote3" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="3" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote4" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 11.0pt;">
            <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Pursuant to the Federal Energy Regulatory Commission's Order Denying Petition and Granting Remedies issued November 20, 2025, we have included in Page 300, in revenue account 210, the amount of $107,744 related to correcting invoices from March 1, 2022 to September 30, 2024.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value4" xlink:to="footnote4" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="4" />
  </link:footnoteLink>
</xbrli:xbrl>
