t: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 26.1pt; margin-bottom: 0.5pt; text-indent: 5.4pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 53.3pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 1pt; margin-bottom: 0; line-height: 1pt; border-top: 2.25pt double rgba(0, 0, 0, 1); padding-top: 1pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 52.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 1pt; margin-bottom: 0; line-height: 1pt; border-top: 2.25pt double rgba(0, 0, 0, 1); padding-top: 1pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 7pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The total provisions for income taxes for the years ended December 31, 2025 and 2024, were expenses of $480 thousand and $519 thousand, respectively.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The components of the provision for income taxes are (in thousands):&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 460.7pt; margin-left: 21.8pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr style="height: 11.25pt"&gt;&lt;td style="width: 277.55pt; padding-right: 5.4pt; padding-left