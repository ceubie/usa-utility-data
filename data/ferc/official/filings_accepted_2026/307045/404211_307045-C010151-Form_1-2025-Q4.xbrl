 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 11.44%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.48%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 11.44%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.48%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 11.44%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.48%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 11.32%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;(7)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Related-Party Transactions&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The Company receives operational and administrative services from an affiliate, LSP Electric Services, LLC (Project Manager) which is owned by an affiliate of the Company. The Company reimburses the Project Manager for all reasonable and necessary expenses incurred in the performance of such services. This includes direct labor costs, general and administrative expenses, third party costs, overhead, travel and lodging. For the year ended December 31, 2025, The Company incurred $2.3 million of such reimbursable costs, of which $1.3 million are included in Property and equipment, net on the accompanying balance sheet, and $1.0 million are included in Total expenses on the accompanying statement of operations. For the year ended December 31, 2024, The Company incurred $0.9 million of such reimbursable costs, of which $0.1 million are included in Property and equipment, net on the accompanying balance sheet, and $0.8 million are included in Total expenses on the accompanying statement of operations. As of December&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31, 2025 and 2024, the Company had outstanding payables to the Project Manager of $199 thousand and $101 thousand, respectively. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;(8)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Members' Equity&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;Profit, losses and distributions are allocated in accordance with the provisions of the Company's Limited Liability agreement. In 2025 and 2024, no equity contributions were received from Republic Holdings. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;During 2025, equity distributions from the Company to Republic Holdings were $2.2 million. During 2024, equity distributions from the Company to Republic Holdings were $3.6 million. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;(9)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Income Taxes&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The components of pre-tax income are as follows (in thousands):&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 460.7pt; margin-left: 21.8pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr style="height: 18pt"&gt; 					&lt;td style="width: 277.55pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 4.3pt; margin-bottom: 0.5pt; text-indent: -4.3pt; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 53.3pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 							&lt;span style="font-weight: bold"&gt;2025&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid; line-height: 1pt; border-top: 1pt solid rgba(0, 0, 0, 1); padding-top: 1pt"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 52.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 							&lt;span style="font-weight: bold"&gt;2024&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid; line-height: 1pt; border-top: 1pt solid rgba(0, 0, 0, 1); padding-top: 1pt"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 