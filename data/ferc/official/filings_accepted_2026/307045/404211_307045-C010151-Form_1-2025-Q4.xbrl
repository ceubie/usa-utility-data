uble rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;25,650&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 58.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.95pt"&gt; 					&lt;td style="width: 1.25pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 128.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 17.3pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 55.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 60.35pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 58.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;At December 31, 2025 and 2024, the unamortized debt issuance and deferred financing costs associated with the Senior Notes Facility totaled $415thousand and $429thousand, respectively. As of December 31, 2024, unamortized debt issuance and deferred financing costs associated with the Revolving Loan Facility totaled $12 thousand. These costs were fully amortized during 2025, resulting in no remaining balance as of December 31, 2025. The amortization of these costs is reflected as a component of Interest expense, net on the accompanying statements of operations. For both years ended December 31, 2025 and 2024, amortization of such costs was $26 thousand.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(a)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Note Purchase Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;On December 17, 2020, the Company executed a note purchase agreement with a group of lenders (Note Purchase Agreement), which consists of a $29.3 million senior notes facility.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;Under the Note Purchase Agreement, the principal balance will be repaid according to the amortization schedule with installment payments made on a semi-annual basis with the final balance due on the maturity date of December 17, 2050. During the years ended December 31, 2025 and 2024, installment payments were made of $700thousand and $800 thousand, respectively. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;Interest is payable semi-annually under the Note Purchase Agreement with an interest rate of 2.62%. As of December 31, 2025 and 2024, the Company recognized $667thousand and $688thousand, respectively, in interest expense related to the Note Purchase Agreement.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The Company may, at its option, upon notice provided, prepay all or part of the senior notes in an amount not less than $1.0 million or a whole multiple of $0.5 million in excess thereof.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(b)&lt;/span&gt;&lt;span style="width: 14.17pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Credit Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;On December 17, 2020 the Company executed a credit agreement with a group of lenders (Credit Agreement). The Credit Agreement includes a $5.0 million revolving and letter of credit facility (Revolving Loan Facility) to fund working capital expenditures and for other general corporate purposes and issuances of letters of credit (LOCs).&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The Credit Agreement permits both Eurodollar and base rate loans. Interest rates on Eurodollar Loans are equal to the Eurodollar Base Rate for the applicable term of the loan with an applicable margin of 1.125%. Interest rates on base rate loans are equal to the greatest of (a) the rate that the administrative agent announces from time to time as its prime or base commercial lending rate, as in effect from time to time, (b) the sum of (i) the Federal Funds Effective Rate in effect on such day plus (ii) 0.50% and (c) the sum of (i) the Eurodollar rate for a one-month interest period commencing on such day plus (ii) 1.00%.LOCs accrue at the applicable margin rate of 1.125%. At December 31, 2025 and 2024, there are no revolving loan borrowings outstanding under this facility but there are $2.3 million in LOC's outstanding related to the HIMB Project. In both2025 and 2024, the fees associated with these LOCs totaled $26 thousand.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The revolving loan facility carries a commitment fee of 0.125% per annum on the unused portion. Commitment fees are payable quarterly and, in both 2025 and 2024, commitment fee expense related to the Credit Agreement was $3 thousand.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The Credit Agreement specifies a maturity date as the fifth anniversary of the closing date. All loans are due and payable at the maturity date. Voluntary prepayments prior to the maturity date are permitted under the Credit Agreement. In December 2025, the Company executed an amendment to the Credit Agreement that extended the Revolving Loan Facility maturity date through March 31, 2026. The Company plans to renew the Credit Agreement in March 2026.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(c)&lt;/span&gt;&lt;span style="width: 15.14pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Common Terms Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;In connection with the Note Purchase Agreement and Credit Agreement, the Company entered into a Common Terms Agreement with the lenders. This agreement set out certain provisions, conditions, representations and covenants under the Note Purchase Agreement and Credit Agreement. The Common Terms Agreement required compliance with affirmative and negative covenants, including, among other things, financial statement reporting requirements and limitations or restrictions relating to the use of the proceeds, additional indebtedness and disposition of assets. The Company was in compliance with all covenants at December&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31, 2025 and 2024.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt; page-break-after: avoid"&gt; 				&lt;br /&gt;&lt;span&gt;As of December&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31, 2025, minimum principal payments under the Company's financing arrangements for the next five years are as follows (in thousands):&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 89.2%; margin-left: 20.25pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr style="height: 11.1pt"&gt; 					&lt;td style="width: 2.5%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.5%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.5%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.48%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.48%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.48%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 0; text-indent: -27pt; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&