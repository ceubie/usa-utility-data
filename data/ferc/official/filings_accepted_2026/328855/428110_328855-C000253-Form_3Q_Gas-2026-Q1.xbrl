    <link:loc xlink:type="locator" xlink:href="#HH6D09B49321ED2F9175728B9D8D482ABE" xlink:label="HH6D09B49321ED2F9175728B9D8D482ABE" />
    <link:footnote xlink:type="resource" xlink:label="HH3978C194A3728D977432782F218858D7" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong>Schedule Page: 118 Line No.: 1 Column: c</strong>
        </p>
        <p>Sea Robin Pipeline Company, LLC, as a limited liability company, records member's equity in Other Paid-In Capital.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6D09B49321ED2F9175728B9D8D482ABE" xlink:to="HH3978C194A3728D977432782F218858D7" order="1" />
