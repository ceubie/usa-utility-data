  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-1" contextRef="c-1">Vincent Gaeto, Treasurer and Secretary</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:AddressWhereCorporateBooksAreKept id="f-2" contextRef="c-1">15 Buttrick Rd, Londonderry, NH 03053</ferc:AddressWhereCorporateBooksAreKept>
  <ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered id="f-3" contextRef="c-1">New Hampshire: Retail Electric distribution service to customers.</ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-4" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-5" contextRef="c-1">Vincent Gaeto, Treasurer and Secretary</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:StateOfIncorporation id="f-6" contextRef="c-1">NH</ferc:StateOfIncorporation>
  <ferc:IncorporationDate id="f-7" contextRef="c-1">1912-09-09</ferc:IncorporationDate>
