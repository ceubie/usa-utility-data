9.5pt;font-weight:700;line-height:120%"&gt;$&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #000;padding:2px 0;text-align:right;vertical-align:top"&gt;&lt;div style="margin-top:1.7pt;text-align:right"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:9.5pt;font-weight:700;line-height:120%"&gt;12,501&lt;/span&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"&gt;&lt;div style="margin-top:1.7pt;text-align:right"/&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height:15pt"&gt;&lt;td colspan="3" style="border-top:2pt solid #000000;padding:0 1pt"/&gt;&lt;td colspan="3" style="border-top:1.5pt solid #000000;padding:0 1pt"/&gt;&lt;td colspan="3" style="border-top:1.5pt solid #000000;padding:0 1pt"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:0.45pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:79.5pt;text-align:justify;text-indent:-36pt"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:9.5pt;font-weight:400;line-height:100%"&gt;(a)&#160;&#160;&#160;&#160;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:100%"&gt;Storm cost&#160;&#160;&#160;&#160;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.95pt;padding-left:79.5pt;padding-right:10.35pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:100%"&gt;Incurred repair costs resulting from certain storms over or under amounts collected from customers, which are expected to be recovered or refunded through rates.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.65pt;padding-left:79.5pt;text-align:justify;text-indent:-36pt"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:9.5pt;font-weight:400;line-height:100%"&gt;(b)&lt;/span&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:100%"&gt;&#160;&#160;&#160;&#160;Energy costs adjustment&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.95pt;padding-left:79.5pt;padding-right:10.25pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:100%"&gt;The Company's revenue includes a component that is designed to recover the cost of electricity through rates charged to customers. Under deferred energy accounting, to the extent actual purchased power costs differ from purchased power costs recoverable through current rates, that difference is deferred and recorded as a regulatory asset or liability on the balance sheets. These differences are reflected in adjustments to rates and recorded as an adjustment to cost of electricity over the next 12 months, subject to regulatory review.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.8pt;padding-left:79.5pt;text-align:justify;text-indent:-36pt"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:9.5pt;font-weight:400;line-height:100%"&gt;(c) Property taxes&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.95pt;padding-left:79.5pt;padding-right:10.3pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:100%"&gt;In 2019, House Bill 700 established a new method for municipalities to assess utility property and provided for a new mechanism for utilities to adjust rates annually to recover (or refund) changes in property taxes.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.55pt;padding-left:79.5pt;text-align:justify;text-indent:-36pt"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:9.5pt;font-weight:400;line-height:121%"&gt;(d)&lt;/span&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:121%"&gt;&#160;&#160;&#160;&#160;Rate review costs&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:0.6pt;padding-left:79.5pt;padding-right:10.25pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:108%"&gt;Rate review costs represent regulatory costs associated with rate proceedings, not yet incorporated in a regulatory recovery mechanism. The Company anticipates the recovery period of these costs to be between one and three years, commencing upon Commission approval.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.25pt;padding-left:79.5pt;text-align:justify;text-indent:-36pt"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:9.5pt;font-weight:400;line-height:100%"&gt;(e)&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;Income taxes&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.95pt;padding-left:79.5pt;padding-right:10.3pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:100%"&gt;The income taxes regulatory assets and liabilities represent income taxes recoverable through future revenues required to fund flow-through deferred income tax liabilities over the life of the utility plant and amounts owed to customers for deferred taxes collected at a higher rate than the current statutory rates.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt; (f) Deferred incremental depreciation&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:76.5pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;As per rate case settlement agreement DE 23-039, the Company shall be permitted to create a regulatory assets to defer incremental actual depreciation expense included in base distribution rates for capital projects.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.8pt;padding-left:79.5pt;text-align:justify;text-indent:-36pt"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:9.5pt;font-weight:400;line-height:100%"&gt;(g)&#160;&#160;&#160;&#160;Cost of removal&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.9pt;padding-left:79.5pt;padding-right:10.25pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:100%"&gt;Rates charged to customers cover for costs that are expected to be incurred in the future to retire the utility plant. A regulatory liability tracks the amounts that have been collected from customers net of costs incurred to date.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.8pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:9.5pt;font-weight:400;line-height:100%"&gt; (h) RGGI (Regional green house initiative) refund&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:76.5pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;RGGI refund represents amounts to be returned to customers from regional greenhouse initiative auction proceeds as required by the regulatory program. The refund is recorded as a reduction of revenue or a regulatory liability and is returned to customers &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:12pt;padding-left:36pt;text-align:justify;text-indent:-36pt"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:700;line-height:120%;padding-left:26.52pt"&gt;Long-term debt&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.8pt;padding-left:43.5pt;padding-right:10.25pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:100%"&gt;As of December 31, 2025, the Company had outstanding $5,000 of unsecured long-term notes (2024 - $10,000). The interest rates on these unsecured notes range from 7.30%, and the maturity dates is June 2028. The notes have interest-only payments, payable semi-annually. This unsecured note has certain restrictive covenants and acceleration clauses. These covenants stipulate that note holders may declare the debt to be due and payable if total debt becomes greater than 70% of total capitalization.The Company is in compliance with these covenants as at December 31, 2025.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.6pt;padding-left:43.5pt;padding-right:10.4pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:100%"&gt;As of December 31, 2025, the Company had accrued $15 in interest expense (2024 - $81). Interest paid on the long-term debt in 2025 was $564 (2024 - $762).&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.9pt;padding-left:43.5pt;padding-right:10.55pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:400;line-height:100%"&gt;As of December 31, 2025, long-term debt is presented net of deferred financing costs of $0 on the balance sheets (2024 - $9).&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:12pt;padding-left:36pt;text-align:justify;text-indent:-36pt"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:10pt;font-weight:700;line-height:120%;padding-left:26.52pt"&gt;Related party transactions&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:4.85pt;padding-left:43.5pt;padding-right:10.25pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Tahoma',sans-serif;font-size:9.5pt;font-weight:400;line-height:117%"&gt;As of December 31, 2025, the Company has outstanding $108,130 (December 31, 2024 - $9,101) of unsecured long-term promissory notes payable to Liberty Utilities as below:&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:99.702%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.900%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.900%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.900%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.900%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.900%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:700;line-height:120%"&gt;Maturity date&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:700;line-height:120%"&gt;Interest payment&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:700;line-height:120%"&gt;Interest rate&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:700;line-height:120%"&gt;December 31, 2025&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:700;line-height:120%"&gt;December 31, 2024&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-top:2pt solid #05cfff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;December 20, 2027&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="border-top:2pt solid #05cfff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;Semi annual&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="border-top:2pt solid #05cfff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;4.89%&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="border-top:2pt solid #05cfff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:700;line-height:120%"&gt;$5,667&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="border-top:2pt solid #05cfff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;$5,667&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;December 20, 2032&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;Semi annual&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;4.22%&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:700;line-height:120%"&gt;3,434&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;3,434&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;June 26, 2035&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;Semi annual&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:400;line-height:120%"&gt;5.77%&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Trade Gothic',sans-serif;font-size:9.5pt;font-weight:700;line-height:120%"&gt;27,000&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000