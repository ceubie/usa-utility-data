    <ferc:AccumulatedOtherComprehensiveIncomeLossMinimumPensionLiabilityAdjustmentBalance id="f-526" contextRef="c-89" unitRef="u-02" decimals="0">0</ferc:AccumulatedOtherComprehensiveIncomeLossMinimumPensionLiabilityAdjustmentBalance>
    <ferc:AccumulatedOtherComprehensiveIncomeLossOtherAdjustmentsToComprehensiveIncomeLossBalance id="f-527" contextRef="c-89" unitRef="u-02" decimals="0">0</ferc:AccumulatedOtherComprehensiveIncomeLossOtherAdjustmentsToComprehensiveIncomeLossBalance>
    <ferc:AccumulatedOtherComprehensiveIncomeLossOtherCashFlowHedgesBalance id="f-528" contextRef="c-89" unitRef="u-02" decimals="0">0</ferc:AccumulatedOtherComprehensiveIncomeLossOtherCashFlowHedgesBalance>
    <ferc:AccumulatedOtherComprehensiveIncomeLossOtherCashFlowHedgesInterestRateSwapsBalance id="f-529" contextRef="c-89" unitRef="u-02" decimals="0">-6171630</ferc:AccumulatedOtherComprehensiveIncomeLossOtherCashFlowHedgesInterestRateSwapsBalance>
    <ferc:AccumulatedOtherComprehensiveIncomeLossUnrealizedGainsAndLossesOnAvailableForSaleSecuritiesBalance id="f-530" contextRef="c-89" unitRef="u-02" decimals="0">0</ferc:AccumulatedOtherComprehensiveIncomeLossUnrealizedGainsAndLossesOnAvailableForSaleSecuritiesBalance>
    <ferc:AdditionsToUnappropriatedRetainedIncome id="f-532" contextRef="c-55" unitRef="u-02" decimals="0">242524884</ferc:AdditionsToUnappropriatedRetainedIncome>
    <ferc:DeductionsFromUnappropriatedRetainedIncome id="f-533" contextRef="c-55" unitRef="u-02" decimals="0">0</ferc:DeductionsFromUnappropriatedRetainedIncome>
    <ferc:NetIncreaseDecreaseInUnappropriatedRetainedIncome id="f-534" contextRef="c-55" unitRef="u-02" decimals="0">242524884</ferc:NetIncreaseDecreaseInUnappropriatedRetainedIncome>
    <ferc:UnappropriatedRetainedIncomeCreditTransferredFromIncome id="f-535" contextRef="c-55" unitRef="u-02" decimals="0">242524884</ferc:UnappropriatedRetainedIncomeCreditTransferredFromIncome>
    <ferc:EquityInEarningsLossesOfAffiliatedCompanies id="f-536" contextRef="c-89" unitRef="u-02" decimals="0">135650930</ferc:EquityInEarningsLossesOfAffiliatedCompanies>
    <ferc:UnappropriatedRetainedIncome id="f-537" contextRef="c-89" unitRef="u-02" decimals="0">242524884</ferc:UnappropriatedRetainedIncome>
    <ferc:NotesToFinancialStatementsTextBlock id="f-539" contextRef="c-55">&lt;div&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="font-size: 10pt"&gt;NOTE A - ORGANIZATION, OPERATIONS AND BASIS OF PRESENTATION&lt;/span&gt;&lt;/b&gt;&lt;span style="font-size: 10pt"&gt;:&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="font-size: 10pt"&gt;Organization.&lt;/span&gt;&lt;/b&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt"&gt;NuStar Logistics L.P. (&amp;quot;NuStar Logistics&amp;quot;) is a Delaware limited partnership which wholly owns NuStar Supply &amp;amp; Trading LLC,&lt;span style="color: rgba(73, 80, 87, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;a Delaware limited liability company, Nustar Permian Holdings, LLC, a Delaware limited liability company and NuStar Finance LLC,&lt;span style="color: rgba(73, 80, 87, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;&amp;#160;&lt;/span&gt;&lt;span style="color: rgba(73, 80, 87, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;a Delaware limited liability company&lt;span style="color: rgba(73, 80, 87, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;. Nustar also owns 99.99% of NuStar Internacional, S. de R.L. de C.V., a Mexican company. Nustar Logistics is owned 100% by Sunoco LP,&lt;span style="color: rgba(73, 80, 87, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal"&gt;&amp;#160;&lt;/span&gt;&lt;span style="color: rgba(73, 80, 87, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;a Delaware limited partnership.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(51, 51, 51, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="color: rgba(73, 80, 87, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none"&gt;Effective July 24, 2025, Star Creek Ranch, LLC, a limited liability company incorporated in Delaware and previously wholly owned by NuStar Logistics, has been cancelled.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(51, 51, 51, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="color: rgba(73, 80, 87, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none"&gt;&lt;br /&gt;&lt;/span&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="font-size: 10pt"&gt;Operations.&lt;/span&gt;&lt;/b&gt;&lt;span style="font-size: 10pt"&gt;&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;NuStar Logistics owns pipeline systems and storage terminal assets. The pipelines transport crude oil, refined petroleum products, including gasoline, diesel, and propane throughout Texas, Colorado, New Mexico and Oklahoma.&lt;/span&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 1rem"&gt;&lt;b style="font-weight: bold; color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: normal"&gt;&lt;span style="font-size: 10pt"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 1rem"&gt;&lt;b style="font-weight: bold; color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: normal"&gt;&lt;span style="font-size: 10pt"&gt;Undivided Joint Interest.&lt;/span&gt;&lt;/b&gt;&lt;span style="font-size: 10pt"&gt;Nustar Logistics has an undivided joint interest of 50% in the ATA Products Pipeline, 66.67% in El Paso Products Pipeline, and 50% in SAAL Products Pipeline.&lt;/span&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 1rem"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="font-size: 10pt"&gt;Regulation&lt;/span&gt;&lt;/b&gt;&lt;span style="font-size: 10pt"&gt;. NuStar Logistic's transportation activities are subject to regulation by the Federal Energy Regulatory Commission (&amp;quot;FERC&amp;quot;) and various state authorities. Regulatory bodies exercise statutory authority over matters such as rates, underlying accounting practices, and rate-making agreements with customers.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;span lang="en-US" style="color: rgba(73, 80, 87, 1); font-family: Arial, Helvetica, sans-serif; font-size: small; font-style: normal; text-align: left; text-indent: 0; white-space: normal; font-weight: bold; line-height: 14.2667px"&gt;Basis of Presentation.&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(73, 80, 87, 1); font-family: Arial, Helvetica, sans-serif; font-size: small; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;T&lt;/span&gt;&lt;span lang="en-US" style="color: rgba(73, 80, 87, 1); font-family: Arial, Helvetica, sans-serif; font-size: small; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; line-height: 14.2667px"&gt;he f&lt;/span&gt;&lt;span lang="en-US" style="color: rgba(73, 80, 87, 1); font-family: Arial, Helvetica, sans-serif; font-size: small; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; line-height: 14.2667px"&gt;inancial statements presented herein are prepared in accordance with the accounting requirements of the FERC, as set forth in the applicable Uniform System of Accounts and published accounting releases, which is a comprehensive basis of accounting other than accounting principles generally accepted in the United States of America (&amp;quot;GAAP&amp;quot;). T&lt;span style="color: rgba(73, 80, 87, 1); font-family: Arial, Helvetica, sans-serif; font-size: small; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;he most significant differences between GAAP and the financial statements presented herein are: (1) subsidiaries are reflected on the equity method whereas GAAP requires that all majority-owned subsidiaries be consolidated (2) classification of certain accounts on the balance sheet, statement of income and the statement of cash flows and (3) use of FERC approved depreciation rates.&lt;/span&gt;&lt;/span&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="font-size: 10pt; color: rgba(0, 0, 0, 1)"&gt;NOTE B - SUMMARY OF SIGNIFICANT ACCOUNTING POLICIES AND OTHER MATTERS:&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="text-decoration: underline"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Use of Estimates&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;The preparation of financial statements requires management to make estimates and assumptions that affect the reported amounts of assets and liabilities and disclosure of contingent assets and liabilities at the date of the financial statements and the reported amounts of revenues and expenses during the reporting period.&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;Actual results could differ from those estimates.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="text-decoration: underline"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Property, Plant and Equipment&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;NuStar Logistics capitalizes expenditures related to property, plant and equipment that have a useful life greater than one year for (1) assets purchased or constructed; (2) existing assets that are replaced or improved; or (3) land regardless of cost. During construction,&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;NuStar Logistics&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;capitalizes direct costs, such as labor, materials and overhead.&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;NuStar Logistics&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;records property, plant and equipment at its original cost. Depreciation is computed on a composite straight-line method at rates based on the expected economic lives of the various classes of assets.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="text-decoration: underline"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Accounts Receivable and Allowance for Credit Losses&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;Accounts receivables are carried at the amount owed by customers less an allowance for credit losses, if deemed necessary.&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;NuStar Logistics&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;evaluates the collectability of accounts receivable based on review of a specific customer's ability to meet its financial obligation or as a result of changes in the overall aging of accounts receivable.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;NuStar Logistics's allowance for credit losses was not material as of December 31, 2025 and 2024.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="text-decoration: underline"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Revenue Recognition&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="font-size: 10pt"&gt;Contract Balances with Customers&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;NuStar Logistics&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;satisfies its obligations by transferring goods or services in exchange for consideration from customers. The timing of performance may differ from the timing that the associated consideration is received from the customer, thus resulting in the recognition of a contract liability.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;NuStar Logistics&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;recognizes a contract liability if the customer's payment of consideration precedes&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;NuStar Logistics&lt;/span&gt;'s fulfillment of the performance obligations. Certain contracts contain provisions requiring customers to pay a fixed fee for services but allow customers to apply such fees against services to be provided at a future point in time. These amounts are reflected as deferred revenue until the customer applies the deficiency fees to services provided or becomes unable to use the fees as payment for future services due to expiration of the contractual period the fees can be applied or physical inability of the customer to utilize the fees due to capacity constraints.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="font-size: 10pt"&gt;Performance Obligations&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;At contract inception,&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;NuStar Logistics&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;assesses the goods and services promised in its contracts with customers and identifies a performance obligation for each promise to transfer a good or service that is distinct.&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;Revenue is recognized when (or as) the performance obligations are satisfied, that is, when the customer obtains control of the good or service.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;NuStar Logistics&lt;/span&gt; does not own the crude oil or the refined petroleum products that it transports or stores.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="text-decoration: underline"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Income Taxes&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;NuStar Logistics&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;is a limited partnership that passes the federal income tax liability through to its members and does not recognize this liability on its financial statements.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="text-decoration: underline"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Environmental Remediation&lt;/span&gt;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;NuStar Logistics&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;accrues environmental remediation costs for work at identified sites where an assessment has indicated that cleanup costs are probable and reasonably estimable. Such accruals are undiscounted and are based on currently available information, estimated timing of remedial actions and related inflation assumptions, existing technology and presently enacted laws and regulations. If a range of probable environmental cleanup costs exists for an identified site, the minimum of the range is accrued unless some other point or points in the range are more likely, in which case the most likely amount in this range is accrued.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: Arial, sans-serif"&gt;&lt;b style="font-weight: bold"&gt;&lt;span style="font-size: 10pt; color: rgba(0, 0, 0, 1)"&gt;NOTE C - SUPPLEMENTAL CASH FLOW INFORMATION:&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;span style="font-family: Arial, sans-serif; background: rgba(0, 0, 0, 0)"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto, &amp;quot;Segoe UI&amp;quot;, GeezaPro, &amp;quot;DejaVu Serif&amp;quot;, &amp;quot;sans-serif&amp;quot;, -apple-system, BlinkMacSystemFont; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"&gt;&lt;span style="font-family: Arial, sans-serif; background: rgba(0, 0, 0, 0)"&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;Accrued capital expenditures as of December 31, 2025 and 2024 were $3 million and $55 million, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(73, 80, 87, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif; background: rgba(0, 0, 0, 0)"&gt;&lt;span style="color: rgba(51, 51, 51, 1); font-family: Arial, sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"&gt;Non-Cash settlements of Affiliate Payables for the year ended December 31, 2025 and 2024 were $65 million and $1.9 billion, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(73, 80, 87, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif; background: rgba(0, 0, 0, 0)"&gt;Non-Cash settlement of Investments in Affiliates for the year ended December 31, 2025 and 2024 were $24 million and $2 billion, respectively.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; color: rgba(73, 80, 87, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif; background: rgba(0, 0, 0, 0)"&gt;&lt;br /&gt;&lt;/span&gt;&lt;br style="color: rgba(73, 80, 87, 1); font-family: &amp;quot;Times New Roman&amp;quot;, serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal" /&gt;  &lt;/p&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
    <ferc:DescriptionOfAssetsOrOfTransaction id="f-541" contextRef="c-91">Affiliate receivable for services and materials</ferc:DescriptionOfAssetsOrOfTransaction>
    <ferc:DescriptionOfAssetsOrOfTransaction id="f-542" contextRef="c-94">Affiliate receivable for services</ferc:DescriptionOfAssetsOrOfTransaction>
    <ferc:DescriptionOfAssetsOrOfTransaction id="f-543" contextRef="c-92">Affiliate receivable for services and materials</ferc:DescriptionOfAssetsOrOfTransaction>
    <ferc:DescriptionOfAssetsOrOfTransaction id="f-544" contextRef="c-93">Affiliate receivable for transporation and delivery services</ferc:DescriptionOfAssetsOrOfTransaction>
    <ferc:DescriptionOfAssetsOrOfTransaction id="f-545" contextRef="c-95">Minor accounts, each less than $500,000</ferc:DescriptionOfAssetsOrOfTransaction>
