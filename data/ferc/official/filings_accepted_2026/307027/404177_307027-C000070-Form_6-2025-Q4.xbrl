    <ferc:ChangesInAccumulatedOtherComprehensiveIncomeLoss id="f-523" contextRef="c-55" unitRef="u-02" decimals="0">-5468498</ferc:ChangesInAccumulatedOtherComprehensiveIncomeLoss>
    <ferc:ComprehensiveIncomeLoss id="f-524" contextRef="c-55" unitRef="u-02" decimals="0">235413718</ferc:ComprehensiveIncomeLoss>
