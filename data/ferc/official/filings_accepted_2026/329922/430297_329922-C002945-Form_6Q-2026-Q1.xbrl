  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-06-09</ferc:ReportDate>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;strong&gt;Basis of Accounting&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;DCP Southern Hills Pipeline, LLC is subject to regulation by the Federal Energy Regulatory Commission (FERC). The accounting policies followed in preparation of these financial statements generally conform to those required by FERC.&lt;/p&gt;
&lt;p&gt;&lt;strong&gt;Pipeline Operator&lt;/strong&gt;&lt;/p&gt;
&lt;p&gt;Respondent has no employees.&lt;/p&gt;
&lt;p&gt;Respondent's properties are operated by Phillips 66 Pipeline LLC 66 as agent.&lt;/p&gt;
&lt;p&gt;&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
  <ferc:DisclosureOfRespondentAppearingInAnnualReportToTheStockholdersTextBlock id="HH5E4D37729B3C0D95B1347B63AFD3C1FF" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfRespondentAppearingInAnnualReportToTheStockholdersTextBlock>
