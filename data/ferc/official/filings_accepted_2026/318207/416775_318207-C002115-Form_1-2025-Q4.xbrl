oyee benefits&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 81.9pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;(8)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 75.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;(74)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 270pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;Valuation allowance&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 81.9pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;