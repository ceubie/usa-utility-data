: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;(298)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 276.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 18.8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 26.15pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Total income tax expense&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;937&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;352&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Federal income tax returns for the Company have either been examined and reported on by the Internal Revenue Service (&amp;quot;IRS&amp;quot;) or closed by statute through 2021.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Income taxes related to decommissioning activity are recorded in the accounts of the CY Decommissioning Trust.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The fol