60;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;23,615&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 51pt; padding-right: 6pt; padding-left: 6pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 							&lt;span style="width: 3pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;2,958&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 42pt; padding-right: 6pt; padding-left: 6pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 							&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;33,603&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 42pt; padding-right: 6pt; padding-left: 6pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 							&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;1,638&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 42pt; padding-right: 6pt; padding-left: 6pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 							&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;344&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 0"&gt; 					&lt;td style="width: 67.5pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 59.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;The Nonqualified Trust Fund is a &amp;quot;Grantor&amp;quot; Trust and any federal income tax resulting from earnings of the Trust is reported on the Company's tax return. The Nonqualified Trust Fund reimburses the Company for any income tax liabilities created by the taxable earnings of the Nonqualified Trust Fund investments. The Qualified Trust Fund is a separate taxable entity for federal income tax purposes. Contributions by the Company to the Qualified Trust Fund are deductible, subject to the IRS Approved Schedule of Ruling Amounts; and decommissioning expense withdrawals by the Company represent taxable income.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;The Nuclear Waste Policy Act of 1982 (&amp;quot;NWPA&amp;quot;) provides that the DOE is responsible for the disposal of Spent Nuclear Fuel (&amp;quot;SNF&amp;quot;) and high-level radioactive waste. As required by the NWPA, electric utilities generating SNF and high-level waste are obligated to pay fees into a fund that is to be used to cover the cost of siting, constructing, developing, and operating a disposal facility for this waste.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;In accordance with the Standard Contract between CY and the DOE, in return for payment by the Company of fees prescribed by the NWPA, the DOE is to take title to and dispose of the Company's high-level wastes and SNF. Fees for disposal of nuclear fuel burned on or after April&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;7, 1983 were billed to Shareholder/Sponsors and paid to the DOE on a quarterly basis. For nuclear fuel used to generate electricity prior to April 7, 1983 (&amp;quot;prior-period fuel&amp;quot;), payment may be made any time prior to the first delivery of spent fuel to the DOE. Until such payment for the disposal of prior-period fuel is made to the DOE, the outstanding balance due will continue to accrue interest at the 90-day Treasury bill yield rate, compounded quarterly. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;In 1990, CY established the Spent Fuel Disposal Trust (&amp;quot;SFT&amp;quot;), for the purpose, among other things, to assure CY's financial ability to meet its DOE obligation for payment of the one-time fee with respect to the disposal of prior-period fuel under the NWPA. The Company merged the Spent Fuel Trust Fund into the Nuclear Decommissioning Trust on August 1, 2000 according to the terms of a FERC settlement agreement. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;Since the DOE prior-period fuel disposal obligation was well-funded in 2018, with a rising interest rate environment impending, the Company elected to negotiate an amendment to its Standard Contract with the DOE in order to make a partial payment of the obligation. On December 19, 2018 an amendment to the Standard Contract was executed allowing for partial payments. Accordingly, on December 20, 2018 the Company made a partial payment of $145 million to the DOE towards disposal of prior-period fuel of which $38.2 million was principal and $106.8 million was interest. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;Further, on December 10, 2019, the Company made another substantial partial payment of $29 million to the DOE of which $7.5 million was principal and $21.5 million was interest. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;On November 20, 2024, the Company made a third partial payment of $7.5 million to the DOE of which $1.725 million was principal and $5.775 million was interest. As of December 31, 2025 fees due to the DOE for the disposal of prior-period fuel were approximately $5.9 million of which $1.3 million is the principal and $4.6 million is the accrued interest. As part of the 2000 FERC Rate Settlement, payments toward this obligation are to be made from the decommissioning trust.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;The DOE was scheduled to begin accepting delivery of spent fuel on January 31, 1998. The DOE's current estimate for an available disposal site is after 2040. Until the federal government begins accepting nuclear waste for disposal, the Company will need to retain high-level waste and spent fuel on-site or find some other currently available means of storage. The decommissioning cost estimate included in the Company's September 18, 2024 FERC Filing assumes continued long-term storage of spent fuel on site. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 97%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE H - EMPLOYEE BENEFITS&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;1.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Post-retirement Benefits Other than Pensions&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company maintains a post-retirement welfare benefit plan for employees who retire from active service after meeting specified age and service requirements. Beginning January 1, 2025, the Company pays 100% of the medical premiums for retirees. In 2024, the Company paid 100% of the premiums for certain retirees and other retirees contributed to the cost of the medical premiums. At age 65, the medical insurance converts to a Medicare Advantage Plan. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;CY's post-retirement welfare benefit plan is funded through a trust that is intended to qualify as a voluntary employee beneficiary association (VEBA) under IRC Section 501(c)(9). The VEBA trust funds the benefits for non-key employees. The benefits for key employees (as defined in IRC Section 416) are paid out of Company assets. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Accrued and prepaid benefit costs recognized in the balance sheets at December 31, 2025 and 2024 have offsetting regulatory assets and liabilities, respectively, as they are expected to be included in billing in future years.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In accordance with FASB ASC 715, &lt;/span&gt;&lt;span style="font-style: italic"&gt;Compensation--Retirement Benefits&lt;/span&gt;&lt;span&gt;, the Company recognizes an asset or liability in its balance sheet for the over-funded or under-funded status of its post-retirement plan. The post-retirement asset or liability is the difference between the fair value of the plans' assets and the projected benefit obligations as of year-end. In accordance with ASC 980, the Company has recorded regulatory assets or liabilities in lieu of taking a charge or credit to accumulated other comprehensive income.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The following tables represent the plan's beginning benefit obligation balance reconciled to the ending benefit obligation balance, beginning fair value of plan's assets balance reconciled to the ending fair value of plan's assets balance and the fund's funded status reconciled to the balance sheets, along with other information about the plan:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 501pt; border-collapse: collapse"&gt; 				 					&lt;tr&gt; 						&lt;td style="width: 226.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="4" style="width: 274.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span style="width: 176.42pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;December 31,&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr style="height: 15.7pt"&gt; 						&lt;td style="width: 226.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 135pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 139.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 								&lt;span style="text-decoration: underline"&gt;Post-retirement Benefits&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 226.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 72pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 								&lt;span style="font-weight: bold; text-decoration: underline"&gt;2025&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 								&lt;span style="text-decoration: underline"&gt;2024&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 				 				 					&lt;tr style="page-break-inside: avoid"&gt; 						&lt;td style="width: 226.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="4" style="width: 274.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span style="width: 155.79pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt; (Dollars in Thousands)&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 226.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span style="font-weight: bold"&gt;Change in benefit obligation:&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 72pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 226.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span&gt;Benefit obligation, beginning of year&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 72pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span style="width: 12pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;$&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;7,696&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-after: avoid"&gt; 								&lt;span style="width: 12pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;6,234&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 	