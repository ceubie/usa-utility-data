5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span style="width: 17.1pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;53&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 77pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span style="width: 17.1pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;85&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 269.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 								&lt;span&gt;Deferred tax liabilities:&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 		