: 0; margin-left: 18pt; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span style="width: 17.1pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;(10,036)&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 77pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span style="width: 17.1pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;(9,537)&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 269.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0; font-size: 8pt"&gt; 								&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0; font-size: 8pt"&gt; 								&lt;span style="width: 17.1pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 77pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0; font-size: 8pt"&gt; 								&lt;span style="width: 17.1pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 269.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span style="width: 45pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Net deferred tax liability&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span style="width: 17.1pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;(9,983)&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 77pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span style="width: 17.1pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;(9,452)&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 				 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The valuation allowance at December 31, 2025 and 2024 is primarily the result of uncertainty of realizing tax benefits associated with the Company's long-term medical and other employee retirement benefits.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE F - ASSET RETIREMENT OBLIGATION&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company accounts for its Asset Retirement Obligation (&amp;quot;ARO&amp;quot;) in accordance with FASB ASC 410, &lt;/span&gt;&lt;span style="font-style: italic"&gt;Asset Retirement and Environmental Obligations&lt;/span&gt;&lt;span&gt;. Under ASC 410, entities are required to record the fair value of a legal liability for an ARO in the period in which it is incurred. In determining the ARO, the Company considered the uncertainties of the fuel off load dates related to the DOE's timing of performance regarding its obligation to dispose of the spent nuclear fuel and high-level waste. The Company estimates the fair value of the ARO using present value techniques in which it makes various assumptions including estimates of the amounts and timing of future cash flows and credit adjusted risk free rates for changes in cash flows (for 2025, there were no changes made to the cash flow assumptions that were included in the Decommissioning Cost Estimate filed and accepted by FERC in 2024; 5.6% was used in 2024.)&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt; The ARO is reported in the Balance Sheets. When the Company revises any of the assumptions used to calculate the fair value of the ARO, it adjusts the carrying amount of both the ARO liability and the related regulatory asset or liability.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The following table presents the details of the Company's ARO which is presented as Deferred Credits in the accompanying balance sheets:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 477pt; border-collapse: collapse"&gt; 				 					&lt;tr&gt; 						&lt;td style="width: 279pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="3" style="width: 198pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span&gt;December 31,&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 279pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 96.75pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="font-weight: bold; text-decoration: underline"&gt;2025&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 101.25pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="text-decoration: underline"&gt;2024&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 279pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="3" style="width: 198pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span&gt;(Dollars in Thousands)&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 				 				 					&lt;tr&gt; 						&lt;td style="width: 279pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; font-size: 8pt"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid; font-size: 8pt"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid; font-size: 8pt"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 279pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span&gt;Beginning balance&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;$&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;226,588&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;184,435&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 279pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span&gt;Accretion&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;14,234&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;11,845&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 279pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span&gt;Settled&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;(13,649)&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;(14,305)&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 279pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span&gt;Adjusted&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;(3,548)&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;44,613&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 279pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span&gt;Ending Balance&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;223,625&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 99pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;226,588&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr style="height: 0"&gt; 						&lt;td style="width: 279pt"&gt; 						&lt;/td&gt; 						&lt;td style="width: 96.75pt"&gt; 						&lt;/td&gt; 						&lt;td style="width: 2.25pt"&gt; 						&lt;/td&gt; 						&lt;td style="width: 99pt"&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 				 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 11.65pt; widows: 0; orphans: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 11.65pt; widows: 0; orphans: 0"&gt; 				&lt;span&gt;As of January 1, 2003, the value of the plant balance which generated the ARO was fully depreciated. The incremental asset recorded as an offset to the ARO was fully depreciated as well, since the plant asset had no remaining useful life. In accordance with ASC 980, the Company recorded no income statement impact for either the cumulative depreciation charged on the incremental asset or the reduction of liability recorded.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 11.65pt; widows: 0; orphans: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The assets included in the Decommissioning Trust are restricted for settling the ARO and all other decommissioning obligations.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE G - DECOMMISSIONING &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Decommissioning Trust was established under the Indenture of Trust dated April&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;30, 1984, and last revised January 1, 2010. The purpose of the Trust is to provide segregated funds to pay for the cost of decommissioning the Plant, including the ISFSI.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In April 1987, the Trust Indenture was revised to reflect Section 468A of the Internal Revenue Code (&amp;quot;IRC&amp;quot;). In conjunction with this revision, the Trust was segregated into a Qualified Trust Fund and a Nonqualified Trust Fund. The Qualified Trust Fund is a nuclear decommissioning reserve fund, as defined in Section 468A, and is administered under that section of the IRC. As approved by the IRS, the Trust elected to be taxed under the provisions of Section 468A, effective for tax years (calendar years) ending after July 18, 1984. Qualifying contributions are deductible when paid by the Company and are limited to the amount approved by the IRS. The Nonqualified Trust Fund is not subject to Section 468A and is administered in accordance with the indenture provisions. The Company has provided for decommissioning costs in accordance with FERC rate orders and NRC regulations. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;Components of the Decommissioning Trust are set forth in the following table: &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="border-collapse: collapse"&gt; 				&lt;tr&gt; 					&lt;td style="width: 279pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 169.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-inside: avoid; page-break-after: avoid"&gt; 							&lt;span&gt;December 31,&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 279pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&g