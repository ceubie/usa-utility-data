&gt; 					&lt;td style="width: 84pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;(5,891)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;(5,647)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 279pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;Deferred tax liabilities&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 84pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;(2,943)&lt;/span&gt;