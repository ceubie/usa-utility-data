					&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 5.4pt"&gt; 					&lt;td style="width: 152.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;Asset Retirement Obligation (Note F)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 12.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 45.67pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;-&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 83.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 12.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 45.67pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;-&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 60.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 12.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 3pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;226,588&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 13.35pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 12pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;226,588&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;(a) &lt;/span&gt;&lt;span style="width: 4.4pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;This category includes investments in equity securities of large-, small- and medium-sized companies.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;(b) &lt;/span&gt;&lt;span style="width: 3.84pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;This category includes equity securities of foreign companies, including those in developing countries.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; text-align: left"&gt; 				&lt;span&gt;(c) &lt;/span&gt;&lt;span style="width: 4.4pt; text-indent: 0; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;This category includes investments in domestic corporate and/or government investment grade fixed-income instruments.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;(d) &lt;/span&gt;&lt;span style="width: 3.84pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;This category includes investments in debt securities of foreign companies.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; text-align: left"&gt; 				&lt;span&gt;(e) &lt;/span&gt;&lt;span style="width: 4.4pt; text-indent: 0; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;This category includes investments in pooled funds which can include both domestic and foreign equity securities and debt instruments.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;(f) &lt;/span&gt;&lt;span style="width: 5.51pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;This category consists of cash and cash equivalents.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 37.5pt"&gt; 				&lt;span&gt;Investments in the plant decommissioning trust, other trusts, and the Company's asset retirement obligation are presented as fair values. Investments are exposed to various risks, such as interest rates, credit and overall market volatility. As such, it is reasonably possible that changes in the values of investment will occur in the near term and that such changes could materially affect the amounts reported in the balance sheets.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: 19.5pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 37.5pt; margin-bottom: 0; text-indent: -19.5pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;7.&lt;/span&gt;&lt;span style="width: 12pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Use of Estimates &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The preparation of financial statements in conformity with accounting principles generally accepted in the United States of America requires management to make estimates and assumptions that affect the reported amounts of assets, liabilities, disclosure of contingent assets and liabilities at the date of the financial statements, and the reported amounts of revenues and expenses during the reporting period. Significant estimates include assumptions used to determine accumulated plan benefits, future estimates of market values of investments, closure costs, asset retirement obligations and the deferred tax valuation allowance. Actual results could differ from those estimates.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: 19.5pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 37.45pt; margin-bottom: 0; text-indent: -19.45pt; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;8.&lt;/span&gt;&lt;span style="width: 11.95pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Benefit Plan Risks&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The actuarial present value of accumulated plan benefits is prepared based on certain assumptions pertaining to interest rates, inflation rates, and employee demographics, all of which are subject to change. Due to uncertainties inherent in the estimations and assumptions process, it is at least reasonably possible that changes in these estimates and assumptions in the near term would be material to the financial statements.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;br style="page-break-before: always; clear: both" /&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 37.5pt; margin-bottom: 0; text-indent: -19.5pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;9.&lt;/span&gt;&lt;span style="width: 12pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Affiliated Services&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In 2025 and 2024, Yankee Atomic Electric Company (&amp;quot;YA&amp;quot;), Maine Yankee Atomic Power Company (&amp;quot;MY&amp;quot;), and CY shared financial, technical, and management services. The following table represents the costs of services shared among CY, MY, and YA. &lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="margin-left: 113.4pt; border-collapse: collapse"&gt; 				&lt;tr&gt; 					&lt;td style="width: 114.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 112.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span style="font-weight: bold; text-decoration: underline"&gt;2025&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 113.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span style="text-decoration: underline"&gt;2024&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 114.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 112.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 113.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 114.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;CY to MY&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 112.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 30.6pt; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="font-weight: bold"&gt;$0.8 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 113.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 35.1pt; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;$0.6 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 114.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;CY to YA&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 112.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 30.6pt; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="font-weight: bold"&gt;$0.8 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 113.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 35.1pt; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;$0.6 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 114.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;MY to CY&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 112.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 30.6pt; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="font-weight: bold"&gt;$0.4 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 113.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 35.1pt; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;$0.3 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 114.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;YA to CY&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 112.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 30.6pt; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="font-weight: bold"&gt;$1.0 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 113.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 35.1pt; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;$1.0 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 37.5pt; margin-bottom: 0; text-indent: -19.5pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;10.&lt;/span&gt;&lt;span style="width: 7pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Regulatory Accounting and Assets &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The accounting policies of the Company and the accompanying financial statements conform to accounting principles generally accepted in the United States of America applicable to rate-regulated enterprises and reflect the effects of the ratemaking process in accordance with FASB ASC 980, &lt;/span&gt;&lt;span style="font-style: italic"&gt;Regulated Operations&lt;/span&gt;&lt;span&gt;. Assuming a cost-of-service based regulatory structure, regulators may permit incurred costs, normally treated as expenses, to be deferred and recovered through future rates. Through their actions, regulators may also reduce or eliminate the value of an asset or create a liability. If any portion of the Company's operations were no longer subject to the provisions of ASC 980 as a result of a change in the cost-of-service based regulatory structure, the Company would be required to write off related regulatory assets and liabilities. Based on current regulation, the Company believes that its use of regulatory accounting remains appropriate.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 37.5pt; margin-bottom: 0; text-indent: -19.5pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;11.&lt;/span&gt;&lt;span style="width: 7pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Subsequent Events&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;For purposes of preparation of these financial statements in conformity with U.S. generally accepted accounting principles, the Company has considered transactions or events occurring through April 22, 2026, which was the date the financial statements were available to be issued.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE B - CONCLUSION OF PHASE I, II, III and PHASE IV LITIGATION WITH THE U.S. DEPARTMENT OF ENERGY (DOE)&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;Since 1998, CY, along with MY and YA, have sought damages from the DOE related to breach of contract.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase I&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On December 5, 2012, the DOE's right to appeal the Judgment in the Company's Phase I Litigation expired and the Judgment became final. The damages awarded to the Company for Phase I Litigation were $39.7 million. In December 2012, the Department of Justice submitted the required paperwork to the United States Treasury to initiate payment to the Company. A receivable for the award was recorded for both financial statement and tax reporting in December 2012. The proceeds were received on January 25, 2013 and deposited into the Nonqualified Nuclear Decommissioning Trust (&amp;quot;NDT&amp;quot;) pending the outcome of the Company's 2013 FERC Filing. The FERC Filing was approved on June 27, 2013 and resulted in the return of the full $39.7 million of proceeds to the Company's wholesale customers. In addition, in July 2013, the Company ceased billing its wholesale customers for the estimated costs of funding decommissioning and long-term fuel storage; see Note C - &amp;quot;Rate Proceedings,&amp;quot; and Note G - &amp;quot;Decommissioning.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase II&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On January 14, 2014, the DOE's right to appeal the Judgment in the Company's Phase II Litigation expired and the Judgment became final. The damages awarded to the Company for Phase II Litigation were $126.3 million. In January 2014, the Department of Justice submitted the required paperwork to the United States Treasury to initiate payment to the Company. The Company recorded the receivable in January 2014 when the period for appeals passed and it became likely that such damages would be paid. The damages proceeds of $126.3 million were received on March 28, 2014. On June 5, 2014, the full amount of the proceeds was returned to the Company's wholesale customers in accordance with the Company's 2014 FERC Filing.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase III&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On July 18, 2016, the DOE's right to appeal the Judgment in the Company's Phase III Litigation expired and the Judgment become final. The damages awarded to the Company for Phase III Litigation were $32.6 million. In July 2016, the Department of Justice submitted the required paperwork to the United States Treasury to initiate payment to the Company. The Company recorded the receivable in July 2016 when the period for appeals passed and it became likely that such damages would be paid. The damage proceeds of $32.6 million were received on October 14, 2016. In accordance with the Company's October 2016 Informational FERC Filing, $18.4 million of the proceeds were returned to the Company's wholesale customers on December 15, 2016. In addition, $.6 million of proceeds were deposited in the Company's irrevocable external trust to fund Post Retirement Benefits Other Than Pension (&amp;quot;PBOP&amp;quot;), and $.4 million of proceeds were used to pay the associated taxes. The remaining proceeds were deposited into the Decommissioning Trust Fund to fund long-term ISFSI operations and decommissioning costs; see Note C - &amp;quot;Rate Proceedings.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase IV&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On February 21, 2019, the United States Court of Federal Claims rendered a summary judgment associated with uncontested damages in the Phase IV litigation with the DOE and awarded the Company $40.7 million. This left $.5 million remaining in dispute for resolution at trial which was scheduled for June 2019. On April 23, 2019, the DOE's right to appeal the Judgment related to the uncontested damages in the Company's Phase IV Litigation expired and the Judgment become final. The Company recorded the receivable in April 2019 when the period for appeals passed and it became likely that such damages would be paid. The uncontested damage proceeds of $40.7 million were received on June 11, 2019. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Additionally, in lieu of incurring the expense of a trial, the Company and the DOE negotiated an Offer of Settlement associated with the contested damages. On June 12, 2019, the court accepted the Offer of Settlement which entitled the Company to additional proceeds in the amount of $.155 million. The Company recorded this receivable in June 2019 when the court accepted the Offer of Settlement. These additional proceeds were received on July 16, 2019. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Following FERC's acceptance of the Company's rate filings as required upon receipt of DOE proceeds, on December 10, 2019, $29.0 million of the proceeds were paid to the DOE for a substantial partial payment of the Company's Pre-1983 Spent Fuel Obligation; $.146 million for lobbying expense was credited to the Statement of Income to reimburse Sponsor Companies for these previously incurred costs; $.169 million was used to offset the regulatory asset that was established as a result of a permanent loss of deferred income tax assets that the Company recorded when implementing the Tax Cuts and Jobs Act; and, the balance of proceeds in the amount of $11.5 million, less estimated income taxes, was transferred to the Decommissioning Trust Fund to fund long term ISFSI Operations costs and to meet the balance of the DOE Pre-1983 Spent Fuel Obligation; see Note C - &amp;quot;Rate Proceedings.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;For further discussion of litigation that resulted from DOE's failure to assume responsibility for disposal of such spent fuel; see Note I &amp;quot;Commitments and Contingencies&amp;quot; - &amp;quot;DOE Spent Fuel Litigation.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE C - RATE PROCEEDINGS&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On July 1, 2004, CY filed a rate application seeking additional funding to complete decommissioning and store spent fuel through 2023. The filing proposed increased decommissioning charges and the addition of new schedules for pension and post-retirement benefits other than pensions (&amp;quot;PBOP&amp;quot;). Following interventions and protests and a hearing before FERC, the parties submitted a settlement agreement on August 15, 2006 (&amp;quot;2006 Settlement&amp;quot;). The 2006 Settlement revised the Company's schedule of decommissioning charges, based on an estimated cost of decommissioning of $642.9 million, including contingency, in 2006 dollars (&amp;quot;2006 Estimate&amp;quot;) for the period from 2003 to 2023. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;To recover this amount, the 2006 Settlement provided for two charges. The first charge is paid into the nuclear decommissioning trust (&amp;quot;NDT&amp;quot;) for ongoing onsite storage of spent nuclear fuel and other high-level waste, final decommissioning of CY's ISFSI, and a DOE fee for the storage of spent fuel generated prior to 1983. The second charge funds the PBOP, which primarily consist of medical benefits for former CY employees. Charges are paid into the Voluntary Employees' Beneficiary Association Fund for Total Retiree Welfare (&amp;quot;VEBA&amp;quot;) Trust.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Other aspects of the 2006 Settlement included, but were not limited to:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&amp;#8226;&lt;/span&gt;&lt;span style="width: 13.4pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;A mechanism to adjust decommissioning charges to account for differences between actual and estimated costs of plant decontamination and dismantlement (&amp;quot;D&amp;amp;D&amp;quot;), following the issuance by the NRC of a license amendment that permits fuel storage-only operations.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0; text-indent: -36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0; text-indent: -18pt; text-align: left"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&amp;#8226;&lt;/span&gt;&lt;span style="width: 13.4pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;A projection for the earnings of investments made from nuclear decommissioning trust funds for each year from 2007 to 2014.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0; text-indent: -18pt; text-align: left"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&amp;#8226;&lt;/span&gt;&lt;span style="width: 13.4pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;A mechanism to provide regular reports on the actual performance of investments made from CY's NDT. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0; text-indent: -18pt; text-align: left"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&amp;#8226;&lt;/span&gt;&lt;span style="width: 13.4pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;A mechanism to adjust NDT collections if the difference between actual and projected earnings exceeded $1 million in any year (&amp;quot;Adjustment Mechanism&amp;quot;).&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0; text-indent: -18pt; text-align: left"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&amp;#8226;&lt;/span&gt;&lt;span style="width: 13.4pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;A requirement to file an updated decommissioning cost estimate and schedule of decommissioning charges by no later than December 31, 2010, and no less frequently than every four years thereafter. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On November 26, 2007, the NRC issued the license amendment permitting fuel storage-only operations, marking the end of Plant D&amp;amp;D. On July 31, 2008, CY submitted a filing (the &amp;quot;2008 Settlement&amp;quot;) that adjusted decommissioning charges to reconcile estimated and actual costs of Plant D&amp;amp;D, while also seeking recovery of additional costs for PBOP. The 2008 Settlement established NDT charges of $39.7 million for 2010, $40.9 million annually for 2011-2014, and $43.7 million in 2015. It provided for VEBA collections of $1.89 million annually from 2009-2015. Although the 2008 Settlement revised charges, it did not alter the underlying 2006 Estimate.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On October 13, 2010, CY submitted its decommissioning cost estimate and schedule of decommissioning charges (&amp;quot;2010 Rate Filing&amp;quot;), as it had committed to do in the 2006 Settlement. The 2010 Rate Filing demonstrated that, after escalating costs to 2010 dollars and adjusting for the fact that the costs of the first part of the waste storage included in the 2006 Estimate have already been incurred, the 2006 Estimate remains a reasonable projection of costs upon which the Company may rely in calculating the rates necessary to fund the NDT. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The 2010 Rate Filing then assessed the adequacy of the Company's decommissioning funding, projecting that the NDT would be under-funded by about $5.7 million by 2023. Nevertheless, the 2010 Rate Filing noted ongoing uncertainties regarding prospective damage awards obtained from litigation with the DOE, offsets to CY's funding needs, the DOE's commitment to remove CY's nuclear waste, and the timing of these key events. In light of these unknowns, along with the fact that the 2006 Settlement committed CY to file another update of decommissioning costs and charges by 2014, CY proposed to maintain its current level of collections.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Similarly, the 2010 Rate Filing reported on the adequacy of VEBA funding. It reported that recent analyses conducted by CY's independent consultants had concluded that the VEBA Trust would require an additional contribution of $2.8 million in 2016 to cover remaining PBOP obligations. Again, however, CY noted the high degree of uncertainty surrounding the performance of VEBA Trust investments, changes in the health care industry, and the performance of the DOE's obligation to remove nuclear materials. Based on these considerations, along with the 2014 filing deadline, CY proposed to make no changes to its PBOP rates.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The only change that the 2010 Rate Filing proposed to make to CY's wholesale power contract was the removal of the Adjustment Mechanism. As the 2010 Rate Filing reported, CY's experience with this mechanism since 2006 was characterized by wide fluctuations that would have caused substantial rate volatility. Furthermore, CY explained that the rate Adjustment Mechanism is unnecessary, given that decommissioning cost estimates showed sufficient funds to meet expenses through 2021, and given the Company's right to make rate filings with FERC to meet any funding issues. Thus, CY proposed to eliminate the Adjustment Mechanism, while still providing purchasers, Commission Staff, and other parties with annual reports on the actual performance of NDT investments. CY requested an effective date of January 1, 2011 for its revisions. FERC assigned Docket No. ER11-101-000 to the filing and established November 3, 2010 as the deadline for motions to intervene and protest. Three parties subsequently sought to intervene. On December 20, 2010, FERC issued a letter order accepting the 2010 Rate Filing, including the elimination of the NDT adjustment mechanism.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;On May 1, 2013, CY submitted an application to reduce its wholesale rates under its wholesale power contracts to reflect the combined effect of CY's receipt of a damage award in litigation with DOE and a projected increase in decommissioning costs due primarily to the extension of the period during which CY must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance of its obligation to remove that material. CY's application proposed to add a fifteen-year funding mechanism to the wholesale power contracts to permit the flow through to customers of additional damage awards that it may receive in further litigation with DOE that are in excess of funding requirements for projected decommissioning costs for a fifteen-year period. CY's application also proposed to eliminate its scheduled decommissioning charges to its wholesale customers, in conjunction with the establishment of a revised process to regularly review CY's funding needs as additional DOE litigation awards are received. Finally, CY's application proposed to provide an immediate credit of approximately $39.7 million to CY's wholesale customers. CY requested a rate effective date of July 1, 2013 for its application. CY's filing was supported by a stipulation and agreement among CY, the Connecticut Public Utilities Regulatory Authority, the Connecticut Office of Consumer Counsel, the Maine Public Utilities Commission, the Maine Office of Public Advocate, the Massachusetts Department of Public Utilities, and the Massachusetts Attorney General. On June 27, 2013, FERC issued an order in Docket No. ER13-1399-000 granting CY's application to reduce its rates under the wholesale power contracts and approving CY's proposed review mechanism. FERC noted that CY's application was unopposed and supported by state agencies and many other stakeholders.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The receipt of DOE Phase II Litigation proceeds of $126.3 million on March 28, 2014 triggered the requirement approved in the 2013 FERC Order for CY to review its funding needs for a fifteen-year period upon receipt of DOE proceeds. The review is required to determine the excess (if any) that could flow back to wholesale customers as a result of the receipt of the proceeds. Accordingly, the Company conducted the required financial analysis, which was reviewed with and supported by Stakeholders from Connecticut (&amp;quot;CT&amp;quot;), Massachusetts (&amp;quot;MA&amp;quot;), and Maine (&amp;quot;ME&amp;quot;). The results of the financial analysis were submitted to FERC in an Informational Filing on April 29, 2014. The Informational Filing provided for the return of the $126.3 million to wholesale customers with a rate effective date of June 1, 2014.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;In July 2016, the damage award to CY Phase III of its litigation against DOE in the amount of $32.6 million became final and no longer subject to appeal. In anticipation of the payment of that damage award, CY performed the financial analysis required by the 2013 FERC Order. As part of that analysis, CY reviewed the decommissioning cost estimate and related financial assumptions that it filed with the Commission in 2013 and determined, as discussed below, that updates were required.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On August 22, 2016, CY provided its financial analysis together with supporting work papers to Stakeholders from CT, MA, and ME, including the representatives of the state agencies that executed the stipulation and agreement, submitted in 2013 in Docket No. ER13-1399-000. None of the Signatories objected to CY's calculation of its financial analysis, or CY's proposal to credit a portion of the Phase III DOE damage award to wholesale customers.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On September 30, 2016, CY submitted a filing in Docket No. ER16-2723-000 updating the decommissioning cost estimate and the related financial assumptions CY used to calculate the financial analysis required by the 2013 FERC Order. The updated decommissioning estimate reflected a projected increase in decommissioning costs due to a number of factors, including a three-year extension of the period during which CY must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance and increased staffing requirements. CY also proposed a revision to its estimate of PBOP expenses and to modify its periodic review mechanism as originally prescribed in Docket No. ER13-1399-000 to allow CY to use DOE proceeds to fund PBOP expenses, as an alternative to collecting funds for that purpose from its customers&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;CY requested a rate effective date of December 1, 2016 for its application. The proposed changes, submitted in Docket No. ER16-2723-000, did not require new or increased charges to customers. The application was unopposed and supported by state agencies including the Connecticut Public Utilities Regulatory Authority, the Connecticut Office of Consumer Counsel, the Maine Public Utilities Commission, the Maine Office of Public Advocate, the Massachusetts Department of Public Utilities, and the Massachusetts Attorney General. On November 15, 2016, the FERC issued an order accepting the filing of Docket No. ER16-2723-000 with an effective date of December 1, 2016 as requested.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The receipt of DOE Phase III Litigation proceeds of $32.6 million on October 14, 2016 triggered the requirement approved in the 2013 FERC Order for CY to review its funding needs for a fifteen-year period upon receipt of DOE proceeds. The review is required to determine the excess (if any) that could flow back to wholesale customers as a result of the receipt of the proceeds. Accordingly, the Company conducted the required financial analysis, which was previously reviewed with and supported by Stakeholders. The results of the financial analysis were submitted to FERC in an Informational Filing on October 28, 2016. In accordance with that filing, $18.4 million of the proceeds were returned to the Company's wholesale customers on December 15, 2016. In addition, $0.6 million of proceeds were deposited in the Company's PBOP, and $0.4 million of proceeds were used to pay the associated taxes. The remaining proceeds were deposited into the Decommissioning Trust Fund to fund long-term ISFSI operations and decommissioning costs.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;By July 16, 2019, the aggregate $40.9 million of proceeds awarded to the Company in Phase IV of its litigation against DOE was received. As required by the Company's 2013 FERC Order upon receipt of DOE proceeds, a financial analysis was conducted. As part of the analysis, Connecticut Yankee reviewed the decommissioning cost estimate and related financial assumptions that it last filed with the Commission in 2016 and determined that updates were required. Prior to submitting a 205 Filing to FERC to update the decommissioning cost estimate, Connecticut Yankee provided its financial analysis together with supporting work papers to Stakeholders from CT, ME, and MA, including the representatives of the state agencies that executed the stipulation and agreement, submitted in 2013 in Docket No. ER13-1399-000. None of the Signatories objected to Connecticut Yankee's calculation of its financial analysis.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On September 23, 2019, Connecticut Yankee submitted a 205 filing in Docket No. ER19-2852-000 updating the decommissioning cost estimate and the related financial assumptions Maine Yankee used to calculate the financial analysis required by the 2013 FERC Order. The updated decommissioning cost estimate reflected a projected increase in decommissioning costs due to a number of factors, including a three-year extension of the period during which Connecticut Yankee must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance, and increased staffing requirements to address succession planning. Connecticut Yankee also proposed to extend the &amp;quot;sunset&amp;quot; provision of the Power Contract, which specifies when Connecticut Yankee must submit a filing to initiate a review of the financial assurance mechanism.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;Connecticut Yankee requested a rate effective date of December 1, 2019 for its application. The proposed changes, submitted in Docket No. ER19-2852-000, did not require new or increased charges to customers. The application was unopposed and supported by state agencies including the Connecticut Public Utilities Regulatory Authority, the Connecticut Office of Consumer Counsel, the Maine Public Utilities Commission, the Maine Office of Public Advocate, the Massachusetts Department of Public Utilities, and the Massachusetts Attorney General. On November 7, 2019, the FERC issued an order accepting the filing of Docket No. ER19-2852-000 with an effective date of December 1, 2019 as requested.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The receipt of DOE Phase IV Litigation proceeds of $40.9 million also triggered the requirement approved in the 2013 FERC Order for Connecticut Yankee to review its funding needs for a fifteen-year period upon receipt of DOE proceeds. The review is required to determine the excess (if any) that could flow back to wholesale customers as a result of the receipt of the proceeds. Accordingly, the Company conducted the required financial analysis, which was previously reviewed with and supported by Stakeholders as discussed above. The results of the financial analysis were submitted to FERC in an Informational Filing on September 23, 2019. In accordance with that filing, $29.0 million of the proceeds were paid to the DOE on December 10, 2019 for a substantial partial payment of the Company's Pre-1983 Spent Fuel Obligation; $.146 million for lobbying expense was credited to the Statement of Income to reimburse Sponsor Companies for these previously incurred costs; $.169 million was used to offset the regulatory asset that was established as a result of a permanent loss of deferred income tax assets that the Company recorded when implementing the Tax Cuts and Jobs Act; and, the balance of proceeds in the amount of $11.5 million, less estimated income taxes, was transferred to the Decommissioning Trust Fund to fund long term ISFSI Operations costs and to meet the balance of the DOE Pre-1983 Spent Fuel Obligation.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In September 2024, the Company's DOE Phase V litigation was ongoing. See Note I Commitments and Contingencies. As required by the Company's 2013 FERC Order, due to the passage of five years from its most recent informational filing and absent the receipt of DOE proceeds, a financial analysis was conducted. As part of the analysis, Connecticut Yankee reviewed the decommissioning cost estimate and related financial assumptions that it last filed with the Commission in 2019 and determined that updates were required. Prior to submitting a 205 Filing to FERC to update the decommissioning cost estimate, Connecticut Yankee provided its financial analysis together with supporting work papers to Stakeholders from CT, MA, and ME, including the representatives of the state agencies that executed the stipulation and agreement, submitted in 2013 in Docket No. ER13-1399-000. None of the Signatories objected to Connecticut Yankee's calculation of its financial analysis.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On September 18, 2024, the Company submitted FERC informational and 205 filings in Docket No. ER24-3070-000 updating the decommissioning cost estimate and the related financial assumptions Connecticut Yankee used to calculate the financial analysis required by the 2013 FERC Order. The updated decommissioning cost estimate reflected a projected increase in decommissioning costs due to a number of factors, including a five-year extension of the period during which Connecticut Yankee must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance, an increase in the cost escalation rate and increased staffing requirements to address succession planning. &lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;In addition, the filings proposed a $7.5 million payment toward Connecticut Yankee's long-term fuel disposal liability for its DOE pre-1983 Spent Nuclear Fuel Obligation.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;The proposed changes did not require new or increased charges to customers. Connecticut Yankee requested a rate effective date of November 18, 2024 for its application.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;On November 14, 2024, the FERC issued an order accepting the filing of Docket No. ER24-3070-000 with an effective date of November 18, 2024, as requested. In accordance with these filings, $7.5 million was paid to the DOE on November 20, 2024, for a substantial partial payment of the Company's DOE Pre-1983 Spent Nuclear Fuel Obligation.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Connecticut Yankee will continue to allocate prior DOE litigation damages to fund projected decommissioning costs, which will be based on the 2024 Estimate. Upon receipt of any future damage awards resulting from its litigation with the DOE, Connecticut Yankee will prepare an updated financial analysis and credit any balance not necessary to fund projected decommissioning costs back to its customers.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;See discussion of DOE Phase V Litigation in Note I - Commitments and Contingencies.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE D - NUCLEAR FUEL&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Energy Policy Act of 1992, enacted October 24, 1992, established the Uranium Enrichment Decontamination and Decommissioning (&amp;quot;UED&amp;amp;D&amp;quot;) Fund and authorized the collection of a special assessment for domestic utilities over a fifteen-year period. The Company made the final payment of $3.7 million in 2006. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;On January 8, 2026, the House adopted a three-bill minibus Appropriations Package that included the FY 2026 Energy and Water Development and Related Agencies (E&amp;amp;WD) appropriations bill (H.R. 6938). This appropriations package did not include reinstatement of the UED&amp;amp;D fee on domestic utilities. The Senate passed that Appropriations Package on January 15, 2026, and presented it to the President on January 22, 2026. The President signed the appropriations package into law on January 23, 2026. No amount has been accrued for this matter as of December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;For discussion of litigation that resulted from DOE's refusal to assume responsibility for disposal of such spent fuel, see Note I &amp;quot;Commitments and Contingencies&amp;quot; - &amp;quot;DOE Spent Fuel Litigation.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE E - INCOME TAXES&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Income tax expense consists of the following components:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="margin-left: 18.9pt; border-collapse: collapse"&gt; 				&lt;tr&gt; 					&lt;td style="width: 276.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span style="font-weight: bold; text-decoration: underline"&gt;2025&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span style="text-decoration: underline"&gt;2024&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 276.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 169.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;(Dollars in Thousands)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 276.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 276.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;Income taxes charged to operations&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;$&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;73&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;62&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 276.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;Income taxes credited to other income&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;0&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;2&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 276.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;Income taxes charged to decommissioning trust&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;864&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;288&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 276.4pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 17.55pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 27.4pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Total income tax expense &lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;937&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span style="width: 13.15pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt