bold"&gt;7.50%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 82.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;7.90%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 246.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;Ultimate healthcare cost trend rate&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 82.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="font-weight: bold"&gt;4.04%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 82.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;4.04%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 246.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;Year ultimate is reached&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 82.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="font-weight: bold"&gt;2074&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 82.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;2074&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt;