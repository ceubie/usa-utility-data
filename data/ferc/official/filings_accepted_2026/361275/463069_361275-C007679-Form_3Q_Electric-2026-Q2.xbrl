					&lt;td style="width:97.2pt; padding-right:5.4pt; padding-left:5.4pt; vertical-align:top"&gt;&#xD;
						&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:8pt"&gt;&#xD;
