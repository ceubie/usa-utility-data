              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">(16,369,186)</span>
            </td>
            <td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:top"/>
