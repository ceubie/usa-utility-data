        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:92%">for</span>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:92%"></span>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:92%">the</span>
