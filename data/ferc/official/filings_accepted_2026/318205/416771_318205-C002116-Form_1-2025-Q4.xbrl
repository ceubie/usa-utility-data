						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 198.65pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="text-decoration: underline"&gt;Liabilities:&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 64.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 69.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 60.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 56.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 198.65pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span&gt;Asset retirement obligation (Note F)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 64.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="width: 8.1pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 41.17pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;-&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 69.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="width: 7.35pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 41.92pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;-&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 60.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="width: 5.85pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 10.5pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;165,093&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 56.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="width: 6.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 4.5pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;165,093&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td colspan="5" style="width: 493.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;(a)&lt;/span&gt;&lt;span style="width: 27.12pt; font-size: 8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 8pt"&gt;This category includes investments in equity securities of large-, small- and medium-sized companies.&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;(b)&lt;/span&gt;&lt;span style="width: 8.67pt; text-indent: 0; font-size: 8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 8pt"&gt;This category includes equity securities of foreign companies, including those in developing countries.&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;(c)&lt;/span&gt;&lt;span style="width: 9.12pt; text-indent: 0; font-size: 8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 8pt"&gt;This category includes investments in domestic corporate and/or government investment grade fixed-income instruments.&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;(d)&lt;/span&gt;&lt;span style="width: 8.67pt; text-indent: 0; font-size: 8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 8pt"&gt;This category includes investments in debt securities of foreign companies.&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;(e)&lt;/span&gt;&lt;span style="width: 9.12pt; text-indent: 0; font-size: 8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 8pt"&gt;This category includes investments in pooled funds which can include both domestic and foreign equity securities and debt instruments.&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;(f)&lt;/span&gt;&lt;span style="width: 10.01pt; text-indent: 0; font-size: 8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 8pt"&gt;This category consists of cash and cash equivalents.&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Investments in the plant decommissioning trust, other trusts and the Company's asset retirement obligation are presented at fair value. Investments are exposed to various risks, such as interest rates, credit and overall market volatility. As such, it is reasonably possible that changes in the values of investment will occur in the near term and that such changes could materially affect the amounts reported in the balance sheets.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 11pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; line-height: 11pt"&gt; 				&lt;span style="font-weight: bold"&gt;7.&lt;/span&gt;&lt;span style="width: 10.5pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Use of Estimates&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 11pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 11pt"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The preparation of financial statements in conformity with accounting principles generally accepted in the United States of America requires management to make significant estimates and assumptions that affect the reported amounts of assets, liabilities, disclosures of contingent assets and liabilities at the date of the financial statements, and the reported amounts of revenue and expenses during the reporting period. Significant estimates include the assumptions used to determine the accumulated plan benefits, future estimates of market values of investments, closure costs, asset retirement obligations and the deferred tax valuation allowance. Actual results could differ from those estimates.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 11pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span style="font-weight: bold"&gt;8.&lt;/span&gt;&lt;span style="width: 10.5pt; text-indent: 0; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Benefit Plan Risks&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The actuarial present value of accumulated plan benefits is prepared based on certain assumptions pertaining to interest rates, inflation rates, and employee demographics, all of which are subject to change. Due to uncertainties inherent in the estimations and assumptions process, it is at least reasonably possible that changes in these estimates and assumptions in the near term could be material to the financial statements.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;9.&lt;/span&gt;&lt;span style="width: 8pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Affiliated Services&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In 2025 and 2024, Connecticut Yankee Atomic Power Company (&amp;quot;CY&amp;quot;), Maine Yankee Atomic Power Company (&amp;quot;MY&amp;quot;), and YA shared financial, technical, and management services. The following table represents the costs of services shared among CY, MY, and YA:&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="margin-left: 108.9pt; border-collapse: collapse"&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;2025&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;2024&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;YA to CY&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span style="font-weight: bold"&gt;$1.0 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;$1.0 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;YA to MY&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span style="font-weight: bold"&gt;$1.0 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;$1.1 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;CY to YA&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span style="font-weight: bold"&gt;$0.8 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;$0.6 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;MY to YA&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span style="font-weight: bold"&gt;$0.5 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;$0.3 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 11pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;10.&lt;/span&gt;&lt;span style="width: 5.5pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Regulatory Accounting and Assets&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The accounting policies of the Company and the accompanying financial statements conform to accounting principles generally accepted in the United States of America applicable to rate-regulated enterprises and reflect the effects of the ratemaking process in accordance with FASB ASC 980, &lt;/span&gt;&lt;span style="font-style: italic"&gt;Regulated Operations&lt;/span&gt;&lt;span&gt;. Assuming a cost-of-service based regulatory structure, regulators may permit incurred costs, normally treated as expenses, to be deferred and recovered through future rates. Through their actions, regulators may also reduce or eliminate the value of an asset or create a liability. If any portion of the Company's operations were no longer subject to the provisions of ASC 980 as a result of a change in the cost-of-service based regulatory structure, the Company would be required to write off related regulatory assets and liabilities. Based on current regulation, the Company believes that its use of regulatory accounting remains appropriate.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;11.&lt;/span&gt;&lt;span style="width: 5.5pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Subsequent Events&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;For purposes of the preparation of the financial statements in conformity with U.S. generally accepted accounting principles, the Company has considered transactions or events occurring through April 22, 2026, which was the date that the financial statements were available to be issued.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE B - CONCLUSION OF PHASE I, PHASE II, PHASE III AND PHASE IV LITIGATION WITH THE DEPARTMENT OF ENERGY &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;Since 1998, YA, along with CY and MY, have sought damages from the DOE related to breach of contract.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase I&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On December 5, 2012, the DOE's right to appeal the Judgment in the Company's Phase I Litigation expired and the Judgment became final. The damages awarded to the Company for Phase I Litigation were $38.3 million. In December 2012, the Department of Justice submitted the required paperwork to the United States Treasury to initiate payment to the Company. A receivable for the award was recorded for both financial statement and tax reporting in December 2012. The proceeds were received on January 25, 2013 and deposited into the Nonqualified Nuclear Decommissioning Trust (&amp;quot;NDT&amp;quot;) pending the outcome of the Company's 2013 FERC Filing. The FERC Filing which was approved on June 27, 2013 resulted in a reduction of the amounts collected from the Company's wholesale customers for the estimated costs of funding the decommissioning and long-term fuel storage costs; see Note C - &amp;quot;Rate Proceedings.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase II&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On January 14, 2014, the DOE's right to appeal the Judgment in the Company's Phase II Litigation expired and the Judgment became final. The damages awarded to the Company for Phase II Litigation were $73.3 million.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;In January 2014, the Department of Justice submitted the required paperwork to the United States Treasury to initiate payment to the Company. The Company recorded the receivable in January 2014 when the period for appeals passed and it became likely that such damages would be paid. The damage proceeds of $73.3 million were received on March 28, 2014. On June 5, 2014, $71.4 million of the proceeds was returned to the Company's wholesale customers in accordance with the Company's 2014 FERC Filing. The remaining $1.9 million of the proceeds was deposited into the Decommissioning Trust Fund to fund long-term ISFSI operations and decommissioning costs.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase III&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On July 18, 2016, the DOE's right to appeal the Judgment in the Company's Phase III Litigation expired and the Judgment became final. The damages awarded to the Company for Phase III Litigation were $19.6 million. In July 2016, the Department of Justice submitted the required paperwork to the United States Treasury to initiate payment to the Company. The Company recorded the receivable in July 2016 when the period for appeals passed and it became likely that such damages would be paid. The damage proceeds of $19.6 million were received on October 14, 2016 and in accordance with the Company's October 2016 Informational FERC Filing, the proceeds were deposited in the Decommissioning Trust to fund long-term ISFSI operations and decommissioning costs; see Note C - &amp;quot;Rate Proceedings.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase IV&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On February 21, 2019, the United States Court of Federal Claims rendered a summary judgment associated with uncontested damages in the Phase IV litigation with the DOE and awarded the Company $28.1 million. This left $.4 million remaining in dispute for resolution at trial which was scheduled for June 2019. On April 23, 2019, the DOE's right to appeal the Judgment related to the uncontested damages in the Company's Phase IV Litigation expired and the Judgment became final. The Company recorded the receivable in April 2019 when the period for appeals passed and it became likely that such damages would be paid. The uncontested damage proceeds of $28.1 million were received on June 11, 2019. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Additionally, in lieu of incurring the expense of a trial, the Company and the DOE negotiated an Offer of Settlement associated with the contested damages. On June 12, 2019, the court accepted the Offer of Settlement which entitled the Company to additional proceeds in the amount of $.2 million. The Company recorded this receivable in June 2019 when the court accepted the Offer of Settlement. These additional proceeds were received on July 16, 2019.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Following FERC's acceptance of the Company's rate filings as required upon receipt of DOE proceeds, on December 17, 2019, $5.4 million of the proceeds was returned to the Company's wholesale customers. Of the remaining proceeds, $22.7 million, less estimated income taxes, was transferred to the Decommissioning Trust Fund to fund long term ISFSI Operations and Decommissioning costs and $.2 million for lobbying expense was credited to the statement of operations to reimburse Sponsor Companies for these previously incurred costs; see Note C - &amp;quot;Rate Proceedings.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;For further discussion of litigation that resulted from DOE's failure to assume responsibility for disposal of such spent fuel, see Note I &amp;quot;Commitments and Contingencies&amp;quot; - &amp;quot;DOE Spent Fuel Litigation.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE C - RATE PROCEEDINGS&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 7.5pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;On November 23, 2005, Yankee submitted a filing to FERC to increase its wholesale decommissioning charges. After parties filed motions to intervene and protest, FERC set the matter for hearing on January 31, 2006. On May 1, 2006, the parties presented FERC with a settlement (the &amp;quot;2006 Settlement&amp;quot;). The 2006 Settlement submitted a schedule of decommissioning charges based on an estimated cost of $212.7 million for the period from 2005 through 2022 (the &amp;quot;2006 Estimate&amp;quot;). For the years of 2011 through 2014, the schedule provided that Yankee would make annual collections of $11.75 million. Other aspects of the 2006 Settlement included, but were not limited to, the following:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 7.5pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&amp;#8226;&lt;/span&gt;&lt;span style="width: 13.4pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;A mechanism to adjust decommissioning charges to account for differences between actual and estimated costs of plant decontamination and dismantlement (&amp;quot;D&amp;amp;D&amp;quot;), following the issuance by the NRC of a license amendment that permits fuel storage-only operations.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&amp;#8226;&lt;/span&gt;&lt;span style="width: 13.4pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;An addition to Yankee's power contract listing the projected earnings of investments made from nuclear decommissioning trust (&amp;quot;NDT&amp;quot;) funds for each year from 2006 to 2014.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt; text-align: left"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&amp;#8226;&lt;/span&gt;&lt;span style="width: 13.4pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;A mechanism to provide regular reports on the actual performance of investments made from Yankee's NDT. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&amp;#8226;&lt;/span&gt;&lt;span style="width: 13.4pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;A mechanism to adjust NDT collections if the difference between actual and projected earnings exceeded $1&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;million in any year (&amp;quot;Adjustment Mechanism&amp;quot;).&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&amp;#8226;&lt;/span&gt;&lt;span style="width: 13.4pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;A requirement to file an updated decommissioning cost estimate and schedule of decommissioning charges by no later than December 31, 2010. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; font-size: 7.5pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In August 2007, the NRC issued the license amendment for fuel storage-only operations, marking the end of plant D&amp;amp;D. Rather than adjust rates, however, the parties agreed that Yankee would take the difference into account in the filing due by December 31, 2010.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 7.5pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;On October 13, 2010, Yankee submitted its decommissioning cost estimate and schedule of decommissioning charges (&amp;quot;2010 Rate Filing&amp;quot;), as it had committed to do in the 2006 Settlement. The 2010 Rate Filing demonstrated that, after escalating costs to 2010 dollars and adjusting for the fact that the costs of the first part of the waste storage included in the 2006 Estimate have already been incurred, the 2006 Estimate remains a reasonable projection of costs upon which the Company may rely in calculating the rates necessary to fund the NDT. The 2010 Rate Filing then assessed the adequacy of the Company's decommissioning funding, projecting that the NDT would be under-funded by about $5.9 million in 2022. Nevertheless, the 2010 Rate Filing noted ongoing uncertainties regarding prospective damage awards obtained from litigation with the DOE, offsets to Yankee's funding needs, the DOE's commitment to remove Yankee's nuclear waste, and the timing of these key events. In light of these unknowns, along with the fact that the 2006 Settlement committed Yankee to file another update of decommissioning costs and charges by 2014, Yankee proposed to maintain its current level of collections.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%; font-size: 7.5pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;The only change that the 2010 Rate Filing proposed to make to Yankee's wholesale power contract was the removal of the Adjustment Mechanism. As the 2010 Rate Filing reported, Yankee's experience with this mechanism since 2006 was characterized by wide fluctuations that would have caused substantial rate volatility. Furthermore, Yankee explained that the rate Adjustment Mechanism would not be necessary, given that decommissioning cost estimates showed sufficient funds to meet expenses through 2020, and given the Company's right to make rate filings with FERC to meet any funding issues. Thus, Yankee proposed to eliminate the Adjustment Mechanism, while still providing purchasers, Commission Staff, and other parties with annual reports on the actual performance of NDT investments. Yankee requested an effective date of January 1, 2011 for its revisions.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 98%; font-size: 7.5pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;On May 1, 2013, Yankee submitted an application to reduce its wholesale rates under its wholesale power contract to reflect the combined effect of Yankee's receipt of a damage award in litigation with DOE and a projected increase in decommissioning costs due primarily to the extension of the period during which Yankee must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance of its obligation to remove that material. Yankee's application proposed to add a fifteen-year funding mechanism to its wholesale power contract to permit the flow through to customers of additional damage awards that it may receive in further litigation with DOE that are in excess of funding requirements for projected decommissioning costs for a fifteen-year period. Yankee also proposed in its application to reduce its scheduled decommissioning charges to its wholesale customers from $979,167 per month to $252,542 per month, in conjunction with the establishment of a revised process to regularly review Yankee's funding needs as additional DOE litigation awards are received. Yankee requested an effective date of July 1, 2013 for its application. Yankee's filing was supported by a stipulation and agreement among Yankee, the Connecticut Public Utilities Regulatory Authority, the Connecticut Office of Consumer Counsel, the Maine Public Utilities Commission, the Maine Office of Public Advocate, the Massachusetts Department of Public Utilities, and the Massachusetts Attorney General. On June 27, 2013, FERC issued an order in Docket No. ER13-1397-000 granting Yankee's application to reduce its rates under the wholesale power contract and approving Yankee's incorporation of the periodic review mechanism. FERC noted that Yankee's application was unopposed and supported by state agencies and many other stakeholders. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;The receipt of the DOE Phase II Litigation proceeds of $73.3 million on March 28, 2014 triggered the requirement approved in the 2013 FERC Order for YA to review its funding needs for a fifteen-year period upon receipt of DOE proceeds. The review is required to determine the excess (if any) that could flow back to the Sponsor Companies as a result of the receipt of the proceeds. Accordingly, the Company conducted the required financial analysis, which was reviewed with and supported by Stakeholders from Connecticut (CT), Massachusetts (MA), and Maine (ME). The results of the financial analysis were submitted to FERC in an Informational Filing on April 29, 2014. The Informational Filing provided for cessation of decommissioning collections and a return of proceeds in the amount of $71.4 million to Sponsor Companies with a rate effective date of June 1, 2014. The Informational Filing also included a provision for the Company to retain $1.9 million of the proceeds in its Decommissioning Trust Fund to fund long-term ISFSI operations and decommissioning costs.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;In July 2016, the damage award to Yankee in Phase III of its litigation against DOE in the amount of $19.6 million became final and no longer subject to appeal. In anticipation of the payment of that damage award, Yankee performed the financial analysis required by the 2013 FERC Order. As part of that analysis, Yankee reviewed the decommissioning cost estimate and related financial assumptions that it filed with the Commission in 2013 and determined, as discussed below, that updates were required.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On August 22, 2016, Yankee provided its financial analysis together with supporting work papers to Stakeholders from CT, MA, and ME, including the representatives of the state agencies that executed the stipulation and agreement, submitted in 2013 in Docket No. ER13-1397-000. None of the Signatories objected to Yankee's calculation of its financial analysis, or Yankee's proposal to retain the Phase III DOE damage award in the Decommissioning Trust to fund ongoing long-term ISFSI operations and decommissioning costs.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On September 30, 2016, Yankee submitted a filing in Docket No. ER16-2733-000 updating the decommissioning cost estimate and the related financial assumptions Yankee used to calculate the financial analysis required by the 2013 FERC Order. The updated decommissioning cost estimate reflected a projected increase in decommissioning costs due to a number of factors, including a three-year extension of the period during which Yankee must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance and increased staffing requirements. Yankee also proposed to modify its periodic review mechanism as originally prescribed in Docket No. ER13-1397-000 to allow Yankee to use DOE proceeds to fund post-retirement benefits other than pensions (&amp;quot;PBOP&amp;quot;) expenses, rather than collecting funds for that purpose from its customers. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;Yankee requested a rate effective date of December 1, 2016 for its application. The proposed changes, submitted in Docket No. ER16-2733-000, did not require new or increased charges to customers. The application was unopposed and supported by state agencies including the Connecticut Public Utilities Regulatory Authority, the Connecticut Office of Consumer Counsel, the Maine Public Utilities Commission, the Maine Office of Public Advocate, the Massachusetts Department of Public Utilities, and the Massachusetts Attorney General. On November 15, 2016, the FERC issued an order accepting the filing of Docket No. ER16-2733-000 with an effective date of December 1, 2016 as requested.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The receipt of DOE Phase III Litigation proceeds of $19.6 million on October 14, 2016 triggered the requirement approved in the 2013 FERC Order for Yankee to review its funding needs for a fifteen-year period upon receipt of DOE proceeds. The review is required to determine the excess (if any) that could flow back to wholesale customers as a result of the receipt of the proceeds. Accordingly, the Company conducted the required financial analysis, which was previously reviewed with and supported by Stakeholders. The results of the financial analysis were submitted to FERC in an Informational Filing on October 28, 2016. The analysis concluded that the Decommissioning Trust Fund was underfunded by approximately $5.8 million. However, rather than resume charges, which would require an increase in billing to customers of $3.2 million, Yankee proposed to defer resumption of decommissioning charges at this time. The proposal was without prejudice to Yankee's right to apply to FERC, to impose such charges, should it be necessary to do so. In accordance with the Informational Filing, the litigation proceeds were deposited to the Yankee Decommissioning Trust Fund to fund long-term ISFSI operations and decommissioning costs. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;By July 16, 2019, the aggregate $28.3 million of proceeds awarded to the Company in Phase IV of its litigation against DOE was received. &lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;As required by the Company's 2013 FERC Order upon receipt of DOE proceeds, a financial analysis was conducted. As part of the analysis, Yankee reviewed the decommissioning cost estimate and related financial assumptions that it last filed with the Commission in 2016 and determined that updates were required. Prior to submitting a 205 Filing to FERC to update the decommissioning cost estimate, Yankee provided its financial analysis together with supporting work papers to Stakeholders from CT, MA, and ME, including the representatives of the state agencies that executed the stipulation and agreement, submitted in 2013 in Docket No. ER13-1397-000. None of the Signatories objected to Yankee's calculation of its financial analysis.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On September 23, 2019, Yankee submitted a 205 filing in Docket No. ER19-2855-000 updating the decommissioning cost estimate and the related financial assumptions Yankee used to calculate the financial analysis required by the 2013 FERC Order. The updated decommissioning cost estimate reflected a projected increase in decommissioning costs due to a number of factors, including a three-year extension of the period during which Yankee must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance, and increased staffing requirements to address succession planning. Yankee also proposed to extend the &amp;quot;sunset&amp;quot; provision of the Power Contract, which specifies when Yankee must submit a filing to initiate a review of the financial assurance mechanism.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;Yankee requested a rate effective date of December 1, 2019 for its application. The proposed changes, submitted in Docket No. ER19-2855-000, did not require new or increased charges to customers. The application was unopposed and supported by state agencies including the Connecticut Public Utilities Regulatory Authority, the Connecticut Office of Consumer Counsel, the Maine Public Utilities Commission, the Maine Office of Public Advocate, the Massachusetts Department of Public Utilities, and the Massachusetts Attorney General. On November 7, 2019, the FERC issued an order accepting the filing of Docket No. ER19-2855-000 with an effective date of December 1, 2019 as requested.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The receipt of DOE Phase IV Litigation proceeds of $28.3 million also triggered the requirement approved in the 2013 FERC Order for YA to review its funding needs for a fifteen-year period upon receipt of DOE proceeds. The review is required to determine the excess (if any) that could flow back to wholesale customers as a result of the receipt of the proceeds. Accordingly, the Company conducted the required financial analysis, which was previously reviewed with and supported by Stakeholders as discussed above. The results of the financial analysis were submitted to FERC in an Informational Filing on September 23, 2019. In accordance with that filing, on December 17, 2019, $5.4 million of the proceeds was returned to the Company's wholesale customers. Of the remaining proceeds, $.2 million for lobbying expense was credited to the statement of operations to reimburse Sponsor Companies for these previously incurred costs and $22.7 million, less estimated income taxes, was transferred to the Decommissioning Trust Fund to fund long term ISFSI Operations and Decommissioning costs.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In September 2024, the Company's DOE Phase V litigation was ongoing. See Note I - Commitments and Contingencies. As required by the Company's 2013 FERC Order, due to the passage of five years from its most recent informational filing and absent the receipt of DOE proceeds, a financial analysis was conducted. As part of the analysis, Yankee reviewed the decommissioning cost estimate and related financial assumptions that it last filed with the Commission in 2019 and determined that updates were required. Prior to submitting a 205 Filing to FERC to update the decommissioning cost estimate, Yankee provided its financial analysis together with supporting work papers to Stakeholders from CT, MA, and ME, including the representatives of the state agencies that executed the stipulation and agreement, submitted in 2013 in Docket No. ER13-1397-000. None of the Signatories objected to Yankee's calculation of its financial analysis.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On September 18, 2024, the Company submitted FERC informational and 205 filings in Docket No. ER24-3069-000 updating the decommissioning cost estimate and the related financial assumptions Yankee used to calculate the financial analysis required by the 2013 FERC Order. The updated decommissioning cost estimate reflected a projected increase in decommissioning costs due to a number of factors, including a five-year extension of the period during which Yankee must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance, an increase in the cost escalation rate and increased staffing requirements to address succession planning.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;The proposed changes did not require new or increased charges to customers. Yankee requested a rate effective date of November 18, 2024 for its application.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;On November 14, 2024, the FERC issued an order accepting the filing of Docket No. ER24-3069-000 with an effective date of November 18, 2024 as requested. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Yankee Atomic will continue to allocate prior DOE litigation damages to fund projected decommissioning costs, which will be based on the 2024 Estimate. Upon receipt of any future damage awards resulting from its litigation with the DOE, Yankee Atomic will prepare an updated financial analysis and credit any balance not necessary to fund projected decommissioning costs back to its customers.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;See discussion of DOE Phase V Litigation in Note I - Commitments and Contingencies.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 98%"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE D - NUCLEAR FUEL&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 98%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;The Energy Policy Act of 1992, enacted October 24, 1992, established the Uranium Enrichment Decontamination and Decommissioning (&amp;quot;UED&amp;amp;D&amp;quot;) Fund and authorized the collection of a special assessment for domestic utilities over a fifteen-year period. The Company made the final payment of $1.4 million in 2006. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 98%"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;On January 8, 2026, the House adopted a three-bill minibus Appropriations Package that included the FY 2026 Energy and Water Development and Related Agencies (E&amp;amp;WD) appropriations bill (H.R. 6938). This appropriations package did not include reinstatement of the UED&amp;amp;D fee on domestic utilities. The Senate passed that Appropriations Package on January 15, 2026, and presented it to the President on January 22, 2026. The President signed the appropriations package into law on January 23, 2026. No amount has been accrued for this matter as of December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 98%"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;For discussion of litigation that resulted from DOE's refusal to assume responsibility for disposal of such spent fuel, see Note I &amp;quot;Commitments and Contingencies&amp;quot; - &amp;quot;DOE Spent Fuel Litigation.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE E - INCOME TAXES&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 				&lt;span&gt;Income tax expense consists of the following components: &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; line-height: 97%; font-size: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="margin-left: 18pt; border-collapse: collapse"&gt; 				&lt;tr&gt; 					&lt;td style="width: 270pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 171pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 							&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;December 31,&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 							&lt;span style="font-weight: bold; text-decoration: underline"&gt;2025&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;2024&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 							&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;(Dollars in Thousands)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 5.4pt"&gt; 					&lt;td style="width: 270pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 270pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span&gt;Income taxes charged to operations&lt;/span&gt;&lt;span style="width: 2.39pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;$&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;4&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;4&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 270pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span&gt;Increase taxes credited to other income&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;(2)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;(2)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 270pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span&gt;Income taxes charged to decommissioning&lt;/span&gt;&lt;span style="width: 9.49pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;525&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;340&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 270pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 23.4pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Total income tax expense&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;527&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;342&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 7.65pt"&gt; 					&lt;td style="width: 270pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 171pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-inside: avoid; page-break-after: avoid; line-height: 97%"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 270pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span&gt;Current income tax (benefit) expense &lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;$&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;(6)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;31&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 270pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span&gt;Deferred income tax expense &lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;533&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 85.5pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;311&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.6pt"&gt; 					&lt;td style="width: 270pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 97%"&gt; 							&lt;span style="width: 22.5pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Total income tax expense &lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 			