		&lt;span style="width: 31.5pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;100%&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 85.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 								&lt;span style="width: 31.5pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;100%&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 				 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 11.65pt"&gt; 				&lt;span style="font-size: 7.5pt"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 				&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The current asset allocation target for the plan is 50% equity, 50% fixed income and 0% cash. This target allocation reflects the long-term nature of the liabilities associated with this plan. The primary goals in the management of plan assets are to maintain the funds' purchasing power and to maximize the long-term total return within the context of a moderate-risk environment.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Expected Company Contributions, Fiscal Year 2026&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The Company does not expect to make contributions to the post-retirement trust in 2026.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;br style="page-break-before: always; clear: both" /&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Expected Benefit Payments&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="border-collapse: collapse"&gt; 				&lt;tr&gt; 					&lt;td style="width: 123.95pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span style="text-decoration: underline"&gt;Years&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 304.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;Post-Retirement&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span style="text-decoration: underline"&gt;Welfare Benefit Payments&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 123.95pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 304.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;(Dollars in Thousands)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 123.95pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 304.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 123.95pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;2026&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 304.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 116.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$&lt;/span&gt;&lt;span style="width: 22.75pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;645&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 123.95pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;2027&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 304.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 116.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 27.75pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;700&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 123.95pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;2028&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 304.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 116.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 27.75pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;743&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 123.95pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;2029&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 304.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 116.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 27.75pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;713&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 123.95pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;2030&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 304.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 116.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 27.75pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;639&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 123.95pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;2031-2035&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 304.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="width: 116.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 27.75pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;3,029&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE I - COMMITMENTS AND CONTINGENCIES&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;1.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Nuclear Liability Insurance&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The Price-Anderson Act (the &amp;quot;Act&amp;quot;) is a federal statute that mandates an industry-wide program of nuclear liability insurance for nuclear facilities. Under the Act, the requirement to provide Primary Financial Protection is provided for by commercial insurance companies and Secondary Financial Protection is provided through a retrospective assessment levied on each of the units licensed to operate in the United States. The Act was extended through 2025 by the Energy Policy Act of 2005. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;On September 28, 1992, the Company submitted to the NRC a request for a reduction of the Primary Financial Protection layer and withdrawal from the Secondary Financial Protection program. The exemption was granted on June 20, 1994. The required level of Primary Financial Protection was reduced to $100 million and the Company is no longer a participant in the Secondary Financial Protection program. The Company remains liable for any retrospective premium assessments arising from nuclear incidents occurring during the period the Company participated in the Secondary Financial Protection program. Under the billing provisions of the Power Contracts, these assessments, if any, would be included in the cost of power. An indemnity agreement with the NRC provides for protection above the primary coverage layer up to $560 million.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 38.25pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;2.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;DOE Spent Fuel Litigation&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 13.5pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In the Nuclear Waste Policy Act of 1982 (&amp;quot;the Act&amp;quot;), Congress provided for the DOE to dispose of spent nuclear fuel and other high-level waste, including GTCC waste (hereinafter &amp;quot;Nuclear Waste&amp;quot;), from nuclear generating plants and, in 1983, YA and the DOE entered into a standard disposal contract mandated by the Act. The contract required DOE to begin disposing of YA's Nuclear Waste by the end of January 1998. As of this date, the DOE has failed to even begin to honor its contract obligation to dispose of YA's Nuclear Waste, and due to the ongoing political and regulatory uncertainties associated with the DOE nuclear waste program, the Company cannot predict when the DOE may begin performance of its obligations. As an interim measure, until the DOE complies with its contractual obligation to dispose of YA's Nuclear Waste, the Company constructed an ISFSI, utilizing dry-cask storage, on the Plant site and completed the transfer of its Nuclear Waste to the ISFSI in 2005. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In the Spring of 1998, YA, along with CY and MY, two other New England-based shut-down nuclear generating plants (collectively &amp;quot;the Yankees&amp;quot;), filed claims in the United States Court of Federal Claims seeking damages resulting from the breach of the 1983 contracts by the DOE. In November of 1998, the Court ruled that the DOE had breached the contracts and was liable for damages, but left the amount of damages to be determined after a trial on the evidence. The ruling was affirmed by the United States Court of Appeals for the Federal Circuit in August of 2000.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In another damages case (Indiana Michigan), the appellate court also ruled that a utility could not recover future damages under the Standard Contract. The effect of this ruling was to require utilities to bring periodic suits to recover past damages. The Yankees' initial suit against the DOE for damages under the Standard Contract was for all damages incurred prior to December 31, 2002 for MY and December 31, 2001 for YA and CY. These cases are referred to as the Phase I cases. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The consolidated trial in the Claims Court to determine damages in the Phase I cases lasted seven weeks and concluded in August of 2004. At the trial and in post-trial briefing, the DOE contended that the costs associated with the storage of the Nuclear Waste were not covered by the Company's contract and they challenged a number of additional positions taken by the Yankees, including the rate at which the DOE was required to accept the fuel, and whether an exchange program would have developed that would change the order in which the fuel would be picked up from the various sites by the DOE.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On October 4, 2006, the Claims Court issued judgment for YA in the amount of $32.9 million for its spent-fuel-related costs through 2001, ruling in favor of the Company on substantially all of the major issues, and entered judgments in different amounts in favor of CY and MY. The decision denied recovery of costs incurred through 2001 associated with spent-fuel-pool storage and called into question claims for recovery of such costs for an unspecified period after 2001. The Court based those conclusions on its findings that YA would have had to incur fuel storage costs through 2001 and for some time thereafter even if the DOE had performed its contract obligations, and therefore those costs did not constitute recoverable damages at least through the period covered by the decision. In addition to ISFSI construction costs, the Court also found both Nuclear Waste and &amp;quot;failed fuel&amp;quot; to be covered under the Standard Contract as claimed by the Company, but left undetermined whether additional fees might be imposed for disposal of GTCC waste. In calculating its costs of closure, the Company has assumed that no additional Nuclear Waste disposal costs are required under the contract.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On December 4, 2006, the DOE appealed the Phase I decision to the United States Court of Appeals for the Federal Circuit, which heard oral arguments on the cases on February 4, 2008. In the Court of Appeals, two other appeals involving issues similar to those of the three Yankees' cases, Pacific Gas &amp;amp; Electric Co. v. United States and Sacramento Public Utility District v. United States, were consolidated for argument purposes before the same three-judge panel. The trial courts in those cases had reached conclusions that appeared to be in conflict with the YA Claims Court decision on several issues common to those cases. On August 7, 2008, the Court of Appeals issued its decisions on the five appeals, vacating some of &lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the findings of the trial courts and remanding the cases to the trial courts with instructions to apply the 1987 Annual Capacity Report (&amp;quot;ACR&amp;quot;) acceptance rates to assess causation for the ISFSI and re-racking costs awarded in the Phase I cases. In addition, the Court of Appeals affirmed that the proper value of the cost of GTCC waste disposal remained open for adjudication in future proceedings. The Court of Appeals also affirmed the lower court's position that pre-1983 monetary obligations for fuel disposal should not be treated as an offset to money damages. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;By order dated January 30, 2009, the trial court scheduled the remanded Phase I cases for trial in August 2009. The remanded trial case was presented to the Judge the week of August 10, 2009, and post-trial briefing and argument was concluded by December 10, 2009. The Court filed its decision in the remanded cases on September 7, 2010, awarding YA $21.2 million. The court concluded that in the non-breach world of full government performance at the 1987 ACR removal rates, none of the Yankees would have built dry storage. The court also concluded that an exchange market would have developed enabling YA to pay other utilities to &amp;quot;swap&amp;quot; queue positions for fuel pick-up so that YA could empty its fuel storage pool by 1999, thereby making their decommissioning activities more efficient. The court reasoned that YA would have been willing to pay up to $14.7 million to swap queue spots so as to avoid building an ISFSI. As a result, the court deducted this amount from YA damages claim. In addition, the Court did not allow YA to recover damages sought for wet pool operating costs in 2000 and 2001, ruling that consideration of the issue was outside the scope of the remand. The Court did award YA $3.1 million for the deferred costs of loading to DOE. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The government appealed the Judge's decision claiming, among other reasons, that he misinterpreted the mandate rule by expanding the scope of the issues to be considered in the remanded case. In response, the Yankees appealed the Judge's ruling that YA was not allowed to recover for its wet pool operating costs in 2000 and 2001 and some NRC fees. After the completion of briefing, oral argument was heard on the appeals on November 7, 2011. On May 18, 2012, the appellate court affirmed most of the trial judge's decision, and ruled that Yankee Atomic was entitled to recover its wet pool operating costs and NRC fees, increasing Yankee's award by more than $17 million. The government then filed a timely petition for reconsideration and rehearing en banc. In early September 2012, the appellate court denied these petitions. The government decided not to appeal further and these Phase I decisions became final in early December 2012. The Company received the awarded damages in the amount of $38.3 million in January 2013. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In December 2007, the Yankees filed a complaint against the government for damages sustained since January 1, 2002 for CY and YA, and since January 1, 2003 for MY (hereinafter the &amp;quot;Phase II cases&amp;quot;). In early July 2009, YA notified the government that it would seek approximately $76.6 million in damages from the government in this Phase II case, adding damages from 2008 to the claim. In early February 2010, the government began its discovery into the Yankees' claimed damages. The Phase II trial occurred in early October 2011. In October 2012, the trial Judge issued an Order that allowed the parties to file supplemental briefs on relevant case law that arose following the close of the trial. Both parties submitted additional briefing. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On November 1, 2013, the Claims Court issued judgment for YA in the amount of $73.3 million for its spent-fuel-related costs through 2008, ruling in favor of the Company on most of the major issues, and entered judgments in different amounts in favor of CY and MY. On January 14, 2014, the DOE's right to appeal the Judgment in the Company's Phase II Litigation expired and the Judgment became final. The Company received the awarded damages on March 28, 2014. On June&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;5, 2014, $71.4 million of the proceeds were returned to the Company's wholesale customers in accordance with the Company's 2014 FERC Filing and $1.9 million of the proceeds were held in the Decommissioning Trust to fund ISFSI operations and decommissioning costs. (See Note C - &amp;quot;Rate Proceedings.&amp;quot;)&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; page-break-after: avoid"&gt; 				&lt;span&gt;In August 2013, the Yankees filed another complaint against the government for damages sustained from January 1, 2009 through December 31, 2012 (&amp;quot;Phase III cases&amp;quot;). In December 2013, YA notified the government that it believed the amount of damages it would seek in this case was approximately $21.4 million. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; page-break-after: avoid"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In a pre-trial order, the Judge directed the parties to pursue settlement discussions.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The parties met in May 2014 to begin these discussions and exchanged proposals during the year, but were unable to settle their dispute. In September 2014, the Judge issued an order setting the Phase III cases for trial from June 30 to July 2, 2015.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The trial concluded on July 1, 2015.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The trial Judge ultimately requested two rounds of post-trial briefing.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The final round concluded on February 12, 2016.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;An oral argument on the second round was held on February 19, 2016.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Judge Merow issued his decision under seal on March 25, 2016.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The seal was removed and the decision reissued on April 7, 2016.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The decision awarded Yankee Atomic $19.6 million, Maine Yankee $24.6 million, and Connecticut Yankee $32.6 million, which totals approximately 98.6% of the damages sought.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;On April 21, 2016, the Yankees filed a motion for clarification, which requested that Judge Merow explain a statement in his opinion that implies that the Companies would not be entitled to recover the costs of benefits administration going forward. The motion was denied. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On July 18, 2016, the DOE's right to appeal the Judgment in the Company's Phase III Litigation expired and the Judgment became final. The Company received the awarded damages on October 14, 2016 and deposited them in the Decommissioning Trust to fund long-term ISFSI operations and decommissioning costs in accordance with the Company's FERC filings. (See Note C - &amp;quot;Rate Proceedings.&amp;quot;)&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company filed its next case, Phase IV, on May 22, 2017, in the Federal Court of Claims, seeking damages for the period from January 1, 2013 through December 31, 2016.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;As a result of the death of Judge James Merow, who had heard and decided the first three Yankees' damages cases, the Phase IV case was assigned to Senior Judge Nancy Firestone. The Yankees submitted their claimed Phase IV damages to the government in late August 2017.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Yankee Atomic sought approximately $28.6 million in damages for the Phase IV period.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;On July 24, 2018, the Yankees filed a motion seeking partial summary judgment of $103.2 million in uncontested damages. The remaining approximately $1.1 million in contested damages remained on schedule for trial.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The parties had several pre-trial conferences with Judge Firestone on a variety of issues including uncontested damages and scheduling. Discovery was set to close originally on August 15, 2018, but later extended to October 15, 2018.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Trial was set for January 29 and 30, 2019.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;However, because of the partial government shutdown at the end of 2018 and into most of January 2019, Judge Firestone stayed all pre-trial actions in early January 2019, effectively delaying the trial. Following the reopening of the government at the end of January 2019, Judge Firestone issued a new Order setting trial for June 2019. On February 21, 2019, Judge Firestone ruled in the Yankees' favor on their pending Motion for Partial Summary Judgment. The Judge's ruling awarded Yankee Atomic $28.1 million in uncontested damages, while Connecticut Yankee was awarded $40.7 million, and Maine Yankee $34.4 million.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The government had 60 days to appeal this decision. On April 23, 2019, the government's right to appeal expired, the decision became final and a request for payment was sent to the U.S. Department of the Treasury. Payment was received on June 11, 2019.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Of the remaining approximately $1.1 million in total Yankees contested damages, Judge Firestone held a pre-trial hearing on a specific legal question regarding approximately $.1 million in total Yankees legal expenses related to the DOE litigation. Following briefing and oral argument on the issue, Judge Firestone denied the Yankees' claim for these damages. Of the remaining approximately $1 million in total Yankees contested damages, rather than go to trial on these issues, the parties negotiated an Offer of Settlement splitting the difference so that the Yankees ultimately received an additional $.5 million of total Yankees contested damages. Yankee Atomic's share of these damages totaled $.18 million. The acceptance of the Offer of Settlement by the Court ended the Phase IV cases.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company filed its Phase V case, on March 25, 2021, in the Federal Court of Claims, seeking damages for the period from January 1, 2017 through December 31, 2020. The Phase V case was assigned to Judge Carolyn Lerner, a new judge who was confirmed at the end of 2021. The Company submitted its Phase V damages claim to the government in October 2021. The Court had set July 25, 2023 as the date for trial.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;In June 2022, Judge Lerner issued an Order that, among other things, allowed the Yankees to amend their Complaint to add 2021 damages to the case.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;In November 2022, the case was reassigned to Judge Thompson Dietz who had been appointed to the Court in December 2020.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;In January 2023, at the request of all parties, Judge Dietz rescheduled the trial for the last two weeks of October 2023.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt; text-indent: 36pt; line-height: 105%"&gt; 				&lt;span&gt;During a pre-trial conference in the late Summer of 2023, Judge Dietz informed the parties that he did not want to hold the trial until after he had considered and ruled on the competing Summary Judgment Motions that had been filed.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;He scheduled oral argument on the Motions for November 2, 2023, and asked the parties to confer and agree to a trial that could be held in the Spring of 2024.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The parties informed the Court that they agreed to a trial that could be held during the last two weeks of March 2024.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;Following the hearing on the Summary Judgment Motions, Judge Dietz informed the parties that he would rule on the Motions soon. On February 7, 2024, Judge Dietz ruled in favor of the Yankees on the competing Summary Judgment Motions finding, in essence, that the government could not use trust fund earnings as a set off to damages.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt; text-indent: 36pt; line-height: 105%"&gt; 				&lt;span&gt;Judge Dietz held a status conference with the parties on February 22, 2024, to discuss next steps, including the consideration of pending discovery motions by both parties.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;On March 13, 2024, Judge Dietz issued an Order establishing a schedule to resolve the discovery disputes by June 10, 2024.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The Order also states that the Court will contact the parties to schedule a post discovery conference to set dates for further proceedings.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In late June 2024, Judge Dietz set the Phase V trial to occur during a two-week period beginning in late October through early November.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;In mid-September 2024, the parties reached a verbal agreement to settle the Phase V case subject to certain conditions.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The Yankees would receive $145 million of the approximately $149 million they would seek at trial, the Yankees' Boards of Directors and the senior management of the Department of Justice (&amp;quot;DOJ&amp;quot;) had to agree to the settlement amount, and the DOJ reserved the right to appeal Judge Dietz's Summary Judgment trust fund off-set decision in favor of the Yankees.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;All needed approvals were obtained and Judge Dietz issued an Order approving the settlement in mid-November 2024.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On January 17, 2025, the DOJ filed an appeal of Judge Dietz's Summary Judgment decision.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;As of this writing, no schedule has been established for the oral argument in the Federal Circuit Court of Appeals.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company filed its Phase VI case on March 31, 2026, in the Federal Court of Claims, seeking damages for the period January 1, 2022 through December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company believes it is entitled to continue to recover substantial damages for the DOE's ongoing breach of its contractual obligations and intends to vigorously pursue such recoveries.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span style="font-weight: bold"&gt;3.&lt;/span&gt;&lt;span style="width: 10.5pt; text-indent: 0; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Other Matters&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The Company has been involved in certain other legal matters in the regular course of business, including defending cases where former non-employee workers at the site have sued Yankee Atomic for damages for alleged injuries related to exposure to asbestos.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;One such asbestos case is pending against the Company as of December 31, 2024, which is in the discovery phase.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;This case is not expected to have a material financial impact on the Company. Accordingly, no amount has been accrued for this matter as of December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 		&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
    <ferc:ControlOverRespondentTextBlock id="f-934" contextRef="c-121">&lt;div&gt;&lt;h1 style="margin: 0; font-size: 16pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;Common Stock Ownership&lt;/h1&gt;&lt;p align="left" style="margin: 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;&lt;/p&gt;&lt;table border="0" cellspacing="0" cellpadding="0" style="margin-left: 6pt" class="e-rte-paste-table"&gt;  &lt;tr&gt;   &lt;td width="372" valign="top" style="width: 279pt; padding: 0 6pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: center"&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: center"&gt;Ownership&lt;/p&gt;   &lt;h5 style="margin: 0; text-align: center; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; font-weight: normal; text-decoration: underline"&gt;Percentage&lt;/h5&gt;   &lt;p style="margin: 0; text-align: justify; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: center"&gt;Shares&lt;/p&gt;   &lt;h4 align="center" style="margin: 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; font-weight: normal; text-decoration: underline; text-align: center"&gt;Issued&lt;/h4&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 8.1pt"&gt;   &lt;td width="372" valign="top" style="width: 279pt; padding: 0 6pt; height: 8.1pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;New   England Power Company (including interest as successor to Montaup Electric   Company)&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt; height: 8.1pt"&gt;   &lt;p align="left" style="margin: 4pt -6pt 0.0001pt 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;34.5%&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt; height: 8.1pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;2,646&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr&gt;   &lt;td width="372" valign="top" style="width: 279pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;The   Connecticut Light and Power Company&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt -6pt 0.0001pt 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;24.5&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;1,879&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr&gt;   &lt;td width="372" valign="top" style="width: 279pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;NSTAR   Electric &amp;amp; Gas Corporation (including interest as successor to Boston   Edison Company, Commonwealth Electric Company, Cambridge Electric Light   Company and Western Massachusetts Electric Company)&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt -6pt 0.0001pt 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;21.0&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;1,611&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr&gt;   &lt;td width="372" valign="top" style="width: 279pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;Central   Maine Power Company&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt -6pt 0.0001pt; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;9.5&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;729&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr&gt;   &lt;td width="372" valign="top" style="width: 279pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;Public   Service Company of New Hampshire&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt -6pt 0.0001pt; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;7.0&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;537&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr&gt;   &lt;td width="372" valign="top" style="width: 279pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;Green   Mountain Power Corporation&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt -6pt 0.0001pt; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;&lt;span style="text-decoration: underline"&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;3.5&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;&lt;span style="text-decoration: underline"&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;268&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr&gt;   &lt;td width="372" valign="top" style="width: 279pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt -6pt 0.0001pt; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="138" valign="top" style="width: 103.5pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: left"&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr&gt;   &lt;td width="372" valign="top" style="width: 279pt; padding: 0 6pt"&gt;   &lt;p align="left" style="margin: 4pt 0 0; font-size: 