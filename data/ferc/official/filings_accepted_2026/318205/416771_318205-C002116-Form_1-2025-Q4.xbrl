e="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;(c)&lt;/span&gt;&lt;span style="width: 9.12pt; text-indent: 0; font-size: 8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 8pt"&gt;This category includes investments in domestic corporate and/or government investment grade fixed-income instruments.&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;(d)&lt;/span&gt;&lt;span style="width: 8.67pt; text-indent: 0; font-size: 8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 8pt"&gt;This category includes investments in debt securities of foreign companies.&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;(e)&lt;/span&gt;&lt;span style="width: 9.12pt; text-indent: 0; font-size: 8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 8pt"&gt;This category includes investments in pooled funds which can include both domestic and foreign equity securities and debt instruments.&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 							&lt;span style="font-size: 8pt"&gt;(f)&lt;/span&gt;&lt;span style="width: 10.01pt; text-indent: 0; font-size: 8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 8pt"&gt;This category consists of cash and cash equivalents.&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; li