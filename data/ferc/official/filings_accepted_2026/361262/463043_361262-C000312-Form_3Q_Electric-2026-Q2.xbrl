							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial"&gt;Temporary Cash Investments (Account 136)&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:84pt; border-bottom-style:solid; border-bottom-width:1pt; padding-right:0.75pt; vertical-align:top"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="width:69.45pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:69.45pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#x2014;&lt;/span&gt;&lt;span style="width:2.9pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:81.35pt"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:3pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; page-break-after:avoid; font-size:12pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
