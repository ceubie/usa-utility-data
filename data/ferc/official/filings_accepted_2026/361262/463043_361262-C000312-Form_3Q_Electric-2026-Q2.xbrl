  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="HH582A4E700260C05D782FA2D6F218758A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:8pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;Please refer to the &amp;#x201C;Certain Relationships and Related Person Transactions&amp;#x201D; section of &lt;/span&gt;&lt;span style="font-family:Arial"&gt;FirstEnergy&amp;#x2019;s 202&lt;/span&gt;&lt;span style="font-family:Arial"&gt;6&lt;/span&gt;&lt;span style="font-family:Arial"&gt; Proxy&lt;/span&gt;&lt;span style="font-family:Arial"&gt; Statement.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
