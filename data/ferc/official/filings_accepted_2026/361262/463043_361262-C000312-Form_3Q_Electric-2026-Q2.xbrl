								&lt;span style="width:55.95pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:55.95pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;1,300&lt;/span&gt;&lt;span style="width:2.88pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:81.35pt"&gt;&amp;#160;&lt;/span&gt;&#xD;
