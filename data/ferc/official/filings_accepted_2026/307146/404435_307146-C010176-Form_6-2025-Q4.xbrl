    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">ONEOK, Inc., through the following wholly owned subsidiaries, owns all of the outstanding interest in EnLink Energy GP, LLC and EnLink Midstream Operating, LP, which own EnLink Delaware Crude Pipeline, LLC: ONEOK Partners, L.P., ONEOK ILP GP, L.L.C., ONEOK Partners Intermediate Partnership, EnLink Merger Sub II, L.L.C., EnLink Midstream GP, LLC, and EnLink Midstream Operating GP, LLC. As of December 31, 2025, ONEOK, Inc. owned 100% of the outstanding limited partner interest in EnLink Midstream Partners, LP which was controlled by ONEOK, Inc. through ownership of the GP interest.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Adjustments due to contributions in aid of construction.</span>
      </div>
    </link:footnote>
    <link:loc xlink:type="locator" xlink:label="f-49" xlink:href="#f-49"/>
    <link:loc xlink:type="locator" xlink:label="f-194" xlink:href="#f-194"/>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-49" xlink:to="fn-1" order="1"/>
