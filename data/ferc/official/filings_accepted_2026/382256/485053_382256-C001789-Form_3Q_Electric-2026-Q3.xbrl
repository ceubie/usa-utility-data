  <ferc:OtherRegulatoryAssets id="HH5DB1F6AB121CECD226CF8097FB383530" contextRef="HH8F3A12C1EAE3A96695FDB1B55EFCD9B2" decimals="0" unitRef="HHferc_us_Currency">34650291</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HH349C3ADB357F486FCEEB0427AA2F00C8" contextRef="HHA7975F7473D4F597E8C5A6A32EBC7730" decimals="0" unitRef="HHferc_us_Currency">190208</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HHB2D60F1095F97BFEDACBC66D4DC42C18" contextRef="HH53D35F4FC7EB7314094F62BC8A12731A" decimals="0" unitRef="HHferc_us_Currency">827088</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HHF60857C3088EDD9CB21B0CB41470D7D7" contextRef="HH93BB864FF0113B4F148CD558162657F1" decimals="0" unitRef="HHferc_us_Currency">19437129</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HHD846EE62D6D26A5EEFE0A86199F61566" contextRef="HH3A1C1A17E3BF4AAAB09D31760435CD02" decimals="0" unitRef="HHferc_us_Currency">453913</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HH592EA3967B19CFDE8854B55F7F7629B0" contextRef="HH6763BDA48D4A62CA72E735B55BEDBA47" decimals="0" unitRef="HHferc_us_Currency">3475330</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HHA099052A2E07D3935ED2D1675CDE7034" contextRef="HH3AA57F174D9338EF7EB6144EC4118F19" decimals="0" unitRef="HHferc_us_Currency">14128757</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HH70A3B55A43E969BF0CE588027CF3C85B" contextRef="HH681EBAA57496E5D3EE37CD12F360B179" decimals="0" unitRef="HHferc_us_Currency">17802965</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HH8BDF445BCF7A511D285F807DD7F2D6DD" contextRef="HH00BB247A6D79DFB5C6F24592D6368C72" decimals="0" unitRef="HHferc_us_Currency">0</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HH740A927D3D3701EB7C31E1BAB72B1B8B" contextRef="HHAA893A79C59B10536A73AAE73E77A68C" decimals="0" unitRef="HHferc_us_Currency">981099</ferc:OtherRegulatoryAssets>
