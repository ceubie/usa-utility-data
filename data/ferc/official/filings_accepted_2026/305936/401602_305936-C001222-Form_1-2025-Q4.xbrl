&lt;p class="MsoNormal" style="text-align: right;" align="right"&gt;&lt;strong&gt;&lt;span style="font-size: 9.0pt; font-family: 'Arial',sans-serif; layout-grid-mode: line;"&gt;$&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 2,112&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
