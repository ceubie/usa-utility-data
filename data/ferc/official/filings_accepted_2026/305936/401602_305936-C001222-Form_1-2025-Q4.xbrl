  <ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock id="HH26F298D96F05ADD051F0C74B218AC0A3" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock>
  <ferc:DisclosureOfRateTreatmentWhereUnamortizedLossOnReacquiredDebtAndUnamortizedGainOnReacquiredDebtAccountsAreNotUsedTextBlock id="HH0B76238A9F8E6C02F440632AE14FC4CE" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfRateTreatmentWhereUnamortizedLossOnReacquiredDebtAndUnamortizedGainOnReacquiredDebtAccountsAreNotUsedTextBlock>
