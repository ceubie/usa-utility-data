  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="width: 36pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 36pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;During the six months ended &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;June&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; 3&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;0&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, 2026, pursuant to the Cash Management Agreement among Buckeye Linden Pipe Line Company LLC (the "Company") and its affiliates, the Company effected a settlement of its &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;payables&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;to&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; Buckeye Pipe Line Transportation LLC, in the amount &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;$&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;3&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;2&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; million&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, previously&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; included in &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Payables to Affiliated Companies&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;through a&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;n&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;increase&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; of its &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Additional Paid-in-Capital&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, effectively representing a non-cash &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;capital contribution from Buckeye Pipe Line Transportation LLC.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
