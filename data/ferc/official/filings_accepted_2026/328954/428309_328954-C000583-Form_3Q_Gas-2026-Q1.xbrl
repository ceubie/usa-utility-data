    <link:footnote xlink:type="resource" xlink:label="fn-15" id="fn-15" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:48.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="display:none"/>
          </tr>
          <tr>
            <td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">On December 22, 2017, the Tax Cuts and Jobs Act was signed into law. The Tax Cuts and Jobs Act made extensive changes to the U.S. tax laws and included provisions that, beginning in 2018, reduced the U.S. corporate tax rate from 35 percent to 21 percent. We recorded regulatory liabilities associated with the revaluation of our deferred taxes due to the reduction in the corporate tax rate. The revaluation or excess tax reserve is being reversed through a normalization method of accounting over the average life of the underlying assets that created the reserve.</span>
            </td>
          </tr>
        </table>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-16" id="fn-16" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:68.916%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="display:none"/>
          </tr>
          <tr>
            <td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Park and Loan and Enhanced Aggregation Wheeling are balancing services; therefore, quantities are excluded as associated Dths used for balancing do not represent gas delivered.</span>
            </td>
          </tr>
        </table>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-17" id="fn-17" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <span xmlns="http://www.w3.org/1999/xhtml" style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Gas is valued at a monthly average price for the Chicago City-Gates point as published in the Platts Gas Daily publication.</span>
    </link:footnote>
