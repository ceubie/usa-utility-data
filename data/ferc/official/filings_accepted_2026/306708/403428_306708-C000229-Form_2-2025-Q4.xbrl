  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-1" contextRef="c-1">Juliett R. Mensing</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:TitleOfOfficerWithCustodyOfCorporateBooks id="f-2" contextRef="c-1">SVP and Chief Accounting Officer</ferc:TitleOfOfficerWithCustodyOfCorporateBooks>
  <ferc:AddressWhereCorporateBooksAreKept id="f-3" contextRef="c-1">370 Van Gordon Street, Lakewood, CO 80228</ferc:AddressWhereCorporateBooksAreKept>
  <ferc:GeneralInformationAboutIncorporationOfTheRespondentDescription id="f-4" contextRef="c-1">Illinois, February 21, 1980 as a partnership. Reorganized on December 18, 2007 as a Delaware limited liability company.</ferc:GeneralInformationAboutIncorporationOfTheRespondentDescription>
  <ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription id="f-5" contextRef="c-1">Not Applicable</ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription>
  <ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered id="f-6" contextRef="c-1">During the year ended December 31, 2025, Trailblazer Pipeline Company LLC was engaged in the transmission of natural gas for others in interstate commerce from Colorado through a portion of Wyoming to Beatrice, Nebraska.</ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-7" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="f-8" contextRef="c-1">&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;1.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;2.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;3.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;Trailblazer Pipeline Company LLC (&#8220;Trailblazer&#8221;) previously abandoned a total of approximately 392 miles of pipeline and related facilities comprising a portion of the Trailblazer Pipeline during the year ended December 31, 2024. See&#8239;Note 8 -&#8239;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Regulatory Matters&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#8239;in the Notes to the Financial Statements on Page 122 for additional detail. The abandoned pipeline and related facilities were subsequently sold by Trailblazer in February 2025. See Note 4 &#8211; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Related Party Transactions&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt; in the Notes to the Financial Statements on Page 122 for additional detail.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;4.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;5.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;6.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;7.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;8.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;9.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;10.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:4.11pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;11.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:4.11pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;12.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:4.11pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;13.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:4.11pt"&gt;Not Applicable&lt;/span&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock id="f-9" contextRef="c-1">&lt;div style="margin-bottom:6pt;margin-top:6pt;padding-left:18pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;1. Description of Business&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:107%"&gt;Trailblazer Pipeline Company LLC (&#8220;Trailblazer&#8221;) is a Delaware limited liability company that is engaged in the transmission of natural gas for others in interstate commerce from Colorado through Wyoming to Beatrice, Nebraska. Trailblazer provides service utilizing owned and operated pipeline as well as a Capacity Lease with Rockies Express Pipeline LLC (&#8220;REX&#8221;), an indirect wholly-owned subsidiary of Tallgrass Energy Partners, LP (&#8221;TEP&#8221;). See Note 8 - &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:107%"&gt;Regulatory Matters&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:107%"&gt; for additional information.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The sole member of Trailblazer is Tallgrass MLP Operations, LLC, a wholly-owned subsidiary of TEP.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;padding-left:18pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;2. Summary of Significant Accounting Policies&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Basis of Presentation&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The accompanying financial statements were prepared in accordance with the accounting requirements of the Federal Energy Regulatory Commission ("FERC") as set forth in its applicable Uniform System of Accounts and published accounting releases, which is a comprehensive basis of accounting other than accounting principles generally accepted in the United States of America ("GAAP").&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Use of Estimates&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Certain amounts included in or affecting these financial statements and related disclosures must be estimated, requiring management to make certain assumptions with respect to values or conditions which cannot be known with certainty at the time the financial statements are prepared. These estimates and assumptions affect the amounts reported for assets, liabilities, revenues, and expenses during the reporting period, and the disclosure of contingent assets and liabilities at the date of the financial statements. Management evaluates these estimates on an ongoing basis, utilizing historical experience, consultation with experts and other methods it considers reasonable in the particular circumstances. Nevertheless, actual results may differ significantly from these estimates. These estimates and other factors, including those outside of Trailblazer's control, such as the impact of commodity price volatility associated with global economic factors, could have a significant adverse impact on its business, financial position, or results of operations. Any impact of revisions to these estimates is recorded in the period in which the facts that give rise to the revision become known.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Going Concern&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;The accompanying financial statements have been prepared on a going concern basis, which contemplates the continuity of operations, the realization of assets and the satisfaction of liabilities in the normal course of business.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;As of the date of these financial statements, Trailblazer has generated recurring losses and negative cash flows from operations. Trailblazer has not yet established an ongoing source of revenues that is sufficient to cover its future operating costs and obligations as they become due during the twelve months following the issuance of these financial statements. These conditions raise substantial doubt about its ability to continue as a going concern for twelve months following the issuance of these financial statements.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;In response to these conditions, Trailblazer has begun the process of pursuing certain cost recovery mechanisms, however, the timeline and outcome is outside of the Company&#8217;s control and therefore cannot be deemed probable. As a result, TEP has the ability and will fully support the operating, investing, and financing activities of the Company. Trailblazer has concluded that management&#8217;s plans are probable of being achieved to alleviate substantial doubt about Trailblazer&#8217;s ability to continue as a going concern.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Cash Equivalents and Supplemental Cash Flow Information&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Trailblazer considers all highly liquid investments purchased with an original maturity of three months or less to be cash equivalents. &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Non-cash investing activities during the years ended December 31, 2025 and 2024 include accruals of property, plant, and equipment of $0.1 million and $0.9 million, respectively.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Accounts Receivable and Reserves for Credit Losses&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;Accounts receivable are carried at their estimated collectible amounts. Current expected credit losses for trade receivables are estimated using a combination of the probability-of-default methodology and review of aging schedules. Trade receivables are measured collectively, with customers grouped on the basis of their credit profile and line of business, and consideration is given to individual receivables that may have different risk profiles. Probability of default rates are assigned to customers based on actual credit ratings or estimated ratings based on available financial metrics. Outstanding receivables are periodically reviewed and for any specific receivables deemed uncollectible, a reserve for current expected credit losses is recorded. Trailblazer&#8217;s reserve for current expected credit losses totaled $0.4 million at December 31, 2025 and 2024.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Fuel Recovery Mechanism&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Trailblazer obtains natural gas quantities from its shippers as reimbursement for fuel consumed at compressor stations, fuel consumed in connection with compression and transportation by others, and other locations on its system, as well as for natural gas quantities lost and otherwise unaccounted for, in accordance with its tariff and applicable contract terms. Trailblazer tracks the volume and value of associated over- or under-collections of fuel and lost and unaccounted for quantities through a tracking mechanism referred to as "fuel tracker." Those amounts are recorded as an addition or reduction to a regulatory asset or liability balance representing the amounts to be recovered from or refunded to customers through the fuel tracker mechanisms. Fuel tracker volumes are valued using an average monthly index price.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Accounting for Regulatory Activities&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Regulatory assets and liabilities represent probable future revenues or expenses to Trailblazer associated with certain charges and credits that will be recovered from or refunded to customers through the ratemaking process. Trailblazer recorded $11.2 million and $1.6 million in regulatory assets (Account 182.3, Other Regulatory Assets) at December 31, 2025 and 2024, respectively, which were primarily attributable to costs associated with Trailblazer's fuel and power trackers and the FERC annual charge adjustment. Trailblazer recorded regulatory liabilities (Account 254, Other Regulatory Liabilities) of $2.5 million and $4.0 million at December 31, 2025 and 2024, respectively, related to Trailblazer's fuel and power trackers and regulatory liabilities associated with the remeasurement of Trailblazer's deferred income tax liability.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Gas Imbalances&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Gas imbalances receivable and payable represent the difference between customer nominations and actual gas receipts from and gas deliveries to interconnecting pipelines under various operational balancing and imbalance agreements. Gas imbalances are either made up in-kind or settled in cash, subject to the terms of the various agreements. Imbalances are valued at applicable average market index prices of $3.34 per MMBtu and $2.60 per MMBtu at December 31, 2025 and 2024, respectively.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Property, Plant and Equipment&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Utility Plant is stated at historical cost, which for a constructed plant includes indirect costs such as payroll taxes, other employee benefits, allowance for funds used during construction and other costs directly related to the projects. Expenditures that increase capacities, improve efficiencies or extend useful lives are capitalized and depreciated over the remaining useful life of the asset or major asset component. Trailblazer also capitalizes certain costs related to the construction of assets, including internal labor costs, interest and engineering costs.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Routine maintenance, repairs and renewal costs are expensed as incurred. The cost of normal retirements of depreciable utility property, plant and equipment, plus the cost of removal less salvage value and any gain or loss recognized, is recorded in accumulated depreciation with no effect on current period earnings. Gains or losses are recognized upon retirement of utility property, plant and equipment constituting an operating unit or system, and land, when sold or abandoned, and costs of removal or salvage are expensed when incurred.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Trailblazer maintains natural gas in its pipeline, known as "line pack," which serves to maintain the necessary pressure to allow efficient transmission of natural gas. Line pack is capitalized within Utility Plant and depreciated over the estimated useful life of the pipeline. &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Depreciation and Amortization&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Depreciation is computed based on the composite method over the estimated useful lives of property, plant and equipment. The annual composite rate of depreciation for the years ended December 31, 2025 and 2024 ranges from 0.7% to 10.0% for the various classes of depreciable assets. These depreciation rates include two components, one based on economic service life (capital recovery) and one based on net costs of removal (negative salvage).&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Impairment of Long-Lived Assets &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Trailblazer reviews its long-lived assets for impairment whenever events or changes in circumstances indicate that the carrying amount of an asset may not be recoverable. An impairment loss results when the estimated undiscounted future net cash flows expected to result from the asset's use and its eventual disposition are less than its carrying amount. Any such impairment losses at Trailblazer would be recorded as a regulatory asset until regulatory review regarding recoverability through the rate-making process is complete, at which time Trailblazer will recognize the loss if it is determined to be unrecoverable or retain it as a regulatory asset and recover through its rates.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Examples of long-lived asset impairment indicators include:&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;padding-left:36pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#8226;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt"&gt;a significant decrease in the market value of a long-lived asset or group;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;padding-left:36pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#8226;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt"&gt;a significant adverse change in the extent or manner in which a long-lived asset or asset group is being used or in its physical condition;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;padding-left:36pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#8226;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt"&gt;a significant adverse change in legal factors or in the business climate could affect the value of a long-lived asset or asset group, including an adverse action or assessment by a regulator which would exclude allowable costs from the rate-making process;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;padding-left:36pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#8226;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt"&gt;an accumulation of costs significantly in excess of the amount originally expected for the acquisition or construction of the long-lived asset or asset group;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;padding-left:36pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#8226;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt"&gt;a current period operating cash flow loss combined with a history of operating cash flow losses or a projection or forecast that demonstrates continuing losses associated with the use of a long-lived asset or asset group; and&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;padding-left:36pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;&#8226;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:14.5pt"&gt;a current expectation that, more likely than not, a long-lived asset or asset group will be sold or otherwise disposed of significantly before the end of its previously estimated useful life. &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;When an impairment indicator is present, Trailblazer first assesses the recoverability of the long-lived assets by comparing the sum of the undiscounted future cash flows expected to result from the use and eventual disposition of the asset to the carrying amount of the asset. If the carrying amount is higher than the undiscounted future cash flows, the fair value of the asset is assessed using a discounted cash flow analysis and used to determine the amount of impairment, if any, to be recognized.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Allowance for Funds Used During Construction&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Included in the cost of construction work in progress is an allowance for funds used during construction (&#8220;AFUDC&#8221;). AFUDC represents the estimated cost of debt, from borrowed funds, or the estimated cost of capital, from equity funds, during the construction period.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Revenue Recognition&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Trailblazer accounts for revenue from contracts with customers in accordance with the five-step model outlined in ASC 606, Revenue from Contracts with Customers ("ASC 606"). Under the five-step model, Trailblazer identifies the contract, identifies the performance obligations, determines the transaction price, allocates the transaction price, and recognizes revenue. Revenue is recognized when (or as) the performance obligations are satisfied. For additional information see Note 5 - &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Revenue from Contracts with Customers.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Commitments and Contingencies&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Trailblazer recognizes liabilities for other commitments and contingencies when, after fully analyzing the available information, it determines it is probable that a liability has been incurred and the amount of loss can be reasonably estimated. When a range of probable loss can be estimated, Trailblazer accrues the most likely amount, or if no amount is more likely than another, Trailblazer accrues the minimum of the range of probable loss.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Environmental Costs&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Trailblazer expenses or capitalizes, as appropriate, environmental expenditures that relate to current operations. Trailblazer expenses amounts that relate to an existing condition caused by past operations that do not contribute to current or future revenue generation. Trailblazer does not discount environmental liabilities to a net present value, and records environmental liabilities when environmental assessments and/or remedial efforts are probable and costs can be reasonably estimated. Recording of these accruals coincides with the completion of a feasibility study or a commitment to a formal plan of action. Estimates of environmental liabilities are based on currently available facts and presently enacted laws and regulations taking into consideration the likely effects of other factors including prior experience in remediating contaminated sites, other companies' clean-up experience and data released by government organizations. Trailblazer's estimates are subject to revision in future periods based on actual cost or new information.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Income Taxes&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Deferred income tax assets and liabilities are recognized for temporary differences between the basis of assets and liabilities for financial reporting and tax purposes. Changes in tax legislation are included in the relevant computations in the period in which such changes are effective. Deferred tax assets are reduced by a valuation allowance for the amount of any tax benefit Trailblazer does not expect to be realized. For more information regarding income taxes and the changes in tax legislation, see Note 3 - &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Income Taxes. &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;padding-left:18pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;3. Income Taxes&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;As a single-member limited liability company, Trailblazer is classified as a disregarded entity for income tax purposes. As a disregarded entity, Trailblazer's annual taxable income or loss is included in the tax return filed by a parent entity. The parent entity is a limited partnership subject to pass-through treatment for federal and state income tax purposes. Although Trailblazer does not directly pay federal or state income taxes, it has historically been allowed to treat the income tax paid by the ultimate owners of TEP as a cost component in rates allowed by the FERC. These taxes are calculated based on the composite federal and state tax rates of the ultimate owners of TEP and included in the applicable financial statements herein. In Trailblazer Pipeline Co., LLC, 166 FERC &#182; 61,141, at P 17 (2019), FERC established a framework permitting pass-through entities to report an income tax allowance equal to the proportion of partnership interest owned by partners treated as corporations for federal income tax purposes.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The computation of the current and deferred income tax expense assumes the use of an accelerated method for calculating tax depreciation. Trailblazer records deferred income taxes for significant differences between book and taxable income. Income taxes charged to Trailblazer and assignable to the ultimate owners of TEP are reflected in the accompanying Comparative Balance Sheet as taxes accrued (Account 236) and accumulated deferred income taxes (Accounts 190, 282 and 283). A portion of the change in Account 211, Miscellaneous Paid-In Capital (Account 211) reflects the income taxes assigned to the owners of TEP. Trailblazer settles accrued taxes recorded in Account 236 as a deemed contribution from or deemed distribution to its sole Member (a credit or debit to Additional Paid-in Capital or "APIC" (Account 211)).&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;margin-top:6pt;text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Components of the income tax expense applicable to federal and state income taxes are as follows (in thousands):&lt;/span&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:99.702%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:58.601%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.750%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.397%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.752%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="9" style="padding:2px 1pt;text-align:center;vertical-align:bottom"&gt;Year Ended December 31, &lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="border-top:1pt solid #000000;padding:2px 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;2025&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="border-top:1pt solid #000000;padding:0 1pt"/&gt;&lt;td colspan="3" style="border-top:1pt solid #000000;padding:2px 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;2024&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;Deferred income tax expense:&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="border-top:1pt solid #000000;padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="border-top:1pt solid #000;padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;