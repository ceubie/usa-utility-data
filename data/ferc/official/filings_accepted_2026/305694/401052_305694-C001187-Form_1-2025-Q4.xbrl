  <ferc:VendorName id="f-3557" contextRef="c-1">The Workiva Platform</ferc:VendorName>
  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">J. Caleb Adcock was named Chief Financial Officer and Senior Vice President, effective January 1, 2026. On December 31, 2025, J. Caleb Adcock was Chief Financial Officer and Vice President.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">On January 2, 2025 a Certificate of Cancellation was filed with the state of Delaware dissolving the LLC. Prior to dissolution, the LLC consisted of TEP (43.75% member), UNS Electric (6.25% member) and Salt River Project Agricultural Improvement and Power District (50% member).</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-3" id="fn-3" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The officers listed are all employees of Tucson Electric Power. However, they perform executive services for all UNS Energy Corporation affiliates. Officer salaries are allocated to affiliates based on a three-factor (assets, payroll, and revenues) weighted average formula. The officer salaries reported in column (c) represent the portion of base salaries allocated to UNS Electric for the year ended December 31, 2025.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-4" id="fn-4" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">J. Caleb Adcock was named Chief Financial Officer and Vice President, effective January 1, 2025.</span>
      </div>
    </link:footnote>
