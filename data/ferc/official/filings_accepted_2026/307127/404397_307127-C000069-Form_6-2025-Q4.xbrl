    <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
        <link:loc xlink:href="#f-23" xlink:label="f-23_lbl" xlink:type="locator" />
        <link:loc xlink:href="#f-241" xlink:label="f-241_lbl" xlink:type="locator" />
        <link:loc xlink:href="#f-778" xlink:label="f-778_lbl" xlink:type="locator" />
        <link:loc xlink:href="#f-1412" xlink:label="f-1412_lbl" xlink:type="locator" />
        <link:loc xlink:href="#f-1425" xlink:label="f-1425_lbl" xlink:type="locator" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-23_lbl" order="0" xlink:to="ft-23_47445_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-241_lbl" order="0" xlink:to="ft-241_47444_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-778_lbl" order="0" xlink:to="ft-778_47407_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1412_lbl" order="0" xlink:to="ft-1412_47199_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1425_lbl" order="0" xlink:to="ft-1425_47400_lbl" />
        <link:footnote xlink:label="ft-23_47445_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p>2024 results have been revised based on a correction to prior year depreciation expense and a reclassification of carrier/non-carrier expenses.<br /></p></link:footnote>
        <link:footnote xlink:label="ft-241_47444_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p>Ratebase has been revised based on a review of carrier property following Sunocos acquisition of NuStar Pipeline in 2024.<br /></p></link:footnote>
        <link:footnote xlink:label="ft-778_47407_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p style="text-align: left"><span style="color: rgba(0, 0, 0, 1); font-family: Roboto">In accordance with the Order Denying Rehearing, Denying Petition and Granting Remedies in Docket No. RM20-14-004 issued on November 20, 2025 footnote 111, we have determined that rebillings, as permitted in that Order, are not distortive. Accordingly, rebillings in the amount of $1.7 million are included in Account(s) 600.</span><br /></p></link:footnote>
        <link:footnote xlink:label="ft-1412_47199_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p>Cash Management Program with Sunoco LP</p></link:footnote>
        <link:footnote xlink:label="ft-1425_47400_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto">In accordance with the Order Denying Rehearing, Denying Petition and Granting Remedies in Docket No. RM20-14-004 issued on November 20, 2025 footnote 111, we have determined that rebillings, as permitted in that Order, are not distortive. Accordingly, rebillings in the amount of $1,759,668 are included in line 10, interstate operating revenue. These revenues represent a one-time event and are not representative of future revenues.</p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto">The cost of service results were calculated using the Cost of Service Model. This Model calculates cost of service using the Trended Original Cost methodology promulgated by the FERC in Opinion No. 154-B, 31 FERC 61,377 (1985), as modified and clarified by subsequent rulings.</p></div></link:footnote>
    </link:footnoteLink>
</xbrl>