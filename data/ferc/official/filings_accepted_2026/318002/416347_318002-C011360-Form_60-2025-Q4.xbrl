  <xbrli:context id="c-246">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.ferc.gov/CID">C011360</xbrli:identifier>
      <xbrli:segment>
        <xbrldi:typedMember dimension="ferc:MiscellaneousGeneralExpensesAxis">
          <ferc:MiscellaneousGeneralExpensesDomain>Misc Other Expenses</ferc:MiscellaneousGeneralExpensesDomain>
        </xbrldi:typedMember>
