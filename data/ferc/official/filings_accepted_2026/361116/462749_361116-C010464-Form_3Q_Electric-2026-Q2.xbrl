  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <span xmlns="http://www.w3.org/1999/xhtml" style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:103%">Bear Valley Electric Service, Inc (BVES) has 2 long-term firm point-to-point transmission contracts with Southern California Edison (SCE). A 33kV contract from 2 points of receipt to BVES with a total capacity of 39 MW and a 115kV firm point-to-point contract from Victor to Cottonwood substation with no maximum capacity specified.
        <span/> 
      </span>
    </link:footnote>
