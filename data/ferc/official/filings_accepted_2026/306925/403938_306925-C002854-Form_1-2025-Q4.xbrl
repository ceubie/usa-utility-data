; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;2027&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;2,933,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.6pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;2028&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;3,077,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.55pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;2029&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;3,228,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.6pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;2030&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;3,387,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.6pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;Thereafter&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;56,252,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.6pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt"&gt;Unamortized debt issuance costs&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 2.4pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span style="font-size: 12pt; text-decoration: underline"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 15.45pt; font-family: &amp;quot;Lucida Console&amp;quot;; font-size: 12pt; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; text-decoration: underline"&gt;(1,368,038&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.4pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 12pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.4pt"&gt; 							&lt;span style="font-size: 12pt"&gt;$&lt;/span&gt;&lt;span style="font-size: 12pt; text-decoration: underline"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 13.15pt; font-family: &amp;quot;Lucida Console&amp;quot;; font-size: 12pt; text-decoration: underline; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; text-decoration: underline"&gt;70,304,962&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0.45pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 8pt; margin-left: 40.8pt; margin-bottom: 4pt; text-indent: -18pt; page-break-inside: avoid; page-break-after: avoid; font-size: 12pt"&gt; 				&lt;span&gt;&lt;span style="color: rgba(15, 71, 97, 1)"&gt;5.&lt;/span&gt;&lt;span style="width: 9pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;OPERATIONS AND MAINTENANCE&lt;/span&gt;&lt;span style="letter-spacing: -0.75pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;AGREEMENT&lt;/span&gt; 			&lt;/h2&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 11.25pt 0 51.55pt; text-align: justify; font-size: 12pt"&gt; 				&lt;span&gt;SDG&amp;amp;E is the ultimate owner of the leased transmission line. SDG&amp;amp;E is responsible for the operation and maintenance of the line during the Company's lease term. As part of the lease agreement, the Company pays SDG&amp;amp;E additional rent for relevant maintenance and operational costs. The Company incurred approximately $3,788,000 and $3,865,000 of maintenance and operation expenses from SDG&amp;amp;E in the years ended December 31, 2025 and 2024,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.3pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 8pt; margin-left: 40.8pt; margin-bottom: 4pt; text-indent: -28.85pt; page-break-inside: avoid; page-break-after: avoid; font-size: 12pt"&gt; 				&lt;span&gt;&lt;span&gt;6.&lt;/span&gt;&lt;span style="width: 19.85pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;LOW-INCOME ASSISTANCE&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;ACTIVITIES&lt;/span&gt; 			&lt;/h2&gt; 			&lt;p style="margin-top: 0.55pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 11.3pt 0 51.55pt; text-align: justify; font-size: 12pt"&gt; 				&lt;span&gt;During 2012, Citizens Energy Corporation (the Parent Company), on behalf of CST, began a program that provides assistance to low-income families in the Imperial Valley of California. The program aims to reduce energy bills for low-income residents through the use of on-bill credits. The funding of the program will be provided by CST pursuant to its agreement with SDG&amp;amp;E to apply one-half of CST's adjusted profits derived from the Sunrise Powerlink Transmission Project to this purpose.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.25pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.05pt; margin-left: 51.55pt; margin-bottom: 0; text-align: justify; line-height: 12.6pt"&gt; 				&lt;span style="font-size: 12pt"&gt;The funding obligation for the years ended December 31, 2025 and 2024 amounted to approximately&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 11.4pt 0 51.55pt; text-align: justify; font-size: 12pt"&gt; 				&lt;span&gt;$1,268,000 and $1,161,000, respectively, and was recorded in general and administrative expenses in the accompanying statements of income and member's deficit. As of December 31, 2025 and 2024, the accrued low-income assistance payable amounted to approximately $1,202,000 and $827,000, respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.35pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 8pt; margin-left: 40.8pt; margin-bottom: 4pt; text-indent: -28.85pt; page-break-inside: avoid; page-break-after: avoid; font-size: 12pt"&gt; 				&lt;span&gt;&lt;span&gt;7.&lt;/span&gt;&lt;span style="width: 19.85pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;RELATED PARTY&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;TRANSACTIONS&lt;/span&gt; 			&lt;/h2&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 11.45pt 0 51.55pt; text-align: justify; font-size: 12pt"&gt; 				&lt;span&gt;Under an administrative service agreement entered into between the Company and Citizens Enterprises Corporation, certain management and administrative services were provided to the Company. The aggregate fees charged to the Company were approximately $292,000 and $276,000 in the fiscal years 2025 and 2024, respectively. Amounts outstanding in the balance sheets at December 31, 2025 and 2024, were approximately $175,000 and $146,000,&lt;/span&gt;&lt;span style="letter-spacing: 0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 		&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
