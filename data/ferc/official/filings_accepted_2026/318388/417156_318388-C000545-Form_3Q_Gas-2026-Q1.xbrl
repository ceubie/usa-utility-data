  <ferc:OrderNumber id="HHCD8C51806C51B93A2DF8ECE393D71A6B" contextRef="HHFC1C9EA63168932F510031F4CECB2855" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH6421358480E1856CEC4C6EDE9FDDC4A6" xlink:label="HH6421358480E1856CEC4C6EDE9FDDC4A6" />
    <link:footnote xlink:type="resource" xlink:label="HHB0B47FEF2CB48D93DD6FEE8A0F13F88D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: rgba(0, 0, 0, 1); font-family: sans-serif; font-size: medium; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal;">
          <strong>
            <em>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">Schedule Page: 278 Line No.: 2 Column: a</span>
              </span>
            </em>
          </strong>
        </p>
        <p>
          <span style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Pursuant to Section 22 of the General Terms and Conditions of MRT's FERC Gas Tariff, Seventh Revised Volume No.1, </span>
          <span style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Docket No. RP26-23-000, as approved by FERC's order issued on October 20, 2025.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6421358480E1856CEC4C6EDE9FDDC4A6" xlink:to="HHB0B47FEF2CB48D93DD6FEE8A0F13F88D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHEE5EDB7B0A3A2332B615FF48E024F77C" xlink:label="HHEE5EDB7B0A3A2332B615FF48E024F77C" />
    <link:footnote xlink:type="resource" xlink:label="HH92694A55568E9A2F32FBB3C7B28F5CE6" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <p>
            <strong>
              <em>
                <span style="font-family: Arial, Helvetica, sans-serif;">
                  <span style="font-size: 12pt;">Schedule Page: 278 Line No.: 1 Column: a</span>
                </span>
              </em>
            </strong>
          </p>
          <p>
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt;">
                <span style="color: #000000; font-size: 14px;">
                  <span style="font-size: 12pt;">Pursuant to Section 34 of the General Terms and Conditions ("GT&amp;C") of MRT's FERC Gas Tariff, Seventh Revised Volume No.1, Docket No. RP26-124-000, MRT is required to credit to eligible firm </span>
                </span>
                <span style="color: #000000; text-align: inherit; background-color: unset; font-size: 12pt;">customers penalty revenues collected during the Penalty Base Period. The annual base period runs August 1 through July 31. Under the terms </span>
                <span style="color: #000000; font-size: 14px;">
                  <span style="font-size: 12pt;">of Section 34 of the GT&amp;C, MRT is not required to calculate revenue credits until the Total Penalty Crediting Revenues exceed </span>
                </span>
                <span style="color: #000000; font-size: 14px;">
                  <span style="font-size: 12pt;">$250,000.</span>
                </span>
              </span>
            </span>
          </p>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHEE5EDB7B0A3A2332B615FF48E024F77C" xlink:to="HH92694A55568E9A2F32FBB3C7B28F5CE6" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH6B8DFEAE75CCE350C6D7E48F6DB4E38D" xlink:label="HH6B8DFEAE75CCE350C6D7E48F6DB4E38D" />
    <link:footnote xlink:type="resource" xlink:label="HH3688101CE6178058064ADD7E7CC108BE" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong style="font-weight: bold; color: rgba(51, 51, 51, 1);">
            <em>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">Schedule Page: 120 Line No.: 16.1 Column: b</span>
              </span>
            </em>
          </strong>
        </p>
        <p>
          <img title="Screenshot CF Footnote.gif" src="data:image/gif;base64," alt="" width="407" height="152" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6B8DFEAE75CCE350C6D7E48F6DB4E38D" xlink:to="HH3688101CE6178058064ADD7E7CC108BE" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHDB82CB15C0BFD2C7B22968703AB8D813" xlink:label="HHDB82CB15C0BFD2C7B22968703AB8D813" />
    <link:footnote xlink:type="resource" xlink:label="HHA71891B141D20DF92FEB143F57B3B75B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-weight: bold; font-family: sans-serif; font-size: medium;">
            <em>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">Schedule Page: 520 Line No.: 3 Columns: c and d</span>
              </span>
            </em>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; font-size: medium; color: #333333; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Gas purchase expense was booked to Natural gas transmission line purchases, Account 803.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHDB82CB15C0BFD2C7B22968703AB8D813" xlink:to="HHA71891B141D20DF92FEB143F57B3B75B" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH108E0787C5FA84260ADC8A159CDA666D" xlink:label="HH108E0787C5FA84260ADC8A159CDA666D" />
    <link:footnote xlink:type="resource" xlink:label="HHFEA024361A63EC436A5B4F8122969C93" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-weight: bold; font-family: sans-serif; font-size: medium;">
            <em>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">Schedule Page: 520 Line No.: 12 Columns: c and d</span>
              </span>
            </em>
          </span>
        </p>
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">This represents gas withdrawn from storage to support system management activity.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH108E0787C5FA84260ADC8A159CDA666D" xlink:to="HHFEA024361A63EC436A5B4F8122969C93" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH6238E28BEE421A236AF12C6B6C5BC013" xlink:label="HH6238E28BEE421A236AF12C6B6C5BC013" />
    <link:footnote xlink:type="resource" xlink:label="HH31B1117465E038164E173B453B4AABCC" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong style="font-family: sans-serif; font-size: medium;">
            <em>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">Schedule Page: 520 Line No.: 27 Columns: c and d</span>
              </span>
            </em>
          </strong>
        </p>
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">This represents gas delivered to storage to support system management activity.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6238E28BEE421A236AF12C6B6C5BC013" xlink:to="HH31B1117465E038164E173B453B4AABCC" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE42A88354FE811940E49AF98CC4875FD" xlink:label="HHE42A88354FE811940E49AF98CC4875FD" />
    <link:footnote xlink:type="resource" xlink:label="HHD27490032B63F2156D64AB4E0DE487BB" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: sans-serif; font-size: medium;">
          <strong style="font-size: 16px; font-family: Arial, Helvetica, sans-serif;">
            <em>Schedule Page: 521 Line No.: 7 Column: f</em>
          </strong>
        </p>
        <p style="margin: 0px; color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <em>
              <strong style="font-style: normal; font-family: Arial, Helvetica, sans-serif;">
                <em>
                  <span style="font-size: 12pt; font-style: normal; font-weight: 400;">The basis for valuing the gas reported on columns (f), (g) and (h) is the weighted average rate for system gas.</span>
                </em>
              </strong>
            </em>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE42A88354FE811940E49AF98CC4875FD" xlink:to="HHD27490032B63F2156D64AB4E0DE487BB" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF954BDD3127828E1BCA0358719386A04" xlink:label="HHF954BDD3127828E1BCA0358719386A04" />
    <link:footnote xlink:type="resource" xlink:label="HHD533C2AE899D76B9286A6D3FA548D8B4" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <em>
                <strong>Schedule Page: 521 Line No.: 22 Column: i</strong>
              </em>
            </span>
          </span>
        </p>
        <p style="margin: 0px; color: #000000; font-family: sans-serif; font-size: medium;">
          <strong style="font-size: 16px; font-family: Arial, Helvetica, sans-serif;">
            <em>
              <strong style="font-style: normal;">
                <em>
                  <span style="font-size: 12pt; font-style: normal; font-weight: 400;">Gas used for other operational purposes includes blow-downs and other operational uses of gas other than compressor station fuel, and in-kind volumes of gas delivered to other pipelines in accordance with applicable transportation contracts. This footnote applies to all three months.</span>
                </em>
              </strong>
            </em>
          </strong>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF954BDD3127828E1BCA0358719386A04" xlink:to="HHD533C2AE899D76B9286A6D3FA548D8B4" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH461B79B59BC96E4177D74F941DBD976B" xlink:label="HH461B79B59BC96E4177D74F941DBD976B" />
    <link:footnote xlink:type="resource" xlink:label="HH8501FA05CED8FA86A44D6FACCDDAC024" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium; margin: 0px 0px 10px;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <em>
                <strong>Schedule Page: 521 Line No.: 43.1 and 55.1 Column: i</strong>
              </em>
            </span>
          </span>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium; margin: 0px 0px 10px;">
          <strong style="font-size: 16px; font-family: Arial, Helvetica, sans-serif;">
            <em>
              <strong style="font-style: normal;">
                <em>
                  <span style="font-size: 12pt; font-style: normal; font-weight: 400;">Cumulative volumes of in-kind gas owed to or due from shippers are revalued to market price each month. The dollars reported on this page reflect the net valuation for the current month volumes and exclude the revaluation adjustment.</span>
                </em>
              </strong>
            </em>
          </strong>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH461B79B59BC96E4177D74F941DBD976B" xlink:to="HH8501FA05CED8FA86A44D6FACCDDAC024" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>