&lt;td style="width: 20.7pt; border-top: 4.5pt solid #000000; border-left: 0.75pt solid #000000; border-bottom: 4.5pt solid #000000; padding-right: 5.4pt; padding-left: 5.03pt; vertical-align: bottom; -aw-border-left: 0.5pt single;"&gt;
