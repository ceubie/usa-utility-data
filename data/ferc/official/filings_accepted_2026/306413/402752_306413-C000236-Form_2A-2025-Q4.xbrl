&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;Steven Romano&amp;#160;&lt;/font&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;&amp;#8211; Vice President&lt;/font&gt;&lt;/p&gt;
