          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; mso-yfti-lastrow: yes;">
              <xhtml:td style="width: 553.25pt; border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="738">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Property, Plant, and Equipment</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 20.85pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="28">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border: solid windowtext 1.0pt; border-left: none; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="192">
                <xhtml:p class="MsoNormal" style="text-align: right;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">1,657,333</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
