							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:2.95pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:120%; font-size:12pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
					&lt;/tr&gt;&#xD;
					&lt;tr style="height:12.75pt; -aw-height-rule:exactly"&gt;&#xD;
						&lt;td style="width:209.95pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:bottom"&gt;&#xD;
