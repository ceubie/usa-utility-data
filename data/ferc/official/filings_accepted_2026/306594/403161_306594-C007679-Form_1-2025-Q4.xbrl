    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH1B1306C271E1F0B58F4E2F71451B7CFB" xlink:to="HH9E494277AC33308F8B16FBDEE61CA093" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH1713E766C7FCCEDC8E648B827B38C014" xlink:label="HH1713E766C7FCCEDC8E648B827B38C014" />
    <link:footnote xlink:type="resource" xlink:label="HH68968B6C293B7F48B8ADBB53C435C665" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">FICA, Payroll Tax, , 2025
</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH1713E766C7FCCEDC8E648B827B38C014" xlink:to="HH68968B6C293B7F48B8ADBB53C435C665" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH353732E4D25C88E535E5B34872630FB8" xlink:label="HH353732E4D25C88E535E5B34872630FB8" />
    <link:footnote xlink:type="resource" xlink:label="HH49996B90B98D39E649BB56CABBC1522C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">
          <strong>
            <span style="font-size: 11.0pt; line-height: 115%;">TrAIL </span>
          </strong>
          <span style="font-size: 11.0pt; line-height: 115%;">is included in the consolidated federal income tax return filed by <strong>FET </strong>and is party to an intercompany income tax allocation agreement among the consolidated group members pursuant to which consolidated tax liability is allocated in accordance with IRC Section 1552 and Treasury Regulations 1.1502-33(d)(3) and 1.1552-1(a)(2).&#160; Each member&#8217;s federal income tax liability is determined as if such member filed a separate tax return and such tax is paid to the parent of the group.&#160; Members generating losses or credits are compensated by the parent in proportion to the amount of such member&#8217;s losses or credits used by other members of the consolidated group.&#160; In accordance with federal tax normalization rules, and for ratemaking purposes only, certain net operating loss carryforwards may be shown on a separate return basis without regard to any utilization by the consolidated income tax group.&#160; &#160;&#160;</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH353732E4D25C88E535E5B34872630FB8" xlink:to="HH49996B90B98D39E649BB56CABBC1522C" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH3C4655C0442607A9449F1F88FE5E9822" xlink:label="HH3C4655C0442607A9449F1F88FE5E9822" />
    <link:footnote xlink:type="resource" xlink:label="HH9641B367551BE3DCA84B08A6EF4A4B4A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">TrAIL's Transmission service is administered through a Regional Transmission Organization (RTO) and requested information is not available as the individual company does not represent a distinct zone within the RTO; rather each Regional Transmission Expansion Plan (RTEP) project is billed individually.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH3C4655C0442607A9449F1F88FE5E9822" xlink:to="HH9641B367551BE3DCA84B08A6EF4A4B4A" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>