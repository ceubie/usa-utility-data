							&lt;span style="font-family:Arial; font-weight:bold"&gt;As of December 31,&lt;/span&gt;&#xD;
						&lt;/p&gt;&#xD;
					&lt;/td&gt;&#xD;
					&lt;td style="width:79.45pt; border-bottom-style:solid; border-bottom-width:1pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:bottom"&gt;&#xD;
