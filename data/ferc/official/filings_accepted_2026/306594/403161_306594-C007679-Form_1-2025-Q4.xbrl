    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE42303D4671667258121A2A9A04E679B" xlink:to="HH533E78D292538BFA4C78E2E1ABC2FD8A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHFB30E51831817AED8173EE25A765E9A6" xlink:label="HHFB30E51831817AED8173EE25A765E9A6" />
    <link:footnote xlink:type="resource" xlink:label="HH21C1E5D5631612BF4E6BD32689F4311A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div class="ps-content" style="height: 200px;">
          <div class="ng-star-inserted">
            <div>
              <span style="color: #000000; font-family: Arial, sans-serif; font-size: 10pt; line-height: 15.3333px;">Revenues earned from PJM Interconnection, LLC (PJM) per the revenue requirement for the Transmission Expansion Project filed with FERC. The </span>
              <span style="color: #000000; font-family: Arial, sans-serif; font-size: 10pt; line-height: 15.3333px;">2025 </span>
              <span style="color: #000000; font-family: Arial, sans-serif; font-size: 10pt; line-height: 15.3333px;">year-to-date revenue requirement formula rate includes the Point-to-Point revenue per FERC Docket No.</span>
              <span style="color: #000000; font-family: Arial, sans-serif; font-size: 10pt; line-height: 15.3333px;">ER07-562</span>
              <span style="color: #000000; font-family: Arial, sans-serif; font-size: 10pt; line-height: 15.3333px;">. The annual requirement is allocated to a monthly revenue, paid to TrAIL by PJM members.</span>
            </div>
            <div>&#160;</div>
            <div>
              <table style="width: 720px; border-radius: 2px 2px 0px 0px; border-spacing: 0px; display: inline-table; margin-bottom: 5pt; vertical-align: text-bottom;">
                <tbody>
                  <tr>
                    <td style="width: 6.95312px;">&#160;</td>
                    <td style="width: 248.266px;">&#160;</td>
                    <td style="width: 2.14062px;">&#160;</td>
                    <td style="width: 8.75px;">&#160;</td>
                    <td style="width: 82.3594px;">&#160;</td>
                    <td style="width: 2px;">&#160;</td>
                    <td style="width: 7.15625px;">&#160;</td>
                    <td style="width: 82.0469px;">&#160;</td>
                    <td style="width: 2px;">&#160;</td>
                    <td style="width: 8.75px;">&#160;</td>
                    <td style="width: 80.3438px;">&#160;</td>
                    <td style="width: 2px;">&#160;</td>
                    <td style="width: 8.75px;">&#160;</td>
                    <td style="width: 80.3438px;">&#160;</td>
                    <td style="width: 2px;">&#160;</td>
                    <td style="width: 8.75px;">&#160;</td>
                    <td style="width: 84.8281px;">&#160;</td>
                    <td style="width: 2.0625px;">&#160;</td>
                  </tr>
                  <tr>
                    <td style="padding: 0px 1pt;" colspan="3">&#160;</td>
                    <td style="padding: 2px 1pt; text-align: center; vertical-align: bottom;" colspan="3">
                      <span style="color: #000000; font-family: Arial, sans-serif; font-size: 10pt; line-height: 16px; text-decoration-line: underline;">1st Qtr 2025</span>
                    </td>
                    <td style="padding: 2px 1pt; text-align: center; vertical-align: bottom;" colspan="3">
                      <span style="color: #000000; font-family: Arial, sans-serif; font-size: 10pt; line-height: 16px; text-decoration-line: underline;">2nd Qtr 2025</span>
