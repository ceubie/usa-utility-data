    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAA5FBD8719474DD5747A7408B60A86A3" xlink:to="HHF4BE7A740B71EE130C53057AE0395215" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH482B38766DC093884E8CE7292B263AD7" xlink:label="HH482B38766DC093884E8CE7292B263AD7" />
    <link:footnote xlink:type="resource" xlink:label="HHBA65CE4DE1F75A41F0D12DE478BFE87E" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">Includes a credit of $ (4,236,803) related to rent revenue received for transmission buildings in West Virginia.</span>
        </p>
      </div>
