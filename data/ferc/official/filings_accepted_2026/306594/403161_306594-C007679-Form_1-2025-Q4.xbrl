							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:120%; font-size:12pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:99.75pt; padding-right:0.75pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial"&gt;$&lt;/span&gt;&lt;span style="width:84.19pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:89.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;7&lt;/span&gt;&lt;span style="width:2.89pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:97.1pt"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:7.5pt; padding-right:0.75pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:12pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
					&lt;/tr&gt;&#xD;
					&lt;tr style="height:15.75pt; -aw-height-rule:exactly"&gt;&#xD;
						&lt;td style="width:209.95pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-left:6.75pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial"&gt;LOCs&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:2.95pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:120%; font-size:12pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:99.75pt; border-bottom-style:solid; border-bottom-width:1pt; padding-right:0.75pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="width:89.2pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:89.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;1&lt;/span&gt;&lt;span style="width:2.89pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:97.1pt"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:7.5pt; padding-right:0.75pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:12pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
					&lt;/tr&gt;&#xD;
					&lt;tr style="height:15.75pt; -aw-height-rule:exactly"&gt;&#xD;
						&lt;td style="width:209.95pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:1.65pt; margin-bottom:1.5pt; line-height:120%; font-size:9pt"&gt;&#xD;
