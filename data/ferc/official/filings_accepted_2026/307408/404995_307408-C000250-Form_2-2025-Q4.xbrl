; margin-bottom: 0; text-align: right"&gt; 							&lt;span style="font-family: Arial"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt;&lt;/tr&gt;&lt;tr style="height: 15.6pt"&gt;&lt;td style="width: 251.2pt; padding-right: 0.75pt; padding-left: 0.75pt; vertical-align: middle" class=""&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Transportation and compression expenses&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 					&lt;/td&gt;&lt;td style="width: 11.8pt; padding-right: 0.75pt; padding-left: 0.75pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt;&lt;td style="width: 69.75pt; padding-right: 0.75pt; padding-left: 0.75pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-align: center"&gt; 							&lt;span style="font-family: Arial"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;-&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt;&lt;td style="width: 16.1pt; padding-right: 0.75pt; padding-left: 0.75pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt;&lt;td style="width: 11.8pt; padding-right: 0.75pt; padding-left: 0.75pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt;&lt;td style="width: 65.4pt; padding-right: 0.75pt; padding-left: 0.75pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;3.8&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt;&lt;td style="width: 14.95pt; vertical-align: top" class=""&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right; font-size: 9pt"&gt; 							&lt;span style="font-size: 10pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;(5)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt; 			&lt;p style="margin-top: 14pt; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;(1) For the year ended 2025, PEPL provided gas transportation services primarily to Rover Pipeline LLC (&amp;quot;Rover&amp;quot;), a less than wholly-owned subsidiary of Energy Transfer, which its transportation receivables from Rover were $4.3 million. For the year ended 2024, PEPL provided gas transportation services primarily to Rover, which its transportation receivables from Rover and Pan Gas were $3.8 million and $0.1 million, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;(2) Corporate charges and services provided by Energy Transfer and its subsidiaries.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;(3) Interest income and interest expense from cash management program.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;(4) For the year ended 2025, c&lt;span style="font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;ontract storage fees were from Pan Gas, which provided 60.9 Bcf of underground storage services to PEPL, and Lee 8 Storage Partnership, a joint venture of PEPL. For the year ended 2024, in addition to the associated companies mentioned above, PEPL also had contract storage fees from Houston Pipe Line Company LP, an indirect wholly-owned subsidiary of Energy Transfer. A&lt;/span&gt;ll transactions are at rates pursuant to the existing tariff.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span style="font-family: Arial"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;(5) Transportation and compression expenses primarily provided by Trunkline Gas Company, LLC (&amp;quot;Trunkline&amp;quot;), a direct wholly-owned subsidiary of PEPL.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span style="font-family: Arial"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 58.3pt; margin-bottom: 0; text-indent: -22.3pt"&gt; 				&lt;span style="font-family: Arial"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Panhandle participates in a cash management program (&amp;quot;CMA&amp;quot;) with Energy Transfer, whereby all of Panhandle's cash receipts and cash disbursements are processed through Energy Transfer's cash accounts with a corresponding credit or charge to an intercompany promissory note between Energy Transfer and PEPL (&amp;quot;Intercompany Promissory Note&amp;quot;). The CMA with Energy Transfer is recorded in Notes receivable from associated companies, Account 145, or Advances from associated companies, Account 223. An interest rate based on Energy Transfer's weighted average interest rate on its outstanding indebtedness is applied to Intercompany Promissory Note balance. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;The Panhandle cash management program applies to PEPL's subsidiaries whereby the PEPL subsidiaries transfer funds in excess of their operational needs to PEPL. If any of PEPL's subsidiaries has insufficient funds to meet its operating needs, funds are borrowed from PEPL to cover the deficit. Cash funding activity with PEPL's subsidiaries is recorded in Notes receivable from associated companies, Account 145, or Notes payable to associated companies, Account 233. An interest rate of 5% per annum is applied to the net intercompany balance between PEPL and its subsidiaries. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Accounts receivable from associated companies is primarily related to gas transportation services, various operating and administrative services and interest earned related to the cash management program with Energy Transfer.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Accounts payable to associated companies primarily related to underground gas storage services, payroll funding, interest expense related to the cash management program with PEPL's subsidiaries and various operating and administrative services provided by Energy Transfer and its subsidiaries.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;PEPL has transportation and exchange gas receivables and payables with various associated companies as a result of differences in volumes of gas received and delivered on behalf of those associated companies. The imbalances are settled based on the operator balancing agreements that PEPL has with those associated companies.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;The following table sets forth the balances with associated companies within transportation and exchange gas receivables and payables reflected in&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Miscellaneous current and accrued assets, Account 174, and Miscellaneous current and accrued liabilities, Account 242, respectively, on the balance sheet:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-family: Arial"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 436.5pt; margin-left: 22.5pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr style="height: 12pt"&gt; 					&lt;td style="width: 2.25pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 244.05pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 9.3pt; border-bottom: 1pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="4" style="width: 137.7pt; border-bottom: 1pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;December 31,&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12pt"&gt; 					&lt;td style="width: 2.25pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 244.05pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="