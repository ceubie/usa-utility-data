        <link:footnote xlink:label="ft-641_47451_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 0.0001pt; color: rgba(51, 51, 51, 1); font-family: Roboto"><b style="font-weight: bold"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 102 Line No.: 2 Column: d</span></span></b></p><p style="margin: 0 0 0.0001pt; color: rgba(51, 51, 51, 1); font-family: Roboto"><b style="font-weight: bold"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></b></p><p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Energy Transfer Interstate Holdings LLC has a 99% limited partner interest in Panhandle Eastern Pipe Line, LP and a 100% membership interest in Southern Union Panhandle LLC.</span></span></p><p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt; background-color: unset; text-align: inherit">Southern Union Panhandle LLC has a 1% general partner interest in Panhandle Eastern Pipe Line Company, LP.</span></p><p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt; background-color: unset; text-align: inherit"><br /></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-657_47447_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1580px; min-height: 0" alt="" /> </p><p><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-1256_47456_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 350 Line No.: 1 Column: e</span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Account 186, Miscellaneous deferred debits was used to record deferred charges for regulatory commission expense. This footnote applies to columns (e), (i) and (l), lines 1 and 2.</span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1292_47475_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 118 Line No.: 14 Column: c</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Panhandle Eastern Pipe Line Company, LP, as a limited partnership, records partners' capital in Other Paid-In Capital.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Statement of Retained Earnings (unaudited)</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1310_47464_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)">Schedule Page: 220 Line No.: 5 Column: f</b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none">Current gas represents gas that is anticipated to be utilized within a twelve-month period.</span></span><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"><br /></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1365_47452_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 118 Line No.: 25.1 Column: c</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Reclassed Equity in Earnings for Year, Account 418.1 to Other Paid-in Capital, Account 211. See page 253 Other Paid-In Capital.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1574_47463_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 336 Line No.: 10 Column: b</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">General plant is depreciated on a straight line basis per assigned FERC rates.</span></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1851_47460_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 521 Line No.: 7 Column: f</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">The basis for valuing the gas reported in columns (f), (g), and (h) is the weighted average rate for system gas.</span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1941_47455_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1580px; min-height: 0" alt="" /></p><p> <br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-2056_47457_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 262 Line No.: 6 Column: i</b></span></span></p><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Reversals of prior year accruals. This footnote also applies to lines 8 and 10, column (i).</span></span></p><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2071_47474_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 220 Line No.: 5 Column: i</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">PEPL utilizes the inventory method to account for the gas.</span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2190_47449_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 233 Line No.: 3 Column: f</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Includes adjustments for OPEB true up per actuarial report.</span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2744_47468_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 219 Line No.: 17.1 Column: c</b></span></span></p><p style="margin: 0; color: rgba(0, 0, 0, 1); font-family: Roboto"><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="422" height="122" alt="" style="vertical-align: bottom; border: 0; cursor: pointer; display: inline-block; float: none; margin: auto 5px; max-width: 1410px; position: relative; padding: 1px; color: rgba(0, 0, 0, 1) !important; min-width: 0; min-height: 0" /> </p></div></link:footnote>
        <link:footnote xlink:label="ft-2745_47469_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 338 Line No.: 7 Column: b</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">D</span></span></span><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; text-decoration: inherit; display: inline !important">epreciation Plant Basis reflects balance as of 12/31/2025. This footnote also applies to lines 8 and 9 column (b).</span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2750_47485_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 313 Line No.: 1 Column: c</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">The volumes include discounted reservation contract quantities and commodity transactions.</span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2913_47473_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 521 Line No: 7 Column: e</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The allocation is derived from the throughput volume of each contract within the billing system. A path to path calculation of the rate utilized within the contract billing is determined and a percentage for recourse rate, discount rate and negotiated rate is derived based on the rate charged within the paths. This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3034_47466_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 521 Line No.: 21 Column: b</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Other Deliveries are unmetered gas losses. This footnote applies to all columns line 21 - Other Deliveries.</span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3368_47465_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 520 Line No.: 29.1 Column: d</b></span></span></p><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="505" height="203" style="min-width: 0; max-width: 1580px; min-height: 0" alt="" /></p><p><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3443_47470_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 520 Line No.: 20 Column: c</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">For the purpose of the Annual Charge Adjustment ("ACA") calculation, the throughput volume is </span><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">974,699,493</span><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"> Dth as represented on line 20. No additional volumes are needed to calculate the total volumes eligible for the ACA surcharge.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><br/></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3463_47471_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><b style="font-weight: 700">Schedule Page: 520 Line No.: 27 Column: d</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: nowrap; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">Other gas delivered to storage represents injections of system balancing gas. This footnote also applies to column (c).</span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: nowrap; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"><br /></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3471_47472_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><b style="font-weight: bold">Schedule Page: 520 Line No.: 12 Column: d</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><b style="font-weight: 700; font-style: normal; text-align: left; text-indent: 0; white-space: nowrap; background-color: rgba(255, 255, 255, 1); color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px"><b style="font-weight: 700; color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: nowrap"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: nowrap; background-color: rgba(255, 255, 255, 1); display: inline !important">Other gas withdrawn from storage represents withdrawals of system balancing gas. This footnote also applies to column (c).</span></b></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><b style="font-weight: 700; font-style: normal; text-align: left; text-indent: 0; white-space: nowrap; background-color: rgba(255, 255, 255, 1); color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px"><b style="font-weight: 700; color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: nowrap"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: nowrap; background-color: rgba(255, 255, 255, 1); display: inline !important"><br /></span></b></b></p></div></link:footnote>
        <link:footnote xlink:label="ft-3531_47480_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 514 Line No: 5 Column e</b></span></span></span><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">PEPL operated 343 miles of transmission pipe in Ohio, of which PEPL owned 302.6 miles and ANR owned 40.4 miles.</span></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3535_47481_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 514 Line No: 6 Column e</b></span></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">PEPL operated 432.2 miles of transmission pipeline in Oklahoma, of which PEPL owned 422.6 miles and Pan Gas Storage LLC owned 9.6 miles.</span></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3536_47479_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 514 Line No: 4 Column e</b></span></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><em style="color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); text-decoration: inherit; display: inline !important">PEPL operated 387 miles of transmission pipe in Michigan, of which PEPL owned 347.5 miles, Pan Gas Storage LLC owned 39.2 miles and Battle Creek Gas Company owned 0.3 miles.</span></em></span></span></span></p><p style="margin: 0; font-family: Roboto"><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3537_47467_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 514 Line No: 1 Column e</b></span></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none">PEPL operated 1,246.2 miles of transmission pipe in Illinois, of which PEPL owned 1,227.7 miles and Pan Gas Storage LLC owned 18.5 miles.</span></span></span></span></p><p style="margin: 0; font-family: Roboto"><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3539_47478_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 514 Line No: 3 Column e</b></span></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none">PEPL operated 1,794 miles of transmission pipe in Kansas, of which PEPL owned 1,763.8 miles and Pan Gas Storage LLC owned 30.2 miles.</span></span></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none"><br /></span></span></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none">In 2024 Form 2 page 514, Transmission Lines in Kansas reported 173.9 miles has discrepancy with page footnote data. The correct miles was 1,793.9 which was stated correctly on the page footnote data.</span></span></span></span></p><p style="margin: 0; font-family: Roboto"><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3540_47477_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 514 Line No: 2 Column e</b></span></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none">PEPL operated 817.7 miles of transmission pipe in Indiana, of which PEPL owned 817.4 miles and Dayton Power and Light owned 0.3 miles.</span></span></span></span></p><p style="margin: 0; font-family: Roboto"><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3551_47462_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 338 Line No.: 9 Column: c</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The applied depreciation rates for Intangibles range from 2.5% to 20.0%.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3777_47461_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 338 Line No.: 8 Column: c</b></span></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The applied depreciation rates for General Plant range from 1.7% to 20.0%.</span></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3896_47458_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 0.0001pt; line-height: normal; font-size: 11pt"><b><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 103 Line No.: 5 Column: d</span></span></b></p><p style="margin: 0 0 0.0001pt; line-height: normal; font-size: 11pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><em><br /></em></span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Panhandle Storage LLC has 29% direct joint control in Lee 8 Storage Partnership.</span></span></p><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3899_47459_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><pre style="margin: 0 0 0.0001pt; line-height: normal; font-size: 11pt"><b style="font-weight: 700"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 103 Line No.: 8 Column: d</span></span></b><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><em><br /></em></span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span><b style="font-weight: 700"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"></span></span></b><span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt; background-color: initial; text-align: inherit">Trunkline LNG Holdings LLC has 20% direct joint control in Lake Charles Exports, LLC.</span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></pre></link:footnote>
        <link:footnote xlink:label="ft-3911_47519_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 514 Line No: 9 Column e</b></span></span></span></p><p style="margin: 0; font-size: 12pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">PEPL owned 0.2 miles of transmission pipeline in Indiana, and is operated by Trunkline Gas Company, LLC, a subsidiary of PEPL.</span></span><span style="font-size: 11pt"> </span></p><p style="margin: 0"><br style="color: rgba(0, 0, 0, 1); font-family: Roboto" /></p></div></link:footnote>
    </link:footnoteLink>
