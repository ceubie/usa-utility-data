    <link:footnoteArc xlink:type="arc" xlink:from="value1" xlink:to="footnote1" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="1" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote33" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">A correction was made to the 2024 real equity rate of return, thus resulting in updated 2024 amounts from the previous filing. The impact is minimal as Hammond uses settlement terms instead of cost of service to determine its FERC tariffs. Additionally, Hammond was under-recovering in 2024 and the adjustment increases the under-recovery.</xhtml:p>
      </xhtml:div>
    </link:footnote>
