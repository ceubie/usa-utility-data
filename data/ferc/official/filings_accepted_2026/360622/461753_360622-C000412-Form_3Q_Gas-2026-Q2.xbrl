  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:label="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" />
    <link:footnote xlink:type="resource" xlink:label="HHBBCD2FC39705354AFEA3BDF3CF1F197F" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto, 'Segoe UI', GeezaPro, 'DejaVu Serif', 'sans-serif', -apple-system, BlinkMacSystemFont;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-weight: bold;">Schedule Page: 521 Line No.: 7 Column: e</span>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto, 'Segoe UI', GeezaPro, 'DejaVu Serif', 'sans-serif', -apple-system, BlinkMacSystemFont;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">The allocation is derived by determining whether the reservation rate charged within the billing system is discounted, negotiated or recourse. This determination is applied to the retained fuel charged per contract scheduled path, and a pro rata is derived and applied to all volumes and dollars.</span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto, 'Segoe UI', GeezaPro, 'DejaVu Serif', 'sans-serif', -apple-system, BlinkMacSystemFont;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span>
          </span>
        </p>
        <p style="margin: 0px; color: #000000; font-family: Roboto, 'Segoe UI', GeezaPro, 'DejaVu Serif', 'sans-serif', -apple-system, BlinkMacSystemFont;">&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:to="HHBBCD2FC39705354AFEA3BDF3CF1F197F" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE42A88354FE811940E49AF98CC4875FD" xlink:label="HHE42A88354FE811940E49AF98CC4875FD" />
    <link:footnote xlink:type="resource" xlink:label="HHD589CCC3704405BBEC9E53745A723DAD" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto, 'Segoe UI', GeezaPro, 'DejaVu Serif', 'sans-serif', -apple-system, BlinkMacSystemFont;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-weight: bold;">Schedule Page: 521 Line No.: 7 Column: f</span>
            </span>
          </span>
        </p>
        <p style="margin: 0px; color: #000000; font-family: Roboto, 'Segoe UI', GeezaPro, 'DejaVu Serif', 'sans-serif', -apple-system, BlinkMacSystemFont;">
          <span style="font-family: Arial, Helvetica, sans-serif; font-size: 16px;">The basis for valuing the gas reported in columns (f), (g), and (h) is the weighted average rate for system gas.</span>
        </p>
        <p style="margin: 0px; color: #000000; font-family: Roboto, 'Segoe UI', GeezaPro, 'DejaVu Serif', 'sans-serif', -apple-system, BlinkMacSystemFont;">&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE42A88354FE811940E49AF98CC4875FD" xlink:to="HHD589CCC3704405BBEC9E53745A723DAD" order="1" />
