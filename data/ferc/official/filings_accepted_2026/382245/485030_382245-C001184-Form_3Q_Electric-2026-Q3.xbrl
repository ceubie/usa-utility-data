    <link:footnote xlink:type="resource" xlink:label="fn-19" id="fn-19" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Docket #ER15-1860-000 has details on the Interconnection and TSA 218 reported herein.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-20" id="fn-20" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Docket #ER16-1920-001 has details on the Interconnection and TSA 267 reported herein.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-21" id="fn-21" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">UNS Electric, Inc. and Tucson Electric Power Company are affiliated, wholly-owned subsidiaries of UNS Energy Corporation.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-22" id="fn-22" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">The grandfathered agreement executed between Tucson Electric Power Company and El Paso Electric Company includes the exchange of transmission services over agreed-upon facilities. The contract terminates 40 years from commercial operation of the Springerville-Luna 345kV circuit during July 2027.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-23" id="fn-23" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">The amounts listed in column (i) above on page 329 reflect energy reserved. MWh received equals MWh delivered because losses are accounted for financially and included in column (m).</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-24" id="fn-24" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">The amounts listed in column (j) above on page 329 reflect energy reserved. MWh received equals MWh delivered because losses are accounted for financially and included in column (m).</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-25" id="fn-25" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Monthly average coincident peak</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-26" id="fn-26" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Amortization of 2023 Open Access Transmission Tariff (OATT) Undercollections.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-27" id="fn-27" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">The amounts listed as Other Charges in column (m) on page 330 include ancillary charges, losses, and adjustments related to the prior period.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-28" id="fn-28" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Amounts listed as "Other Charges" include prior period adjustments, ancillary charges, losses and refunds.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-29" id="fn-29" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">"Other Charges" in column (g) include amounts charged by Arizona Public Service Company ("APS") for non-conforming transmission service under APS Service Agreement Nos. 336, 337, and 378. The contracts terminate in 2052.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-30" id="fn-30" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Purchased Power and Fuel Adjustment Clause (PPFAC) ratemaking treatment.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-31" id="fn-31" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <span xmlns="http://www.w3.org/1999/xhtml" style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">The grandfathered agreement executed between Tucson Electric Power Company and El Paso Electric Company includes the exchange of transmission services over agreed-upon facilities. The Springerville-Luna 345kV contract terminates July 2027.</span>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-32" id="fn-32" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Times New Roman',serif;font-size:10pt;font-weight:400;line-height:120%">Amounts reported in column (j) include capacity reserved to meet the obligation of Rate Schedule No. 49, a grandfathered agreement that includes a power exchange between Tucson Electric Power Company and El Paso Electric Company.</span>
      </div>
    </link:footnote>
