&lt;p class="MsoNormal" style="text-align: justify; text-justify: inter-ideograph; text-indent: -.5in; line-height: normal; mso-pagination: none; tab-stops: .5in center 3.25in; margin: 0in 0in 0in .5in;"&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-align: justify; text-justify: inter-ideograph; text-indent: -.5in; line-height: normal; mso-pagination: none; tab-stops: .5in center 3.25in; margin: 0in 0in 0in .5in;"&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;strong&gt;Removal, effective 10/03/2025&lt;/strong&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-align: justify; text-justify: inter-ideograph; text-indent: -.5in; line-height: normal; mso-pagination: none; tab-stops: .5in center 3.25in; margin: 0in 0in 0in .5in;"&gt;&lt;strong&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;/strong&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;Slater, David J., Representative, DTM NEXUS&lt;/span&gt;&lt;/p&gt;
