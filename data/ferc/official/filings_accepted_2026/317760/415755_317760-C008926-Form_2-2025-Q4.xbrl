    <link:footnote xlink:type="resource" xlink:label="HH233716EEF3F5DC8D7E13920336D47100" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All plant base amounts reported are the ending plant balances.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7DE469DC4BF9381EC20735A77DF4036F" xlink:to="HH233716EEF3F5DC8D7E13920336D47100" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH565378F6AA95F134EF17E30AF2751AEB" xlink:label="HH565378F6AA95F134EF17E30AF2751AEB" />
    <link:footnote xlink:type="resource" xlink:label="HH9D5B4473206B6D634734996F6C1AE544" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All plant base amounts reported are the ending plant balances.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH565378F6AA95F134EF17E30AF2751AEB" xlink:to="HH9D5B4473206B6D634734996F6C1AE544" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHAE37AA9D7011DAD2BEC298FC11B232EB" xlink:label="HHAE37AA9D7011DAD2BEC298FC11B232EB" />
    <link:footnote xlink:type="resource" xlink:label="HHB42157A3B16BEB65D49EBF60C359687F" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All system balancing gas recorded under the fixed asset method as defined by FERC Order 581.</span>
          <br style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;" />
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">Initial line pack is recorded in the plant account 117.1 (non-current). Any additional system gas volumes needed for load balancing, no notice transportation and other operational purposes is recorded in account 117.2 (current portion).</span>
          <br style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;" />
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">For purposes of accounting for encroachment resulting from line inventory changes, we used Account 117.4 with appropriate debits to Account 808.1 and credits to Account 808.2.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAE37AA9D7011DAD2BEC298FC11B232EB" xlink:to="HHB42157A3B16BEB65D49EBF60C359687F" order="1" />
