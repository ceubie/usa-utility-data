    <link:footnote xlink:type="resource" xlink:label="HH0DB9AD81C7099C9EA15D4B52E2238433" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
