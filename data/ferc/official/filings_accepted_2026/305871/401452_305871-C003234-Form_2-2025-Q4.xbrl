    <link:footnoteArc xlink:type="arc" xlink:from="value36" xlink:to="footnote36" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="36" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote37" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
