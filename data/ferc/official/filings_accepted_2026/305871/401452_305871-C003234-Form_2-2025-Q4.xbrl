    <link:footnoteArc xlink:type="arc" xlink:from="value16" xlink:to="footnote16" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="16" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote17" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Use tax is distributed to various accounts based on the accounts charged for the originating invoice.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value17" xlink:to="footnote17" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="17" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote18" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">The cost rate percentage of common equity is based on the average earned during the preceding 3 years. Bear Creek's recent rate case settlements (RP12-121 and RP19-51) have been black box settlements with no stated cost rate percentage of common equity.</xhtml:span>
          <xhtml:u>
          </xhtml:u>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value18" xlink:to="footnote18" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="18" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote19" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Rate for borrowed funds used for Bear Creek Storage Company, L.L.C. is equal to the average rate of its owners, Southern Natural Gas Company, L.L.C. (2.10%) and Tennessee Gas Pipeline Company, L.L.C. (1.84%).</xhtml:span>
          <xhtml:u>
          </xhtml:u>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value19" xlink:to="footnote19" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="19" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote20" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Rate for other funds used for Bear Creek Storage Company, L.L.C. is equal to the average rate of its owners,</xhtml:span>
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Southern Natural Gas Company, L.L.C. (7.94%) and Tennessee Gas Pipeline Company, L.L.C. (8.45%).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value20" xlink:to="footnote20" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="20" />
