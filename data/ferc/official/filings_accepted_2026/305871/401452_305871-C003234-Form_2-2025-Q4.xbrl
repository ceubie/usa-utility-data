&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 16pt;"&gt;&lt;font style="font-family: Arial; font-weight: bold;"&gt;Year Ended December 31,&lt;/font&gt;&lt;/p&gt;
