        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">As of December 31, 2025, we estimate that the following deferred tax balance in Account 282 could be used in the development of jurisdictional recourse rates:</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
        </xhtml:p>
        <xhtml:table class="MsoTableGrid" style="width: 16.0in; border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" width="1536" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; mso-yfti-lastrow: yes; height: .3in;">
              <xhtml:td style="width: 13.6in; border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="1306">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Property, Plant, and Equipment</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: .4in; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="38">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border: solid windowtext 1.0pt; border-left: none; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="bottom" width="192">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal;" align="right">
