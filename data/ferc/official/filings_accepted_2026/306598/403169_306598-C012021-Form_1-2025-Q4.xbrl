					&lt;td style="width:98.95pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:top"&gt;&#xD;
						&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; line-height:120%; font-size:12pt"&gt;&#xD;
							&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
						&lt;/p&gt;&#xD;
					&lt;/td&gt;&#xD;
