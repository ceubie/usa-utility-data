                  <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 8pt; font-weight: 400; line-height: 120%;">1st Qtr 2024</span>
                </td>
                <td style="padding: 2px 1pt; text-align: center; vertical-align: bottom;" colspan="3">
