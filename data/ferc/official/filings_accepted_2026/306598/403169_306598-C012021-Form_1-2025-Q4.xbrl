						&lt;td style="width:276.7pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-left:6pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial"&gt;Temporary Cash Investments (Account 136)&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:54.45pt; border-bottom-style:solid; border-bottom-width:1pt; padding-right:5.4pt; padding-left:5.4pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="width:49.95pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:49.95pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#x2014;&lt;/span&gt;&lt;span style="width:2.9pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:61.85pt"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="padding-right:5.4pt; padding-left:5.4pt; vertical-align:top"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:64.5pt; border-bottom-style:solid; border-bottom-width:1pt; padding-right:0.75pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="width:49.95pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:49.95pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#x2014;&lt;/span&gt;&lt;span style="width:2.9pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:61.85pt"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
