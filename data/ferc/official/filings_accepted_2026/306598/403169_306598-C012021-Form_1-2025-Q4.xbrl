    <link:footnote xlink:type="resource" xlink:label="HHF448130921C6846A20EE6ACC55B08D1F" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
Federal Income Tax, Income Tax, , 2025</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHFB7E2F963D881C0E943757CD44411B7A" xlink:to="HHF448130921C6846A20EE6ACC55B08D1F" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH28A8A58096C74775B49EBC81C2A3B722" xlink:label="HH28A8A58096C74775B49EBC81C2A3B722" />
    <link:footnote xlink:type="resource" xlink:label="HH30C852490AE9CA01CD5798B9435E586D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">PA Corp. Net Income, Income Tax, PA, 2025
</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH28A8A58096C74775B49EBC81C2A3B722" xlink:to="HH30C852490AE9CA01CD5798B9435E586D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHBC4DCD5FBF507C3346BC942891783B74" xlink:label="HHBC4DCD5FBF507C3346BC942891783B74" />
    <link:footnote xlink:type="resource" xlink:label="HH533D0E7BA66E105C1C825F55B45B6080" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">
          <strong>
            <span style="font-size: 11.0pt; line-height: 115%;">KATC </span>
          </strong>
          <span style="font-size: 11.0pt; line-height: 115%;">is included in the consolidated federal income tax return filed by <strong>FirstEnergy Corp.</strong>&#160;and is party to an intercompany income tax allocation agreement among the consolidated group members pursuant to which consolidated tax liability is allocated in accordance with IRC Section 1552 and Treasury Regulations 1.1502-33(d)(3) and 1.1552-1(a)(2).&#160; Each member&#8217;s federal income tax liability is determined as if such member filed a separate tax return and such tax is paid to the parent of the group.&#160; Members generating losses or credits are compensated by the parent in proportion to the amount of such member&#8217;s losses or credits used by other members of the consolidated group.&#160; In accordance with federal tax normalization rules, and for ratemaking purposes only, certain net operating loss carryforwards may be shown on a separate return basis without regard to any utilization by the consolidated income tax group.&#160; &#160;&#160;</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHBC4DCD5FBF507C3346BC942891783B74" xlink:to="HH533D0E7BA66E105C1C825F55B45B6080" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH925FA12F0A7D28BCD8652C5A6887CC42" xlink:label="HH925FA12F0A7D28BCD8652C5A6887CC42" />
    <link:footnote xlink:type="resource" xlink:label="HH97DF18B10BB0A52C60A5F5D6CAA1B536" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>KATCo's Transmisison service is administered through a Regional Transmission Organization (RTO) and requested information is not available as the individual company does not represent a distinct zone within the RTO.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH925FA12F0A7D28BCD8652C5A6887CC42" xlink:to="HH97DF18B10BB0A52C60A5F5D6CAA1B536" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>