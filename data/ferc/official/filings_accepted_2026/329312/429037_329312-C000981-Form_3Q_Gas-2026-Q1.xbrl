                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Pursuant to Instruction 9, Line 12 includes:</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 251.597px; border-width: 1pt 1pt 4.5pt medium; border-style: solid solid solid none; border-color: windowtext windowtext windowtext currentcolor; padding: 0in 5.4pt; height: 21px;" valign="top">
