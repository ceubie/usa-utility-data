    <link:footnoteArc xlink:type="arc" xlink:from="value4" xlink:to="footnote4" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="4" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote11" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
          </xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
        <xhtml:div style="line-height: 108%; font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level, rather than by service type (i.e., firm transport, interruptible transport, etc.) or by discounted, negotiated, or recourse rate contracts. Therefore, the amounts reported have been allocated to the service types and to discounted, negotiated or recourse rate contracts based on reasonable assumptions.</xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value11" xlink:to="footnote11" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="11" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote12" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
          </xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
        <xhtml:div style="line-height: 108%; font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Volumes shown on this line are those for vent gas, heater fuel and greenhouse gas. This footnote applies to all periods within the quarter.</xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value12" xlink:to="footnote12" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="12" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote13" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
          </xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
        <xhtml:div style="line-height: 108%; font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">The value of this gas is based on the current month cash out price provided for in our tariff. This footnote applies to all periods within the quarter.</xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
