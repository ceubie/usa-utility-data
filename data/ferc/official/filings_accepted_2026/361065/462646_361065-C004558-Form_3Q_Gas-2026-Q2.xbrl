    <link:loc xlink:type="locator" xlink:label="value9" xlink:href="#Tag436" />
    <link:loc xlink:type="locator" xlink:label="value10" xlink:href="#Tag437" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote6" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">Recorded pursuant to Docket No. AI93-5-000 issued April 23, 1993 (Accounting for Income Taxes).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value6" xlink:to="footnote6" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="6" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote7" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Recorded pursuant to Docket No. RP20-148-000. Remaining balance at end of current filing period will be refunded through adjustments to future period fuel retention rates.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value7" xlink:to="footnote7" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="7" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote8" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level, rather than by discounted, negotiated or recourse rate contracts; therefore, the amounts reported have been allocated to discounted, negotiated or recourse rate contracts based on reasonable assumptions. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value8" xlink:to="footnote8" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="8" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote9" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">The value of this gas is based on the current month cash-out price provided for in our tariff.<xhtml:span style="mso-spacerun: yes;"></xhtml:span>This footnote applies to all periods within the quarter.<xhtml:u></xhtml:u></xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value9" xlink:to="footnote9" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="9" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote10" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Normal">
          <xhtml:span style="font-size: 18.0pt;">
            <xhtml:span style="font-family: arial, helvetica, sans-serif;">Shipper supplied gas and gas lost and unaccounted for are not directly charged to an account. As directed under FERC Order No. 581, we record "Other Regulatory Assets/Liabilities" (Accounts 182.3 / 254) through offsetting entries booked to "Regulatory Debits/Credits", (Accounts 407.3/.4) for any excess or deficiency in net shipper supplied gas (Line 37). This footnote applies to Lines 4 and 26 for all periods within the quarter.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value10" xlink:to="footnote10" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="10" />
  </link:footnoteLink>
</xbrli:xbrl>
