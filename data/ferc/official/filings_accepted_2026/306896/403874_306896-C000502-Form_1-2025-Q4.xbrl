  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="HHEBA1CD44839C108D1DAFD6DE3427BE45" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;8. A 3.9% average increase for wage and hourly employees became effective April 8, 2025.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock>
  <ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock id="HH22FBAEA0509E80B804A4341B1670898A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;9. None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock>
  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="HH582A4E700260C05D782FA2D6F218758A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;10. None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
  <ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock id="HHFB056E8F64ABA7B86B31B31B7725CE20" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;12. None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;13. Directors Ronald Graber and Bradley Kulka resigned from Wisconsin River Power Company's Board of Directors in February. Benjamin Bilitz and Kathryn Wilhelm were appointed as directors.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock id="HHD790CCB2EDB33AB49E3957CEAFD4E7D7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;14. None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div class="WordSection1"&gt;
&lt;p class="MsoNormal" style="text-align: center; line-height: 120%; mso-outline-level: 1;" align="center"&gt;&lt;strong style="text-align: center; font-size: 0.9rem;"&gt;&lt;span style="font-size: 11.0pt; mso-bidi-font-size: 12.0pt; line-height: 120%; font-family: 'Calibri',sans-serif; mso-fareast-font-family: Calibri;"&gt;GLOSSARY OF TERMS AND ABBREVIATIONS&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/div&gt;
&lt;div class="WordSection1"&gt;
&lt;p class="MsoNormal" style="text-align: center; line-height: 120%; mso-outline-level: 1;" align="center"&gt;&lt;a name="Section1"&gt;&lt;/a&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="line-height: 120%;"&gt;&lt;strong&gt;&lt;span style="font-size: 11.0pt; mso-bidi-font-size: 12.0pt; line-height: 120%; font-family: 'Calibri',sans-serif; mso-fareast-font-family: Calibri;"&gt;&amp;#160;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="margin-bottom: 5.0pt; line-height: 120%;"&gt;&lt;span style="font-size: 10.0pt; mso-bidi-font-size: 12.0pt; line-height: 120%; font-family: 'Calibri',sans-serif; mso-fareast-font-family: Calibri;"&gt;The abbreviations and terms set forth below are used throughout this report and have the meanings assigned to them below:&lt;/span&gt;&lt;/p&gt;
