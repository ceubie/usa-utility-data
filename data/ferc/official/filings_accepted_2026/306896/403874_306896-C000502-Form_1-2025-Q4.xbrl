&lt;td style="width: 80.25pt; border: none; mso-border-top-alt: solid black 1.0pt; background: #CCCCCC; padding: 0in .75pt 0in 0in; height: 12.0pt; mso-height-rule: exactly;" valign="bottom" width="107"&gt;
