&lt;p class="MsoNormal" style="text-align: right; tab-stops: 44.6pt 76.85pt; margin: 2.75pt 0in 1.5pt 0in;" align="right"&gt;&lt;span style="font-size: 9pt; font-family: Calibri, sans-serif;"&gt;$&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 280,000 &lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 3.75pt; background: #CCCCCC; padding: 0in 0in 0in 0in; height: 12.0pt; mso-height-rule: exactly;" valign="bottom" width="5"&gt;
