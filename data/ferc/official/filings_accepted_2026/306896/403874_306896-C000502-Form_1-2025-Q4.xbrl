&lt;/td&gt;
&lt;td style="width: 80.25pt; border: none; border-bottom: solid black 1.0pt; padding: 0in 2.65pt 0in 2.65pt; height: 12.0pt; mso-height-rule: exactly;" valign="bottom" width="107"&gt;
