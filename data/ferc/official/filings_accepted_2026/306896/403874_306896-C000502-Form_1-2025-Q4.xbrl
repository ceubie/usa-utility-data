&lt;/td&gt;
&lt;td style="width: 410.25pt; border: none; border-bottom: solid black 1.0pt; padding: 0in 2.65pt 0in 2.65pt; height: 12.0pt;" colspan="15" valign="bottom" width="547"&gt;
&lt;p class="MsoNormal" style="text-align: center; page-break-after: avoid; margin: 3.75pt 0in 1.5pt 0in;" align="center"&gt;&lt;strong&gt;&lt;span style="font-size: 9pt; font-family: Calibri, sans-serif;"&gt;Pension Plan Assets&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
