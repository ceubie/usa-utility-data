  <ferc:ControlOverRespondentTextBlock id="HH603760CF1DD86B04F6DFD4ADAF9B592D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;Wisconsin Public Service Corporation, whose parent company is Integrys Holding, Inc., a wholly owned subsidiary of WEC Energy Group, Inc., and Wisconsin Power and Light Company, a wholly owned subsidiary of Alliant Energy Corporation, are equal 50% owners of the company. Wisconsin Public Service Corporation is the operator of Wisconsin River Power Company.&lt;/p&gt;&lt;/div&gt;</ferc:ControlOverRespondentTextBlock>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
