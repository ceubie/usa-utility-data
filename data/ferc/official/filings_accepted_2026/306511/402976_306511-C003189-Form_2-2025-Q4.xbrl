&lt;td style="width: 74.7pt; border-top: 0.75pt solid #000000; border-left: 0.75pt solid #000000; border-bottom: 0.75pt solid #000000; padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top; -aw-border-bottom: 0.5pt single; -aw-border-left: 0.5pt single; -aw-border-top: 0.5pt single;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; line-height: normal; font-size: 10pt;"&gt;&lt;font style="font-family: Arial;"&gt;$&lt;/font&gt;&lt;font style="font-family: Arial; -aw-import: spaces;"&gt;&amp;#160; &lt;/font&gt;&lt;font style="font-family: Arial;"&gt;247,108,401&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 178.2pt; border-top: 0.75pt solid #000000; border-right: 0.75pt solid #000000; border-bottom: 0.75pt solid #000000; padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top; -aw-border-bottom: 0.5pt single; -aw-border-right: 0.5pt single; -aw-border-top: 0.5pt single;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: normal; font-size: 10pt;"&gt;&lt;font style="font-family: Arial;"&gt;General Plant&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 74.7pt; border: 0.75pt solid #000000; padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top; -aw-border: 0.5pt single;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; line-height: normal; font-size: 10pt;"&gt;&lt;font style="font-family: Arial;"&gt;2,083,282&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 74.7pt; border-top: 0.75pt solid #000000; border-left: 0.75pt solid #000000; border-bottom: 0.75pt solid #000000; padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top; -aw-border-bottom: 0.5pt single; -aw-border-left: 0.5pt single; -aw-border-top: 0.5pt single;"&gt;
