    <link:loc xlink:type="locator" xlink:href="#HHAF47E0C8D007896CDD2A7A8597F05869" xlink:label="HHAF47E0C8D007896CDD2A7A8597F05869" />
    <link:footnote xlink:type="resource" xlink:label="HHED3430FB3299D53A1D49F4ABFCC74492" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
