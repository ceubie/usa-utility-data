    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB827B2AB2D91B91330E7AA10A4A454D6" xlink:to="HH43F91A565FCBE8D38461DF2B66A3E0BE" order="1" />
