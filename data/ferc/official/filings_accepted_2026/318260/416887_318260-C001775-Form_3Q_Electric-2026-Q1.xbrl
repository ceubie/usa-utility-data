&lt;/td&gt;
&lt;td style="width: 1.16%; border-width: medium medium 1pt; border-style: none none solid; border-color: currentcolor currentcolor black; border-image: initial; padding: 0.7pt 0.7pt 0in 0in; line-height: 1; height: 64px;" valign="bottom" width="1%"&gt;
