&lt;div style="line-height: 1;" align="center"&gt;
&lt;table class="MsoNormalTable" style="width: 100%; border-collapse: collapse; border-image: initial; line-height: 1; border: medium none currentcolor;" border="1" width="100%" cellspacing="0" cellpadding="0"&gt;

