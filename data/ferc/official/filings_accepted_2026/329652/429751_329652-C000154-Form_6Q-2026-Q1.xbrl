  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-indent: 36pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;During the &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;three&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; months ended &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;March&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; 3&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;1&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, 202&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;6&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, pursuant to the Cash Management Agreement among Wood River Pipe Lines LLC (the "Company") and its affiliates&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;the Company effected a settlement of its receivable from&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;Buckeye Partners, L.P. in the amount of $&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;6&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;0&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; million&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, previously included in Receivable&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; from&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;Affiliated Companies, through a &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;reduction&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; of its &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Unappropriated Retained Earnings&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, effectively representing a non-cash &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;dis&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;tribution &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;to&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; Buckeye Partners, L.P.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
