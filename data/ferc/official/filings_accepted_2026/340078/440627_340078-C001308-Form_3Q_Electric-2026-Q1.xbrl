            </td>
            <td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/>
          </tr>
          <tr>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Misc. Service Revenue - Electric</span>
            </td>
            <td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">10,958,929&#160;</span>
            </td>
