  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH715BF7859520102182C3D4987E34D736" xlink:label="HH715BF7859520102182C3D4987E34D736" />
    <link:footnote xlink:type="resource" xlink:label="HH0597C348AC4F7E6FC96475418B8A09A8" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
This Balancing Authority has no load within its metered boundaries. Therefore, there is no Net Energy for Load to use as a point of reference to determine the available plant capacity at the hour of annual peak demand.</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH715BF7859520102182C3D4987E34D736" xlink:to="HH0597C348AC4F7E6FC96475418B8A09A8" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH68690170408E151216D0AF2599480968" xlink:label="HH68690170408E151216D0AF2599480968" />
    <link:footnote xlink:type="resource" xlink:label="HH131A7BA93FB44C73B1F1CE34F5A43D9F" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
This Balancing Authority has no load within its metered boundaries. Therefore, there is no Net Energy for Load to use as a point of reference to determine the integrated net load on plant at the hour of annual peak demand.</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH68690170408E151216D0AF2599480968" xlink:to="HH131A7BA93FB44C73B1F1CE34F5A43D9F" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7D7EBDB40D3591C428143F15627EBBE1" xlink:label="HH7D7EBDB40D3591C428143F15627EBBE1" />
    <link:footnote xlink:type="resource" xlink:label="HH1FB34C194D796C75EC849A40B7365B7B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
This Balancing Authority has no load within its metered boundaries. Therefore, there is no Net Energy for Load to use as a point of reference to determine the available plant capacity at the hour of annual peak demand.</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7D7EBDB40D3591C428143F15627EBBE1" xlink:to="HH1FB34C194D796C75EC849A40B7365B7B" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHDEA1AF3BA685145C1EC2AAF4536E2478" xlink:label="HHDEA1AF3BA685145C1EC2AAF4536E2478" />
    <link:footnote xlink:type="resource" xlink:label="HH5C57BD46B670E8485E57BAC135ECAEF2" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
This Balancing Authority has no load within its metered boundaries. Therefore, there is no Net Energy for Load to use as a point of reference to determine the integrated net load on plant at the hour of annual peak demand.</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHDEA1AF3BA685145C1EC2AAF4536E2478" xlink:to="HH5C57BD46B670E8485E57BAC135ECAEF2" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHD048EF4F0A088EFD19E93C2E6345269A" xlink:label="HHD048EF4F0A088EFD19E93C2E6345269A" />
    <link:footnote xlink:type="resource" xlink:label="HH1A97DE17826570DC89AA98400B1966A2" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
