      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-26" id="fn-26" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="text-align:justify">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:62.202%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:66.842%"/>
            <td style="width:0.1%"/>
            <td style="width:1.0%"/>
            <td style="width:5.359%"/>
            <td style="width:0.1%"/>
            <td style="width:1.0%"/>
            <td style="width:24.499%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="padding:2px 1pt;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:700;line-height:120%">Misc Service Revenue&#8208;Electric</span>
            </td>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
          </tr>
          <tr>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:120%">Open Access Revenue&#8208;DSM</span>
            </td>
            <td colspan="3" style="padding:0 1pt"/>
            <td style="padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:120%">$</span>
            </td>
            <td style="padding:2px 0;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:120%">4,857,886&#160;</span>
            </td>
            <td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/>
          </tr>
          <tr>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:120%">Open Access Revenue&#8208;Customer Charge</span>
            </td>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:120%">1,395,437&#160;</span>
