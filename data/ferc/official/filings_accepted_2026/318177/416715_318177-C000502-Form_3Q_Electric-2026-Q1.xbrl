&lt;p class="MsoNormal" style="text-align: center; page-break-after: avoid; margin: 3.75pt 0in 1.5pt 0in;" align="center"&gt;&lt;strong&gt;&lt;span style="font-size: 9pt; font-family: Calibri, sans-serif;"&gt;Three Months Ended March&amp;#160;31&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="mso-yfti-irow: 1; height: 12.0pt; mso-height-rule: exactly;"&gt;
&lt;td style="width: 372.0pt; border: none; border-bottom: solid black 1.0pt; padding: 0in 0in 0in 0in; height: 12.0pt; mso-height-rule: exactly;" valign="bottom" width="496"&gt;
&lt;p class="MsoNormal" style="page-break-after: avoid;"&gt;&lt;span style="font-family: Times_New_Roman, serif;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 3.75pt; padding: 0in 0in 0in 0in; height: 12.0pt; mso-height-rule: exactly;" valign="bottom" width="5"&gt;
