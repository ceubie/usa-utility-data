  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH08BAEE8356E451885665C23483F9CB41" xlink:label="HH08BAEE8356E451885665C23483F9CB41" />
    <link:footnote xlink:type="resource" xlink:label="HHFB354C78384F9E826EFC1809012CB05D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">
          <span style="color: #0070c0;">
            <span style="color: #000000;">During the three months ended June 30, 2026, the Company reclassified approximately $3.5 million of equity earnings from our investment in Little Missouri 4 LLC from Miscellaneous Income Charges (Account 660) to Miscellaneous Income (Account 640) for the three months ended March 31, 2026, to more appropriately reflect the nature of the activity in accordance with the Uniform System of Accounts. The reclassification has no effect on net income, unappropriated retained income, or cash flows.</span>
          </span>
        </p>
      </div>
    </link:footnote>
