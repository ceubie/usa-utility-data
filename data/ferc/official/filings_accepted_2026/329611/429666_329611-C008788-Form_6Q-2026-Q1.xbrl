  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="Tag1" contextRef="C1">&lt;div&gt;&lt;p&gt;&lt;font style="font-family: arial, helvetica, sans-serif; font-size: 16pt;"&gt;1. None&lt;/font&gt;&lt;/p&gt;
