  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:label="value1" xlink:href="#Tag164" />
    <link:loc xlink:type="locator" xlink:label="value3" xlink:href="#Tag169" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote1" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 16pt;">This balance relates to excess deferred income taxes created by the remeasurement of deferred income tax liabilities resulting from the reduction in U.S. federal tax rates from 35% to 21%, due to legislation referred to as the Tax Cuts and Jobs Act of 2017. This balance is currently expected to be amortized through approximately 2057.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value1" xlink:to="footnote1" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="1" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote3" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 16pt;">In accordance with a Letter Agreement dated April 28, 2022, SWG agreed to make a CIAC to the Company to cover the actual cost of construction of the Low Flow Meter Run at the Company Interconnect subject to the FERC approval of the proposed CIAC provisions to be included in the Company's tariff. These provisions were approved in association with the recently settled rate case, and a CIAC in the amount of $1,529,056, in addition to $183,487 of federal tax gross-up, was recorded in the Company's records and through its intercompany accounts in June 2024. As of the first quarter of 2026 accumulated amortization of CIAC totaled $12,233.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value3" xlink:to="footnote3" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="3" />
  </link:footnoteLink>
</xbrli:xbrl>
