    <link:footnote xlink:type="resource" xlink:label="HH936614A470327F6B9AC26793FBB6379B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>GPPL has no storage facilities, therefore account 117.4 is used to record OBA imbalances</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH9BC7D5A92B59A328BEC0774C740FDFF5" xlink:to="HH936614A470327F6B9AC26793FBB6379B" order="1" />
