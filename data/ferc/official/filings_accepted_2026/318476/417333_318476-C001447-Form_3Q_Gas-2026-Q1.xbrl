    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH64633A73430FB8EB4CDFF2364B2BE5C6" xlink:to="HH14945D39FEC58B05AD46CCAD2ADDBA3F" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH31A189B7DF4AEDCEB048932595325850" xlink:label="HH31A189B7DF4AEDCEB048932595325850" />
    <link:footnote xlink:type="resource" xlink:label="HH4CC8D5BA971F8099B645EE174C1E1A37" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Effective July 1, 2019, GPPL began amortizing the Regulatory Asset, created in accordance with the Commission's Order per Docket No. CP11-34, pursuant to the Order Approving Settlement issued June 14, 2019 under Docket No. RP19-1219-000. The Regulatory Asset will be amortized over a 50-year period commencing July 1, 2019.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH31A189B7DF4AEDCEB048932595325850" xlink:to="HH4CC8D5BA971F8099B645EE174C1E1A37" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE350134AB1A72A2E48EC01AB797FE1F3" xlink:label="HHE350134AB1A72A2E48EC01AB797FE1F3" />
    <link:footnote xlink:type="resource" xlink:label="HH49D04C8F231B3D7A879D1720EEDB5FF6" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Recorded pursuant to Section 16.5 of the General Terms and Conditions of our FERC Gas Tariff.</p>
      </div>
    </link:footnote>
