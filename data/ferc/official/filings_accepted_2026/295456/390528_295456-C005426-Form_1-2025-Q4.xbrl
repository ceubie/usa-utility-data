  <ferc:ControlOverRespondentTextBlock id="f-16" contextRef="c-1">&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;NextEra Energy Southwest. is a direct wholly owned subsidiary of NextEra Energy Transmission Southwest Holdings, LLC, which in turn is a wholly owned subsidiary of NextEra Energy Transmission, LLC (NEET). NEET is a wholly owned subsidiary of NextEra Energy Infrastructure, LLC, which in turn is a wholly owned subsidiary of NextEra Energy Capital Holdings, Inc. (NEECH), a wholly owned subsidiary of NextEra Energy, Inc. (NextEra Energy), a company listed on the New York Stock Exchange.&lt;br/&gt;&lt;/span&gt;</ferc:ControlOverRespondentTextBlock>
