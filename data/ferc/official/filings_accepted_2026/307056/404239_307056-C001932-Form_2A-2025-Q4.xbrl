t-weight:400;line-height:120%"&gt;12%&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%"&gt;4&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:700;line-height:120%"&gt;28%&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%"&gt;30%&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr style="height:15pt"&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%"&gt;*&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%"&gt;Related party customer&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr style="height:15pt"&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr style="height:15pt"&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Gas Plant: &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Additions to gas plant are recorded at cost, less accumulated depreciation. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Costs include material, labor, overhead, and for major capital additions, an allowance for funds used during construction (&#8220;AFUDC&#8221;). &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Repairs and maintenance costs are charged to expense and the costs of betterments are capitalized.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;AFUDC represents the estimated debt and equity costs of capital funds necessary to finance the construction of certain new regulated facilities and consists of two components, an equity component and an interest expense component. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The equity component is a non-cash item. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;After construction is completed, the Company is permitted to recover these costs through inclusion in the rate base and in the depreciation provision.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;AFUDC is capitalized as a component of gas plant costs, with offsetting credits to the statements of income through other income and deductions for the equity component and interest charges for the interest expense component.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Depreciation is computed using the straight-line method over the estimated useful lives of the assets, which range from 4 - 30 years.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;NOTE 2: SIGNIFICANT ACCOUNTING POLICIES (CONTINUED)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Income Taxes: &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The operations of the Company are included in the consolidated federal income tax return of Consolidated Edison, Inc., as well as consolidated or combined filings within several state jurisdictions. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The current income tax provision is recognized as an allocable portion of consolidated and combined tax provisions, based upon separate company taxable income and losses. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The deferred tax provision is recognized based upon changes in the separate company&#8217;s own deferred tax attributes. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Accounting for Uncertain Tax Positions: &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The Company is required to recognize the financial statement impact of a tax position when it is more likely than not that the position will not be sustained upon examination. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The Company recognizes interest accrued related to unrecognized tax benefits in interest expense and penalties in operating expenses. &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Net Income Per Share: &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Net income per share is determined by dividing net income by the weighted average number of common shares outstanding during the year.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Accounts Receivable and Allowance for Credit Losses: &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Accounts receivable is stated at the amount billed to the customer. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The Company does not assess finance charges for late payments. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The Company recognizes an estimate for an expected allowance for credit losses in accordance with &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt;FASB ASU 2016-13 Financial Instruments &#8211; Credit Losses ASC 326. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The estimate for credit losses is updated to reflect any changes in credit risk since the receivable was initially recorded.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Accounts receivables are evaluated individually when they do not share similar risk characteristics which could exist in circumstances where amounts are considered at risk or uncollectible.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The allowance estimate is derived from a review of the Company&#8217;s historical losses based on the aging of receivables. This estimate is adjusted for management&#8217;s assessment of current conditions, reasonable and supportable forecasts regarding future events, and any other factors deemed relevant by the Company. Management believes historical loss information is a reasonable starting point in which to calculate the expected allowance for credit losses.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;As accounts are considered by management to be fully collectible, no allowance for credit losses has been established for the years ended December 31, 2025 and 2024.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Asset Retirement Obligations: &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The Company incurs retirement obligations for certain assets at the time they are installed.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The fair values of these obligations are recorded as liabilities on a discounted basis.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The costs associated with these liabilities are capitalized as a part of the related assets and depreciated.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Over time, the liabilities are accreted for the change in their present value.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Other Gas Revenue: &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Other gas revenue results from compliance with FERC Order No. 581 accounting regulations. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Other gas revenue is recognized when the amount of gas collected by the Company from its Part 284 customers for compressor fuel and other gas operations exceeds the amount actually used by the Company. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The surplus gas is categorized either as cushion gas, stored underground or storage gas surplus, depending on regulated capacity limitations, at current market values per FERC regulations.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Marketing: &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The Company expenses marketing activities as incurred.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:700;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt; NOTE 3: GAS PLANT&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The gas plant consisted of the following as of December 31:&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Lato',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;