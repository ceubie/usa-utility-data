    <link:loc xlink:type="locator" xlink:href="#HH804E27F811FA12ABB210B316CDF7FC1C" xlink:label="HH804E27F811FA12ABB210B316CDF7FC1C" />
    <link:footnote xlink:type="resource" xlink:label="HH12A28C11D6A7C3977B4CEB9359D6AFB0" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Respondent(Sabal Trail Transmission) estimates no deferred income taxes reported in the beginning-of-year and end-of-year balances for Accumulated Deferred Taxes (Account 190) could be included in the development of
          <br />jurisdictional recourse rates. Furthermore, as stated in paragraph III G. 3 of Order No. 710, Docket No. RM07-9-00 as issued on March 21, 2008 by the Federal Energy Regulatory Commission, these estimates are not binding on the pipeline at such time as it may file a section 4 rate case.
          <br /></span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH804E27F811FA12ABB210B316CDF7FC1C" xlink:to="HH12A28C11D6A7C3977B4CEB9359D6AFB0" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHAE8F1A252E0AFBDB69F037FF67019687" xlink:label="HHAE8F1A252E0AFBDB69F037FF67019687" />
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAE8F1A252E0AFBDB69F037FF67019687" xlink:to="HH948ADB33EA0A5BB2A075123C1AC1B3C8" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0C3A2FD04307328532DD0B769DD5C856" xlink:label="HH0C3A2FD04307328532DD0B769DD5C856" />
    <link:footnote xlink:type="resource" xlink:label="HH356AB00C9B85D163F74F75D309A81B37" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Sabal Trail Transmission, LLC. estimates 100% of the deferred income taxes reported in the beginning-of-year and end-of-year balances for Accumulated Deferred Taxes-Other (Account 282) could be included in the development of jurisdictional recourse rates, with the exception that approximately $105,634,723 (end-of-year balance), which is attributable to certain recent accelerated depreciation, would be excluded. Furthermore, as stated in paragraph III G. 3 of Order No. 710, Docket No. RM07-9-000 as issued on March 21, 2008 by the Federal Energy Regulatory Commission, these estimates are not binding on the pipeline at such time as it may file a section 4 rate case.</span>
        </div>
      </div>
    </link:footnote>
