    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC8A373D2A24E12DFEF68F3352BF81142" xlink:to="HH9E4C17B07E3C225E809E68F0612155B8" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH9BC7D5A92B59A328BEC0774C740FDFF5" xlink:label="HH9BC7D5A92B59A328BEC0774C740FDFF5" />
    <link:footnote xlink:type="resource" xlink:label="HH3ED4DA3A60B4E396C6D5C9286E5C5C7B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All system balancing gas recorded under the fixed asset method as defined by FERC Order 581. Initial line pack is recorded in the plant account 117.1 (non-current). Any additional system gas volumes needed for load balancing, no notice transportation and other operational purposes is recorded in account 117.2 (current portion). For purposes of accounting for encroachment resulting from line inventory changes, we used Account 117.4 with appropriate debits to Account 808.1 and credits to Account 808.2.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH9BC7D5A92B59A328BEC0774C740FDFF5" xlink:to="HH3ED4DA3A60B4E396C6D5C9286E5C5C7B" order="1" />
