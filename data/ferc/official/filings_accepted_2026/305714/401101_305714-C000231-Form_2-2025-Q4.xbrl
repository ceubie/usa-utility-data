&lt;td style="width: 413.05pt; border-right: 1pt solid #000000; border-left: 1pt solid #000000; border-bottom: 1pt solid #000000; padding-right: 2.9pt; padding-left: 3.4pt; vertical-align: bottom;"&gt;
