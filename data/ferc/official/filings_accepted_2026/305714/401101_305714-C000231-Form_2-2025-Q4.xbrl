&lt;/td&gt;
&lt;td style="width: 155.1pt; border-right: 1pt solid #000000; border-bottom: 1pt solid #000000; padding-right: 3.4pt; padding-left: 4.65pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;1.0&lt;/font&gt;&lt;/p&gt;
