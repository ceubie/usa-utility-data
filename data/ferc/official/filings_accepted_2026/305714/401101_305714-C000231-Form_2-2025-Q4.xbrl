    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote3" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table class="MsoNormalTable" style="margin-left: -.25pt; border-collapse: collapse; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="0" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes;">
              <xhtml:td style="border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext 1.0pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom">
                <xhtml:p class="MsoNormal" style="line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; margin: 0in 3.75pt 0in 0in;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Allowance for other funds used during construction</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 29.5pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="39">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$</xhtml:span>
