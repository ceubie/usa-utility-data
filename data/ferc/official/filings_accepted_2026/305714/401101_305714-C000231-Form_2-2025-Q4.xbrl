    <link:footnoteArc xlink:type="arc" xlink:from="value22" xlink:to="footnote22" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="22" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote23" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level, rather than by discounted, negotiated or recourse rate contracts; therefore, the amounts reported have been allocated to discounted, negotiated or recourse rate contracts based on reasonable assumptions.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value23" xlink:to="footnote23" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="23" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote24" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">The value of this gas is based on the current month cash-out price provided for in our tariff. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value24" xlink:to="footnote24" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="24" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote25" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Shipper supplied gas and gas lost and unaccounted for are not directly charged to an account. As directed under FERC Order No. 581, we record "Other Regulatory Assets/Liabilities" (Accounts 182.3 / 254) through offsetting entries booked to "Regulatory Debits/Credits", (Accounts 407.3/.4) for any excess or deficiency in net shipper supplied gas (Line 37). This footnote applies to Lines 4 and 26 for all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value25" xlink:to="footnote25" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="25" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote27" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Default">
          <xhtml:span style="font-size: 18pt; color: windowtext; font-family: arial, helvetica, sans-serif;">Receipt point Natural Gas Pipeline Company of America LLC. Lease Pin 44405 NGPL Cameron.</xhtml:span>
        </xhtml:p>
        <xhtml:p class="Default">
          <xhtml:span style="font-size: 18pt; color: windowtext; font-family: arial, helvetica, sans-serif;">Delivery Point Natural Gas Company of America LLC. Lease PIN 44402 Transco SW Loop Cameron and 44411 Bridgeline Cameron.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value27" xlink:to="footnote27" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="27" />
