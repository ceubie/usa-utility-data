      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Default">
          <xhtml:span style="font-size: 18.0pt; color: windowtext;">Recorded pursuant to Docket No. AI93-5-000 issued April 23, 1993 (Accounting for Income Taxes).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value10" xlink:to="footnote10" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="10" />
