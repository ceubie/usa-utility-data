      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">We had no balance with Kinder Morgan, Inc. (KMI) under the cash management program as of December 31, 2025 and 2024. For further discussion of our participation in KMI's cash management program, see page 122.1 "Notes to Financial Statements," Note 5, "Related Party Transactions."</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value32" xlink:to="footnote32" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="32" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote33" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Default">
          <xhtml:span style="font-size: 18pt; color: windowtext; font-family: arial, helvetica, sans-serif;">In accordance with FERC Order No. 581, we use the fixed asset method.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value33" xlink:to="footnote33" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="33" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote34" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Default">
          <xhtml:span style="font-size: 18pt; color: windowtext; font-family: arial, helvetica, sans-serif;">See page 122.1, Notes to Financial Statements, Note 7 "Commitments" for additional information.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value34" xlink:to="footnote34" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="34" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote35" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">As of December 31, 2024, we estimate that the following deferred tax balance in Account 190 could be used in the development of jurisdictional recourse rates:</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
        </xhtml:p>
        <xhtml:table class="MsoTableGrid" style="width: 994px; border-collapse: collapse; border: none;" border="1" width="858" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; mso-yfti-lastrow: yes;">
              <xhtml:td style="width: 635.656px; border: 1pt solid windowtext; padding: 0in 5.4pt;" valign="top">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Regulatory Liability - Deferred Income Tax Rate Adjustment</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 13.3594px; border-top: 1pt solid windowtext; border-left: none; border-bottom: 1pt solid windowtext; border-right: none; padding: 0in 5.4pt;" valign="top">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 298.859px; border-top: 1pt solid windowtext; border-right: 1pt solid windowtext; border-bottom: 1pt solid windowtext; border-image: initial; border-left: none; padding: 0in 5.4pt;" valign="top">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal; mso-layout-grid-align: none; text-autospace: none;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">2,217,340</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
          </xhtml:tbody>
        </xhtml:table>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value35" xlink:to="footnote35" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="35" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote36" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Kinder Morgan, Inc. directly owns 38.06% of Kinder Morgan Energy Partners, L.P. and 100% of Kinder Morgan GP LLC and KM Energy, Inc.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value36" xlink:to="footnote36" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="36" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote37" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Amounts charged are based on Kinder Morgan, Inc.'s other compensation and benefit expenses and are allocated to us based on the distribution of direct labor charges (excluding overtime and special pay).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value37" xlink:to="footnote37" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="37" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote39" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 24px;">Use tax is distributed to various accounts based on the accounts charged for the originating invoice.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value39" xlink:to="footnote39" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="39" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote43" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="text-align: justify;">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">In Docket No. CP17-22-000, the FERC approved our proposal to reflect our existing reservation charge as the monthly reservation charge for the Sabine Pass Expansion Project, as well as our proposed incremental commodity charge. We consider the Sabine Pass Expansion Project to be a partially incremental project as a result.  Amounts in column (k) reflect only commodity revenues. All other amounts are not applicable to partially non-traditional rate treatment.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value43" xlink:to="footnote43" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="43" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote44" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="text-align: justify;">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">In Docket No. CP19-484-000, the FERC approved our proposal to reflect our existing reservation charge as the monthly reservation charge for the Sabine Pass Acadiana Expansion Project, as well as our proposed incremental commodity charge. We consider the Sabine Pass Acadiana Expansion Project to be a partially incremental project as a result.  Amounts in column (k) reflect only commodity revenues. All other amounts are not applicable to partially non-traditional rate treatment.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value44" xlink:to="footnote44" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="44" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote45" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">KM Energy LLC is a direct wholly-owned subsidiary of KM Energy Inc.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value45" xlink:to="footnote45" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="45" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote46" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Transferred to Retirement Work in Progress.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value46" xlink:to="footnote46" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="46" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote50" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 24px;">Transfer of general plant account 391 to intangible software plant account 303.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value50" xlink:to="footnote50" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="50" />
  </link:footnoteLink>
</xbrli:xbrl>
