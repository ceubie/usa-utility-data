              <td class="xl71" style="width: 39.7691%; text-align: center;" colspan="2" width="195">MWH</td>
            </tr>
            <tr style="height: 51.75pt;">
              <td style="height: 51.75pt; width: 60.175%;" height="69">&#160;</td>
              <td class="xl65" style="width: 17.7248%; text-align: center;" width="87">Total<br />Purchased Power</td>
              <td class="xl65" style="width: 22.0443%; text-align: center;" width="108">Total<br />Sales for Resale&#160;&#160;</td>
            </tr>
            <tr style="height: 17.25pt;">
              <td class="xl66" style="height: 17.25pt; width: 60.175%;" width="294" height="23">Reporting Difference</td>
              <td class="xl67" style="width: 17.7248%;" width="87">&#160;</td>
              <td class="xl67" style="width: 22.0443%;" width="108">&#160;</td>
            </tr>
            <tr style="height: 15.0pt;">
              <td style="height: 15pt; width: 60.175%;" height="20">FERC Form 1 Grand Total</td>
              <td class="xl68" style="text-align: right; width: 17.7248%;">&#160;&#160;&#160;&#160;&#160;&#160; 1,432,674</td>
              <td class="xl68" style="text-align: right; width: 22.0443%;">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 143,448</td>
            </tr>
            <tr style="height: 15.0pt;">
              <td style="height: 15pt; width: 60.175%;" height="20">MISO RTO Netting Adjustment</td>
              <td class="xl69" style="text-align: right; width: 17.7248%;">&#160;&#160;&#160;&#160;&#160;&#160;&#160; (140,254)</td>
              <td class="xl69" style="text-align: right; width: 22.0443%;">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; (140,254)</td>
            </tr>
            <tr style="height: 15.75pt;">
              <td style="height: 15.75pt; width: 60.175%;" height="21">WESR Grand Total</td>
