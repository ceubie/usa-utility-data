    <link:footnote xlink:type="resource" xlink:label="HH8EEB5E9D5B4B0342AFF8A938EB3C8012" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>310 L1i</p>
        <p>MISO RTO Netting of energy transactions is performed hourly. FERC requires that the RTO Netting of energy transactions be calculated separately for Day Ahead and Real Time markets.</p>
        <table style="border-collapse: collapse; width: 100%;" border="1" width="367pt" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="height: 15.75pt;">
              <td style="height: 15.75pt; width: 221pt;" width="294" height="21">&#160;</td>
              <td class="xl72" style="width: 146pt; text-align: center;" colspan="2" width="195">Dollars</td>
            </tr>
            <tr style="height: 51.75pt;">
              <td style="height: 51.75pt;" height="69">&#160;</td>
              <td class="xl65" style="width: 65pt; text-align: center;" width="87">Total<br />Purchased Power</td>
              <td class="xl65" style="width: 81pt; text-align: center;" width="108">Total<br />Sales for Resale&#160;</td>
            </tr>
            <tr style="height: 17.25pt;">
              <td class="xl66" style="height: 17.25pt; width: 221pt;" width="294" height="23">Reporting Difference</td>
              <td class="xl67" style="width: 65pt;" width="87">&#160;</td>
              <td class="xl67" style="width: 81pt;" width="108">&#160;</td>
            </tr>
            <tr style="height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">FERC Form 1 Grand Total</td>
              <td class="xl68" style="text-align: right;">&#160;$&#160; 51,410,371</td>
              <td class="xl69" style="text-align: right;">&#160;$ &#160;13,446,367</td>
            </tr>
            <tr style="height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">MISO RTO Netting Adjustment</td>
              <td class="xl70" style="text-align: right;">&#160;(6,315,033)</td>
              <td class="xl70" style="text-align: right;">&#160;(6,315,033)</td>
            </tr>
            <tr style="height: 15.75pt;">
              <td style="height: 15.75pt;" height="21">Grand Total</td>
              <td class="xl71" style="text-align: right;" align="right">$&#160; 45,095,338</td>
              <td class="xl71" style="text-align: right;" align="right">$&#160; &#160; 7,131,334</td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
