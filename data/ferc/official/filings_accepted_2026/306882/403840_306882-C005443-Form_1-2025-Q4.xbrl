&lt;td style="width: 3.75pt; vertical-align: bottom; background-color: #ffffff;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; page-break-after: avoid; font-size: 12pt;"&gt;&lt;span style="font-family: Times_New_Roman;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 79.5pt; padding-right: 0.75pt; vertical-align: bottom; background-color: #ffffff;"&gt;
&lt;p style="margin-top: 3.75pt; margin-bottom: 1.5pt; text-align: right; page-break-after: avoid; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri;"&gt;$&lt;/span&gt;&lt;span style="width: 58.29pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 62.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri;"&gt;7.3&lt;/span&gt;&lt;span style="width: 2.6pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 76.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
