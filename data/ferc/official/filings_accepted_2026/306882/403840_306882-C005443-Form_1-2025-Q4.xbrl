&lt;p style="margin-top: 3.75pt; margin-bottom: 1.5pt; text-align: right; page-break-after: avoid; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;$&lt;/span&gt;&lt;span style="width: 53.49pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 58.05pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;11.1&lt;/span&gt;&lt;span style="width: 2.71pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 76.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
