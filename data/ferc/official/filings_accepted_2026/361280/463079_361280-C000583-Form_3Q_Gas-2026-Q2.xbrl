            </td>
            <td style="border-bottom:3pt double #000;border-top:1pt solid #000000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">$</span>
            </td>
            <td style="border-bottom:3pt double #000;border-top:1pt solid #000000;padding:1.5pt 0;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">(41,930,050)</span>
            </td>
            <td style="border-bottom:3pt double #000;border-top:1pt solid #000000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/>
          </tr>
        </table>
      </div>
    </link:footnote>
