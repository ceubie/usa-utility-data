  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-1" contextRef="c-1">Joseph P. Finland</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:TitleOfOfficerWithCustodyOfCorporateBooks id="f-2" contextRef="c-1">Chief Accounting Officer</ferc:TitleOfOfficerWithCustodyOfCorporateBooks>
  <ferc:AddressWhereCorporateBooksAreKept id="f-3" contextRef="c-1">500 Woodward Ave, Suite 2900, Detroit, Michigan 48226</ferc:AddressWhereCorporateBooksAreKept>
  <ferc:IndicatorThatRespondentIsNotIncorporatedFlag id="f-4" contextRef="c-1">true</ferc:IndicatorThatRespondentIsNotIncorporatedFlag>
  <ferc:TypeOfOrganizationIfNotIncorporated id="f-5" contextRef="c-1">Guardian Pipeline, L.L.C. is a limited liability company, not a corporation, and was organized on 03/11/99 in Delaware.</ferc:TypeOfOrganizationIfNotIncorporated>
  <ferc:OrganizationDate id="f-6" contextRef="c-1">1999-03-10</ferc:OrganizationDate>
  <ferc:NameOfReceiverOrTrusteeHoldingPropertyOfTheRespondent id="f-7" contextRef="c-1">N/A</ferc:NameOfReceiverOrTrusteeHoldingPropertyOfTheRespondent>
  <ferc:AuthorityByWhichTheReceivershipOrTrusteeshipWasCreated id="f-8" contextRef="c-1">N/A</ferc:AuthorityByWhichTheReceivershipOrTrusteeshipWasCreated>
  <ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered id="f-9" contextRef="c-1">The respondent provides natural gas transportation services in Illinois and Wisconsin via a pipeline extending from Joliet, Illinois to a point near Green Bay, Wisconsin. Respondent provided both firm and interruptible transportation services and miscellaneous transportation services such as wheeling and park and loan services.</ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-10" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
