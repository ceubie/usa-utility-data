          <ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesDomain>The Company, along with Con Edison and its other subsidiaries, files a consolidated federal income tax return. The</ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesDomain>
        </xbrldi:typedMember>
      </xbrli:segment>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:startDate>2025-01-01</xbrli:startDate>
      <xbrli:endDate>2025-12-31</xbrli:endDate>
    </xbrli:period>
  </xbrli:context>
  <xbrli:context id="c-169">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.ferc.gov/CID">C000509</xbrli:identifier>
      <xbrli:segment>
        <xbrldi:typedMember dimension="ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesAxis">
          <ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesDomain>consolidated income tax liability is allocated to each member of the consolidated group using the separate return</ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesDomain>
        </xbrldi:typedMember>
      </xbrli:segment>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:startDate>2025-01-01</xbrli:startDate>
      <xbrli:endDate>2025-12-31</xbrli:endDate>
    </xbrli:period>
  </xbrli:context>
  <xbrli:context id="c-170">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.ferc.gov/CID">C000509</xbrli:identifier>
      <xbrli:segment>
        <xbrldi:typedMember dimension="ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesAxis">
          <ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesDomain>method. Each member pays or receives an amount based on its own taxable income or loss in accordance with a</ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesDomain>
        </xbrldi:typedMember>
      </xbrli:segment>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:startDate>2025-01-01</xbrli:startDate>
      <xbrli:endDate>2025-12-31</xbrli:endDate>
    </xbrli:period>
  </xbrli:context>
  <xbrli:context id="c-171">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.ferc.gov/CID">C000509</xbrli:identifier>
      <xbrli:segment>
        <xbrldi:typedMember dimension="ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesAxis">
          <ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesDomain>consolidated tax allocation agreement. Tax loss and tax credit carryforwards, as well as the corporate alternative</ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesDomain>
        </xbrldi:typedMember>
      </xbrli:segment>
    </xbrli:entity>
    <xbrli:period>
      <xbrli:startDate>2025-01-01</xbrli:startDate>
      <xbrli:endDate>2025-12-31</xbrli:endDate>
    </xbrli:period>
  </xbrli:context>
  <xbrli:context id="c-172">
    <xbrli:entity>
      <xbrli:identifier scheme="http://www.ferc.gov/CID">C000509</xbrli:identifier>
      <xbrli:segment>
        <xbrldi:typedMember dimension="ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesAxis">
          <ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesDomain>minimum tax (CAMT) liability, are allocated among members in accordance with consolidated tax return regulations.</ferc:ReconciliationOfNetIncomeWithTaxableIncomeForFederalIncomeTaxesDomain>
        </xbrldi:typedMember>
      </xbrli:segment>
    </xbrli:entity>
