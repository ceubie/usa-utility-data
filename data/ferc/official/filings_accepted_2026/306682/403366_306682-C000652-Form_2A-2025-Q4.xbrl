    <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
        <link:loc xlink:href="#f-794" xlink:label="f-794_lbl" xlink:type="locator" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-794_lbl" order="0" xlink:to="ft-794_43137_lbl" />
        <link:footnote xlink:label="ft-794_43137_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><span style="font-family: Roboto">Volumes which are subject to FERC's jurisdiction total 519,150 MMBtu. West Texas Gas (WTG) has only one customer which represents all the FERC jurisdictional sales for WTG. This customer is New Mexico Gas Company. The total deliveries of 43,549,391 MMBtu includes all deliveries for the entire company. Of this, 43,030,241 MMBtu are <b><span style="text-decoration: underline">not subject</span></b></span><span style="font-family: Roboto"> to Commission regulation. </span><br /></p></link:footnote>
    </link:footnoteLink>
</xbrl>