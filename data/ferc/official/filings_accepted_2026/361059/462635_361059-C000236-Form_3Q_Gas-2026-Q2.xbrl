          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Recorded pursuant to Docket No. AI93-5-000 issued on April 23, 1993 (Accounting for Income Taxes).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value3" xlink:to="footnote3" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="3" />
  </link:footnoteLink>
</xbrli:xbrl>
