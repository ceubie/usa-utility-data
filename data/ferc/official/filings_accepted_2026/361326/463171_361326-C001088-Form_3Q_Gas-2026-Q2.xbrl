    <link:footnote xlink:type="resource" xlink:label="fn-7" id="fn-7" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Inventory in account 117.1 represents the balance of recoverable gas volumes that are necessary to maintain pressure and deliverability requirements for MountainWest Pipeline&#8217;s storage facilities. Recoverable base gas is reported under the inventory method.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-8" id="fn-8" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Inventory in account 117.2 represents the balance of system balancing gas volumes for load balancing, no notice transportation, and other operational purposes. System balancing gas is reported under the inventory method.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-9" id="fn-9" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Inventory in account 117.4 represents</span>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"></span>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">volumes owed to the system and volumes lent to the system in a park and loan agreement, reported at market (estimated replacement) value.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-10" id="fn-10" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Inventory in account 164.1 represents the balance of pipeline owned gas which the pipeline intends to sell. Pipeline owned gas is reported under the inventory method.</span>
      </div>
    </link:footnote>
