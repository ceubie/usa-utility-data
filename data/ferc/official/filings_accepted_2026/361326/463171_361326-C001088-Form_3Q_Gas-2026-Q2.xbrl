    <link:footnote xlink:type="resource" xlink:label="fn-61" id="fn-61" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Max deliverability for Chalk Creek assumes a BTU conversion of 1,044 BTU/SCF and a max rate of 35 MMscfd.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-62" id="fn-62" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Max deliverability for Coalville assumes a BTU conversion of 1,024 BTU/SCF and a max rate of 65 MMscfd.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-63" id="fn-63" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Max deliverability for Leroy assumes a BTU conversion of 1,026 BTU/SCF and a max rate of 75 MMscfd.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-64" id="fn-64" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Max deliverability for Clay Basin assumes a BTU conversion of 1,065 BTU/SCF and a max rate of 765 MMscfd as limited by dehydration units.</span>
      </div>
    </link:footnote>
