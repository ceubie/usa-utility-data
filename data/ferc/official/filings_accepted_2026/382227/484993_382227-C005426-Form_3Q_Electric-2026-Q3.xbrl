  <ferc:ReportYear id="f-125" contextRef="c-1" decimals="0" unitRef="u-1">2026</ferc:ReportYear>
  <ferc:DisclosureOfInterimDisclosureTextBlock id="f-126" contextRef="c-1">&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;5. &#160;&#160;&#160;&#160;COMMITMENTS AND CONTINGENCIES&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The Company had purchase obligations related to construction contract commitments of $22.6 million for the purchase of materials, services, and equipment that had not yet been received or paid for as of September 30, 2026. The Company expects to pay for the majority of the construction contract commitments through 2026.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfInterimDisclosureTextBlock>
  <ferc:DisclosureOfSubsequentEventsTextBlock id="f-127" contextRef="c-1">&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;6. &#160;&#160;&#160;&#160;RELATED PARTY TRANSACTIONS&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;NextEra Energy Transmission, LLC ("NEET"), NextEra Energy Resources, LLC ("NEER"), and Florida Power &amp;amp; Light Company ("FPL"), subsidiaries of NextEra Energy, Inc. ("NextEra Energy"), and NextEra Energy provide general support services to the Company. These services are invoiced to the Company on a monthly basis. Amounts payable for these costs are included in accounts payable to associated companies. Amounts receivable from related parties are included in accounts receivable from associated companies.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfSubsequentEventsTextBlock>
  <ferc:DisclosureOfApplicableNotesTextBlock id="f-128" contextRef="c-1">&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;7.&#160;&#160;&#160;&#160;SUBSEQUENT EVENTS&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The Company's management has evaluated the recognition and disclosure of subsequent events for its September 30, 2026 financial statements through November&#160;4, 2026.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfApplicableNotesTextBlock>
