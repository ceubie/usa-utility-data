&lt;td class="xl97" style="width: 115.088px; border-bottom: 2.8pt double #000000; border-top: 1pt solid #000000;"&gt;&amp;#160; $&amp;#160; &amp;#160; &amp;#160;4,303,957&amp;#160;&lt;/td&gt;
