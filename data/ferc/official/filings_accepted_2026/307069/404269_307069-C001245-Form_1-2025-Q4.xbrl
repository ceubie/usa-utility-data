&lt;td class="xl92" style="width: 115.1px; text-align: center;"&gt;&lt;strong&gt;2025&lt;/strong&gt;&lt;/td&gt;
&lt;td class="xl92" style="width: 115.088px; text-align: center;"&gt;&lt;strong&gt;2024&lt;/strong&gt;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="mso-height-source: userset; height: 12.95pt;"&gt;
&lt;td style="height: 12.95pt; width: 375.612px;" height="17"&gt;&amp;#160;&lt;/td&gt;
&lt;td style="width: 115.1px;"&gt;&amp;#160;&lt;/td&gt;
&lt;td style="width: 115.088px;"&gt;&amp;#160;&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="mso-height-source: userset; height: 12.95pt;"&gt;
&lt;td style="height: 12.95pt; width: 375.612px;" height="17"&gt;Federal income tax expense at federal statutory rate&lt;/td&gt;
&lt;td class="xl94" style="width: 115.1px;"&gt;&amp;#160; $&amp;#160; &amp;#160;(4,738,431)&lt;/td&gt;
&lt;td class="xl94" style="width: 115.088px;"&gt;&amp;#160; $&amp;#160; &amp;#160; &amp;#160;7,881,252&amp;#160;&lt;/td&gt;
