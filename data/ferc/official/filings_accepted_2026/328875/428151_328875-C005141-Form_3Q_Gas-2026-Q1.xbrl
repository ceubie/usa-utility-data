      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Lease fuel 217,614</p>
        <p>M&amp;R fuel 4,766</p>
        <p>O&amp;M gas loss 1,402&#160; &#160; &#160;&#160;</p>
        <p>Total 223,782</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH619F68CC642ADE5177C1660EF32AC89A" xlink:to="HHE2C227320AA2892E909E930B2AB99438" order="1" />
