  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH0ACEA97864FC5C0598CC1AD0832E60F6" xlink:label="HH0ACEA97864FC5C0598CC1AD0832E60F6" />
    <link:footnote xlink:type="resource" xlink:label="HHE40C3F6470244832CEBF8998D3E5EF25" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All system balancing gas recorded under the fixed asset method as defined by FERC Order 581. Initial line pack is recorded in the plant account 117.1 (non-current). Any additional system gas volumes needed for load balancing, no notice transportation and other operational purposes is recorded in account 117.2 (current portion). For purposes of accounting for encroachment resulting from line inventory changes, we used Account 117.4 with appropriate debits to Account 808.1 and credits to Account 808.2.</span>
        </p>
      </div>
    </link:footnote>
