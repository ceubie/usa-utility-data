  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;span style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;"&gt;Sabal Trail Transmission, LLC has a Management Committee:&lt;/span&gt;&lt;br style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;" /&gt;&lt;br style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;" /&gt;&lt;span style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;"&gt;Removal, effective 01/29/2926&lt;/span&gt;&lt;br style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;" /&gt;&lt;span style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;"&gt;Wolfe, Jeffrey J., Representative, SEPSTT&lt;/span&gt;&lt;br style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;" /&gt;&lt;br style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;" /&gt;&lt;span style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;"&gt;Appointment, effective 01/29/2026&lt;/span&gt;&lt;br style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;" /&gt;&lt;span style="font-family: 'MS Reference Sans Serif', sans-serif; font-size: 14.6667px;"&gt;Knight-Turcan, Kurt, Representative, SEPSTT&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
