                <p class="MsoNormal" style="text-align: center;" align="center">
                  <strong>
                    <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif;">2025</span>
                  </strong>
                </p>
              </td>
              <td style="width: .75in; border: none; border-bottom: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: 13.1pt; mso-height-rule: exactly;" valign="top" width="72">
                <p class="MsoNormal" style="text-align: center;" align="center">
                  <strong>
                    <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif;">2024</span>
                  </strong>
                </p>
              </td>
            </tr>
            <tr style="mso-yfti-irow: 1; height: 4.5pt; mso-height-rule: exactly;">
              <td style="width: 306.9pt; padding: 0in 5.4pt 0in 5.4pt; height: 4.5pt; mso-height-rule: exactly;" valign="top" width="409">
                <p class="MsoNormal">
                  <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif;">&#160;</span>
                </p>
              </td>
              <td style="width: 13.5pt; padding: 0in 5.4pt 0in 5.4pt; height: 4.5pt; mso-height-rule: exactly;" valign="top" width="18">
                <p class="MsoNormal">
                  <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif; background: yellow; mso-highlight: yellow;">&#160;</span>
                </p>
              </td>
              <td style="width: .75in; border: none; mso-border-top-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: 4.5pt; mso-height-rule: exactly;" valign="top" width="72">
                <p class="MsoNormal" style="text-align: right;" align="right">
                  <strong>
                    <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif; background: yellow; mso-highlight: yellow;">&#160;</span>
                  </strong>
                </p>
              </td>
              <td style="width: .75in; border: none; mso-border-top-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: 4.5pt; mso-height-rule: exactly;" valign="top" width="72">
                <p class="MsoNormal" style="text-align: right;" align="right">
                  <strong>
                    <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif; background: yellow; mso-highlight: yellow;">&#160;</span>
                  </strong>
                </p>
              </td>
            </tr>
            <tr style="mso-yfti-irow: 2; height: .2in; mso-height-rule: exactly;">
              <td style="width: 306.9pt; padding: 0in 5.4pt 0in 5.4pt; height: .2in; mso-height-rule: exactly;" valign="top" width="409">
                <p class="MsoNormal">
                  <strong>
                    <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif;">Total Balance at Beginning of Year</span>
                  </strong>
                </p>
              </td>
              <td style="width: 13.5pt; padding: 0in 5.4pt 0in 5.4pt; height: .2in; mso-height-rule: exactly;" valign="top" width="18">
                <p class="MsoNormal">
                  <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif; background: yellow; mso-highlight: yellow;">&#160;</span>
                </p>
              </td>
              <td style="width: .75in; padding: 0in 5.4pt 0in 5.4pt; height: .2in; mso-height-rule: exactly;" valign="top" width="72">
                <p class="MsoNormal">
                  <strong>
                    <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif;">$&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 0.3</span>
                  </strong>
                </p>
              </td>
              <td style="width: .75in; padding: 0in 5.4pt 0in 5.4pt; height: .2in; mso-height-rule: exactly;" valign="top" width="72">
                <p class="MsoNormal">
                  <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">$&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 0.3</span>
                </p>
              </td>
            </tr>
            <tr style="mso-yfti-irow: 3; height: .05in; mso-height-rule: exactly;">
              <td style="width: 306.9pt; padding: 0in 5.4pt 0in 5.4pt; height: .05in; mso-height-rule: exactly;" valign="top" width="409">
                <p class="MsoNormal">
