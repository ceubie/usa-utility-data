            <tr style="mso-yfti-irow: 11; mso-yfti-lastrow: yes; height: .2in; mso-height-rule: exactly;">
              <td style="width: 300.45pt; padding: 0in 5.4pt 0in 5.4pt; height: .2in; mso-height-rule: exactly;" valign="top" width="401">
                <p class="MsoNormal">
                  <strong>
                    <span style="font-size: 9.0pt; font-family: 'Arial',sans-serif; layout-grid-mode: line;">Amount of Lease Obligations Recorded on Balance Sheets</span>
