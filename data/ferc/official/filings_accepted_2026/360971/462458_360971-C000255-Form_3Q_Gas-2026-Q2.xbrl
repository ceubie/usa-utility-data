  DrawAspect="Content" ObjectID="_1848471889"&gt;
 &lt;/o:OLEObject&gt;
&lt;/xml&gt;&lt;![endif]--&gt;&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;#160;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-align: justify; tab-stops: list -9.0pt left 0in 13.5pt 22.5pt;"&gt;&lt;span style="font-size: 10.0pt; font-family: 'Arial',sans-serif;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
