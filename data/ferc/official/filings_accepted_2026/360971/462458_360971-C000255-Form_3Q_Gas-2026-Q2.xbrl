  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH6D09B49321ED2F9175728B9D8D482ABE" xlink:label="HH6D09B49321ED2F9175728B9D8D482ABE" />
    <link:footnote xlink:type="resource" xlink:label="HHC6B47F68D21763B60D94122471A9EE7A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto;">
          <span style="font-size: 12pt;">
            <strong style="font-weight: bold;">
              <span style="font-family: Arial, Helvetica, sans-serif;">Schedule Page: </span>
              <span style="font-family: Arial, Helvetica, sans-serif;">118 Line No.: 1 Column: c</span>
            </strong>
          </span>
        </p>
        <p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Florida Gas Transmission </span>
            <span style="font-family: Arial, Helvetica, sans-serif;">Company, LLC, as a limited liability company, records member's equity in Other Paid-In Capital.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6D09B49321ED2F9175728B9D8D482ABE" xlink:to="HHC6B47F68D21763B60D94122471A9EE7A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH748D1EF178E8211A6195210D031E42A2" xlink:label="HH748D1EF178E8211A6195210D031E42A2" />
    <link:footnote xlink:type="resource" xlink:label="HH40A15219FC6AF4834D2854DA7B114285" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <strong>Schedule Page: 278 Line No.: 1 Column: a</strong>
          </span>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">Pursuant to Section 24 of the General Terms and Conditions of Florida Gas' FERC Gas Tariff, Fifth Revised Volume No. 1, Docket No. RP26-323-000.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH748D1EF178E8211A6195210D031E42A2" xlink:to="HH40A15219FC6AF4834D2854DA7B114285" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH191B23318676368C54D6A3EC779F00C8" xlink:label="HH191B23318676368C54D6A3EC779F00C8" />
    <link:footnote xlink:type="resource" xlink:label="HHB061BB6D9CC3A4FFEEDF2E6B94C576B5" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div style="color: #000000; font-family: sans-serif; font-size: medium;">
          <p>
            <span style="font-size: 12pt;">
              <span style="text-decoration: inherit;">
                <strong>Schedule Page: 278 Line No.: 2 Column: a</strong>
              </span>
            </span>
          </p>
        </div>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">Pursuant to Article VII, Section 7 of Stipulation and Agreement of Settlement, Docket No. RP21-441-000, et al. as approved by FERC's order issued on June 3, 2022.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH191B23318676368C54D6A3EC779F00C8" xlink:to="HHB061BB6D9CC3A4FFEEDF2E6B94C576B5" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7CD7E4B4A025F4265203ACE921DA0FF0" xlink:label="HH7CD7E4B4A025F4265203ACE921DA0FF0" />
    <link:footnote xlink:type="resource" xlink:label="HH3A316E799428B6E0B77194EEBACEC8A8" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-weight: bold; color: #000000; font-family: sans-serif; font-size: 16px;">Schedule Page: 278 Line No.: 3 Column: a</span>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">In December 2017, the "Tax Cuts and Jobs Act" was signed into law. Among other provisions, the highest corporate federal income tax rate was reduced from 35% to 21% for taxable years beginning after December 31, 2017. Under regulatory accounting, the effect on deferred tax assets and liabilities of a change in tax rate is recognized as a regulatory asset or regulatory liability in the period that includes the enactment date. Docket No. PL19-2-000 dated November 15, 2018.</span>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Pursuant to Article VII, Section 2 of Stipulation and Agreement of Settlement, Docket No. RP21-441-000, et al. as approved by FERC's order issued <span style="text-decoration: inherit;">on June 3, 2022, Florida Gas adjusted regulatory liability at June 30, 2021, which resulted in an adjustment to its deferred income tax liability. </span><span style="text-decoration: inherit;">The amortization period is 38 years for Florida Gas Incremental FTS-3. The amortization period is 20 years for Florida Gas (excluding FTS-3).</span></span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7CD7E4B4A025F4265203ACE921DA0FF0" xlink:to="HH3A316E799428B6E0B77194EEBACEC8A8" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH4A92748659CDFD5BE95F057026540AEF" xlink:label="HH4A92748659CDFD5BE95F057026540AEF" />
    <link:footnote xlink:type="resource" xlink:label="HH910AB6BA0A7B99A2ADB46A3685425F51" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <strong>
            <span style="font-size: 12pt;">Schedule Page: 278 Line No.: 4 Column: a</span>
          </strong>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Pursuant to Section 24.A.4 of the General Terms and Conditions of Florida Gas' FERC Gas Tariff, Fifth Revised Volume No. 1, Docket No. RP26-323-000.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH4A92748659CDFD5BE95F057026540AEF" xlink:to="HH910AB6BA0A7B99A2ADB46A3685425F51" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH68CF5903C651A80D777FDC84ED13EF3D" xlink:label="HH68CF5903C651A80D777FDC84ED13EF3D" />
    <link:footnote xlink:type="resource" xlink:label="HH283E5B07A7A5C4D5DEE8A0223BE4DF85" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt; font-family: sans-serif; font-weight: bold;">Schedule Page: 278 Line No.: 5 Column: a</span>
            </span>
          </span>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Pursuant to Section 27.E of the General Terms and Conditions of Florida Gas' FERC Gas Tariff, Fifth Revised Volume No. 1, Docket No. RP26-597-000, as approved by FERC's order issued on March 18, 2026.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH68CF5903C651A80D777FDC84ED13EF3D" xlink:to="HH283E5B07A7A5C4D5DEE8A0223BE4DF85" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF87E71DFF0E4EF767802707D2DCF2B83" xlink:label="HHF87E71DFF0E4EF767802707D2DCF2B83" />
    <link:footnote xlink:type="resource" xlink:label="HH9F75D6866460B11CE307F542133DC797" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <img title="P520 FN screenshot.gif" src="data:image/gif;base64," alt="" width="457" height="159" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF87E71DFF0E4EF767802707D2DCF2B83" xlink:to="HH9F75D6866460B11CE307F542133DC797" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:label="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" />
    <link:footnote xlink:type="resource" xlink:label="HHFD96FDA8896EBF747C2814B32AC253A4" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <strong style="font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Schedule Page: 521 Line No.: 7 Column: e</strong>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">The allocation is derived from the throughput volume of each contract within the billing system. A path to path calculation of the rate utilized within the contract billing is determined and a percentage for recourse rate, discount rate and negotiated rate is derived based on the rate charged within the paths.</span>
          </span>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:to="HHFD96FDA8896EBF747C2814B32AC253A4" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE42A88354FE811940E49AF98CC4875FD" xlink:label="HHE42A88354FE811940E49AF98CC4875FD" />
    <link:footnote xlink:type="resource" xlink:label="HHB7216101BA089BD4954583C9EF633157" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <strong style="font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Schedule Page: 521 Line No.: 7 Column: f</strong>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-family: Arial, Helvetica, sans-serif; font-size: 16px;">The basis for valuing the gas reported in columns (f), (g) and (h) is based on the daily mid-point spot prices in Zones 1, 2 and 3 of Gas Daily as provided in the tariff.</span>
        </p>
      </div>
    </link:footnote>
