  <ferc:OtherRegulatoryAssets id="HHA5EE379F90C08B5730F4106628673B66" contextRef="HH49BCDEC94830C539EAD208FD3E54E424" decimals="0" unitRef="HHferc_us_Currency">32468603</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HH7186D3ED5AA22A2D749C11D340F31255" contextRef="HHA517475FDB4FD0059BC88A4206B196CE" decimals="0" unitRef="HHferc_us_Currency">729819</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryAssets id="HHE21ED7EF85521D8C98A22B6A98BD911B" contextRef="HH75D36256B87E34B51B2E8D4168F6BE84" decimals="0" unitRef="HHferc_us_Currency">1674875</ferc:OtherRegulatoryAssets>
  <ferc:OtherRegulatoryLiabilities id="HHF07419AFD3CD73061A8889C463BFDABB" contextRef="HH77641ED9278B7B26FE7EDABEC29125BE" decimals="0" unitRef="HHferc_us_Currency">33161985</ferc:OtherRegulatoryLiabilities>
  <ferc:OtherRegulatoryLiabilities id="HH3E541933135F51A3B065DCC7C1A0590D" contextRef="HH1941E5D2665213A498B6678469B22898" decimals="0" unitRef="HHferc_us_Currency">48171019</ferc:OtherRegulatoryLiabilities>
