			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; text-indent:-18pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;1)&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; text-indent:-18pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;2)&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; text-indent:-18pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;3)&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; text-indent:-18pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;4)&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; text-indent:-18pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;5)&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;N/A&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;The Company&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Sorrento Pipeline Company, LLC (&amp;#x201C;Sorrento&amp;#x201D;) is a Texas limited liability corporation and a consolidated subsidiary of Enterprise Products Partners L.P., a Delaware partnership, through the 100% interest held by Enterprise Products Operating LLC (&amp;#x201C;EPOLLC&amp;#x201D;), a Texas limited liability company. EPOLLC is the operator of Sorrento.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Description of the Property&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Sorrento is a natural gas liquids pipeline system that is approximately 660 miles in length and located entirely within the State of Louisiana. The pipeline extends from the Sorrento Hub in Ascension Parish north to Grangeville in St. Helena Parish, east to the Norco NGL Fractionator in St. Charles Parish, west to Lake Charles and northwest to the interconnect with Dixie Pipeline.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Regulation&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Sorrento is subject to regulation by various federal and state authorities, including the Federal Energy Regulatory Commission (FERC). The State of Louisiana considers all liquids lines located in the state to be common carrier lines, resulting in all of Sorrento's pipelines being so classified.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Basis of Accounting&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Financial statements are prepared on &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;the accrual&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; basis of accounting. The accounting policies followed in preparation of these financial statements conform to those required by FERC. Property, plant and equipment assets are recorded at original cost.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Revenue Recognition&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Sorrento's common carrier revenues are primarily derived from transportation of natural gas liquids regulated by the FERC or the Louisiana Public Service Commission. Revenues are recognized upon delivery of product to customers.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Income Taxes&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Sorrento is a limited liability company that passes income tax liability through the company to EPOLLC and does not record tax liability or expenses on its financial statements. For the purposes of calculating income tax expense and liability for the annual cost of service (shown on page 700 of the Annual Report) Sorrento employs FERC's Policy Statement on Income Tax Allowances.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Employees&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Sorrento has no employees of its own. All operations, management and administrative functions are performed by employees of Enterprise Products Company on behalf of EPOLLC, as operator.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Sorrento reimburses EPOLLC for management and administrative functions under the terms of an operating agreement.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
