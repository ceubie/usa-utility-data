  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH38CDC632689E97053821709991A84A6D" xlink:label="HH38CDC632689E97053821709991A84A6D" />
    <link:footnote xlink:type="resource" xlink:label="HH8DCA497EDE2E2AF073D369C8F30D852D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto;">
            <span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important;">
              <span style="font-size: 12pt;">
                <strong style="font-weight: bold;">Schedule Page: 278 Line No.: 1 Column: a</strong>
              </span>
            </span>
          </p>
          <p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto;">
            <span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important;">Pursuant to Section 9 of the General Terms and Conditions ("GT&amp;C") of Gulf Run's FERC Gas Tariff, Original Volume No. 1, Docket No. RP26-123-000 filed with FERC on October 25, 2025, Gulf Run </span>
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt;">is required to credit to eligible firm </span>
            </span>
            <span style="font-size: 12pt; font-family: Arial, Helvetica, sans-serif; background-color: unset; text-align: inherit;">customers penalty revenues collected during the Penalty Base Period. The annual base period runs August 1 through July 31. Under the </span>
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt;">terms of Section 9.6 of the GT&amp;C, Gulf Run is not required to calculate revenue credits until the total penalty crediting revenues exceed </span>
            </span>
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt;">$250,000.</span>
            </span>
          </p>
          <p>
            <span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important;">&#160;</span>
          </p>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH38CDC632689E97053821709991A84A6D" xlink:to="HH8DCA497EDE2E2AF073D369C8F30D852D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0F125AE2B5CDF7BA9C50D7DA84BEC797" xlink:label="HH0F125AE2B5CDF7BA9C50D7DA84BEC797" />
    <link:footnote xlink:type="resource" xlink:label="HHB805A0E24B7EFA2674C93CE44115F3D8" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #333333; font-family: Roboto;">
          <span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">
            <span style="font-size: 12pt;">
              <strong>Schedule Page: 278 Line No.: 2 Column: a</strong>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #333333; font-family: Roboto;">
          <span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">Pursuant to Section 22.3 of the General Terms and Conditions of Gulf Run's FERC Gas Tariff, Original Volume No. 1, Docket No. RP25-875-000, as approved by FERC's order issued on May 14, 2025 and Docket No. RP26-817-000, as approved by FERC's order issued on May 26, 2026.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0F125AE2B5CDF7BA9C50D7DA84BEC797" xlink:to="HHB805A0E24B7EFA2674C93CE44115F3D8" order="1" />
