    <link:footnote xlink:type="resource" xlink:label="HH3DF7D2834B425222E5B8A960E9C67C17" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-weight: bold;">Schedule Page: 521 Line No.: 7 Column: f</span>
            </span>
          </span>
        </p>
        <p style="margin: 0px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">The basis for valuing the gas reported in columns (f), (g) and (h) is the weighted average rate for system gas.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE42A88354FE811940E49AF98CC4875FD" xlink:to="HH3DF7D2834B425222E5B8A960E9C67C17" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH13A6EC4FBA0B316EB0C6AAA04F16829C" xlink:label="HH13A6EC4FBA0B316EB0C6AAA04F16829C" />
    <link:footnote xlink:type="resource" xlink:label="HH1EAB74C4640C71F8B1B006DEEABA5196" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-weight: bold;">Schedule Page: 521 Line No.: 7 Column: i</span>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <em style="color: #333333; font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: bold;">
            <span style="font-size: 12pt; font-style: normal; font-weight: 400;">Gulf Run does not recognize revenues for shipper-supplied fuel and values only the net excess or deficiency volume as reported on line 37. The dollars reported for lines 1-30 on this page are allocated to these categories using current average market prices.</span>
          </em>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH13A6EC4FBA0B316EB0C6AAA04F16829C" xlink:to="HH1EAB74C4640C71F8B1B006DEEABA5196" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF954BDD3127828E1BCA0358719386A04" xlink:label="HHF954BDD3127828E1BCA0358719386A04" />
    <link:footnote xlink:type="resource" xlink:label="HH7783163D7B1B2524FDDABF3737D74710" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-weight: bold;">Schedule Page: 521 Line No.: 22 Column: i</span>
            </span>
          </span>
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <br />
            </span>
          </span>
        </p>
        <p style="margin: 0px; color: #000000; font-family: Roboto;">
          <span style="color: #333333; font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">Gas used for other operational purposes includes blow-downs and other operational uses of gas other than compressor station fuel, and in-kind volumes of gas delivered to other pipelines in accordance with applicable transportation contracts.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF954BDD3127828E1BCA0358719386A04" xlink:to="HH7783163D7B1B2524FDDABF3737D74710" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH3EB1612345BAC43EAE83A77596A18B2E" xlink:label="HH3EB1612345BAC43EAE83A77596A18B2E" />
    <link:footnote xlink:type="resource" xlink:label="HH8C758C2B64234E8AE87B0F98E6CE515B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-weight: bold;">Schedule Page: 521 Lines No.: 51 and 65 Column: i</span>
            </span>
          </span>
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <br />
            </span>
          </span>
        </p>
        <p style="margin: 0px; color: #000000; font-family: Roboto;">
          <em style="color: #333333; font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: bold;">
            <span style="font-size: 12pt; font-style: normal; font-weight: 400;">Cumulative volumes of in-kind gas owed to or due from shippers are revalued to market price each month. The dollars reported reflects the net valuation for the current month volumes and excludes the revaluation adjustment.</span>
          </em>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH3EB1612345BAC43EAE83A77596A18B2E" xlink:to="HH8C758C2B64234E8AE87B0F98E6CE515B" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>