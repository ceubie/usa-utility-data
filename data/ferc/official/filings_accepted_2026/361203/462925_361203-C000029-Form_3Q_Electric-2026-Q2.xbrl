  <ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock id="HHD2B1DFDF71C7477E84AEA1D4D780024C" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;NA&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock>
  <ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock id="HH9BC0EFBCB25FD35BD21CC5095A000F66" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;NA&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock>
  <ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock id="HHB507706EE223692FB3CE9DE4D62FC621" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;NA&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock>
  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="HH1C967D5CB7055C23C61684D3A8ADDA65" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;NA&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
  <ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock id="HH3753C2D0F64441EEC1CB77241E2239DC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;NA&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock>
  <ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock id="HH2FB9527C1D4BB25D79F1C0C76F5BC95D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;span style="font-size: 12.6px;"&gt;On February 10, 2026 ISO New England Inc. (ISO-NE) filed an application pursuant to Section 204 of the Federal Power Act requesting authorization of up to $60,000,000 in principal amount of senior obligations to be issued either in connection with a loan from the Massachusetts Development Authority (the "Authority") to be funded with the proceeds of a tax-exempt bond to be issued by the Authority or in the event that such tax-exempt bond financing is not available, through a private placement transaction. This request was approved by the Commission on March 20, 2026 under Docket No. ES26-30-000 and was effective as of March 31, 2026 through March 30, 2028. The purpose of this request is to fund the acquisition and expansion of ISO New England Inc.'s facilities and payment of related expenses. On April 30, 2026 ISO New England Inc. closed on the Authority financing with interest cap rate of 6.25% and floor rate of 3.619% equal to the product of 0.86 times the sum of Term SOFR plus 1.25%.&amp;#160; The bond mature on April 30, 2051.&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock>
  <ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock id="HHDB4E63D65FD21AE5462A8FBA840EA717" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;NA&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock>
  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="HHEBA1CD44839C108D1DAFD6DE3427BE45" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;NA&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock>
  <ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock id="HH22FBAEA0509E80B804A4341B1670898A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;span style="font-size: 12.6px;"&gt;The Company is involved in various claims and legal proceedings of a nature considered normal to its business. The claims are in various stages and some may ultimately be brought to trial.&amp;#160; While it is not feasible to predict or determine the outcome of any of these claims, it is the opinion of management that final outcome of these claims will not materially impact the Company's financial position.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock>
  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="HH582A4E700260C05D782FA2D6F218758A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;NA&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
