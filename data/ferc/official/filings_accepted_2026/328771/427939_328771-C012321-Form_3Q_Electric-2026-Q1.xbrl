  </xbrli:unit>
  <ferc:FormType id="HHF7EC89F6B6814CD2CC1C6928B801FC93" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">1/3-Q</ferc:FormType>
  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C012321</ferc:CompanyIdentifier>
  <ferc:ReportYearPeriod id="HH6439FA2135BC4FC31DA52CEDA67ED097" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026/Q1</ferc:ReportYearPeriod>
  <ferc:ReportYear id="HH660FC444EE17A785BFF22BCDC6434313" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4" decimals="0" unitRef="HHferc_us_Pure">2026</ferc:ReportYear>
  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q1</ferc:ReportPeriod>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-03-31</ferc:ReportDate>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock id="HHD2B1DFDF71C7477E84AEA1D4D780024C" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock>
  <ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock id="HH9BC0EFBCB25FD35BD21CC5095A000F66" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock>
  <ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock id="HHB507706EE223692FB3CE9DE4D62FC621" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock>
  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="HH1C967D5CB7055C23C61684D3A8ADDA65" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;NJBPU decided in its 4/22/26 Order to enter into a mutual agreement with PJM to terminate the Amended SAA Agreement which will effectively terminate the Company's project. The Board gave its president authority to sign the agreement, allowing PJM to send it to FERC for review and approval.&amp;#160; Following FERC&amp;#8217;s acceptance of the termination agreement, expected by June 23, 2026, PJM will end the DEA with the Company. The Company has no plans to appeal or challenge the termination of its DEA.&amp;#160; Following the termination of the DEA, the Company plans to seek authorization from FERC to recover prudently incurred transmission-related development and construction costs associated with the Project. Such request would be made in accordance with applicable FERC policies, including the transmission incentives outlined in FERC&amp;#8217;s declaratory order issued on February 15, 2024, in Docket No. EL23-101-000, which includes provisions addressing recovery of certain costs in the event of project abandonment due to circumstances beyond the transmission developer&amp;#8217;s control.&amp;#160; This effort is expected to take an estimated 12-24 months.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
  <ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock id="HH3753C2D0F64441EEC1CB77241E2239DC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock>
  <ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock id="HH2FB9527C1D4BB25D79F1C0C76F5BC95D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock>
  <ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock id="HHDB4E63D65FD21AE5462A8FBA840EA717" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock>
  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="HHEBA1CD44839C108D1DAFD6DE3427BE45" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock>
  <ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock id="HH22FBAEA0509E80B804A4341B1670898A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;On September 20, 2024, in docket ER24-2564-000 the Federal Energy Regulatory Commission approved the Company's transmission formula rate template and protocols (together the "Formula Transmission Rate") under section 205 of the Federal Power Act. Concurrently, the Formula Transmission Rate was remanded to settlement proceedings under section 206 of the Federal Power Act. The Company and other parties have entered into a settlement agreement in the Section 206 proceedings filed under FERC Docket ER24-137-000 that provides for adjustments to the Formula Transmission Rate. The settlement agreement is currently pending Commission approval. For purposes of these financial statements, the Company has reflected the effects of the adjusted Formula Rate consistent with the terms of the pending settlement agreement.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock>
  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="HH582A4E700260C05D782FA2D6F218758A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
  <ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock id="HHFB056E8F64ABA7B86B31B31B7725CE20" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;N/A&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock id="HHD790CCB2EDB33AB49E3957CEAFD4E7D7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:11.2pt; margin-left:36pt; margin-bottom:3pt; text-indent:-17.95pt; page-break-after:avoid; line-height:115%; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-size:11pt"&gt;1.&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Organization&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.25pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;and&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.3pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Basis&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.2pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;of&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.25pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.1pt"&gt;Presentation&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Mid-Atlantic Offshore Development LLC ("MAOD" or the "Company") is a limited liability company formed to develop offshore electric transmission facilities intended to interconnect offshore wind generation resources to the onshore transmission grid.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The accompanying unaudited financial statements have been prepared in accordance with the accounting and reporting requirements of the Federal Energy Regulatory Commission ("FERC") as set forth in the Uniform System of Accounts (&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;&amp;#x201C;&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;USoA") prescribed for electric utilities. Accordingly, the accompanying financial statements are prepared in conformity with accounting requirements of FERC, which constitute a &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;comprehensive basis of accounting other than accounting principles generally accepted in the United States of America ("U.S. GAAP").&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;These financial statements were not subjected to audit, review, or compilation by an independent certified public accounting firm. Management is responsible for the preparation and fair presentation of these financial statements.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:3.25pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The accompanying financial statements are presented for the three months ended&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; March 31, 2026.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; Certain balance sheet amounts are presented on a comparative basis with the Company&amp;#x2019;s financial statements as of December 31, 2025, which represent the Company&amp;#x2019;s first annual reporting period. Results for interim periods are not necessarily indicative of results for the full year. &lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:3.25pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:3.25pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Management has evaluated subsequent events through &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;May&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;27&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;, 2026, the date the financial statements were available to be issued&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:3.25pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:12pt; margin-left:36pt; margin-bottom:3pt; text-indent:-17.95pt; page-break-after:avoid; line-height:115%; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-size:11pt"&gt;2.&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Summary&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.45pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;of&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.25pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Significant&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.7pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Accounting&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.4pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.1pt"&gt;Policies&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; text-decoration:underline; color:#404040"&gt;Use&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.15pt; color:#404040"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; color:#404040"&gt;of&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.2pt; color:#404040"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.1pt; color:#404040"&gt;Estimates&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:1.45pt 17.8pt 0pt 18pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Our financial statements are prepared in conformity with FERC accounting requirements, which require management to make estimates in measuring assets and liabilities and related revenues and expenses. These estimates involve judgments with respect to, among other things, various future economic factors that are difficult to predict and are beyond our control; therefore, actual results could differ from these estimates. As additional information becomes available, or actual amounts are determined, recorded estimates are revised. Consequently, operating results can be affected by revisions to prior accounting estimates.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.7pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.1pt; color:#404040"&gt;Utility Plant and Construction Work in Progress&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Utility plant continues to consist primarily of construction work in progress (&amp;#x201C;CWIP&amp;#x201D;) related to the development of the offshore transmission project.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Capitalized costs include direct labor, materials, third-party contractor costs, applicable overhead, and allowance for funds used during construction ("AFUDC").&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Expenditures related to preliminary surveying, environmental studies, engineering, permitting, and regulatory approvals that are directly attributable to the construction of utility plants are capitalized in accordance with FERC accounting guidance. Costs determined to be non-recoverable or no longer probable of inclusion in future rates would be expensed or written off in the period such determination is made.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.1pt; color:#404040"&gt;Allowance for Funds Used During Construction&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:0.05pt 17.8pt 0pt 17.95pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;AFUDC is capitalized as a component of CWIP in accordance with FERC regulations&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; and applicable settlement provisions&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;. For the &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;quarter ended March 31, 2026, $772,511 and $1&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;,375,431&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;was capitalized for &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;AFUDC debt and AFUDC equity, respectively.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.7pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; text-decoration:underline"&gt;Impairment&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.55pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline"&gt;of&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.35pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline"&gt;Long-lived&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.6pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.1pt"&gt;Assets&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.75pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The Company evaluates long-lived assets for impairment whenever events or changes in circumstances indicate that the carrying amount of an asset may not be recoverable. Recoverability is assessed based on a comparison of the carrying amount to the sum of the undiscounted expected future cash flows. No impairment indicators were identified, and no impairment charges were recorded for &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;the quarter ended March 31, 2026.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.75pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; text-decoration:underline"&gt;Regulated&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.6pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.1pt"&gt;Operations&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:1.45pt 17.75pt 0pt 18pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;We account for our operations in accordance with Financial Accounting Standards Board Accounting Standards Codification Topic 980, Regulated Operations, which includes accounting principles for &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;companies whose rates are determined by independent third-party regulators. When setting rates, regulators often make decisions, the economics of which require companies to defer costs or revenues in different periods than may be appropriate for unregulated enterprises. When this situation occurs, a regulated company defers the associated costs as regulatory assets on the balance sheet and records them as expense on the income statement as it collects revenues. Further, regulators can also impose liabilities upon a regulated company for amounts previously collected from customers and for recovery of costs that are expected to be incurred in the future as regulatory liabilities. If we were required to terminate the application of these regulatory provisions to our regulated operations, all such deferred amounts would be recognized in the income statement at that time, which could have a material impact on our financial position, results of operations and cash flows.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.85pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:0pt 17.85pt 0pt 18pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;We monitor our regulatory and competitive environment to determine whether the recovery of our regulatory assets continues&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.05pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;to&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.1pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;be&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.15pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;probable.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.1pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;If&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.1pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;we were&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.15pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;to&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.1pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;determine&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.15pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;that&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.15pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;recovery&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.35pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;of&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.25pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;these&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.15pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;assets&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.05pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;is&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.05pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;no&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.1pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;longer&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; letter-spacing:-0.1pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;probable, we would write off the assets against earnings. &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Management believes costs incurred remain probable of recovery through future regulatory mechanisms; however, this assessment is subject to ongoing evaluation in light of recent regulatory developments described below.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:0pt 17.85pt 0pt 18pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; text-decoration:underline"&gt;Revenue&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.45pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.1pt"&gt;Recognition&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.7pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The Company did not recognize operating revenues during the &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;three months ending &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;March 31, 2026,&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; as the transmission facilities &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;have not been &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;placed in service.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.7pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; text-decoration:underline"&gt;Cash&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.3pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline"&gt;and&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.15pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline"&gt;Cash&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.25pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.1pt"&gt;Equivalents&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.8pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Cash and cash equivalents consist of highly liquid investments with original maturities of three months or less at the time of purchase. Cash balances are maintained to fund ongoing development activities.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.9pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; text-decoration:underline"&gt;Income&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.55pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.1pt"&gt;Taxes&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.8pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The Company is treated as a pass-through entity for federal and state income tax purposes; accordingly, the Company is not subject to income taxes at the entity level and taxable income, or loss is reportable by the Company&amp;#x2019;s members. Notwithstanding its pass-through tax status, the Company is permitted, subject to regulatory approval, to include an income tax allowance in its cost of service to reflect the income taxes that would be payable by the Company&amp;#x2019;s members on returns attributable to the Company&amp;#x2019;s regulated activities.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.8pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.8pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Consistent with accounting guidance applicable to regulated utilities, the Company accounts for income taxes on a stand-alone, regulated-entity basis as if it were a taxable corporation, to the extent of the income tax allowance reflected in rates. Accordingly, the Company records current income tax expense (or benefit) and deferred income taxes associated with temporary differences arising from regulated activities for which an income tax allowance is provided. Deferred income taxes are recorded as accumulated deferred income taxes (&amp;#x201C;ADIT&amp;#x201D;) and measured using enacted tax rates expected to apply when such temporary differences reverse.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.8pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.8pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The income tax allowance and related tax accounting are limited to taxes associated with regulated operations and do not represent taxes payable by the Company. Any differences between the tax amounts recognized for regulatory accounting purposes and the actual taxes incurred by the Company&amp;#x2019;s members are reflected as differences in the members&amp;#x2019; capital accounts and are not recorded as liabilities of the Company.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.8pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:1.8pt; margin-left:18pt; margin-bottom:0pt; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The Company&amp;#x2019;s income tax accounting is intended to comply with applicable normalization requirements, including the treatment of accelerated depreciation and related deferred taxes, to the extent such requirements are applicable to the Company&amp;#x2019;s regulated operations and income tax allowance.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Consistent with applicable tax &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;regulations and regulatory precedent, normalization is not required for the tax effects associated with equity AFUDC, which are accounted for using flow&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;&amp;#x2011;&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;through treatment.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; text-decoration:underline"&gt;Financial&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.65pt"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; text-decoration:underline; letter-spacing:-0.1pt"&gt;Instruments&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The carrying amounts of cash, accounts payable, and accrued liabilities approximate fair value due to the short-term nature of these instruments.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0.05pt; margin-left:36pt; margin-bottom:3pt; text-indent:-17.95pt; page-break-after:avoid; line-height:115%; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-size:11pt"&gt;3.&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.1pt"&gt;Utility Plant&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:17.95pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;As of March 31, 2026, u&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;tility plant consist&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;s&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; entirely of &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;CWIP&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; related to the offshore transmission project&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; The facilities have not been placed in service, and no depreciation expense was recorded during the year.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:17.95pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:17.95pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Management has evaluated the recoverability of CWIP in light of recent regulatory developments, including the expected termination of the Company&amp;#x2019;s Designated Entity Agreement. Based on its assessment of applicable FERC regulatory frameworks and policies supporting recovery of prudently incurred costs for cancelled or abandoned transmission projects, management believes that the costs capitalized as CWIP remain probable of recovery. This conclusion is dependent upon future regulatory approvals and is therefore subject to uncertainty associated with the outcome of such proceedings.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:17.95pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:17.95pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The Company has also considered whether these developments represent indicators of impairment of long-lived assets. While the anticipated cancellation of the project constitutes a triggering event requiring evaluation, management has not recorded an impairment as of March 31, 2026, based on its expectation that a substantial portion of the recorded CWIP will be recoverable through FERC-authorized mechanisms. The Company will continue to monitor developments and reassess this conclusion as additional information becomes available.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:17.95pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0.05pt; margin-left:36pt; margin-bottom:3pt; text-indent:-17.95pt; page-break-after:avoid; line-height:115%; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-size:11pt"&gt;4.&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.1pt"&gt;Transaction&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.1pt"&gt;with&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.45pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.1pt"&gt;Affiliates&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The Company receives administrative, management, accounting, legal, and other support services from affiliated entities. Costs are allocated based on direct charges consistent with FERC requirements. Amounts due to affiliates are recorded as accounts payable to associated companies.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Activity during the interim period is consistent with the nature of transactions disclosed in the Company&amp;#x2019;s annual financial statements.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:12pt; margin-left:36pt; margin-bottom:3pt; text-indent:-17.95pt; page-break-after:avoid; line-height:115%; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-size:11pt"&gt;5.&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Income&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.5pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.1pt"&gt;Taxes&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:0pt 17.85pt 0pt 18pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The Company is treated as a pass-through entity for federal and state income tax purposes. &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;For regulatory accounting purposes, the Company recognizes an income tax allowance&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;associated with its regulated activities and accounts for income taxes on a stand-alone basis consistent with FERC guidance and ASC Topic 740, Income Taxes.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;The Company also recognized accumulated deferred income taxes (&amp;#x201C;ADIT&amp;#x201D;) &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;associated with property, plant, and equipment and regulatory assets and liabilities. The Company expects that such amounts will be reflected in future cost-of-service recovery mechanisms, including any approved recovery of abandoned project costs.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:0pt 17.85pt 0pt 18pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:0pt 17.85pt 0pt 18pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;In determining its interim tax provision, the Company reflects its estimated impact from its permanent and flow-through tax differences. The statutory Federal tax rate is 21% for 2025 and 2024. The regulated utility earnings are also subject to tax in New Jersey, which has a state income tax rate of 9%. The Company&amp;#x2019;s effective income tax rate for the three months ended March 31, 2026 and the twelve months ended December 31, 2025 is 10.1%, and 10.4%, respectively. Our effective tax rate differs from the federal statutory tax rate primarily due to flow-through impacts of AFUDC-Equity. &lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:0pt 17.85pt 0pt 18pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:0pt 17.85pt 0pt 18pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The Company remains subject to examination by federal and state tax authorities, subject to the appropriate statute of limitations.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:12pt; margin-left:36pt; margin-bottom:3pt; text-indent:-17.95pt; page-break-after:avoid; line-height:115%; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-size:11pt"&gt;6.&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Rates&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.3pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;and&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.35pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Other&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.45pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Regulatory&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.65pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.1pt"&gt;Activities&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:8.05pt 17.85pt 0pt 17.95pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The Company is subject to the jurisdiction of the Federal Energy Regulatory Commission ("FERC") with respect to the transmission facilities under development. The Company expects to recover its prudently incurred costs, including a return on and of invested capital, through FERC&amp;#x2011;jurisdictional formula transmission rates &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;or other FERC-authorized recovery mechanisms, subject to regulatory approval.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:8.05pt 17.85pt 0pt 17.95pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;As of &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;March 31, 2026,&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; the Company&amp;#x2019;s transmission facilities &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;are not&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; in service; accordingly, no revenues have been reco&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;rded. &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:12pt; margin-left:36pt; margin-bottom:3pt; text-indent:-17.95pt; page-break-after:avoid; line-height:115%; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-size:11pt"&gt;7.&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Other&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.55pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Commitments&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.2pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;and&lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.35pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial; letter-spacing:-0.1pt"&gt;Contingencies&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:8.05pt 17.85pt 0pt 17.95pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The Company is party to various contractual commitments related to construction, procurement, engineering, consulting, permitting, and development activities entered into in the ordinary course of business. Management believes that resolution of any existing commitments or contingencies will not have a material adverse effect on the Company&amp;#x2019;s financial position.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ol start="8" type="1" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-top:8.05pt; margin-right:17.85pt; margin-left:31.2pt; text-align:justify; line-height:115%; widows:0; orphans:0; padding-left:4.75pt; font-family:'Times New Roman'; font-size:11pt; font-weight:bold"&gt;&#xD;
					&lt;span style="font-size:10pt"&gt;Subsequent Event and Context&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ol&gt;&#xD;
			&lt;p style="margin:8.05pt 17.85pt 0pt 17.95pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Subsequent to March 31, 2026, significant regulatory developments occurred that materially affect the status of the Company&amp;#x2019;s transmission project and the expected timing and method of cost recovery.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:8.05pt 17.85pt 0pt 17.95pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;On April 22, 2026, the New Jersey Board of Public Utilities ("NJBPU") issued Order &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;4-22-26-LSA (the &amp;#x201C;4/22/26 Order&amp;#x201D;) &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;determining that termination of the State Agreement Approach ("SAA") arrangement with PJM was in the best interest of the State. The NJBPU authorized execution of an agreement to terminate the Amended SAA Agreement, which includes the Company&amp;#x2019;s designated transmission project.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:8.05pt 17.85pt 0pt 17.95pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Upon FERC acceptance of the termination agreement, PJM is expected to terminate the Company&amp;#x2019;s Designated Entity Agreement. As a result, the Company does not expect the project to be completed or placed into service under the previously contemplated development framework.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:8.05pt 17.85pt 0pt 17.95pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;In response to these developments, the Company expects to pursue recovery of prudently incurred development and construction costs through FERC processes applicable to transmission projects that are cancelled or abandoned due to factors outside the control of the developer. Such recovery may include CWIP, carrying costs, and a return on prudently incurred investments, subject to FERC approval.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin:8.05pt 17.85pt 0pt 17.95pt; text-align:justify; line-height:115%; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Management has evaluated these developments and continues to believe that the costs recorded as CWIP remain probable of recovery; however, the ultimate outcome, timing, and method of recovery are subject to regulatory proceedings and therefore involve inherent uncertainty. The Company will continue to assess these matters and will recognize any required adjustments in the period in which new information becomes available.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:8pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
  <ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock id="HH26F298D96F05ADD051F0C74B218AC0A3" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock>
