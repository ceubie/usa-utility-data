    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH4FE388D693CF8A5B257374966362BD66" xlink:to="HH25CB790C00569A13F13005209AB19725" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHA28CF79B3FD6A978F50BB7D392220CA8" xlink:label="HHA28CF79B3FD6A978F50BB7D392220CA8" />
    <link:footnote xlink:type="resource" xlink:label="HHD5A873A46846E25BD7CC57B228F59548" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>&#160;</p>
        <table style="width: 718.438px; border-radius: 2px 2px 0px 0px; border-spacing: 0px; display: inline-table; margin-bottom: 5pt; vertical-align: text-bottom;">
          <tbody>
            <tr>
              <td style="width: 7.10938px;">&#160;</td>
              <td style="width: 134.551px;">&#160;</td>
              <td style="width: 1.99219px;">&#160;</td>
              <td style="width: 7.10938px;">&#160;</td>
              <td style="width: 134.551px;">&#160;</td>
              <td style="width: 1.99219px;">&#160;</td>
              <td style="width: 7.10938px;">&#160;</td>
              <td style="width: 134.551px;">&#160;</td>
              <td style="width: 1.99219px;">&#160;</td>
              <td style="width: 7.10938px;">&#160;</td>
              <td style="width: 134.551px;">&#160;</td>
              <td style="width: 1.99219px;">&#160;</td>
              <td style="width: 7.10938px;">&#160;</td>
              <td style="width: 134.551px;">&#160;</td>
              <td style="width: 2.16797px;">&#160;</td>
            </tr>
            <tr>
              <td style="padding: 2px 1pt; vertical-align: bottom;" colspan="15">
                <span style="color: #000000; font-family: Arial, sans-serif; font-size: 8pt; line-height: 12.8px;">The Commission is required by section 3401 of the Omnibus Budget Reconciliation Act of 1983 to assess and collect fees and annual charges in any fiscal year in amounts equal to all costs incurred by the Commission in a fiscal year. This allows FERC to establish an ACA unit charge applicable to all jurisdictional quantities transported which allows pipelines to recover these costs under its current rates with customers.</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHA28CF79B3FD6A978F50BB7D392220CA8" xlink:to="HHD5A873A46846E25BD7CC57B228F59548" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHC218D9C033E4551F94C80460A92FC26A" xlink:label="HHC218D9C033E4551F94C80460A92FC26A" />
    <link:footnote xlink:type="resource" xlink:label="HH459F2C6E20E0B00DCD274E4CD6F1C91C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">Line 56- The Net Increase in Debt (Long Term Advances) of $2,300,000.00 received in the First Quarter of 2025, represents a Capital Contribution of cash from Vector&#8217;s Partners (as shown in Line 56.2).&#160; This funding is specifically earmarked for payment of Capital expenditure related invoices due to be paid during the Second Quarter of 2025.&#160; This is not a Long Term Advance.</p>
      </div>
    </link:footnote>
