    <ferc:RegulatoryCommissionDescription id="f-3454" contextRef="c-576">Other</ferc:RegulatoryCommissionDescription>
    <ferc:NotesToFinancialStatementsTextBlock id="f-3456" contextRef="c-129">&lt;div class="Section_1"&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-right: 64.8pt; margin-bottom: 0; line-height: 12pt"&gt; 					&lt;span&gt;&amp;#160;&lt;/span&gt; 				&lt;/p&gt; 			&lt;/div&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;NOTE A - ORGANIZATION AND OPERATIONS:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Organization.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern Pipeline Company, LLC (&amp;quot;Transwestern&amp;quot;), a Delaware limited liability company (&amp;quot;LLC&amp;quot;), is an indirect wholly-owned subsidiary of Energy Transfer LP (&amp;quot;Energy Transfer&amp;quot;). &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Operations.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern is a provider of natural gas transportation services to the southwestern United States and as such, is subject to the rules, regulations, and accounting of the Federal Energy Regulatory Commission (&amp;quot;FERC&amp;quot;).&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern owns and operates approximately 2,520 miles of interstate natural gas pipeline systems extending from Texas, New Mexico, and southern Colorado to California, directly and indirectly serving several southwest markets, including Phoenix, Arizona; Las Vegas, Nevada; and Southern California.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern has direct access to three significant gas basins: the Permian Basin in West Texas and eastern New Mexico, the San Juan Basin in northwest New Mexico and southern Colorado, and the Anadarko Basin in the Texas and Oklahoma panhandles.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's pipeline system has a mainline that stretches from Texas to the California border with major supply laterals reaching into these gas producing basins.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's mainline has bi-directional flow capability from the San Juan basin east to connect with interstate pipelines serving the mid-continent markets and Texas intrastate pipelines and west to Phoenix, Arizona and to the California border.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern evaluated subsequent events thro&lt;span style="background-color: rgba(0, 0, 0, 0)"&gt;ugh &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="background-color: rgba(0, 0, 0, 0)"&gt;April 7, 2026&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="background-color: rgba(0, 0, 0, 0)"&gt;, t&lt;/span&gt;he date on which the financial statements were available to be issued.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Any material subsequent events that occurred during this time have been properly recognized and/or disclosed in these financial statements.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;NOTE B - ESTIMATES AND SIGNIFICANT ACCOUNTING POLICIES: &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;1.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Basis of Presentation&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.5pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's financial statements have been prepared in accordance with the requirements of the FERC, as set forth in the applicable Uniform System of Accounts and published accounting releases, which constitute a comprehensive basis of accounting other than accounting principles generally accepted in the United States of America (&amp;quot;GAAP&amp;quot;).&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The most significant differences between GAAP and the financial statement presented herein are (1) classification of certain accounts on the balance sheet, statement of income and statement of cash flows, (2) certain assets and liabilities that result from the regulated ratemaking process are recorded that would not be recorded under GAAP for non-regulated entities.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt; text-align: justify"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;2.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Use of Estimates&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.5pt; margin-bottom: 0; text-align: justify"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The preparation of financial statements requires management to make estimates and assumptions that affect the reported amounts of assets and liabilities and the accrual for and disclosure of contingent assets and liabilities at the date of the financial statements and the reported amounts of revenues and expenses during the reporting period.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Although these estimates are based on management's available knowledge of current and expected future events, actual results could differ from those estimates. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;3.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Cash and Cash Equivalents&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.5pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern has a cash management agreement with Energy Transfer which authorizes Energy Transfer or its designated affiliate to provide cash management services to Transwestern.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;At the close of each business day, the agreement allows for Transwestern to transfer funds in excess of general operating purposes to Energy Transfer or if Transwestern has insufficient funds to meet its general operating purposes, Energy Transfer will transfer all funds necessary to Transwestern.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;These cash transfer activities are presented as investing cash flows in the accompanying statements of cash flows given that the net cash transferred to Energy Transfer or its affiliate results in a net receivable to Transwestern, subject to netting arrangements or periodic net equity reclassifications. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;4.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Plant Materials and Operating Supplies&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.5pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Plant materials and operating supplies are carried at the lower of weighted average cost or net realizable value.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Materials transferred out of warehouses are priced at weighted average cost. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;5.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Natural Gas Imbalances&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.5pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Natural gas imbalances occur as a result of differences in volumes of natural gas received and delivered.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern values natural gas imbalance for in-kind receivables and payables at the current market price and dollar valued imbalances at contractual prices.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;6.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;&lt;span style="text-decoration: underline"&gt;System Balancing Gas&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Gas held for transmission operations is recorded in System balancing gas, Account 117.2 using the fixed asset method valued at historical cost.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;7.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Gas Owed to System Gas&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.5pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern accounts for gas owed to system gas using the fixed asset accounting model established under FERC Order No.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;581.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Under this approach, gas owed to system gas volumes are classified as fixed assets and valued at historical cost.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Encroachments upon gas owed to system gas are valued at current market prices.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern may sell gas owed to system gas in excess of its system operational requirements.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;8.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Utility Plant&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.5pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: underline"&gt;Additions&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Ongoing additions of utility plant are stated at cost.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern capitalizes all construction related direct labor and material costs, as well as indirect construction costs.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Such indirect construction costs primarily include labor and related costs of departments associated with supporting construction activities and allowance for funds used during construction.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The indirect capitalized labor and related costs are largely based upon results of periodic time studies or management reviews of time allocations, which provide an estimate of time spent supporting construction projects.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The cost of replacements and betterments that extend the useful life of utility plant is also capitalized.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The cost of repairs and replacements of minor utility plant items is charged to expense as incurred. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: underline"&gt;Retirements&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;When ordinary retirements of utility plant occur, the original cost plus cost of removal less salvage value is removed by a charge to accumulated depreciation and amortization, with no gain or loss recorded.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;When entire regulated operating units of utility plant are sold, the original cost and related accumulated depreciation and amortization accounts are removed, with any resulting gain or loss recorded in the statements of income.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: underline"&gt;Depreciation.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern computed depreciation expense under the composite method using FERC- approved depreciation rates. For general and intangible plant, Transwestern computed depreciation expense under the straight-line method using FERC-approved depreciation rates. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: underline"&gt;Allowance for Funds Used During Construction (&amp;quot;AFUDC&amp;quot;).&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern capitalizes the cost of funds used during construction for capital projects.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The rates used by Transwestern are calculated pursuant to FERC rules, which include an allowance for the cost of debt and equity funds. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: underline"&gt;Plant Acquisition Adjustment.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;In 2006, an aggregate plant acquisition adjustment of $446.2 million, associated with Energy Transfer's acquisition of Transwestern is allocated to Transwestern's transmission plant.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;This acquisition adjustment is not included in the determination of tariff rates that Transwestern charges to its customers.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The acquisition adjustment is being amortized over 35 years, the composite weighted average estimated remaining life of Transwestern's assets as of the acquisition date.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;As of December 31, 2025 and 2024, the unamortized balance of this adjustment was $203.9 million and $216.5 million, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;9.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Asset Retirement Obligation (&amp;quot;ARO&amp;quot;)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Legal obligations associated with the retirement of long-lived assets are recorded at fair value at the time the obligations are incurred, if a reasonable estimate of fair value can be made.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Present value techniques are used which reflect assumptions such as removal and remediation costs, inflation, and profit margins that third parties would demand to settle the amount of the future obligation.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern did not include a market risk premium for unforeseeable circumstances in its fair value estimates because such a premium could not be reasonably estimated.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Upon initial recognition of the liability, costs are capitalized as part of the long-lived asset and depreciated over the useful life of the related asset.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The liability is accreted to its present value each period with accretion being recorded to operating expense or regulatory asset, as applicable, with a corresponding increase in the carrying amount of the liability.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;10.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Related Party Transactions&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Related party transactions primarily include revenues earned from and payments for services provided by Energy Transfer and its subsidiaries. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transactions are generally allocated based on relevant criteria, including time spent, utility plant, gross margin, salaries, or other appropriate methods. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;11.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Unamortized Debt Premium, Discount and Expense&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.5pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern amortizes premiums, discounts, and expenses incurred in connection with the issuance of long-term debt through the maturity date of the respective debt instrument, which is comparable to the effective interest method.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span style="font-weight: bold"&gt;12.&lt;/span&gt;&lt;span style="width: 2.75pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Environmental Expenditures&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Environmental expenditures that relate to an existing condition caused by past operations that do not contribute to current or future revenue generation are expensed.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Environmental expenditures relating to current or future revenues are expensed or capitalized as appropriate.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Liabilities are recorded when environmental assessments and/or clean-ups are probable and the costs can be reasonably estimated.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Remediation obligations are not discounted because the timing of future cash flow streams is not predictable.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 18pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;13. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Revenue Recognition&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.5pt; margin-bottom: 0; text-align: justify"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's revenues from transportation of natural gas are based on capacity reservation charges and, to a lesser extent, commodity usage charges. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Reservation revenues, recognized monthly, are based on contracted rates and capacity reserved by the customers. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Revenues from commodity usage charges, also recognized monthly, are based on the volumes received from or delivered to the customer, based on Transwestern's tariff.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Revenues collected during the pendency of a rate proceeding may be required by the FERC to be refunded in the final order.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern establishes reserves for such potential refunds, as appropriate.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;No such reserves were required at December&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;31, 2025 and 2024. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;14. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Accounts Receivable and Allowance for Expected Credit Losses&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -13.5pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -13.5pt"&gt; 				&lt;span style="width: 9pt; text-indent: 0; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 4.5pt; text-indent: 0; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern generates the majority of its revenues from long and short-term firm transportation contracts with natural gas producers, local distribution companies and utilities, marketers, and end-users.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The large n&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;umber of customers in this energy segment may impact Transwestern's overall exposure to credit risk, either positively or negatively, in that the customers may be similarly affected by changes in economic or other conditions.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit; text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-size: 12pt; background-color: unset"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;From time to time, specifically identified customers that fail to meet the creditworthiness standards s&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; text-indent: -13.5pt; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;et forth in Transwestern's tariff are required to provide prepayments or other forms of collateral to Transwestern.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit; text-indent: -13.5pt"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; text-indent: -13.5pt; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;Transwestern held aggregate deposits of $21.0 million and $26.9 million as of December&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit; text-indent: -13.5pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; text-indent: -13.5pt; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;31, 2025 and 2024, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit; text-indent: -13.5pt"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; text-indent: -13.5pt; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;Deposits are included in Customer advances for construction, Account 252 and Customer deposits, Account 235.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit; text-indent: -13.5pt"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; text-indent: -13.5pt; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;Transwestern's management believes that the portfolio of receivables, which includes regulated producers and electric utilities, regulated local distribution companies and municipalities, are subject to minimal credit risk.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -13.5pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern establishes an allowance for expected credit losses on trade receivables based on the expected ultimate recovery of these receivables and considers many factors including historical customer collection experience, general and specific economic trends and known specific issues related to individual customers, sectors and transactions that might impact collectability.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Changes in the allowance are recorded as a component of operating expenses; reductions in the allowance are recorded when receivables are subsequently collected or written-off.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Past due receivable balances are written-off when Transwestern's efforts have been unsuccessful in collecting the amount due.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's allowance for expected credit losses was not material as of December 31, 2025 and 2024. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The following table presents the relative contribution to Transwestern's total transportation revenues from operations of each customer that comprised at least 10% of its revenues:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="568" height="137" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-align: inherit"&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern has the following transportation receivables from these customers at the dates indicated:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="607" height="167" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt; &lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: inherit"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;In addition to the concentration of revenue risk by customers discussed above, Transwestern has customers with outstanding accounts receivable greater than 10% of the total accounts receivable. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Two customers have accounts receivable of $2.6 million and $2.4 million, and $2.6 million and $1.2 million, respectively, as of December 31, 2025 and 2024.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;One customer has accounts receivable of $3.6 million as of December 31, 2024. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;15. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Fair Value Measurement&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.5pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Under Accounting Standards Codification (&amp;quot;ASC&amp;quot;) 820, Fair Value Measurement, the fair value measurements are characterized in one of three levels based upon the input used to arrive at the measurement.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The three levels of the fair value hierarchy are as follows:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;ul style="margin-left: 36pt"&gt;&lt;li style="margin-top: 0; margin-bottom: 0; text-indent: -9pt; font-family: Arial, Helvetica, sans-serif; font-size: 12pt; color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span&gt;&lt;span style="width: 3.94pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Level 1 inputs are quoted prices (unadjusted) in active markets for identical assets or liabilities that the reporting entity can access at the measurement date.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt; 			&lt;ul style="margin-left: 36pt"&gt;&lt;li style="margin-top: 0; margin-bottom: 0; text-indent: -9pt; font-family: Arial, Helvetica, sans-serif; font-size: 12pt; color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span&gt;&lt;span style="width: 3.94pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Level 2 inputs are inputs other than quoted prices included within Level 1 that are observable for the asset or liability, either directly or indirectly; and&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt; 			&lt;ul style="margin-left: 36pt"&gt;&lt;li style="margin-top: 0; margin-bottom: 0; text-indent: -9pt; font-family: Arial, Helvetica, sans-serif; font-size: 12pt; color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span&gt;&lt;span style="width: 3.94pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Level 3 inputs are unobservable inputs for the asset or liability.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Assets and liabilities are classified in their entirety based on the lowest level of input that is significant to the fair value measurement. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's assessment of the significance of a particular input to the fair value measurement requires judgment and may affect the valuation of these assets and liabilities and their placement within the fair value hierarchy.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The carrying amounts of accounts receivable and accounts payable approximate their fair value.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The other postretirement plan assets are classified as Level 1 and Level 2 assets within the fair-value hierarchy as their values are based on active market quotes.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The fair value of Transwestern's debt obligation is a Level 2 valuation based on observable inputs for similar liabilities.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;16. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Retirement Benefits&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Employers are required to recognize in their balance sheets the overfunded or underfunded status of defined benefit other postretirement plans, measured as the difference between the fair value of the plan assets and the benefit obligation.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Each overfunded plan is recognized as an asset and each underfunded plan is recognized as a liability.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Employers applying regulatory accounting recognize the change in the funded status of the plan as a regulatory asset or regulatory liability in the year in which the change occurs.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern recognized net periodic benefit expense to the extent of amounts recorded in Transwestern's rates with any difference recorded as a regulatory asset or regulatory liability.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Unrecognized prior service costs (benefits) and gains&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;and/or losses are recorded as a regulatory asset or regulatory liability, reflecting amounts due from or to customers, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;17. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Income Taxes&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The FERC's Revised Policy Statement on Treatment of Income Taxes, Docket No. PL17-1, states that it no longer permits master limited partnerships including a company that does not pay taxes itself and is owned by a master limited partnership, to recover an income tax allowance in their cost of service.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 12pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;18. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Taxes, Other Than on Income&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Taxes, other than on income primarily consist of ad valorem tax paid on the assessed value of Transwestern natural gas transmission lines based on fixed rates established by the applicable state or local taxing authorities. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Ad valorem taxes are generally based on assessed property value at the beginning of each year.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;19. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Commitments and Contingencies&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 22.5pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern is subject to proceedings, lawsuits and other claims related to environmental and other matters.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Accounting for contingencies requires significant judgment by management regarding the estimated probabilities and ranges of exposure to potential liability.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;NOTE C - RELATED PARTY TRANSACTIONS:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The following table provides a summary of the associated transactions for the periods presented:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;img src="data:image/png;base64," class="e-rte-image e-imginline" width="576" height="115" style="min-width: 0; max-width: 1752px; min-height: 0" alt="" /&gt; &lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; &lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-align: center"&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 67.5pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span&gt;(1)&lt;/span&gt;&lt;span style="width: 6.43pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transportation and operational sales related revenue from ETC Marketing Ltd., an indirect wholly-owned subsidiary of Energy Transfer.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 67.5pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span&gt;(2)&lt;/span&gt;&lt;span style="width: 6.43pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Corporate charges and shared services provided by Energy Transfer and its subsidiaries. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Accounts receivable from associated companies primarily relate to cash management activity, transportation and operational sales of natural gas.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Accounts payable to associated companies primarily relate to services provided by Energy Transfer and its subsidiaries.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern declared non-cash distributions of $171.8 million and $35.8 million at December 31, 2025 and 2024, respectively, to settle its associated company accounts receivable from Energy Transfer Interstate Holdings, LLC, a subsidiary of Energy Transfer.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern has transportation and exchange gas receivables and payables with associated companies as a result of differences in volumes of gas received and delivered for those associated companies.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The imbalances are settled based on the operator balancing agreements that Transwestern has with those associated companies.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The following table sets forth the balances with associated companies within transportation and exchange gas receivables and payables reflected in Miscellaneous current and accrued assets, Account 174, and Miscellaneous current and accrued liabilities, Account 242, respectively, on the balance sheet:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="688" height="120" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-align: inherit"&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 7pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;NOTE D - DEBT OBLIGATIONS:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The following table sets forth the debt obligations of Transwestern at the dates indicated:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="732" height="118" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;In 2025, Transwestern paid interest of $4.6 million on senior notes. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Interest on Transwestern's note is payable semi-annually and the note is prepayable, subject to a make-whole premium, or upon a change of control event, as defined in the indenture. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="width: 126.75pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Based on the estimated borrowing rates currently available for loans with similar terms and average maturities, the aggregate fair value of Transwestern's debt obligations as of December 31, 2025 and 2024 was $76.3 million and $73.7 million, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's notes indenture contains a financial covenant that specifies a maximum debt-to-capital leverage ratio of 65%.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt; The indenture also contains other restrictive covenants that, among other things, limit the incurrence of additional debt, limit the distribution of capital and prohibit the sale of a significant portion of assets.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-size: 12pt"&gt;A failure by Transwestern to satisfy any such covenants would be considered an event of default which would cause the notes to become immediately due and payable if Transwestern did not cure such default within a&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;ny permitted cure period or if Transwestern did not obtain amendments, consents or waivers from its note holders with respect to such covenants. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;As of December 31, 2025, Transwestern was in compliance with these covenants.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;NOTE E - RETIREMENT BENEFITS: &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-align: justify"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Other Postretirement Benefit Plans&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern is participating in a voluntary employees' beneficiary association (&amp;quot;VEBA&amp;quot;) within the meaning of Section 501(c) (9) of the Internal Revenue Code of 1986, as amended (the &amp;quot;Code&amp;quot;).&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;In general, the VEBA provides a financial subsidy to offset a portion of the premium due from eligible participants and their eligible dependents who participate in certain of Transwestern's post-retirement medical benefits.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Postretirement benefits expense for the years ended December 31, 2025 and 2024 reflect the impact of changes Transwestern adopted as of September 30, 2013 to modify its retiree medical benefits program, effective January 1, 2014.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The modification placed all eligible retirees on a common medical benefit platform, subject to limits on Transwestern's annual contribution toward eligible retirees' medical premiums.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;As of December&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;31, 2025 and 2024, Transwestern's plan was in an overfunded position.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;There is no cost recovery or related funding that is required as part of Transwestern's current FERC approved rates (Docket No. RP22-1031-000).&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Obligations and Funded Status&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 13.5pt; margin-bottom: 0; text-indent: 22.5pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Other postretirement benefit liabilities are accrued on an actuarial basis during the years an employee provides services.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The following table contains information at the date indicated about the obligations and funded status of Transwestern's other postretirement plan.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="685" height="456" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt; &lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt;&lt;span style="font-weight: bold; background-color: unset; font-size: 1em"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span&gt;(1)&lt;/span&gt;&lt;span style="width: 6.43pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Pursuant to Transwestern's previous rate proceeding Transwestern contributed $0.5 million annually for post-retirement benefits; however, when Transwestern's plan became fully funded, contributions to the plan were to be discontinued with Transwestern continuing to accrue $0.5 million annually.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;In 2023, Transwestern paid shippers $3.8 million for amounts previously collected after the plan became fully funded. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: inherit"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; font-weight: bold; text-align: inherit"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Components of Net Periodic Benefit Cost&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="616" height="186" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt; &lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Assumptions&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The weighted average discount rate used in determining benefit obligations was 5.02% and 5.00% at December 31, 2025 and 2024, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The weighted average assumptions used in determining net periodic benefit cost for the periods presented are shown in the following table:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="599" height="84" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: inherit"&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The long-term expected rate of return on plan assets was estimated based on a variety of factors including the historical investment return achieved over a long-term period, the targeted allocation of plan assets and expectations concerning future returns in the marketplace for both equity and fixed income securities.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Current market factors such as inflation and interest rates are evaluated before long-term market assumptions are determined.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Peer data and historical returns are reviewed to ensure reasonableness and appropriateness.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The assumed health care cost trend weighted average rates used to measure the expected cost of benefits covered by the plan are shown in the following table:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="787" height="107" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Changes in the health care cost trend rate assumptions are not expected to have a significant impact on postretirement benefits.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Plan Assets&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The fair value of other postretirement plan assets by asset category at the dates indicated is as follows:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="641" height="144" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt; &lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;span&gt;(1)&lt;/span&gt;&lt;span style="width: 6.43pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Primarily comprised of approximately 65% of equity securities, 25% of debt securities and 10% of cash and cash equivalents as of December 31, 2025, and 62% of equity securities, 26% of debt securities and 12% of cash and cash equivalent as of December 31, 2024.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Contributions&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;For the 2026 fiscal year, the estimated contribution to the other postretirement benefit plan is $0.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;Benefit Payments&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's estimate of expected benefit payments, which reflect expected future service, as appropriate, in each of the next five years and in the aggregate for the five years thereafter are shown in the following table:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="378" height="176" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt; &lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The Medicare Prescription Drug Act provides for a prescription drug benefit under Medicare (&amp;quot;Medicare Part D&amp;quot;) as well as a federal subsidy to sponsors of retiree health care benefit plans that provide a prescription drug benefit that is at least actuarially equivalent to Medicare Part D.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern does not expect to receive any Medicare Part D subsidies in any future periods.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;NOTE F - UTILITY PLANT: &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The following table provides a summary of utility plant at the dates indicated:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-align: center"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="748" height="182" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-align: center"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;NOTE G - ASSET RETIREMENT OBLIGATIONS:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's ARO is related to obligations associated with the removal and disposal of asbestos and asbestos containing materials on Transwestern's pipeline system. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;When the asbestos on the underlying asset is disturbed Transwestern is legally required to remove the asbestos.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;An ARO is required to be recorded when a legal obligation to retire an asset exists and such obligation can be reasonably estimated.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Although a number of other assets in Transwestern's system are subject to agreements or regulations that give rise to AROs upon T&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; text-decoration-line: inherit; font-size: 12pt; background-color: unset; text-align: inherit"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;ranswestern's discontinued use of these assets, AROs were not recorded because these assets have an indeterminate removal or abandonment date given the expected continued use of the assets with proper maintenance or replacement.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Individual component assets have been and will continue to be replaced, but the pipeline system will continue in operation as long as supply and demand for natural gas exists.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Based on the widespread use of natural gas in industrial and power generation activities, management expects supply and demand to exist for the foreseeable future.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern has in place a rigorous repair and maintenance program that keeps the pipeline system in good working order.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Therefore, although some of the individual assets of the pipeline system may be replaced, the pipeline system itself will remain intact indefinitely.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The following table is a reconciliation of the carrying amount of the ARO reflected as liabilities recorded in Asset retirement obligations, Account 230 on the balance sheet for the periods presented.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Changes in assumptions regarding the timing, amount, and probabilities associated with the expected cash flows, as well as the difference in actual versus estimated costs, will result in a change in the amount of the liability recognized.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="567" height="162" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt; &lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-align: center"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-align: center; background-color: unset; font-size: 1em"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Management determined that Transwestern is obligated by contractual requirements to remove facilities or perform other remediation upon retirement of certain pipeline assets.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Determination of the amounts recognized is based upon numerous estimates and assumptions, including expected settlement dates, future retirement costs, future inflation rates, and the credit-adjusted risk-free interest rates. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Management is not able to reasonably measure the fair value of the asset retirement obligations, other than the asbestos related l&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;iabilities, as of December 31, 2025 or 2024 because the settlement dates are indeterminable.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;An ARO will be recorded in the periods management can reasonably determine the settlement dates.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;NOTE H - COMMITMENTS, CONTINGENCIES AND ENVIRONMENTAL LIABILITIES: &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Leases.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern utilizes assets under operating leases in several areas of operation.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Rental expenses for these leases, including expenses allocated from associated companies, amounted to $19.5 million and $18.6 million as of December 31, 2025 and 2024, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Future minimum rental payments of rights-of-way cost are approximately $26.2 million for 2026, $27.2 million for 2027, $28.3 million for 2028, $29.4 million for 2029, $30.6 million for 2030 and approximately $1.0 billion in aggregate thereafter.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Liabilities for Litigation and Other Claims. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern records accrued liabilities for litigation and other claim costs when management believes a loss is probable and reasonably estimable. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;When management believes there is at least a reasonable possibility that a material loss or an additional material loss may have been incurred, Transwestern discloses (i) an estimate of the possible loss or range of loss in excess of the amount accrued; or (ii) a statement that such an estimate cannot be made. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;On February 3, 2022, the State of New Mexico, ex rel. Hector Balderas, Attorney General filed a complaint against Energy Transfer Operating, L.P., formerly a less than wholly-owned subsidiary of Energy Transfer until its merger into Energy Transfer in April 2021, Transwestern, Kinder Morgan, Inc., El Paso Natural Gas L.L.C. and Northwest Pipeline, LLC in Cause No. D-101-CV-2022-00174 in the First Judicial District Court, County of Santa Fe, State of New Mexico, seeking to recover statewide damages for contamination with polychlorinated biphenyls (&amp;quot;PCBs&amp;quot;) used for decades by the oil and gas industry in the operation and maintenance of pipeline infrastructure.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The complaint alleged discharge or release of PCBs into the natural environment from compressor stations in connection with the operation of Transwestern.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The State sought damages in the range of $50 million to $60 million plus the attorneys' fee from Transwestern.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;On January 26, 2026, Transwestern entered into a settlement agreement resolving all claims against it in this proceeding.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The settlement amount of $4.6 million was paid on February 3, 2026. &lt;span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none"&gt;As of December 31, 2025 and 2024, Transwestern's accruals of $4.6 million and nil, respectively, were reflected in Miscellaneous current and accrued liabilities, Account 242, on the balance sheet related to litigation and other claim-related costs that met both probable and reasonably estimable criteria.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern does not have any other material litigation or other claim contingency matters assessed as probable or reasonably possible that would require disclosure in the financial statements.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Environmental Matters&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's operations are subject to federal, tribal, state and local environmental and safety laws and regulations that require expenditures to ensure compliance, including related to air emissions and wastewater discharges at operating facilities and for remediation at current and former facilities as well as waste disposal sites.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Historically, Transwestern's environmental compliance costs have not had a material adverse effect on Transwestern's results of operations but there can be no assurance that such costs will not be material in the future or that such future compliance with existing, amended or new legal requirements will not have a material adverse effect on Transwestern's business and operating results.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Costs of planning, designing, constructing and operating pipelines and other facilities must incorporate compliance with environmental laws and regulations and safety standards.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Failure to comply with these laws and regulations may result in the assessment of administrative, civil and criminal penalties, the imposition of investigatory, remedial and corrective action obligations, natural resource damages, the issuance of injunction in affected areas and the filing of federally authorized citizen suits.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Contingent losses related to all significant known environmental matters have been accrued and/or separately disclosed.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;However, Transwestern may revise accrual amounts prior to resolution of a particular contingency based on changes in facts and circumstances or changes in the expected outcome.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Environmental exposures and liabilities are difficult to assess and estimate due to unknown factors such as the magnitude of possible contamination, the timing and extend of remediation, the determination of Transwestern's liability in proportion to other parties, improvements in cleanup technologies and the extent to which environmental laws and regulations may change in the future.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Although environmental costs may have a significant impact on Transwestern's results of operations for any single period, Transwestern believes that such costs will not have a material adverse effect on its financial position. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Based on information available at this time and reviews undertaken to identify potential exposure, Transwestern believes the amount reserved for environmental matters is adequate to cover the potential exposure of cleanup costs.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 12pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Environmental Remediation.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern conducts soil and groundwater remediation related to contamination from past uses of PCBs.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;PCB assessments are ongoing and, in some cases, Transwestern could be contractually responsible for contamination caused by other parties.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 12pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;To the extent estimable, expected remediation costs are included in the amounts recorded for environmental matters in Transwestern's balance sheets.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;In some circumstances, future costs cannot be reasonably estimated because remediation activities are undertaken as claims are made by customers and former customers.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Amounts that are expected to be recoverable through tariffs or rates are recorded as Regulatory assets, Account 182.3 on Transwestern's balance sheet.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;As of December 31, 2025 and 2024, the regulatory assets related to the remediation costs were $1.3 million and $1.8 million, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 12pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern, as part of an ongoing arrangement with a customer, continues to incur costs associated with the PCB remediation.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Costs for these remedial activities totaled $0.9 million and $0.6 million for the years ended December 31, 2025 and 2024, respectively. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;While future costs cannot be reasonably estimated because remediation activities are undertaken as potential claims are made by the customer, the expectation is that these costs will continue to be less over time.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Nonetheless, such future costs are not expected to have a material impact on Transwestern's financial position, results of operations or cash flows.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 12pt"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern recorded accrued liabilities of $2.4 million and $2.7 million in Miscellaneous current and accrued liabilities, Account 242 and Other deferred credits, Account 253 as of December 31, 2025 and 2024, respectively, related to environmental matters that are considered to be probable and reasonably estimable.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Currently, Transwestern is not able to estimate possible losses or range of possible losses in excess of amounts accrued.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Except for matters discussed above, Transwestern does not have any material environmental matters assessed as reasonably possible that would require disclosure in its financial statements.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern facilities must comply with environmental regulations for United States Environmental Protection Agency's Spill Prevention, Control and Countermeasures (&amp;quot;SPCC&amp;quot;) program.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern continues to review the impact to its operations with respect to SPCC requirements and expects to expend resources on tank integrity testing and any associated corrective actions as well as potential upgrades to containment structures to comply with the new rules.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Costs associated with tank integrity testing and resulting corrective actions cannot be reasonably estimated at this time, but Transwestern believes such costs will not have a material adverse effect on its financial position, results of operations or cash flows.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Air Quality Standards.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;In 2023, the United States Environmental Protection Agency (&amp;quot;EPA&amp;quot;) finalized its Good Neighbor Plan (the &amp;quot;Plan&amp;quot;) which seeks to reduce nitrogen oxide pollution from power plants and other industrial facilities from 23 upwind states which the EPA determined is contributing to National Ambient Air Quality Standards (&amp;quot;NAAQS&amp;quot;) nonattainment and interfering with maintenance of the 2015 ozone NAAQS in downwind states. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;As part of the Plan, the EPA announced that it would be issuing prescriptive emission standards for several sectors, including certain new and existing internal combustion engines of a certain size used in pipeline transportation of natural gas. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The EPA's final rule was to become effective on August 4, 2023, and the prescribed emission standards were scheduled to be effective in 2026. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;However, on March 12, 2025, the EPA announced plans to end the Plan. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Operators and industry groups have challenged the Plan in the District of Columbia Circuit (&amp;quot;D.C. Circuit&amp;quot;), as well as the legal predicates to the individual upwind states' inclusion in the Plan in the regional circuits. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The effectiveness of the rule is currently stayed in certain states within Energy Transfer's footprint, by nature of judicial stays of the legal predicate to the Plan, by judicial stay of the Plan itself by the United States Supreme Court (&amp;quot;U.S. Supreme Court&amp;quot;), or by the administrative stay issued by the EPA in October 2024. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;On June 18, 2025, the U.S. Supreme Court ruled that the regional circuits are the appropriate venue for the proceedings. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;On July 30, 2025, the United States Court of Appeals for the Tenth Circuit placed the case in abeyance pending the EPA's reconsideration of its disapproval of upwind states' state implementation plans addressing their Plan obligations. P&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;roceedings challenging the Plan in the D.C. Circuit were also placed in abeyance on May 2, 2025 pending the EPA's reconsideration of the Plan. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The EPA is preparing a proposed rulemaking as part of the reconsideration process, and on January 27, 2026, the EPA announced its proposal to approve state implementation plans for certain states, which would resolve those states' obligations under the Good Neighbor Plan. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern cannot predict with any certainty the substance of any later proposed rule or the potential impacts on Transwestern. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern currently estimates that the existing final rule would require retrofitting or replacement of certain of its engines used in its operations. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Compliance with the Plan (if implementation is not stayed or otherwise delayed) may require substantial capital expenditures which could adversely affect Transwestern's business in future periods. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;However, at this time, Transwestern is still assessing the potential costs of this rule and, given uncertainties resulting from the multiple legal challenges filed against the Plan in various states, in the D.C. Circuit and the U.S. Supreme Court, Transwestern cannot predict with any certainty what the final costs of compliance for the Plan for Transwestern ultimately may be.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Other Commitments and Contingencies&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Federal Pipeline Integrity Rules.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's pipeline operations are subject to regulation by the United States Department of Transportation, under the Pipeline Hazardous Materials Safety Administration (&amp;quot;PHMSA&amp;quot;), pursuant to which PHMSA has established requirements relating to the design, installation, testing, construction, operation, replacement and management of pipeline facilities.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Moreover, PHMSA, through the Office of Pipeline Safety, has promulgated a rule requiring pipeline operators to develop integrity management programs to comprehensively evaluate their pipelines, and take measures to protect pipeline segments located in what the rule refers to as &amp;quot;high consequence areas&amp;quot;.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Activities under these integrity management programs involve the performance of internal pipeline inspections, pressure testing, or other effective means to assess the integrity of these regulated pipeline segments, and the regulations require prompt action to address integrity issues raised by the assessment and analysis.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Integrity testing and assessment of all of these assets will continue, and the results of such testing and assessment could cause Transwestern to incur future capital and operating expenditures for repairs or upgrades deemed necessary to ensure the continued safe and reliable operation of Transwestern; however, no estimate can be made at this time of the likely range of such expenditures.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern's operations are also subject to the requirements of the Federal Occupational Safety and Health Act (&amp;quot;OSHA&amp;quot;) and comparable state laws that regulate the protection of the health and safety of employees.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;In addition, the Occupational Safety and Health Administrations' hazardous communication standard requires that information be maintained about hazardous materials used or produced in Transwestern's operations and that this information be provided to employees, state and local government authorities and citizens.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern believes that its past costs of OSHA required activities, including general industry standards, record keeping requirements and monitoring of occupational exposure to regulated substances have not had a material adverse effect on Transwestern's results of operation; however, there is no assurance that such costs will not be material in the future.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;NOTE I - REVENUE:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Contract Balances with Customers.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern satisfies its obligations by transferring goods or services in exchange for consideration from customers. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;The timing of performance may differ from the timing the associated consideration is paid to or received from the customer, thus resulting in the recognition of a contract asset or a contract liability.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;As of January 1, 2024, the opening balance of accounts receivable from contracts with customers was $28.6 million.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern recognizes a contract asset when making upfront consideration payments to certain customers or when providing services to customers prior to the time at which Transwestern is contractually allowed to bill for such services.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;As of December 31, 2025 and 2024, no contract assets have been recognized.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern recognizes a contract liability if the customer's payment of consideration precedes Transwestern's fulfillment of the performance obligations.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;As of December 31, 2025 and 2024, no contract liabilities have been recognized.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Performance Obligation.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;At contract inception, Transwestern assesses the goods and services promised in its contracts with customers and identifies a performance obligation for each promise to transfer a good or service (or bundle of goods or services) that is distinct. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;To identify the performance obligations, Transwestern c&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;onsiders all the goods or services promised in the contract, whether explicitly stated or implied based on customary business practices. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;For a contract that has more than one performance obligation, Transwestern allocates the total contract consideration it expects to be entitled to, to each distinct performance obligation based on a standalone-selling price basis.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;Revenue is recognized when (or as) the performance obligations are satisfied, that is, when the customer obtains control of the good or service.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;Certain of our contracts contain variable components, which, when combined with the fixed component are considered a single performance obligation.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="background-color: unset; font-size: 1em; text-align: inherit"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="background-color: unset; text-align: inherit; font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif; background-color: unset"&gt;For these types of contracts, only the fixed component of the contracts are included in the amount of revenue expected to be recognized on contracts with customers existing as of December 31, 2025.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;As of December 31, 2025, the aggregate amounts of transaction price allocated to unsatisfied (or partially satisfied) performance obligations are approximately $0.9 billion from 2026 through 2028 and $1.3 billion thereafter that Transwestern expects to recognize as revenue.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-align: center"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;Practical Expedients Utilized by Transwestern.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Transwestern elected the following practical expedients in accordance with ASC Topic 606:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;ul style="margin-bottom: 0; margin-left: 0.75in"&gt;&lt;li style="margin-top: 0; margin-right: 0; margin-bottom: 0; font-size: 12pt; font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;p&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;b&gt;&lt;span&gt;Right to invoice&lt;/span&gt;&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt; - Transwestern elected to utilize an output method to recognize revenue that is based on the amount to which Transwestern has a right to invoice a customer for services performed to date, if that amount corresponds directly with the value provided to the customer for the related performance or its obligation completed to date. &lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;As such, Transwestern recognized revenue in the amount to which it had the right to invoice customers.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul style="margin-bottom: 0; margin-left: 0.75in"&gt;&lt;li style="margin-top: 0; margin-right: 0; margin-bottom: 0; font-size: 12pt; font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;p&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;b&gt;&lt;span&gt;Significant financing component&lt;/span&gt;&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt; - Transwestern elected not to adjust the promised amount of consideration for the effects of significant financing component if Transwestern expects, at contract inception, that the period between the transfer of a promised good or service to a customer and when the customer pays for that good or service will be one year or less.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;ul style="margin-bottom: 0; margin-left: 0.75in"&gt;&lt;li style="margin-top: 0; margin-right: 0; margin-bottom: 0; font-size: 12pt; font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;p&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;b&gt;&lt;span&gt;Unearned variable consideration&lt;/span&gt;&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt; - Transwestern elected to only disclose the unearned fixed consideration associated with unsatisfied performance obligations related to Transwestern's various customer contracts which contain both fixed and variable components.&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Garamond&amp;quot;, serif; color: rgba(0, 0, 0, 1)"&gt;&lt;/p&gt;&lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Garamond&amp;quot;, serif; color: rgba(0, 0, 0, 1)"&gt;&lt;br /&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;NOTE J - SUPPLEMENTAL CASH FLOW INFORMATION:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;img src="data:image/gif;base64," class="e-rte-image e-imginline" width="674" height="182" style="min-width: 0; max-width: 1956px; min-height: 0" alt="" /&gt; &lt;/p&gt;&lt;p style="margin-top: 0; margin-bottom: 0"&gt;&lt;span style="font-size: 12pt"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-weight: bold"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: inherit"&gt;&lt;span style="text-align: inherit; background-color: unset; font-size: 1em"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-align: inherit; background-color: unset; font-size: 1em"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt; 		&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
