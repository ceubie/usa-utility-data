        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2722_lbl" order="0" xlink:to="ft-2722_47085_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2724_lbl" order="0" xlink:to="ft-2724_47345_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2729_lbl" order="0" xlink:to="ft-2729_47104_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3195_lbl" order="0" xlink:to="ft-3195_47259_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3212_lbl" order="0" xlink:to="ft-3212_47260_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3236_lbl" order="0" xlink:to="ft-3236_47261_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3441_lbl" order="0" xlink:to="ft-3441_47331_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3493_lbl" order="0" xlink:to="ft-3493_47410_lbl" />
        <link:footnote xlink:label="ft-170_46889_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource">Original value: N</link:footnote>
        <link:footnote xlink:label="ft-230_46885_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><b><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><em>Schedule Page: 278 Line No.: 1 Column: a</em></span></span></b><br /></p><div><p><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; display: inline !important; float: none">Pursuant to Article VIII, Section 1 of the Stipulation and Agreement of Settlement in Docket No. RP22-1031, as approved by Commission Order issued on June 30, 2023.</span></span></span></p><p><br /></p></div></div></link:footnote>
        <link:footnote xlink:label="ft-232_46886_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b><em>Schedule Page: 278 Line No.: 2 Column: a</em></b></span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p><p><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">Pursuant to Section 22.4 of the General Terms and Conditions of Transwestern's FERC Gas Tariff, Fifth Revised Volume No. 1, Docket No. RP26-368-000 filed on January 9, 2026</span>.</span><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none"><span> </span></span><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">The current annual penalty period is October 1, 2025 through September 30, 2026.</span></p><p><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-490_47046_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 350 Line No.: 1 Column: e</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Account 186, Miscellaneous deferred debits was used to record deferred charges for regulatory commission expense. This footnote applies to columns (e), (i) and (l) lines 1 and 2.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-517_46907_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 118 Line No.: 14 Column: c</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Transwestern Pipeline Company, LLC, as a limited liability company, records member's equity in Other Paid-In Capital.</span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Statement of Retained Earnings (unaudited).</span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-976_47022_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 520 Line No.: 20 Column: c</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">For the purposes of the Annual Charge Adjustment ("ACA") calculation, the throughput volume is 667,212,089 Dth as represented on line 20. No additional volumes are needed to calculate the volumes eligible for the ACA Surcharge.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br/></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1000_47346_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-style: normal; text-align: left; text-indent: 0; white-space: normal; font-family: Arial, Helvetica, sans-serif; font-size: 16px; background-color: rgba(255, 255, 255, 1)">Schedule Page: 520 Line No.: 29.1 Column: d</b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="487" height="126" alt="" style="vertical-align: bottom; border: 0; cursor: pointer; display: inline-block; float: none; margin: auto 5px; max-width: 1580px; position: relative; padding: 1px; color: rgba(0, 0, 0, 1) !important; min-width: 0; min-height: 0" /></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"> <br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-1018_47025_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 220 Line No.: 6 Column: e</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Transwestern utilizes the fixed asset method of accounting for system line pack.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1019_47026_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 220 Line No.: 7 Column: e</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Transwestern has no storage facilities, therefore account 117.4 is used to record operational fluctuations in line p</span></span></span><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">ack.<span> </span></span></span><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; text-decoration: inherit; display: inline !important">Transwestern uses the fixed asset method to account for gas owed to the system.</span></span></span></span></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; text-decoration: inherit; display: inline !important"><br /></span></span></span></span></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1042_47031_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><b style="font-weight: bold">Schedule Page: 313 Line No.: 1 Column: c</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">The volumes in columns (c) and (e) include Maximum Daily Quantities.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1047_47032_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><b style="font-weight: bold">Schedule Page: 521 Line No.: 7 Column: e</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">The allocation is derived by determining whether the reservation rate charged within the billing system is discounted, negotiated or recourse. This determination is applied to the retained fuel charged per contract scheduled path, and a pro rata allocation is derived and applied to all volumes and dollars.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1048_47033_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><b style="font-weight: bold">Schedule Page: 521 Line No.: 7 Column: f</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; text-decoration: inherit; display: inline !important">The basis for valuing the gas reported in columns (f), (g) and (h) is the Gas Daily monthly average index for San Juan Bondad, San Juan Non-Bondad and Transwestern Permian.</span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; text-decoration: inherit; display: inline !important"><br /></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2490_47067_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1580px; min-height: 0" alt="" /> </p><p> <br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-2491_47068_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1580px; min-height: 0" alt="" /> </p><p> <br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-2648_47074_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 336 Line No.: 10 Column: b</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">General plant is depreciated on a straight line basis per assigned FERC rates.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2654_47077_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 338 Line No.: 8 Column: c</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">General Plant has depreciation rates range from 4.35% to 16.67% approved by Commission Order issued June 30, 2023, in Docket No. RP22-1031-000 et al.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2655_47076_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 338 Line No.: 7 Column: c</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Transmission Plant has depreciation rates range from 2.01% to 2.22% approved by Commission Order issued June 30, 2023, in Docket No. RP22-1031-000 et al.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2656_47075_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 338 Line No.: 7 Column: b</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Depreciation Plant Basis reflects balance as of 12/31/2025. This footnote also applies to lines 8 and 9, column (b).</span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2659_47078_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 338 Line No.: 9 Column: c</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Intangible Plant has depreciation rates range from 6.67% to 33.33% approved by Commission Order issued June 30, 2023, in Docket No. RP22-1031-000 et al. For Intangible Plant supported by a contract, a separate amortization rate will be determined by dividing 100% by the initial life of the contract, stated in years; otherwise, the amortization rate will be as stated above.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2665_47080_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 514 Line No.: 6 Column: e</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Transwestern is the operator and owns an 83.4% ownership interest in the La Plata, Colorado facility. Northwest Pipeline retains a 16.6% ownership interest.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2667_47081_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 514 Line No.: 7 Column: e</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Transwestern is the operator and owns an 83.4% ownership interest in the La Plata, New Mexico facility. Northwest Pipeline retains a 16.6% ownership interest.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2669_47079_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 514 Line No.: 5 Column: e</b></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Transwestern is the operator and a co-owner of an undivided interest of 50% in the 37-mile Santan Lateral with El Paso Natural Gas Company, LLC.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2722_47085_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 219 Line No.: 17.1 Column: c</b></span></span></p><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="464" height="140" style="min-width: 0; max-width: 1410px; min-height: 0" alt="" /></p></div></link:footnote>
        <link:footnote xlink:label="ft-2724_47345_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 262 Line No.: 5 Column: i</b></span></span></p><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Other adjustments.</span></span></p><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2729_47104_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 217 Line No.: 1 Column: b</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Pursuant to Article VIII, Section 2, of the Stipulation and Agreement of Settlement in Docket No. RP15-23, Transwestern was authorized to roll the costs associated with the new River Compressor Station constructed under CP14-8 into the Phoenix Lateral incremental rates.</span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><br /></span></span></span></p></div></link:footnote>
