    <link:loc xlink:type="locator" xlink:href="#HH56C05747B78307B1666CD042E44B6564" xlink:label="HH56C05747B78307B1666CD042E44B6564" />
    <link:footnote xlink:type="resource" xlink:label="HH121776F1E8487D6461B800A5E002FE11" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 724px; height: 189px;" border="0" width="554" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt; width: 416pt;" width="554" height="20">Since we administer the recovery of gas used for fuel by means of a tracking mechanism with a&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">cash transaction-based make-up provision, no dollar values are assigned to the net excesses or&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">deficiencies which results from shipper supplied gas.&#160; The dollar values reported are for the sole&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">purpose of complying with this schedule.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH56C05747B78307B1666CD042E44B6564" xlink:to="HH121776F1E8487D6461B800A5E002FE11" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH619F68CC642ADE5177C1660EF32AC89A" xlink:label="HH619F68CC642ADE5177C1660EF32AC89A" />
    <link:footnote xlink:type="resource" xlink:label="HH0F7A7901474AC53C16F8AC1B8958F4BC" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 490pt;" border="0" width="652" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td class="xl440" style="height: 15.0pt; width: 416pt;" width="554" height="20">Schedule Page: 521&#160;&#160;&#160;&#160; Line No.: 18&#160;&#160;&#160;&#160; Column: s</td>
              <td style="width: 74pt;" width="98">&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">O&amp;M gas loss</td>
              <td class="xl441">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 937</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">M&amp;R Fuel</td>
              <td class="xl441">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 78</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">Heater Fuel</td>
              <td class="xl441">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 31</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">Warehouse fuel</td>
              <td class="xl442">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; <span style="text-decoration: underline;">6,266 </span></td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">&#160;&#160;&#160;&#160; Total</td>
              <td class="xl441">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 7,312</td>
