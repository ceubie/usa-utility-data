    <link:loc xlink:type="locator" xlink:href="#HH25BFB857E87D1CFD4E1B20877A7F6D4F" xlink:label="HH25BFB857E87D1CFD4E1B20877A7F6D4F" />
    <link:footnote xlink:type="resource" xlink:label="HH1EEA4E90A365DB0EC634365EA361C1BF" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Docket RP13-1350-000</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH25BFB857E87D1CFD4E1B20877A7F6D4F" xlink:to="HH1EEA4E90A365DB0EC634365EA361C1BF" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHAC63CC9A4C95A782B4FC7F5DE7DEB371" xlink:label="HHAC63CC9A4C95A782B4FC7F5DE7DEB371" />
    <link:footnote xlink:type="resource" xlink:label="HH2E11D54BDDF6DCE57AF2DFDE83288AB8" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>portion of the M&amp;N Phase I facilities which were placed into service on March 10, 1999. This regulatory asset arises from the deferral of operating costs incurred on the 83 miles of Phase I joint facilities with Portland Natural Gas Transmission System (PNGTS). The FERC allowed M&amp;N to defer the costs beginning from 12/1/99. The asset is being amortized at a rate of 2.2% over the life of the facilities.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAC63CC9A4C95A782B4FC7F5DE7DEB371" xlink:to="HH2E11D54BDDF6DCE57AF2DFDE83288AB8" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHAAFA1517026EB96D34A209A12BC03AC9" xlink:label="HHAAFA1517026EB96D34A209A12BC03AC9" />
    <link:footnote xlink:type="resource" xlink:label="HH3EFA2DE1B66B856FA1FCC01B00A67DD2" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Footnote-1</p>
        <p>Recorded pursuant to 18 CFR 154.402(a) and 18 CFR 382.202.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAAFA1517026EB96D34A209A12BC03AC9" xlink:to="HH3EFA2DE1B66B856FA1FCC01B00A67DD2" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH423EDA05AA7D4C648FBC2FF8CED9181F" xlink:label="HH423EDA05AA7D4C648FBC2FF8CED9181F" />
    <link:footnote xlink:type="resource" xlink:label="HH8FB48426DE9BFD85C27F32D76A200B16" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>created by the difference in the depreciation expense between the modified depreciation rate and the straight-line book depreciation rate in account 182.3. Accordingly, the March 12, 2003 Order in Docket No. RP02-134-000 approves the un-amortized regulatory asset remaining after this levelization period shall continue to be depreciated.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH423EDA05AA7D4C648FBC2FF8CED9181F" xlink:to="HH8FB48426DE9BFD85C27F32D76A200B16" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH92B61E2EC5B5A8F6AD9B15DEB5DB16F0" xlink:label="HH92B61E2EC5B5A8F6AD9B15DEB5DB16F0" />
    <link:footnote xlink:type="resource" xlink:label="HH4C3CF9158C082951287739387FDC4B01" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Docket No. AI93-5-001 issued on April 23, 1993 (Accounting for Income Taxes).</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH92B61E2EC5B5A8F6AD9B15DEB5DB16F0" xlink:to="HH4C3CF9158C082951287739387FDC4B01" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7633CD4E75A567054BBBE78A1D58F688" xlink:label="HH7633CD4E75A567054BBBE78A1D58F688" />
    <link:footnote xlink:type="resource" xlink:label="HHE21243235B703215145B00C34721C2BF" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 735px; height: 310px;" border="0" width="554" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt; width: 416pt;" width="554" height="20">Fuel quantities requiring an allocation are assigned to the rate categories on the basis of the&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">stated fuel rates as referenced in Order No. 710-C, at paragraph 9.&#160; Specifically, within each&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">functional category, the fuel quantities in lines 8 &#8211; 30 are prorated to the rate categories based on&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">the ratio of the Shipper Supplied quantities in lines 1 - 7 for each rate category to the total&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">Shipper Supplied quantity for such functional category.</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">Disposition of Excess Gas and Gas Acquired to Meet Deficiency quantities in lines 38 &#8211; 65 are&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">prorated to the rate categories based on the ratio of the Excess or Deficiency quantities for each&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">rate category to the total Excess or Deficiency quantity in line 37.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7633CD4E75A567054BBBE78A1D58F688" xlink:to="HHE21243235B703215145B00C34721C2BF" order="1" />
