  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:label="value3" xlink:href="#Tag135" />
    <link:loc xlink:type="locator" xlink:label="value4" xlink:href="#Tag203" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote3" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 11pt; font-family: Calibri; vertical-align: baseline;">Red River</xhtml:span>
          <xhtml:span style="font-size: 11pt; font-family: Calibri; vertical-align: baseline;"> Pipeline Company LLC has adopted the Association of Oil Pipelines Accounting Guideline 3-13, "Equity Reporting for Non-corporate Filers" (the "guideline"). The guideline suggests that any distributions in excess of the positive balance in unappropriated retained income should be recorded against additional paid-in capital. Current year distributions were $11,931,000 which exceeded unappropriated retained income by $4,080,780 as of March 31, 2026. Such excess was recorded against additional paid-in capital.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value3" xlink:to="footnote3" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="3" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote4" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 11pt; font-family: Calibri; vertical-align: baseline;">Red River</xhtml:span>
          <xhtml:span style="font-size: 11pt; font-family: Calibri; vertical-align: baseline;"> Pipeline Company LLC has adopted the Association of Oil Pipelines Accounting Guideline 3-13, "Equity Reporting for Non-corporate Filers" (the "guideline"). The guideline suggests that any distributions in excess of the positive balance in unappropriated retained income should be recorded against additional paid-in capital. Current year distributions were $11,931,000 which exceeded unappropriated retained income by $4,080,780 as of March 31, 2026. Such excess was recorded against additional paid-in capital.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value4" xlink:to="footnote4" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="4" />
  </link:footnoteLink>
