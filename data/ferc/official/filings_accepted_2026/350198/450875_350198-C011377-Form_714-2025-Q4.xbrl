  <ferc:OrderNumber id="HH5DDBBCC65F0A7CDCF8732B977EAE5B2C" contextRef="HH6B45DF1C52C43B4D88F1C0B0EFBC6D6E" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <ferc:OrderNumber id="HH7ABFD3FC826A08EF97077622CF3DAC70" contextRef="HH81BA027C13D4AF44A9BEDA0BCECC4CFB" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <ferc:OrderNumber id="HHFA7850E3B72397C67DCA4096B2530FB1" contextRef="HH0DF38D34C03CCE88D3D19CD2A5ABEF45" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH3DE680DE74A202320024CA88CCD8C6D9" xlink:label="HH3DE680DE74A202320024CA88CCD8C6D9" />
    <link:footnote xlink:type="resource" xlink:label="HHB483C6B7695D26B49661A48243A04494" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
There was a total of 4813 MW of actual interchancereceived between adjacent BAAs of which 1772 MW were for station service and 3041 MW for contingency reserves. The zero value entered is because none of the MWs were to meet native load. There is no load within the metered boundaries of this BA..</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH3DE680DE74A202320024CA88CCD8C6D9" xlink:to="HHB483C6B7695D26B49661A48243A04494" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH1A59B3EC3E66AE5EB428D996D4E006D7" xlink:label="HH1A59B3EC3E66AE5EB428D996D4E006D7" />
    <link:footnote xlink:type="resource" xlink:label="HH8C49BAA5579159E1F202AE08C8B8CDAD" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
This Balancing Authority has no load within its metered boundaries. Therefore, there is no Net Energy for Load to use as a point of reference to determine the available plant capacity at the hour of annual peak demand.</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH1A59B3EC3E66AE5EB428D996D4E006D7" xlink:to="HH8C49BAA5579159E1F202AE08C8B8CDAD" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHB425AC94FA93E89A89EACEB02D84E0FE" xlink:label="HHB425AC94FA93E89A89EACEB02D84E0FE" />
    <link:footnote xlink:type="resource" xlink:label="HHA295C0EF6AB97159A8099662A654E79F" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
This Balancing Authority has no load within its metered boundaries. Therefore, there is no Net Energy for Load to use as a point of reference to determine the integrated net load on plant at the hour of annual peak demand.</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB425AC94FA93E89A89EACEB02D84E0FE" xlink:to="HHA295C0EF6AB97159A8099662A654E79F" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHD048EF4F0A088EFD19E93C2E6345269A" xlink:label="HHD048EF4F0A088EFD19E93C2E6345269A" />
    <link:footnote xlink:type="resource" xlink:label="HH1EB60E69BBF5DB2D79782ED3643297F6" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
This Balancing Authority has no load within its metered boundaries. Therefore, there is no Net Energy for Load to use as a point of reference to determine the net capability from plant at the time of monthly peak demand. This same footnote applies to all months in the year.</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHD048EF4F0A088EFD19E93C2E6345269A" xlink:to="HH1EB60E69BBF5DB2D79782ED3643297F6" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH4540BA7DD620D47C8A331FF207E9A208" xlink:label="HH4540BA7DD620D47C8A331FF207E9A208" />
    <link:footnote xlink:type="resource" xlink:label="HH2E7B54C6B07B2B856C5D9B9E8BD114F4" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
