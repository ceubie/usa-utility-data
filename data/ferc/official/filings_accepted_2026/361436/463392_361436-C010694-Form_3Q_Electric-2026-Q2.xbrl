  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C010694</ferc:CompanyIdentifier>
  <ferc:ReportYearPeriod id="HH6439FA2135BC4FC31DA52CEDA67ED097" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026/Q2</ferc:ReportYearPeriod>
  <ferc:ReportYear id="HH660FC444EE17A785BFF22BCDC6434313" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4" decimals="0" unitRef="HHferc_us_Pure">2026</ferc:ReportYear>
  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q2</ferc:ReportPeriod>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-08-31</ferc:ReportDate>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock id="HHD2B1DFDF71C7477E84AEA1D4D780024C" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;1. The following occurred during Q2 2026:&amp;#160;&amp;#160;&lt;/p&gt;
&lt;p&gt;LS Power Grid California obtained franchise rights from the Cities of San Jose and Fremont related to transmission line rights of way for underground transmission projects under construction. No consideration was paid to acquire the franchise rights.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock>
  <ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock id="HH9BC0EFBCB25FD35BD21CC5095A000F66" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;2. None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock>
  <ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock id="HHB507706EE223692FB3CE9DE4D62FC621" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;3. None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock>
  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="HH1C967D5CB7055C23C61684D3A8ADDA65" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;4. None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
  <ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock id="HH3753C2D0F64441EEC1CB77241E2239DC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;5. The following occurred during Q2 2026:&amp;#160;&amp;#160;&lt;/p&gt;
&lt;p&gt;LS Power Grid California's Fern Road Substation, located in Shasta County, was partially energized on June 12, 2026.&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock>
  <ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock id="HH2FB9527C1D4BB25D79F1C0C76F5BC95D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;6. The following occurred during Q2 2026:&amp;#160;&lt;/p&gt;
&lt;p&gt;LS Power Grid California, LLC borrowed $43 million from its term loan facility authorized in FERC Docket No. ES24-38&lt;/p&gt;
&lt;p&gt;LS Power Grid California, LLC borrowed $1.8 million from the revolving credit facility authorized in FERC Docket No. ES22-14.&lt;/p&gt;
&lt;p&gt;LS Power Grid California, LLC refinanced its $50 million revolving credit facility and upsized its $600 million term loan facility to a $1.5 billion term loan facility authorized in FERC Docket No. ES24-38. As part of the refinancing, the outstanding borrowings of $372.5 million were transferred to the new lender group through an assignment and assumption agreement.&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock>
  <ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock id="HHDB4E63D65FD21AE5462A8FBA840EA717" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;7. None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock>
  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="HHEBA1CD44839C108D1DAFD6DE3427BE45" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;8. None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock>
  <ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock id="HH22FBAEA0509E80B804A4341B1670898A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;9. The following occurred during Q2 2026:&amp;#160;&lt;/p&gt;
&lt;p&gt;LS Power Grid Cal., LLC, 195 FERC &amp;#182; 61,085 (2026) (authorizing abandoned plant incentive and accepting ministerial tariff revisions).&lt;/p&gt;
&lt;p&gt;&amp;#160;&lt;/p&gt;
&lt;p&gt;Request for Approval of Transmission Incentive Rates, LS Power Grid California, LLC, Docket No. ER26-2665 (filed May 28, 2026) (requesting approval of abandoned plant and hypothetical capital structure incentives under FPA section 219).&lt;/p&gt;
&lt;p&gt;&amp;#160;&lt;/p&gt;
&lt;p&gt;Application Under Section 204 of the Federal Power Act for Authorization to Issue Securities, LS Power Grid California, LLC, Docket No. ES26-51 (filed May 27, 2026) (applying for authorization to issue securities under FPA section 204).&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock>
  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="HH582A4E700260C05D782FA2D6F218758A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;10. Not Applicable&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
  <ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock id="HHFB056E8F64ABA7B86B31B31B7725CE20" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;12. Not Applicable&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;13. The following occurred during Q2 2026:&amp;#160;&lt;/p&gt;
&lt;p&gt;Joseph Esteves removed as Executive Vice President;&amp;#160;&lt;/p&gt;
&lt;p&gt;Darren Thomas appointed Managing Director;&lt;/p&gt;
&lt;p&gt;Rebecca Beckham appointed Vice President &amp;amp; Controller.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock id="HHD790CCB2EDB33AB49E3957CEAFD4E7D7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;14. Not Applicable&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;p style="margin-top: 3.7pt; margin-left: 6pt; margin-bottom: 0pt; text-align: center; line-height: 12.45pt; widows: 0; orphans: 0;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;LS POWER GRID CALIFORNIA&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;, LLC&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 3.7pt; margin-left: 6pt; margin-bottom: 0pt; text-align: center; line-height: 12.45pt; widows: 0; orphans: 0;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;NOTES TO FINANCIAL STATEMENTS&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;(1)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Organization&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt; and Basis of Presentation&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 40.5pt; margin-bottom: 7pt; text-indent: -31.5pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;(a)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;Organization&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 10pt; text-align: justify; line-height: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;California Transmission Development, LLC (California Transmission) was formed on August 15, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;2008&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; as a Delaware limited liability company. The name of California Transmission was amended to LS Power Grid California, LLC (the Company) on February 28, 2019.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; The Company is owned by LS Power Grid California Holdings, LLC (California Holdings). &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 10pt; text-align: justify; line-height: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;The Company was formed to develop, own, and operate transmission projects in the area operated by the California Independent System Operator Corporation (CAISO).&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; In January 2020, CAISO designated the Company as the approved project sponsor for the Gates Dynamic Reactive Support (DRS) Project (Gates Project) and in February 2020, CAISO designated the Company as the approved project sponsor for the Round Mountain Area DRS Project (RM Project). The Gates Project is a 500 kV dynamic reactive power support substation, to be known as Orchard Substation, which includes an approximately 850 MVAR (megavolt&amp;#8211;ampere, reactive) static synchronous compensator (STATCOM) device to be installed in two equally-sized blocks independently connected to the Pacific Gas and Electric Company (PG&amp;amp;E) Gates substation. The RM Project is a 500 kV dynamic reactive power support substation, to be known as Fern Road Substation, which includes an approximately 530 MVAR STATCOM to be installed in two &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;equally-sized&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; blocks independently connected to each of the existing PG&amp;amp;E Round Mountain to Table Mountain 500 kV transmission lines at the new Fern Road Substation located south of PG&amp;amp;E&amp;#8217;s Round Mountain substation. The Gates &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;Project was placed into service on March 12, 2025. &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;One portion of the RM Project was placed in service in June &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;2026&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; and the remaining portion is expected to be placed into service in Q3 2026.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; line-height: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;In January 2023, the Company was selected by CAISO to construct two new transmission projects, Manning (Manning Project) and Collinsville (Collinsville Project). &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;The &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;Manning&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; Project&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; will &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;be located in&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; Fresno County with a 500/230 kV substation and an approximately 1&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;2&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;-mile double circuit 230 kV transmission line.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;The &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;Collinsville&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; Project&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; will &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;be located in&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; Solano County and Contra Costa County with a 500/230 kV substation and an approximately 6-mile double circuit 230 kV transmission line including a submarine crossing of the Sacramento River.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;Each&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; project &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;is&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;expected&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; to be in-service &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;in&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; 20&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;28. Additionally, in 2025, CAISO approved a new 500 kV transmission line from Manning to Metcalf (Manning to Metcalf Project). As the incumbent owner of the Manning substation, the Company will be responsible for installing a new 500 kV line terminal position and transmission line segment from the Manning substation to a point near the Company&amp;#8217;s property boundary. This project is expected to be in service in 2034.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 10pt; text-align: justify; line-height: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;In March 2023, the Company was selected by CAISO to build, own, and operate two new High-Voltage Direct Current (HVDC) transmission projects in the San Jose area (Metcalf-San Jose B (the Metcalf Project) and Newark-Northern Receiving Station (the Newark Project)). In November 2024, CAISO adjusted the scope of these projects to better meet growing demand forecasts. With those adjustments, the Newark Project is now a 230 kV transmission line which is approximately 12 miles long and predominately underground. The Metcalf Project includes two new HVDC terminals and approximately 13 miles of predominantly underground transmission lines. Each project is expected to be in-service in 2028.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; line-height: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;In June 2024, CAISO approved two new 500 kV transmission lines from New Humboldt to Fern Road and from New Humboldt to Collinsville. As the incumbent transmission owner of the Fern Road and Collinsville substations, the Company will be responsible for installing a new 500 kV line terminal position and transmission line segment from the substations to a point near the Company&amp;#8217;s property boundary at Fern Road and Collinsville. Each project is expected to be in service in 2034.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; line-height: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;In April 2026, the Company was selected by CAISO as the approved project sponsor of a new 230 kV transmission line from the Northern Receiving Station to the San Jose B substation (the NRS &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;Project). The NRS Project is anticipated to be approximately 7 miles long and predominantly underground. The expected &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;in service&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; date &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;is in&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; 2030.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -45.7pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;(b)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;Basis of Presentation&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#8217;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;s financial statements and accompanying notes &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;were&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;prepared&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;in&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accordance&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;with&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;the&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accounting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;requirements&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of the Federal Energy Regulatory Commission (FERC) as set forth in its applicable Uniform System of Accounts&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.9pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;and&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.8pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;published&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.95pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accounting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.8pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;releases,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.9pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;which&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.85pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;is&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.8pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;a&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.9pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;comprehensive&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.9pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;basis&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.85pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.8pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accounting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.85pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;other&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: 0.95pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;than U.S.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;generally&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.6pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accepted&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accounting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.6pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;principles&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;(U.S. GAAP).&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.75pt 6pt 31.5pt; text-align: justify; line-height: 108%; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The primary differences between the Company's FERC financial statements and U.S. GAAP financial statements are:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0.05pt 12.8pt 0pt 54pt; text-indent: -18pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;a)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Accumulated&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;costs&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;removal&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;are&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;reported&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;in&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.5pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;accumulated&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;depreciation&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;for&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;FERC&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.6pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;reporting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;purposes (U.S. GAAP requires that cost of removal be classified as a regulatory&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;liability);&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.95pt 0pt 54pt; text-indent: -18pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;b)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;There is no current liability classification of the current portion of long-term debt; and deferred financing costs are reported separately in the FERC balance&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.8pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;sheet;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.9pt 0pt 54pt; text-indent: -18pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;c)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The presentation of regulatory assets and regulatory liabilities in the balance sheet under U.S. GAAP requirements differs from FERC requirements;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.9pt 0pt 54pt; text-indent: -18pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;d)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The inclusion of income taxes as a component of the FERC financial statements pursuant to the FERC&amp;#8217;s Policy Statement on Income Tax Allowances, rather than the exclusion of income taxes pursuant to U.S. GAAP due to the Company&amp;#8217;s treatment as a flow through entity; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;and&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.8pt 0pt 54pt; text-indent: -18pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;e)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;A portion of Member&amp;#8217;s equity for U.S. GAAP reporting purposes is included in Accumulated Deferred Income Taxes for FERC reporting purposes. However, the Members pay income taxes on their allocated share of the Company&amp;#8217;s income and for purposes herein, those taxes are calculated using the federal corporate&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;rate.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 12.8pt 0pt 54pt; text-align: justify; line-height: 108%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 31.5pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;These financial statements and notes reflect the Company&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#8217;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;s evaluation of events occurring &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;subsequent to&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; the accompanying balance sheet dates &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;through &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;August 31, 2026,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; the&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; date the Company filed this report with FERC.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;(2)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Regulatory Matters&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company has received FERC approval to use a company-specific, forward-looking or projected &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;formula rate&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; framework in setting its transmission rates which are collected by CAISO on the Company&amp;#8217;s behalf. These projected rates are updated annually with forecasted information. Two reconciliations occur annually. The first, a true-up adjustment of the formula rate, calculates the revenue requirement for the prior rate year using actual data. The second, a TRBA adjustment, calculates the difference between revenues due under the effective formula rate and actual revenues received during the trailing October to September period. Both adjustments are incorporated into the projected rates in a subsequent year.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -45.7pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;(a)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;Formula Rate Items&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;On April 15, 2026, in FERC Docket No. ER26-2236, the Company submitted an informational filing, including the 2026 projection. &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;On May 1, 2026, in FERC Docket No. ER26-1588, the Commission granted the Company&amp;#8217;s incentive request to recover 100% of the prudently incurred costs associated with the investment in &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;the Manning Substation Expansion Project if the project is abandoned or canceled for reasons beyond the Company&amp;#8217;s control. &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27pt; margin-bottom: 10pt; text-align: justify; line-height: 108%; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;On May 27, 2026, in FERC Docket No. ES26-51, the Company &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;submitted an application&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; requesting authorization to issue new long-term debt securities in an amount not to exceed $1.975 billion. On July 17, 2026, the Commission issued an order authorizing the issuance of debt. &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;On May 28, 2026, in FERC Docket No. ER26-2665, the Company &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;submitted an application&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; requesting authorization to recover 100% of the prudently incurred costs associated with the investment in the NRS Project if the project is abandoned or canceled for reasons beyond the control of the Company. On July 27, 2026, the Commission issued an order granting the Company&amp;#8217;s request. &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;(3)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Property, Equipment, and Construction in progress&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;On June 12, 2026, the Company completed commissioning of the gas-insulated switching station portion of the Fern Road substation, and these assets in the RM Project were placed in service. The STATCOM portion of the Fern Road substation is expected to be completed in Q3 2026 and placed in service at that time. &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;(4)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Contracts and Commitments&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;(a)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;Engineering, Procurement and Other Construction Agreements&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;In addition to contracts previously executed, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;the Company and a third party entered into a conductor supply agreement for the Manning Project&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; in March 2026&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;. The third party will be responsible for the design, fabrication, delivery, and testing of the conductor for the double circuit transmission line. &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 10pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Additionally, the Company and a separate third party entered into a Turnkey Procurement and Construction agreement for the Collinsville Project in July 2026. The third party will be responsible for delivery and installation of the submarine cable.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;(5)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Financing Arrangements&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -45.7pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;(a)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;Credit Agreement&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;On June 30, 2026, the Company entered into a third amendment to its existing credit agreement. With the new amendment, the credit agreement provides for a total term loan facility of $1.58 billion and a total revolving facility of $55.0 million (New Facility). The New Facility is comprised of the following:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 63pt; margin-bottom: 10pt; text-indent: -27pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160; &amp;#160; &amp;#160;(i)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Initial Facility- original term loan of $81.0 million and revolving facility of $5.0 million for the initial facilities.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 63pt; margin-bottom: 10pt; text-indent: -27pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160; &amp;#160; &amp;#160;(ii)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt; &amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Upsized Facility- new term loan of $1.50 billion and revolving facility of $50.0 million for the upsized facilities.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company also entered into an associated Agent Replacement Agreement to assign a new administrative agent, and the Company entered into associated Master/Subsequent Assignment and Assumption Agreements to assign certain loans and commitments to new/replacement lenders and issuing banks. On June 30, 2026, the Company borrowed $372.5 million under the New Facility to repay existing debt under the credit agreement &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;as six new lenders replaced five of the original facility&amp;#8217;s eight term loan lenders and one revolving facility lender did not continue under the New Facility.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&amp;#160;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company incurred debt issuance costs of $17.9 million. These costs are presented as Unamortized Debt Expense. The unamortized debt issuance costs associated with the old lenders, totaling $3.6 million, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;is&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; presented as Unamortized Loss on Reacquired Debt.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&amp;#160;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;As of June 30, 2026, total borrowings outstanding under the term loan and revolving facility totaled $453.5 million and $1.8 million, respectively.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&amp;#160;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;For the Initial Facility, the credit agreement continues to specify a maturity date as the earlier of the twelfth anniversary of the commercial operation date or the fifteenth anniversary of the closing date. For the Upsized Facility, the credit agreement specifies a maturity date as the earlier of (a) eighteen months from the first date on which all projects have achieved completion and (b) five years from the upsizing closing date.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -45.7pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;(b)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic;"&gt;Holdco Credit Agreement&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;On June 30, 2026, the Company repaid all outstanding borrowings, totaling $372.5 million, under the Holdco Credit Agreement.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;(6)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;Member&amp;#8217;s&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt; Equity&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 27.35pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Profit&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, losses and distributions are allocated in accordance with the provisions of the Company&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#8217;s limited l&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;iability agreement.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; In&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; 202&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;6&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, the Company received contributions from the Member of $&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;39.2 &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;million&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
