&lt;td style="width: 79.5pt; border-top-style: solid; border-top-width: 1pt; border-bottom-style: double; border-bottom-width: 3pt; padding-right: 0.75pt; vertical-align: bottom; background-color: #ffffff;"&gt;
&lt;p style="margin-top: 2.75pt; margin-bottom: 1.5pt; text-align: right; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri;"&gt;$&lt;/span&gt;&lt;span style="width: 54.54pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 59.1pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri;"&gt;(0.2)&lt;/span&gt;&lt;/p&gt;
