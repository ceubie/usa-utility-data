&lt;p style="margin-top: 2.75pt; margin-bottom: 1.5pt; text-align: right; font-size: 9pt;"&gt;&lt;span style="width: 0.05pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 0.05pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri;"&gt;15.2&lt;/span&gt;&lt;span style="width: 2.79pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 18.8pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri;"&gt;%&lt;/span&gt;&lt;/p&gt;
