    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHA3023F087857A07618749306E554C66E" xlink:to="HH7C7D9030A921A77F790B52EE1C640429" order="1" />
