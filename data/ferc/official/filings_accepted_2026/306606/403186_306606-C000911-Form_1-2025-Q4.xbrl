							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial; font-weight:bold"&gt;For the Twelve Months Ended December 31,&lt;/span&gt;&#xD;
