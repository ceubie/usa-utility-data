    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF03832CDCD582DA45D5682D0823DE572" xlink:to="HH04E879BC99E0766BC4B1C83F3B3A42E0" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7C6A1E060B470C92EA58AE74D77D863D" xlink:label="HH7C6A1E060B470C92EA58AE74D77D863D" />
    <link:footnote xlink:type="resource" xlink:label="HH920CB6B5DA8606C9B0A8C966268D8EE2" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">
          <strong>
            <span style="font-size: 11.0pt; line-height: 115%;">AGC </span>
          </strong>
          <span style="font-size: 11.0pt; line-height: 115%;">is included in the consolidated federal income tax return filed by <strong>FirstEnergy Corp.</strong>&#160;and is party to an intercompany income tax allocation agreement among the consolidated group members pursuant to which consolidated tax liability is allocated in accordance with IRC Section 1552 and Treasury Regulations 1.1502-33(d)(3) and 1.1552-1(a)(2).&#160; Each member&#8217;s federal income tax liability is determined as if such member filed a separate tax return and such tax is paid to the parent of the group.&#160; Members generating losses or credits are compensated by the parent in proportion to the amount of such member&#8217;s losses or credits used by other members of the consolidated group.&#160; In accordance with federal tax normalization rules, and for ratemaking purposes only, certain net operating loss carryforwards may be shown on a separate return basis without regard to any utilization by the consolidated income tax group.&#160; &#160;&#160;</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7C6A1E060B470C92EA58AE74D77D863D" xlink:to="HH920CB6B5DA8606C9B0A8C966268D8EE2" order="1" />
  </link:footnoteLink>
