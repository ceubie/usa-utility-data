  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">Cheniere Energy Partners, L.P is jointly owned between Cheniere Energy, Inc 50.6% (comprised of 48.6% LP interest through Cheniere Energy Partners LP Holdings, LLC and 2% through Cheniere Energy Partners GP, LLC) and 41.4% by Blackstone &amp; Brookfield, and 8% by Public Unitholders.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">Cheniere Energy Investments, LLC, a limited partner interest, owns 100% of Cheniere Creole Trail Pipeline and is exposed to the credit, operational, and other risks of the Partnership.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-3" id="fn-3" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">Cheniere Pipeline GP Interests, LLC has no direct exposure to risks through its 0% general partner interest.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-4" id="fn-4" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">Cheniere Energy, Inc. owns 50.6% comprised of 48.6% LP interest through Cheniere Energy Partners LP Holdings, LLC and 2% through Cheniere Energy Partners GP LLC.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-5" id="fn-5" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">Balance includes $15,717,629 of advances to an associated company.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-6" id="fn-6" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">Balance includes $2,086,639 of advances to an associated company.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-7" id="fn-7" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Balance includes $165,684 with an associated company.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-8" id="fn-8" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
