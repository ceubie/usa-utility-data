    <link:footnoteArc xlink:type="arc" xlink:from="value69" xlink:to="footnote69" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="69" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote70" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Amounts charged are based on Kinder Morgan, Inc.'s other compensation and benefit expenses and are allocated to us based on the distribution of direct labor charges (excluding overtime and special pay).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value70" xlink:to="footnote70" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="70" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote71" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Amounts charged by Kinder Morgan, Inc. through shared services are allocated using the modified Massachusetts Formula.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value71" xlink:to="footnote71" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="71" />
