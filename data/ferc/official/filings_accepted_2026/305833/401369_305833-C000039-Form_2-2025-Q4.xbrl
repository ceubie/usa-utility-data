&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; line-height: 18.4pt;"&gt;&lt;font style="font-family: Arial; font-size: 16pt; font-weight: bold;"&gt;Year Ended December 31,&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
