      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">Line 12 consists of decreases in tank inventory (gas used/not stored).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value47" xlink:to="footnote47" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="47" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote48" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 24px;">Line 12 consists of decreases in tank inventory (gas used/not stored).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value48" xlink:to="footnote48" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="48" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote49" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Line 13 represents storage fuel.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value49" xlink:to="footnote49" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="49" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote50" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Line 13 represents storage fuel.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value50" xlink:to="footnote50" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="50" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote51" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">34,007,278 Dth included in Deliveries of Contract Storage Gas (Account 489.4), line 22 was not billed to customers and is not subject to ACA surcharge.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value51" xlink:to="footnote51" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="51" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote52" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Line 27 consists of increases in tank inventory (gas stored/not used).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value52" xlink:to="footnote52" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="52" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote53" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify;">
          <xhtml:span style="font-size: 18pt; line-height: 107%; font-family: arial, helvetica, sans-serif;">The value of this gas is based on the current month cash-out price provided for in our tariff. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value53" xlink:to="footnote53" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="53" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote54" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Normal" style="text-align: justify;">
          <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">We use a non-revenue recognition method for shipper-supplied gas which results in accounting entries for net fuel over or under-collected rather than separate revenue entries for shipper-supplied gas used in plant operations. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value54" xlink:to="footnote54" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="54" />
