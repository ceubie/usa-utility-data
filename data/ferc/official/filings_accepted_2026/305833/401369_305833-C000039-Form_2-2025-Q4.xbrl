    <link:footnoteArc xlink:type="arc" xlink:from="value56" xlink:to="footnote56" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="56" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote61" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Our methodology for allocating costs to incremental facilities in a Section 4 filing may differ from that displayed here. This footnote applies to line 1 and line 2, columns (f), (g), (h), and (j).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value61" xlink:to="footnote61" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="61" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote62" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA; mso-bidi-font-weight: bold;">See Page 122.1, Notes to Financial Statements, Note 7 "Contract Prepayment" for further information.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value62" xlink:to="footnote62" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="62" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote63" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">As of December 31, 2024, we estimate that the following deferred tax balance in Account 190 could be used in the development of jurisdictional recourse rates:</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
        </xhtml:p>
        <xhtml:table class="MsoTableGrid" style="width: 16.0in; border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" width="1536" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; mso-yfti-lastrow: yes; height: .3in;">
