: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="35" valign="bottom" style="width: 26pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 15.8pt; font-family: Arial, Helvetica, sans-serif; font-size: small"&gt;   &lt;p style="margin: 0; font-size: small; font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-size: small; font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="134" valign="bottom" style="width: 100.75pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 15.8pt; font-family: Arial, Helvetica, sans-serif; font-size: small"&gt;   &lt;p style="margin: 0; font-size: small; font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-size: small; font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="19" valign="bottom" style="width: 14.45pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 15.8pt; font-family: Arial, Helvetica, sans-serif; font-size: small"&gt;   &lt;p style="margin: 0; font-size: small; font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-size: small; font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="132" valign="bottom" style="width: 98.7pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 15.8pt; font-family: Arial, Helvetica, sans-serif; font-size: small"&gt;   &lt;p style="margin: 0; font-size: small; font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="font-size: small; font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="23" valign="bottom" style="width: 16.9pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 15.8pt; font-family: Arial, Helvetica, sans-serif; font-size: 