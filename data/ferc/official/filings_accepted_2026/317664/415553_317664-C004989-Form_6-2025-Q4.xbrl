    <link:footnote xlink:type="resource" xlink:label="HHB9180104FB7F326C5AE2A6DB00517019" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 9pt; font-weight: 400; line-height: 98%;">Management believes that the information on this page has been prepared consistent with the Commission's Opinion 154-B methodology. This presentation on page 700 is not necessarily in the form in which it would appear in connection with a challenge to a particular rate, or rates, and is therefore not intended to be binding in any specific rate litigation.</span>
        </div>
        <div>&#160;</div>
        <div>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 9pt; font-weight: bold; line-height: 112%;">Notes</span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 9pt; font-style: italic; font-weight: 400; line-height: 112%;">:</span>
        </div>
        <div>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 9pt; font-weight: 400; line-height: 115%;">Pursuant to the Commission&#8217;s Remedial Order, issued on November 20, 2025, in Docket No. RM25-2-000, Total Interstate Operating Revenues include amounts recoverable during the Locked-In-Period from March 1, 2022, to September 17, 2024.</span>
        </div>
        <div>&#160;</div>
        <div>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 9pt; font-weight: 400; line-height: 115%;">Totals may not sum due to rounding.</span>
        </div>
      </div>
    </link:footnote>
