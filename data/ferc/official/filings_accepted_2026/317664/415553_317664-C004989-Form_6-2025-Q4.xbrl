				&lt;span style="font-family:Arial"&gt;3) N/A&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-indent:-18pt; padding-left:18pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;4) &lt;/span&gt;&lt;span style="font-family:Arial"&gt;N/A&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-indent:-18pt; padding-left:18pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;5) N/A&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:12pt; margin-bottom:12pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
