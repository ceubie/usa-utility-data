			&lt;p style="margin-top:0pt; margin-bottom:0pt; padding-right:18pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;Use this space to paste or type in any Important Changes During the Quarter&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:2pt; margin-bottom:0pt; padding-right:18pt; font-size:12pt"&gt;&#xD;
