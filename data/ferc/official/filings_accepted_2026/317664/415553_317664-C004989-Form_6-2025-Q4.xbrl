				&lt;span style="font-family:Arial"&gt;1)&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;N/A&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-indent:-18pt; padding-left:18pt; font-size:10pt"&gt;&#xD;
