    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH1D893ADDC5410898C07C3750E61416FF" xlink:to="HHA6FC66AEC2B4A5858FA0A02E927D4F27" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHAE37AA9D7011DAD2BEC298FC11B232EB" xlink:label="HHAE37AA9D7011DAD2BEC298FC11B232EB" />
    <link:footnote xlink:type="resource" xlink:label="HH6180EF43996AAF39A2E03D83268474A8" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <p>All system balancing gas recorded under the fixed asset method as defined by FERC Order 581. System gas volumes needed for load balancing, no notice transportation and other operational purposes is recorded in account 117.2 (current portion). For purposes of accounting for encroachment resulting from line inventory changes, we used Account 117.4 with appropriate debits to Account 808.1 and credits to Account 808.2.</p>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAE37AA9D7011DAD2BEC298FC11B232EB" xlink:to="HH6180EF43996AAF39A2E03D83268474A8" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH3C03590C2F8A7A830887D512E1EBF4E6" xlink:label="HH3C03590C2F8A7A830887D512E1EBF4E6" />
    <link:footnote xlink:type="resource" xlink:label="HH51D6962D2E0E41081326CDDBB89CF64D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <p>
            <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">Recorded pursuant to 18 CFR 154.402(a) and 18 CFR 382.202.</span>
          </p>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH3C03590C2F8A7A830887D512E1EBF4E6" xlink:to="HH51D6962D2E0E41081326CDDBB89CF64D" order="1" />
