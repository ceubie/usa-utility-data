&lt;p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal; vertical-align: baseline;" align="right"&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: 'Times New Roman'; mso-font-kerning: 0pt; mso-ligatures: none;"&gt;&amp;#160;2024&amp;#160;&amp;#160;&lt;/span&gt;&lt;/p&gt;
