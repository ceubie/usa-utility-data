            <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">Commission,</span>
            <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
            <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">these</span>
