    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH8D63349AE4B60A24D78B727CAD9B7382" xlink:to="HHF416B639007F095DDE106E195894D38F" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHD64029E62CA3E977514F25742F92099A" xlink:label="HHD64029E62CA3E977514F25742F92099A" />
    <link:footnote xlink:type="resource" xlink:label="HH7011898B0F2146A05DF2709FF0DAA632" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Docket RP13-1350-000</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHD64029E62CA3E977514F25742F92099A" xlink:to="HH7011898B0F2146A05DF2709FF0DAA632" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7633CD4E75A567054BBBE78A1D58F688" xlink:label="HH7633CD4E75A567054BBBE78A1D58F688" />
    <link:footnote xlink:type="resource" xlink:label="HHDD57831B4DB47FA5A7FE292C06ED3EE8" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">Fuel quantities requiring an allocation are assigned to the rate categories on the basis of the&#160; stated fuel rates as referenced in Order No. 710-C, at paragraph 9.&#160; Specifically, within each&#160; functional category, the fuel quantities in lines 8 &#8211; 30 are prorated to the rate categories based on&#160; the ratio of the Shipper Supplied quantities in lines 1 - 7 for each rate category to the total&#160; Shipper Supplied quantity for such functional category. &#160; Disposition of Excess Gas and Gas Acquired to Meet Deficiency quantities in lines 38 &#8211; 65 are&#160; prorated to the rate categories based on the ratio of the Excess or Deficiency quantities for each&#160; rate category to the total Excess or Deficiency quantity in line 37.</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7633CD4E75A567054BBBE78A1D58F688" xlink:to="HHDD57831B4DB47FA5A7FE292C06ED3EE8" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH58E6DCC3A40C8EEDD2CC6703D210561B" xlink:label="HH58E6DCC3A40C8EEDD2CC6703D210561B" />
    <link:footnote xlink:type="resource" xlink:label="HH0C1BAA86071295DCB14EF46A9375A8E8" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">O&amp;M gas loss &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 145 M&amp;R Fuel &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 55 Heater Fuel &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 23 Warehouse fuel &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 4,310 &#160;&#160;&#160;&#160; Total &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 4,533</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH58E6DCC3A40C8EEDD2CC6703D210561B" xlink:to="HH0C1BAA86071295DCB14EF46A9375A8E8" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH56C05747B78307B1666CD042E44B6564" xlink:label="HH56C05747B78307B1666CD042E44B6564" />
    <link:footnote xlink:type="resource" xlink:label="HHD177CDBF2F2745EA9D638D24BF5015EC" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">Since we administer the recovery of gas used for fuel by means of a tracking mechanism with a&#160; cash transaction-based make-up provision, no dollar values are assigned to the net excesses or&#160; deficiencies which results from shipper supplied gas.&#160; The dollar values reported are for the sole&#160; purpose of complying with this schedule.</div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH56C05747B78307B1666CD042E44B6564" xlink:to="HHD177CDBF2F2745EA9D638D24BF5015EC" order="1" />
