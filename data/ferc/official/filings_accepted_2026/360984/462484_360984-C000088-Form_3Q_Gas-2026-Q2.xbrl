    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHDE51493AC7D5EE350C22CB2EABE6CE96" xlink:to="HH59F478F1B27860794B5DABD712D24310" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH8D63349AE4B60A24D78B727CAD9B7382" xlink:label="HH8D63349AE4B60A24D78B727CAD9B7382" />
    <link:footnote xlink:type="resource" xlink:label="HHF416B639007F095DDE106E195894D38F" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 416pt;" border="0" width="554" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt; width: 416pt;" width="554" height="20">Since we administer the recovery of gas used for fuel by means of a tracking mechanism with a&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">cash transaction-based make-up provision, no dollar values are assigned to the net excesses or&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">deficiencies which results from shipper supplied gas.&#160; The dollar values reported are for the sole&#160;</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">purpose of complying with this schedule.</td>
            </tr>
