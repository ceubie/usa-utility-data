  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="f-14" contextRef="c-1">&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;8. Union Increases:&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:72pt;text-indent:-18pt"&gt;&lt;span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;1.&lt;/span&gt;&lt;span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:9.67pt"&gt;Effective 1/1/2025 &#8211; 3/31/2025 contract increases:&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:108pt;text-indent:-18pt"&gt;&lt;span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;a.&lt;/span&gt;&lt;span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:9.67pt"&gt;3.00%, paired with an employee increase of 2 leading to a increase of $264,846.40&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:72pt;text-indent:-18pt"&gt;&lt;span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;2.&lt;/span&gt;&lt;span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:9.67pt"&gt;Effective 4/1/2025 &#8211; 6/30/2025 contract increases:&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:108pt;text-indent:-18pt"&gt;&lt;span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;a.&lt;/span&gt;&lt;span style="color:#2a2a2a;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%;padding-left:9.67pt"&gt;4.50%, paired with an employee increase of 0 leading to an increase of $26,291.20&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:108pt;text-indent:-18pt"&gt;&lt;span style="col