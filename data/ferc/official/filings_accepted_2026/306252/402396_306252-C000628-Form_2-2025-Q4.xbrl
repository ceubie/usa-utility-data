  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-1" contextRef="c-1">Jayson Antolin</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:TitleOfOfficerWithCustodyOfCorporateBooks id="f-2" contextRef="c-1">Director of Accounting</ferc:TitleOfOfficerWithCustodyOfCorporateBooks>
  <ferc:AddressWhereCorporateBooksAreKept id="f-3" contextRef="c-1">700 Louisiana Street, Suite 10177, Houston, TX USA 77002-2700</ferc:AddressWhereCorporateBooksAreKept>
  <ferc:GeneralInformationAboutIncorporationOfTheRespondentDescription id="f-4" contextRef="c-1">Great Lakes Gas Transmission Limited Partnership is not incorporated. It is a Limited Partnership formed in April 1990 in the state of Delaware.</ferc:GeneralInformationAboutIncorporationOfTheRespondentDescription>
  <ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription id="f-5" contextRef="c-1">N/A</ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription>
  <ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered id="f-6" contextRef="c-1">During 2025, Great Lakes Gas Transmission Limited Partnership was engaged in the operation of natural gas pipeline for the transmission of natural gas in interstate and foreign commerce from the international boundary near Emerson, Manitoba across and within the states of Minnesota, Wisconsin, and Michigan to points on the international boundary near Sault Ste. Marie and Sarnia, Ontario, Canada.</ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-7" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
  <ferc:EngagementDateOfIndependentAuditor id="f-8" contextRef="c-1" xsi:nil="true"></ferc:EngagementDateOfIndependentAuditor>
