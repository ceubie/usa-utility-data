gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-top:1pt solid #0d2e82;padding:2px 1pt 2px 7pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Total&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #330e74;padding:2px 0 2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #330e74;padding:2px 0;text-align:right;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;288,000&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #330e74;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td style="border-top:1pt solid #000;padding:2px 0 2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #000;padding:2px 0;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;104,000&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Less: Current maturities of long-term debt&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;21,000&lt;/span&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;21,000&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-bottom:1pt solid #0a2299;border-top:1pt solid #0d2e82;padding:2px 1pt;text-align:left;text-indent:6.75pt;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Total long-term debt, net&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #0a2299;border-top:1pt solid #000;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #0a2299;border-top:1pt solid #000;padding:2px 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;267,000&lt;/span&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #0a2299;border-top:1pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td style="border-bottom:1pt solid #0a2299;border-top:1pt solid #330e74;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #0a2299;border-top:1pt solid #330e74;padding:2px 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;83,000&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #0a2299;border-top:1pt solid #330e74;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="padding-left:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;On January&#160;29, 2025, the Partnership made a long-term debt principal payment of $10 million towards the 8.08% Series B Senior Notes. On March&#160;25, 2025, the Partnership made a long-term debt principal payment of $11 million towards the 6.95% Senior Notes.&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;The Partnership&#8217;s long-term debt repayments consisted of the following at December 31, 2025:&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:9pt;padding-right:9pt;text-align:center"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:59.077%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:64.643%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:33.157%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-style:italic;font-weight:700;line-height:112%"&gt;Year Ending&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-style:italic;font-weight:400;line-height:112%"&gt;(In thousands)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-top:1pt solid #0d2e82;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;2026&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #0d2e82;padding:2px 0 2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #0d2e82;padding:2px 0;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;21,000&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #0d2e82;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;2027&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;21,000&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;2028&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;226,000&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Thereafter&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;20,000&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-bottom:1pt solid #0d2e82;border-top:1pt solid #0d2e82;padding:0 1pt"/&gt;&lt;td style="border-bottom:1pt solid #0a2299;border-top:1pt solid #330e74;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #0a2299;border-top:1pt solid #330e74;padding:2px 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;288,000&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #0a2299;border-top:1pt solid #330e74;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;On October 10, 2025, the Partnership secured a $205 million three-year term loan facility maturing in October 2028. The facility bears interest on a variable rate basis equal to the term SOFR rate as determined for each applicable interest period plus the applicable SOFR adjustment plus the applicable margin.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;The Partnership is required to comply with certain financial, operational, and legal covenants. Under the most restrictive covenants in the Senior Notes Agreements, approximately $155.1 million of partners&#8217; capital was restricted as to distributions as of December 31, 2025. The Senior Notes, Series B Senior Notes and Term Loan Facility also contain a covenant that limits total funded debt to no greater than 65 percent of the Partnership&#8217;s total GAAP capitalization. At December 31, 2025, the Partnership&#8217;s ratio of funded debt to GAAP capitalization was 32 percent. As of December 31, 2025, the Partnership was in compliance with all of its financial covenants.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:18pt;text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:18pt;text-align:justify"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;(6) FAIR VALUE MEASUREMENTS&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;a.&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%;padding-left:8.84pt"&gt;Fair Value Hierarchy&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;Under ASC 820, &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-style:italic;font-weight:400;line-height:120%"&gt;Fair Value Measurement&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;, fair value measurements are characterized in one of three levels based upon the input used to arrive at the measurement. The three levels of the fair value hierarchy are as follows:&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:54pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;&#8226;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%;padding-left:14.15pt"&gt;Level 1 inputs are quoted prices (unadjusted) in active markets for identical assets or liabilities that the Partnership has the ability to access at the measurement date.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:54pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;&#8226;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%;padding-left:14.15pt"&gt;Level 2 inputs are inputs other than quoted prices included within Level 1 that are observable for the asset or liability, either directly or indirectly.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:54pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;&#8226;&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%;padding-left:14.15pt"&gt;Level 3 inputs are unobservable inputs for the asset or liability.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:54pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;When appropriate, valuations are adjusted for various factors including credit considerations. Such adjustments are generally based on available market evidence. In the absence of such evidence, management&#8217;s best estimate is used.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;b.&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%;padding-left:8.24pt"&gt;Fair Value of Financial Instruments&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;The carrying value of demand loan receivable to related parties, accrued interest, and all current receivable and payable accounts, except for natural gas imbalances approximate their fair values because of the short maturity or duration of these instruments.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;The Partnership&#8217;s natural gas imbalances, which are reported as part of accounts receivable, accounts payable and related party accounts, are classified as a Level 2 in the &#8220;Fair Value &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;Hierarchy,&#8221; as the valuation approach includes quoted prices in the market index and observable volumes for the imbalance.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;The Partnership values these imbalances by applying the difference between the measured quantities of natural gas delivered to or received from our shippers and operators to the current Emerson Viking GL index price. For the years ended December 31, 2025 and 2024, the total estimated fair value of our third party natural gas imbalance was a net payable of approximately $1.3&#160;million and $0.2&#160;million, respectively. For the year ended December 31, 2025, the total estimated fair value of our related party natural gas imbalance was a net payable of approximately $2.3 million. For the year ended &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;December 31, 2024,&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt; the total estimated fair value of our related party natural gas imbalance was a net &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;receivable of approximately&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt; $0.7&#160;million.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;For the years ended December 31, 2025 and 2024, the fair value of the Partnership&#8217;s long-term debt was $297&#160;million and $114&#160;million, respectively. The fair value was estimated based on quoted market prices for the same or similar debt instruments with similar terms and remaining maturities, which is classified as Level 2 in the &#8220;Fair Value Hierarchy,&#8221; where the fair value is determined by using valuation techniques that refer to observable market data.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;text-align:justify"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;(7) TRANSACTIONS WITH RELATED PARTIES&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;a.&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%;padding-left:8.84pt"&gt;Cash Management Program&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:9pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;The Partnership participates in TC Energy&#8217;s Cash Management Program through TC Energy&#8217;s subsidiary TransCanada PipeLine USA Ltd. (TCPL USA), which matches short&#8209;term cash surpluses and needs of participating related parties, thus minimizing total borrowings from outside sources. Monies advanced under the program are considered loans, accruing interest and repayable on demand. The Partnership receives interest on monies advanced to TCPL USA at the rate of interest earned by TCPL USA on its short-term cash investments. The Partnership pays interest on monies advanced from TCPL USA based on TCPL USA&#8217;s short-term borrowing costs. For the years ended December 31, 2025 and 2024, the net interest income on this arrangement was &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;$3.1&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt; million and &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;$4.7&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt; million, respectively. At December 31, 2025 and 2024, the Partnership had a demand loan receivable from TCPL USA of $52.6&#160;million and $95.3&#160;million, respectively.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify;text-indent:-18pt"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;b.&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%;padding-left:8.24pt"&gt;Related Party Transactions&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;The Partnership earns significant transportation revenues from TC Energy and its related parties under contracts, which provide for negotiated, discounted and maximum recourse rates. The contracts are on the same terms as would be available to other shippers and the majority of the Partnership&#8217;s related party revenue is derived from both short-haul and long-haul transportation services.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;Pursuant to the Partnership&#8217;s Operating Agreement, day-to-day operations of the Partnership's activities are the responsibility of TC Energy. The Partnership is charged by TC Energy and related parties for services such as legal, tax, and other costs incurred on its behalf. These include, but are not limited to, employee costs and property and liability insurance costs. These costs are based on direct assignment to the extent practicable, or by using allocation methods that are reasonable reflections of the utilization of services provided to or for the benefits received by the Partnership.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;The following table shows revenues and charges from the Partnership&#8217;s related parties for the years ended December 31:&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:91.369%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:66.489%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:15.838%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:14.373%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;2025&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="border-bottom:1pt solid #0d2e82;padding:2px 1pt;text-align:center;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;2024&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-top:1pt solid #0d2e82;padding:0 1pt"/&gt;&lt;td colspan="6" style="border-top:1pt solid #0d2e82;padding:2px 1pt;text-align:center;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-style:italic;font-weight:400;line-height:112%"&gt;(In thousands)&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Transportation revenues from related parties:&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div style="padding-left:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;TransCanada PipeLines Ltd. (Canadian Mainline) &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:7.15pt;font-weight:400;line-height:112%;position:relative;top:-3.85pt;vertical-align:baseline"&gt;(a)&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style="padding:2px 0 2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 0;text-align:right;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;70,530&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td style="padding:2px 0 2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 0;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;72,239&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div style="padding-left:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;ANR Pipeline Company &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:7.15pt;font-weight:400;line-height:112%;position:relative;top:-3.85pt;vertical-align:baseline"&gt;(a)&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;61,602&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;60,718&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt 2px 19pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;TC Energy Marketing&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;961&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;926&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Costs charged by TC Energy's subsidiaries:&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt 2px 19pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Capital costs&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;16,193&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;8,709&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt 2px 19pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Operating costs&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;34,167&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;35,363&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="9" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div style="margin-bottom:7pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:5.2pt;font-weight:400;line-height:112%;position:relative;top:-2.8pt;vertical-align:baseline"&gt;(a) &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:112%"&gt;No single customer accounted for more than 10% of the Partnership's revenue in 2025 or 2024 other than Canadian Mainline and ANR noted above.&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:72pt;text-align:justify;text-indent:-14.4pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;The Partnership holds a 10-year transportation agreement with Canadian Mainline, a related entity, effective from November 1, 2017, for transporting up to 711,000 dekatherms (Dth) of natural gas daily. The contract includes options to reduce volumes from the third year onwards. The shipper opted to decrease the transport volume to 346,000 Dth/day starting November 1, 2022, and further to 306,537 Dth/day effective November 1, 2024. Annual volume reduction is permissible November 1 of any year with 349 days' notice.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;Additionally, the Partnership holds multiple long-term service contracts with ANR, also a related party, including one 15-year service contract, initially effective from April 16, 2018, for transporting up to 160,000 Dth of natural gas daily. Over time, the service contract was amended to decrease the transport volume capacity to 155,407 Dth/day starting October 1, 2022, the anticipated in-service date of ANR&#8217;s Alberta XPress Project. The Alberta XPress Project was placed in-service on January 19, 2023, resulting in an amendment which terminated the aforementioned service contract, but also the execution of a 16-year Capacity Lease Agreement for the same capacity associated with the firm transportation service of 155,407 Dth/day, with fees according to the Partnership&#8217;s tariff rates for firm transportation from the Western to Central zone.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:36pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;At December 31, 2025 and 2024, the Partnership had outstanding receivables of $8.5 million and $7.7 million, respectively, from its related parties. Amounts reported in this footnote are Accounts Receivable from Associated Companies (146) net of Accounts Payable to Associated Companies (234) on the Partnership's balance sheets.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;text-align:justify"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;(8) DISTRIBUTIONS&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;The Partnership&#8217;s distribution policy generally results in a quarterly cash distribution equal to 100 percent of distributable cash flow based upon earnings before income taxes, depreciation, AFUDC less capital expenditures and debt repayments not funded with cash calls to its partners. The resulting distribution amount and timing are subject to Management Committee modification and approval after considering business risks as well as ensuring minimum cash balances, equity balances, and ratios are maintained.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;For the years ended December 31, 2025 and 2024, the Partnership paid distributions to its general partners of $278.9&#160;million and $134.6&#160;million, respectively.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;text-align:justify"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;(9) SUPPLEMENTAL CASH FLOW INFORMATION&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:18pt"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:77.678%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:64.608%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:14.991%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.907%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:14.994%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-style:italic;font-weight:400;line-height:120%"&gt;(in thousands)&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;2025&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:center;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;2024&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;Interest paid, net of capitalized interest&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #0a2299;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #0a2299;padding:2px 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;6,308&lt;/span&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #0a2299;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="border-top:1pt solid #0a2299;padding:0 1pt"/&gt;&lt;td style="border-top:1pt solid #0a2299;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #0a2299;padding:2px 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;8,395&lt;/span&gt;&lt;span style="color:#0a2299;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #0a2299;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;Accruals for plant, property and equipment, net&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;55,013&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;36,730&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;text-align:justify"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:120%"&gt;(10) SUBSEQUENT EVENTS&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;On January 29, 2025, the Partnership made a long-term debt principal payment of $10 million towards the 8.08% Senior Notes. On March 25, 2026, the Partnership made a long-term debt principal payment of $11 million towards the 6.95% Series B Senior Note&lt;/span&gt;&lt;span style="color:#000000;font-family:'Frutiger LT 45 Light',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;s.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:7pt;padding-left:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:120%"&gt;Subsequent events have been assessed through April&#160;2, 2026, which is the date the financial statements were issued, and the Partnership has concluded there were no additional events nor transactions during this period that would require recognition or disclosure in the financial statements other than those already reflected here or in the preceding notes.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock>
  <ferc:GeneralDescriptionOfConstructionOverheadTextBlock id="f-23" contextRef="c-1">&lt;div style="text-align:center"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:95.535%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:19.772%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.681%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.681%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.681%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:18.685%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="15" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt;OVERHEADS:&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="15" style="padding:2px 1pt;text-align:justify;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;Administrative, engineering, and supervision salaries, expenses, and employee benefits relating to construction activities are capitalized based on labor recorded to the payroll system. The amounts so capitalized are directly assigned, based on individual construction projects, exclusive of construction orders covering the cost of capitalized software and purchases of general plant, furniture, transportation equipment, tools, and similar property, on a percentage basis with the same percentage being applied to all types of construction.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="15" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt;ALLOWANCE FOR FUNDS USED DURING CONSTRUCTION:&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="15" style="padding:2px 1pt;text-align:justify;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;Computed monthly on construction work in progress, exclusive of construction projects covering the purchase of property normally placed in service when received. The amounts so capitalized are directly assigned, based on individual construction projects exclusive of construction orders covering the purchase of general plant furniture, transportation equipment, tools and similar property, on a percentage basis with the same percentage being applied to all types of construction. In 2025 $11,319,162 of equity and $811,262 of debt were directly charged to construction.&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;</ferc:GeneralDescriptionOfConstructionOverheadTextBlock>
  <ferc:ExplanatoryOfSecuritiesIssuedOrAssumedAndSecuritiesRefundedOrRetiredTextBlock id="f-24" contextRef="c-1">&lt;div style="margin-top:2pt;padding-right:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;Account 224&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-right:18pt;text-indent:36pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-right:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;Debt Principal Payments: &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-right:18pt;text-indent:36pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-right:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;The Partnership made required principal payments on Senior Notes. There were no other premiums, discounts, expenses, gains or losses paid during the year relating to these transactions.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-right:18pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-right:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;6.95% required payment&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; $11,000,000&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-right:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;8.08% required payment&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%;text-decoration:underline"&gt;$10,000,000&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-right:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt;Total Debt Principal Payments in 2025&#160;&#160;&#160;&#160; $21,000,000&lt;/span&gt;&lt;/div&gt;</ferc:ExplanatoryOfSecuritiesIssuedOrAssumedAndSecuritiesRefundedOrRetiredTextBlock>
