;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt 2px 13pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;State&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;1,241&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;1,426&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-top:1pt solid #330e74;padding:2px 1pt 2px 25pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Total deferred expense&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #330e74;padding:2px 0 2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #330e74;padding:2px 0;text-align:right;vertical-align:top"&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;4,271&lt;/span&gt;&lt;span style="color:#0d2e82;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #330e74;paddi