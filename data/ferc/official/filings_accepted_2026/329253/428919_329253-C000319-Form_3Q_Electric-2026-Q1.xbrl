							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:3pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; page-break-after:avoid; font-size:12pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
