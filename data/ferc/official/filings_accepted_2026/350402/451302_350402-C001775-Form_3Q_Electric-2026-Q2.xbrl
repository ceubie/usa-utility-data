&lt;p class="MsoNormal" style="text-align: right; break-after: avoid; line-height: 1; border: medium none currentcolor;" align="right"&gt;&lt;font style="font-family: 'Calibri',sans-serif; mso-fareast-font-family: Calibri; color: black;"&gt;12,459.7&lt;/font&gt;&lt;/p&gt;
