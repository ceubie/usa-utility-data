&lt;/td&gt;
&lt;td style="width: 1.16%; border-top: solid black 1.0pt; border-left: none; border-bottom: solid black 1.0pt; border-right: none; mso-border-top-alt: solid black .5pt; mso-border-bottom-alt: solid black .5pt; background: white; padding: .7pt .7pt 0in 0in;" valign="bottom" width="1%"&gt;
