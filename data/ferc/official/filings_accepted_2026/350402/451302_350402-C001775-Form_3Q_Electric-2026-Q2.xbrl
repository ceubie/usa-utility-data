&lt;p class="MsoNormal" style="text-align: justify; break-after: avoid; line-height: 1; border: medium none currentcolor;"&gt;&lt;font style="font-family: 'Calibri',sans-serif; mso-fareast-font-family: Calibri; color: black;"&gt;Construction, work in progress&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 6.02%; border-width: medium medium 1pt; border-style: none none solid; border-color: currentcolor currentcolor windowtext; padding: 0in 5.4pt; line-height: 1;" valign="top" width="6%"&gt;
