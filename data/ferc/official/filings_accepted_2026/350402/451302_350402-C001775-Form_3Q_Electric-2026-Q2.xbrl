&lt;p class="MsoNormal" style="text-align: right; break-after: avoid; line-height: 1; border: medium none currentcolor;" align="right"&gt;&lt;strong style="mso-bidi-font-weight: normal;"&gt;&lt;font style="font-family: 'Calibri',sans-serif; mso-fareast-font-family: Calibri; color: black;"&gt;769.0&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 2.68%; border-width: medium medium 1pt; border-style: none none solid; border-color: currentcolor currentcolor windowtext; padding: 0in 5.4pt; line-height: 1;" valign="top" width="2%"&gt;
&lt;p class="MsoNormal" style="text-align: justify; break-after: avoid; line-height: 1; border: medium none currentcolor;"&gt;&lt;font style="font-family: 'Calibri',sans-serif; mso-fareast-font-family: Calibri; color: black;"&gt;&amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
