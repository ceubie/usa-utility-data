&lt;td style="width: 1.36%; border: none; border-bottom: double black 2.25pt; mso-border-top-alt: solid black .5pt; padding: .7pt .7pt 0in 0in;" valign="bottom" width="1%"&gt;
&lt;p class="MsoNormal" style="border: none; mso-padding-alt: 31.0pt 31.0pt 31.0pt 31.0pt; mso-border-shadow: yes;"&gt;&lt;font style="font-family: 'Calibri',sans-serif; mso-fareast-font-family: Calibri; color: black;"&gt;$&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 15.5%; border: none; border-bottom: double black 2.25pt; mso-border-top-alt: solid black .5pt; padding: .7pt .7pt 0in 0in;" valign="bottom" width="15%"&gt;
&lt;p class="MsoNormal" style="text-align: right; border: none; mso-padding-alt: 31.0pt 31.0pt 31.0pt 31.0pt; mso-border-shadow: yes;" align="right"&gt;&lt;font style="font-family: 'Calibri',sans-serif; mso-fareast-font-family: Calibri; color: black;"&gt;103.0&lt;/font&gt;&lt;/p&gt;
