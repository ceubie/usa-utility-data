          <tr>
            <td colspan="3" style="padding:1.5pt 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%">Schedule Page: 521 Line No 4 Column f</span>
            </td>
          </tr>
          <tr>
            <td colspan="3" style="padding:1.5pt 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Gas is valued at a monthly average price for the Tenn LA 500 Leg point as published in the Platts Gas Daily Publication.</span>
            </td>
