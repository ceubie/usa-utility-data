  <ferc:VendorName id="f-656" contextRef="c-1">The Workiva Platform</ferc:VendorName>
  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">Our cash management activities result in cash being swept to and from a subsidiary of ONEOK, generating affiliate payables and receivables. Our policy is to present net cash sweep activity in financing activities when the associated balance is in a payable position and as investing when the balance is in a receivable position.</link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">Cash flows associated with internal recapitalization adjustments are deemed cash settled through our affiliate accounts and are recorded between us and a subsidiary of ONEOK to maintain certain capitalization structures. Our policy is to present the recapitalization activities gross in the statement of cash flows as sources or uses of cash flows from investing and financing activities, as appropriate.</link:footnote>
    <link:loc xlink:type="locator" xlink:label="f-161" xlink:href="#f-161"/>
    <link:loc xlink:type="locator" xlink:label="f-171" xlink:href="#f-171"/>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-161" xlink:to="fn-1" order="1"/>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-171" xlink:to="fn-2" order="2"/>
  </link:footnoteLink>
</xbrli:xbrl>
