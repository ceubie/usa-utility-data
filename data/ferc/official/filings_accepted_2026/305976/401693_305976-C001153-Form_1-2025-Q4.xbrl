    <ferc:TaxesAccrued id="f-3437" contextRef="c-490" unitRef="u-02" decimals="0">0</ferc:TaxesAccrued>
    <ferc:TaxesAccrued id="f-3438" contextRef="c-491" unitRef="u-02" decimals="0">0</ferc:TaxesAccrued>
    <ferc:TaxesAccrued id="f-3439" contextRef="c-492" unitRef="u-02" decimals="0">0</ferc:TaxesAccrued>
    <ferc:TaxesAccrued id="f-3440" contextRef="c-493" unitRef="u-02" decimals="0">0</ferc:TaxesAccrued>
    <ferc:TaxesAccrued id="f-3441" contextRef="c-494" unitRef="u-02" decimals="0">0</ferc:TaxesAccrued>
