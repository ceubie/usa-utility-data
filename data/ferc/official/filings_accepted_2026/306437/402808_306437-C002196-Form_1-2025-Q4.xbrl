      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-38" id="fn-38" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The other charges listed in this column include:</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:10pt">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:77.827%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:19.358%"/>
            <td style="width:0.1%"/>
            <td style="width:1.0%"/>
            <td style="width:78.442%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">(1,022,930)</span>
            </td>
            <td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Schedule 9 (Network Transmission)</span>
            </td>
          </tr>
          <tr>
            <td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">10,292,897&#160;</span>
            </td>
            <td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Schedule 26A (Multi-Value Projects)</span>
            </td>
          </tr>
          <tr>
            <td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">(45,053)</span>
            </td>
            <td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Schedule 26 (Network Upgrade Transmission Expansion)</span>
            </td>
          </tr>
          <tr>
            <td style="border-top:1pt solid #000;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">$</span>
            </td>
            <td style="border-top:1pt solid #000;padding:2px 0;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">9,224,914&#160;</span>
            </td>
            <td style="border-top:1pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/>
            <td colspan="3" style="padding:0 1pt"/>
