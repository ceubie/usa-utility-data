              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">$</span>
            </td>
            <td style="border-top:1pt solid #000;padding:2px 0;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">215,464,614&#160;</span>
            </td>
            <td style="border-top:1pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/>
            <td colspan="3" style="padding:0 1pt"/>
          </tr>
        </table>
      </div>
    </link:footnote>
