  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-1" contextRef="c-1">Russell Wright</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:TitleOfOfficerWithCustodyOfCorporateBooks id="f-2" contextRef="c-1">VP, Chief Accounting Officer</ferc:TitleOfOfficerWithCustodyOfCorporateBooks>
  <ferc:AddressWhereCorporateBooksAreKept id="f-3" contextRef="c-1">1111 Louisiana Street, Houston, TX 77002</ferc:AddressWhereCorporateBooksAreKept>
  <ferc:StateOfIncorporation id="f-4" contextRef="c-1">TX</ferc:StateOfIncorporation>
  <ferc:IncorporationDate id="f-5" contextRef="c-1">2019-02-01</ferc:IncorporationDate>
  <ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription id="f-6" contextRef="c-1">Not Applicable</ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription>
  <ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered id="f-7" contextRef="c-1">All operations are within the State of Indiana except for approximately nine miles of 138kv transmission line and approximately fifteen of 345kv transmission line located in Kentucky. The 138kv transmission line interconnects with Louisville Gas and Electric Company's system at Cloverport, Kentucky, while the 345kv transmission line interconnects with Big Rivers Corporation's system near Sebree, Kentucky. The Company also sells and purchases power in the Wholesale Power Market principally with the Midcontinent ISO, and such power is generally exchanged in Indiana.</ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-8" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-9" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
  <ferc:ControlOverRespondentTextBlock id="f-10" contextRef="c-1">&lt;div style="padding-left:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;All of the common stock of Southern Indiana Gas and Electric Company is held by Vectren Utility Holdings, LLC. Vectren Utility Holdings, LLC is an indirect, wholly owned subsidiary of CenterPoint Energy Corporation, an investor-owned holding company.&lt;/span&gt;&lt;/div&gt;</ferc:ControlOverRespondentTextBlock>
  <ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock id="f-11" contextRef="c-1">&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;1. None&lt;/span&gt;</ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock>
