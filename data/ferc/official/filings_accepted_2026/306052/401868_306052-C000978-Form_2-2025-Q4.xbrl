                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Regulatory Liability - Deferred Income Tax Rate Adjustment</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 22.5pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="30">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 135.45pt; border: solid windowtext 1.0pt; border-left: none; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="181">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal; mso-layout-grid-align: none; text-autospace: none;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">1,857,253</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
          </xhtml:tbody>
        </xhtml:table>
