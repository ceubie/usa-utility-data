    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote25" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA; mso-bidi-font-weight: bold;">The cost rate percentage of common equity is based on the approved rate in Docket No. RP99-381.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value25" xlink:to="footnote25" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="25" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote26" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Rate for borrowed funds actually used during year is based upon the capital ratio of 49.68% long term debt in the settlement of rate case Docket No. RP99-381 multiplied by the 8% long term debt cost rate percentage.</xhtml:span>
          <xhtml:u>
          </xhtml:u>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
