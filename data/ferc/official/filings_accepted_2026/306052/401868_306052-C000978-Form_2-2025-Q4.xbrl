    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value67" xlink:to="footnote67" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="67" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote69" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This project has separately tracked fuel retention rates. During 2025, we retained 0 Dth of gas from our shippers and we consumed 0 Dth of gas.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Powder River Lateral service was discontinued effective October 1, 2023.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value69" xlink:to="footnote69" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="69" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote71" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This project has separately tracked fuel retention rates. During 2025, we retained 0 Dth of gas from our shippers and we consumed 49 Dth of gas.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">The Kanda Diamond Mountain Compressor Station was abandoned in September 2023.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value71" xlink:to="footnote71" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="71" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote72" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This project has separately tracked fuel retention rates. During 2025, we retained 321,612 Dth of gas from our shippers and we consumed 297,043 Dth of gas.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value72" xlink:to="footnote72" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="72" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote73" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Medicine Bow Original Application CP99-102</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Medicine Bow Expansion 1 CP99-624</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Medicine Bow Expansion 2 CP00-471</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Medicine Bow Expansion 3 CP07-395</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Medicine Bow Expansion 4 CP08-468</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value73" xlink:to="footnote73" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="73" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote74" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Kanda Lateral CP07-14</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Kanda Lateral Expansion CP09-449</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value74" xlink:to="footnote74" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="74" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote75" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Piceance Basin Original Application CP05-54</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Piceance Basin Expansion Phase 1 CP08-403</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Piceance Basin Expansion Phase 2 CP08-403</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value75" xlink:to="footnote75" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="75" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote76" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Includes Account 101.1, Property Under Capital Leases:</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;"> Douglas Compressor Station $106,503.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value76" xlink:to="footnote76" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="76" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote77" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Accumulated depreciation has been allocated using the FERC approved depreciation rate over time applied to gross plant for each incremental facility. Our methodology for allocating composite depreciation to incremental facilities for cost allocation and rate design purposes may differ in a Section 4 or 5 rate filing.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value77" xlink:to="footnote77" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="77" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote78" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Accumulated deferred income tax is a computed amount representing the impact of the difference between allocated composite book depreciation amounts and tax depreciation for each incremental facility. We record and compute book depreciation on a composite basis. Our methodology for allocating composite deferred income taxes to incremental facilities for cost allocation and rate design purposes may differ in a Section 4 or 5 rate filing.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value78" xlink:to="footnote78" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="78" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote79" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Operating expenses are allocated based on gross plant amounts or are directly assigned; associated lease expense for each project included where applicable. Our methodology for cost allocation and rate design purposes may differ in a Section 4 or 5 rate filing.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value79" xlink:to="footnote79" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="79" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote80" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Maintenance expenses are allocated based on gross plant amounts or are directly assigned. Our methodology for cost allocation and rate design purposes may differ in a Section 4 or 5 rate filing.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value80" xlink:to="footnote80" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="80" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote82" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This project has separately tracked fuel retention rates. During 2025, we retained 365,741 Dth of gas from our shippers and we consumed 562,747 Dth of gas.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value82" xlink:to="footnote82" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="82" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote83" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Other Expenses (including taxes) are primarily allocated based on assessed value. Our methodology for cost allocation and rate design purposes may differ in a Section 4 or 5 rate filing.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value83" xlink:to="footnote83" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="83" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote86" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Default">
          <xhtml:span style="font-size: 18.0pt; color: windowtext;">
            <xhtml:span style="font-family: arial, helvetica, sans-serif;">Recorded pursuant to Docket No. AI93-5-000 issued April 23, 1993 (Accounting for Income Taxes). We estimate approximately $6.4 million of the ending balance is associated with projects granted non-traditional rate treatment that are reported on Page 217.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
