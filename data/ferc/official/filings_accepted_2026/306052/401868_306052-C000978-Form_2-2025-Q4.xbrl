  <ferc:NameOfCompanyControllingRespondent id="Tag1813" contextRef="C747">KM Energy LLC</ferc:NameOfCompanyControllingRespondent>
  <ferc:TypeOfControlOverTheRespondent id="Tag1814" contextRef="C747">I</ferc:TypeOfControlOverTheRespondent>
  <ferc:StateOfIncorporation id="Tag1815" contextRef="C747">DE</ferc:StateOfIncorporation>
  <ferc:VotingStockOfRespondentOwnedByOthersPercentage id="Tag1816" contextRef="C748" unitRef="Pure" decimals="4">0.5952</ferc:VotingStockOfRespondentOwnedByOthersPercentage>
  <ferc:NameOfCompanyControllingRespondent id="Tag1817" contextRef="C749">Kinder Morgan Energy Partners, L.P.</ferc:NameOfCompanyControllingRespondent>
  <ferc:TypeOfControlOverTheRespondent id="Tag1818" contextRef="C749">D</ferc:TypeOfControlOverTheRespondent>
  <ferc:StateOfIncorporation id="Tag1819" contextRef="C749">DE</ferc:StateOfIncorporation>
  <ferc:VotingStockOfRespondentOwnedByOthersPercentage id="Tag1820" contextRef="C750" unitRef="Pure" decimals="2">1.00</ferc:VotingStockOfRespondentOwnedByOthersPercentage>
  <ferc:OrderNumber id="Tag1821" contextRef="C153" unitRef="Pure" decimals="0">1</ferc:OrderNumber>
  <ferc:OrderNumber id="Tag1822" contextRef="C155" unitRef="Pure" decimals="0">2</ferc:OrderNumber>
  <ferc:OrderNumber id="Tag1823" contextRef="C157" unitRef="Pure" decimals="0">3</ferc:OrderNumber>
