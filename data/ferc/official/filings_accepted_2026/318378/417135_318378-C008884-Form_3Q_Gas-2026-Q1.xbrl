  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="f-20" contextRef="c-1">&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;1. None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;2. None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;3. None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;4. None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;5. None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;6. None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;7. None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:14pt;margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;8. None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:5pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;9. See Page 122.1 - Note 3&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;10. None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;11. None &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;12. None&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;13. Not Applicable&lt;/span&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:ReportYear id="f-21" contextRef="c-1" decimals="0" unitRef="u-1">2026</ferc:ReportYear>
  <ferc:ReportPeriod id="f-22" contextRef="c-1">Q1</ferc:ReportPeriod>
  <ferc:ReportYear id="f-23" contextRef="c-1" decimals="0" unitRef="u-1">2026</ferc:ReportYear>
  <ferc:ReportPeriod id="f-24" contextRef="c-1">Q1</ferc:ReportPeriod>
  <ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock id="f-25" contextRef="c-1">&lt;div style="padding-left:14.4pt;text-indent:-14.4pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;1. Organization and Operations&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Midship Pipeline Company, LLC (collectively, &#8220;Midship Pipeline&#8221; or the &#8220;Company&#8221;) is a wholly-owned subsidiary of Midship Holdings, LLC (&#8220;Midship Holdings&#8221;). Midship Holdings is a joint venture between EIG Midship Holdings I, LP (&#8220;EIG&#8221;) and, prior to the sale of its equity interests on February 13, 2025, a wholly-owned subsidiary of Cheniere Energy, Inc. (&#8220;Cheniere Energy&#8221;). On February 13, 2025, Cheniere Energy sold its equity interests in Midship Holdings to a wholly-owned subsidiary of Howard Midstream Energy Partners, LLC (&#8220;HEP&#8221;) (the &#8220;HEP Purchase&#8221;). Concurrent with the HEP Purchase, an associated company of Cheniere Energy assigned certain operating and construction management services agreements to HEP. Unless the context requires otherwise, &#8220;we,&#8221; &#8220;us&#8221; and &#8220;our&#8221; refer to Midship Pipeline. &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Midship Pipeline owns and operates a natural gas pipeline that connects natural gas production in the Anadarko Basin to Gulf Coast and Southeast markets.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify;text-indent:27pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:14.4pt;text-indent:-14.4pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;2. Basis of Presentation&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The accompanying Financial Statements of Midship Pipeline have been prepared in accordance with the accounting regulations of the Federal Energy Regulatory Commission (&#8220;FERC&#8221;), as set forth in the applicable Uniform System of Accounts and published accounting releases, which are a comprehensive basis of accounting other than accounting principles generally accepted in the United States of America (&#8220;GAAP&#8221;). The most significant differences between GAAP and the comprehensive basis of accounting applied in these Financial Statements are: (i) the classification of certain accounts on the Comparative Balance Sheet, Statement of Income and Statement of Cash Flows, (ii) certain assets from the regulated ratemaking process are recorded that would not be recorded under GAAP for non-regulated entities, and (iii) accounting and reporting requirements for certain operating leases may not be required to be reported in balance sheet accounts under FERC&#8217;s accounting regulations (Docket No. AI19-1-000). These interim Financial Statements do not include all of the information and footnotes required by FERC for complete financial statements and should be read in conjunction with the Financial Statements and accompanying notes included in our FERC Form No. 2 for the year ended December 31, 2025.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Results of operations for the three months ended March 31, 2026 are not necessarily indicative of the results of operations that will be realized for the year ending December 31, 2026.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Management has evaluated subsequent events through May&#160;20, 2026, the date the Financial Statements were available to be issued.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:6pt;padding-left:14.4pt;text-align:justify;text-indent:-14.4pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;3. Commitments and Contingencies &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%"&gt;Litigation&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-align:justify;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;We are party to claims and legal proceedings arising in the ordinary course of business. We have not recorded a loss contingency with respect to some of these matters because we have determined that it is remote that a loss has been incurred or the loss cannot be reasonably estimated. For other matters, we have recorded a loss contingency where we have determined that it is probable that a loss has been incurred and that the loss is reasonably estimable. We reevaluate and update our loss contingency assessments as matters progress over time, and except as discussed below, we believe that any changes to the recorded liabilities will not be material to our financial position or results of operations. &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;As of March 31, 2026 and December 31, 2025, we accrued a total reserve for regulatory and other legal proceedings in the amount of $1.2&#160;million and $3.0&#160;million, respectively, in Account 242, Miscellaneous Current and Accrued Liabilities in our balance sheets. Estimates are preliminary and it is at least reasonably possible that actual costs incurred could differ from these estimates.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Effective as of the closing of the HEP Purchase, Cheniere Energy entered into an indemnity agreement with Midship Holdings, EIG and HEP concerning the regulatory matter described below. Pursuant to the terms of the indemnity agreement, Cheniere Energy has agreed to reimburse Midship Holdings for 50% of applicable costs incurred during the eighteen months following the HEP Purchase, less a $1.0 million deductible, subject to a maximum aggregate reimbursement of $12.5&#160;million. As of March 31, 2026, we recorded an indemnification receivable of approximately $0.7&#160;million in Account 143, Other Accounts Receivable in our balance sheet. &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%"&gt;Regulatory Matters&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Midship Pipeline is subject to extensive regulation under federal, state and local statutes, rules, regulations and laws. These laws require that we engage in consultations with appropriate federal and state agencies and that we obtain and maintain applicable permits and other authorizations. Failure to comply with such laws could result in legal proceedings, which may include substantial penalties.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;FERC&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:400;line-height:120%"&gt;Order Directing Restoration Activity&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On December 16, 2021, the FERC issued an Order to Show Cause to Midship Pipeline regarding alleged concerns about the remediation of the right-of-way or other land disturbed during construction of its pipeline. The order directed Midship Pipeline to submit an assessment plan to investigate the identified concerns and a remediation plan to address any confirmed issues. Midship Pipeline submitted both plans and coordinated with the FERC to finalize them. FERC approved the assessment plan on October 27, 2022 (&#8220;Assessment Plan&#8221;) and the remediation plan on February 3, 2023 (&#8220;Remediation Plan&#8221;).&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Throughout 2023, Midship Pipeline worked to comply with its Assessment Plan and Remediation Plan obligations, in cooperation with FERC Staff and in the presence of FERC&#8217;s third-party monitor, environmental inspectors, and independent experts across multiple properties. Midship Pipeline completed all Assessment Plan activities on August 20, 2023, and completed all Remediation Plan activities on December 21, 2023. Certain landowners subsequently asserted that additional assessment and remediation activities were required on their respective tracts. In response, FERC directed its third-party monitor to conduct additional inspections, which occurred between June and August 2024 and in December 2024. As a result of those inspections, FERC issued three Inspection Report Findings and Conclusions, dated January 8, March 18, and April 11, 2025, requiring further remediation and monitoring activities on 90 tracts. &lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Following a FERC order issued on August 21, 2025, addressing rehearing and other issues raised by the parties, Midship Pipeline has completed the remaining required remediation work. Midship Pipeline will continue to cooperate with the FERC and its third-party monitor to address any new issues that may arise.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;Other Legal Proceedings&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;We are party to certain lawsuits (or threatened lawsuits) filed by and against residents, businesses and property owners regarding various causes of action based on condemnation and tort, that generally seek compensatory and punitive damages, and declaratory, injunctive and other relief. The parties are working towards resolution on the condemnation matters. In the Western District of Oklahoma, our request for condemnation and immediate possession of the right-of-way and temporary workspace was granted on February 6, 2019, the Commissioner hearings were held in late May and early August 2022, and the Commissioner Report and Recommendation was approved by the Court on February 16, 2023. In the Eastern District of Oklahoma, our request for condemnation and immediate possession of the right-of-way and temporary workspace was granted on January 2, 2019, the Commissioner hearings were held the week of September 6, 2022, and a Commissioner Report and Recommendation was approved by the Court on May 30, 2023. The judgments were approved in both Courts. We sought an extension of the possession of temporary workspace in October 2022 in both the Eastern and Western Districts of Oklahoma, and the courts granted immediate possession in January 2023. The Commissioners in both proceedings have had their hearing results entered on the record. Both courts are in the process of approving judgments and associated distribution of funds.&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:14.4pt;text-align:justify;text-indent:-14.4pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;4. Supplemental Cash Flow Information&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-align:justify;text-indent:27pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The following table provides supplemental disclosure of cash flow information (in thousands):&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify;text-indent:27pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:98.363%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:72.273%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.556%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:11.456%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.556%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:11.459%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="9" style="padding:2px 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:700;line-height:120%"&gt;Three Months Ended March 31,&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="border-top:1pt solid #000000;padding:2px 1pt;text-align:center;vertical-align:middle"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:700;line-height:120%"&gt;2026&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="border-top:1pt solid #000000;padding:0 1pt"/&gt;&lt;td colspan="3" style="border-top:1pt solid #000000;padding:2px 1pt;text-align:center;vertical-align:middle"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:700;line-height:120%"&gt;2025&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Cash paid for interest, net of allowance for funds used during construction - debt&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#cceeff;padding:0 1pt"/&gt;&lt;td style="background-color:#cceeff;border-top:1pt solid #000000;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#cceeff;border-top:1pt solid #000000;padding:2px 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;6,246&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#cceeff;border-top:1pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#cceeff;padding:0 1pt"/&gt;&lt;td style="background-color:#cceeff;border-top:1pt solid #000000;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#cceeff;border-top:1pt solid #000000;padding:2px 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;6,389&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#cceeff;border-top:1pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Non-cash activity:&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:0 1pt"/&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:0 1pt"/&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:0 1pt"/&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:0 1pt"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;text-indent:18pt;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Capital expenditures included in accounts payable, accounts payable to &lt;br/&gt; associated companies and accrued liabilities&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#cceeff;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;1,999&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#cceeff;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="background-color:#cceeff;padding:0 1pt"/&gt;&lt;td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;4,431&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#cceeff;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;</ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock>
