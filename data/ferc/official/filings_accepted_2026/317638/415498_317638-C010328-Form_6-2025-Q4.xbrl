    <link:footnote xlink:type="resource" xlink:label="HHB40B23068A4596D7FB315636104B589A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color: #000000; font-family: Calibri, sans-serif; font-size: 11pt; line-height: 16.4267px;">Gray Oak Pipeline, LLC in section (A) column (a) line 1 is the owner of the pipeline reported.</span>
        </div>
        <div>
          <span style="color: #000000; font-family: Calibri, sans-serif; font-size: 11pt; line-height: 17.6px;">Respondent&#8217;s properties are operated by Enbridge as agent (not lessee).</span>
