        <table style="width: 663px; height: 69px;" border="0" width="240" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="height: 15.0pt;">
              <td class="xl504" style="height: 15pt; width: 663px;" height="20">Distributions paid to members during the twelve month period ended December 31, 2025 were $308,200,000 . Distirbutions paid from Additional Paid-In Capital were $63,504,034 while Distributions paid from Unappropriated Retained Income were $244,695,966</td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
