  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HHAA5C56CFA5A9DAB483282F0CFF1DDE58" xlink:label="HHAA5C56CFA5A9DAB483282F0CFF1DDE58" />
    <link:footnote xlink:type="resource" xlink:label="HH38ED8090AB6CD275C156C4BB734E76CE" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>(a) Concept: Direct Parent Name<br />Schedule Page: 102, Line No.:1, Column: e<br />DCP Mistream, LLC is owned by Spectra Energy DEFS Holding, LLC (90%) and<br />Phillips Gas Company, LLC, DE which is owned by Phillips 66 Company, DE which is owned by Phillips 66, DE (10%)</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAA5C56CFA5A9DAB483282F0CFF1DDE58" xlink:to="HH38ED8090AB6CD275C156C4BB734E76CE" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH41BD507F193424CA50B4A10FCE61671B" xlink:label="HH41BD507F193424CA50B4A10FCE61671B" />
    <link:footnote xlink:type="resource" xlink:label="HHE034D4F420C6FF46CFE846EFC037E2EA" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>(b) Concept: Direct Parent Name<br />Schedule Page: 102, Line No: 3, Column: e<br />Effective as of January 9, 2023, Spectra Energy DEFS Holding, LLC, an indirect, consolidated subsidiary of Enbridge, acquired Rattler Midstream's 10% interest in the Company.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH41BD507F193424CA50B4A10FCE61671B" xlink:to="HHE034D4F420C6FF46CFE846EFC037E2EA" order="1" />
