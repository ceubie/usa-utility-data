    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE6EB1413802F572BAE85019FC7F7A0DD" xlink:to="HHB40B23068A4596D7FB315636104B589A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH61195969E8DB57EBC71E91F85A2B07CA" xlink:label="HH61195969E8DB57EBC71E91F85A2B07CA" />
    <link:footnote xlink:type="resource" xlink:label="HH11B6F80EA211104C043EB5551BA81E68" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 730px; height: 311px;" border="0" width="528" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 62.1pt;">
              <td class="xl63" style="height: 62.1pt; width: 396pt;" width="528" height="82">Management believes that the information on this page has been prepared in accordance with the Commission's Opinion 154-B methodology. This presentation on page 700 is not necessarily in the form in which it would appear in connection with a challenge to a particular rate, or rates, and is therefore not intended to be binding in any specific rate litigation.</td>
            </tr>
            <tr style="height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">&#160;</td>
            </tr>
            <tr style="height: 30.0pt;">
              <td class="xl64" style="height: 30.0pt; width: 396pt;" width="528" height="40">Notes:<br />Totals may not sum due to rounding.</td>
            </tr>
            <tr style="height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">&#160;</td>
            </tr>
            <tr style="height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">Pursuant to the Commission&#8217;s Remedial Order, issued on November 20, 2025, in Docket No. RM25-2-000, Total Interstate Operating Revenues include amounts recoverable during the Locked-In-Period from March 1, 2022, to September 17, 2024.</td>
            </tr>
            <tr style="height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">&#160;</td>
            </tr>
            <tr style="height: 15.0pt;">
              <td style="height: 15.0pt;" height="20">2024 amounts have been restated to correct the Total Interstate Throughput.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH61195969E8DB57EBC71E91F85A2B07CA" xlink:to="HH11B6F80EA211104C043EB5551BA81E68" order="1" />
  </link:footnoteLink>
