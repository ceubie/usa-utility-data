  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q4</ferc:ReportPeriod>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-04-20</ferc:ReportDate>
  <ferc:IndicatorStockholdersReportSubmittedOrNotPrepared id="HH338A37446FF58C0756F3AE1CD8A44F64" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Not Prepared</ferc:IndicatorStockholdersReportSubmittedOrNotPrepared>
  <ferc:DisclosureOfEventsThatHaveAMaterialEffectToRespondentsTextBlock id="HH11476EB422E065C84DE3B12A8533C405" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;S&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;IGNIFICANT EVENTS &amp;#x2013; EXPIRATION OF COST OF SERVICE TRANSPORTATION SERVICES AGREEMENTS&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Enbridge Pipelines (Southern Lights) L.L.C.&amp;#x2019;s diluent transportation activities are subject to regulation by the Federal Energy Regulatory Commission. The Company operated under transportation services agreements that utilized a cost of service toll methodology through June 30, 2025; those agreements expired as of June 30, 2025. Accordingly, second-quarter results reflected cost of service tolling through the end of the period. Effective July 1, 2025, the Company&amp;#x2019;s Local Rates tariff FERC No. 4.25.0 became effective, and the Rules &amp;amp; Regulations tariff FERC No. 3.9.0 remains in force; third and fourth quarter periods reflect tolls and charges in accordance with the currently effective FERC tariffs.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:DisclosureOfEventsThatHaveAMaterialEffectToRespondentsTextBlock>
  <ferc:DisclosureOfImportantNotesRegardingFinancialStatementsTextBlock id="HHCA5ED8FA45B245705E52E9F0E61FB5CB" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfImportantNotesRegardingFinancialStatementsTextBlock>
