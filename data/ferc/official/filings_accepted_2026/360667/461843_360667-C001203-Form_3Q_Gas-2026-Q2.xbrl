              <td class="xl55680" style="height: 15.0pt;" height="20">&#160;&#160;&#160;&#160; Total</td>
              <td class="xl55681">&#160;</td>
              <td class="xl55683">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 2,187,893</td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHD1EA3FFD4E6ECAF2321E855D05772CE5" xlink:to="HH1ECEB81D6FE70D37B27E27FCFFD70938" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH9021491CB056BE29CD693EF0FDE70721" xlink:label="HH9021491CB056BE29CD693EF0FDE70721" />
    <link:footnote xlink:type="resource" xlink:label="HHA187FE6C9F67FAB54C8188BEECD47DEE" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="border-collapse: collapse; width: 397pt;" border="0" width="529" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td class="xl55680" style="height: 15.0pt; width: 269pt;" width="359" height="20">Distributions to partners</td>
              <td class="xl55681" style="width: 48pt;" width="64">&#160;</td>
              <td class="xl55682" style="width: 80pt;" width="106">&#160;&#160;&#160;&#160;&#160;&#160; (60,020,000)</td>
