    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH9021491CB056BE29CD693EF0FDE70721" xlink:to="HHA187FE6C9F67FAB54C8188BEECD47DEE" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHAE37AA9D7011DAD2BEC298FC11B232EB" xlink:label="HHAE37AA9D7011DAD2BEC298FC11B232EB" />
    <link:footnote xlink:type="resource" xlink:label="HH29BEED235C30B14AF0762F5A5414BA0D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All system balancing gas recorded under the fixed asset method as defined by FERC Order 581.</span>
          <br style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;" />
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">Initial line pack is recorded in the plant account 117.1 (non-current). Any additional system gas volumes needed for load balancing, no notice transportation and other operational purposes is recorded in account 117.2 (current portion).</span>
          <br style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;" />
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">For purposes of accounting for encroachment resulting from line inventory changes, we used Account 117.4 with appropriate debits to Account 808.1 and credits to Account 808.2.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAE37AA9D7011DAD2BEC298FC11B232EB" xlink:to="HH29BEED235C30B14AF0762F5A5414BA0D" order="1" />
