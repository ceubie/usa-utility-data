            </td>
          </tr>
          <tr style="height:12pt">
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
          </tr>
          <tr>
            <td colspan="15" style="padding:1.5pt 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">ALL QUANTITIES OF GAS WERE SUBJECT TO COMMISSION REGULATION.</span>
            </td>
          </tr>
          <tr style="height:12pt">
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
          </tr>
          <tr>
            <td colspan="15" style="padding:1.5pt 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%">FOOTNOTE TO INSTRUCTION 10:</span>
            </td>
          </tr>
          <tr style="height:12pt">
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
            <td colspan="3" style="padding:0 1pt"/>
          </tr>
          <tr>
            <td colspan="15" style="padding:1.5pt 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">THERE ARE NO VOLUMES OF PIPELINE PRODUCTION FIELD SALES INCLUDED IN THE TOTAL SALES OR THE TOTAL TRANSPORTATION VOLUMES.</span>
            </td>
          </tr>
        </table>
      </div>
    </link:footnote>
