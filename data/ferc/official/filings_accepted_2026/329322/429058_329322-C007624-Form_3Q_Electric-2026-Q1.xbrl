        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-504_lbl" order="0" xlink:to="ft-504_340107_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-532_lbl" order="0" xlink:to="ft-532_340106_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-581_lbl" order="0" xlink:to="ft-581_340108_lbl" />
        <link:footnote xlink:label="ft-108_340101_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p>ER15-572, ER24-232, ER25-885 and ER26-893, which are recovered under the NYISO OATT.</p></link:footnote>
        <link:footnote xlink:label="ft-504_340107_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p style="text-align: left"><span style="color: rgba(0, 0, 0, 1); font-family: Roboto">ER15-572, ER24-232, ER25-885 and ER26-893, which are recovered under the NYISO OATT.</span><br /></p></link:footnote>
        <link:footnote xlink:label="ft-532_340106_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p style="text-align: left"><span style="color: rgba(51, 51, 51, 1); font-family: Roboto">See Page 328 for details.</span><br /></p></link:footnote>
        <link:footnote xlink:label="ft-581_340108_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p style="text-align: left"><span style="color: rgba(51, 51, 51, 1); font-family: Roboto">New York Independent System Operator ("NYISO") OATT, Section 6.13, Rate Schedule 13 and Section 13 and Section 36, Attachment DD.</span><br/></p></link:footnote>
