    <link:footnoteArc xlink:type="arc" xlink:from="value144" xlink:to="footnote144" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="144" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote145" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Operating and Maintenance expenses are based on Docket No. CP07-207, CP12-496, and CP19-56 amounts (updated for actual lease and FERC Account No. 858 expenses). Our methodology for cost allocation and rate design purposes may differ in a Section 4 rate filing.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This footnote also applies to line 1, column (h).</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value145" xlink:to="footnote145" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="145" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote146" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Default">
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <xhtml:span style="font-size: 18.0pt; color: windowtext;">Recorded pursuant to Docket No. AI93-5-000 issued April 23, 1993 (Accounting for Income Taxes). </xhtml:span>
            <xhtml:a style="mso-comment-reference: AR_1; mso-comment-date: 20250425T0843;">
              <xhtml:span style="font-size: 18.0pt; color: black; mso-themecolor: text1;">We estimate approximately $2.5 million of the ending balance is associated with projects granted non-traditional rate treatment that are reported on Page 217.</xhtml:span>
            </xhtml:a>
          </xhtml:span>
          <xhtml:span class="MsoCommentReference">
            <xhtml:span style="font-size: 8.0pt; font-family: 'Calibri',sans-serif; mso-ascii-theme-font: minor-latin; mso-hansi-theme-font: minor-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-theme-font: minor-bidi; color: black; mso-themecolor: text1;">
              <!-- [if !supportAnnotations]-->
            </xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value146" xlink:to="footnote146" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="146" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote148" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Amount reflected in Construction Work in Progress reduced by reimbursements from joint venture partner.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value148" xlink:to="footnote148" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="148" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote149" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 16pt;">Pursuant to Docket No. CP24-159-000, ten reciprocal engines were retired May 1, 2025, representing 12,360 horsepower. Two new turbines were installed May 20, 2025 with 10,602 ISO horsepower.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value149" xlink:to="footnote149" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="149" />
  </link:footnoteLink>
</xbrli:xbrl>
