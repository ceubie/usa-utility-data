&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 16pt;"&gt;&lt;font style="font-family: Arial; font-weight: bold;"&gt;2025&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 143.2pt; border-right: 1pt solid #000000; border-bottom: 4.5pt solid #000000; padding-right: 3.9pt; padding-left: 5.65pt; vertical-align: bottom;" colspan="2"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 16pt;"&gt;&lt;font style="font-family: Arial; font-weight: bold;"&gt;2024&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 23.75pt; -aw-height-rule: exactly;"&gt;
&lt;td style="width: 488.35pt; border-right: 1pt solid #000000; border-left: 1pt solid #000000; border-bottom: 1pt solid #000000; padding-right: 3.9pt; padding-left: 3.9pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;Current:&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
