    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value41" xlink:to="footnote41" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="41" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote42" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Excludes 4,221,221 Dth related to Boehm Keyes Zone which was abandoned pursuant to Order No. CP01-1-000, issued May 16, 2001.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value42" xlink:to="footnote42" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="42" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote43" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Includes the combined Certificated Storage Capacities of CIG Fields (Boehm, Flank, Fort Morgan, Latigo) plus Totem Field.</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal" style="mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">A composite average Btu of 1.069 per cubic foot at a pressure base of 14.73 was used to convert the Certificated Storage Capacities of CIG Fields (Boehm, Flank, Fort Morgan, Latigo) to Dth.</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal" style="mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">A composite average Btu of 1.074 per cubic foot at a pressure base of 14.73 was used to convert the Certificated Storage Capacities of CIG Field (Totem) to Dth.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value43" xlink:to="footnote43" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="43" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote47" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="tab-stops: .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Includes CIG Injection / Withdrawal Wells (Boehm, Flank, Fort Morgan, Latigo) + Totem Field Injection / Withdrawal Wells. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
