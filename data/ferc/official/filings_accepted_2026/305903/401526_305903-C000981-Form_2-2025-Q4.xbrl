    <link:footnoteArc xlink:type="arc" xlink:from="value123" xlink:to="footnote123" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="123" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote125" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">Kinder Morgan, Inc. directly owns 38.06% of Kinder Morgan Energy Partners, L.P. and 100% of Kinder Morgan GP LLC and KM Energy Inc.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value125" xlink:to="footnote125" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="125" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote126" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This project has separately tracked fuel retention rates. During 2025 we retained 17,423 Dth of gas from our shippers and we consumed 24,811 Dth of gas.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value126" xlink:to="footnote126" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="126" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote127" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This project has separately tracked fuel retention rates. During 2025 we retained 127,257 Dth of gas from our shippers and we consumed 155,828 Dth of gas.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value127" xlink:to="footnote127" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="127" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote128" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">High Plains Pipeline Original Application CP07-207</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">High Plains Pipeline Expansion CP12-496</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Kiowa Lateral CP19-56</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value128" xlink:to="footnote128" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="128" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote130" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Represents the net capital lease as recorded in Account 101.1.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value130" xlink:to="footnote130" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="130" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote131" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Represents the net capital lease as recorded in Account 101.1.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value131" xlink:to="footnote131" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="131" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote133" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Operating and Maintenance expenses are based on the Docket No. CP08-30 Exhibit N plus the appropriate lease expense. Our methodology for cost allocation and rate design purposes may differ in a Section 4 rate filing.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This footnote also applies to line 2, column (h).</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value133" xlink:to="footnote133" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="133" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote135" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Operating and Maintenance expenses are based on the Docket No. CP09-464 Exhibit N. Our methodology for cost allocation and rate design purposes may differ in a Section 4 rate filing.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This footnote also applies to line 3, column (h).</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value135" xlink:to="footnote135" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="135" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote136" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Operating and Maintenance expenses are based on the Docket No. CP10-486 Exhibit N. Our methodology for cost allocation and rate design purposes may differ in a Section 4 rate filing. </xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This footnote also applies to line 4, column (h).</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value136" xlink:to="footnote136" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="136" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote137" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Other expenses (including taxes) are allocated based on assessed value. Our methodology for cost allocation and rate design purposes may differ in a Section 4 rate filing.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value137" xlink:to="footnote137" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="137" />
