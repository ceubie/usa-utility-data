    <link:footnoteArc xlink:type="arc" xlink:from="value98" xlink:to="footnote98" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="98" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote99" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 24px;">Amounts charged by Kinder Morgan, Inc. through shared services are allocated using the modified Massachusetts Formula.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value99" xlink:to="footnote99" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="99" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote101" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18pt; line-height: 107%; font-family: arial, helvetica, sans-serif;">Excludes $77,314 that relates to fuel consumed under affiliate transportation agreements.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value101" xlink:to="footnote101" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="101" />
