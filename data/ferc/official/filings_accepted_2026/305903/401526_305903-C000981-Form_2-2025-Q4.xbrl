        <xhtml:p class="Default">
          <xhtml:span style="font-size: 18.0pt; color: windowtext;">
            <xhtml:span style="font-family: arial, helvetica, sans-serif;">Excludes 29,349 Dth that relates to fuel consumed under affiliate transportation agreements.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value102" xlink:to="footnote102" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="102" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote103" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Totem Storage Field is operated by us under a long-term lease with WYCO Development LLC.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value103" xlink:to="footnote103" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="103" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote104" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Young Storage Field is owned by Young Gas Storage Company, Ltd. 90% of the capacity is held by us under a long-term agreement.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value104" xlink:to="footnote104" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="104" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote105" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">A BTU of 1.069 per cubic foot at a pressure base of 14.73 was used to convert the "Maximum Daily Delivery Capacity of Facility to Dth.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value105" xlink:to="footnote105" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="105" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote107" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">A BTU of 1.069 per cubic foot at a pressure base of 14.73 was used to convert the "Maximum Daily Delivery Capacity of Facility to Dth.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value107" xlink:to="footnote107" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="107" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote108" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 24px;">A BTU of 1.069 per cubic foot at a pressure base of 14.73 was used to convert the "Maximum Daily Delivery Capacity of Facility to<xhtml:span style="font-size: 18pt;"></xhtml:span></xhtml:span>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Dth.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value108" xlink:to="footnote108" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="108" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote109" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">A BTU of 1.074 per cubic foot at a pressure base of 14.73 was used to convert the "Maximum Daily Delivery Capacity of Facility to Dth.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value109" xlink:to="footnote109" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="109" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote110" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="background-color: #f5f5f5; font-family: arial, helvetica, sans-serif; font-size: 24px;">A BTU of 1.101 per cubic foot at a pressure base of 14.73 was used to convert the "Maximum Daily Delivery Capacity of Facility to Dth.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value110" xlink:to="footnote110" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="110" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote111" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 24px;">A BTU of 1.069 per cubic foot at a pressure base of 14.73 was used to convert the "Maximum Daily Delivery Capacity of Facility to </xhtml:span>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Dth.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value111" xlink:to="footnote111" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="111" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote112" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">As of December 31, 2025, we estimate that no deferred tax balance in Account 283 could be used in the development of jurisdictional recourse rates.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value112" xlink:to="footnote112" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="112" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote113" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 24px;">As of December 31, 2024</xhtml:span>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 24px;">, we estimate that no deferred tax balance in Account 283 could be used in the development of jurisdictional recourse rates.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value113" xlink:to="footnote113" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="113" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote115" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 24px;">Amounts charged are based on Kinder Morgan, Inc.'s other compensation and benefit expenses and are allocated to us based on the distribution of direct labor charges (excluding overtime and special pay).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value115" xlink:to="footnote115" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="115" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote119" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Operated by us under a long-term lease with WYCO Development LLC.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value119" xlink:to="footnote119" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="119" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote121" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">KM Energy LLC is a direct wholly-owned subsidiary of KM Energy Inc.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value121" xlink:to="footnote121" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="121" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote122" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table class="MsoTableGrid" style="border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 16.65pt;">
              <xhtml:td style="width: 455.4pt; border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: 16.65pt;" valign="bottom" width="607">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 174.7pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 3.0pt; border-right: solid windowtext 1.0pt; mso-border-left-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext 3.0pt; padding: 0in 5.4pt 0in 5.4pt; height: 16.65pt;" valign="bottom" width="233">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Dth (e)</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 57.0pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 3.0pt; border-right: none; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext 3.0pt; padding: 0in 5.4pt 0in 5.4pt; height: 16.65pt;" valign="top" width="76">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 176.65pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 3.0pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext 3.0pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: 16.65pt;" valign="bottom" width="236">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Dollars (i)</xhtml:span>
                </xhtml:p>
              </xhtml:td>
