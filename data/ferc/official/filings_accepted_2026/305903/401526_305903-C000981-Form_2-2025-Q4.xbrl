                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">23.00%</xhtml:span>
                </xhtml:p>
