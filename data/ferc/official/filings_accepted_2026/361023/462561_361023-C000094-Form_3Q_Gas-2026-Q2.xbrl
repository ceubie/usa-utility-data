  <ferc:OrderNumber id="HH891511E2F509203E54689EC9E4403329" contextRef="HH21F2B570B146E09B85F535C8A9225D0C" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HHDB4985C1B1D2EA1E499D0C31EF970AF4" xlink:label="HHDB4985C1B1D2EA1E499D0C31EF970AF4" />
    <link:footnote xlink:type="resource" xlink:label="HH83CDCA7BCA1192F4334CB421699F6B2A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All system balancing gas recorded under the fixed asset method as defined by FERC Order 581. Initial line pack is recorded in the plant account 117.1 (non-current).</span>
          <br style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;" />
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">Any additional system gas volumes needed for load balancing, no notice transportation and other operational purposes is recorded in account 117.2 (current portion).</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHDB4985C1B1D2EA1E499D0C31EF970AF4" xlink:to="HH83CDCA7BCA1192F4334CB421699F6B2A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHABBF724CBBE08A25C268A9E1B87ED480" xlink:label="HHABBF724CBBE08A25C268A9E1B87ED480" />
    <link:footnote xlink:type="resource" xlink:label="HHCFDDEFF32AA4079546D277A3558D3C6B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%">On March 18, 1992, FERC approved an uncontested settlement ("Settlement") in Texas Eastern Transmission Corp., 58 FERC 61,295 (1992). The order approving the Settlement became final on April 17, 1992. The compliance tariff filing, submitted April 24, 1992, was accepted by the Commission on June 17, 1992. Rates for twenty-four annual periods under the Settlement have also been filed and approved by the Commission. On August 9, 2017 Texas Eastern Transmission, LP refiled a Joint Settlement Extension Agreement (2017 Settlement Extension) to extend the Joint Stipulation and Agreement orignally approved by the Commission in Docket No. RP88-67-000 on March 18, 1992. On October 10, 2017 the Commission approved the filing to extend the 1992 Settlement from March 18, 2017 through November 30, 2027.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHABBF724CBBE08A25C268A9E1B87ED480" xlink:to="HHCFDDEFF32AA4079546D277A3558D3C6B" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH20B0907611F5DDE5E9BCD40D11A12BD1" xlink:label="HH20B0907611F5DDE5E9BCD40D11A12BD1" />
    <link:footnote xlink:type="resource" xlink:label="HHB27DF5F1D1CFA06107B4DAF21EEA6575" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%">On March 18, 1992, FERC approved an uncontested settlement ("Settlement") in Texas Eastern Transmission Corp., 58 FERC 61,295 (1992). The order approving the Settlement became final on April 17, 1992. The compliance tariff filing, submitted April 24, 1992, was accepted by the Commission on June 17, 1992. Rates for twenty-four annual periods under the Settlement have also been filed and approved by the Commission. On August 9, 2017 Texas Eastern Transmission, LP refiled a Joint Settlement Extension Agreement (2017 Settlement Extension) to extend the Joint Stipulation and Agreement orignally approved by the Commission in Docket No. RP88-67-000 on March 18, 1992. On October 10, 2017 the Commission approved the filing to extend the 1992 Settlement from March 18, 2017 through November 30, 2027.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH20B0907611F5DDE5E9BCD40D11A12BD1" xlink:to="HHB27DF5F1D1CFA06107B4DAF21EEA6575" order="1" />
