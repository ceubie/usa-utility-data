    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7A5D6AE5A1D5F0F0A1BCEDA265CFCBDE" xlink:to="HH785150E6A05D2365C3DB475EC8293A19" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH3EA8C53ACB48F8C2EF6C7B76841E2237" xlink:label="HH3EA8C53ACB48F8C2EF6C7B76841E2237" />
    <link:footnote xlink:type="resource" xlink:label="HHB6EA55E65DE6C1AAD067549406AE8A71" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%">Relates to the establishment of a regulatory liability as a result of the U.S. tax reform legislation dated December 22, 2017.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH3EA8C53ACB48F8C2EF6C7B76841E2237" xlink:to="HHB6EA55E65DE6C1AAD067549406AE8A71" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH8010D7847A1AE824B8E36BFAE6FF9CF0" xlink:label="HH8010D7847A1AE824B8E36BFAE6FF9CF0" />
    <link:footnote xlink:type="resource" xlink:label="HH9E08E62BFBFAEDF9762D3EABB3177C4C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%">Texas Eastern estimates that the Deferred Income Tax Adjustment Gross-Up would not be included in the rate base used in the development of jurisdictional rates.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH8010D7847A1AE824B8E36BFAE6FF9CF0" xlink:to="HH9E08E62BFBFAEDF9762D3EABB3177C4C" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF449327C9D2C975F0938E7D56C9462C7" xlink:label="HHF449327C9D2C975F0938E7D56C9462C7" />
    <link:footnote xlink:type="resource" xlink:label="HH9943774855D7E7BD701A3CD8E1322EBB" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 14.6667px;">On March 18, 1992, FERC approved an uncontested settlement ("Settlement") in the Texas Eastern Transmission Corp., 58 FERC 61,295 (1992). The order approving the Settlement became final on April 17, 1992. The compliance tariff filing, submitted April 24, 1992, was accepted by the Commission on June 17, 1992. Rates for twenty-four annual periods under the Settlement have also been filed and approved by the Commission. On August 9, 2017 Texas Eastern Transmission, LP refiled a Joint Settlement Extension Agreement (2017 Settlement Extension) to extend the Joint Stipulation and Agreement originally approved by the Commission in Docket No. RP88-67-000 on March 18, 1992. On October 10, 2017 the Commission approved the filing to extend the 1992 Settlement from March 18, 2017 through November 30, 2027.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF449327C9D2C975F0938E7D56C9462C7" xlink:to="HH9943774855D7E7BD701A3CD8E1322EBB" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH8EA594348627E7B078B3D67CAA5CA604" xlink:label="HH8EA594348627E7B078B3D67CAA5CA604" />
    <link:footnote xlink:type="resource" xlink:label="HHF747E6FD9C8479EB74C9257C352BDF97" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
