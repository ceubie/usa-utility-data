pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 233.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;Construction in progress&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 52.2pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 2.25pt double rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;521,609&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.3pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54.35pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 1.5pt double rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;435,796&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.18pt; margin-bottom: 7pt; text-indent: -40.18pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;(5)&lt;/span&gt;&lt;span style="width: 27.35pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Contracts and Commitments&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;The Company has various contracts in support of the projects in the construction phase. The primary contracts for each project are discussed below, and the total contract values total $1.8 billion.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;As of December 31, 2025 and 2024, the Company incurred total costs of $388.5 million and $277.5 million, respectively, under these agreements which are included in Property and equipment on the accompanying balance sheets. Of this amount, $5.0 million and $4.7 million, respectively, remain in Accrued retainage payable on the accompanying balance sheets.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(a)&lt;/span&gt;&lt;span style="width: 14.17pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Engineering, Procurement and Construction Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In December 2020, the Company and an unaffiliated third party entered into agreements for engineering, procurement and construction (EPC) for the Gates Project and RM Project. The unaffiliated third party agreed to perform necessary work and services required for the design, engineering and permitting, the procurement of some materials and equipment for construction, assembly, installation, commissioning, start-up, training and testing. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;Additionally, in July 2024, the Company and the unaffiliated third party entered into an engineering, procurement and commissioning agreement (EPCA) for the HVDC converter stations for the Newark Project and Metcalf Project. The unaffiliated third party agreed to perform all necessary work and services required for the design and engineering, the procurement of certain equipment materials as are required to be incorporated into the HVDC converter stations, observation of and assistance with the construction assembly and installation by other contractor and contractor's commissioning start-up and testing of the HVDC converter stations.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;No changes to the work are permitted except in accordance with a duly issued change order executed by both parties authorizing such changes. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(b)&lt;/span&gt;&lt;span style="width: 14.17pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Engineering, Procurement and Construction Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-align: justify; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In December 2020, the Company and an unaffiliated third party entered into an EPC agreement for the RM Project. The unaffiliated third party agreed to perform necessary work and services required for the design, engineering and permitting, the procurement of some materials and equipment for construction, assembly, installation, commissioning, start-up, training and testing. No changes to the work are permitted except in accordance with a duly issued change order executed by both parties authorizing such changes. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In July 2024, the Company and the unaffiliated third party entered into EPC agreements for the Manning Project and Collinsville Project. The unaffiliated third party agreed to perform necessary work and services required for the design, engineering and permitting, the procurement of some materials and equipment for construction, assembly, installation, commissioning, start-up, training and testing. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(c)&lt;/span&gt;&lt;span style="width: 14.79pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Construction and Procurement Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In January 2023, the Company and an unaffiliated third party entered into an agreement for construction and procurement services for the Gates Project. The unaffiliated third party agreed to perform civil construction work for the entire site and all electrical/mechanical installation work not performed by another third party. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In January 2024, the Company and the unaffiliated third party entered into an agreement for construction and procurement services for the RM Project. The unaffiliated third party agreed to perform civil construction work for the entire site and all electrical/mechanical installation work not performed by other third parties.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;No changes to the work are permitted except in accordance with a duly issued change order executed by both parties authorizing such changes. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(d)&lt;/span&gt;&lt;span style="width: 14.17pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Engineering, Procurement and Construction Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In January 2024, the Company and an unaffiliated third party entered into EPC agreements for the Collinsville Project and Manning Project. The unaffiliated third party agreed to perform necessary work and services required for the design, engineering and permitting, the procurement of some materials and equipment for construction, assembly, installation, commissioning, start-up, training and testing. No changes to the work are permitted except in accordance with a duly issued change order executed by both parties authorizing such changes. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(e)&lt;/span&gt;&lt;span style="width: 14.79pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Conductor Supply Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In April 2024, the Company and an unaffiliated third party entered into conductor supply agreement for Collinsville Project. In 2024, the estimated conductor supply price was reduced as a result of less cable used than originally estimated. The unaffiliated third party processed a refund to the Company in 2025 equal to 20% of the change in conductor supply price. The unaffiliated third party agreed to perform necessary work and services required for the design, engineering, procurement, fabrication, supply and transport of, and provide installation support for the conductor. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(f)&lt;/span&gt;&lt;span style="width: 16.01pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Conductor Engineering and Installation Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In September 2024, the Company and an unaffiliated third party entered into conductor engineering, procurement and installation agreement for underground transmission circuits for the Newark Project and Metcalf Project. The unaffiliated third party agreed to provide and perform all services, work, labor, material and equipment necessary for the design, engineering, procurement, permitting, fabrication, supply, transport, assembly, installation, commissioning, start-up and testing of the conductor. No changes to the work are permitted except in accordance with a duly issued change order executed by both parties authorizing such changes. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(g)&lt;/span&gt;&lt;span style="width: 14.17pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Structure Supply Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In September 2025, the Company entered into a Structure Supply Agreement with an unaffiliated third party for the Manning Project. The agreement covers the design, fabrication, and delivery of tubular steel transmission structures for an approximately 11-mile double-circuit 230 kV overhead transmission line in Fresno County, California. The contract includes delivery milestones scheduled in coordination with construction activities.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(h)&lt;/span&gt;&lt;span style="width: 13.56pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;HVDC Terminal Engineering, Procurement and Construction Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In October 2025, the Company entered into an EPC Agreement with an unaffiliated third party for the Metcalf Project. The contract covers design, procurement, construction, and commissioning of two 320 kV HVDC terminals and related 500 kV/230 kV AC switchyards. No changes to the work are permitted except in accordance with a duly issued change order executed by both parties authorizing such changes. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(i)&lt;/span&gt;&lt;span style="width: 16.62pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Transmission Line Procurement and Construction Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In September 2025, the Company executed a Transmission Line Procurement and Construction Agreement with an unaffiliated third party for the Metcalf Project underground transmission lines. The agreement covers approximately 14 miles of 320 kV HVDC and 500 kV AC duct-bank construction.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In September 2025, the Company entered into a procurement and construction agreement with the unaffiliated third party for the Newark Project, which covers the engineering, procurement, construction, installation, and testing of overhead and underground transmission facilities, including foundations, structures, conductors, and associated equipment associated with the 230 kV Transmission Line Project. No changes to the work are permitted except in accordance with a duly issued change order executed by both parties authorizing such changes. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(j)&lt;/span&gt;&lt;span style="width: 16.62pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Transmission Line Procurement and Construction Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In December 2025, the Company executed a Transmission Line Procurement and Construction Agreement with an unaffiliated third party for the Manning Project. The contract includes procurement, installation, stringing, and commissioning of approximately 11.5 miles of double-circuit 230 kV overhead transmission line, including interconnections at the Manning and Tranquility substations. The contract includes a guaranteed completion date of September 2027.No changes to the work are permitted except in accordance with a duly issued change order executed by both parties authorizing such changes. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(k)&lt;/span&gt;&lt;span style="width: 14.17pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Electric Interconnection Agreement &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In October 2022, the Company and PG&amp;amp;E entered into an agreement for interconnection of the Gates Project's substation. The agreement provides for PG&amp;amp;E to design and procure the interconnection facilities and network upgrades. PG&amp;amp;E will own, control and operate interconnection facilities once completed. PG&amp;amp;E will also pay for all of the interconnection facilities and network upgrades.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In December 2024, the Company and PG&amp;amp;E entered into an agreement for interconnection of the RM Project's substation. The agreement provides for PG&amp;amp;E to design and procure the interconnection facilities and network upgrades. PG&amp;amp;E will own, control and operate interconnection facilities once completed. PG&amp;amp;E will also pay for all of the interconnection facilities and network upgrades.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(l)&lt;/span&gt;&lt;span style="width: 16.62pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Land&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In December 2025, the Company exercised their option to purchase 40 acres of land in Fresno County, California for the Manning substation site for $1.0 million dollars. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;The Company has an option to purchase approximately 14 acres of additional property for construction of the Metcalf Project. This option was not exercised as of December 31, 2025.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;The Company has various long term contractual and commercial commitments of which the significant contracts have been previously discussed in this note and note 6, which further discusses lease agreements.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.18pt; margin-bottom: 7pt; text-indent: -40.18pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;(6)&lt;/span&gt;&lt;span style="width: 27.35pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Leases&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In August 2023 the Company entered into a non&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span&gt;cancellable operating lease for an office space. The lease commenced on March&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;1, 2024 and the term of the lease was three years and one month. The lease includes an option to renew for an additional term of three years. In 2025, the Company determined it plans to exercise the three year extension at the end of the initial lease term.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;Lease payments are payable on a monthly basis. Lease payments under this agreement escalate over the lease term by a fixed percentage. The Company does not have any leases that contain variable lease payments.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The Company has no leases which contain residual value guarantees provided by the Company.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In 2025, the Company recognized an operating lease liability and related ROU asset, both in the amount of $189 thousand, for the lease modification noted above. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;For the years ended December 31, 2025 and 2024, the operating lease cost and related cash flows are as follows (in thousands):&lt;/span&gt;&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 460.7pt; margin-left: 21.8pt; border-col