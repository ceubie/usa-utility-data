td&gt; 					&lt;td style="width: 7.5pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;$&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.2pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;81,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.5pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 66.8pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;70,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 11.8pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.1pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;2037&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.95pt"&gt; 					&lt;td colspan="7" style="width: 195.65pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;Assumed Term Loan&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.5pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.2pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;294,500&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.5pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 66.8pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;--&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 11.8pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.1pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;2029&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 20.1pt"&gt; 					&lt;td style="width: 6pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6.05pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 136.6pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;Total&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.5pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;$&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.2pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 2.25pt double rgba(0, 0, 0, 1); padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;375,500&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.5pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 66.8pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 2.25pt double rgba(0, 0, 0, 1); padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;70,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 11.8pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.1pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;At December 31, 2025 and 2024the unamortized debt issuance and deferred financing costs associated with the Term Loan totaled $1.0 million, and the unamortized debt issuance and deferred financing costs associated with the Revolving Loan Facility totaled $59thousand and $64 thousand, respectively. The amortization of these costs is reflected as a component of Interest expense, net on the accompanying statements of operations. For the years ended December 31, 2025 and 2024amortization of such costs was $88 thousand and $86 thousand, respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;At December 31, 2025 unamortized debt issuance and deferred financing costs associated with the Assumed Term Loan totaled $7.4 million, and the unamortized debt issuance and deferred financing costs associated with the Assumed Revolving Loan Facility totaled $549 thousand. The amortization of these costs is reflected as a component of Interest expense, net on the accompanying statement of operations. For the years ended December 31, 2025 amortization of such costs was $1.4 million.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(a)&lt;/span&gt;&lt;span style="width: 14.17pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Credit Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;On February 3, 2022, the Company executed a credit agreement with three lenders (the Credit Agreement). The Credit Agreement consists of:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 90pt; margin-bottom: 10pt; text-indent: -18pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span&gt;(i)&lt;/span&gt;&lt;span style="width: 7.62pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;$81&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;million Term Loan Facility (Term Loan) to use for the construction costs and,&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 90pt; margin-bottom: 10pt; text-indent: -18pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span&gt;(ii)&lt;/span&gt;&lt;span style="width: 4.56pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;$5 million Revolving Facility (Revolver) to use solely for project costs, working capital and general corporate purposes.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;The Credit Agreement requires compliance with affirmative and negative covenants, including, among other things, financial statement reporting requirements and limitations surrounding further consolidations and mergers without formal approval of the creditors. The Company was in compliance with all covenants as of December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;The Credit Agreement specifies a maturity date as the earlier of the twelfth anniversary of the commercial operation date or the fifteenth anniversary of the closing date. All loans are due and payable at the maturity date. Voluntary prepayments prior to the maturity date are permitted under the Credit Agreement. As of December 31, 2025 and 2024 there was $81.0 million and $70.0 million, respectively, outstanding under the Term Loan. At both December 31, 2025 and 2024, there were no balances outstanding under the Revolver.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;The Credit Agreement permits both base rate loans and Secured Overnight Financing Rate (SOFR) loans. The interest rate on SOFR loans is equal to the SOFR rate plus the applicable margin that ranges between 1% - 1.375%. The interest rate on base rate loans is equal to the prime rate plus the applicable margin that ranges between 0.00% - 0.375%.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;A commitment fee equal to 0.25% per annum on the unused portion of the Term Loan and Revolver is payable quarterly until the commitments are terminated. During 2025 and 2024, the Company incurred $21 thousand and $90 thousand, respectively of commitment fees and they are recorded in Interest expense, net in the accompanying statements of operations.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 7pt; text-indent: -27pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(b)&lt;/span&gt;&lt;span style="width: 14.17pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Holdco Credit Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In 2024, California Holdings and six lenders entered into a credit agreement (the Holdco Credit Agreement) to fund construction costs for the Manning Project, Metcalf Project, Collinsville Project, and Newark Projects. The Holdco Credit Agreement consisted of a $600.0 million term loan facility and a $50.0 million revolving facility. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;During 2024, California Holdings borrowed $81.0 million under the Holdco Credit Agreement in support of construction costs. As of December 31, 2024, after borrowings, payments for closing costs and interest, there was available capacity totaling $499.5 million under the term loan facility and $50.0 million under the revolving facility. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;In 2025, the Company received the state and federal approvals required to incur debt in support of construction for these projects. In accordance with the Holdco Credit Agreement, California Holdings can assign all rights and obligations under the Holdco Credit Agreement to the Company. In May 2025, the Company assumed all rights and obligations under the $650.0 million credit facility previously entered into by California Holdings, consisting of a $600.0 million term loan facility (Assumed Term Loan) and a $50.0 million revolving facility (Assumed Revolver). At the time of the assumption, the credit facility had outstanding borrowings of $188.5 million, unamortized debt issuance costs of $9.3 million, and accrued interest and debt fees of $1.7 million. During the remainder of 2025, the Company borrowed an additional $106.0 million under this facility for total outstanding borrowings of $294.5 million as of December 31, 2025. The Assumed Term Loan and Assumed Revolver have available capacity totaling $305.5 million and $50.0 million, respectively, as of December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;A commitment fee equal to 0.5% per annum on the unused portion of the Term Loan and Revolver associated with the Holdco Credit Agreement is payable quarterly until the commitments are terminated. During 2025, the Company incurred $1.3 million of commitment fees and they are recorded in Interest expense, net in the accompanying statements of operations. As of December&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31, 2025, the Company recognized $83 thousand in LOC fee expense related to the Credit Agreement.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 40.18pt; margin-bottom: 7pt; text-indent: -40.18pt; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;(8)&lt;/span&gt;&lt;span style="width: 27.35pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Derivative Instruments and Hedging Activities &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;The Company enters into interest rate swaps to reduce its exposure to market risks from changing interest rates. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;On February 22, 2022, the Company entered into an interest rate swap for the period from March 29, 2024 through December 31, 2036 with an initial amortizing notional amount of $72.9 million that carries a fixed interest rate of 1.974% to hedge interest rate risk associated with Company's Term Loan. This swap was designated as a cash flow hedge at inception under ASC 815. As of December 31, 2025 and 2024, the swap had an aggregate notional amount of $69.6 million and $72.1million, respectively.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;As of December 31, 2025 and 2024, the Company had approximately $9.6 million and $12.0 million, respectively of income in AOCI included in Member's Equity related to its interest rate swap cash flow hedge. Approximately $1.0 million of gain is expected to be reclassified from AOCI into earnings over the next 12 months. During 2025 and 2024, the Company received $1.6 million and $1.7 of settlement payments, respectively. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 7pt; text-align: justify; page-break-inside: avoid; page-break-after: avoid; widows: 2; orphans: 2"&gt; 				&lt;span style="font-weight: bold; font-style: italic"&gt;Fair Value Measurements&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;The following table sets forth by level within the fair value hierarchy, the assets and liabilities of the Company that were accounted for at fair value on a recurring basis as of December 31, 2025 and 2024. These assets and liabilities are classified in their entirety based on the lowest level of input that is significant to the fair value measurement. The assessment of the significance of a particular input to the fair value measurement requires judgment and may affect the valuation of fair value assets and liabilities and their placement within the fair value hierarchy levels. The three levels of the fair value hierarchy defined by ASC 820 are as follows:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 63.35pt; margin-bottom: 10pt; text-indent: -18pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&lt;/span&gt;&lt;span style="width: 12.94pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;Level 1 - Quoted prices are available in active markets for identical assets or liabilities as of the reporting date. Active markets are those in which transactions for the asset or liability occur in sufficient frequency and volume to provide pricing information on an ongoing basis.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 63.35pt; margin-bottom: 10pt; text-indent: -18pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&lt;/span&gt;&lt;span style="width: 12.94pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;Level 2 - Pricing inputs are other than quoted prices in active markets included in Level 1, which are either directly or indirectly observable as of the reporting date. Level 2 includes those financial instruments that are valued using models or other valuation methodologies. These models are primarily industry standard models that consider various assumptions, including quoted forward prices for commodities, time value, volatility factors and current market and agreement prices for the underlying instruments, as well as other relevant economic measures. Substantially all of these assumptions are observable in the marketplace throughout the full term of the instrument, can be derived from observable data or are supported by observable levels at which transactions are executed in the marketplace.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 63.35pt; margin-bottom: 10pt; text-indent: -18pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;&lt;span style="font-family: Symbol"&gt;&lt;/span&gt;&lt;span style="width: 12.94pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;Level 3 - Pricing inputs include significant inputs that are generally less observable from objective sources. These inputs may be used with internally developed methodologies that result in management's best estimate of fair value.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 				&lt;span&gt;The following tables present assets and liabilities measured and recorded at fair value on the Company's balance sheets and their level within the fair value hierarchy as of December 31, 2025 and 2024(in thousands):&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 460.7pt; margin-left: 21.95pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr style="height: 19pt"&gt; 					&lt;td style="width: 127.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: justify; widows: 2; orphans: 2"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="8" style="width: 237.05pt; border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&lt;span style="font-weight: bold"&gt;Fair value as of December 31, 2025&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 14.4pt"&gt; 					&lt;td colspan="2" style="width: 200.35pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; widows: 2; orphans: 2"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6.05pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; widows: 2; orphans: 2"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 42.65pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&lt;span style="font-weight: bold"&gt;Level 1&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.75pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 37.8pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&lt;span style="font-weight: bold"&gt;Level 2&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.75pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 37.8pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&lt;span style="font-weight: bold"&gt;Level 3&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.75pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 38.8pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&lt;span style="font-weight: bold"&gt;Total&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="border-top: 0.75pt solid rgba(0, 0, 0, 1); vertical-align: top"&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 14.4pt"&gt; 					&lt;td colspan="2" style="width: 200.35pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; widows: 2; orphans: 2"&gt; 							&lt;span&gt;Interest rate swap&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6.05pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; widows: 2; orphans: 2"&gt; 							&lt;span&gt;$&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 42.65pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&lt;span&gt;__&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.75pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center; widows: 2; orphans: 2"&gt; 							&