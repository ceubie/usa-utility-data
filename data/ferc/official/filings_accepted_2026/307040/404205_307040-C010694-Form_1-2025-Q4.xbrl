ts are as follows (in thousands):&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 460.7pt; margin-left: 24.45pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr style="height: 12.95pt"&gt; 					&lt;td style="width: 6pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6.05pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6.05pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 124.75pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.5pt; padding-right: 2.9pt; padding-left: 2.9pt; vertica