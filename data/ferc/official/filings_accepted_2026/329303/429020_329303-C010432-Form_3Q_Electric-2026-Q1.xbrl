  <ferc:OrderNumber id="HH14879CD7713C2CF384A1F5F69CF24F80" contextRef="HH99B347CA55291FCD7DCD65D79B7C04BF" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <ferc:OrderNumber id="HHB23F1286521CA76786E11B352FC71EE9" contextRef="HH006DBFC2F4F7462B2FC04BDF72CF956F" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <ferc:OrderNumber id="HH618B8EB915F51FBDE0185E09984398CB" contextRef="HHC7B22436537E14E8B0B3B50E62FBDD9A" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH71CC8BCF6E03DDE540AC747CD4F4D523" xlink:label="HH71CC8BCF6E03DDE540AC747CD4F4D523" />
    <link:footnote xlink:type="resource" xlink:label="HHCFFAE11625070C24E642762114756CED" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">Southwest Water Authority is a member of McKenzie Electric Cooperative, Inc. and purchases electric service and wheeling services.&#160;&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH71CC8BCF6E03DDE540AC747CD4F4D523" xlink:to="HHCFFAE11625070C24E642762114756CED" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7B324823FB552071AB650DA22A22B254" xlink:label="HH7B324823FB552071AB650DA22A22B254" />
    <link:footnote xlink:type="resource" xlink:label="HHC916784988A03F4F359BCA21CED122A7" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">Western Area Power Administration is a power marketing administration within the U.S. Department of Energy whose role is to market and transmit electricity from multi-use water projects to preference customers.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7B324823FB552071AB650DA22A22B254" xlink:to="HHC916784988A03F4F359BCA21CED122A7" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7B512BEE097D9FE5FA1F768A1B13CFCE" xlink:label="HH7B512BEE097D9FE5FA1F768A1B13CFCE" />
    <link:footnote xlink:type="resource" xlink:label="HHB6A243492F139D3446C6B83ED92C0FAC" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">Southwest Water Authority is a preference customer of WAPA and received an allocation of power for one of their water pumping stations in McKenzie Electric Cooperative, Inc.&#8217;s service area.&#160;&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7B512BEE097D9FE5FA1F768A1B13CFCE" xlink:to="HHB6A243492F139D3446C6B83ED92C0FAC" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH4082CB7B5326455126A4C76CEBA5B2A4" xlink:label="HH4082CB7B5326455126A4C76CEBA5B2A4" />
    <link:footnote xlink:type="resource" xlink:label="HH00C1A4C1F87F28B8D27416EE78A08D43" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">MegaWatt Hours Received and MegaWatt Hours Delivered will equal as represented by the actual delivery.&#160; However, due to timing issues, the meter reading used to bill Southwest Water their wheeling charges is an additional meter used to read and bill usage prior to receipt of Western Area Power Administration transmission delivery invoice of actual MegaWatt hours delivered.&#160; The wheeling MegaWatt Hours and charges are trued-up annually (in the following period) based on actual receipt and delivery of MegaWatt Hours.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH4082CB7B5326455126A4C76CEBA5B2A4" xlink:to="HH00C1A4C1F87F28B8D27416EE78A08D43" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0512CB9DD30CA5ADC015217C9D2B49D1" xlink:label="HH0512CB9DD30CA5ADC015217C9D2B49D1" />
    <link:footnote xlink:type="resource" xlink:label="HH971E00A3F2AB485F018C0D237E6D834B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">Other Charges represents a monthly facility charge.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0512CB9DD30CA5ADC015217C9D2B49D1" xlink:to="HH971E00A3F2AB485F018C0D237E6D834B" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>