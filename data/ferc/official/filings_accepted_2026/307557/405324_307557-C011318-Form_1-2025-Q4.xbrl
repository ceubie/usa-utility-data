&lt;p style="font: 13pt Arial, Helvetica, Sans-Serif; margin: 0pt 0pt 12pt; text-indent: 0pt; text-align: center"&gt;&lt;font style="color: #16161A; letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/font&gt;&lt;/p&gt;


    &lt;div style="margin-top: 6pt; margin-bottom: 6pt"&gt;&lt;p style="margin: 0pt"&gt;&amp;#160;&amp;#160;&lt;/p&gt;&lt;/div&gt;
    &lt;div style="break-before: page; margin-top: 6pt; margin-bottom: 6pt"&gt;&lt;p style="margin: 0pt"&gt;&amp;#160;&lt;/p&gt;&lt;/div&gt;
    

&lt;p style="font: 13pt Arial, Helvetica, Sans-Serif; margin: 0pt 0pt 12pt; text-align: center"&gt;&lt;font style="color: #16161A; letter-spacing: -0.1pt"&gt;&lt;/font&gt;&lt;/p&gt;

&lt;p style="font: 11pt Arial, Helvetica, Sans-Serif; margin: 0pt 0pt 12pt; text-indent: 0pt; text-align: center; color: #08050C"&gt;&lt;b&gt;NORTHWESTERN WISCONSIN ELECTRIC &lt;font style="letter-spacing: -0.1pt"&gt;COMPANY&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;

&lt;p style="font: 11pt Arial, Helvetica, Sans-Serif; margin: 0pt 0pt 12pt; text-indent: 0pt; text-align: center; color: #08050C"&gt;&lt;b&gt;SCHEDULE OF OPERATION
AND MAINTENANCE &lt;font style="letter-spacing: -0.1pt"&gt;EXPENSE&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;

&lt;p style="font: 11pt Arial, Helvetica, Sans-Serif; margin: 0pt 0pt 12pt; text-indent: 0pt; text-align: center; color: #08050C"&gt;&lt;b&gt;For
the Years Ended December 31, 2025 and &lt;font style="letter-spacing: -0.2pt"&gt;2024&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;

&lt;p style="font: 10.5pt Arial, Helvetica, Sans-Serif; text-indent: 0pt; margin: 0pt 0pt 12pt"&gt;&amp;#160;&lt;/p&gt;

&lt;div style="margin: 3pt auto; width: 100%"&gt;&lt;div style="font-size: 1pt; border-top: Black 1pt solid"&gt;&amp;#160;&lt;/div&gt;&lt;/div&gt;

&lt;p style="font: 10.5pt Arial, Helvetica, Sans-Serif; margin: 0pt 0pt 12pt; text-indent: 0pt"&gt;&lt;/p&gt;

&lt;p style="margin: 0pt 0pt 12pt; text-indent: 0pt"&gt;&lt;/p&gt;

&lt;table cellpadding="0" cellspacing="0" style="border-collapse: collapse; width: 100%; font: 10.5pt Arial, Helvetica, Sans-Serif"&gt;
  &lt;tbody&gt;&lt;tr style="vertical-align: bottom"&gt;
    &lt;td style="padding-bottom: 1pt"&gt;&lt;b&gt;&amp;#160;&lt;/b&gt;&lt;/td&gt;
    &lt;td style="padding-bottom: 1pt"&gt;&lt;b&gt;&amp;#160;&lt;/b&gt;&lt;/td&gt;
    &lt;td colspan="3" style="border-bottom: Black 1pt solid; text-align: center"&gt;&lt;b&gt;2025&lt;/b&gt;&lt;/td&gt;
    &lt;td style="padding-bottom: 1pt"&gt;&lt;b&gt;&amp;#160;&lt;/b&gt;&lt;/td&gt;
    &lt;td colspan="3" style="border-bottom: Black 1pt solid; text-align: center"&gt;&lt;b&gt;2024&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;
  &lt;tr style="vertical-align: bottom"&gt;
    &lt;td&gt;&lt;b&gt;OPERATION&lt;/b&gt;&lt;/td&gt;
    &lt;td&gt;&lt;b&gt;&amp;#160;&lt;/b&gt;&lt;/td&gt;
