&lt;td style="width: 143.3pt; border-top: 0.75pt solid #000000; border-right: 1pt solid #000000; border-bottom: 1pt solid #000000; padding-right: 4.4pt; vertical-align: bottom; -aw-border-top: 0.5pt single;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;1.0&lt;/font&gt;&lt;/p&gt;
