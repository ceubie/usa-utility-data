              <td style="padding: 2px 1pt 2px 13pt; text-align: left; vertical-align: bottom;" colspan="3">
                <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 120%;">&#160;&#160;&#160;&#160;&#160;Total</span>
              </td>
              <td style="border-top: 1pt solid #000; padding: 2px 0 2px 1pt; text-align: left; vertical-align: bottom;">
                <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 120%;">$</span>
              </td>
              <td style="border-top: 1pt solid #000; padding: 2px 0; text-align: right; vertical-align: bottom;">
                <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 120%;">6,234&#160;</span>
              </td>
              <td style="border-top: 1pt solid #000; padding: 2px 1pt 2px 0; text-align: right; vertical-align: bottom;">&#160;</td>
            </tr>
          </tbody>
        </table>
      </div>
