  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:label="value1" xlink:href="#Tag53" />
    <link:loc xlink:type="locator" xlink:label="value2" xlink:href="#Tag69" />
    <link:loc xlink:type="locator" xlink:label="value3" xlink:href="#Tag77" />
