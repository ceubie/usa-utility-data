    <link:footnoteArc xlink:type="arc" xlink:from="value142" xlink:to="footnote142" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="142" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote143" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-fareast-font-family: 'Times New Roman';">Delivery point - 39755 Horizon/NGPL North McHenry</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 18pt;">Receipt point - 39855 Horizon/NGPL South Grundy</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 18pt;">Volumes represent January 2025 - December 2025 flow.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value143" xlink:to="footnote143" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="143" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote144" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Includes additional shared compressor station fuel with Horizon Pipeline Company, L.L.C. of 23,070 Dth.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value144" xlink:to="footnote144" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="144" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote146" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">All of the debt required to finance our pipeline was issued by our parent company, NGPL PipeCo LLC (NGPL PipeCo). NGPL PipeCo's interest expense, as calculated in accordance with U.S. Generally Accepted Accounting Principles and as reported on its audited consolidated financial statements for the years ended December 31, 2025 and 2024 was $97.5 million and $95.2 million, respectively. </xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Interest on debt to associated companies recorded in Account 430 of $4,761 relates to principal balances in other accounts, and is not reported on Page 256.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value146" xlink:to="footnote146" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="146" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote147" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="line-height: 116%; font-family: Arial; font-size: 12pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 8pt; line-height: 116%; font-size: 18pt;">Volumes are Jan 2025 to Dec 2025 flow month (Feb 2025 accounting month to Jan 2026 accounting month). Dollars are Jan 2025 to Dec 2025 accounting month.</xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value147" xlink:to="footnote147" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="147" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote151" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table class="MsoTableGrid" style="margin-left: -.25pt; border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes;">
              <xhtml:td style="width: 112.25pt; border: solid windowtext 1.0pt; border-bottom: solid windowtext 3.0pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="150">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold; mso-bidi-font-style: italic;">Account</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 121.75pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 3.0pt; border-right: solid windowtext 1.0pt; mso-border-left-alt: solid windowtext 1.0pt; padding: 0in 5.4pt 0in 5.4pt;" colspan="2" valign="top" width="162">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold; mso-bidi-font-style: italic;">Amount</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 1;">
              <xhtml:td style="width: 112.25pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: 3.0pt; mso-border-left-alt: .5pt; mso-border-bottom-alt: 1.0pt; mso-border-right-alt: .5pt; mso-border-color-alt: windowtext; mso-border-style-alt: solid; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="150">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold; mso-bidi-font-style: italic;">107</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 20.85pt; border: none; border-bottom: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext 3.0pt; mso-border-left-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="28">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold; mso-bidi-font-style: italic;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 100.9pt; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext 3.0pt; mso-border-bottom-alt: solid windowtext 1.0pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="135">
