  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="Tag2005" contextRef="C1">&lt;div&gt;&lt;p&gt;&lt;font style="font-size: 18.0pt; font-family: 'Arial',sans-serif; color: black;"&gt;12. Changes made during the year ended December 31, 2025:&lt;/font&gt;&lt;/p&gt;
&lt;p&gt;&lt;font style="font-size: 18.0pt; font-family: 'Arial',sans-serif; color: black;"&gt;&amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-size: 18.0pt; font-family: 'Arial',sans-serif; color: black;"&gt;Appointments:&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-size: 18.0pt; font-family: 'Arial',sans-serif; color: black;"&gt;Mary Limbaugh&amp;#160;&lt;/font&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;&amp;#8211; President and Chief Executive Officer&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-size: 18.0pt; font-family: 'Arial',sans-serif; color: black;"&gt;Vicki A. Phillips &amp;#8211; Vice President&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-size: 18.0pt; font-family: 'Arial',sans-serif; color: black;"&gt;Michael Pitta&amp;#160;&lt;/font&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;&amp;#8211; Chief Administrative Officer&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;Steven Romano&amp;#160;&lt;/font&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;&amp;#8211; Vice President&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-size: 18.0pt; font-family: 'Arial',sans-serif; color: black;"&gt;Tony&amp;#160;Sala&amp;#160;&lt;/font&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;&amp;#8211; Vice President&amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;David Weeks &amp;#8211; Vice President, Marketing and Business Development&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: 0.5in; text-align: left;"&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 18pt;"&gt;&amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: 0.5in; text-align: left;"&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 18pt;"&gt;Resignations:&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-size: 18.0pt; font-family: 'Arial',sans-serif; color: black;"&gt;William Burton&amp;#160;&lt;/font&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;&amp;#8211; President, Senior Vice President of Finance&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;Mary Limbaugh&amp;#160;&lt;/font&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;&amp;#8211; Vice President&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-size: 18.0pt; font-family: 'Arial',sans-serif; color: black;"&gt;William E. Morgan &amp;#8211; Vice President and Operational Controller&lt;/font&gt;&lt;/p&gt;
&lt;p style="text-indent: .5in;"&gt;&lt;font style="font-size: 18.0pt; font-family: 'Arial',sans-serif; color: black;"&gt;Christa Robbins&amp;#160;&lt;/font&gt;&lt;font style="font-family: Arial, sans-serif; font-size: 24px;"&gt;&amp;#8211; Vice President&lt;/font&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
