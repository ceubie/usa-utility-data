    <link:footnoteArc xlink:type="arc" xlink:from="value158" xlink:to="footnote158" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="158" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote162" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Net additions and dispositions for the year.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value162" xlink:to="footnote162" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="162" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote165" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">AL NGPL Holdings, LLC is indirectly owned by funds managed by ArcLight Capital Partners, LLC.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value165" xlink:to="footnote165" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="165" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote169" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">NGPL Holdings LLC is owned 37.5% by Kinder Morgan NGPL Holdings LLC, 37.5% by AL NGPL Holdings, LLC and 25% by AL NGPL Fund VIII Funding, LLC (jointly ArcLight). ArcLight is indirectly owned by funds managed by ArcLight Capital Partners, LLC.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">On May 9, 2025, Brookfield Infrastructure Partners L.P. sold its entire minority interest in NGPL Holdings to funds managed by ArcLight Capital Partners, LLC. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value169" xlink:to="footnote169" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="169" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote170" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table class="MsoTableGrid" style="border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes;">
              <xhtml:td style="width: 382.25pt; border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="510">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Storage Plant (in thousands)</xhtml:span>
                </xhtml:p>
