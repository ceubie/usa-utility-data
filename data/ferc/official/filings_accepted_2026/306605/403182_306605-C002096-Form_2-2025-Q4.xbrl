                  <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;"> 7.50%</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 3; mso-yfti-lastrow: yes; height: 30.25pt; mso-height-rule: exactly;">
              <xhtml:td style="width: 369.75pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: 30.25pt; mso-height-rule: exactly;" valign="top" width="493">
                <xhtml:p class="MsoNormal" style="margin-left: 2.25pt;">
                  <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Herscher Galesville Intangible</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 161.25pt; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: 30.25pt; mso-height-rule: exactly;" valign="top" width="215">
                <xhtml:p class="MsoNormal" style="margin-left: 2.25pt; text-align: right;" align="right">
                  <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;"> 5.00%</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
          </xhtml:tbody>
        </xhtml:table>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value92" xlink:to="footnote92" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="92" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote94" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="line-height: 108%; font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">Cushion Gas consists of 205,584,203 Dekatherms of recoverable cushion volumes owned in fee by us and 118,028,197 Dekatherms of non-recoverable volumes owned by us reported in Account 101. </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: spaces;">
              </xhtml:span>
              <xhtml:span style="width: 32.87pt; font-family: Arial; display: inline-block;">
              </xhtml:span>
              <xhtml:span style="font-family: Arial; -aw-import: spaces;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value94" xlink:to="footnote94" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="94" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote95" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="line-height: 108%; font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">Amount consists of customer owned and proprietary gas. Natural has a combination of working gas and customer parked LPS gas totaling 8.8 million Dekatherms that serves a cushion function. </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: spaces;">
              </xhtml:span>
              <xhtml:span style="width: 32.87pt; font-family: Arial; display: inline-block;">
              </xhtml:span>
              <xhtml:span style="font-family: Arial; -aw-import: spaces;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value95" xlink:to="footnote95" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="95" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote96" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="line-height: 108%; font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">All volumes converted to Btu using 1.03 btu/cf (1.03 Dth/Mcf).</xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: spaces;">
              </xhtml:span>
              <xhtml:span style="width: 32.87pt; font-family: Arial; display: inline-block;">
              </xhtml:span>
              <xhtml:span style="font-family: Arial; -aw-import: spaces;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value96" xlink:to="footnote96" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="96" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote97" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="line-height: 108%; font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">Includes observation wells, water disposal wells and water pump wells. </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 10pt;">
              <xhtml:span style="font-family: Arial; -aw-import: spaces;">
              </xhtml:span>
              <xhtml:span style="width: 32.87pt; font-family: Arial; display: inline-block;">
              </xhtml:span>
              <xhtml:span style="font-family: Arial; -aw-import: spaces;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value97" xlink:to="footnote97" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="97" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote104" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This footnote applies to all transmission compressor stations not reporting operational data in columns k-m:</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Shipper nominations and resulting system flow patterns did not require operation of station in period.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Plant cost in column (e) reflects gross cost of compressor station</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value104" xlink:to="footnote104" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="104" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote106" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">All horsepower is FERC Certificated. Site horsepower could be rated differently based on elevation and temperature.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value106" xlink:to="footnote106" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="106" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote109" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 24px;">As of December 31, 2025, we estimate that no deferred tax balance in Account 283 could be used in the development of jurisdictional recourse rates.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value109" xlink:to="footnote109" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="109" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote110" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">Recorded pursuant to Docket No. AI93-5-000 issued on April 23, 1993 (Accounting for Income Taxes).</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">We estimate approximately $24.0 million of the ending balance is associated with the projects granted non-traditional rate treatment that are reported on page 217.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value110" xlink:to="footnote110" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="110" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote112" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Use tax is distributed to various accounts based on the accounts charged for the originating invoice. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value112" xlink:to="footnote112" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="112" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote122" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">Year-to-date shipper supplied gas (Fuel Used &amp; L&amp;U) from transmission contracts: 29,608,452 Dth.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value122" xlink:to="footnote122" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="122" />
