&lt;p style="margin-top: 0pt; margin-left: 21.6pt; margin-bottom: 0pt; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;State&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 177.05pt; border-top: 0.75pt dashed #bbbbbb; border-right: 1pt solid #000000; border-left: 0.75pt dashed #bbbbbb; border-bottom: 4.5pt solid #000000; padding-right: 3.9pt; padding-left: 4.72pt; vertical-align: bottom; -aw-border-left: 0.75pt dash-large-gap; -aw-border-top: 0.75pt dash-large-gap;" colspan="2"&gt;
