    <link:footnoteArc xlink:type="arc" xlink:from="value151" xlink:to="footnote151" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="151" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote152" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Many of the cost categories required to be reported on this page are recorded at the entity level rather than at the asset level. Therefore, the costs and expenses reported have been allocated to the projects listed based on reasonable assumptions and may differ from those used in a Section 4 rate proceeding. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value152" xlink:to="footnote152" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="152" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote153" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">In the order approving the Chicago Market Expansion Project (CMEP) in Docket No. CP15-505-000, the FERC approved our proposal to reflect our system reservation charge as the monthly reservation charge for the CMEP, but required us to calculate an incremental commodity charge for the CMEP instead of allowing us to use our system commodity charge as requested. We consider the CMEP to be a partially incremental project as a result</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value153" xlink:to="footnote153" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="153" />
