    <link:footnoteArc xlink:type="arc" xlink:from="value134" xlink:to="footnote134" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="134" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote136" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 16.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">
            <xhtml:span style="font-size: 18pt;">The capital structure used as the source of the 2025 AFUDC rates is that of our direct parent, NGPL PipeCo LLC.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value136" xlink:to="footnote136" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="136" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote137" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18pt; line-height: 107%; font-family: Arial, sans-serif;">The cost of debt used as the source of the 2025 AFUDC rates is that of our direct parent, NGPL PipeCo LLC.</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal">
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value137" xlink:to="footnote137" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="137" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote138" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18pt; line-height: 107%; font-family: Arial, sans-serif;">The cost rate percentage of common equity used as the source of the 2025 AFUDC rate was the rate set by Docket No. RP95-326.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value138" xlink:to="footnote138" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="138" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote139" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="line-height: 108%; font-family: Arial; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 8pt; line-height: 108%; font-size: 18pt;">For the year ended December 31, 2025, we did not sell gas from company owned cushion gas.</xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 8pt; line-height: 108%; font-size: 18pt;">
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 8pt; line-height: 108%; font-size: 18pt;">From time to time we have completed storage expansion projects which, with FERC approval, reduces the amount of cushion gas required to be maintained for operation of certain of our storage facilities.</xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 8pt; line-height: 108%; font-size: 18pt;">
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 8pt; line-height: 108%; font-size: 18pt;">NGPL has a combination of working gas and LPS gas totaling 8.8 million Dekatherms that serves a cushion function.</xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value139" xlink:to="footnote139" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="139" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote140" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="text-align: justify;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">As of December 31, 2025, we estimate that the following deferred tax balance in Account 190 could be used in the development of jurisdictional recourse rates:</xhtml:span>
        </xhtml:p>
        <xhtml:p class="MsoNormal" style="text-align: justify;">
        </xhtml:p>
        <xhtml:table class="MsoNormalTable" style="border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 0in 0in 0in;" border="0" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr>
              <xhtml:td style="width: 553.25pt; border: solid windowtext 1.0pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="738">
                <xhtml:p class="MsoNormal" style="text-align: justify;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Regulatory Liability - Deferred Income Tax Rate Adjustment</xhtml:span>
                </xhtml:p>
