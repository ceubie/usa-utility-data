    <link:footnoteArc xlink:type="arc" xlink:from="value26" xlink:to="footnote26" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="26" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote27" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="line-height: 108%; font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 8pt; line-height: 108%; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">In accordance with FERC Order No. 581, we use the inventory method to report storage gas.</xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 8pt;">
              <xhtml:span style="-aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value27" xlink:to="footnote27" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="27" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote29" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="line-height: 116%; font-family: Arial; font-size: 12pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt;">Gas pipeline rupture costs recorded in 2024 were reversed in 2025 due to insurance recovery.</xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 8pt;">
              <xhtml:span style="-aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value29" xlink:to="footnote29" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="29" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote35" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt;">
              <xhtml:span style="-aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt;">
              <xhtml:span style="-aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">The value of this gas is based on the Average Monthly Index Price provided for in our tariff. This footnote applies to all periods within the quarter. </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value35" xlink:to="footnote35" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="35" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote36" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level rather than by discounted, negotiated, or recourse rate contracts; therefore, the reported amounts have been allocated to discounted, negotiated, or recourse rate contracts based on reasonable assumptions. </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
