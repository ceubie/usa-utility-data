    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote178" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Pursuant to Docket No. CP24-8, in conjunction with the ongoing project scheduled for in service in the third quarter of 2026, two units were uprated at a total of 1,600 hp each increasing the station total to 30,000 hp on April 1, 2025.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value178" xlink:to="footnote178" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="178" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote179" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">Pursuant to CP25-1, three units at a total of 1,040 hp each were abandoned (Units 1, 2, and 3) decreasing the station total to 16,580 hp on March 4, 2025. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value179" xlink:to="footnote179" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="179" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote180" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 24px;">Pursuant to Docket No. CP24-525 Unit 2, a 4,000 hp unit was replaced with one new 5,000 hp unit, increasing the station total to 9,000 hp on November 10, 2025.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value180" xlink:to="footnote180" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="180" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote181" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Pursuant to Docket No. CP25-113 Unit 4, one unit at a total of 800 hp, was retired in place on September 22, 2025.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value181" xlink:to="footnote181" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="181" />
  </link:footnoteLink>
</xbrli:xbrl>
