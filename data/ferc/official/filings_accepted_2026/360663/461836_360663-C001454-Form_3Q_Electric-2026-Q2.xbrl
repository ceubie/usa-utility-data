    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote27" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Affiliate transaction.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value27" xlink:to="footnote27" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="27" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote28" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Affiliate transaction.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value28" xlink:to="footnote28" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="28" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote29" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Reactive Supply, Regulation charges and Interest Payments for Terry Ranch Road credits</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value29" xlink:to="footnote29" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="29" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote30" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Other charges represent ancillary services which may include scheduling, system control, and dispatch. Additionally, these charges may include reactive supply and voltage control from generation source services.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value30" xlink:to="footnote30" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="30" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote31" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Affiliate transaction - Black Hills Power is a joint owner of the Black Hills Basin Electric (BHBE) Transmission system. Amounts shown are payments from BHBE. Cheyenne Light Fuel and Power is an affiliate of Black Hills Power.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value31" xlink:to="footnote31" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="31" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote32" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="background-color: #f5f5f5;">Affiliate transaction - Black Hills Power is a joint owner of the Black Hills Basin Electric (BHBE) Transmission system. Amounts shown are payments from BHBE. Cheyenne Light Fuel and Power is an affiliate of Black Hills Power.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value32" xlink:to="footnote32" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="32" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote33" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="background-color: #f5f5f5;">Affiliate transaction - Black Hills Power is a joint owner of the Black Hills Basin Electric (BHBE) Transmission system. Amounts shown are payments from BHBE. Cheyenne Light Fuel and Power is an affiliate of Black Hills Power.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value33" xlink:to="footnote33" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="33" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote34" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Affiliate transaction</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value34" xlink:to="footnote34" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="34" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote35" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Affiliate transaction</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value35" xlink:to="footnote35" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="35" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote36" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Affiliate transaction - Black Hills Balancing Authority is owned by Black Hills Corporation, the parent company of Cheyenne Light Fuel and Power. </xhtml:p>
      </xhtml:div>
    </link:footnote>
