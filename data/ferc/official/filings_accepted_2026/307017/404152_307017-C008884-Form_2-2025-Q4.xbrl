weight:400;line-height:120%"&gt;2028&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;108,885&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#cceeff;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;2029&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="background-color:#ffffff;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;108,588&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;2030&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="background-color:#cceeff;padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;35,700&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#cceeff;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#ffffff;padding:2px 1pt 2px 19pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Total&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;border-bottom:3pt double #000;border-top:1pt solid #000;padding:2px 0 2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;border-bottom:3pt double #000;border-top:1pt solid #000;padding:2px 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;478,394&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="background-color:#ffffff;border-bottom:3pt double #000;border-top:1pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:10pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;11. Subsequent Events&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:3pt;margin-top:5pt;text-indent:36pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;In March 2026, Midship approved and paid capital distributions of approximately $12.9 million&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock>
  <ferc:GeneralDescriptionOfConstructionOverheadTextBlock id="f-24" contextRef="c-1">&lt;div style="padding-right:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"&gt;1.OVERHEAD:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Administrative, engineering, and supervision salaries, expenses, and employee benefits relating to construction activities are capitalized based on labor recorded to the payroll system. The amounts so capitalized are directly assigned, based on individual construction projects. Employees charge their time and expenses directly to individual construction projects by each hour worked as assigned. Employee benefits are derived based on the labor hours charged to each individual project.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:12pt;padding-left:18pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"&gt;2. ALLOWANCE FOR FUNDS USED DURING CONSTRUCTION:&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Allowance for funds used during construction is calculated on Page 218a.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:12pt;padding-left:18pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"&gt;3. NET-OF-TAX RATE FOR BORROWED FUNDS:&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:18pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Not Applicable&lt;/span&gt;&lt;/div&gt;</ferc:GeneralDescriptionOfConstructionOverheadTextBlock>
  <ferc:ExplanatoryOfSecuritiesIssuedOrAssumedAndSecuritiesRefundedOrRetiredTextBlock id="f-25" contextRef="c-1">&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;On July 11, 2025, Midship Pipeline repaid the outstanding balances on its term loan and working capital facility due 2030 under the 2019 Credit Agreement in connection with the closing of the 2025 Credit Agreement that provides for a term loan with principal amount of $350&#160;million and a revolving credit facility due on July 11, 2029. Loss on extinguishment resulting from unamortized debt discounts and expenses of its term loan and working capital facility under 2019 Credit Agreement is included in Account 189 - Unamortized Loss on Reacquired Debt and amortized by equal monthly amounts over the remainder of the original life of the debt retired.&lt;/span&gt;&lt;/div&gt;</ferc:ExplanatoryOfSecuritiesIssuedOrAssumedAndSecuritiesRefundedOrRetiredTextBlock>
  <ferc:ExplanatoryOfSecuritiesIssuedOrAssumedAndSecuritiesRefundedOrRetiredTextBlock id="f-26" contextRef="c-1">&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;On July 11, 2025, Midship Pipeline repaid the outstanding balances on its term loan and working capital facility due 2030 under the 2019 Credit Agreement in connection with the closing of the 2025 Credit Agreement that provides for a term loan with principal amount of $350&#160;million and a revolving credit facility due on July 11, 2029. Loss on extinguishment resulting from unamortized debt discounts and expenses of its term loan and working capital facility under 2019 Credit Agreement is included in Account 189 - Unamortized Loss on Reacquired Debt and amortized by equal monthly amounts over the remainder of the original life of the debt retired.&lt;/span&gt;&lt;/div&gt;</ferc:ExplanatoryOfSecuritiesIssuedOrAssumedAndSecuritiesRefundedOrRetiredTextBlock>
  <ferc:ExplanatoryOfSecuritiesIssuedOrAssumedAndSecuritiesRefundedOrRetiredTextBlock id="f-27" contextRef="c-1">&lt;div style="margin-top:2pt;padding-left:36pt;padding-right:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;padding-left:9.67pt"&gt;On July 11, 2025, Midship Pipeline repaid the outstanding balances on its term loan and working capital facility due 2030 under the 2019 Credit Agreement in connection with the closing of the 2025 Credit Agreement that provides for a term loan with principal amount of $350&#160;million and a revolving credit facility due on July 11, 2029. Loss on extinguishment resulting from unamortized debt discounts and expenses of its term loan and working capital facility under 2019 Credit Agreement is included in Account 189 - Unamortized Loss on Reacquired Debt and amortized by equal monthly amounts over the remainder of the original life of the debt retired.&lt;/span&gt;&lt;/div&gt;</ferc:ExplanatoryOfSecuritiesIssuedOrAssumedAndSecuritiesRefundedOrRetiredTextBlock>
