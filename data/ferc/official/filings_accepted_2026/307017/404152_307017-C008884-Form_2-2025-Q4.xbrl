    <link:footnote xlink:type="resource" xlink:label="fn-24" id="fn-24" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%">Schedule Page: 520 Line No.: 20 Column: c</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">For the purpose of the Annual Charge Adjustment (&#8220;ACA&#8221;) calculation, the throughput volume is 319,442,504 Dth as represented on line 20. No additional volumes are needed to calculate the volumes eligible for the ACA surcharge.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-25" id="fn-25" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:120%">Schedule Page: 521 Line No.: 7 Column: g</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The basis for valuing the gas reported in column (g) is based on the monthly mid-point average price NGPL TexOk. This footnote also applies to lines 14, 22, 30, 37, 51 and 65.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-26" id="fn-26" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
