      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Date range: 12/28/2025-12/30/2025.</span>
      </div>
    </link:footnote>
