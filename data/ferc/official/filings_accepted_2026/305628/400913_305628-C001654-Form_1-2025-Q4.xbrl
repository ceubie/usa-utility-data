    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#040404;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:115%">Salary disclosure includes amounts that have been allocated to New England Electric Transmission Corporation (reporting entity). The salary amount allocated to other companies was $706,403. These salary amounts exclude incentive compensation payments and reflect base salary paid by the company from 1-1-2025 through 12-31-2025.</span>
      </div>
    </link:footnote>
