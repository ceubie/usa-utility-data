							&lt;span style="font-family:Arial"&gt;FET&lt;/span&gt;&#xD;
						&lt;/p&gt;&#xD;
					&lt;/td&gt;&#xD;
					&lt;td style="width:394.45pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:top"&gt;&#xD;
						&lt;p style="margin-top:2.65pt; margin-left:9pt; margin-bottom:1.5pt; text-indent:-9pt; line-height:120%; font-size:8pt"&gt;&#xD;
							&lt;span style="font-family:Arial"&gt;FirstEnergy Transmission, LLC a consolidated VIE of FE and the parent company of ATSI, MAIT and TrAIL, and having a joint venture in PATH&lt;/span&gt;&#xD;
						&lt;/p&gt;&#xD;
					&lt;/td&gt;&#xD;
				&lt;/tr&gt;&#xD;
