						&lt;td colspan="4" style="width:377.95pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:top"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:115%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial"&gt;SUPPLEMENTAL DISCLOSURE ON CASH FLOW INFORMATION:&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
					&lt;/tr&gt;&#xD;
					&lt;tr style="height:12.75pt; -aw-height-rule:exactly"&gt;&#xD;
						&lt;td style="width:244.45pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:top"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:115%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial; font-weight:bold"&gt;Three Months Ended March 31,&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
