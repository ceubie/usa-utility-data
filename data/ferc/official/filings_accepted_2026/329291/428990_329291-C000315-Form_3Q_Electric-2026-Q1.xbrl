							&lt;span style="font-family:Arial"&gt;FirstEnergy Service Company, which provides legal, financial and other corporate support services&lt;/span&gt;&#xD;
						&lt;/p&gt;&#xD;
					&lt;/td&gt;&#xD;
				&lt;/tr&gt;&#xD;
				&lt;tr style="height:21.75pt; -aw-height-rule:exactly"&gt;&#xD;
					&lt;td style="width:98.95pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:top"&gt;&#xD;
