  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH5641A1670EB38E9838DDD3FC8AEAC8AF" xlink:label="HH5641A1670EB38E9838DDD3FC8AEAC8AF" />
    <link:footnote xlink:type="resource" xlink:label="HHDD73BB41A429B4C5EA963FC03103CAB2" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin-top: 0; margin-right: 0; margin-bottom: 0; font-size: 12pt; font-family: Arial, sans-serif">
          <span style="font-size: 10pt">
            <span style="font-family: Arial, Helvetica, sans-serif">Effective July 31, 2024, through a series of transactions Energy Transfer GC NGL Pipelines LP conveyed its 100% membership interest in Energy Transfer GC NGL Product Services LLC to Energy Transfer GC NGLs LLC, an indirect wholly owned subsidiary of Energy Transfer LP.</span>
          </span>
          <span />
        </p>
      </div>
    </link:footnote>
