    <link:loc xlink:type="locator" xlink:href="#HH2885DC8540863A94C996075B9B2EAAA3" xlink:label="HH2885DC8540863A94C996075B9B2EAAA3" />
    <link:footnote xlink:type="resource" xlink:label="HHFF088E3F9F6E3174C94C37EC9D16E128" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Loss and Unaccounted For (LAUF). LAUF incurred in the operation of the pipeline is tracked and flowed through to customers. LAUF amounts are recorded as a debit to account 813-Other Gas Supply Expense and a credit to account 812-Gas used for Other Operations.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH2885DC8540863A94C996075B9B2EAAA3" xlink:to="HHFF088E3F9F6E3174C94C37EC9D16E128" order="1" />
