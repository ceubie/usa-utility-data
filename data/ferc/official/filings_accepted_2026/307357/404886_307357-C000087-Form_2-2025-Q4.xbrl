    <link:footnote xlink:type="resource" xlink:label="HH907FDB2A31F85CED9225AF1A2B5AC2A7" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">Gulfstream Natural</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">Gas, LLC estimates no deferred income taxes reported in the beginning-of-year and end-of-year balances for Accumulated Deferred Taxes-Other (Account 283) could be included in the development of jurisdictional recourse</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">rates.</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">Furthermore,</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">as</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">stated</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">in</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">paragraph</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">III</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">G.</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">3</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">of</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">Order</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">No.</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">710,</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">Docket</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">No.</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:118%">RM07-9-00</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:118%" />
