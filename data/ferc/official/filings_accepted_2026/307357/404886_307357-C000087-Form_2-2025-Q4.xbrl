&lt;p class="MsoNormal" style="text-align: justify; text-justify: inter-ideograph; text-indent: -.5in; line-height: normal; mso-pagination: none; margin: 0in 0in 0in .5in;"&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';"&gt;Huffman, Robert L., Alternate Representative, Enbridge&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-indent: -.5in; line-height: normal; margin: 0in 0in 0in .5in;"&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-indent: -.5in; line-height: normal; margin: 0in 0in 0in .5in;"&gt;&lt;strong&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';"&gt;Appointment, effective 01/22/2025&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-indent: -.5in; line-height: normal; mso-pagination: none; margin: 0in .5in 0in .5in;"&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;Paglia, Richard M., Alternate Representative, Enbridge&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-indent: -.5in; line-height: normal; margin: 0in 0in 0in .5in;"&gt;&lt;strong&gt;&amp;#160;&lt;/strong&gt;&lt;/p&gt;
