          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">System</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">L.L.C.</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">estimates</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">100%</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">of</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">the</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">deferred</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">income</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">taxes</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">reported</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">in</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">the</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">beginning-of-year</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">and end-of-year balances for Accumulated Deferred Taxes-Other (Account 282) could be included in the development of jurisdictional recourse rates, with</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">the exception that</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">approximately</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">$793,609(end-of-year</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">balance), which is attributable to certain recent accelerated depreciation, would be excluded.</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Furthermore, as stated in paragraph</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">III G. 3 of Order No. 710,</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Docket</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">No.</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">RM07-9-000</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">as</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">issued</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">on</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">March</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">21,</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">2008</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">by</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">the</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Federal</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Energy</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Regulatory</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Commission,</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">these estimates are not binding on the pipeline at such time as it may</span>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%" />
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">file a section 4 rate case.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0C3A2FD04307328532DD0B769DD5C856" xlink:to="HH889B386BC36059A1951C84DE615E7BEE" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH804E27F811FA12ABB210B316CDF7FC1C" xlink:label="HH804E27F811FA12ABB210B316CDF7FC1C" />
    <link:footnote xlink:type="resource" xlink:label="HH6EEB3D5E80BC28CDCD4170A69B2CDAD1" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Gulfstream Natural Gas System, LLC estimates no deferred income taxes reported in the beginning-of-year and end-of-year balances for Accumulated Deferred Taxes (Account 190) could be included in the development of jurisdictional recourse rates. Furthermore, as stated in paragraph III G. 3 of Order No. 710, Docket No. RM07-9-00 as issued on March 21, 2008 by the Federal Energy Regulatory Commission, these estimates are not binding on the pipeline at such time as it may file a section 4 rate case.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH804E27F811FA12ABB210B316CDF7FC1C" xlink:to="HH6EEB3D5E80BC28CDCD4170A69B2CDAD1" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHD09DD9D253198549A535AC056509D032" xlink:label="HHD09DD9D253198549A535AC056509D032" />
    <link:footnote xlink:type="resource" xlink:label="HHA1B6C762876656528426D182BA477C97" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Docket No. AI93-5-001 issued on April 23, 1993 (Accounting for Income Taxes).</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHD09DD9D253198549A535AC056509D032" xlink:to="HHA1B6C762876656528426D182BA477C97" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH6A3B3C806F47F340DA3691429D032389" xlink:label="HH6A3B3C806F47F340DA3691429D032389" />
    <link:footnote xlink:type="resource" xlink:label="HH466137A409C200D988D7A1C5A9E20D14" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Certificated HP for Station 410C includes 37,896 of spare HP.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6A3B3C806F47F340DA3691429D032389" xlink:to="HH466137A409C200D988D7A1C5A9E20D14" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHDCB3966B26B28EDD98E8F6C85B0ADB64" xlink:label="HHDCB3966B26B28EDD98E8F6C85B0ADB64" />
    <link:footnote xlink:type="resource" xlink:label="HH6E3284937B932404EF152FDAE2DF41EE" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Gulfstream uses a 50/50 capital structure for AFUDC calculation purposes. The Long-Term Debt and Common Equity amounts on page 218 only present the percentage of debt/equity</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHDCB3966B26B28EDD98E8F6C85B0ADB64" xlink:to="HH6E3284937B932404EF152FDAE2DF41EE" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH811E9BBAB4F768E5540E877BDED1971B" xlink:label="HH811E9BBAB4F768E5540E877BDED1971B" />
    <link:footnote xlink:type="resource" xlink:label="HHE25C9518F406F4E5ACACA2D2B6CB9831" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>The rate of Return was approved by the Commision in Docket No. CP00-6-000, et al.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH811E9BBAB4F768E5540E877BDED1971B" xlink:to="HHE25C9518F406F4E5ACACA2D2B6CB9831" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH2D9E8719AC673B3EBE9115D759294E23" xlink:label="HH2D9E8719AC673B3EBE9115D759294E23" />
    <link:footnote xlink:type="resource" xlink:label="HHCE91C03D831DE8683B940F80D8493C66" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Arial, sans-serif; font-size: 13.3333px;">All plant base amounts reported are the ending plant balances.</span>
        </p>
