&lt;p class="MsoNormal" style="text-indent: -.5in; line-height: normal; mso-pagination: none; margin: 0in .5in 0in .5in;"&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;Hamilton, Nicholas A., Alternate Representative, SEP&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;#160;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-indent: -.5in; line-height: normal; margin: 0in 0in 0in .5in;"&gt;&lt;strong&gt;&amp;#160;&lt;/strong&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
