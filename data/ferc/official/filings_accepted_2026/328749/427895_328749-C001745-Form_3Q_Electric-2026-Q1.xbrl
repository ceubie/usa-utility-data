&lt;p class="MsoNormal" style="text-align: right; page-break-after: avoid; tab-stops: 22.2pt 47.6pt; margin: 1.65pt 0in 1.5pt 0in;" align="right"&gt;&lt;font style="font-size: 9pt; font-family: Arial, sans-serif;"&gt;$&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 9,482&amp;#160;&lt;/font&gt;&lt;/p&gt;
