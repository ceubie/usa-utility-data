&lt;p class="MsoNormal" style="text-align: right; tab-stops: 17.45pt 60.35pt; margin: 2.65pt 0in 1.5pt 0in;" align="right"&gt;&lt;font style="font-size: 9pt; font-family: Arial, sans-serif;"&gt;$&amp;#160;&amp;#160;&amp;#160;&amp;#160; 1,707,798&amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
