&lt;/td&gt;
&lt;td style="width: 63.75pt; border: none; mso-border-top-alt: solid black 1.0pt; padding: 0in .75pt 0in 0in; height: 12.75pt; mso-height-rule: exactly;" valign="bottom" width="85"&gt;
&lt;p class="MsoNormal" style="text-align: right; page-break-after: avoid; tab-stops: 47.45pt 60.35pt; margin: 1.65pt 0in 1.5pt 0in;" align="right"&gt;&lt;strong&gt;&lt;font style="font-size: 9pt; font-family: Arial, sans-serif;"&gt;$&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 22&amp;#160;&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 8.25pt; border: none; padding: 0in 2.65pt 0in 2.65pt; height: 12.75pt; mso-height-rule: exactly;" valign="bottom" width="11"&gt;
&lt;p class="MsoNormal" style="page-break-after: avoid;"&gt;&amp;#160;&lt;/p&gt;
