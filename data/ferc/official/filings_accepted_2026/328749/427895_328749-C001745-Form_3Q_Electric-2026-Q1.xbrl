&lt;/td&gt;
&lt;td style="width: 63.75pt; border: none; border-bottom: solid black 1.0pt; padding: 0in .75pt 0in 0in; height: 15.0pt; mso-height-rule: exactly;" valign="bottom" width="85"&gt;
&lt;p class="MsoNormal" style="text-align: right; page-break-after: avoid; tab-stops: 29.95pt 60.35pt; margin: 2.65pt 0in 1.5pt 0in;" align="right"&gt;&lt;strong&gt;&lt;font style="font-size: 9pt; font-family: Arial, sans-serif;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 21,847&amp;#160;&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 8.25pt; border: none; padding: 0in 2.65pt 0in 2.65pt; height: 15.0pt; mso-height-rule: exactly;" valign="bottom" width="11"&gt;
&lt;p class="MsoNormal" style="page-break-after: avoid; margin: 2.65pt 0in 1.5pt 0in;"&gt;&amp;#160;&lt;/p&gt;
