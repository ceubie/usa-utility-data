&lt;td style="width: 63.75pt; border: none; border-bottom: solid black 1.0pt; padding: 0in .75pt 0in 0in; height: 15.0pt; mso-height-rule: exactly;" valign="bottom" width="85"&gt;
&lt;p class="MsoNormal" style="text-align: right; page-break-after: avoid; tab-stops: 29.95pt 60.35pt; margin: 2.65pt 0in 1.5pt 0in;" align="right"&gt;&lt;font style="font-size: 9pt; font-family: Arial, sans-serif;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 20,957&amp;#160;&lt;/font&gt;&lt;/p&gt;
