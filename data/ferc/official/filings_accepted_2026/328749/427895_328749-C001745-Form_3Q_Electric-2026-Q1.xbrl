&lt;/td&gt;
&lt;td style="width: 63.75pt; border: none; padding: 0in .75pt 0in 0in; height: 12.75pt; mso-height-rule: exactly;" valign="bottom" width="85"&gt;
&lt;p class="MsoNormal" style="text-align: right; page-break-after: avoid; tab-stops: 48.45pt 60.35pt; margin: 2.65pt 0in 1.5pt 0in;" align="right"&gt;&lt;strong&gt;&lt;font style="font-size: 9pt; font-family: Arial, sans-serif;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &amp;#8212;&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;
