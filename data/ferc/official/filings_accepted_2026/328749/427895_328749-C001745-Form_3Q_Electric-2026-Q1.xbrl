&lt;tr style="mso-yfti-irow: 3; page-break-inside: avoid; height: 15.0pt; mso-height-rule: exactly;"&gt;
&lt;td style="width: 267.75pt; border: none; padding: 0in 2.65pt 0in 2.65pt; height: 15.0pt; mso-height-rule: exactly;" valign="bottom" width="357"&gt;
&lt;p class="MsoNormal" style="page-break-after: avoid; margin: 2.65pt 0in 1.5pt 48.0pt;"&gt;&lt;font style="font-size: 9pt; font-family: Arial, sans-serif;"&gt;Resiliency initiatives&lt;/font&gt;&lt;/p&gt;
