&lt;p class="MsoNormal" style="page-break-after: avoid; margin: 2.65pt 0in 1.5pt 0in;"&gt;&amp;#160;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 63.75pt; border: none; border-bottom: solid black 1.0pt; padding: 0in 2.65pt 0in 2.65pt; height: 15.0pt; mso-height-rule: exactly;" valign="bottom" width="85"&gt;
&lt;p class="MsoNormal" style="text-align: center; page-break-after: avoid; margin: 2.65pt 0in 1.5pt 0in;" align="center"&gt;&lt;strong&gt;&lt;font style="font-size: 9pt; font-family: Arial, sans-serif;"&gt;2024&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="mso-yfti-irow: 2; page-break-inside: avoid; height: 15.0pt; mso-height-rule: exactly;"&gt;
&lt;td style="width: 4.25in; border: none; padding: 0in 2.65pt 0in 2.65pt; height: 15.0pt; mso-height-rule: exactly;" valign="bottom" width="408"&gt;
