&lt;p class="MsoNormal" style="text-align: center; line-height: 120%; page-break-after: avoid; margin: 1.65pt 0in 1.5pt 0in;" align="center"&gt;&lt;strong&gt;&lt;font style="font-size: 9pt; line-height: 120%; font-family: Arial, sans-serif;"&gt;Pension plan benefits&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 5.25pt; border: none; border-top: solid black 1.0pt; padding: 0in 2.65pt 0in 2.65pt; height: 35.25pt; mso-height-rule: exactly;" valign="bottom" width="7"&gt;
&lt;p class="MsoNormal" style="page-break-after: avoid;"&gt;&amp;#160;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 69.0pt; border-top: solid black 1.0pt; border-left: none; border-bottom: solid black 1.0pt; border-right: none; padding: 0in 2.65pt 0in 2.65pt; height: 35.25pt; mso-height-rule: exactly;" valign="bottom" width="92"&gt;
&lt;p class="MsoNormal" style="margin-top: 1.65pt; text-align: center; line-height: 120%; page-break-after: avoid;" align="center"&gt;&lt;strong&gt;&lt;font style="font-size: 9pt; line-height: 120%; font-family: Arial, sans-serif;"&gt;Other&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-align: center; line-height: 120%;" align="center"&gt;&lt;strong&gt;&lt;font style="font-size: 9pt; line-height: 120%; font-family: Arial, sans-serif;"&gt;postretirement&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="margin-bottom: 1.5pt; text-align: center; line-height: 120%;" align="center"&gt;&lt;strong&gt;&lt;font style="font-size: 9pt; line-height: 120%; font-family: Arial, sans-serif;"&gt;benefits&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 8.25pt; border: none; padding: 0in 2.65pt 0in 2.65pt; height: 35.25pt; mso-height-rule: exactly;" valign="bottom" width="11"&gt;
&lt;p class="MsoNormal" style="page-break-after: avoid;"&gt;&amp;#160;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 63.75pt; border: none; border-bottom: solid black 1.0pt; padding: 0in 2.65pt 0in 2.65pt; height: 35.25pt; mso-height-rule: exactly;" valign="bottom" width="85"&gt;
&lt;p class="MsoNormal" style="text-align: center; line-height: 120%; page-break-after: avoid; margin: 1.65pt 0in 1.5pt 0in;" align="center"&gt;&lt;font style="font-size: 9pt; line-height: 120%; font-family: Arial, sans-serif;"&gt;Pension plan benefits&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 5.25pt; border: none; border-top: solid black 1.0pt; padding: 0in 2.65pt 0in 2.65pt; height: 35.25pt; mso-height-rule: exactly;" valign="bottom" width="7"&gt;
&lt;p class="MsoNormal" style="page-break-after: avoid;"&gt;&amp;#160;&lt;/p&gt;
