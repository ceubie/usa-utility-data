&lt;tr style="height: 15pt;"&gt;
&lt;td class="xl343" style="height: 15px; width: 44.3686%;" height="20"&gt;Mutual funds&lt;/td&gt;
&lt;td style="width: 1.93402%; height: 15px;"&gt;&amp;#160;&lt;/td&gt;
&lt;td class="xl340" style="height: 15px; width: 9.89761%;"&gt;&amp;#160;&lt;/td&gt;
