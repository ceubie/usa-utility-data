&lt;td class="xl348" style="text-align: center; border-bottom: 1pt solid #000000; height: 19px; width: 9.89761%;"&gt;&lt;strong&gt;(Level 2)&lt;/strong&gt;&lt;/td&gt;
&lt;td style="text-align: center; border-bottom: 1pt solid #000000; width: 1.93402%; height: 19px;"&gt;&amp;#160;&lt;/td&gt;
&lt;td style="text-align: center; border-bottom: 1pt solid #000000; width: 1.93402%; height: 19px;"&gt;&amp;#160;&lt;/td&gt;
&lt;td class="xl348" style="text-align: center; border-bottom: 1pt solid #000000; height: 19px; width: 11.0353%;"&gt;&lt;strong&gt;(Level 3)&lt;/strong&gt;&lt;/td&gt;
