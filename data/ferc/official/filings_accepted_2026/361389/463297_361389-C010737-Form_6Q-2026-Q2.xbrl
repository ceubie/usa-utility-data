  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%;text-decoration:underline">Page 110, Line 40: Other Non Current Assets</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">We participate in a cash management program; thus, no cash balances are maintained. Contributions to or from affiliates have been classified as a component of members&#8217; equity because the affiliates have not historically required repayment or repaid amounts owed to us. Balances in this account in prior periods represented receivables from our parent company who received all revenue related cash as part of our cash management agreement.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%;text-decoration:underline">Page 110, Line 61: Other Non Current Liabilities</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">We participate in a cash management program; thus, no cash balances are maintained. Contributions to or from affiliates have been classified as a component of members&#8217; equity because the affiliates have not historically required repayment or repaid amounts owed to us. Balances in this account in prior periods represented payables to our parent company for all cash payments made on our behalf as part of our cash management agreement.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-3" id="fn-3" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:112%;text-decoration:underline">Account 75: Unappropriated Retained Income</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">We participate in a cash management program; thus, no cash balances are maintained. Contributions to or from affiliates have been classified as a component of members&#8217; equity because the affiliates have not historically required repayment or repaid amounts owed to us.</span>
      </div>
    </link:footnote>
    <link:loc xlink:type="locator" xlink:label="f-50" xlink:href="#f-50"/>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-50" xlink:to="fn-3" order="1"/>
  </link:footnoteLink>
