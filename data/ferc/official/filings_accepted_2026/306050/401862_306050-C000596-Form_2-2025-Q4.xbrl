    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote58" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Operating expenses are based on expense amounts directly assigned to the North Expansion Project. TransColorado's methodology for cost allocation and rate design purposes may differ in a Section 4 rate filing.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
