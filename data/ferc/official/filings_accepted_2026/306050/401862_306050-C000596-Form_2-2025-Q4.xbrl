              <xhtml:td style="width: .4in; border: none; border-bottom: solid windowtext 4.5pt; mso-border-top-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" width="38">
