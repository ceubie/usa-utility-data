&lt;td style="width: 17pt; border-top: 4.5pt solid #000000; border-left: 0.75pt solid #000000; border-bottom: 0.75pt solid #000000; padding-right: 5.9pt; padding-left: 5.52pt; vertical-align: bottom; -aw-border-bottom: 0.5pt single; -aw-border-left: 0.5pt single;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 16pt;"&gt;&lt;font style="-aw-import: ignore;"&gt; &amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 144pt; border-top: 4.5pt solid #000000; border-bottom: 1pt solid #000000; vertical-align: bottom;"&gt;
