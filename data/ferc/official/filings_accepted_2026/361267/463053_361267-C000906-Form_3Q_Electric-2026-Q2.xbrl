							&lt;p style="margin-top:0pt; margin-bottom:0pt; page-break-after:avoid; font-size:12pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:64.5pt; border-top-style:solid; border-top-width:1pt; padding-right:0.75pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:1.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial"&gt;$&lt;/span&gt;&lt;span style="width:21.44pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:26.45pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;376,000&lt;/span&gt;&lt;span style="width:2.87pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:61.85pt"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
					&lt;/tr&gt;&#xD;
					&lt;tr style="height:12.75pt; -aw-height-rule:exactly"&gt;&#xD;
						&lt;td colspan="2" style="width:254.2pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:top"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-left:6pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:115%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial"&gt;Working Fund (Account 135)&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:64.5pt; padding-right:0.75pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="width:49.95pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:49.95pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#x2014;&lt;/span&gt;&lt;span style="width:2.9pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:61.85pt"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:3pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; page-break-after:avoid; font-size:12pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:64.5pt; padding-right:0.75pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="width:49.95pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:49.95pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#x2014;&lt;/span&gt;&lt;span style="width:2.9pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:61.85pt"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
					&lt;/tr&gt;&#xD;
