        <xhtml:p class="Default">
          <xhtml:span style="font-size: 18.0pt; color: windowtext;">
            <xhtml:span style="font-family: arial, helvetica, sans-serif;">Recorded pursuant to Section 14 of the General Terms and Conditions of our tariff.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value36" xlink:to="footnote36" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="36" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote38" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18pt; line-height: 107%; font-family: arial, helvetica, sans-serif;">Recorded pursuant to Section 25 of the General Terms and Conditions of our tariff.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value38" xlink:to="footnote38" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="38" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote41" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Line 3 contains cashout and operational purchases recorded to Account 803.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value41" xlink:to="footnote41" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="41" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote42" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Line 3 contains cashout and operational purchases recorded to Account 803.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value42" xlink:to="footnote42" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="42" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote44" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Line 18 contains cashout sales recorded to Account 803 and operational sales, recorded to Account 495.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value44" xlink:to="footnote44" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="44" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote46" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">We use a non-revenue recognition method for shipper-supplied gas which results in accounting entries for net fuel over or under-collected rather than separate revenue entries for shipper-supplied gas and expenses for gas used in compressors. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value46" xlink:to="footnote46" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="46" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote47" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">The value of this gas is based on the current month cash-out price provided for in our tariff. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value47" xlink:to="footnote47" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="47" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote48" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">Use tax is distributed to various accounts based on the accounts charged for the originating invoice.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value48" xlink:to="footnote48" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="48" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote49" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
