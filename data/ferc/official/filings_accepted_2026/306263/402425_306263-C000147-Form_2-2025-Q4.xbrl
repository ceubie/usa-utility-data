    <link:footnoteArc xlink:type="arc" xlink:from="value17" xlink:to="footnote17" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="17" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote20" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">The cost rate percentage of common equity is based on the approved rate in Docket No. CP06-417-000. </xhtml:span>
          <xhtml:u>
          </xhtml:u>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value20" xlink:to="footnote20" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="20" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote21" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">AFUDC Debt Rate for Borrowed Funds is based upon a debt cost of 7.5% and a capital structure of 50% debt as specified in Docket No. CP06-417-000.</xhtml:span>
          <xhtml:u>
          </xhtml:u>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value21" xlink:to="footnote21" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="21" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote22" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">AFUDC Equity Rate for Other Funds is based upon an equity rate of return of 14% and a capital structure of 50% equity as specified in Docket No. CP06-417-000.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value22" xlink:to="footnote22" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="22" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote27" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Amounts charged are based on Kinder Morgan, Inc.'s other compensation and benefit expenses and are allocated to us based on the distribution of direct labor charges (excluding overtime and special pay).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value27" xlink:to="footnote27" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="27" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote28" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Amounts charged by Kinder Morgan, Inc. through shared services are allocated using the modified Massachusetts Formula.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value28" xlink:to="footnote28" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="28" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote29" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">See page 218 "General Description of Construction Overhead Procedure" for the basis of allocation.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value29" xlink:to="footnote29" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="29" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote32" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table class="MsoTableGrid" style="width: 16.0in; border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" width="1536" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: .3in;">
              <xhtml:td style="width: 13.6in; border: solid windowtext 1.0pt; border-bottom: solid windowtext 4.5pt; mso-border-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext 4.5pt; padding: 0in 5.4pt 0in 5.4pt; height: .3in;" valign="top" width="1306">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Account</xhtml:span>
