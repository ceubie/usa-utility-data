    <link:loc xlink:type="locator" xlink:href="#HH88CD6ADF43A8ACA97EC205A85A3EF889" xlink:label="HH88CD6ADF43A8ACA97EC205A85A3EF889" />
    <link:footnote xlink:type="resource" xlink:label="HH24A346EDD58CF9ADF999EF03ED97D79B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div style="color: #000000; font-family: 'Segoe UI'; line-height: 20px;">Effective March 1, 2025, Tank No. 407 was placed into operational service and reclassified from non&#8209;carrier property to carrier property, while Tank No. 412 was reclassified from carrier property to non&#8209;carrier property. The related reclassification of tank costs is reflected in <em>Other Adjustments, Transfers and Clearances (in dollars) (g).</em></div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH88CD6ADF43A8ACA97EC205A85A3EF889" xlink:to="HH24A346EDD58CF9ADF999EF03ED97D79B" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHB19BA071ACE3BA02F362CEE1DD30FFCC" xlink:label="HHB19BA071ACE3BA02F362CEE1DD30FFCC" />
    <link:footnote xlink:type="resource" xlink:label="HHB4C01297DDAAFCAD7BFF739FDDCE407C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div style="color: #000000; font-family: 'Segoe UI'; line-height: 20px;">
          <div style="line-height: 20px;">The negative additions to Construction Work in Progress (CWIP) reflect transfers of $54 million from CWIP to plant in service upon unitization (offsets with Carrier Property additions above), partially offset by CWIP additions of $21 million during the period.</div>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB19BA071ACE3BA02F362CEE1DD30FFCC" xlink:to="HHB4C01297DDAAFCAD7BFF739FDDCE407C" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH654162810BCEE28E6FFF69FA5863DEEE" xlink:label="HH654162810BCEE28E6FFF69FA5863DEEE" />
    <link:footnote xlink:type="resource" xlink:label="HH3A11714EB99976A00A8CA026F0F33ACF" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: 'Segoe UI';">Effective March 1, 2025, Tank No. 407 was placed into operational service and reclassified from non&#8209;carrier property to carrier property, while Tank No. 412 was reclassified from carrier property to non&#8209;carrier property. The related </span>
          <span style="color: #000000; font-family: 'Segoe UI';">reclassification of accumulated depreciation through February 2025 is reflected in&#160;</span>
          <em style="color: #000000; font-family: 'Segoe UI';">Other Debits and Credits, Net (in dollars) (g).</em>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH654162810BCEE28E6FFF69FA5863DEEE" xlink:to="HH3A11714EB99976A00A8CA026F0F33ACF" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHC91C650B81C2B17305CC81DA9FBE7106" xlink:label="HHC91C650B81C2B17305CC81DA9FBE7106" />
    <link:footnote xlink:type="resource" xlink:label="HH1373659DD37BE17FA1C1662063F1534B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: 'Segoe UI';">Effective March 1, 2025, Tank No. 407 was placed into operational service and reclassified from non&#8209;carrier property to carrier property, while Tank No. 412 was reclassified from carrier property to non&#8209;carrier property.&#160;</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC91C650B81C2B17305CC81DA9FBE7106" xlink:to="HH1373659DD37BE17FA1C1662063F1534B" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH61195969E8DB57EBC71E91F85A2B07CA" xlink:label="HH61195969E8DB57EBC71E91F85A2B07CA" />
    <link:footnote xlink:type="resource" xlink:label="HHDB821E2D46B3CABC2F9B4DFA63222AB1" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Management believes that the information on this page has been prepared in accordance with the Commission's Opinion 154-B methodology. This presentation on page 700 is not necessarily in the form in which it would appear in connection with a challenge to a particular rate, or rates, and is therefore not intended to be binding in any specific rate litigation.</p>
        <p>Pursuant to the Commission's Remedial Order, issued on November 20, 2025, in Docket No. RM25-2-000, Total Interstate Operating Revenues include amounts recoverable during the Locked-In-Period from March 1, 2022, to September 17,2024.</p>
        <p>Totals may not sum due to rounding.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH61195969E8DB57EBC71E91F85A2B07CA" xlink:to="HHDB821E2D46B3CABC2F9B4DFA63222AB1" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>