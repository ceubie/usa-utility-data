    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH9612147A8CF48969F8AE3565031DE9DE" xlink:to="HHB02751807C072B1F808228D8EA264365" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0C3A2FD04307328532DD0B769DD5C856" xlink:label="HH0C3A2FD04307328532DD0B769DD5C856" />
    <link:footnote xlink:type="resource" xlink:label="HH1D012896DB2B6666878D62E38206531C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">The July 18, 2018 Commission order in Docket No. PL17-1-001 provided guidance regarding the Commission&#8217;s income tax allowance policy for pipelines owned by master limited partnerships and the related deferred tax balances, including balances in Account 282 (Accumulated Deferred Taxes-Other). The July 18 Order explained that MLP pipelines could elect </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">to </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">eliminate </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">certain </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">deferred </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">tax </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">balances. </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">Algonquin&#8217;s </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">parent </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">company, </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">Spectra </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">Energy </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">Partners, </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">LP, </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">has </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">a </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">pending request </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">with </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">the </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">FERC </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">Chief </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">Accountant </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">to </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">eliminate </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">amounts </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">recorded </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">in </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">Account </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">282, </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">including </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">amounts </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">in </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">Account </span>
          <span style="color: #000000; font-family: 'Arial',sans-serif; font-size: 10pt; font-weight: 400; line-height: 115%;">282 for Algonquin. Certain amounts in Account 282 may be excluded in the development of jurisdictional recourse rates in the future.</span>
        </div>
      </div>
    </link:footnote>
