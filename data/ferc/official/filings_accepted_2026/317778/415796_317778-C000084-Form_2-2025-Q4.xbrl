    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH202F54314DEFAAD414BD0A2FB6B6BE0D" xlink:to="HHBF8B6A89CA26EE610DC1C811B86EFBA2" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHFCE7BCAAC3A6D684FD360DDA5C5CA406" xlink:label="HHFCE7BCAAC3A6D684FD360DDA5C5CA406" />
    <link:footnote xlink:type="resource" xlink:label="HHAF37F1D4C1321E9A3439F44B23C268AC" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Depreciation expense for all listed projects has been calculated on a straight line basis.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHFCE7BCAAC3A6D684FD360DDA5C5CA406" xlink:to="HHAF37F1D4C1321E9A3439F44B23C268AC" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH757199E6C4713641D66A747CF68D73A2" xlink:label="HH757199E6C4713641D66A747CF68D73A2" />
    <link:footnote xlink:type="resource" xlink:label="HHBB6B60205772B3BB85AD2EF9C59D1005" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>For projects utilizing the system 2.00% composite depreciation rate, the accumulated depreciation reflects the Commission's composite depreciation methodology as outlined in Part 201 of the Commission's regulations.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH757199E6C4713641D66A747CF68D73A2" xlink:to="HHBB6B60205772B3BB85AD2EF9C59D1005" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHCCEE68ACC7E30C4D8A07ADC452911E43" xlink:label="HHCCEE68ACC7E30C4D8A07ADC452911E43" />
    <link:footnote xlink:type="resource" xlink:label="HH5B28943B96A15C7F55FF11A3E90A63BD" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>All tracked costs (fuel and ACA) were eliminated prior to allocating costs to incrementally priced services. In addition, the amount utilized for Account 850 has been normalized to remove prior period PS&amp;I provisions, if any (see Footnote for Schedule Page: 317 Line No.: 180).</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHCCEE68ACC7E30C4D8A07ADC452911E43" xlink:to="HH5B28943B96A15C7F55FF11A3E90A63BD" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHD7DA698EA059360452C0B6853D7CC910" xlink:label="HHD7DA698EA059360452C0B6853D7CC910" />
    <link:footnote xlink:type="resource" xlink:label="HH7113D31F9E7734C7C7A1A7BBDC3CFA08" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>All tracked costs (fuel) were eliminated prior to allocating costs to incrementally priced services.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHD7DA698EA059360452C0B6853D7CC910" xlink:to="HH7113D31F9E7734C7C7A1A7BBDC3CFA08" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH45ECA7AA1A80AF323167BA34C2BC7349" xlink:label="HH45ECA7AA1A80AF323167BA34C2BC7349" />
    <link:footnote xlink:type="resource" xlink:label="HH14386D11FCC4B53B6E843E266D88331B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>See Note to Page 274, Line No. 3, Column k.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH45ECA7AA1A80AF323167BA34C2BC7349" xlink:to="HH14386D11FCC4B53B6E843E266D88331B" order="1" />
  </link:footnoteLink>
