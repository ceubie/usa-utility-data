    <link:loc xlink:type="locator" xlink:href="#HHBE71FD0CE9899D316B05B16724F6B652" xlink:label="HHBE71FD0CE9899D316B05B16724F6B652" />
    <link:footnote xlink:type="resource" xlink:label="HHD13820A0C962155A90F40C7B818EA2CF" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Distributions paid to members during the six month period ended June 30, 2025 were $168,400,000. Distirbutions paid from Additional Paid-In Capitalwere $38,878,752 while Distributions paid from Unappropriated Retained Income were $129,521,248.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHBE71FD0CE9899D316B05B16724F6B652" xlink:to="HHD13820A0C962155A90F40C7B818EA2CF" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH300B32F9182BC695346626A935302C3A" xlink:label="HH300B32F9182BC695346626A935302C3A" />
    <link:footnote xlink:type="resource" xlink:label="HHD5142920016EE49829A75FFECCEC0DEB" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Distributions paid to members during the six month period ended June 30, 2026 were $164,100,000. Distirbutions paid from Additional Paid-In Capital were $36,431,132 while Distributions paid from Unappropriated Retained Income were $127,668,868.</p>
      </div>
    </link:footnote>
