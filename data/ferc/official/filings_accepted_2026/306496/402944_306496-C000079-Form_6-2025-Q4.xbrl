    <ferc:DescriptionOfMiscellaneousItem id="f-508" contextRef="c-99">Bad Debt Expense</ferc:DescriptionOfMiscellaneousItem>
    <ferc:DescriptionOfMiscellaneousItem id="f-509" contextRef="c-100">Minor Items, each less than $250,000</ferc:DescriptionOfMiscellaneousItem>
