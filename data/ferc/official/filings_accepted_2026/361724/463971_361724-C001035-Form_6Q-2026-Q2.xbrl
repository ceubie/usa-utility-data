  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C001035</ferc:CompanyIdentifier>
  <ferc:ReportYearPeriod id="HH6439FA2135BC4FC31DA52CEDA67ED097" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026/Q2</ferc:ReportYearPeriod>
  <ferc:ReportYear id="HH660FC444EE17A785BFF22BCDC6434313" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4" decimals="0" unitRef="HHferc_us_Pure">2026</ferc:ReportYear>
  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q2</ferc:ReportPeriod>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-09-04</ferc:ReportDate>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p class="MsoNormal" style="font-size: 14px;"&gt;1) None&lt;/p&gt;
&lt;p class="MsoNormal" style="font-size: 14px;"&gt;2) None&lt;/p&gt;
&lt;p class="MsoNormal" style="font-size: 14px;"&gt;3) None&lt;/p&gt;
&lt;p class="MsoNormal" style="font-size: 14px;"&gt;4) The Company is involved in various litigation arising from the normal operations of its pipeline business. The Company, based on the advice of counsel, believes that any adverse findings with respect to such legal actions will not result in a material effect on the financial position of the Company.&lt;/p&gt;
&lt;p class="MsoNormal" style="font-size: 14px;"&gt;5) Not Applicable&lt;/p&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p style="font-size: 14px;"&gt;&lt;strong&gt;Basis of Accounting&lt;/strong&gt;&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;SouthTex 66 Pipeline Company, Ltd. is subject to regulation by the Federal Energy Regulatory Commission (FERC). The accounting policies followed in preparation of these financial statements generally conform to those required by FERC.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;&lt;strong&gt;Pipeline Operator&lt;/strong&gt;&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;The respondent has no employees.The respondent's properties are operated by Phillips 66 Pipeline LLC as agent.&amp;#160;&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;&lt;strong&gt;Certification&lt;/strong&gt;&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;The certifying officer is Vice President of Phillips 66 Pipeline LLC, operator of SouthTex 66 Pipeline Company, Ltd.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;&lt;strong&gt;Officers/Directors&lt;/strong&gt;&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;As a partnership, the respondent does not have officers or directors as does a C-corp.&amp;#160; The operational contact of the managing partner is listed on Page 104, Principal General Officers, and Page 105, Directors, is identified on Page 2, List of Schedules, as "None".&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;&lt;strong&gt;Participation in a Cash Management Program&lt;/strong&gt;&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;The respondent reports on the Balance Sheet and Statement of Cash Flows a zero cash balance due to participation in a cash management program.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;In accordance with FERC Order 634-A, 68 FR 62004, October 31, 2003 as amended at 69 FR 9045, February 26, 2004, a Cash Management Agreement has been filed with FERC.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Cash management or "money pool" programs typically concentrate affiliates' cash asset in joint accounts for the purpose of providing financial flexibility and lowering the cost of borrowing.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;&lt;strong&gt;Company History&lt;/strong&gt;&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Partnership formed 7/12/1999 by WesTTex 66 Pipeline Company and SouthTex Pipeline Holding Company.&amp;#160; SouthTex 66Pipeline Company, Ltd. was contributed to Chevron Phillips Chemical Company LLC on 7/1/2000.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;&lt;strong&gt;Accounting for Partner Capital&lt;/strong&gt;&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;SouthTex 66 Pipeline Company, Ltd. is organized as a limited partnership under the Texas Limited Partnership Laws.&amp;#160; &amp;#160;Partnerships do not have capital stock and retained income, but rather combine partner capital and undistributed earnings as Partner Capital.&amp;#160; In the absence of a Partner Capital account in the Uniform System of Accounts, Partner Capital and undistributed earnings are captured in FERC Account 70, Capital Stock.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Page 119, Unappropriated Retained Income Statement, is not included in the financial reports provided because there is no balance in Account 75, Unappropriated Retained Income, for which Page 119 supports.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Because SouthTex 66 Pipeline Company, Ltd., as a partnership, has Partner Capital and does not have Capital Stock,Page 250-251, Capital Stock, and Page 252-253, Capital Stock Changes During the Year, are not included in the financial reports.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;&lt;strong&gt;Recognition of Income Taxes&lt;/strong&gt;&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Because Partnerships are not subject to income taxes, the recognition of income tax expense, income taxes payable and deferred income tax assets and liabilities is not customary.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;The recognition of income taxes results from the May 18, 2006 passage of Texas House Bill 3 ("HB 3").&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;On May 18, 2006 Texas House Bill 3 was signed into law.&amp;#160; HB 3 replaced the Texas franchise tax with an Alternative Margins Tax, beginning January 1, 2007.&amp;#160;&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;House Bill 3 includes partnerships and limited liability companies in the definition of a &amp;#8220;taxable entity&amp;#8221; resulting in partnerships and limited liability companies being subject to franchise tax.While HB 3 specifically states that the modified tax is &amp;#8220;not an income tax&amp;#8221;, the magnitude of the deductions applied in determining the tax base under FAS 109 (Accounting for Income Taxes) requires it to be accounted for as income taxes.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Since the respondent is a Texas limited partnership, income taxes and deferred income taxes were not reported prior to passage of HB 3.&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Rather than repeat a footnote at every occurrence of Income Tax related activity on each affected Page in this report, this note serves to identify and explain why income taxes may appear on the following Pages:&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Page 110, Line 13 - Current Deferred Income Tax Assets (19-5)&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Page 111, Line 42 - Noncurrent Deferred Income Tax Assets (45)&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Page 113, Line 56 - Current Deferred Income Tax Liabilities (59)&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Page 113, Line 62 - Noncurrent Accumulated Deferred Income Tax Liabilities (64)&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Page 114, Line 16 - Income Taxes on Income from Continuing Operations (670)&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;Page 114, Line 17 - Provision for Deferred Income Taxes (671)&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;&amp;#160;Page 120, Line 08 - Deferred Income Taxes&lt;/p&gt;
&lt;p style="font-size: 14px;"&gt;&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
