  <ferc:FederalIncomeTaxForOtherPropertyChangesCreditedToProvisionForDeferredIncomeTaxesOperatingIncome id="f45" contextRef="c1" unitRef="u1" decimals="0">0</ferc:FederalIncomeTaxForOtherPropertyChangesCreditedToProvisionForDeferredIncomeTaxesOperatingIncome>
