  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-1" contextRef="c-1">Amy Perlman</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:TitleOfOfficerWithCustodyOfCorporateBooks id="f-2" contextRef="c-1">Vice President and Chief Accounting Officer - ITC Holdings Corp.</ferc:TitleOfOfficerWithCustodyOfCorporateBooks>
  <ferc:AddressWhereCorporateBooksAreKept id="f-3" contextRef="c-1">27175 Energy Way, Novi, Michigan 48377</ferc:AddressWhereCorporateBooksAreKept>
  <ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription id="f-4" contextRef="c-1">Not Applicable</ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription>
  <ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered id="f-5" contextRef="c-1">Transmission of electricity within the State of Michigan with the exception of an immaterial amount of electric plant in Indiana at an interconnection point on the Michigan/Indiana border.</ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-6" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
