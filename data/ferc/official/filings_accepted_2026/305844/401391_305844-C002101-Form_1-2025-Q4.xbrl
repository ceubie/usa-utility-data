            </td>
            <td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">(102,864)</span>
