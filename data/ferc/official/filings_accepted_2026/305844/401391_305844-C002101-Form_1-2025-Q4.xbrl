            </td>
            <td style="border-top:1pt solid #000;padding:2px 0;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">3,347,189,494&#160;</span>
            </td>
