&lt;/td&gt;
&lt;td style="width: 81.7pt; border-bottom: 1pt solid #000000; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; text-align: center; page-break-after: avoid; font-size: 10pt;"&gt;&lt;font style="font-family: Arial;"&gt;2024&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 14.25pt; -aw-height-rule: exactly;"&gt;
&lt;td style="width: 248.2pt; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: bottom;"&gt;
