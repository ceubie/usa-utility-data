    <link:footnoteArc xlink:type="arc" xlink:from="value144" xlink:to="footnote144" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="144" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote146" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Due to FERC Form 2 programming constraints, line 21 reflects intangible balances and not Production-Manufactured Gas as labeled.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value146" xlink:to="footnote146" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="146" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote147" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Represents the total miles of jointly owned pipe for Niagara Spur section. Supply Corporation's share is 56.72%, Tennessee Gas Pipeline's share is 32.63% and Dominion Transmission Corporation's share is 10.65%.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value147" xlink:to="footnote147" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="147" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote148" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Represents two jointly owned transmission pipelines in Pennsylvania. YM-53, which totals 41.6 miles, is jointly owned with Dominion Transmission Corporation. Supply Corporation's ownership percentage is 73.23% and Dominion Transmission Corporation's share is 26.77%. YM-54, which totals 2.4 miles, is jointly owned with Dominion Transmission Corporation. Supply Corporation's ownership percentage is 64.35% and Dominion Transmission Corporation's share is 35.65%.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value148" xlink:to="footnote148" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="148" />
