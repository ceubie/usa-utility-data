      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table style="border-collapse: collapse; width: 100%; height: 80px;" border="0">
          <xhtml:tbody>
            <xhtml:tr style="height: 20px;">
              <xhtml:td style="width: 73.9933%; height: 20px;">Page 219, Line 12 (c), Book Cost of Plant Retired</xhtml:td>
              <xhtml:td style="width: 26.0067%; height: 20px; text-align: right;">$6,946,906</xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="height: 20px;">
              <xhtml:td style="width: 73.9933%; height: 20px;">
              </xhtml:td>
              <xhtml:td style="width: 26.0067%; height: 20px; text-align: right;">
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="height: 20px;">
              <xhtml:td style="width: 73.9933%; height: 20px;">Retirements recorded to Account 421</xhtml:td>
              <xhtml:td style="width: 26.0067%; height: 20px; text-align: right;">471,210</xhtml:td>
