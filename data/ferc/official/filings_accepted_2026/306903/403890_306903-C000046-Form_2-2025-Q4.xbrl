&lt;td style="width: 66pt; padding-right: 0.75pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; text-align: right; font-size: 10pt;"&gt;&lt;font style="font-family: Arial;"&gt;$&lt;/font&gt;&lt;font style="width: 4.54pt; font-family: Arial; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 10.1pt;"&gt; &amp;#160;&lt;/font&gt;&lt;font style="font-family: Arial;"&gt;38,977,562&lt;/font&gt;&lt;font style="width: 3.2pt; font-family: Arial; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 63.35pt;"&gt; &amp;#160;&lt;/font&gt;&lt;/p&gt;
