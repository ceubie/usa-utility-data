            <xhtml:tr style="mso-yfti-irow: 3; mso-yfti-lastrow: yes;">
              <xhtml:td style="width: 526.25pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="702">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Total </xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 193.25pt; border-top: none; border-left: none; border-bottom: solid windowtext 4.5pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: 4.5pt; mso-border-left-alt: .5pt; mso-border-bottom-alt: 4.5pt; mso-border-right-alt: .5pt; mso-border-color-alt: windowtext; mso-border-style-alt: solid; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="258">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">32,651,029</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
          </xhtml:tbody>
        </xhtml:table>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value4" xlink:to="footnote4" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="4" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote5" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Line 12 consists of decreases in field inventory. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value5" xlink:to="footnote5" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="5" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote6" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">The value of this gas is based on the current month cash-out price provided for in our tariff. This footnote applies to all periods within the quarter. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value6" xlink:to="footnote6" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="6" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote7" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">We use a non-revenue recognition method for shipper-supplied gas which results in accounting entries for net fuel over or under-collected rather than separate revenue entries for shipper-supplied gas and expenses for gas used in compressors. This footnote applies to all periods within the quarter. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value7" xlink:to="footnote7" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="7" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote8" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 24px;">Recorded pursuant to Docket No. AI93-5-000 issued on April 23, 1993 (Accounting for Income Taxes).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value8" xlink:to="footnote8" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="8" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote9" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 24px;">Recorded pursuant to Section 3.4 of rate schedule SS-P.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
