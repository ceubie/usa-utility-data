&lt;td style="width: 140.78pt; border: 0.75pt solid #000000; padding-right: 4.53pt; vertical-align: bottom; -aw-border: 0.5pt single;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;0.9&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 8.52pt; border: 0.75pt solid #000000; padding-right: 5.28pt; vertical-align: bottom; -aw-border: 0.5pt single;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 16pt;"&gt;&lt;font style="-aw-import: ignore;"&gt; &amp;#160;&lt;/font&gt;&lt;/p&gt;
