  <ferc:FormType id="HHF7EC89F6B6814CD2CC1C6928B801FC93" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">60</ferc:FormType>
  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C011112</ferc:CompanyIdentifier>
  <ferc:ReportYear id="HH660FC444EE17A785BFF22BCDC6434313" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4" decimals="0" unitRef="HHferc_us_Pure">2025</ferc:ReportYear>
  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q4</ferc:ReportPeriod>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-05-01</ferc:ReportDate>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-weight: bold;"&gt;ATC Management Inc.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-weight: bold;"&gt;Notes to Financial Statements as of December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-weight: bold;"&gt;202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-weight: bold;"&gt;5&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-weight: bold;"&gt; and 202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-weight: bold;"&gt;4&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-weight: bold;"&gt; and for the Years Ended &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-weight: bold;"&gt;December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-weight: bold;"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-weight: bold;"&gt; and 2024&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-indent: -35.94pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(1)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Nature of Operations and Summary of Significant Accounting Policies&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 12pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-indent: -18pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(a)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;General&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 12pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ATC Management Inc. (&amp;#8220;Management Inc.&amp;#8221;), a C corporation organized &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;in&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 2000, functions as the corporate manager of American Transmission Company LLC (ATC LLC) and is a centralized service company under Federal Energy Regulatory Commission (FERC) regulations.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ATC LLC was &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;organized,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; as a limited liability company under the Wisconsin Limited Liability Company Act, as a single-purpose, for-profit electric transmission company.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Its purpose is to plan, construct, operate, own and maintain electric transmission facilities to provide an adequate and reliable transmission system that meets the needs of all users on the system and provides transmission service that supports equal access to a competitive, wholesale, electric energy market.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. and ATC LLC, collectively &amp;#8220;the Company&amp;#8221;, have common ownership and operate as a single functional unit.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;All employees who serve ATC LLC are employees of Management Inc., and ATC LLC has no governance structure separate from Management Inc.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Under the ATC LLC operating agreement (&amp;#8220;Operating Agreement&amp;#8221;), Management Inc. has complete discretion over the business of ATC LLC and provides all management services to ATC LLC at cost.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The Operating Agreement establishes that all expenses of Management Inc. incurred on behalf of ATC LLC are the responsibility of ATC LLC.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;These expenses consist primarily of payroll, benefits, payroll-related taxes and other employee-related expenses.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;All such expenses are recorded in ATC LLC&amp;#8217;s accounts as if they were direct expenses of ATC LLC.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ATC Development Company LLC (&amp;#8220;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Development LLC&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#8221;)&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, which is not a subsidiary of either ATC LLC or Management Inc.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; was created in 2016 to formally separate ATC LLC&amp;#8217;s development activities from operations in its traditional footprint.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. and ATC Development Manager Inc. (&amp;#8220;Development Manager&amp;#8221;), corporate manager of Development LLC, have an overhead sharing agreement, approved by the Public Service Commission of Wisconsin in 2015.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;In accordance with the agreement, Management Inc. provides management services to Development LLC, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;which are billed &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;through Development&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; Manager, at cost.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;See Note 6(b) for further discussion of Development LLC.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. uses all proceeds from the sale of shares of its common stock to purchase equity interests in ATC LLC.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. owned &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;approximate&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ly one one-hundredth of one percent of the outstanding member units of ATC LLC as of December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and 2024.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Although Management Inc. has control over the operations of ATC LLC as delegated to it by the Operating Agreement, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;it accounts for its investment in ATC LLC under the equity method of accounting &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;in Account 123, Investment in Associate Companies, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;as it &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;owns less than a substantive percentage of the outstanding member units of ATC LLC.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;See Note 6(a) for further discussion of ATC LLC. &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-indent: -18pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(b)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Basis of Presentation&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;These financial statements were prepared in accordance with the accounting regulations of FERC, as set forth in its Uniform System of Accounts (USOA), which is a comprehensive basis of accounting other than accounting principles generally accepted in the United States of America (U.S. GAAP).&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Accordingly, differences exist between these financial statements and Management Inc.&amp;#8217;s financial statements prepared in accordance with U.S. GAAP, largely attributable to balance sheet classification of intercompany payables and receivables and deferred income taxes.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Additionally, pursuant to the Bill of Sale and Right to Repurchase Agreement, Management Inc. has a joint plant agreement with ATC LLC resulting in a one-millionth ownership interest in the transmission&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and general plant of ATC LLC.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The following amounts are reported in Management Inc.&amp;#8217;s balance sheets prepared in accordance with U.S. GAAP at December 31 (in thousands):&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;img style="-aw-left-pos: 0pt; -aw-rel-hpos: column; -aw-rel-vpos: paragraph; -aw-top-pos: 0pt; -aw-wrap-type: inline;" src="data:image/jpeg;base64," alt="" width="445" height="96" /&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-indent: -18pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(c)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Cash and Cash Equivalents&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 12pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Account 131, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Cash&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; include&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;s&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; highly liquid investments with original maturities of three months or less.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. pays no cash for interest, and ATC LLC pays cash for income taxes on Management Inc.&amp;#8217;s behalf.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. had no cash or cash equivalents on its balance sheets&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; as of December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;5&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; or 202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;4, and it &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;intends to maintain a zero&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;cash balance&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 35.3pt; margin-bottom: 0pt; text-indent: -18pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(d)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="width: 4.56pt; text-indent: 0pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Use of Estimates &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The preparation of financial statements in conformity with U.S. GAAP requires management to apply policies and make estimates and assumptions that affect the reported amounts of assets and liabilities, the disclosure of contingent assets and liabilities at the date of the financial statements and the reported amounts of revenues and expenses during the reporting period.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Estimates are used for items such as tax provisions, actuarially&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; determined&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; benefit costs&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and operations and maintenance expenses.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;As additional information becomes available, or actual amounts are determined, the recorded estimates are revised.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Consequently, operating results can be affected by revisions to prior accounting estimates.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 22.44pt; margin-bottom: 0pt; text-indent: -22.44pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(2)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Revenue Recognition&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 6pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. recognizes revenues as services are provided to associate companies.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 6pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 22.44pt; margin-bottom: 0pt; text-indent: -22.44pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(3)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Benefits&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 12pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. sponsors several benefit plans for its employees.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;These plans include certain postretirement medical, dental&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, vision&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and life insurance benefits (&amp;#8220;postretirement healthcare benefits&amp;#8221;).&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The weighted-average assumptions related to the postretirement &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;healthcare&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; benefits, as of the measurement date&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; of December 31,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; are as f&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ollows&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;img style="-aw-left-pos: 0pt; -aw-rel-hpos: column; -aw-rel-vpos: paragraph; -aw-top-pos: 0pt; -aw-wrap-type: inline;" src="data:image/jpeg;base64," alt="" width="444" height="158" /&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The components of Management Inc.&amp;#8217;s postretirement healthcare benefit net &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;credits&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;recognized by the Company during&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 2025 and 2024 are&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; as follows (in thousands):&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;img style="-aw-left-pos: 0pt; -aw-rel-hpos: column; -aw-rel-vpos: paragraph; -aw-top-pos: 0pt; -aw-wrap-type: inline;" src="data:image/jpeg;base64," alt="" width="445" height="184" /&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;To recognize the over-funded status of its postretirement healthcare benefit plan in accordance with the Financial Accounting Standards Board&amp;#8217;s (FASB) Accounting Standards Codification (ASC) Topic 715, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;Management Inc. recorded long-term &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;assets&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt; in Account 186, Miscellaneous Deferred Debits,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt; related to its postretirement benefit plan &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;of &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;$1.8 million and $2.7 million as of December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt; and 2024,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt; respectively.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;In addition, Management Inc. had the following amounts not yet reflected in net periodic benefit cost as of December 31 (in thousands):&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;img style="-aw-left-pos: 0pt; -aw-rel-hpos: column; -aw-rel-vpos: paragraph; -aw-top-pos: 0pt; -aw-wrap-type: inline;" src="data:image/jpeg;base64," alt="" width="554" height="117" /&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The funded &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;position&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; of Management Inc.&amp;#8217;s postretirement healthcare benefit plan as of December 31&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;is as follows (in thousands):&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;img style="-aw-left-pos: 0pt; -aw-rel-hpos: column; -aw-rel-vpos: paragraph; -aw-top-pos: 0pt; -aw-wrap-type: inline;" src="data:image/jpeg;base64," alt="" width="554" height="360" /&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The benefit obligation a&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;t&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; increased from December&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;4&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; primarily due to changes in &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;claims and contributions and updated medical trend rates.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;Management Inc. does not anticipate contributing to the plan for postretirement healthcare benefit obligations during 2026.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. anticipates net retiree healthcare benefit payments for the next 10 years to be as follows (in thousands):&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;img style="-aw-left-pos: 0pt; -aw-rel-hpos: column; -aw-rel-vpos: paragraph; -aw-top-pos: 0pt; -aw-wrap-type: inline;" src="data:image/jpeg;base64," alt="" width="160" height="163" /&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;To fund postretirement healthcare benefit obligations, Management Inc. has, in the past, contributed to its &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Voluntary Employees&amp;#8217; Beneficiary Association (&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;VEBA&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;)&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; trust.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The funds restricted for postretirement healthcare benefits within the&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; VEBA trust, along with the 401(h) trust&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;previously established by Management Inc. to fund postretirement healthcare benefits, are discretionary trusts with a long-term investment objective to preserve and &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;enhance the post-inflation value of the trusts&amp;#8217; assets, subject to cash flow requirements, while maintaining an acceptable level of volatility.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The composition of the fair value of total plan assets held in the trusts &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;and restricted for &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;postretirement&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; healthcare benefits &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;as of December 31, along with targeted allocation percentages&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and the acceptable range of deviation from those targets&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; for each major category of plan assets in the trusts, is as follows:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;img style="-aw-left-pos: 0pt; -aw-rel-hpos: column; -aw-rel-vpos: paragraph; -aw-top-pos: 0pt; -aw-wrap-type: inline;" src="data:image/jpeg;base64," alt="" width="625" height="138" /&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. appoints a trustee to maintain investment discretion over trust assets.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The trustee is responsible for holding and investing plan assets in accordance with the terms of Management Inc.&amp;#8217;s trust agreement, including investing within the targeted allocation percentages.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The asset classes designated above and &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;described below&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; serve as guides for the selection of individual investment vehicles by the trustee:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;ul style="margin: 0pt; padding-left: 0pt;" type="disc"&gt;
&lt;li style="margin-left: 46.06pt; margin-bottom: 3pt; text-align: justify; line-height: 14pt; padding-left: 7.94pt; font-family: serif; font-size: 11pt; -aw-font-family: 'Symbol'; -aw-font-weight: normal; -aw-number-format: '&amp;#61623;';"&gt;&lt;span style="font-family: 'Arial Narrow'; font-style: italic; text-decoration: underline;"&gt;U.S. Equities&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt; &amp;#8211; S&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;trategy of achieving long-term growth of capital and dividend income through investing primarily in common stock of companies in the U.S. stock market with the &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;Wilshire 5000 Index&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt; (or a comparable broad U.S. stock index) as the investment benchmark.&lt;/span&gt;&lt;/li&gt;
&lt;li style="margin-left: 46.06pt; margin-bottom: 3pt; text-align: justify; line-height: 14pt; padding-left: 7.94pt; font-family: serif; font-size: 11pt; -aw-font-family: 'Symbol'; -aw-font-weight: normal; -aw-number-format: '&amp;#61623;';"&gt;&lt;span style="font-family: 'Arial Narrow'; font-style: italic; text-decoration: underline;"&gt;Non-U.S. Equities&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt; &amp;#8211; S&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;trategy of achieving long-term growth of capital and dividend income through investing primarily in common stock of companies in the non-U.S. stock markets with the Morgan Stanley Capital Index All Country World ex-U.S. Index (or a comparable broad non-U.S. stock index) as the investment benchmark.&lt;/span&gt;&lt;/li&gt;
&lt;li style="margin-left: 46.06pt; text-align: justify; line-height: 14pt; padding-left: 7.94pt; font-family: serif; font-size: 11pt; -aw-font-family: 'Symbol'; -aw-font-weight: normal; -aw-number-format: '&amp;#61623;';"&gt;&lt;span style="font-family: 'Arial Narrow'; font-style: italic; text-decoration: underline;"&gt;Fixed Income&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt; &amp;#8211; Strategy of achieving total return from current income and capital appreciation by investing in a diversified portfolio of fixed-income securities with the Barclays Capital Aggregate Index (or a comparable broad bond index) as the investment benchmark.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The objective of the investment vehicles is to minimize risk of large losses by effective diversification.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The investment vehicles will attempt to rank better than the median vehicle in their respective peer group.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;However, these investments are intended to be viewed over the long term; during the short term, there will be fluctuations in rates of return characteristic of the securities markets.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. measures its plan assets at fair value according to the hierarchy set forth in ASC Topic 820, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#8220;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Fair Value Measurements&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#8221;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The three levels of the fair value hierarchy under ASC Topic 820 are:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 12pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 88.55pt; margin-bottom: 0pt; text-indent: -34.55pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Level 1&lt;/span&gt;&lt;span style="width: 18.53pt; text-indent: 0pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Inputs to the valuation methodology are unadjusted quoted prices for identical assets in active markets that Management Inc.&amp;#8217;s &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;postretirement&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; healthcare benefit plans &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;can&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; access.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 88.55pt; margin-bottom: 0pt; text-indent: -34.55pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Level 2&lt;/span&gt;&lt;span style="width: 18.53pt; text-indent: 0pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Observable market-based inputs or unobservable inputs that are corroborated by market data.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Inputs to the valuation methodology include:&lt;/span&gt;&lt;/p&gt;
&lt;ul style="margin: 0pt; padding-left: 0pt;" type="disc"&gt;
&lt;li style="margin-left: 98.61pt; text-align: justify; line-height: 14pt; padding-left: 7.94pt; font-family: serif; font-size: 11pt; -aw-font-family: 'Symbol'; -aw-font-weight: normal; -aw-number-format: '&amp;#61623;';"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;Quoted prices for similar assets in active markets&lt;/span&gt;&lt;/li&gt;
&lt;li style="margin-left: 98.61pt; text-align: justify; line-height: 14pt; padding-left: 7.94pt; font-family: serif; font-size: 11pt; -aw-font-family: 'Symbol'; -aw-font-weight: normal; -aw-number-format: '&amp;#61623;';"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;Quoted prices for identical or similar assets in inactive markets&lt;/span&gt;&lt;/li&gt;
&lt;li style="margin-left: 98.61pt; text-align: justify; line-height: 14pt; padding-left: 7.94pt; font-family: serif; font-size: 11pt; -aw-font-family: 'Symbol'; -aw-font-weight: normal; -aw-number-format: '&amp;#61623;';"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;Inputs other than quoted prices that are observable for the asset&lt;/span&gt;&lt;/li&gt;
&lt;li style="margin-left: 98.61pt; text-align: justify; line-height: 14pt; padding-left: 7.94pt; font-family: serif; font-size: 11pt; -aw-font-family: 'Symbol'; -aw-font-weight: normal; -aw-number-format: '&amp;#61623;';"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;Inputs that are derived principally from, or corroborated by, observable market data by correlation or other means&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 12pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 88.55pt; margin-bottom: 0pt; text-indent: -34.55pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Level 3&lt;/span&gt;&lt;span style="width: 18.53pt; text-indent: 0pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Inputs to the valuation methodology that are unobservable and not corroborated by market data.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 12pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The asset or liability&amp;#8217;s fair value measurement level within the fair value hierarchy is based on the lowest level of any input that is significant to the fair value measurement.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Valuation techniques used need to maximize the use of observable inputs and minimize the use of unobservable inputs.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;There have been no changes to the methodologies used as&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; of December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;5&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and 202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;4&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The following are descriptions of the valuation methodologies used for investments measured at fair value:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 12pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;ul style="margin: 0pt; padding-left: 0pt;" type="disc"&gt;
&lt;li style="margin-left: 46.06pt; text-align: justify; line-height: 14pt; padding-left: 7.94pt; font-family: serif; font-size: 11pt; -aw-font-family: 'Symbol'; -aw-font-weight: normal; -aw-number-format: '&amp;#61623;';"&gt;&lt;span style="font-family: 'Arial Narrow'; font-style: italic;"&gt;Money Market Fund:&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt; Valued at the net asset value of the shares held by the plan at year end.&lt;/span&gt;&lt;/li&gt;
&lt;li style="margin-left: 46.06pt; text-align: justify; line-height: 14pt; padding-left: 7.94pt; font-family: serif; font-size: 11pt; -aw-font-family: 'Symbol'; -aw-font-weight: normal; -aw-number-format: '&amp;#61623;';"&gt;&lt;span style="font-family: 'Arial Narrow'; font-style: italic;"&gt;Mutual Funds:&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow';"&gt; Valued at the net asset value of shares held by the plan at year end.&lt;/span&gt;&lt;/li&gt;
&lt;/ul&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The following table contains, by level within the fair value hierarchy, Management Inc.&amp;#8217;s &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;postretirement healthcare benefit&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; account investments at fair value as of December 31 (in thousands):&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;img style="-aw-left-pos: 0pt; -aw-rel-hpos: column; -aw-rel-vpos: paragraph; -aw-top-pos: 0pt; -aw-wrap-type: inline;" src="data:image/jpeg;base64," alt="" width="625" height="205" /&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Measurements for Management Inc.&amp;#8217;s Level 2 in&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;vestments&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; are based on inputs other than quoted prices that are observable for these assets.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. sponsors a defined contribution money-purchase pension plan, in which substantially all employees participate, and contribut&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;es&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; to the plan for each participant based on several factors.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Contributions made by Management Inc. to the plan and charged to expense totaled&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;$4.7 million&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; $4.1 million during 2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 2024, respectively.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. also provides a deferred compensation plan for certain employees.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The plan allows for the elective deferral of a portion of an employee&amp;#8217;s base salary and incentive compensation and contains a supplemental retirement and 401(k) component&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;As of December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and 2024, $22.6 million and $22.5 &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;million respectively, were included in&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Account 228.3, Accumulated Provision for Pensions and Benefits,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; related to this deferred compensation plan.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Deferred amounts are taxable to the employee when paid, but Management Inc. recognizes compensation expense in the period earned.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The amounts charged to expense, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;including interest accruals, were $2.2 million&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; $1.9 million in 2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 2024, respectively.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 22.79pt; margin-bottom: 0pt; text-indent: -22.79pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(4)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Income Taxes &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 12pt; -aw-import: spaces;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The income tax provision for Management Inc. for the year&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;s&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ended&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; December&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;31 consisted of the following (in thousands):&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;img style="-aw-left-pos: 0pt; -aw-rel-hpos: column; -aw-rel-vpos: paragraph; -aw-top-pos: 0pt; -aw-wrap-type: inline;" src="data:image/jpeg;base64," alt="" width="431" height="137" /&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Deferred taxes are primarily related to timing differences in the deductibility of certain employee&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; benefit&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;-related costs&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;. &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. h&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ad net deferred tax assets &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;in Account 190, Accumulated Deferred Income Taxes,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;of $13.4 million and $13.3 million as of December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and 2024, respectively&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;consisting &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;primarily &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;of employee&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; benefit&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;-related costs that will be deductible in&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;future years.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc.&amp;#8217;s income tax provision is comprised of the tax expense of permanent tax differences and the provision related to its equity investment in ATC LLC.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;For the years &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ended December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 2024, the tax expense of permanent tax differences was $97 thousand&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; $59 thousand, respectively.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. allocates the tax benefit or expense of permanent tax&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; differences to ATC LLC in the form of a higher or lower management fee.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Those tax effects are considered in the determination of ATC LLC's revenue requirement.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;As Management Inc.&amp;#8217;s net income is derived solely from the small amount of equity income from its ownership interest in ATC LLC, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;which &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;is &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;approximately .01 percent, the&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; effective tax rate will vary significantly from the statutory rate if any permanent tax differences e&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;xist.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;For the years ended December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;5&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;4&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, Management Inc.&amp;#8217;s income tax provision for its equity investment &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;in ATC LLC was $12 thousand&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; $13 thousand, respectively.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ASC Topic 740, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#8220;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Income Taxes&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#8221;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, provides guidance on recognition thresholds and measurement of a tax position taken or expected to be taken in a tax return, including whether an entity is taxable in a particular jurisdiction.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. does not consider any of its tax positions to be uncertain&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Additionally, Management Inc. had no material amounts of unrecognized tax benefits and &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;was assessed no material amounts of interest or penalties&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; during &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;5 or&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;4&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;is no longer subject to examination by the Internal Revenue Service for tax &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;years prior to 202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; or any state jurisdiction for tax years prior to 202&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;1.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;If Management Inc. would be assessed interest or penalties by a taxing authority related to income taxes, interest&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; would be recorded in &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Account 431, Other I&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;nterest &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;E&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;xpense, and penalties would be recorded in &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Account 426.3, Penalties&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 22.44pt; margin-bottom: 0pt; text-indent: -22.44pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(5)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Potential Adverse Legal Proceedings&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;From time to time, the Company is involved in certain legal proceedings concerning matters arising in the ordinary course of business.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;These proceedings could potentially include suits that involve claims for which it may not have sufficient insurance coverage.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Per the ATC LLC operating agreement, any result&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;i&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ng liability would be reimbursed &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;by ATC LLC.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Likewise, per the Development LLC operating agreement, any resulting liability from business development-related claims are the responsibility of Development LLC.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 22.44pt; margin-bottom: 0pt; text-indent: -22.44pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(6)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Related-Party Transactions&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-indent: -18pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(a)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;ATC LLC&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ATC LLC currently owns and operates the electric transmission system, under the direction of &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;the Midcontinent Independent System Operator, Inc.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, in parts of Wisconsin, Illinois, Minnesota and the Upper Peninsula of Michigan.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ATC LLC is subject to regulation by FERC as to rates, terms of service and financing, and &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;by state&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; regulatory commissions as to other aspects of business, including the construction of electric transmission assets.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;As discussed in Note 1(a), all employees who serve ATC LLC are employees of Management Inc., and Management Inc. has complete discretion over the business of ATC LLC and provides all management services to ATC LLC at cost.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. charged ATC LLC approximately &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;$139 million and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; $121 million in 2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 2024, respectively&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, primarily for employee-related expenses&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, which were recorded in Account 457.1, Direct Costs Charged to Associate Companies&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc.&amp;#8217;s net income is derived primarily from its equity investment &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;in ATC LLC&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;During 2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 2024, Management Inc.&amp;#8217;s after-tax earnings w&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ere&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; approximately $3&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;3&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; thousand&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; $34 thousand, respectively.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Distributions of ATC LLC earnings to members&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;are&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; at the discretion of Management Inc.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The Operating Agreement established a target for &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;distribution of 80 percent&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; of annual earnings before members&amp;#8217; income taxes.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;During 2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 2024, ATC LLC made distributions to Management Inc. of $39 thousand&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; $34 thousand&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, respectively&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;board of directors of Management Inc. approved a distribution of earnings from ATC LLC for the fourth quarter of &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2025, which was paid on January 30, 2026.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc.&amp;#8217;s portion of that distribution was approximately $9 thousand.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;As of December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 2024, Management Inc. had net receivables from ATC LLC of $44.0 million&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; $38.7 million, respectively, included &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;in &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Account 146,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; Accounts Receivable from Associate Companies&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Th&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ese&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; amount&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;s&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, which &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;are&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; primarily related to payroll and benefits&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;,&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; also include other long-term liabilities related primarily to certain long-term compensation arrangements covering Management Inc. employees, as described in Note (&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;3&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;).&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="font-family: 'Arial Narrow';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-indent: -18pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(b)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Development LLC&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;As discussed in Note 1(a), &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;charges external development activity costs to Development LLC&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; through Development LLC&amp;#8217;s corporate manager&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. charged Development LLC approximately $88 thousand&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; $70 thousand in 2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; and&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2024, respectively&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;, primarily for employee&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;-related expenses&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; in Account 457.1&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;As of December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; Management Inc. had a net &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;payable&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; to Development LLC of $1 thousand, and as of December 31, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2024&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; Management Inc. had a net receivable from Development LLC of $9 thousand, both were included in Account 146.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 9pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 22.44pt; margin-bottom: 0pt; text-indent: -22.44pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(7)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;New Accounting Pronouncements&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;I&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;n December 2025, FASB issued &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Accounting Standards Update (&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ASU&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;) No.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; 2025-12, Codification Improvements, which aims to clarify existing guidance, correct technical errors, and provide minor improvements to enhance understandability and application of various topics within the accounting standards codification.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;The amendments &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;under ASU 2025-12 become effective for the annual reporting period ending December 31, 2027, with early adoption permitted on an issue-by-issue basis.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;We are currently assessing the impacts of this ASU; however, we do not anticipate that these updates will have a material impact on our financial position, results of operations or cash flows.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;In December 2023, FASB issued ASU 2023-09, Income Taxes (Topic 740): Improvements to Income Tax Disclosures.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Below are the key elements of the amended guidance:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-indent: -18pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(a)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Rate Reconciliation &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;All entities must disclose information that enables a financial statement user to understand the nature, effects and underlying causes of reconciling items that result in a significant difference between the entity&amp;#8217;s statutory tax rate and effective tax rate.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. is not a public business entity (PBE) and in accordance with the guidance in ASU&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2023-09, Management Inc. may satisfy this disclosure objective qualitatively.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ASU 2023-09 requires additional details for certain reconciling items that meet or exceed a dollar threshold, computed as five percent of Management Inc.&amp;#8217;s pretax income or loss multiplied by the applicable statutory income tax rate.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Further disaggregation, such as by taxing jurisdiction, and qualitative disclosures, such as nature, effect, and underlying causes of reconciling items, may be required based on the reconciling item&amp;#8217;s categorization.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Significant judgements used in categorizing the reconciling items are also required to be disclosed.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-indent: -18pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(b)&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Income Taxes&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt; Paid&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Management Inc. must disclose annually the amount of income taxes paid, net of refunds received, with separate amounts disclosed for federal and state taxes.&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;Further disaggregation is required when the net amount paid to an individual jurisdiction meets or exceeds five percent of total income taxes paid, &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;net&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; of refunds received.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(c)&lt;/span&gt;&lt;span style="width: 5.17pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Other Income Tax Disclosures&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;ASU&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2023-09 requires Management Inc. to disclose the amount of income tax expense, or benefit, separated by federal and state jurisdictions.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;(d)&lt;/span&gt;&lt;span style="width: 4.56pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt; text-decoration: underline;"&gt;Effective Date and Transition&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; text-align: justify; line-height: 14pt;"&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;As &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;a non&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;-PBE, the amendments in this ASU&lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;2023-09 are effective for Management Inc. for &lt;/span&gt;&lt;span style="font-family: 'Arial Narrow'; font-size: 11pt;"&gt;the annual period ending December 31, 2026.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
  <ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock id="HH26F298D96F05ADD051F0C74B218AC0A3" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock>
  <ferc:DisclosureOfSignificantContingentAssetsOrLiabilitiesTextBlock id="HHBF53398AA5137162F0C0A6B245F0BF61" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfSignificantContingentAssetsOrLiabilitiesTextBlock>
  <ferc:DisclosureOfSignificantIncreasesInServicesRenderedOrExpensesIncurredTextBlock id="HH7FCC34467929435B84A07016BEF0A1B8" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfSignificantIncreasesInServicesRenderedOrExpensesIncurredTextBlock>
  <ferc:DisclosureOfExtraordinaryIncomeOrExtraordinaryDeductionAmountsTextBlock id="HHE4CEA624F811CC9AADD2BDF89F8D6E56" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfExtraordinaryIncomeOrExtraordinaryDeductionAmountsTextBlock>
  <ferc:DisclosureOfReferencesToFinancialStatementNotesTextBlock id="HHBB3BC4E20287A67645AF2AEB0A930AD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfReferencesToFinancialStatementNotesTextBlock>
  <ferc:DisclosureOfDescriptionsOfAnnualStatementsSuppliedToAssociateServiceCompaniesTextBlock id="HHB04E0E632A1886FE121A35A6149C3C61" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfDescriptionsOfAnnualStatementsSuppliedToAssociateServiceCompaniesTextBlock>
  <ferc:MethodsOfAllocationTextBlock id="HHEBAE58B9382FD4FDF8A17E18EB315BD2" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;img src="data:image/jpeg;base64," width="624" height="485" alt="" style="-aw-left-pos:0pt; -aw-rel-hpos:column; -aw-rel-vpos:paragraph; -aw-top-pos:0pt; -aw-wrap-type:inline" /&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;*&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Supports construction efforts by providing estimating, scheduling and cost engineering services&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;**&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Develops reporting and procedures to support Construction, Asset Management and other departments and includes the project accounting function&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The following are overhead allocations:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Management&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;A ratio to allocate certain management-related, operation and maintenance expenses to the appropriate work orders and jurisdiction.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;The numerator is the operation and maintenance-related labor and related expenses for employees ranging from Director up to Chief Executive Officer, including their respective support staff, and excludes incentives (which is captured in the Incentives Loader).&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;The denominator is the sum of all internal labor and benefits.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Organizational Support&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;A ratio to allocate general support, operation and maintenance expenses to the appropriate work orders and jurisdiction.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;The numerator is the operation and maintenance-related costs of specific service departments that provide &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;general&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; support to the organization.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;The denominator is the sum of all internal labor and benefits.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Incentives&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;A ratio to allocate all incentive program costs to the appropriate work orders and jurisdiction.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;The numerator is the sum of all costs associated with the incentive program and includes short-term incentives, long-term incentives and deferred compensation.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;The denominator is the sum of all internal labor and benefits.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Incentives are allocated as shown above for each function.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:MethodsOfAllocationTextBlock>
  <ferc:DisclosureOfServiceDepartmentOrFunctionAndBasisForAllocationUsedTextBlock id="HH461118930D27C3A1B129009AD0909A3F" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfServiceDepartmentOrFunctionAndBasisForAllocationUsedTextBlock>
