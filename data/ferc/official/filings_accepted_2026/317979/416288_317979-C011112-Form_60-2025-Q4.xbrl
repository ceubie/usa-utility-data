  <ferc:MiscellaneousPaidInCapital id="HH685CB6F05C6405DB59C9F8C58F8E979F" contextRef="HHF7CE68E257CA8D85E9415386900D34E3" decimals="0" unitRef="HHferc_us_Currency">164345</ferc:MiscellaneousPaidInCapital>
  <ferc:OtherAccountsReceivable id="HH8AB13DD04B5C0D378B176C3BFF39EFFC" contextRef="HHF7CE68E257CA8D85E9415386900D34E3" decimals="0" unitRef="HHferc_us_Currency">109922</ferc:OtherAccountsReceivable>
  <ferc:Prepayments id="HH43506A18E638988DBAC002D4799F1D1C" contextRef="HHF7CE68E257CA8D85E9415386900D34E3" decimals="0" unitRef="HHferc_us_Currency">732861</ferc:Prepayments>
  <ferc:ProprietaryCapital id="HHAD1B136BF0693F9726A5AA3F4CF20FDC" contextRef="HHF7CE68E257CA8D85E9415386900D34E3" decimals="0" unitRef="HHferc_us_Currency">771865</ferc:ProprietaryCapital>
  <ferc:UnappropriatedRetainedEarnings id="HH602F104F77983FDC3EDB330282E4907F" contextRef="HHF7CE68E257CA8D85E9415386900D34E3" decimals="0" unitRef="HHferc_us_Currency">607355</ferc:UnappropriatedRetainedEarnings>
  <ferc:AccountsPayableToAssociateCompanies id="HHAEAE89D1A9706BA47C296BAA3734223B" contextRef="HHF7CE68E257CA8D85E9415386900D34E3" decimals="0" unitRef="HHferc_us_Currency">13685015</ferc:AccountsPayableToAssociateCompanies>
  <ferc:AccumulatedDeferredIncomeTaxesOther id="HH6D24415F5EF6211D28601438E8D1D426" contextRef="HHF7CE68E257CA8D85E9415386900D34E3" decimals="0" unitRef="HHferc_us_Currency">383239</ferc:AccumulatedDeferredIncomeTaxesOther>
  <ferc:AccumulatedProvisionForPensionsandBenefits id="HH5DE2830F2C3146564F852DC538C97DC3" contextRef="HHF7CE68E257CA8D85E9415386900D34E3" decimals="0" unitRef="HHferc_us_Currency">27738744</ferc:AccumulatedProvisionForPensionsandBenefits>
  <ferc:CurrentAndAccruedLiabilities id="HH4742F990109AF29444F1A4A75CD9D16F" contextRef="HHF7CE68E257CA8D85E9415386900D34E3" decimals="0" unitRef="HHferc_us_Currency">37389577</ferc:CurrentAndAccruedLiabilities>
