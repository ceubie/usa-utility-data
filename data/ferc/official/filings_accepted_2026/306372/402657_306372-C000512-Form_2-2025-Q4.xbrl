&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;1,370&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 0.98%; border-top-style: solid; border-top-width: 0.75pt; border-bottom-style: solid; border-bottom-width: 0.75pt; padding-top: 0.32pt; padding-right: 0.7pt; vertical-align: bottom; background-color: #ffffff;"&gt;
