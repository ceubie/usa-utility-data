			&lt;p style="margin-top:0pt; margin-bottom:0pt; page-break-inside:avoid; page-break-after:avoid; line-height:92%; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;9. Revenue&lt;/span&gt;&lt;br /&gt;&lt;span style="font-family:'Times New Roman'; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
