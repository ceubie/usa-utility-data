							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:8.44%; border-top-style:solid; border-top-width:0.75pt; border-bottom-style:double; border-bottom-width:2.25pt; padding-top:0.32pt; padding-right:0.7pt; vertical-align:bottom; background-color:#cff0fc"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:right; font-size:10pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'"&gt;3&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:1%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:bottom; background-color:#cff0fc"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
