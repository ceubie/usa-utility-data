							&lt;p style="margin-top:1.65pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:115%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial"&gt;Cash Paid For:&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
