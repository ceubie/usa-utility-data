  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH6421358480E1856CEC4C6EDE9FDDC4A6" xlink:label="HH6421358480E1856CEC4C6EDE9FDDC4A6" />
    <link:footnote xlink:type="resource" xlink:label="HH7D4CFB0A854F048DDED8DB5E3C666AEE" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <p style="color: rgba(0, 0, 0, 1); font-family: sans-serif; font-size: medium; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal;">
            <strong>
              <em>
                <span style="font-family: Arial, Helvetica, sans-serif;">
                  <span style="font-size: 12pt;">Schedule Page: 278 Line No.: 2 Column: a</span>
                </span>
              </em>
            </strong>
          </p>
          <p>
            <span style="font-size: 12pt;">
              <span style="font-family: Arial, Helvetica, sans-serif;">Pursuant to Section 22 of the General Terms and Conditions of MRT's FERC Gas Tariff, Seventh Revised Volume No.1, <span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none;">Docket No. </span>RP26-23-000, as approved by FERC's order issued on October 20, 2025.</span>
            </span>
          </p>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6421358480E1856CEC4C6EDE9FDDC4A6" xlink:to="HH7D4CFB0A854F048DDED8DB5E3C666AEE" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHEE5EDB7B0A3A2332B615FF48E024F77C" xlink:label="HHEE5EDB7B0A3A2332B615FF48E024F77C" />
    <link:footnote xlink:type="resource" xlink:label="HHF73D2A580AA3D1A21E1E79DF55EAD9F2" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <p>
            <b>
              <em>
                <span style="font-family: Arial, Helvetica, sans-serif">
                  <span style="font-size: 12pt">Schedule Page: 278        Line No.: 1        Column: a</span>
                </span>
              </em>
            </b>
          </p>
          <p>
            <span style="font-family: Arial, Helvetica, sans-serif">
              <span style="font-size: 12pt">Pursuant to Section 34 of the General Terms and Conditions ("GT&amp;C") of MRT's FERC Gas Tariff, Seventh Revised Volume No.1, Docket No. RP26-124-000, MRT is required to credit to eligible firm </span>
            </span>
            <span style="font-size: 12pt; font-family: Arial, Helvetica, sans-serif; background-color: unset; text-align: inherit">customers penalty revenues collected during the Penalty Base Period. The annual base period runs August 1 through July 31. Under the </span>
            <span style="font-family: Arial, Helvetica, sans-serif">
              <span style="font-size: 12pt">terms of Section 34 of the GT&amp;C, MRT is not required to calculate revenue credits until the Total Penalty Crediting Revenues exceed </span>
            </span>
            <span style="font-family: Arial, Helvetica, sans-serif">
              <span style="font-size: 12pt">$250,000.</span>
            </span>
          </p>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHEE5EDB7B0A3A2332B615FF48E024F77C" xlink:to="HHF73D2A580AA3D1A21E1E79DF55EAD9F2" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH25ACCF72A3E616B88FCB9F0E77ECBE95" xlink:label="HH25ACCF72A3E616B88FCB9F0E77ECBE95" />
    <link:footnote xlink:type="resource" xlink:label="HH7A716A629045FE872A188FDBC4C10166" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong style="font-family: Roboto;">
            <em>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">Schedule Page: 120 Line No.: 16.1 Column: b</span>
              </span>
            </em>
          </strong>
        </p>
        <p>
          <img src="data:image/jpeg;base64," alt="" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH25ACCF72A3E616B88FCB9F0E77ECBE95" xlink:to="HH7A716A629045FE872A188FDBC4C10166" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH3D8056EA8524A358C43B3E36BA2F7770" xlink:label="HH3D8056EA8524A358C43B3E36BA2F7770" />
    <link:footnote xlink:type="resource" xlink:label="HH14C301BFDC9A2F4FBB973C06894E9E38" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-weight: bold; font-family: sans-serif; font-size: medium; color: #000000;">
            <em>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">Schedule Page: 520 Line No.: 3 Column: c&#160;</span>
              </span>
            </em>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; font-size: medium; color: #333333; font-family: Roboto;">
          <span style="font-size: 12pt; color: #000000;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Gas purchase expense was booked to Natural gas transmission line purchases, Account 803.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH3D8056EA8524A358C43B3E36BA2F7770" xlink:to="HH14C301BFDC9A2F4FBB973C06894E9E38" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHC9D14499FF25BFBD60F04A9AFF1C6451" xlink:label="HHC9D14499FF25BFBD60F04A9AFF1C6451" />
    <link:footnote xlink:type="resource" xlink:label="HHCEF079715C8CCB8F473F1C12A9880762" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-weight: bold; font-family: sans-serif; font-size: medium;">
            <em>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">Schedule Page: 520 Line No.: 12 Column: d</span>
              </span>
            </em>
          </span>
        </p>
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">This represents gas withdrawn from storage to support system management activity.</span>
          <strong style="color: #000000; font-family: sans-serif; font-size: medium;">
            <em>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">
                  <span style="font-style: normal; font-weight: 400;">This footnote also applies to column (c).</span>
                </span>
              </span>
            </em>
          </strong>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC9D14499FF25BFBD60F04A9AFF1C6451" xlink:to="HHCEF079715C8CCB8F473F1C12A9880762" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHAC29FB8A5E084AD2DFDCEE928896308D" xlink:label="HHAC29FB8A5E084AD2DFDCEE928896308D" />
    <link:footnote xlink:type="resource" xlink:label="HHE3B22DB2127B390BAF56184FCE9A0851" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-weight: bold; font-family: sans-serif; font-size: medium;">
            <em>
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <span style="font-size: 12pt;">Schedule Page: 520 Line No.: 27 Column: d</span>
              </span>
            </em>
          </span>
        </p>
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">This represents gas delivered to storage to support system management activity.</span>
          <em style="color: #000000; font-family: sans-serif; font-size: medium; font-weight: bold;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt;">
                <span style="font-style: normal; font-weight: 400;">This footnote also applies to column (c).</span>
              </span>
            </span>
          </em>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAC29FB8A5E084AD2DFDCEE928896308D" xlink:to="HHE3B22DB2127B390BAF56184FCE9A0851" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE42A88354FE811940E49AF98CC4875FD" xlink:label="HHE42A88354FE811940E49AF98CC4875FD" />
    <link:footnote xlink:type="resource" xlink:label="HH48955C3DEDB8C60932D5233570BAC9A0" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-weight: bold; font-size: 16px; font-family: Arial, Helvetica, sans-serif;">
            <em>Schedule Page: 521 Line No.: 7 Column: f</em>
          </span>
        </p>
        <p style="margin: 0px; color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <em>
              <span style="font-weight: bold; font-style: normal; font-family: Arial, Helvetica, sans-serif;">
                <em>
                  <span style="font-size: 12pt; font-style: normal; font-weight: 400;">The basis for valuing the gas reported on columns (f), (g) and (h) is the weighted average rate for system gas.</span>
                </em>
              </span>
            </em>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE42A88354FE811940E49AF98CC4875FD" xlink:to="HH48955C3DEDB8C60932D5233570BAC9A0" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF954BDD3127828E1BCA0358719386A04" xlink:label="HHF954BDD3127828E1BCA0358719386A04" />
    <link:footnote xlink:type="resource" xlink:label="HH1CE9E8D168C61FEEC9FFA90EB243F4A3" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <em>
                <span style="font-weight: bold;">Schedule Page: 521 Line No.: 22 Column: i</span>
              </em>
            </span>
          </span>
        </p>
        <p style="margin: 0px; color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-weight: bold; font-size: 16px; font-family: Arial, Helvetica, sans-serif;">
            <em>
              <span style="font-style: normal;">
                <em>
                  <span style="font-size: 12pt; font-style: normal; font-weight: 400;">Gas used for other operational purposes includes blow-downs and other operational uses of gas other than compressor station fuel, and in-kind volumes of gas delivered to other pipelines in accordance with applicable transportation contracts. This footnote applies to all three months.</span>
                </em>
              </span>
            </em>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF954BDD3127828E1BCA0358719386A04" xlink:to="HH1CE9E8D168C61FEEC9FFA90EB243F4A3" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHFCA4E7E5B211D9E0D86BB5F0803D4287" xlink:label="HHFCA4E7E5B211D9E0D86BB5F0803D4287" />
    <link:footnote xlink:type="resource" xlink:label="HH995C7BD44F81801AF7C056B46DD6B3D3" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <em>
                <span style="font-weight: bold;">Schedule Page: 521 Line No.: 43.1 and 55.1 Column: i</span>
              </em>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-weight: bold; font-size: 16px; font-family: Arial, Helvetica, sans-serif;">
            <em>
              <span style="font-style: normal;">
                <em>
                  <span style="font-size: 12pt; font-style: normal; font-weight: 400;">Cumulative volumes of in-kind gas owed to or due from shippers are revalued to market price each month. The dollars reported on this page reflect the net valuation for the current month volumes and exclude the revaluation adjustment.</span>
                </em>
              </span>
            </em>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHFCA4E7E5B211D9E0D86BB5F0803D4287" xlink:to="HH995C7BD44F81801AF7C056B46DD6B3D3" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>