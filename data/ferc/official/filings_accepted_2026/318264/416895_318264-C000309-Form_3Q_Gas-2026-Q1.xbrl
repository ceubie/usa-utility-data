            <td style="width:0.1%"/>
            <td style="width:1.0%"/>
            <td style="width:23.900%"/>
            <td style="width:0.1%"/>
            <td style="width:1.0%"/>
            <td style="width:23.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="12" style="border-bottom:1pt solid #000;border-left:1pt solid #000;border-right:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:700;line-height:120%">Schedule Page: 309 Line No.: 11 Column: c</span>
            </td>
          </tr>
          <tr style="height:15pt">
            <td colspan="12" rowspan="2" style="border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:top">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">Rate schedule PAL is a balancing service; therefore, quantities are excluded as associated Dths used for balancing do not represent gas delivered.</span>
            </td>
          </tr>
          <tr style="height:15pt">
            <td colspan="12" style="display:none"/>
          </tr>
        </table>
