  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p class="MsoNormal" style="margin: 2.0pt 0in 1.0pt 0in;"&gt;&lt;strong&gt;&lt;span style="font-size: 10pt; font-family: Arial, sans-serif;"&gt;&amp;#160;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="margin-left: .5in; text-indent: -14.0pt; mso-list: l0 level1 lfo1;"&gt;&lt;!-- [if !supportLists]--&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial;"&gt;1.&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt;&amp;#160; &lt;/span&gt;&lt;/span&gt;&lt;!--[endif]--&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial;"&gt;None&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="margin-left: .5in; text-indent: -14.0pt; mso-list: l0 level1 lfo1;"&gt;&lt;!-- [if !supportLists]--&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial;"&gt;2.&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt;&amp;#160; &lt;/span&gt;&lt;/span&gt;&lt;!--[endif]--&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial;"&gt;None&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="margin-left: .5in; text-indent: -14.0pt; mso-list: l0 level1 lfo1;"&gt;&lt;!-- [if !supportLists]--&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial;"&gt;3.&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt;&amp;#160; &lt;/span&gt;&lt;/span&gt;&lt;!--[endif]--&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial;"&gt;None&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="margin-left: .5in; text-indent: -14.0pt; mso-list: l0 level1 lfo1;"&gt;&lt;!-- [if !supportLists]--&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial;"&gt;4.&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt;&amp;#160; &lt;/span&gt;&lt;/span&gt;&lt;!--[endif]--&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial;"&gt;None&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-indent: -14.0pt; mso-list: l0 level1 lfo1; margin: 0in 0in 12.0pt .5in;"&gt;&lt;!-- [if !supportLists]--&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial;"&gt;5.&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt;&amp;#160; &lt;/span&gt;&lt;/span&gt;&lt;!--[endif]--&gt;&lt;span style="font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial;"&gt;None&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;NOTE A &amp;#x2013; &lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;ORGANIZATION, OPERATIONS, AND BASIS OF PRESENTATION&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Organization.&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Energy Transfer GC NGL Pipelines LP (the "Partnership") is a Delaware limited partnership.&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;The Partnership's general partner is Energy Transfer GC NGL Assets GP LLC ("General Partner"). Energy&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Transfer GC NGLs LLC, through its wholly owned subsidiaries, owns a 100% membership interest in the General Partner and &lt;/span&gt;&lt;span style="font-family:Arial"&gt;all&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;of&lt;/span&gt;&lt;span style="font-family:Arial"&gt; the limited partner interests in the Partnership. Energy Transfer GC NGLs LLC is a&lt;/span&gt;&lt;span style="font-family:Arial"&gt;n indirect &lt;/span&gt;&lt;span style="font-family:Arial"&gt;wholly owned subsidiary of Energy Transfer LP.&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; line-height:10.5pt; background-color:#ffffff"&gt;&#xD;
				&lt;span style="font-family:Arial; font-size:10pt; font-weight:bold"&gt;Operations. &lt;/span&gt;&lt;span style="font-family:Arial; font-size:10pt"&gt;The Partnership&lt;/span&gt;&lt;span style="font-family:Arial; font-size:10pt"&gt; &lt;/span&gt;&lt;span style="font-family:Arial; font-size:10pt"&gt;owns and operates an interstate &lt;/span&gt;&lt;span style="font-family:Arial; font-size:10pt"&gt;natural gas liquids (&amp;#x201C;&lt;/span&gt;&lt;span style="font-family:Arial; font-size:10pt"&gt;NGL&lt;/span&gt;&lt;span style="font-family:Arial; font-size:10pt"&gt;&amp;#x201D;)&lt;/span&gt;&lt;span style="font-family:Arial; font-size:10pt"&gt; pipeline system that delivers mixed NGLs from processing plants in the Permian Basin, the Barnett Shale and East Texas to the Mont Belvieu NGL storage and fractionation facilities.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Regulation.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;The Partnership's refined products transportation activities are subject to regulation by the Federal Energy Regulatory Commission ("FERC") and various&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;state authorities. Regulatory bodies exercise statutory authority over matters such as rates, underlying accounting practices, and rate-making agreements with customers&lt;/span&gt;&lt;span style="font-family:Arial"&gt;.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:22.5pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold; letter-spacing:-0.1pt"&gt;Basis of Presentation&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold; letter-spacing:-0.1pt"&gt;. &lt;/span&gt;&lt;span style="font-family:Arial"&gt;The Partnership&amp;#x2019;s financial statements have been prepared in accordance with accounting requirements of the FERC, as set forth in the applicable Uniform System of Accounts and published accounting releases, which constitute a comprehensive basis of accounting other than accounting principles generally accepted in the United States of America (&amp;#x201C;GAAP&amp;#x201D;). The most significant differences between GAAP and the financial statements presented herein are:(&lt;/span&gt;&lt;span style="font-family:Arial"&gt;1&lt;/span&gt;&lt;span style="font-family:Arial"&gt;) classification of certain accounts on the balance sheet, statement of income and &lt;/span&gt;&lt;span style="font-family:Arial"&gt;the&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;statement&lt;/span&gt;&lt;span style="font-family:Arial"&gt; of cash flows and (&lt;/span&gt;&lt;span style="font-family:Arial"&gt;2&lt;/span&gt;&lt;span style="font-family:Arial"&gt;) use of FERC approved depreciation rates.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; widows:0; orphans:0; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;These interim financial statements should be read in conjunction with the financial statements and notes thereto contained in the &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Partnership&amp;#x2019;s&lt;/span&gt;&lt;span style="font-family:Arial"&gt; FERC Form 6 for the year ended December 31, 20&lt;/span&gt;&lt;span style="font-family:Arial"&gt;2&lt;/span&gt;&lt;span style="font-family:Arial"&gt;5&lt;/span&gt;&lt;span style="font-family:Arial"&gt;. The financial statements are unaudited, but in the opinion of management, all adjustments have been made that are necessary to fairly state the financial position, results of operations and cash flows for the periods presented. Certain information and notes that would substantially duplicate the disclosures contained in the most recent FERC Form 6 have been omitted.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;NOTE &lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;B&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt; &amp;#x2013; &lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;SUPPLEMENTAL CASH FLOW INFORMATION&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;Accrued capital expenditures as of &lt;/span&gt;&lt;span style="font-family:Arial"&gt;June&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;3&lt;/span&gt;&lt;span style="font-family:Arial"&gt;0&lt;/span&gt;&lt;span style="font-family:Arial"&gt;, &lt;/span&gt;&lt;span style="font-family:Arial"&gt;202&lt;/span&gt;&lt;span style="font-family:Arial"&gt;6&lt;/span&gt;&lt;span style="font-family:Arial"&gt; and 202&lt;/span&gt;&lt;span style="font-family:Arial"&gt;5&lt;/span&gt;&lt;span style="font-family:Arial"&gt; were $&lt;/span&gt;&lt;span style="font-family:Arial"&gt;1&lt;/span&gt;&lt;span style="font-family:Arial"&gt;8.8&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Arial"&gt;1&lt;/span&gt;&lt;span style="font-family:Arial"&gt;0.4&lt;/span&gt;&lt;span style="font-family:Arial"&gt; million, respectively.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;Non cash&lt;/span&gt;&lt;span style="font-family:Arial"&gt; &lt;/span&gt;&lt;span style="font-family:Arial"&gt;settlement of affiliates transactions as of June 30, &lt;/span&gt;&lt;span style="font-family:Arial"&gt;2026&lt;/span&gt;&lt;span style="font-family:Arial"&gt; and 2025 were $683.5 million and nil, respectively. &lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
