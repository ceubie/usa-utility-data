  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH6D09B49321ED2F9175728B9D8D482ABE" xlink:label="HH6D09B49321ED2F9175728B9D8D482ABE" />
    <link:footnote xlink:type="resource" xlink:label="HHF97A33A552BB7318C642B1A587F510F2" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto;">
            <span style="font-size: 12pt;">
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <strong style="font-weight: bold;">Schedule Page: 118 Line No.: 1 Column: c</strong>
              </span>
            </span>
          </p>
          <p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt;">Transwestern Pipeline Company, LLC, as a limited liability company, records member's equity in Other Paid-In Capital.</span>
            </span>
          </p>
          <p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto;">&#160;</p>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6D09B49321ED2F9175728B9D8D482ABE" xlink:to="HHF97A33A552BB7318C642B1A587F510F2" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHC1D1C929DF6233ED19D321AB06344E63" xlink:label="HHC1D1C929DF6233ED19D321AB06344E63" />
    <link:footnote xlink:type="resource" xlink:label="HHF496F2C33246DA16E8D75AE6C184FAF8" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-weight: bold;">
            <span style="font-size: 12pt;">
              <span style="font-family: Arial, Helvetica, sans-serif;">Schedule Page: 278 Line No.: 1 Column: a</span>
            </span>
          </span>
        </p>
        <div>
          <p>
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt;">
                <span style="color: #000000;">Pursuant to Article VIII, Section 1 of the Stipulation and Agreement of Settlement in Docket No. RP22-1031, as approved by FERC's order issued on June 30, 2023.</span>
              </span>
            </span>
          </p>
          <p>&#160;</p>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC1D1C929DF6233ED19D321AB06344E63" xlink:to="HHF496F2C33246DA16E8D75AE6C184FAF8" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH2A6D94AD2CB2990D22D6AEB2FF83CA5C" xlink:label="HH2A6D94AD2CB2990D22D6AEB2FF83CA5C" />
    <link:footnote xlink:type="resource" xlink:label="HHFF7088595FBD82E991B3637C3795A672" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-size: 12pt; color: #000000;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-weight: bold;">Schedule Page: 278 Line No.: 2 Column: a</span>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px;">
          <span style="color: #000000;">
            <span style="font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Pursuant to Section 22.4 of the General Terms and Conditions of Transwestern's FERC Gas Tariff, Fifth Revised Volume No. 1, Docket No. RP26-368-000 filed on January 9, 2026.</span>
            <span style="font-family: Arial, Helvetica, sans-serif; font-size: 16px;">&#160;&#160;</span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px;">
          <span style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">The current annual penalty period is October 1, 2025 through September 30, 2026.</span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH2A6D94AD2CB2990D22D6AEB2FF83CA5C" xlink:to="HHFF7088595FBD82E991B3637C3795A672" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF88E9F113753B710430C88D7269C0F0A" xlink:label="HHF88E9F113753B710430C88D7269C0F0A" />
    <link:footnote xlink:type="resource" xlink:label="HHC72DC7940083AA9187A1C47398C60952" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <img title="TW CF5.1.gif" src="data:image/gif;base64," alt="" width="499" height="175" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF88E9F113753B710430C88D7269C0F0A" xlink:to="HHC72DC7940083AA9187A1C47398C60952" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF13DF34D185E5A1092215D7883B73216" xlink:label="HHF13DF34D185E5A1092215D7883B73216" />
    <link:footnote xlink:type="resource" xlink:label="HH0D2F4553079CB122D4A37545A49C836F" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <img title="TW CF16.1.gif" src="data:image/gif;base64," alt="" width="503" height="258" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF13DF34D185E5A1092215D7883B73216" xlink:to="HH0D2F4553079CB122D4A37545A49C836F" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:label="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" />
    <link:footnote xlink:type="resource" xlink:label="HH83525382D6FAF11D56FDFB3F92E2B592" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">
              <span style="text-decoration: inherit;">
                <span style="font-weight: bold;">Schedule Page: 521 Line No.: 7 Column: e</span>
              </span>
            </span>
          </span>
        </p>
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">The allocation is derived by determining whether the reservation rate charged within the billing system is discounted, negotiated or recourse. This determination is applied to the retained fuel charged per contract scheduled path, and a pro rata allocation is derived and applied to all volumes and dollars.</span>
          </span>
        </p>
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span>
          </span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:to="HH83525382D6FAF11D56FDFB3F92E2B592" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE42A88354FE811940E49AF98CC4875FD" xlink:label="HHE42A88354FE811940E49AF98CC4875FD" />
    <link:footnote xlink:type="resource" xlink:label="HH359C8A7DD4FFB1EB75BFA1304D1221EF" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif; color: #000000;">
            <span style="font-size: 12pt;">
              <span style="font-weight: bold;">Schedule Page: 521 Line No.: 7 Column: f</span>
            </span>
          </span>
        </p>
        <p>
          <span style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">The basis for valuing the gas reported in columns (f), (g) and (h) is the Gas Daily monthly average index for San Juan Bondad, San Juan Non-Bondad and Transwestern Permian.</span>
        </p>
        <p>
          <span style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">Negative rates caused by imbalance. This footnote applies for Month 1 and 2.&#160;</span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE42A88354FE811940E49AF98CC4875FD" xlink:to="HH359C8A7DD4FFB1EB75BFA1304D1221EF" order="1" />
