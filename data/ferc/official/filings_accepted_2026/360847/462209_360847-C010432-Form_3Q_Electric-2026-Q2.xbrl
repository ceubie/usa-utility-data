  <ferc:OrderNumber id="HH4186A343BB76DE72A77E89904E2B99C1" contextRef="HHC7B22436537E14E8B0B3B50E62FBDD9A" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH1669B6DFDCCCB76920DB02CC4C26A2EB" xlink:label="HH1669B6DFDCCCB76920DB02CC4C26A2EB" />
    <link:footnote xlink:type="resource" xlink:label="HHC121DA160D039420DE04D7917440B063" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">Southwest Water Authority is a member of McKenzie Electric Cooperative, Inc. and purchases electric service and wheeling services.&#160;&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH1669B6DFDCCCB76920DB02CC4C26A2EB" xlink:to="HHC121DA160D039420DE04D7917440B063" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH8570FB774FA7592684DFFC5823F5C3BC" xlink:label="HH8570FB774FA7592684DFFC5823F5C3BC" />
    <link:footnote xlink:type="resource" xlink:label="HH99FD394779E370A6CE0D52BF30860341" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">Western Area Power Administration is a power marketing administration within the U.S. Department of Energy whose role is to market and transmit electricity from multi-use water projects to preference customers.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH8570FB774FA7592684DFFC5823F5C3BC" xlink:to="HH99FD394779E370A6CE0D52BF30860341" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH3EEE17B8BAA2F9E7009D7718BC27641E" xlink:label="HH3EEE17B8BAA2F9E7009D7718BC27641E" />
    <link:footnote xlink:type="resource" xlink:label="HH804E3D9813D8403DDE1A2730423FF4BA" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-size: 11.0pt; line-height: 107%; font-family: 'Calibri',sans-serif; mso-ascii-theme-font: minor-latin; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-hansi-theme-font: minor-latin; mso-bidi-font-family: 'Times New Roman'; mso-bidi-theme-font: minor-bidi; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">Southwest Water Authority is a preference customer of WAPA and received an allocation of power for one of their water pumping stations in McKenzie Electric Cooperative, Inc.&#8217;s service area.&#160;</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH3EEE17B8BAA2F9E7009D7718BC27641E" xlink:to="HH804E3D9813D8403DDE1A2730423FF4BA" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH06F8681DCAC5BE6B94267823239E15A4" xlink:label="HH06F8681DCAC5BE6B94267823239E15A4" />
    <link:footnote xlink:type="resource" xlink:label="HH6126EC2764AA021DB1E477FD06DC7BCD" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">MegaWatt Hours Received and MegaWatt Hours Delivered will equal as represented by the actual delivery.&#160; However, due to timing issues, the meter reading used to bill Southwest Water their wheeling charges is an additional meter used to read and bill usage prior to receipt of Western Area Power Administration transmission delivery invoice of actual MegaWatt hours delivered.&#160; The wheeling MegaWatt Hours and charges are trued-up annually (in the following period) based on actual receipt and delivery of MegaWatt Hours.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH06F8681DCAC5BE6B94267823239E15A4" xlink:to="HH6126EC2764AA021DB1E477FD06DC7BCD" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH1C647D7EA4117A2D8F3114BAD9C1E257" xlink:label="HH1C647D7EA4117A2D8F3114BAD9C1E257" />
    <link:footnote xlink:type="resource" xlink:label="HH1EF26E2D89809F5D8001D7F2896EDA9D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">Other Charges represents a monthly facility charge.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH1C647D7EA4117A2D8F3114BAD9C1E257" xlink:to="HH1EF26E2D89809F5D8001D7F2896EDA9D" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>