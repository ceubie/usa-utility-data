          <tr>
            <td colspan="3" style="display:none"/>
          </tr>
          <tr>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Guardian Pipeline has 100% of its inventory on a current basis. The fixed asset method is used for the valuation change for linepack.</span>
            </td>
          </tr>
        </table>
      </div>
    </link:footnote>
