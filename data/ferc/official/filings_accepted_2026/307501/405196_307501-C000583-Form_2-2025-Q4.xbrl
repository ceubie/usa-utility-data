    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Guardian Pipeline Company's System Map may be viewed and downloaded on its electronic bulletin board web site, http://dtmidstream.trellisenergy.com/ptms/home/infopost/GPL, by selecting "Informational Postings" then "Maps".</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">DT Midstream, Inc., through its 100% ownership of DTM Pipeline Company, owns 100% of DTM Interstate Transportation, LLC, which owns 100% of Guardian Pipeline, LLC.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-3" id="fn-3" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <span xmlns="http://www.w3.org/1999/xhtml" style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Type of Securities Issued: Membership Units - See Page 102 "Control Over Respondent" for a description of our ownership structure.</span>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-4" id="fn-4" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
