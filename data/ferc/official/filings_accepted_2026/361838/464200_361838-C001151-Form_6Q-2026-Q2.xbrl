  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH6417C43ECC35E1C706886AA6C8970BAA" xlink:label="HH6417C43ECC35E1C706886AA6C8970BAA" />
    <link:footnote xlink:type="resource" xlink:label="HH4EFEED6BFE44FA2C96788F11710CED21" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Rental income was overstated in prior periods due to duplicate recognition under both operating lease and sales-type (financing) lease accounting. The lease is appropriately accounted for as a sales-type (financing) lease. The amounts are non-jurisdictional and immaterial. The error has been corrected prospectively effective January 1, 2026.</span>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6417C43ECC35E1C706886AA6C8970BAA" xlink:to="HH4EFEED6BFE44FA2C96788F11710CED21" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>