&lt;p style="margin-top: 3.75pt; margin-bottom: 1.5pt; text-align: right; font-size: 9pt;"&gt;&lt;span style="width: 58.25pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 58.25pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri;"&gt;15.5&lt;/span&gt;&lt;span style="width: 2.64pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 76.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
