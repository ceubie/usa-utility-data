&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 79.5pt; border-top-style: solid; border-top-width: 1pt; border-bottom-style: solid; border-bottom-width: 1pt; padding-right: 0.75pt; vertical-align: middle; background-color: #cccccc;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri;"&gt;$&lt;/span&gt;&lt;span style="width: 58.29pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 62.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri;"&gt;0.1&lt;/span&gt;&lt;span style="width: 2.6pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 76.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
