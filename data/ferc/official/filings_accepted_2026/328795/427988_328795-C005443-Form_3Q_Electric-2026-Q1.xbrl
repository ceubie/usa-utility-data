  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock id="HHD2B1DFDF71C7477E84AEA1D4D780024C" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;1. None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock>
  <ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock id="HH9BC0EFBCB25FD35BD21CC5095A000F66" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;2. None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock>
  <ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock id="HHB507706EE223692FB3CE9DE4D62FC621" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;3. None&lt;/p&gt;
&lt;p&gt;&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock>
  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="HH1C967D5CB7055C23C61684D3A8ADDA65" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;4. We had a remeasurement of Renegade's lease liability and ROU asset due to the project achieving commercial operations. However due to the adjustment not being material, no footnote disclosure was required.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
  <ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock id="HH3753C2D0F64441EEC1CB77241E2239DC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;5. No changes this quarter.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock>
  <ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock id="HH2FB9527C1D4BB25D79F1C0C76F5BC95D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;6.&amp;#160;&amp;#160;At March 31, 2026, UMERC had $50.7 million of short term notes payable to WEC.&amp;#160;&lt;/p&gt;
&lt;p&gt;On August 28, 2019, UMERC issued $160.0 million principal amount of 3.26% senior notes due August 28, 2029. FERC authorization was issued on June 5, 2019 under an Order Authorizing Issuances of Securities in Docket ES19-23-000.&lt;/p&gt;
&lt;p&gt;On August 14, 2025, UMERC issued $80.0 million principal amount of 5.31% senior notes due August 14, 2030 and $40.0 million principal amount of 5.93% senior notes due August 14, 2035. FERC authorization was issued on July 18, 2025 under an Order Authorizing Issuances of Securities in Docket ES25-49-000.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock>
  <ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock id="HHDB4E63D65FD21AE5462A8FBA840EA717" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;7. There have been no changes to the Articles of Incorporation filed September 29, 2016.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock>
  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="HHEBA1CD44839C108D1DAFD6DE3427BE45" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;8. Not applicable.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock>
  <ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock id="HH22FBAEA0509E80B804A4341B1670898A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;9. See UMERC Condensed Notes to the Financial Statements, Note 9, Commitment and Contingencies.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock>
  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="HH582A4E700260C05D782FA2D6F218758A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;10. No material changes to report.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
  <ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock id="HHFB056E8F64ABA7B86B31B31B7725CE20" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;12. Not applicable.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;13. No material changes to report.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
