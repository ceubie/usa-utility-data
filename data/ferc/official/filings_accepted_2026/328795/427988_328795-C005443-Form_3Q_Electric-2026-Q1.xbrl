&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;$&lt;/span&gt;&lt;span style="width: 58.04pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 62.6pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;0.2&lt;/span&gt;&lt;span style="width: 2.72pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 76.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
