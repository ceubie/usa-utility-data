  <ferc:OrderNumber id="HH7A595215F38F9892684CA105AFCC9B45" contextRef="HH05AB82EACCF3F698BA4E3F8B05EBA5C7" decimals="0" unitRef="HHferc_us_Pure">3</ferc:OrderNumber>
  <ferc:OrderNumber id="HH6C2FE9C09E74710F771C45CBDE6CD04C" contextRef="HH089001CAAC52AA003521D0AF5DD63BA3" decimals="0" unitRef="HHferc_us_Pure">4</ferc:OrderNumber>
  <ferc:OrderNumber id="HHAF6AD513F060A2CA3736D36B52CF9798" contextRef="HH6F64FBEEDF7DAE0413A90CA4697815B1" decimals="0" unitRef="HHferc_us_Pure">5</ferc:OrderNumber>
  <ferc:OrderNumber id="HHF499CF420F9B304004A2014FD3E53D5D" contextRef="HHB56E9B87541394EB04B3C49C45939D0D" decimals="0" unitRef="HHferc_us_Pure">6</ferc:OrderNumber>
  <ferc:OrderNumber id="HHB97817057E56DAA89710A0226453F9ED" contextRef="HHE1D1FF0B6BA2EA7D3544D8B5FD1C7CE8" decimals="0" unitRef="HHferc_us_Pure">7</ferc:OrderNumber>
  <ferc:OrderNumber id="HHDC04D5F3545443659DAE949CC51DAC21" contextRef="HH13BA6D365E87629884E8906AC5C304DD" decimals="0" unitRef="HHferc_us_Pure">2</ferc:OrderNumber>
  <ferc:OrderNumber id="HH691B3B5F55A24EB4A4D333DBFE15F532" contextRef="HH38A895F632FDC533D531F7F4AAFF5C17" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH6E24C5DA2876AFDA84469FF01AB724F5" xlink:label="HH6E24C5DA2876AFDA84469FF01AB724F5" />
    <link:footnote xlink:type="resource" xlink:label="HH61C7B9B9B60B6691A288B95A7EC0DD48" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <p>
            <span style="font-size: 12pt;">
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <strong>Schedule Page: 232 Line No.: 1 Column: a</strong>
              </span>
            </span>
          </p>
          <p>
            <span style="font-size: 12pt;">
              <span style="font-family: Arial, Helvetica, sans-serif;">As authorized by the Commission, EGT has a fuel tracker mechanism whereby it recovers gas used and lost on its system via in-kind receipts of volumes from its shippers. The fuel tracker mechanism for EGT has a true-up provision that any over/under recoveries of volumes are returned to or collected from shippers through prospective semi-annual adjustment to fuel tracker retention rates. A regulatory asset or regulatory liability is established for the volumes collected and the volumes actually used/lost on the system. The over/under recovered volumes are valued at market prices in effect at the time the net over/under recoveries were recognized in the regulatory asset or regulatory liability accounts.</span>
            </span>
          </p>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6E24C5DA2876AFDA84469FF01AB724F5" xlink:to="HH61C7B9B9B60B6691A288B95A7EC0DD48" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH3B36AE4E107A804395913BC636953E78" xlink:label="HH3B36AE4E107A804395913BC636953E78" />
    <link:footnote xlink:type="resource" xlink:label="HHF5F6C7285846F97E87F6B49DFC53614D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <img title="Screenshot 2026-05-20 085815.jpg" src="data:image/jpeg;base64," alt="" width="452" height="146" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH3B36AE4E107A804395913BC636953E78" xlink:to="HHF5F6C7285846F97E87F6B49DFC53614D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHC2F436EABA5BEF975984DC7EE7AC93DC" xlink:label="HHC2F436EABA5BEF975984DC7EE7AC93DC" />
    <link:footnote xlink:type="resource" xlink:label="HH314097AD48575519745CC3C4DBAFF599" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <img title="Screenshot 2026-05-20 090526.jpg" src="data:image/jpeg;base64," alt="" width="452" height="185" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC2F436EABA5BEF975984DC7EE7AC93DC" xlink:to="HH314097AD48575519745CC3C4DBAFF599" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF58E69F589153B7D3618F8FFE30CA7EF" xlink:label="HHF58E69F589153B7D3618F8FFE30CA7EF" />
    <link:footnote xlink:type="resource" xlink:label="HH5A5E522D20C7EDADAAD91F3A3A74249D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="color: rgba(0, 0, 0, 1); text-decoration: inherit;">
                <strong>Schedule Page: 232 Line No.: 2 Column: a</strong>
              </span>
            </span>
          </span>
        </p>
        <p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">As authorized by the Commission, EGT collects from its shippers costs incurred for electric power costs associated with compressor stations on its system. The collection is via an Electric Power Cost ("EPC") surcharge billed to customers. The provisions of the EPC tracker contain a true-up provision such that any over/under collections are returned to or collected from shippers through prospective semi-annual adjustments to the EPC rates. A regulatory asset or regulatory liability is established for the difference between the actual EPC incurred and the amount collected via the EPC surcharge.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF58E69F589153B7D3618F8FFE30CA7EF" xlink:to="HH5A5E522D20C7EDADAAD91F3A3A74249D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7E00D728D3F661CB7AAC3739BE127B94" xlink:label="HH7E00D728D3F661CB7AAC3739BE127B94" />
    <link:footnote xlink:type="resource" xlink:label="HH7193528E3E5B043159F71D3FB2868353" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; color: #000000;">Schedule Page: 520 Line No.: 3 Columns: c and d</strong>
        </p>
        <p>
          <img title="Screenshot 2026-05-20 090833.jpg" src="data:image/jpeg;base64," alt="" width="565" height="105" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7E00D728D3F661CB7AAC3739BE127B94" xlink:to="HH7193528E3E5B043159F71D3FB2868353" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH04BBF61C687FCCEFD869F6D524CDFC10" xlink:label="HH04BBF61C687FCCEFD869F6D524CDFC10" />
    <link:footnote xlink:type="resource" xlink:label="HH263999D90F1F83C7F15025B730C40651" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 520 Line No.: 5 Columns: c and d</strong>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Includes quantities processed by others to attain pipeline quality specifications.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH04BBF61C687FCCEFD869F6D524CDFC10" xlink:to="HH263999D90F1F83C7F15025B730C40651" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHB4BCF47AD6B5D06E04DD19A2C4E9D4CB" xlink:label="HHB4BCF47AD6B5D06E04DD19A2C4E9D4CB" />
    <link:footnote xlink:type="resource" xlink:label="HH72BDE459E912DEC099D7D0CECD2CB9C2" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 520 Line No.: 12 Columns: c and d</strong>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Represents gas withdrawn from storage to support system management activity.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB4BCF47AD6B5D06E04DD19A2C4E9D4CB" xlink:to="HH72BDE459E912DEC099D7D0CECD2CB9C2" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHEA0371DB444E2CB2AADEA96BB3547CD0" xlink:label="HHEA0371DB444E2CB2AADEA96BB3547CD0" />
    <link:footnote xlink:type="resource" xlink:label="HHCD2A0A70D67E619A7D475376D646268D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 520 Line No.: 27 Columns: c and d</strong>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Represents gas delivered to storage to support system management activity.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHEA0371DB444E2CB2AADEA96BB3547CD0" xlink:to="HHCD2A0A70D67E619A7D475376D646268D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH3212AB67C727018E5E30D1C833082F7F" xlink:label="HH3212AB67C727018E5E30D1C833082F7F" />
    <link:footnote xlink:type="resource" xlink:label="HHEAE157F037D0C08F9F8CDAE73CE12B21" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong style="color: #000000; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Schedule Page: 520 Line No.: 29.1 Columns: c and d</strong>
        </p>
        <p>
          <img title="Screenshot 2026-05-20 090958.jpg" src="data:image/jpeg;base64," alt="" width="507" height="147" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH3212AB67C727018E5E30D1C833082F7F" xlink:to="HHEAE157F037D0C08F9F8CDAE73CE12B21" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE42A88354FE811940E49AF98CC4875FD" xlink:label="HHE42A88354FE811940E49AF98CC4875FD" />
    <link:footnote xlink:type="resource" xlink:label="HHE43E3523DB7B82B1AB2BBA5B80A624B9" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 521 Line No.: 7 Column: f</strong>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">The basis for valuing the gas reported in columns (f), (g) and (h) is the weighted average rate for system gas.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE42A88354FE811940E49AF98CC4875FD" xlink:to="HHE43E3523DB7B82B1AB2BBA5B80A624B9" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF954BDD3127828E1BCA0358719386A04" xlink:label="HHF954BDD3127828E1BCA0358719386A04" />
    <link:footnote xlink:type="resource" xlink:label="HH6EEF17823742EC1EA834C1DE649A3084" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 521 Line No.: 22 Column: i</strong>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Gas used for other operational purposes includes fuel and shrinkage of gas processed by others, blow-downs and other operational uses of gas other than compressor station fuel, and in-kind volumes of gas delivered to other pipelines in accordance with applicable transportation contracts.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF954BDD3127828E1BCA0358719386A04" xlink:to="HH6EEF17823742EC1EA834C1DE649A3084" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>