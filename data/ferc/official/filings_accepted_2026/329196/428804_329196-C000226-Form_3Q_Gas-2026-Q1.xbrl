&lt;p style="margin-top: 0pt; margin-left: 3pt; margin-bottom: 0pt; text-indent: -3pt; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;$&lt;/font&gt;&lt;/p&gt;
