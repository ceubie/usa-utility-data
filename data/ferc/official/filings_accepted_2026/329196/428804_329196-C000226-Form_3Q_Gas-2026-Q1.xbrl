&lt;p style="margin-top: 0pt; margin-right: 6.05pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;413&lt;/font&gt;&lt;/p&gt;
