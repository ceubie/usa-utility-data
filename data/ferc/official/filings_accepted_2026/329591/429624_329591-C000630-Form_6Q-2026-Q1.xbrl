    <link:footnoteArc xlink:type="arc" xlink:from="value7" xlink:to="footnote7" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="7" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote8" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="text-align: justify;">
          <xhtml:span style="font-size: 18.0pt; line-height: 115%; font-family: 'Arial',sans-serif;">Pursuant to the Federal Energy Regulatory Commission's Order Denying Petition and Granting Remedies issued November 20, 2025, we have included in Page 300, in revenue account 210, the amount of $12,720,039 related to correcting invoices from March 1, 2022 to September 17, 2024.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
