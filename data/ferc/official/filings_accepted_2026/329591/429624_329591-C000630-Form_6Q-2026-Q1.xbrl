    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote4" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Cash and Cash equivalents consists of Cash (Account 10) of $2,553,126 and Temporary Investments (Account 11) of $38,356,290.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
