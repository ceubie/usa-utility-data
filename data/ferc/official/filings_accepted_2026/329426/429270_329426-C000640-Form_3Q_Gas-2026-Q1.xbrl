              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">343,032&#160;</span>
            </td>
            <td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:bottom"/>
