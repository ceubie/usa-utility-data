  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HHC9E9219375AC2F82A8CDFAF00D88FECC" xlink:label="HHC9E9219375AC2F82A8CDFAF00D88FECC" />
    <link:footnote xlink:type="resource" xlink:label="HH9ABF73664801B46B0DAE1091A2470749" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Effective January 1, 2026, Carleton Simpson was elected Senior Vice President and Secretary of Fitchburg.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC9E9219375AC2F82A8CDFAF00D88FECC" xlink:to="HH9ABF73664801B46B0DAE1091A2470749" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH22FBAEA0509E80B804A4341B1670898A" xlink:label="HH22FBAEA0509E80B804A4341B1670898A" />
    <link:footnote xlink:type="resource" xlink:label="HH9E14A6BAA0BA921615F4A71A33103664" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Please refer to the discussion of regulatory matters in Note 8 to the Consolidated Financial Statements of the 2025 Unitil Corporation Form 10-K and Note 7 to the Consolidated Financial Statements of the Unitil Corporation Form 10-Q for the period ended March 31, 2026, as filed with the Securities and Exchange Commission.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH22FBAEA0509E80B804A4341B1670898A" xlink:to="HH9E14A6BAA0BA921615F4A71A33103664" order="1" />
