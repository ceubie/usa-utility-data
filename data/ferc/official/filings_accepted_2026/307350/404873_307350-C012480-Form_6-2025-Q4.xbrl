  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:label="value2" xlink:href="#Tag53" />
    <link:loc xlink:type="locator" xlink:label="value3" xlink:href="#Tag71" />
    <link:loc xlink:type="locator" xlink:label="value14" xlink:href="#Tag98" />
    <link:loc xlink:type="locator" xlink:label="value15" xlink:href="#Tag118" />
    <link:loc xlink:type="locator" xlink:label="value6" xlink:href="#Tag144" />
    <link:loc xlink:type="locator" xlink:label="value11" xlink:href="#Tag151" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote2" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">All cash expenditures and receipts are managed by the parent company and accounted for within Miscellaneous Other Assets.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value2" xlink:to="footnote2" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="2" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote3" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Miscellaneous Other Assets is comprised of amounts receivable from affiliated companies associated with cash managements services.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value3" xlink:to="footnote3" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="3" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote6" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p style="language: en-US; line-height: normal; text-indent: 0in; direction: ltr; unicode-bidi: embed; mso-vertical-align-alt: auto; mso-line-break-override: none; word-break: normal; punctuation-wrap: hanging; margin: 0pt 0in 0pt 0in;">
          <xhtml:span style="font-size: 11pt; font-family: arial, helvetica, sans-serif; color: black; font-weight: normal; font-style: normal; vertical-align: baseline;">MDE Midstream, LLC has adopted the Association of Oil Pipelines Accounting Guideline 3-13, "Equity Reporting for Non-corporate Filers" (the "guideline").<xhtml:span style="mso-spacerun: yes;"></xhtml:span>The guideline suggests that any distributions in excess of the positive balance in unappropriated retained income should be recorded against additional paid-in capital.<xhtml:span style="mso-spacerun: yes;"></xhtml:span>Therefore, the unappropriated retained income balance of $(9,103,140) as of December 31, 2024 and current year net income of $(407,341) have been recorded against additional paid-in capital.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value6" xlink:to="footnote6" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="6" />
