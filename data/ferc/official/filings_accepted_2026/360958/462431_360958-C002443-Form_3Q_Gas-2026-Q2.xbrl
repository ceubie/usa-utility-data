          <tbody>
            <tr>
              <td style="width: 49.9315%;">Utility plan</td>
              <td style="width: 49.9315%; text-align: right;">$&#160; &#160; &#160; &#160; &#160; &#160; -</td>
            </tr>
            <tr>
              <td style="width: 49.9315%;">Regulatory commission expense (ACA)</td>
              <td style="width: 49.9315%; text-align: right;">
                <span style="text-decoration: underline;">&#160; 17,664</span>
              </td>
            </tr>
