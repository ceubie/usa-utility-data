          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Transferred to Account 211 "Miscellaneous Paid-in-Capital."</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value61" xlink:to="footnote61" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="61" />
