    <link:footnoteArc xlink:type="arc" xlink:from="value78" xlink:to="footnote78" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="78" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote84" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="text-align: justify;">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Rate for borrowed funds actually used during year is based upon the capital ratio of 45% long term debt multiplied by the 7% long term debt cost rate percentage in the original certificate in Docket No. CP08-6.</xhtml:span>
          <xhtml:u>
          </xhtml:u>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value84" xlink:to="footnote84" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="84" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote85" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="text-align: justify;">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Rate of other funds actually used during year is based upon the capital ratio of 55% common equity multiplied by the 13% common equity cost rate percentage in the original certificate in Docket No. CP08-6.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value85" xlink:to="footnote85" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="85" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote86" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p style="text-align: justify;">
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Receipt points Enable lease 44599 West Pool, 44601 Waynoka, 47607 Rose Valley and 44600 East Pool. Delivery point Enable lease 44438 Bennington, Oklahoma.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value86" xlink:to="footnote86" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="86" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote95" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Normal" style="text-align: justify;">
          <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level, rather than by service type (i.e., firm transport, interruptible transport, etc.) or by discounted, negotiated, or recourse rate contracts. Therefore, the amounts reported have been allocated to the service types and to discounted, negotiated or recourse rate contracts based on reasonable assumptions.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value95" xlink:to="footnote95" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="95" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote101" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="line-height: 108%; font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; line-height: normal; font-size: 18pt; text-align: justify;">
              <xhtml:span style="font-family: Arial;">Recorded pursuant to Section 36 of the General Terms and Conditions of our tariff. Remaining balance at end of current filing period will be refunded through adjustments to future period fuel retention rates.</xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value101" xlink:to="footnote101" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="101" />
