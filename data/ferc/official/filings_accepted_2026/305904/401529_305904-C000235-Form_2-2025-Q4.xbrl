    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote60" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: justify; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Use tax is distributed to various accounts based on the accounts charged for the originating invoice.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
