        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
          <xhtml:span style="font-size: 18pt; font-family: Arial, sans-serif;">The value of this gas is based on the current month cash out price provided for in our tariff. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value62" xlink:to="footnote62" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="62" />
