  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:label="value4" xlink:href="#Tag256" />
    <link:loc xlink:type="locator" xlink:label="value5" xlink:href="#Tag258" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote4" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="text-align: justify;">
          <xhtml:span style="font-size: 18.0pt; line-height: 115%; font-family: 'Arial',sans-serif;">Pursuant to the Federal Energy Regulatory Commission's Order Denying Petition and Granting Remedies issued November 20, 2025, we have included in Page 300, in revenue account 210, the amount of $2,900,204 related to correcting invoices from March 1, 2022 to September 17, 2024.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value4" xlink:to="footnote4" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="4" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote5" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 24px; text-align: justify;">Pursuant to the Federal Energy Regulatory Commission's Order Denying Petition and Granting Remedies issued November 20, 2025, we have included in Page 300, in revenue account 220, the amount of $284,987 related to correcting invoices from March 1, 2022 to September 17, 2024.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value5" xlink:to="footnote5" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="5" />
  </link:footnoteLink>
</xbrli:xbrl>
