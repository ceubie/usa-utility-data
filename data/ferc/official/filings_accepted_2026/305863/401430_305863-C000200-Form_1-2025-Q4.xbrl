  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <span xmlns="http://www.w3.org/1999/xhtml" style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Effective December 31, 2025, Nevin Boparai assumed the role of Secretary</span>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-top:1pt solid #000000;padding:2px 1pt;text-align:left;vertical-align:top">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">This note is applicable to pages 106 and 106(a). The approximately 20 miles of transmission facilities owned by the respondent are used as a "pass through" for the purpose of wheeling electricity to and from the electricity grid of its parent, ComEd. ComEd's transmission facilities and the respondent's transmission facilities are managed and operated as one integrated system under one transmission - pricing tariff. The transmission facilities of ComEd and the respondent are integrated into and controlled by PJM. ComEd and the respondent file an annual combined formula rate update.</span>
            </td>
          </tr>
        </table>
      </div>
    </link:footnote>
