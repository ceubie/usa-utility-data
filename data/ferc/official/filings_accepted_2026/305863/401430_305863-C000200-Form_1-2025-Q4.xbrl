          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-top:1pt solid #000000;padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Depreciation is computed monthly by using the monthly composite depreciation rate, times the average depreciable plant-in-service balances at the beginning and end of each month. The three amounts shown in column (b) are the annual average depreciable plant-in-service balances computed by dividing the sum of the monthly average plant-in-service balances for the year by twelve.</span>
            </td>
          </tr>
        </table>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-26" id="fn-26" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
