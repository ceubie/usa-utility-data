pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;341&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;(6)&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;39&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td colspan="3" style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:0 1pt"/&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;638&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;682&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;(13)&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0;text-align:right;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:9pt;font-weight:400;line-height:120%"&gt;78&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;The Company's contributions to the defined benefit plan for the six months ended June 30, 2026 and 2025 were $1.9 million. No additional employer contributions to the Versant Power plan are expected for the remainder of 2026. The Company&#8217;s contributions related to the defined contribution plan were $2.7 million and $2.3 million for the same periods.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:98.900%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-bottom:1pt solid #000;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#435369;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;7: Lending Agreements&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The Company remains in compliance with the terms of its debt agreements and had no material change in its borrowing arrangements during the period.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:98.900%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-bottom:1pt solid #000;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#435369;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;8. Commitments and Contingencies&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="margin-bottom:10pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The Company may be, from time to time, subject to various investigations, claims, and legal proceedings covering various matters that arise in the ordinary course of its business activities. Management believes that any liability that may ultimately arise from the resolution of these matters will not have a material adverse effect on the financial position or operating results of the Company.&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:10pt;text-align:justify"&gt;&lt;span style="color:#435369;font-family:'Calibri',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;FERC Transmission ROE Liability&lt;/span&gt;&lt;span style="color:#44546a;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt; &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;From 2011 to 2016, four separate complaints were filed with the Federal Energy Regulatory Commission challenging the base return on equity ("ROE") under the ISO-NE Open Access Transmission Tariff. These proceedings relate to transmission ROEs applicable to the New England Transmission Owners ("NETOs"), including the Company's Bangor Hydro District.&#160;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;On March 19, 2026, FERC issued an order addressing all four complaint proceedings. The order established a new base ROE of 9.57% effective October 16, 2014 and required refunds, plus interest, from the NETOs, and ISO-NE, for the difference between the previously collected ROE and the new ROE. Refunds apply to (i) the 15-month refund period for October 1, 2011 through December 31, 2012 and (ii) the period from October 16, 2014 to the date of the order.&#160;The order initially required refunds to be paid by April 19, 2026; however, FERC subsequently extended the deadline to May 20, 2027.&#160; Requests for rehearing and appeals of the order have been filed.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-bottom:10pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Based on currently available information, the Company recorded incremental estimated refunds of $32.1 million as a reduction to operating revenue and $18.4 million of related interest expense during the six months ended June 30, 2026, with a corresponding increase to a regulatory liability. Together with previously recorded accruals, these amounts represent the Company's total estimated obligation of $57.1 million related to the FERC transmission ROE proceedings as of June 30, 2026. &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:98.900%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-bottom:1pt solid #000;padding:1.5pt 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#435369;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;9: Subsequent Events&lt;/span&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Subsequent to June 30, 2026, the Company completed the issuance of an unsecured $120 million senior note, bearing interest at a rate of 6.15%, payable semi-annually, and maturing in 2056. The note is being funded in two tranches with $50 million received on July 15, 2026 and the remaining tranche of $70 million to be received on September 16, 2026. &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The Company has evaluated subsequent events occurring after June 30, 2026 through the date of issuance of these financial statements. Based on this evaluation, no subsequent events were identified that require recognition or disclosure in the accompanying financial statements.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfApplicableNotesTextBlock>
