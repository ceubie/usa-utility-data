    <link:footnote xlink:type="resource" xlink:label="fn-19" id="fn-19" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">Generator Interconnection Agreements and/or Facility Service Agreements between various parties</link:footnote>
