ont: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;On&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;April&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;30,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2021,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Morongo&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;filed&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;an&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;application&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;authorization&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;under&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Section&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;204&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Federal Power Act in Docket ES21-44-000 and requested the authorization to issue senior secured&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0.6pt 27.7pt 0 64.8pt; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;long-term&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;debt&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;amount&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;up&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$410&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;million&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Letter&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Credit&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;amount&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$17 million to acquire a leasehold interest from SCE in a portion of the Project.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 4.9pt 32.35pt 0 64.8pt; text-indent: -18.05pt; line-height: 97%; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Calibri; font-size: 11pt"&gt;-&lt;/span&gt;&lt;span style="width: 12.57pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;On&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;July&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;8,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2021,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;FERC&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;granted&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;authorizations&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;debt&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;issuance&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;amounting&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$408,346,350 and the Letter of Credit Facility issued to $15,509,029.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 5.15pt 20.05pt 0 64.8pt; text-indent: -18.05pt; line-height: 101%; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Calibri; font-size: 11pt"&gt;-&lt;/span&gt;&lt;span style="width: 12.57pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;On January 31, 2022, Morongo requested authorization to issue senior secured long-term debt securities,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;considered&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;be&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;private&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;placement,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;aggregate&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;principal&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;amount&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;not&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;exceed&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$181 million. The long-term debt securities, would be fully amortized by the maturity and within the&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.3pt; margin-left: 64.8pt; margin-bottom: 0; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;30-year&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;term&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Lease&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;would&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;not&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;increase&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;FERC-approved&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;TRR&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;indicating&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;that&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;new financing would not impair Morongo's ability to perform its public utility services.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 10pt; margin-left: 28.6pt; margin-bottom: 0; text-indent: -23.35pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;(15)&lt;/span&gt;&lt;span style="width: 5.57pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;Significant&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt; Contracts&lt;/span&gt; 			&lt;/h2&gt; 			&lt;h3 style="margin-top: 5.6pt; margin-left: 46.65pt; margin-bottom: 0; text-indent: -17.9pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-style: italic; letter-spacing: -0.05pt"&gt;(a)&lt;/span&gt;&lt;span style="width: 5.68pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-style: italic"&gt;Transfer&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;Capability&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;lease&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;with&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;SCE&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;and&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;CAISO&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;operational&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.1pt"&gt;control&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin: 5.45pt 18.7pt 0 46.8pt; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;SCE developed a transmission project known as the West of Devers Upgrade Project, which includes approximatively 48 corridor miles of new 220kV transmission lines. In 2012, the Morongo Band of Mission Indians consented to a right-of-way for SCE transmission facilities crossing the Reservation with a&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;condition to have&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Company enter into a&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Development&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and Coordination Agreement&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;pursuant to which SCE would develop, design, permit, engineer, procure, construct and own the transmission facilities and that the Company had an Option to lease a portion of the Transfer Capability (the maximum amount of power that can be transferred over part of the transmission facilities) in the transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;facilities.&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;On&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;July&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;12,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2021,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Morongo&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;exercised&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Option,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;paying&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;lease&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;up front&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;an amount of $400 million to SCE for the lease of a portion of the Transfer Capability in the transmission facilities for a 30-year term.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 10.45pt 18.7pt 0 46.8pt; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;SCE is responsible for overseeing and performing all operations and maintenance services for the transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;facilities.&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;SCE&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;is&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;solely&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;entitled&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;decide&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;upon&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;any&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;upgrades,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;replacement,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;renewals&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and any additional capital investment to all or any portion of the transmission facilities and will be solely responsible to pay the costs of such upgrades resulting in no increases in the Transfer Capability allocated&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Morongo.&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;These&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;upgrades&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;will&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;result&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;an&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;adjustment&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Morongo's&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;percentage&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;interest&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in the Transfer Capability, which is at 62.795% in 2025, 62.960% in 2024.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 10.2pt 19.9pt 0 46.8pt; text-align: justify; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;SCE&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and the&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Company share the benefits and the burdens of&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;transmission facilities. SCE&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;billed the Company&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;its&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;share&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;O&amp;amp;M&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;expenses&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;on&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;quarterly&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;basis,&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;based&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;on&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;O&amp;amp;M&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;amount&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;approved&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;by FERC and updated annually.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 0; margin-left: 46.7pt; margin-bottom: 0; text-indent: -17.95pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-style: italic; letter-spacing: -0.05pt"&gt;(b)&lt;/span&gt;&lt;span style="width: 5.18pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-style: italic"&gt;Participating&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;Transmission&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;Owner's&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;to&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;the&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.1pt"&gt;CAISO&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin: 5.55pt 19.4pt 0 46.8pt; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;The Company is a Participating Transmission Owner (&amp;quot;PTO&amp;quot;) of the California Independent System Operator (&amp;quot;CAISO&amp;quot;) and has placed under CAISO's operational control all of its interest in the leased portion&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;line&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;on&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;same&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;date&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Option&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;was&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;exercised.&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Morongo&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;recovers&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;its&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;costs from CAISO as a PTO. Specifically, based on Morongo's TRR, CAISO pays Morongo through the collection of monthly Transmission Access Charges (&amp;quot;TAC&amp;quot;) for transmission service provided to CAISO customers.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 10.2pt; margin-left: 28.6pt; margin-bottom: 0; text-indent: -23.35pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;(16)&lt;/span&gt;&lt;span style="width: 5.57pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;Subsequent&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Events&lt;/span&gt; 			&lt;/h2&gt; 			&lt;p style="margin: 5.55pt 18.7pt 0 28.75pt; line-height: 104%; font-size: 10pt"&gt; 				The&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;Company&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;has&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;evaluated&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;subsequent&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;events&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;from&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;the&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;statement&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;of&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;net&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;assets&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;date&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;through&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;May&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;26, 2026 the date at which the financial statements were available to be issued.&lt;br /&gt; 			&lt;/p&gt; 		&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
