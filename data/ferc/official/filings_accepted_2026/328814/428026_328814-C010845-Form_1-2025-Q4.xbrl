;/span&gt;&lt;span&gt;year&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;advance.&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;amount&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;expenses&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2026&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;is&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$12,057,545.&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The amounts for the remaining years have yet to be determined.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 10.05pt; margin-left: 46.65pt; margin-bottom: 0; text-indent: -17.9pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-style: italic; letter-spacing: -0.05pt"&gt;(c)&lt;/span&gt;&lt;span style="width: 5.68pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-style: italic"&gt;Credit&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.2pt"&gt; risk&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin: 5.55pt 18.7pt 0 46.8pt; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;The Company maintains its cash balances, which at times could be significant, with a US financial institution. Credit risk associated with restricted cash is mitigated as these assets are invested in a financial&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;institution&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;with&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;long-term&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;credit&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;rating&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;A-&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;as&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;per&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Standard&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;amp;&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Poor's&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;as&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;December&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31, &lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 10.15pt; margin-left: 46.7pt; margin-bottom: 0; text-indent: -17.95pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-style: italic; letter-spacing: -0.05pt"&gt;(d)&lt;/span&gt;&lt;span style="width: 5.18pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-style: italic"&gt;Concentration&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;of&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.1pt"&gt; business&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin: 5.55pt 23.8pt 0 46.8pt; text-align: left; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Company&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;conducts&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;business&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;with&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;two&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;parties:&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;CAISO,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;which&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;operates&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;wholesale&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;energy&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;market and&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;SCE&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;which&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;is&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;primarily&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;electricity&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;supply&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;company&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;much&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Southern&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;California&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;provide&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;100% of the Company's operation and maintenance expenses whilst owning the Project. This concentration of counterparties may impact the Company's overall exposure to credit risk in that its counterparties&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;may&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;be&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;similarly&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;affected&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;by&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;changes&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;in&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;economic,&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;regulatory,&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;or&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;other&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;conditions.&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;The Company,&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;through&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;the&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;CAISO,&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;has&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;exposure&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;to&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;trends&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;within&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;the&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;energy&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;industry&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;which&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;could&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt; background-color: unset; text-align: inherit"&gt;include declines in the creditworthiness of its customers.&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin: 10.25pt 27.7pt 0 46.8pt; line-height: 104%; font-size: 10pt; text-align: left"&gt; 				&lt;span&gt;Financial instruments, which potentially subject the Company to credit risk, consist primarily of restricted&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;cash&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;cash&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;equivalents&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;accounts&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;receivable.&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Company&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;maintains&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;cash&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;with major financial institutions.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 10.15pt; margin-left: 46.8pt; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;CAISO&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;accounts&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;100%&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Morongo's&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;revenues.&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Refer&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Note&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;13&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;more&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt; information.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 10.45pt; margin-left: 46.65pt; margin-bottom: 0; text-indent: -17.9pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-style: italic; letter-spacing: -0.05pt"&gt;(e)&lt;/span&gt;&lt;span style="width: 5.68pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-style: italic"&gt;Legal&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;and&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic"&gt;regulatory&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.2pt"&gt;risks&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin: 5.55pt 27.7pt 0 46.8pt; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;Legal&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;regulatory&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;changes&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;could&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;occur&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;during&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;duration&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Company&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;which&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;may&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;adversely affect the Company. Legal disputes, involving the Company, its members or its affiliates, may arise from the foregoing activities (or any other activities relating to the operations of the Company) and could have a significant adverse effect on the Company.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 10.1pt 18.7pt 0 46.8pt; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;The Company is subject to extensive governmental regulations and oversight with respect to its business activities. The failure to comply with applicable regulations, obtain applicable regulatory approvals, or maintain those approvals so obtained may subject the Company to civil penalties, suspension&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;or&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;withdrawal&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;any&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;regulatory&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;approval&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;obtained,&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;injunctions,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;operating&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;restrictions&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and criminal&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;prosecutions&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;penalties,&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;which&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;could,&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;individually&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;or&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;aggregate,&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;have&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;material&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;or adverse effect on the Company.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 10.3pt; margin-left: 28.6pt; margin-bottom: 0; text-indent: -23.35pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;(13)&lt;/span&gt;&lt;span style="width: 5.57pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;Related&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Party&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Transactions:&lt;/span&gt; 			&lt;/h2&gt; 			&lt;p style="margin: 5.5pt 18.7pt 0 28.75pt; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Manager&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;its&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;affiliate&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;provided&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;management&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;services&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Company&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;under&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;an&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Asset&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Management Assistance Agreement&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;until June 18,&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2024.&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;In&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2024,&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Manager and its affiliate&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;incurred $58,487 of&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;office and general expenses which were charged back to the Company. As of December 31, 2024, $0 are &lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;payable.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 10.15pt; margin-left: 28.75pt; margin-bottom: 0; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;For&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;year&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;ended&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;December&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2025&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;December&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2024,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Axium&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Coachella&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;incurred&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;franchise&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;tax expenses on behalf of Morongo totaling $15,190 and $12,890 respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 10.1pt 18.7pt 0 28.75pt; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;During 2025, the Band provided cash contributions of $3,883,216 to Morongo Transmission to support a shortfall in cash under-collections from CAISO related to its transmission revenue requirement. The transactions&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;highlight&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;financial&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;support&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;provided&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;by&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Band&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Morongo&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Transmission,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;LLC,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;reflecting the ongoing financial interactions between these related entities.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 10.15pt 18.15pt 0 28.75pt; line-height: 104%; font-size: 10pt"&gt; 				&lt;span&gt;In 2025 and 2024, Morongo Transmission, a wholly owned subsidiary of Morongo Transmission Holdings, LLC, transferred funds totaling $4,934,538 and $5,511,659 to its parent company. These transfers were made to support debt service obligations and other related charges. The transactions highlight the financial support&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;provided&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;by&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Morongo&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Morongo&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Holdings,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;LLC,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;reflecting&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;ongoing financial interactions between these related entities.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.95pt; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 0; margin-left: 28.6pt; margin-bottom: 0; text-indent: -23.35pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;(14)&lt;/span&gt;&lt;span style="width: 5.57pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;Regulatory&lt;/span&gt;&lt;span style="letter-spacing: -0.45pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Environment&lt;/span&gt; 			&lt;/h2&gt; 			&lt;h3 style="margin-top: 5.55pt; margin-left: 46.65pt; margin-bottom: 0; text-indent: -17.9pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-style: italic; letter-spacing: -0.05pt"&gt;(a)&lt;/span&gt;&lt;span style="width: 5.68pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-style: italic; letter-spacing: -0.1pt"&gt;Project&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin: 5pt 21.8pt 0 64.8pt; text-indent: -18.05pt; line-height: 101%; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Calibri; font-size: 11pt"&gt;-&lt;/span&gt;&lt;span style="width: 12.57pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;On&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;August&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;25,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2014,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;FERC&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;issued&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;declaratory&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;order&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;finding&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;that&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Morongo's&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;capital&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;cost&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;recovery methodology which included a hypothetical structure of 50% debt and 50% equity and a 30-year levelized capital recovery approach would produce just and reasonable results.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 5.1pt 25.3pt 0 64.8pt; text-indent: -18.05pt; line-height: 97%; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-family: Calibri; font-size: 11pt"&gt;-&lt;/span&gt