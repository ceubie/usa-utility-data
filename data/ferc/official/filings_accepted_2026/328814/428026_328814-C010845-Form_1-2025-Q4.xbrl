t"&gt; 							&lt;span style="width: 58.65pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: -0.5pt"&gt;--&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: 2pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 87.7pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0.45pt; margin-bottom: 0; text-align: right; font-size: 9.5pt"&gt; 							&lt;span style="width: 32.4pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: -0.1pt"&gt;178,000&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: 2pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 14.55pt"&gt; 					&lt;td style="width: 232.55pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 10pt"&gt; 							&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 164.7pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 3.6pt; margin-bottom: 0; text-align: right; line-height: 9.95pt"&gt; 							&lt;span style="font-size: 9.5pt"&gt;$ &lt;/span&gt;&lt;span style="width: 33.88pt; font-family: &amp;quot;Lucida Console&amp;quot;; font-size: 9.5pt; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9.5pt; text-decoration: underline; letter-spacing: -0.1pt"&gt;330,373&lt;/span&gt;&lt;span style="font-size: 9.5pt; text-decoration: underline; letter-spacing: 2pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 87.7pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 3.6pt; margin-bottom: 0; text-align: right; line-height: 9.95pt"&gt; 							&lt;span style="width: 23.7pt; font-family: &amp;quot;Lucida Console&amp;quot;; font-size: 9.5pt; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9.5pt; text-decoration: underline; letter-spacing: -0.1pt"&gt;1,235,895&lt;/span&gt;&lt;span style="font-size: 9.5pt; text-decoration: underline; letter-spacing: 2pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0.95pt; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 28.8pt; margin-bottom: 0; text-indent: -18pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; letter-spacing: -0.05pt"&gt;(6)&lt;/span&gt;&lt;span style="width: 5.63pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Transfer Capability regulatory asset:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 28.8pt; margin-bottom: 0; text-align: right; font-size: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 28.8pt; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span&gt;The Company has entered into a Lease Agreement for a portion of the Transfer Capability of the 48-corridor miles of new double-circuit 220 kV transmission line and appurtenant facilities with SCE on July 12, 2021. The Agreement has a term of 30 years.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 28.8pt; margin-bottom: 0; text-align: right; font-size: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 28.8pt; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span&gt;The Transfer Capability regulatory asset amounted to $400 million and is recorded in FERC Account 165 - Prepayment.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 28.8pt; margin-bottom: 0; text-align: right; font-size: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 28.8pt; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span&gt;The prepaid lease is amortized over the lease term of 30 years is recorded in FERC Account 567 - Rents amounting $13,333,329 in 2025 (2024 - $13,350,500).&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 28.65pt; margin-bottom: 0; text-align: right; font-size: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 28.65pt; margin-bottom: 0; text-indent: -17.9pt; font-size: 10pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; letter-spacing: -0.05pt"&gt;(7)&lt;/span&gt;&lt;span style="width: 5.68pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Long-Term&lt;/span&gt;&lt;span style="font-weight: bold; letter-spacing: -0.5pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; letter-spacing: -0.2pt"&gt;Debt&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 5.55pt; margin-left: 28.75pt; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;following&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;table&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt