    <link:footnoteArc xlink:type="arc" xlink:from="value14" xlink:to="footnote14" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="14" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote15" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Operational purchases recorded in Account 803.<xhtml:u style="text-underline: thick;"></xhtml:u></xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value15" xlink:to="footnote15" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="15" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote16" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Gas withdrawn from storage for system balancing purposes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value16" xlink:to="footnote16" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="16" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote17" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Gas delivered to storage for system balancing purposes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value17" xlink:to="footnote17" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="17" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote18" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level, rather than by discounted, negotiated or recourse rate contracts; therefore, the amounts reported have been allocated to discounted, negotiated or recourse rate contracts based on reasonable assumptions.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value18" xlink:to="footnote18" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="18" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote19" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">The value of this gas is based on the current month cash-out price provided for in our tariff. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value19" xlink:to="footnote19" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="19" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote20" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Shipper supplied gas and gas lost and unaccounted for are not directly charged to an account. As directed under FERC Order No. 581, we record "Other Regulatory Assets/Liabilities" (Accounts 182.3 / 254) through offsetting entries booked to "Regulatory Debits/Credits", (Accounts 407.3/.4) for any excess or deficiency in net shipper supplied gas (Line 37). This footnote applies to Lines 4 and 26 for all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
