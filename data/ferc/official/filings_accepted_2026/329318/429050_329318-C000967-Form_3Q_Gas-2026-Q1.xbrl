&lt;td style="width: 102.75pt; border-top: 3pt solid #000000; border-right: 1pt solid #000000; border-bottom: 1pt solid #000000; padding-right: 2.9pt; padding-left: 5.9pt; vertical-align: bottom; background-color: #ffffff;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;5&lt;/font&gt;&lt;/p&gt;
