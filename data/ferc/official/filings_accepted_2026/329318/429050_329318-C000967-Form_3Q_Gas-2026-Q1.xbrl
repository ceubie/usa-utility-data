&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;5&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="border-top: 3pt solid #000000; border-left: 0.75pt dashed #bbbbbb; border-bottom: 1pt solid #000000; padding-right: 5.9pt; padding-left: 3.92pt; vertical-align: bottom; background-color: #ffffff; -aw-border-left: 0.75pt dash-large-gap;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;$&lt;/font&gt;&lt;/p&gt;
