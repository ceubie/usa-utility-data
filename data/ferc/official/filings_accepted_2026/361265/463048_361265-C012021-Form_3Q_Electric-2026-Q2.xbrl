  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 120%; font-size: 9pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;GLOSSARY OF TERMS&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 120%; font-size: 9pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 120%; font-size: 9pt;"&gt;&lt;span style="font-family: Arial;"&gt;The following abbreviations and acronyms may be used in these financial statements to identify Keystone Appalachian Transmission Company and its current and former affiliated companies:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 120%; font-size: 9pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;table style="width: 468pt; border-collapse: collapse;" cellspacing="0" cellpadding="0"&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="width: 97.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;AGC&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 349.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;Allegheny Generating Company, a wholly owned generation subsidiary of MP&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 97.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;ATSI&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 349.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;American Transmission Systems, Incorporated, a wholly owned transmission subsidiary of FET&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 97.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;Brookfield&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 349.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;North American Transmission Company II L.P., a controlled investment vehicle entity of Brookfield Super-Core Infrastructure Partners&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 97.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;Brookfield Guarantors&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
