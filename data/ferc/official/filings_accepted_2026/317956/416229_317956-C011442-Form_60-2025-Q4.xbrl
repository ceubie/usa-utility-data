  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <span xmlns="http://www.w3.org/1999/xhtml" style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">Balance is related to capital contribution made in 2021 by the Parent Company in which Sempra Services Corporation used the capital contribution to pay off its outstanding intercompany note balance to the note holder Sempra Infrastructure Partners, LP, an affiliate of Sempra Services Corporation.</span>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <span xmlns="http://www.w3.org/1999/xhtml" style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">Amount included interest income of $1,401,052 earned from an intercompany promissory note with an associate company that was not part of the company&#8217;s operating revenue.</span>
    </link:footnote>
