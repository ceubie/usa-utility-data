    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote7" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Hampshire Gas is a direct wholly owned subsidiary of WGL Holdings, Inc. WGL Holdings, Inc. is an indirect wholly owned subsidiary of AltaGas Ltd.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value7" xlink:to="footnote7" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="7" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote8" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="color: #242424; font-family: 'times new roman', times; font-size: 16px;">Amounts due from customer as a result of the tax rate changes primarily related to the 2017 Tax Cuts and Job Act.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value8" xlink:to="footnote8" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="8" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote9" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="color: #242424; font-family: 'times new roman', times; font-size: 16px;">Amounts due from customer as a result of the tax rate changes primarily related to the 2017 Tax Cuts and Job Act.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value9" xlink:to="footnote9" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="9" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote10" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Regulatory asset established for the difference between rate treatment under FERC and rate treatment under US Generally Accepted Accounting Principles (US GAAP).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value10" xlink:to="footnote10" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="10" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote11" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Regulatory asset established for the difference between rate treatment under FERC and rate treatment under US Generally Accepted Accounting Principles (US GAAP).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value11" xlink:to="footnote11" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="11" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote12" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Regulatory liability established for the difference between rate treatment under FERC and rate treatment under US Generally Accepted Accounting Principles.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value12" xlink:to="footnote12" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="12" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote13" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="color: #242424; font-family: 'times new roman', times; font-size: 16px;">Amounts due to customer as a result of the tax rate changes primarily related to the 2017 Tax Cuts and Job Act.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value13" xlink:to="footnote13" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="13" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote14" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Regulatory liability established for the difference between rate treatment under FERC and rate treatment under US Generally Accepted Accounting Principles.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value14" xlink:to="footnote14" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="14" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote15" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="color: #242424; font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Washington Gas Light Company is the sole shipper of the Hampshire storage facility, and is responsible for supplying all gas receipts, deliveries and gas used in operations. We operate under a cost of service tariff and we do not charge a fee based on storage volumes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value15" xlink:to="footnote15" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="15" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote16" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="color: #242424; font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Washington Gas Light Company is the sole shipper of the Hampshire storage facility, and is responsible for supplying all gas receipts, deliveries and gas used in operations. We operate under a cost of service tariff and we do not charge a fee based on storage volumes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value16" xlink:to="footnote16" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="16" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote17" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="color: #242424; font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Washington Gas Light Company is the sole shipper of the Hampshire storage facility, and is responsible for supplying all gas receipts, deliveries and gas used in operations. We operate under a cost of service tariff and we do not charge a fee based on storage volumes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value17" xlink:to="footnote17" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="17" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote19" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px; color: #242424;">Hampshire Gas provides natural gas storage services to Washington Gas under a</xhtml:span>
          <xhtml:span style="font-family: sans-serif;">
          </xhtml:span>
          <xhtml:span style="font-style: inherit; font-weight: inherit; font-family: arial, helvetica, sans-serif; font-size: 13.3333px; -webkit-font-smoothing: antialiased; box-sizing: border-box; color: #242424;">FERC approved interstate storage service tariff and does not sell natural gas.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value19" xlink:to="footnote19" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="19" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote20" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px; color: #242424;">Hampshire Gas provides natural gas storage services to Washington Gas under a</xhtml:span>
          <xhtml:span style="font-family: sans-serif;">
          </xhtml:span>
          <xhtml:span style="font-style: inherit; font-weight: inherit; font-family: arial, helvetica, sans-serif; font-size: 13.3333px; -webkit-font-smoothing: antialiased; box-sizing: border-box; color: #242424;">FERC approved interstate storage service tariff and does not sell natural gas.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value20" xlink:to="footnote20" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="20" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote21" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Hampshire Gas only has revenue from Gas Storage services provided to Washington Gas Light Company.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value21" xlink:to="footnote21" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="21" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote22" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Hampshire Gas does not have revenue from discounted rate services or negotiated rate services.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value22" xlink:to="footnote22" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="22" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote23" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Hampshire Gas has no other comprehensive income or hedging activities in calendar year 2025.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value23" xlink:to="footnote23" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="23" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote25" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Hampshire Gas has no preferred stock.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value25" xlink:to="footnote25" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="25" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote26" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">AltaGas provides general corporate services including, but are not limited to, accounting and tax, finance, treasury management, legal and compliance, information technology, board of directors, executive committee, and other office services and corporate resources. The consolidated corporate shared costs are allocated by AltaGas through ASUS and then allocated to WGL Holdings and its subsidiaries, including Hampshire Gas. Allocation costs are calculated using the Massachusetts Modified Mass allocation methodology.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value26" xlink:to="footnote26" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="26" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote27" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Washington Gas has an agreement to purchase all of the storage services of Hampshire; therefore, this arrangement is deemed to be an operating lease because Washington Gas has the right and ability to direct the operation of Hampshire's storage facilities. Revenues from this arrangement are recorded to account 489.4, "Revenues from storing gas of others" and totaled $10.6 million during the year ending December 31, 2025.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value27" xlink:to="footnote27" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="27" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote28" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;">Dekatherms do not correspond to related revenues, as we operate under a cost of service tariff and we do not charge a fee based on storage volumes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value28" xlink:to="footnote28" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="28" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote29" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Dekatherms<xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 13.3333px;"> do not correspond to related revenues, as we operate under a cost of service tariff and we do not charge a fee based on storage volumes.</xhtml:span></xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value29" xlink:to="footnote29" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="29" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote30" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Accounts include 254xxx, 182xxx, 190xxx, and 282xxx, due primarily to FAS 158 and Regulatory Asset/Liability amortization.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value30" xlink:to="footnote30" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="30" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote31" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Accounts include 254xxx, 182xxx, and 190xxx, due primarily to FAS 158 and Regulatory Asset/Liability amortization.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value31" xlink:to="footnote31" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="31" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote32" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Accounts include 254xxx, 182xxx, and 190xxx, due primarily to FAS 158 and Regulatory Asset/Liability amortization.</xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value32" xlink:to="footnote32" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="32" />
