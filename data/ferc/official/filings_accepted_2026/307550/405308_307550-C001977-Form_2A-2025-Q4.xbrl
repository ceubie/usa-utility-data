  <ferc:DueToOrChargedByTheTransactionsWithAssociatedAffiliatedCompanies id="Tag739" contextRef="C63" unitRef="USD" decimals="0">487923</ferc:DueToOrChargedByTheTransactionsWithAssociatedAffiliatedCompanies>
  <ferc:DescriptionOfTheGoodOrService id="Tag740" contextRef="C64">Other Services - Corporate Services Allocations</ferc:DescriptionOfTheGoodOrService>
  <ferc:NameOfAssociatedAffiliatedCompany id="Tag741" contextRef="C64">AltaGas</ferc:NameOfAssociatedAffiliatedCompany>
  <ferc:AccountsChargedOrCreditedTransactionsWithAssociatedAffiliatedCompanies id="Tag742" contextRef="C64">Various</ferc:AccountsChargedOrCreditedTransactionsWithAssociatedAffiliatedCompanies>
  <ferc:DueToOrChargedByTheTransactionsWithAssociatedAffiliatedCompanies id="Tag743" contextRef="C64" unitRef="USD" decimals="0">243629</ferc:DueToOrChargedByTheTransactionsWithAssociatedAffiliatedCompanies>
  <ferc:DueToOrChargedByTheTransactionsWithAssociatedAffiliatedCompanies id="Tag744" contextRef="C1" unitRef="USD" decimals="0">2416275</ferc:DueToOrChargedByTheTransactionsWithAssociatedAffiliatedCompanies>
  <ferc:DueFromOrCreditedByTheTransactionsWithAssociatedAffiliatedCompanies id="Tag745" contextRef="C1" unitRef="USD" decimals="0">10627271</ferc:DueFromOrCreditedByTheTransactionsWithAssociatedAffiliatedCompanies>
  <ferc:OrderNumber id="Tag746" contextRef="C58" unitRef="Pure" decimals="0">2</ferc:OrderNumber>
  <ferc:OrderNumber id="Tag747" contextRef="C59" unitRef="Pure" decimals="0">3</ferc:OrderNumber>
  <ferc:OrderNumber id="Tag748" contextRef="C60" unitRef="Pure" decimals="0">4</ferc:OrderNumber>
