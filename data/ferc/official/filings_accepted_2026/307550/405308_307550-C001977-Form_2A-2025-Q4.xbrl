&lt;td style="width: 22.4806%; height: 22px; text-align: right;"&gt;&lt;font style="font-size: 12pt; font-family: 'times new roman', times;"&gt;&lt;strong&gt;&lt;font style="width: 22.4806%; height: 22px;"&gt;317,668&lt;/font&gt;&lt;/strong&gt;&lt;/font&gt;&lt;/td&gt;
&lt;td style="width: 20.9302%; height: 22px; text-align: right; border-style: none; margin-left: 0.1px;"&gt;&lt;font style="width: 20%; height: 22px; font-size: 12pt; font-family: 'times new roman', times;"&gt;331,447&lt;/font&gt;&lt;/td&gt;
