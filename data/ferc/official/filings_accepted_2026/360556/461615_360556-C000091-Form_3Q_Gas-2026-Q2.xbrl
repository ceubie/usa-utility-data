    <link:loc xlink:type="locator" xlink:href="#HH135E238A5C5003B5B92D72DA17587B54" xlink:label="HH135E238A5C5003B5B92D72DA17587B54" />
    <link:footnote xlink:type="resource" xlink:label="HH1AE94D706DECD7318F44C7A2128B6C1B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="border-collapse: collapse; width: 99.9957%;" border="1">
          <tbody>
            <tr>
              <td style="width: 49.9171%;">O&amp;M Gas Loss</td>
              <td style="width: 49.9171%;">1,395</td>
            </tr>
