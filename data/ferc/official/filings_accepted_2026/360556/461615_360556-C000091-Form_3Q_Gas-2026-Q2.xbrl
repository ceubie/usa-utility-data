    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB14ADF24A100623EE0A6DAB16C085F98" xlink:to="HH79D330AAA7BF7BAEA7552CF6522ADC26" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH385471B6F1ED631A28CAE757E31D4E81" xlink:label="HH385471B6F1ED631A28CAE757E31D4E81" />
    <link:footnote xlink:type="resource" xlink:label="HH090938E9927531482EA75D454DB129F5" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Our valuation of the net excesses or deficiencies which result from shipper supplied gas, as well as the valuation of the dispositions of excesses and the sources of deficiencies, is based upon the monthly market average index prices from the Cashout Rate Calculation for East Tennessee Natural Gas, LLC</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH385471B6F1ED631A28CAE757E31D4E81" xlink:to="HH090938E9927531482EA75D454DB129F5" order="1" />
