    <link:loc xlink:type="locator" xlink:href="#HH61195969E8DB57EBC71E91F85A2B07CA" xlink:label="HH61195969E8DB57EBC71E91F85A2B07CA" />
    <link:footnote xlink:type="resource" xlink:label="HH1862F19F0954466BA58C2A4DACEC9C24" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">Management believes that the information on this page has been prepared in accordance with the Commission's Opinion 154-B methodology. This presentation on page 700 is not necessarily in the form in which it would appear in connection with a challenge to a particular rate, or rates, and is therefore not intended to be binding in any specific rate litigation.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH61195969E8DB57EBC71E91F85A2B07CA" xlink:to="HH1862F19F0954466BA58C2A4DACEC9C24" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH8CFE3BE03A46009158E9B077BCEC7C9E" xlink:label="HH8CFE3BE03A46009158E9B077BCEC7C9E" />
    <link:footnote xlink:type="resource" xlink:label="HH6159CB8F1F8DBEF49D182F1848600B60" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Pursuant to the Commission&#8217;s Remedial Order, issued on November 20, 2025, in Docket No. RM25-2-000, Total Interstate Operating Revenues include amounts recoverable during the Locked-In-Period from March 1, 2022, to September 17, 2024.</p>
      </div>
    </link:footnote>
