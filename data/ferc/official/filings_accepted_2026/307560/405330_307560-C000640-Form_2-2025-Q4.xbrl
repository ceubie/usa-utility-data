    <link:footnote xlink:type="resource" xlink:label="fn-27" id="fn-27" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline">UNDERGROUND STORAGE</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Depreciation 2.23% (RP22-1155) Negative Salvage 0.53% (RP22-1155)</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">All underground storage plant depreciation was computed on depreciable plant in service based on the balance at the end of the preceding month.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-28" id="fn-28" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline">Underground Storage</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Depreciation 2.23% (RP22-1155) Negative Salvage 0.53% (RP22-1155)</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">All underground storage plant depreciation was computed on depreciable plant in service based on the balance at the end of the preceding month.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-29" id="fn-29" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline">TRANSMISSION ONSHORE</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Depreciation Non-incremental 2.50% (RP22-1155) Negative Salvage 0.20% (RP22-1155)</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Depreciation Incremental-various based on contract life (RP22-1155) negative salvage 0.20% (RP22-1155) and range from 3.15% to 10.20%. All transmission plant depreciation was computed on depreciable plant in service based on the balance at the end of the preceding month.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-30" id="fn-30" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline">Transmission Onshore</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Depreciation Incremental-various based on contract life (RP22-1155) negative salvage 0.20% (RP22-1155) and range from 3.15% to 10.20%. All transmission plant depreciation was computed on depreciable plant in service based on the balance at the end of the preceding month.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-31" id="fn-31" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline">GENERAL PLANT</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">General plant depreciation rates range from 4.00% to 33.33% (RP22-1155) based on the expected service life. General plant depreciation was primarily computed on depreciable plant in service based on the balance at the end of the preceding month</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-32" id="fn-32" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline">General Plant</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">General plant depreciation rates range from 4.00% to 33.33% (RP22-1155) based on the expected service life. General plant depreciation was primarily computed on depreciable plant in service based on the balance at the end of the preceding month</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-33" id="fn-33" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline">OTHER STORAGE</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Depreciation 1.45% (RP22-1155) Negative Salvage 0.15% (RP22-1155)</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">All other storage plant depreciation was computed on depreciable plant in service based on the balance at the end of the preceding month.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-34" id="fn-34" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline">Other Storage</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Depreciation 1.45% (RP22-1155) Negative Salvage 0.15% (RP22-1155)</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">All other storage plant depreciation was computed on depreciable plant in service based on the balance at the end of the preceding month.</span>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%;text-decoration:underline"></span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-35" id="fn-35" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">LETTER OF CREDIT FEES INCURRED BY WILLIAMS ARE CHARGED TO ITS SUBSIDIARIES, INCLUDING NORTHWEST PIPELINE, BASED ON A THREE-FACTOR FORMULA, WHICH CONSIDERS REVENUES; PROPERTY, PLANT AND EQUIPMENT; AND PAYROLL.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-36" id="fn-36" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:19pt">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-bottom:1pt solid #000;border-left:1pt solid #000;border-right:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:middle">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:115%">Schedule Page: 358 Line No.: 5 Column: (d)</span>
            </td>
          </tr>
        </table>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Enterprise shared service costs are allocated to franchises via specific or general methods. Specific allocations are based on metrics that bear a reasonable correlation to the delivery of services, for instance some human resource services costs are allocated based on employee headcount. General allocations are based on "Modified Massachusetts" formula (MMF) which is determined by the proportion of three components: net revenues; gross property, plant and equipment; and gross payroll.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-37" id="fn-37" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:19pt">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-bottom:1pt solid #000;border-left:1pt solid #000;border-right:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:middle">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:115%">Schedule Page: 358 Line No.: 6 Column: (d)</span>
            </td>
          </tr>
        </table>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Enterprise shared service costs for fleet leasing and other fleet costs are allocated to franchises via specific allocations based on labor costs assigned to capital work orders.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-38" id="fn-38" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:19pt">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-bottom:1pt solid #000;border-left:1pt solid #000;border-right:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:middle">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:115%">Schedule Page: 358 Line No.: 12 Column: (d)</span>
            </td>
          </tr>
        </table>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Payroll and non-payroll charges for the benefit of the operating area that are not specific to a franchise are allocated to franchises in the operating area via specific or general methods. Specific allocations are based on metrics that bear a reasonable correlation to the delivery of services, for instance some human resource services costs are allocated based on employee headcount. General allocations are based on "Modified Massachusetts" formula (MMF) which is determined by the proportion of three components: net revenues; gross property, plant and equipment; and gross payroll.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-39" id="fn-39" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:19pt">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-bottom:1pt solid #000;border-left:1pt solid #000;border-right:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:middle">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:115%">Schedule Page: 358 Line No.: 13 Column: (d)</span>
            </td>
          </tr>
        </table>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Storage facilities charges recorded to a specific work order for the benefit of the storage facilities within Transmission, Power &amp; Gulf Operating Area that are not specific to a franchise are allocated to franchises included in the operating area via specific allocations primarily based on labor costs.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-40" id="fn-40" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:19pt">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-bottom:1pt solid #000;border-left:1pt solid #000;border-right:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:middle">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:115%">Schedule Page: 358 Line No.: 14 Column: (d)</span>
            </td>
          </tr>
        </table>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Employees' direct assignment payroll and non-payroll charges recorded to a specific work order for the benefit of the Transmission, Power &amp; Gulf Operating Area that are not specific to a franchise are allocated to franchises included in the operating area via general allocations based on "Modified Massachusetts" formula (MMF).</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-41" id="fn-41" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:19pt">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-bottom:1pt solid #000;border-left:1pt solid #000;border-right:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:middle">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:115%">Schedule Page: 358 Line No.: 18 Column: (d)</span>
            </td>
          </tr>
        </table>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Houston, Texas Williams tower building rent is allocated based on employee labor hours.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-42" id="fn-42" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:19pt">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-bottom:1pt solid #000;border-left:1pt solid #000;border-right:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:middle">
              <div>
                <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:115%">Schedule Page: 358 Line No.: 19 Column: (d)</span>
              </div>
            </td>
          </tr>
        </table>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Common systems hardware and software costs are allocated via general allocations using "Modified Massachusetts" formula (MMF).</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-43" id="fn-43" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:19pt">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="border-bottom:1pt solid #000;border-left:1pt solid #000;border-right:1pt solid #000;border-top:1pt solid #000;padding:2px 1pt;text-align:left;vertical-align:middle">
              <div>
                <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-style:italic;font-weight:700;line-height:115%">Schedule Page: 358 Line No.: 23 Column: (d)</span>
              </div>
            </td>
          </tr>
        </table>
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Salt Lake City, Utah building rent is allocated based on employee labor hours.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-44" id="fn-44" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:105%">JACKSON PRAIRIE IS JOINTLY OWNED BY THREE COMPANIES: NORTHWEST (RESPONDENT), PUGET SOUND ENERGY AND AVISTA CORPORATION, EACH OWNS ONE THIRD OF THE FACILITIES.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-45" id="fn-45" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:105%">COSTS REPRESENTS RESPONDENT'S 22.3% SHARE OF FACILITIES. TRANSWESTERN PIPELINE OWNS THE REMAINING 77.7%.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-46" id="fn-46" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
