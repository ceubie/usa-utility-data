        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Pursuant to Section 14.12 of the General Terms and Conditions of Northwest's Tariff.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-15" id="fn-15" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
