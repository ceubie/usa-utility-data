  <ferc:FormType id="HHF7EC89F6B6814CD2CC1C6928B801FC93" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">1/3-Q</ferc:FormType>
  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C012890</ferc:CompanyIdentifier>
  <ferc:ReportYearPeriod id="HH6439FA2135BC4FC31DA52CEDA67ED097" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026/Q2</ferc:ReportYearPeriod>
  <ferc:ReportYear id="HH660FC444EE17A785BFF22BCDC6434313" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4" decimals="0" unitRef="HHferc_us_Pure">2026</ferc:ReportYear>
  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q2</ferc:ReportPeriod>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-06-30</ferc:ReportDate>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock id="HHD2B1DFDF71C7477E84AEA1D4D780024C" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;1) None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock>
  <ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock id="HH9BC0EFBCB25FD35BD21CC5095A000F66" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;2) None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock>
  <ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock id="HHB507706EE223692FB3CE9DE4D62FC621" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;3)&amp;#160;&lt;span style="font-size: 0.9rem;"&gt;In July 2024, NorthWestern Corporation entered into an Abandonment and Acquisition (A&amp;amp;A) Agreement with Puget Sound Energy (Puget) to acquire Puget&amp;#8217;s combined 370 megawatt interests in Units 3 and 4 of the Colstrip Generating Station (Colstrip) for $0. In December 2025, NorthWestern Corporation completed the assignment of its rights and obligations under the A&amp;amp;A Agreement to NorthWestern Colstrip 370Pu LLC (NW Colstrip 370). NW Colstrip 370 completed the acquisition of Puget&amp;#8217;s interests in Colstrip Units 3 and 4 on January 1, 2026.&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal"&gt;Puget will remain responsible for its respective pre-closing share of environmental, asset retirement obligations (AROs), and pension liabilities attributed to events or conditions existing prior to the closing of the transaction and for any future decommissioning and demolition costs associated with the existing Colstrip assets that comprised its interests. While Puget remains contractually obligated for the pre-closing share of AROs, NW Colstrip 370 remains the primary obligor. As such, as of June 30, 2026, NW Colstrip 370 has recorded a $23.2 million liability for these AROs and has recorded an indemnification asset of $23.2 million.&lt;/p&gt;
&lt;p class="MsoNormal"&gt;In October 2025, NW Colstrip 370 entered into a Master Power Purchase and Sale Agreement (PPA) and Confirmation Agreement with Mercuria Energy America, LLC (Mercuria) from the share of Colstrip that NW Colstrip 370 acquired from Puget on January 1, 2026. The delivery period of that agreement is January 1, 2026, through September 30, 2027. NW Colstrip 370 filed the PPA and Confirmation Agreement with FERC in Docket No. ER26-411. FERC accepted the PPA and Confirmation Agreement effective January 1, 2026. &lt;em&gt;See NorthWestern Colstrip 370Pu LLC&lt;/em&gt;, 194 FERC &amp;#182; 61,154 (2026).&lt;/p&gt;
&lt;p class="MsoNormal"&gt;Also in October 2025, NW Colstrip 370 submitted a request to FERC in Docket No. ER26-129 for approval of a Cost-Based Rate Tariff (CBR Tariff) for the purpose of making short-term sales of electricity produced by its share of Units 3 and 4 of Colstrip. FERC accepted the CBR Tariff effective January 1, 2026. &lt;em&gt;See NorthWestern Colstrip 370Pu LLC&lt;/em&gt;, 194 FERC &amp;#182; 61,153 (2026).&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock>
  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="HH1C967D5CB7055C23C61684D3A8ADDA65" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;4) None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
  <ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock id="HH3753C2D0F64441EEC1CB77241E2239DC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;5) None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock>
  <ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock id="HH2FB9527C1D4BB25D79F1C0C76F5BC95D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;6) None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock>
  <ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock id="HHDB4E63D65FD21AE5462A8FBA840EA717" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;7) NorthWestern Colstrip 370Pu, LLC was created on July 22, 2025.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock>
  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="HHEBA1CD44839C108D1DAFD6DE3427BE45" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;8) None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock>
  <ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock id="HH22FBAEA0509E80B804A4341B1670898A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;9) None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock>
  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="HH582A4E700260C05D782FA2D6F218758A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;10) None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
  <ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock id="HHFB056E8F64ABA7B86B31B31B7725CE20" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;12) None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p style="font-family: sans-serif; font-size: 14px;"&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 9pt; line-height: 14.4px;"&gt;13.) &lt;/span&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 9pt; line-height: 14.4px;"&gt;As noted in response to inquiry 3, o&lt;/span&gt;&lt;span style="font-family: 'Proxima Nova'; font-size: 12.6px;"&gt;n January 1, 2026, NW Colstrip 370 acquired Puget&amp;#8217;s 370 megawatt combined share of Colstrip Units 3 and 4. &lt;/span&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 12px;"&gt;NW Colstrip 370 is a direct subsidiary of NorthWestern Energy Group, Inc. &lt;/span&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 12px;"&gt;The Officers (including titles) of NW Colstrip 370 are as follows:&lt;/span&gt;&lt;/p&gt;
&lt;p style="font-family: sans-serif; font-size: 14px;"&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 12px;"&gt;&amp;#8211; Brian Bird, President;&lt;/span&gt;&lt;/p&gt;
&lt;p style="font-family: sans-serif; font-size: 14px;"&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 12px;"&gt;&amp;#8211; Crystal Lail, Vice President;&lt;/span&gt;&lt;/p&gt;
&lt;p style="font-family: sans-serif; font-size: 14px;"&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 12px;"&gt;&amp;#8211; Emily Ng, Treasurer;&lt;/span&gt;&lt;/p&gt;
&lt;p style="font-family: sans-serif; font-size: 14px;"&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 12px;"&gt;&amp;#8211; Timothy Olson, Secretary; and&lt;/span&gt;&lt;/p&gt;
&lt;p style="font-family: sans-serif; font-size: 14px;"&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 12px;"&gt;&amp;#8211; Emily Folsom, Assistant Secretary.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock id="HHD790CCB2EDB33AB49E3957CEAFD4E7D7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;14) N/A&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div style="font-family: sans-serif; font-size: medium; text-align: center;"&gt;
&lt;table style="width: 511.5pt; margin-right: auto; margin-left: auto;" cellspacing="0" cellpadding="0"&gt;
&lt;tbody&gt;
&lt;tr style="height: 15pt;"&gt;
&lt;td style="width: 506.2pt; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: bottom; background-color: #cdcdcd;"&gt;
&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; color: #b90101;"&gt;(1) Liquidity&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;/div&gt;
&lt;p style="font-family: sans-serif; margin-top: 0pt; margin-bottom: 0pt; text-indent: 18pt; line-height: 14.9333px; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="font-family: sans-serif; margin-top: 0pt; margin-bottom: 0pt; text-indent: 18pt; line-height: 14.9333px; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;During the six months &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;ended&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; June 30, 2026, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;NorthWestern&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; Colstrip 370 Pu, LLC (the Company) experienced negative net cash flows from operating activities, driven primarily by timing of fuel costs and low energy prices. As a result, cash generated from operations was not sufficient to fully fund the Company&amp;#8217;s operating and capital requirements for the period.&lt;/span&gt;&lt;/p&gt;
&lt;p style="font-family: sans-serif; margin-top: 0pt; margin-bottom: 0pt; text-indent: 18pt; line-height: 14.9333px; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="font-family: sans-serif; margin-top: 0pt; margin-bottom: 0pt; text-indent: 18pt; line-height: 14.9333px; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company is a wholly owned subsidiary of &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;NorthWestern&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; Energy Group, Inc. (the Parent). Management expects that, should the Company continue to incur negative operating cash flows, that the Parent will continue to provide equity contributions as necessary to support ongoing operations and meet the Company&amp;#8217;s obligations as they become due. The Parent has the intent and ability to provide such support for the foreseeable future.&lt;/span&gt;&lt;/p&gt;
&lt;p style="font-family: sans-serif; margin-top: 0pt; margin-bottom: 0pt; text-indent: 18pt; line-height: 14.9333px; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="font-family: sans-serif; margin-top: 0pt; margin-bottom: 0pt; text-indent: 18pt; line-height: 14.9333px; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Based on the Parent&amp;#8217;s continued financial support, management believes that the Company will have sufficient liquidity to fund operations and capital expenditures for at least the next twelve months. Accordingly, the accompanying financial statements have been prepared on a going&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#8209;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;concern basis.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
