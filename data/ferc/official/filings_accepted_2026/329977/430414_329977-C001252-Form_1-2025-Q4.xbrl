  <ferc:MiscellaneousDeferredDebits id="HH7EC7C4518B37B9BBA85B5C4ED43B645E" contextRef="HHF7CE68E257CA8D85E9415386900D34E3" decimals="0" unitRef="HHferc_us_Currency">1092612</ferc:MiscellaneousDeferredDebits>
