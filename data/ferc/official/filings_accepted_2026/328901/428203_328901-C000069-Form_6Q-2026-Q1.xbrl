    <link:footnote xlink:type="resource" xlink:label="HH7F4A11853F156DE1F51A345651BA8A01" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; margin: 12pt 0px; font-size: 12pt; font-family: 'Times New Roman', serif;">
          <span style="font-size: 10pt;">Effective July</span>
          <span style="font-size: 10pt;">1,2025, the membership interest in Shore Terminals LLC held by NuPop was transferred to Sunoco Midstream LLC.</span>
        </p>
