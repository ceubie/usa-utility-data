    <link:footnote xlink:type="resource" xlink:label="HHA222FA31A94A10FCCA631454BD08C400" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Roboto, 'Segoe UI', GeezaPro, 'DejaVu Serif', 'sans-serif', -apple-system, BlinkMacSystemFont;">Cash Management Program with </span>Sunoco LP</p>
