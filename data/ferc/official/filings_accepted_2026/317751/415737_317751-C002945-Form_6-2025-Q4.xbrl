  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="f-14" contextRef="c-1">&lt;div style="padding-left:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8.5pt;font-weight:400;line-height:119%"&gt;1)&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8.5pt;font-weight:400;line-height:119%;padding-left:10.45pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8.5pt;font-weight:400;line-height:119%"&gt;2)&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8.5pt;font-weight:400;line-height:119%;padding-left:10.45pt"&gt;None&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8.5pt;font-weight:400;line-height:142%"&gt;3)&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8.5pt;font-weight:400;line-height:142%;padding-left:10.45pt"&gt;None &lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8.5pt;font-weight:400;line-height:142%"&gt;4)&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8.5pt;font-weight:400;line-height:142%;padding-left:10.45pt"&gt;The Company is involved in various litigation arising from the normal operations of its pipeline business. The Company, based on the advice of counsel, believes that any adverse findings with respect to such legal actions will not result in a material effect on the financial position of the Company.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:18pt;text-indent:-18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8.5pt;font-weight:400;line-height:119%"&gt;5)&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:8.5pt;font-weight:400;line-height:119%;padding-left:10.45pt"&gt;Not Applicable&lt;/span&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
