t;, sans-serif; text-align: right"&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="106" style="border-top: 3px none currentColor; border-right: 3px none currentColor; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: 3px none currentColor; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 15.75pt; width: 17.4847%"&gt;   &lt;p align="right" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;29&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 10.5691%"&gt;   &lt;td width="234" style="background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 16.5pt; width: 42.0245%"&gt;   &lt;p style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;Total utility plant&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="104" style="background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 16.5pt; width: 15.9509%"&gt;   &lt;p align="center" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="19" style="background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 16.5pt; width: 3.22086%"&gt;   &lt;p style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="106" style="border-top: 3px none currentColor; border-right: 3px none currentColor; border-bottom: 2.25pt double rgba(0, 0, 0, 1); border-left: 3px none currentColor; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 16.5pt; width: 18.0982%"&gt;   &lt;p align="right" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;$&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;638,565&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="19" style="background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 16.5pt; width: 3.22086%"&gt;   &lt;p align="right" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="106" style="border-top: 3px none currentColor; border-right: 3px none currentColor; border-bottom: 2.25pt double rgba(0, 0, 0, 1); border-left: 3px none currentColor; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 16.5pt; width: 17.4847%"&gt;   &lt;p align="right" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;$&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;631,546&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt; &lt;/table&gt;&lt;p style="margin: 12pt 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;/p&gt;&lt;h1 style="margin: 24pt 0 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;NOTE E - ASSET RETIREMENT OBLIGATIONS:&lt;/span&gt;&lt;/span&gt;&lt;/h1&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Sea Robin's recorded asset retirement obligations are primarily related to owned offshore lines and platforms. At the end of the useful life of these underlying assets, Sea Robin is legally or contractually required to abandon in place or remove the asset. An ARO is required to be recorded when a legal obligation to retire an asset exists and such obligation can be reasonably estimated. Although a number of other onshore assets in Sea Robin's system are subject to agreements or regulations that give rise to an ARO upon Sea Robin's discontinued use of these assets, AROs were not recorded because these assets have an indeterminate removal or abandonment date given the expected continued use of the assets with proper maintenance or replacement. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Individual component assets have been and will continue to be replaced, but the pipeline system will continue in operation as long as supply and demand for natural gas exists. Based on the widespread use of natural gas in industrial and power generation activities, management expects supply and demand to exist for the foreseeable future. Sea Robin has in place a rigorous repair and maintenance program that keeps the pipeline system in good working order. Therefore, although some of the individual assets may be replaced, the pipeline system itself will remain intact indefinitely. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Sea Robin recorded AROs related to retiring offshore platforms and lines. Long-lived assets related to AROs aggregated $39.4 million were reflected as Utility plant, Account 101, on the balance sheet as of December 31, 2025 and 2024. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;The ARO trust is measured at fair value on a recurring basis based on quoted prices in an active market and is classified as available-for-sale. However, both realized and unrealized gains and losses of the ARO trust are recorded in Other regulatory assets, Account 182.3, or Other regulatory liabilities, Account 254. The cumulative restricted fund was reflected in the balance sheet as Other special funds, Account 128, in the amount of $34.8 million and $30.8 million as of December 31, 2025 and 2024, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Investments in available-for-sale securities in the ARO trust measured at fair value were as follows:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;table border="0" cellspacing="0" cellpadding="0" width="417" style="width: 502px; margin-left: 13.5pt; max-width: 1784.5px; height: 166px" class="e-rte-paste-table"&gt;  &lt;tr style="height: 14.3678%"&gt;   &lt;td width="198" style="padding: 0 5.4pt; height: 15.75pt; width: 49.2032%"&gt;&lt;br /&gt;&lt;/td&gt;   &lt;td width="219" colspan="3" style="border-top: 3px none currentColor; border-right: 3px none currentColor; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: 3px none currentColor; padding: 0 5.4pt; height: 15.75pt; width: 50.7968%"&gt;   &lt;p align="center" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;December 31, 2025&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 14.3678%"&gt;   &lt;td width="198" style="padding: 0 5.4pt; height: 15.75pt; width: 49.2032%"&gt;&lt;br /&gt;&lt;/td&gt;   &lt;td width="100" style="border-top: 3px none currentColor; border-right: 3px none currentColor; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: 3px none currentColor; padding: 0 5.4pt; height: 15.75pt; width: 22.3108%"&gt;   &lt;p align="center" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;Cost basis&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="19" style="padding: 0 5.4pt; height: 15.75pt; width: 5.37849%"&gt;&lt;br /&gt;&lt;/td&gt;   &lt;td width="100" style="border-top: 3px none currentColor; border-right: 3px none currentColor; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: 3px none currentColor; padding: 0 5.4pt; height: 15.75pt; width: 23.1076%"&gt;