    <ferc:DescriptionOfTheGoodOrService id="f-2422" contextRef="c-372">Other ($250,000 or less)</ferc:DescriptionOfTheGoodOrService>
    <ferc:DueFromOrCreditedByTheTransactionsWithAssociatedAffiliatedCompanies id="f-2423" contextRef="c-372" unitRef="u-02" decimals="0">2754</ferc:DueFromOrCreditedByTheTransactionsWithAssociatedAffiliatedCompanies>
    <ferc:NameOfAssociatedAffiliatedCompany id="f-2424" contextRef="c-372">See footnote</ferc:NameOfAssociatedAffiliatedCompany>
    <ferc:OrderNumber id="f-2425" contextRef="c-372" unitRef="u-07" decimals="0">21</ferc:OrderNumber>
    <ferc:DueFromOrCreditedByTheTransactionsWithAssociatedAffiliatedCompanies id="f-2427" contextRef="c-82" unitRef="u-02" decimals="0">2754</ferc:DueFromOrCreditedByTheTransactionsWithAssociatedAffiliatedCompanies>
    <ferc:ChargesForOutsideProfessionalAndOtherConsultativeServices id="f-2429" contextRef="c-375" unitRef="u-02" decimals="0">342915</ferc:ChargesForOutsideProfessionalAndOtherConsultativeServices>
    <ferc:ChargesForOutsideProfessionalAndOtherConsultativeServices id="f-2430" contextRef="c-376" unitRef="u-02" decimals="0">429064</ferc:ChargesForOutsideProfessionalAndOtherConsultativeServices>
    <ferc:ChargesForOutsideProfessionalAndOtherConsultativeServices id="f-2431" contextRef="c-374" unitRef="u-02" decimals="0">4623948</ferc:ChargesForOutsideProfessionalAndOtherConsultativeServices>
    <ferc:NameOfPersonOrOrganizationRenderingProfessionalOrConsultativeServices id="f-2432" contextRef="c-376">Other ($250,000 or Less)</ferc:NameOfPersonOrOrganizationRenderingProfessionalOrConsultativeServices>
    <ferc:NameOfPersonOrOrganizationRenderingProfessionalOrConsultativeServices id="f-2433" contextRef="c-374">PHI Group Inc</ferc:NameOfPersonOrOrganizationRenderingProfessionalOrConsultativeServices>
    <ferc:NameOfPersonOrOrganizationRenderingProfessionalOrConsultativeServices id="f-2434" contextRef="c-375">T Baker Smith LLC</ferc:NameOfPersonOrOrganizationRenderingProfessionalOrConsultativeServices>
    <ferc:OrderNumber id="f-2435" contextRef="c-374" unitRef="u-07" decimals="0">1</ferc:OrderNumber>
    <ferc:OrderNumber id="f-2436" contextRef="c-375" unitRef="u-07" decimals="0">2</ferc:OrderNumber>
    <ferc:OrderNumber id="f-2437" contextRef="c-376" unitRef="u-07" decimals="0">3</ferc:OrderNumber>
    <ferc:ChargesForOutsideProfessionalAndOtherConsultativeServices id="f-2439" contextRef="c-82" unitRef="u-02" decimals="0">5395927</ferc:ChargesForOutsideProfessionalAndOtherConsultativeServices>
    <ferc:MainsGasTransmissionPlantAdditions id="f-2441" contextRef="c-82" unitRef="u-02" decimals="0">-5</ferc:MainsGasTransmissionPlantAdditions>
    <ferc:NotesToFinancialStatementsTextBlock id="f-2443" contextRef="c-82">&lt;div&gt;&lt;h1 style="margin: 24pt 0 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;NOTE A - ORGANIZATION AND OPERATIONS:&lt;/span&gt;&lt;/span&gt;&lt;/h1&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;b&gt;Organization.&lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt; Sea Robin Pipeline Company, LLC (&amp;quot;Sea Robin&amp;quot;), a Delaware limited liability company, is a direct wholly-owned subsidiary of Panhandle Eastern Pipe Line Company, LP (&amp;quot;PEPL&amp;quot;), which is an indirect wholly-owned subsidiary of Energy Transfer LP (&amp;quot;Energy Transfer&amp;quot;).&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;b&gt;Operations. &lt;/b&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Sea Robin is primarily engaged in the interstate transportation of natural gas and as such, Sea Robin is subject to the jurisdiction of the Federal Energy Regulatory Commission (&amp;quot;FERC&amp;quot;). Sea Robin gathers and transports natural gas supplies from various points in the Gulf of America, and offshore Louisiana, for processing and delivery to the interstate transmission grid in the vicinity of its onshore terminus points near Erath, Louisiana in Vermilion Parish, near Patterson, Louisiana in St. Mary Parish, and near Kaplan, Louisiana in Vermilion Parish. The Sea Robin pipeline system includes the Sea Robin West Area System (&amp;quot;Sea Robin West Area&amp;quot;), or the original Sea Robin system, and the Sea Robin East Area System (&amp;quot;Sea Robin East Area&amp;quot;), which Sea Robin acquired from its associated company, Trunkline Gas Company, LLC, a direct a wholly-owned subsidiary of PEPL, effective September 1, 2012. In total, Sea Robin owns approximately 750 miles of dual phase pipelines which generally gather a raw stream of natural gas and liquid hydrocarbons, including condensate, which has not been separated or processed. This network is divided into two segments for administrative and rate purposes, Sea Robin West Area and Sea Robin East Area. The pipeline has capacity to transport up to 2.0 billion cubic feet per day.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Sea Robin evaluated subsequent events through April &lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="background: rgba(0, 0, 0, 0)"&gt;16&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;, 2026, the date on which these accompanying financial statements were available to be issued. Any material subsequent events that occurred during this time have been properly recognized and/or disclosed in these financial statements.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h1 style="margin: 24pt 0 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;NOTE B - ESTIMATES AND SIGNIFICANT ACCOUNTING POLICIES:&lt;/span&gt;&lt;/span&gt;&lt;/h1&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;1.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Basis of Presentation&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Sea Robin's financial statements have been prepared in accordance with the accounting requirements of the FERC, as set forth in the applicable Uniform System of Accounts and published accounting releases, which constitute a comprehensive basis of accounting other than accounting principles generally accepted in the United States of America (&amp;quot;GAAP&amp;quot;). The most significant differences between GAAP and the financial statements presented herein are: (1) classification of certain accounts on the balance sheet, statement of income, and statement of cash flows, (2) certain assets and liabilities from the regulated ratemaking process are recorded that would not be recorded under GAAP for nonregulated entities, (3) purchase accounting related impacts including purchase cost allocations that are not reflected in the financial statements presented herein, and (4) current vs non-current classification of intercompany loans and advances, which may be different for GAAP purposes. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;2.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Use of Estimates&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;The preparation of financial statements requires management to make estimates and assumptions that affect the reported amounts of assets and liabilities and the accrual for and disclosure of contingent assets and liabilities at the date of the financial statements and the reported amounts of revenues and expenses during the reporting period. &lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); background: rgba(255, 255, 255, 1); text-decoration: inherit"&gt;Although these estimates are based on management's available knowledge of current and expected future events, actual&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt; results could differ from those estimates.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;3.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Cash and Cash Equivalents&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Sea Robin, as a subsidiary of PEPL, participates in a cash management program with Energy Transfer which authorizes Energy Transfer or its designated affiliate to provide cash management services to Sea Robin. At the close of each business day, the agreement allows for Sea Robin to transfer funds in excess of general operating purposes to Energy Transfer or if Sea Robin has insufficient funds to meet its general operating purposes, Energy Transfer will transfer all funds necessary to Sea Robin. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;4.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Plant Materials and Operating Supplies&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Plant materials and operating supplies are carried at the lower of weighted average cost or net realizable value. Materials transferred out of warehouses are priced at weighted average cost. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;5.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Natural Gas Imbalances&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Natural gas imbalances occur as a result of differences in volumes of gas received and delivered. Natural gas imbalance in-kind receivables and payables are valued at market and are generally settled in cash pursuant to Sea Robin's tariff with no impact on revenues.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;6.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Crediting Flow through Mechanism&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Sea Robin is subject to a tracking mechanism and records a regulatory asset or a regulatory liability based on the cumulative net amounts recorded for cash out and in-kind imbalance activity. This is combined with the value of net fuel volumes retained from customers, offset by the value of fuel and other volumes used in the operation of the system. Cumulative net amounts under recovered or over recovered from customers are recorded in Other regulatory assets, Account 182.3, or Other regulatory liabilities, Account 254, as appropriate. The cumulative under recoveries are carried forward to the next twelve months period and cumulative over recoveries for the prior twelve months are refunded to customers, pursuant to guidance Docket No. RP25-318-000 and Section 22 of the General Terms and Conditions of Sea Robin's FERC Gas Tariff, Third Revised Volume No. 1.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;7.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Fuel Tracker &lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;The fuel tracker is the cumulative balance owed to Sea Robin by its customers or owed by Sea Robin to its customers for gas used in the operation of its system including fuel gas lost or unaccounted for gas. The fuel gas reimbursement percentages are based on specific percentages pursuant to Sea Robin's tariff in order to provide fuel to cover gas used in the operation of its system. The net difference between the fuel reimbursement percentage received and gas used in the operation of its system is valued at market price and recorded in Other regulatory assets, Account 182.3, or Other regulatory liabilities, Account 254, as applicable. The effective date of each fuel reimbursement is July 1st.The fuel reimbursement is in-kind and non-discountable.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;As of December 31, 2025 and 2024, Sea Robin's fuel tracker has a balance of $1.0 million and $0.9 million in Other regulatory assets, Account 182.3, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;8.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Utility Plant &lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;i&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: underline"&gt;Additions&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;. &lt;/span&gt;&lt;/span&gt;&lt;/i&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Ongoing additions of utility plant are stated at original cost. Sea Robin capitalizes all construction-related direct labor and material costs, as well as indirect construction costs. Such indirect construction costs primarily include labor and related costs of departments associated with supporting construction activities and allowance for funds used during construction. The indirect capitalized labor and related costs are largely based upon results of periodic time studies or management reviews of time allocations, which provide an estimate of time spent supporting construction projects. The cost of replacements and betterments that extend the useful life of utility plant is also capitalized. The cost of repairs and replacements of minor utility plant items is charged to expense as incurred. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;i&gt;&lt;span style="text-decoration: underline"&gt;Retirements.&lt;/span&gt; &lt;/i&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;When ordinary retirements of utility plant occur, the original cost plus cost of removal less salvage value, is removed by a charge to accumulated depreciation and amortization, with no gain or loss recorded. When entire regulated operating units of utility plant are sold, the original cost and related accumulated depreciation and amortization accounts are removed, with any resulting gain or loss recorded in the statement of income.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;i&gt;&lt;span style="text-decoration: underline"&gt;Depreciation&lt;/span&gt;&lt;/i&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;. &lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;Sea Robin computed depreciation expense under &lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;the composite method using FERC-approved depreciation rates. For general and intangible plant, Sea Robin computed depreciation expense under the straight-line method using FERC-approved depreciation rates. Asset retirement obligations are depreciated over the useful life of the related asset.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Amortization related to Gas plant acquisition adjustments, Account 114, is computed using the straight-line method over the average remaining life of the related asset and included in Miscellaneous amortization, Account 425.&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;i&gt;&lt;span style="text-decoration: underline"&gt;Allowance for Funds Used During Construction.&lt;/span&gt;&lt;/i&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt; Sea Robin capitalizes the cost of funds used during construction for capital projects. The rates used by Sea Robin are calculated pursuant to the FERC rules, which include an allowance for the cost of debt and equity funds.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;9.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Asset Retirement Obligation (&amp;quot;ARO&amp;quot;) &lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Legal obligations associated with the retirement of long-lived assets are recorded at fair value at the time the obligations are incurred, if a reasonable estimate of fair value can be made. Present value techniques are used which reflect assumptions such as removal and remediation costs, inflation, and profit margins that third parties would demand to settle the amount of the future obligation. Sea Robin did not include a market risk premium for unforeseeable circumstances in its fair value estimates because such a premium could not be reasonably estimated. Upon initial recognition of the liability, costs are capitalized as a part of the long-lived asset and depreciated over the useful life of the related asset. The liability is accreted to its present value each period with accretion being recorded to operating expense or regulatory asset, as applicable, with a corresponding increase in the carrying amount of the liability. To the extent Sea Robin is permitted to collect and has reflected in its financials amounts previously collected from customers and expensed, such amounts serve to reduce what would be reflected as capitalized costs at the initial establishment of an ARO. Sea Robin records ARO accretion and amortization expenses (in excess of current recoveries) as a regulatory asset based on the probability of recovery in rates in future rate cases.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;10.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Related Party Transactions&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); background: rgba(255, 255, 255, 1); text-decoration: inherit"&gt;Related party transactions primarily include revenues earned from and payments for services provided by &lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Energy Transfer and its subsidiaries. Transactions are generally allocated based on relevant criteria, including time spent, utility, gross margin, salaries, or other appropriate methods.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;11.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Environmental Expenditures &lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Environmental expenditures that relate to an existing condition caused by past operations that do not contribute to current or future revenue generation are expensed. Environmental expenditures relating to current or future revenues are expensed or capitalized as appropriate. Liabilities are recorded when environmental assessments and/or clean-ups are probable and the costs can be reasonably estimated. Remediation obligations are not discounted because the timing of future cash flow streams is not predictable. As of December 31, 2025 and 2024, there were no amounts accrued for future environmental expenditures.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;12.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Revenue Recognition &lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Sea Robin's revenues from transportation and gathering of natural gas are based on capacity reservation charges and, to a lesser extent, commodity usage charges. Reservation revenues, recognized monthly, are based on contracted rates and capacity reserved by the customers. Revenues from commodity usage charges, also recognized monthly, are based on the volumes received from or delivered to the customer, based on Sea Robin's tariff. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Revenues collected during the pendency of a rate proceeding may be required by the FERC to be refunded in the final order. Sea Robin establishes reserves for such potential refunds, as appropriate. The balances of accumulated provision for rate refunds, Account 229, were $1.7 million as of December 31, 2025 and 2024.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;h2 style="margin: 12pt 0 12pt 0.35in; line-height: 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; font-weight: bold; text-decoration: underline"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="text-decoration: none"&gt;&lt;span&gt;13.&lt;span style="font: 7pt &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Accounts Receivable and Allowance for Expected Credit Losses&lt;/span&gt;&lt;/span&gt;&lt;/h2&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Sea Robin's operations are primarily concentrated in the natural gas industry and its major customers' operations are in the same industry. The large number of customers in this energy segment may impact Sea Robin's overall exposure to credit risk, either positively or negatively, in that the customers may be similarly affected by changes in economic or other conditions. Sea Robin manages credit risks to mitigate credit losses and exposure to uncollectible trade receivables. Prospective and existing customers are reviewed regularly for creditworthiness based upon pre-established standards consistent with FERC filed tariff to manage credit risk within approved tolerances. Customers that do not meet minimum credit standards are required to provide additional credit support in the form of a letter of credit, prepayment, or other forms of security. &lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;Sea Robin establishes an allowance for expected credit losses on trade receivables based on the expected ultimate recovery of these receivables and considers many factors including historical customer collection experience, general and specific economic trends, and known specific issues related to individual customers, sectors, and transactions that might impact collectability. Changes in the allowance are recorded as a component of operating expenses; reductions in the allowance are recorded when receivables are subsequently collected or written-off. Past due receivable balances are written-off when Sea Robin's efforts have been unsuccessful in collecting the amount due. Sea Robin's allowances for expected credit losses were $0.6 million and immaterial as of December 31, 2025 and 2024, respectively.&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 12pt 0 12pt 0.2in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;The following table presents the relative contribution to Sea Robin's total transportation and gathering revenues from operations of each customer that comprised at least 10% of its revenues:&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;table border="0" cellspacing="0" cellpadding="0" width="398" style="width: 298.85pt; margin-left: 31.5pt" class="e-rte-paste-table"&gt;  &lt;tr style="height: 16.2pt"&gt;   &lt;td width="155" style="width: 116.45pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 16.2pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="21" style="width: 15.9pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 16.2pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="222" colspan="3" style="width: 166.5pt; border-top: none; border-right: none; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: none; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 16.2pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;Years Ended December 31,&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 15.45pt"&gt;   &lt;td width="155" style="width: 116.45pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 15.45pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="21" style="width: 15.9pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 15.45pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;, serif; color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="100" style="width: 75.25pt; border-top: none; border-right: none; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: none; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 15.45pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;2025&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="21" style="width: 15.9pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; heigh