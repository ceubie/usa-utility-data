        <link:footnote xlink:label="ft-198_46935_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 278 Line No.: 1 Column: a</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">ARO cost of service allowance established pursuant to Article IV, Section B.5.e. of the Stipulation and Agreement of Settlement in Docket No. RP14-247-000, as approved by <span style="font-size: 12pt; line-height: 107%">FERC's order</span> issued on June 26, 2015.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-200_46936_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 278 Line No.: 2 Column: a </span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">ARO cost of service allowance established pursuant to Article IV, Section C.4.d. of the Stipulation and Agreement of Settlement in Docket No. RP19-352-000, as approved by <span style="font-size: 12pt; line-height: 107%">FERC's order</span> issued on October 17, 2019.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-267_46938_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 102 Line No.: 3 Column: d</b></span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Energy Transfer Interstate Holdings, LLC has a 99% limited partner interest in Panhandle Eastern Pipe Line, LP and a 100% membership interest in Southern Union Panhandle LLC. Southern Union Panhandle LLC has a 1% general partner interest in Panhandle Eastern Pipe Line Company, LP.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-379_47017_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 230a Line No.: 5 Column: b</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Rights-of-Way</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-641_47024_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 313 Line No.: 1 Column: c</span></span></h2><p><span style="font-size: 12pt; line-height: 107%; font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">The volumes in column (c) include discounted reservation contract quantities and commodity transactions.</span></span><span style="font-size: 12pt; line-height: 107%"> </span></p></div></link:footnote>
        <link:footnote xlink:label="ft-783_47071_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 118 Line No.: 14 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Sea Robin Pipeline Company, LLC, as a limited liability company, records member's equity in Other Paid-In Capital.</span></span></p><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Statement of Retained Earnings (unaudited).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-807_47072_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1389px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-812_47073_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1389px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-1148_47419_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1404px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-1188_47128_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 278 Line No.: 3 Column: a</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Pursuant to Section 22 of the General Terms and Conditions of Sea Robin's FERC Gas Tariff, Third Revised Volume No. 1, Docket No. RP24-275-000, as approved by <span style="font-size: 12pt; line-height: 107%">FERC's order </span> issued on January 23, 2024, and Docket No. RP25-318-000, as approved by <span style="font-size: 12pt; line-height: 107%">FERC's order </span> issued on January 23, 2025.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1189_47129_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 278 Line No.: 4 Column: a</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Pursuant to Section 22.3 (c) of the General Terms and Conditions of Sea Robin's FERC Gas Tariff, Third Revised Volume No. 1, Docket No. RP24-275-000, as approved by <span style="font-size: 12pt; line-height: 107%">FERC's order </span> issued on January 23, 2024, and Docket No. RP25-318-000, as approved by <span style="font-size: 12pt; line-height: 107%">FERC's order </span> issued on January 23, 2025.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1228_47326_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 336 Line No.: 10 Column: b</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">General plant is depreciated on a straight line basis per assigned FERC rates.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1231_47135_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 338 Line No.: 8 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The applied depreciation rates for General Plant range from 4.00% to 20.00%. All rates were approved in Docket No. RP23-241-000 and RP23-910-000 (consolidated).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1232_47132_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 338 Line No.: 2 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">East Area Offshore Gathering Plant has a depreciation rate of 0.68%. West Area Offshore Gathering Plant is depreciated at 0.33%. In addition, East and West offshore depreciable plant without associated AROs is subject to a negative salvage rate of 0.43% and 1.21%, respectively. All rates were approved in Docket No. RP23-241-000 and RP23-910-000 (consolidated).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1233_47133_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 338 Line No.: 6 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">East Area Offshore Transmission Plant is depreciated at 0.39%. West Area Offshore Transmission Plant is depreciated at 0.24%. In addition, East and West Area Offshore Transmission Plant are also subject to a negative salvage of 0.14% and 1.98%, respectively. All rates were approved in Docket No. RP23-241-000 and RP23-910-000 (consolidated).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1234_47134_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 338 Line No.: 7 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">West Area Onshore Transmission Plant is depreciated at 1.2% and subject to a negative salvage rate of 1.66%. Rate was approved in Docket No. RP23-241-000 and RP23-910-000 (consolidated).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1236_47131_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 338 Line No.: 2 Column: b</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The depreciation plant basis reflects a balance as of 12/31/2025. This footnote also applies to lines 6, 7, 8 and 9.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1240_47136_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 338 Line No.: 9 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The applied depreciation rates for Intangibles range from 2.02% to 16.67%. All rates were approved in Docket No. RP23-241-000 and RP23-910-000 (consolidated).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1424_47160_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Name of System: Sea Robin East Area</span></span></h2><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 520 Line No.: 20 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">For the purpose of the Annual Charge Adjustment ("ACA") calculation, the throughput volume is 12,329,163 Dth as represented on line 20. No additional volumes are needed to calculate the total volumes eligible for the ACA surcharge.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1433_47159_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1404px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-1451_47161_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Name of System: Sea Robin West Area</span></span></h2><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 520 Line No.: 20 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">For the purpose of the Annual Charge Adjustment ("ACA") calculation, the throughput volume is 2,984,563 Dth as represented on line 20. No additional volumes are needed to calculate the total volumes eligible for the ACA surcharge.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1524_47207_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 521 Line No.: 7 Column: f</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The value of this gas is based on the current month spot rate. This footnote also applies to columns (g) and (h).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1640_47206_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 521 Line No.: 7 Column: e</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The allocation is derived from the throughput volume of each contract within the billing system. A path to path calculation of the rate utilized within the contract billing is determined and a percentage for recourse rate, discount rate and negotiated rate is derived based on the rate charged within the paths. This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2108_47280_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 514 Line No.: 1 Column: e</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Sea Robin owned 530.6 miles, Eagle Rock Pipeline owned 13.2 miles, Exxon Mobil owned 0.5 miles and Apache Corporation owned 2.4 miles.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2111_47303_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 514 Line No.: 1 Column: a</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Includes Gathering 438.7 miles.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2194_47302_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 514 Line No.: 3 Column: e</span></span></span></h2><p style="margin-top: 0; margin-right: 0; margin-bottom: 8pt; line-height: 107%; font-size: 12pt; font-family: Arial, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The 13.1-mile reduction in the Gulf of America consists of: (1) 10.5 miles gathering line retired at book cost of $3,953,887, as reported in Docket No. CP23-249-000; and (2) 2.6 miles retired at book cost of $1,170,437, per Bureau of Safety and Environmental Enforcement Submittal IDs 16699514 and 16701689.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2245_47324_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 218 Line No.: 5 Column: f</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Pursuant to <span style="color: rgba(0, 0, 0, 1); font-family: sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none">a black-box settlement </span>from Sea Robin's last rate case proceeding, Docket No. RP23-241-000 and RP23-910-000 (consolidated), as approved by FERC's order issued on February 21, 2024, a 12% equity cost rate is used in calculating AFUDC.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2397_47373_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><table cellpadding="0" cellspacing="0" width="1036" class="e-rte-paste-table" style="color: rgba(0, 0, 0, 1); margin-bottom: 10px; font-family: Roboto"><tr style="height: 24.0104px"><td colspan="2" height="21" width="1036" class="" style="padding: 0; color: rgba(0, 0, 0, 1); font-size: 11pt; font-weight: 400; font-style: normal; text-decoration: none; font-family: Calibri, sans-serif; vertical-align: bottom; white-space: nowrap; height: 15.75pt; width: 778pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 358 Line No.: 2 Column: a</b></span></span></td></tr></table><table cellpadding="0" cellspacing="0" width="948" style="width: 712pt" class="e-rte-paste-table"> <tr style="height: 15.75pt">  <td height="21" colspan="3" width="558" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt; width: 419pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Allocations Basis:</span></span></td>  <td width="107" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; width: 80pt"><br/></td>  <td width="109" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; width: 82pt"><br/></td>  <td width="174" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal