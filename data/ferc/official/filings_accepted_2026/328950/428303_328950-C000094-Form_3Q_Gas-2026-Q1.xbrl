    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF776CDB4343AB34EEBC8DC98E2753156" xlink:to="HHF3008D6914EF3AB83125B492E8706758" order="1" />
