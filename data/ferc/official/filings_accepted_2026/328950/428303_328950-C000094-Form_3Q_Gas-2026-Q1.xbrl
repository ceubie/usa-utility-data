          <tbody>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td class="xl281" style="height: 15.0pt; width: 464pt;" width="619" height="20">Plant thermal reduction</td>
              <td class="xl282" style="width: 74pt;" width="98">0</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td class="xl281" style="height: 15.0pt;" height="20">3rd Party Transport Fuel Activity</td>
              <td class="xl282">190,149</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
