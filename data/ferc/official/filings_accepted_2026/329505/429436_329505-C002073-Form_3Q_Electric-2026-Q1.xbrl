    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHDBC8A9DD42F2579EB6BBD05FFFFFBEF0" xlink:to="HH8B03D9272F5B29E0E04B60D59BFE2EE7" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE8008B8B43E527AF6906514C6060D7CF" xlink:label="HHE8008B8B43E527AF6906514C6060D7CF" />
    <link:footnote xlink:type="resource" xlink:label="HH28AD66FCBFCF3068B72A8E0AD0ECB060" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #333333; font-family: Roboto;">Accumulated Deferred Income Taxes - Other (Acct 283) is included (netted) with Accumulated Deferred Income Taxes (Acct 190).</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE8008B8B43E527AF6906514C6060D7CF" xlink:to="HH28AD66FCBFCF3068B72A8E0AD0ECB060" order="1" />
  </link:footnoteLink>
