  <ferc:DeferredDebits id="HH3B4A48DD45833AB40FF1F930AE2BB6BE" contextRef="HH7B7758B43D530B049277B7E198A48CAD" decimals="0" unitRef="HHferc_us_Currency">2500944</ferc:DeferredDebits>
  <ferc:MiscellaneousCurrentAndAccruedAssets id="HH948461A1F1E862D5AFD578188F113D93" contextRef="HH7B7758B43D530B049277B7E198A48CAD" decimals="0" unitRef="HHferc_us_Currency">34549</ferc:MiscellaneousCurrentAndAccruedAssets>
  <ferc:NuclearFuelNet id="HH98A675B04282799FD36221C1D5BE7054" contextRef="HH7B7758B43D530B049277B7E198A48CAD" decimals="0" unitRef="HHferc_us_Currency">0</ferc:NuclearFuelNet>
  <ferc:OtherAccountsReceivable id="HHA4232EE5A6BA0D1A0FD3BCF1DC5FCCC4" contextRef="HH7B7758B43D530B049277B7E198A48CAD" decimals="0" unitRef="HHferc_us_Currency">0</ferc:OtherAccountsReceivable>
  <ferc:OtherPropertyAndInvestments id="HHA737E9FCF4E2B6B22C0001FF1ABE2A12" contextRef="HH7B7758B43D530B049277B7E198A48CAD" decimals="0" unitRef="HHferc_us_Currency">0</ferc:OtherPropertyAndInvestments>
  <ferc:OtherRegulatoryAssets id="HH95EA6956AB971A6F696EF418460182EB" contextRef="HH7B7758B43D530B049277B7E198A48CAD" decimals="0" unitRef="HHferc_us_Currency">371078</ferc:OtherRegulatoryAssets>
