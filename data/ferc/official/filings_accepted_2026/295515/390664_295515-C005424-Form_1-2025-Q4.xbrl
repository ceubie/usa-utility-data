  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">NextEra Energy Transmission MidAtlantic, LLC was formed in Delaware on 7-18-2015 and domesticated as an LLC in Illinois on 9-14-2018. On 1-22-2019, NextEra Energy Transmission MidAtlantic, LLC converted to an Illinois corporation (NextEra Energy Transmission MidAtlantic,Inc). On 12-18-2019, NextEra Energy Transmission MidAtlantic, Inc. domesticated in Indiana and changed its name to NextEra Energy Transmission MidAtlantic Indiana, Inc. On 12-11-2023, NextEra Energy Transmission MidAtlantic Indiana, Inc. changed its name to NextEra Energy Transmission MidAtlantic, Inc.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
            <td style="width:98.900%"/>
            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Salary for this officer is zero or less than threshold based on time allocated to respondent.</span>
            </td>
          </tr>
        </table>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-3" id="fn-3" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <span xmlns="http://www.w3.org/1999/xhtml" style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Salary for this officer is zero or less than threshold based on time allocated to respondent.</span>
    </link:footnote>
