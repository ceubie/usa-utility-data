ttom"&gt; 						&lt;p style="margin-top: 0; margin-left: 1.25pt; margin-bottom: 0; text-indent: -1.25pt; text-align: center"&gt; 							&lt;span style="font-weight: bold"&gt;2030&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 21.6pt"&gt; 					&lt;td style="width: 31.84%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 2pt; text-align: left"&gt; 							&lt;span&gt;Minimum principal payments&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.86%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 2pt; text-align: center"&gt; 							&lt;span&gt;$&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 10.84%; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 1.5pt double rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 1.25pt; margin-bottom: 2pt; text-indent: -1.25pt; text-align: right"&gt; 							&lt;span&gt;1,500&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.54%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 1.25pt; margin-bottom: 2pt; text-indent: -1.25pt; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 10.84%; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 1.5pt double rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 1.25pt; margin-bottom: 2pt; text-indent: -1.25pt; text-align: right"&gt; 							&lt;span&gt;1,500&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.54%; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="