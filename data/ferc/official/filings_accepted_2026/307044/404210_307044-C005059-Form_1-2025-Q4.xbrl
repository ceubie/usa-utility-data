    <ferc:MiscellaneousDeferredDebitsExcludingMiscellaneousWorkInProgress id="f-1798" contextRef="c-339" unitRef="u-02" decimals="0">20000</ferc:MiscellaneousDeferredDebitsExcludingMiscellaneousWorkInProgress>
