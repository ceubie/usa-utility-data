m"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;5,512&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 70.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;11,125&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="vertical-align: top"&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.95pt"&gt; 					&lt;td style="width: 1.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="7" style="width: 272.35pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;Transfers to property and equipment in service&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 67.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;(78)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 70.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;(3,156)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="vertical-align: top"&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 23.35pt"&gt; 					&lt;td style="width: 1.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 209.15pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;Construction in progress&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;$&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 67.85pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 2.25pt double rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;14,044&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 70.2pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 2.25pt double rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;8,610&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 9.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 0"&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 207.3pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 18pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 78.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 13.5pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 81pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 20.35pt"&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;(5)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Contracts and Commitments&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(a)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Engineering, Procurement and Construction Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;In May&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2016, the Company and an unaffiliated third party entered into an agreement for engineering, procurement and construction (EPC)for the submarine cable supply and installation plus payment of costs related to design and construction of transmission structures. The initial work under this contract was complete in 2021.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;In June 2021, the Company experienced a failure of one of the submarine cables. The Company and its contractors were able to respond and restore service utilizing an installed redundant cable as planned for in the original design of the transmission line. This limited the outage to approximately one week. The Company worked with the unaffiliated third party to perform a failure investigation and determine the extent of the warranty coverage. The unaffiliated third party was responsible for performing replacement of the failed cable, and the Company was responsible for internal and contracted services associated with creating a safe work environment as well as returning the cable to its normal operating configuration. The unaffiliated third party also performed a failure investigation with a report on remedial corrective actions. This work was substantially completed during 2022 with trailing costs incurred in 2023. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;At the end of 2023, the Company issued a change order against the original project scope to cover the cost of improvements to the Delaware transition structure to improve the reliability of the cable system to prevent a reoccurrence of the 2021 failure. As of December 31, 2024, the work was completed. These costs are included in Property and equipment on the accompanying balance sheet.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(b)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Silver Run Upgrade Project&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;On December 5, 2022, as part of the State of New Jersey's Offshore Wind Transmission Competitive Solicitation, the Company was selected by the NJBPU to increase the capacity of its system. To accommodate the planned increase in load due to future renewable projects in New Jersey, the Company will be adding additional submarine cables and upgrading some equipment at its existing substation (Upgrade Project). The Upgrade Project has an estimated cost in excess of $100 million with a required in-service date by 2029. The Company began project execution in 2023 and entered into an engineering and construction agreement in 2024.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;In 2024, the Company and an unaffiliated third party entered into an agreement for engineering, procurement and construction for the subsurface Delaware river crossing for the Upgrade Project. In April 2025, the Company exercised the contract option to elect a 2027 install date. The unaffiliated third party agreed to perform all necessary work and services required for the design, engineering, permitting, fabrication, procurement, transportation, construction, assembly, installation, testing and completion of the project. The unaffiliated third party is solely responsible for all construction means, methods, techniques, sequences, procedures, coordination and control of labor, safety and security programs, training, commissioning and startup, in connection with the performance of the work. In December 2024, the Company paid a contract execution payment which is included in Property and equipment on the accompanying balance sheet. During 2025, the Company incurred additional costs related to the project, which are also included in Property and equipment on the accompanying balance sheet.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;In 2024, the Company and a separate unaffiliated third party entered into a reimbursement agreement for the potential expansion of an existing easement and the review of such plans. Under the agreement, the Company will pay for actual costs incurred for review of the expansion plan and additional reimbursement for a new or amended easement. The Company expects the review to be completed in 2026 with a potential easement executed in 2026.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(c)&lt;/span&gt;&lt;span style="width: 15.14pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Land Rights&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The Company has land rights that were obtained through various easements and licenses with governmental agencies and private land owners. Most of these land rights required a one&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span&gt;time upfront payment, are perpetual in nature, and were recorded to Property and equipment, net as incurred. Several easements or land agreements require annual payments as noted below.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The Company has a subaqueous lands agreement with the State of Delaware for the in&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span&gt;river structures and submarine power cables associated with the Project. This agreement requires annual payments and will continue for a ten&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span&gt;year period or so long as the conditions in the agreement are adhered to, whichever is the shorter in time. The Company can apply for a renewal of the agreement at the end of the ten&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span&gt;year period. The Company will owe $122&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;thousand per year for a total of $1.2&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;million over the initial ten&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span&gt;year term.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 10pt; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;The Company has a license of lands with the State of New Jersey for right to use a 42,541 square foot area of land across the Delaware River for public utility structures. The license is in effect for a period of twenty&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span&gt;four years effective July&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2018. The Company can apply for a license renewal or remove all structures at the expiration date. The Company will owe $5&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;thousand per year (adjusted for annual inflation) over the twenty&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span&gt;four year license period.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The Company has one perpetual easement for a 150 foot wide strip of land in Delaware used for installation of electric transmission facilities that requires ongoing annual payments. This easement may be terminated by the Company upon written notice to the grantor or by the Company's abandonment of the easement. The Company agreed to pay $175&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;thousand per year (adjusted for annual inflation) until the easement is terminated.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;The Company has various long term contractual and commercial commitments of which the significant contracts have been previously discussed in this note and note 6, which further discusses lease agreements.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The following table summarizes the obligations with respect to the significant contractual and commercial commitments, including lease agreements, as of December&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31, 2025 (in&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;thousands):&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 473.4pt; margin-left: 21.6pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr style="height: 7.35pt"&gt; 					&lt;td style="width: 116.95pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 2pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 							&lt;span style="font-weight: bold"&gt;Contractual obligations&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6.9pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 