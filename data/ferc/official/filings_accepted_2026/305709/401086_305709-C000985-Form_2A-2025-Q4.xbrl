&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;555&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 8.9pt; border-top: 4.5pt solid #000000; border-left: 0.75pt solid #000000; border-bottom: 4.5pt solid #000000; padding-right: 5.9pt; padding-left: 4.72pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;$&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 119.45pt; border-top: 4.5pt solid #000000; border-right: 0.75pt solid #000000; border-bottom: 4.5pt solid #000000; padding-right: 4.72pt; padding-left: 5.9pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;563&lt;/font&gt;&lt;/p&gt;
