&lt;td style="width: 143.25pt; border-top: 0.75pt dashed #bbbbbb; border-right: 1pt solid #000000; border-left: 0.75pt dashed #bbbbbb; border-bottom: 1pt solid #000000; padding-right: 2.9pt; padding-left: 3.92pt; vertical-align: bottom; -aw-border-left: 0.75pt dash-large-gap; -aw-border-top: 0.75pt dash-large-gap;" colspan="2"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt; &amp;#160;&lt;/font&gt;&lt;/p&gt;
