&lt;/td&gt;
&lt;td style="width: 8.9pt; border-top: 1pt solid #000000; border-left: 0.75pt solid #000000; border-bottom: 4.5pt solid #000000; padding-right: 5.9pt; padding-left: 4.72pt; vertical-align: bottom;"&gt;
