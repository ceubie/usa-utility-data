      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table class="MsoTableGrid" style="border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes;">
              <xhtml:td style="width: 485.75pt; border: solid windowtext 1.0pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="648">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Allowance for other funds used during construction</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 27.0pt; border-top: solid windowtext 1.0pt; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: none; mso-border-left-alt: solid windowtext .5pt; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="36">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 134.95pt; border: solid windowtext 1.0pt; border-left: none; mso-border-top-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="180">
                <xhtml:p class="MsoNormal" style="text-align: right;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">(4,248)</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 1;">
              <xhtml:td style="width: 485.75pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="648">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Allowance for borrowed funds used during construction</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 27.0pt; border: none; border-bottom: solid windowtext 3.0pt; mso-border-top-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="36">
                <xhtml:p class="MsoNormal">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">
                  </xhtml:span>
