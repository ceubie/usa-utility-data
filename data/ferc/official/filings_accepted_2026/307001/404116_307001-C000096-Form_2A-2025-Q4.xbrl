  <ferc:GasAccountGasLossesAndGasUnaccountedForGasAccount id="f-465" contextRef="c-106" decimals="0" unitRef="u-3">1776</ferc:GasAccountGasLossesAndGasUnaccountedForGasAccount>
  <ferc:VendorName id="f-466" contextRef="c-1">The Workiva Platform</ferc:VendorName>
  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">Allowance for Funds Used During Construction, or AFUDC, is calculated in compliance with the Federal Energy Commission's "Ordering Issuing Certificates and Declatory Order" issued on June 27, 1997 in Docket NO. CP97-300-000, 79 FERC 61, 391 at 62672</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:8pt;font-weight:400;line-height:120%">Pursuant to Section 7.21.4.A of it's Tariff, Dauphin Island shall maintain a Storm Surcharge Deferred Cost Account</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-3" id="fn-3" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The Partnership purchases gas from producers on behalf of Mobile Bay Processing Partners, or MBPP, and sells that gas to MBPP to meet volume requirements at the MBPP processing plant. The Partnership acts as an agent for MBPP and does not collect a fee for these transactions. Accordingly, purchases and sales related to these transactions are reported on a net basis in the statements of operations. The Partnership had no purchases or sales related to these transactions as of December 31, 2024.</span>
      </div>
    </link:footnote>
    <link:loc xlink:type="locator" xlink:label="f-231" xlink:href="#f-231"/>
    <link:loc xlink:type="locator" xlink:label="f-232" xlink:href="#f-232"/>
    <link:loc xlink:type="locator" xlink:label="f-351" xlink:href="#f-351"/>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-231" xlink:to="fn-1" order="1"/>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-232" xlink:to="fn-2" order="2"/>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-351" xlink:to="fn-3" order="3"/>
  </link:footnoteLink>
