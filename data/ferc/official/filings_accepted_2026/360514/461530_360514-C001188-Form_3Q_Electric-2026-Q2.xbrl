  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p class="MsoBodyTextIndent" style="margin-left: 45.0pt; text-align: justify; text-indent: -27.0pt; line-height: 200%; mso-list: l0 level1 lfo1;"&gt;&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt;&amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &lt;/span&gt;&lt;!--[endif]--&gt;&lt;strong&gt;&lt;u&gt;Director Changes&lt;/u&gt;:&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoBodyTextIndent" style="margin-left: 45.0pt; text-align: justify; text-indent: 0in; line-height: 200%; mso-list: l0 level2 lfo1;"&gt;&lt;!-- [if !supportLists]--&gt;a.&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt;&amp;#160; &lt;/span&gt;Chris Nagel replaced John Brown on April 9, 2026.&lt;/p&gt;
&lt;p class="MsoBodyTextIndent" style="margin-left: 45.0pt; text-align: justify; text-indent: 0in; line-height: 200%; mso-list: l0 level2 lfo1;"&gt;&lt;!-- [if !supportLists]--&gt;b.&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt; &amp;#160;&lt;/span&gt;By operation of Wolverine&amp;#8217;s Bylaws, on April 9, 2026, Wolverine&amp;#8217;s Board of Directors was reduced and on that date, Rob Hunter, Brown, Paul Byl, and Terry Launter ceased being directors.&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock id="HHD790CCB2EDB33AB49E3957CEAFD4E7D7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;Not applicable.&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock>
