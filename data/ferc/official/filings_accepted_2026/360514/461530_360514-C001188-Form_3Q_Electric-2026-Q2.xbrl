  <ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock id="HHD2B1DFDF71C7477E84AEA1D4D780024C" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p class="MsoBodyTextIndent" style="margin-left: 45.0pt; text-align: justify; text-indent: -27.0pt; line-height: 200%; tab-stops: 1.0in 4.0in 5.5in;"&gt;&amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160;&lt;u&gt;Municipality (County)&lt;/u&gt;&amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &lt;u&gt;Consideration/Fees&lt;/u&gt;&amp;#160;&amp;#160;&amp;#160; &lt;u&gt;Date of Approval/Adoption&lt;/u&gt;&lt;/p&gt;
&lt;h6 class="MsoListParagraphCxSpFirst" style="margin-left: .75in; mso-add-space: auto; text-align: justify; text-indent: -9.0pt; line-height: normal; mso-list: l1 level1 lfo2;"&gt;&lt;!-- [if !supportLists]--&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';"&gt;a)&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;/span&gt;&lt;!--[endif]--&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;Chester (Eaton)&amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; $308.43&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 4/13/2026&lt;/span&gt;&lt;/h6&gt;
&lt;h6&gt;&amp;#160;&lt;/h6&gt;
&lt;h6 class="MsoListParagraphCxSpLast" style="margin-left: .75in; mso-add-space: auto; text-align: justify; text-indent: -9.0pt; line-height: normal; mso-list: l1 level1 lfo2;"&gt;&lt;!-- [if !supportLists]--&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';"&gt;b)&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;/span&gt;&lt;!--[endif]--&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;Garfield (Grand Traverse)&amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160; $0&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 6/9/2026&lt;/span&gt;&lt;/h6&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock>
  <ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock id="HH9BC0EFBCB25FD35BD21CC5095A000F66" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;Not applicable.&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock>
  <ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock id="HHB507706EE223692FB3CE9DE4D62FC621" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;span style="font-size: 12.6px;"&gt;Not applicable.&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock>
  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="HH1C967D5CB7055C23C61684D3A8ADDA65" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;span style="font-size: 12.6px;"&gt;Not applicable.&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
  <ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock id="HH3753C2D0F64441EEC1CB77241E2239DC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p class="MsoListParagraph" style="margin-left: 45.0pt; mso-add-space: auto; text-align: justify; text-indent: -27.0pt; line-height: normal; mso-list: l0 level1 lfo1;"&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman';"&gt;&lt;span style="font-style: normal; font-variant: normal; font-size-adjust: none; font-language-override: normal; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-stretch: normal; font-size: 7pt; line-height: normal; font-family: 'Times New Roman';"&gt;&amp;#160; &amp;#160; &amp;#160; &amp;#160; &amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;!--[endif]--&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;On April 3, 2026, in Docket No. ER26-2021, Wolverine Power Supply Cooperative, Inc. (&amp;#8220;Wolverine&amp;#8221;) filed an Engineering, Design, and Procurement Agreement between Wolverine and DTE Electric Company (&amp;#8220;DTE&amp;#8221;) related to Wolverine&amp;#8217;s interconnection facilities required for DTE&amp;#8217;s Round Lake (J2668) and Willow Creek (J2669) generator interconnection projects. An effective date of March 6, 2026 was requested. On June 1, 2026, the Federal Energy Regulatory Commission (&amp;#8220;FERC&amp;#8221;) accepted Wolverine&amp;#8217;s filing.&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="margin-left: 45.0pt; text-align: justify; line-height: normal;"&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;On April 3, 2026, in Docket No. ER26-2020, Wolverine Power Supply Cooperative, Inc. (&amp;#8220;Wolverine&amp;#8221;) filed an Engineering, Design, and Procurement Agreement between Wolverine and DTE Electric Company (&amp;#8220;DTE&amp;#8221;) related to Wolverine&amp;#8217;s interconnection facilities required for DTE&amp;#8217;s J2875 generator interconnection projects. An effective date of March 6, 2026 was requested. On June 1, 2026, the Federal Energy Regulatory Commission (&amp;#8220;FERC&amp;#8221;) accepted Wolverine&amp;#8217;s filing.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;#160;&lt;/p&gt;
&lt;p class="MsoNormal" style="margin-left: 45.0pt; text-align: justify; line-height: normal;"&gt;&lt;span style="font-size: 12.0pt; font-family: 'Times New Roman',serif;"&gt;On June 25, 2026, in Docket No. AC-26-90, Michigan Electric Transmission Company LLC (&amp;#8220;METC&amp;#8221;) submitted a journal entry to reflect the acquisition of Wolverine Power Supply Cooperative&amp;#8217;s, Inc. (&amp;#8220;Wolverine&amp;#8221;) ownership share of the Tittabawassee South Line at the remaining net book value of six hundred and fifty-five dollars ($655.00) pursuant to a Bill of Sale and Instrument of Assignment Agreement dated April 2, 2026.&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock>
  <ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock id="HH2FB9527C1D4BB25D79F1C0C76F5BC95D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;Not applicable.&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock>
