  <ferc:OrderNumber id="HH58A923E43AD5DD0C2045719F7C83E498" contextRef="HH7CF927401F4A90759397295196812F58" decimals="0" unitRef="HHferc_us_Pure">4</ferc:OrderNumber>
  <ferc:OrderNumber id="HH4C4B8B2C58DB505660CA3246BD1FD538" contextRef="HH975CFE5A9C7845138F11F787AAE59CCA" decimals="0" unitRef="HHferc_us_Pure">5</ferc:OrderNumber>
  <ferc:OrderNumber id="HH9E3D8FFFCCADD6852FF020AD0125AE4A" contextRef="HHF71B02462783B403F41AF6C8B0126BEC" decimals="0" unitRef="HHferc_us_Pure">6</ferc:OrderNumber>
  <ferc:OrderNumber id="HHB964327DA67C841E9AAFC4B3D56A3ECC" contextRef="HH43419B8BB453154BA91F1D1E5C1D0B9C" decimals="0" unitRef="HHferc_us_Pure">2</ferc:OrderNumber>
  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:footnote xlink:type="resource" xlink:label="HH9626BB530B7AC4A09E711E607E7F05DA" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:98%">The July 18, 2018 Commission order in Docket No. PL17-1-001 provided guidance regarding the Commission&#8217;s income tax allowance policy for pipelines owned by master limited partnerships and the related deferred tax balances, including balances in Account 190 (Accumulated Deferred Taxes). The July 18 Order explained that MLP pipelines could elect to eliminate certain deferred tax balances. Saltville&#8217;s parent company, Spectra Energy Partners, LP, has a pending request with the FERC Chief Accountant to eliminate amounts recorded in Account 190, including amounts in Account 190 for Saltville. Certain amounts in Account 190 may be excluded in the development of jurisdictional recourse rates in the future.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH804E27F811FA12ABB210B316CDF7FC1C" xlink:to="HH9626BB530B7AC4A09E711E607E7F05DA" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH804E27F811FA12ABB210B316CDF7FC1C" xlink:label="HH804E27F811FA12ABB210B316CDF7FC1C" />
    <link:footnote xlink:type="resource" xlink:label="HHA5B6F7F4CC59C86409259734C39D8EC7" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
