&lt;tr&gt;
&lt;td style="padding: 1.75pt 1.25pt; vertical-align: bottom;" colspan="3"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;Contract Balances&lt;/span&gt;&lt;/p&gt;
