&lt;p style="margin-top: 0pt; margin-bottom: 8pt; text-align: center; line-height: 115%; font-size: 12pt;"&gt;&lt;span style="font-family: Arial;"&gt;123.4&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
