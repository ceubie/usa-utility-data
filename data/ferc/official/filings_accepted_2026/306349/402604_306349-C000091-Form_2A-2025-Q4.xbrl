&lt;/td&gt;
&lt;td style="padding: 1.75pt 1.25pt; vertical-align: bottom;" colspan="3"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 12pt;"&gt;&lt;span style="font-family: Arial;"&gt;$1.&lt;/span&gt;&lt;span style="font-family: Arial;"&gt;0&lt;/span&gt;&lt;/p&gt;
