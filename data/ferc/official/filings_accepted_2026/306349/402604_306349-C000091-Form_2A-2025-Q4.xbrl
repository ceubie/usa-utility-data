    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHEC3CA7ED5418C056C0F1915EC30268E8" xlink:to="HH530D7982096466C68D898DE33B632D1F" order="1" />
