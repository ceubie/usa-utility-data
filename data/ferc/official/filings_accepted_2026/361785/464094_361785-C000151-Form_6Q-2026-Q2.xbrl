  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH11D37003BAE5340EAEFF314895E72CFF" xlink:label="HH11D37003BAE5340EAEFF314895E72CFF" />
    <link:footnote xlink:type="resource" xlink:label="HHFBA147896346AEA3D4E64ABE7D871812" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-size: 11.0pt; font-family: 'Aptos',sans-serif; mso-fareast-font-family: Aptos; mso-fareast-theme-font: minor-latin; mso-bidi-font-family: Aptos; mso-ligatures: standardcontextual; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">Amount represents acquisition of additional equity interest in Transport 4, LLC.&#160;&#160;</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH11D37003BAE5340EAEFF314895E72CFF" xlink:to="HHFBA147896346AEA3D4E64ABE7D871812" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH20BFE5A824366F730158E20CB47DA8BA" xlink:label="HH20BFE5A824366F730158E20CB47DA8BA" />
    <link:footnote xlink:type="resource" xlink:label="HHBE2E2D61C20DBF648EE6D835CF32FF63" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">
          <span style="font-size: 16.0pt; line-height: 107%; font-family: 'Times New Roman',serif;">In compliance with the Airlines Settlement Agreement in Docket No. OR12-28-000, the following revenues and expenses are associated with the JFK Airport Expansion Project during the six months ended June 30, 2026:</span>
        </p>
        <table style="border-collapse: collapse; width: 99.9944%;" border="1">
          <tbody>
            <tr>
              <td style="width: 80.0875%;">&#160;</td>
              <td style="width: 19.9501%; text-align: center;">
                <strong>Six Months</strong>
              </td>
            </tr>
            <tr>
              <td style="width: 80.0875%;">&#160;</td>
              <td style="width: 19.9501%; text-align: center;">
                <strong>Ended 6/30/2026</strong>
              </td>
            </tr>
            <tr>
              <td style="width: 80.0875%;">
                <span style="font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">Project Surcharge Revenue&#160;</span>
              </td>
              <td style="width: 19.9501%; text-align: center;">
                <span style="font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">$1,261,364&#160;</span>
              </td>
            </tr>
            <tr>
              <td style="width: 80.0875%;">
                <span style="font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">(Less) Project Operating Costs</span>
              </td>
              <td style="width: 19.9501%; text-align: center;">
                <span style="font-family: 'Times New Roman', serif; font-size: 16px; color: #000000;">($399,807)</span>
              </td>
            </tr>
            <tr>
              <td style="width: 80.0875%;">
                <span style="font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">Net Surcharge Revenue Available to Recover Capital and Project Return&#160; &#160;&#160;</span>
              </td>
              <td style="width: 19.9501%; text-align: center;">
                <span style="font-family: 'Times New Roman', serif; font-size: 16px;">$861,557</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
