  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Ohio Valley Midstream LLC is 5.31% owned by Williams Ohio River Valley Corporation and 59.95% owned by Williams Ohio River Valley LLC. William Ohio Valley Corporation and Williams Ohio River Valley LLC are 100% owned by Williams MLP Operating, LLC. Williams MLP Operating, LLC is 100% owned by Williams Field Services Group, LLC, which is 100% owned by The Williams Companies, Inc.</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span>
          <br/>
        </span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">All above listed companies are incorporated in the state of Delaware.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-2" id="fn-2" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">Balances in this account represent receivables from our parent company who received all revenue related cash as part of our Cash Management Agreement. These balances never clear, and thus, long-term.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-3" id="fn-3" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">Balances in this account represent payables to our parent company for all cash payments made on our behalf as part of our cash management agreement. These balances never clear, and thus, long-term.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-4" id="fn-4" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:112%;text-decoration:underline">Account 75: Unappropriated Retained Income</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">We participate in a cash management program; thus, no cash balances are maintained. Contributions to or from affiliates have been classified as a component of members&#8217; equity because the affiliates have not historically required repayment or repaid amounts owed to us. In prior periods these balances were recorded in Other Miscellaneous Other Assets (43) and Other Noncurrent Liabilities (63).</span>
      </div>
    </link:footnote>
    <link:loc xlink:type="locator" xlink:label="f-73" xlink:href="#f-73"/>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-73" xlink:to="fn-4" order="1"/>
  </link:footnoteLink>
</xbrli:xbrl>
