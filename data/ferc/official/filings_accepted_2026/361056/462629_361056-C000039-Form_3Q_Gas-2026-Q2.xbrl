&lt;td style="width: 12.52%; border-top: 0.75pt solid #000000; border-right: 0.75pt solid #000000; border-left: 0.75pt dashed #bbbbbb; border-bottom: 1pt solid #000000; padding-right: 3.02pt; vertical-align: bottom; -aw-border-right: 0.25pt single; -aw-border-top: 0.25pt single;"&gt;
