&lt;td style="width: 12.5%; border-top: 0.75pt solid #000000; border-right: 0.75pt solid #000000; border-left: 0.75pt dashed #bbbbbb; border-bottom: 1pt solid #000000; padding-right: 3.02pt; vertical-align: bottom; -aw-border-right: 0.5pt single; -aw-border-top: 0.5pt single;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;0.2&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 2.5%; border-bottom: 1pt solid #000000; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt; &amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 12.5%; border-top: 0.75pt solid #000000; border-right: 0.75pt solid #000000; border-left: 0.75pt dashed #bbbbbb; border-bottom: 1pt solid #000000; vertical-align: bottom; -aw-border-right: 0.5pt single; -aw-border-top: 0.5pt single;"&gt;
&lt;p style="margin-top: 0pt; margin-right: 3pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;0.1&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 2.52%; border-bottom: 1pt solid #000000; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt; &amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 12.48%; border-top: 0.75pt solid #000000; border-right: 0.75pt solid #000000; border-left: 0.75pt dashed #bbbbbb; border-bottom: 1pt solid #000000; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-right: 4.55pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;0.2&lt;/font&gt;&lt;/p&gt;
