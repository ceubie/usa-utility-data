&lt;div style="font-size: 14px; padding-left: 18pt; text-indent: -18pt;"&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 10pt; line-height: 13.8667px;"&gt;4.&lt;/span&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 10pt; line-height: 13.8667px; padding-left: 9.67pt;"&gt;N/A&lt;/span&gt;&lt;/div&gt;
&lt;div style="font-size: 14px; padding-left: 18pt; text-indent: -18pt;"&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 10pt; line-height: 13.8667px;"&gt;5.&lt;/span&gt;&lt;span style="font-family: Arial, sans-serif; font-size: 10pt; line-height: 13.8667px; padding-left: 9.67pt;"&gt;N/A&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
