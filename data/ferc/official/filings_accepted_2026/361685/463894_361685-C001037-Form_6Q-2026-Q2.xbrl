  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HHFF29C47CF2C152C6477C331557807B78" xlink:label="HHFF29C47CF2C152C6477C331557807B78" />
    <link:footnote xlink:type="resource" xlink:label="HH66EADF2665C3A27FF9E9EAD60F47D6BC" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:136%">Schedule Page: 120 Line No.: 81 Column: b</span>
        </div>
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The amount reported represents a distribution to Partners.</span>
        </div>
        <div>
          <span>
            <br />
          </span>
        </div>
        <div>
          <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%">Heartland Pipeline Company's legal entity structure is that of a partnership. Partnerships do not have capital stock or retained income, but rather include both partner capital and undistributed earnings in the Partner Capital account. Distributions to partners are charged to the partner capital account.</span>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHFF29C47CF2C152C6477C331557807B78" xlink:to="HH66EADF2665C3A27FF9E9EAD60F47D6BC" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>