  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:footnote xlink:type="resource" xlink:label="HHD55B1B6707DE04FB7FBD707E2429E4F5" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">Footnote-1</p>
        <p class="MsoNormal">In compliance with the Airlines Settlement Agreement in Docket No. OR12-28-000, the following revenues and expenses are associated with the JFK Airport Expansion Project during the twelve months ended December 31, 2025:</p>
        <table style="border-collapse: collapse; width: 100%;" border="1">
          <tbody>
            <tr>
              <td style="width: 50.0638%;">&#160;</td>
              <td style="width: 50.0638%;">
                <strong>Twelve Months Ended 12/31/2025</strong>
              </td>
            </tr>
            <tr>
              <td style="width: 50.0638%;">Project Surcharge Revenue</td>
              <td style="width: 50.0638%;">
                <span style="font-size: 12.0pt; line-height: 107%; font-family: 'Times New Roman',serif; mso-fareast-font-family: Calibri; mso-fareast-theme-font: minor-latin; mso-ansi-language: EN-US; mso-fareast-language: EN-US; mso-bidi-language: AR-SA;">
                  <span style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, 'Noto Sans', sans-serif, 'Apple Color Emoji', 'Segoe UI Emoji', 'Segoe UI Symbol', 'Noto Color Emoji'; font-size: 14px;">$2,739,803</span>&#160;</span>
              </td>
            </tr>
            <tr>
              <td style="width: 50.0638%;">(Less) Project Operating Costs</td>
              <td style="width: 50.0638%;">&#160; &#160;<span style="text-decoration: underline;">$785,981</span></td>
            </tr>
            <tr>
              <td style="width: 50.0638%;">Net Surcharge Revenue Available to Recover Capital and Project Return</td>
              <td style="width: 50.0638%;">
                <strong>$1,953,822</strong>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH20BFE5A824366F730158E20CB47DA8BA" xlink:to="HHD55B1B6707DE04FB7FBD707E2429E4F5" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH20BFE5A824366F730158E20CB47DA8BA" xlink:label="HH20BFE5A824366F730158E20CB47DA8BA" />
    <link:footnote xlink:type="resource" xlink:label="HH689CABE5E24485304D1CE0FD72DE09D7" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Footnote-2</p>
        <p class="MsoNormal">Amount includes a billing adjustment of $2.8 million representing remedies authorized pursuant to the Commission&#8217;s remedial authority following the court&#8217;s vacatur of the Rehearing Order, 178 FERC &#182; 61,023 at P2.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH20BFE5A824366F730158E20CB47DA8BA" xlink:to="HH689CABE5E24485304D1CE0FD72DE09D7" order="2" />
