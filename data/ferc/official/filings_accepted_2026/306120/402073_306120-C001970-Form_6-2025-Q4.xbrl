						&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:108%; border-bottom-style:double; border-bottom-width:1.5pt; padding-bottom:1pt; font-size:11pt"&gt;&#xD;
							&lt;span style="font-family:Arial"&gt;$&lt;/span&gt;&lt;span style="width:29.88pt; display:inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;70,860,525&lt;/span&gt;&#xD;
