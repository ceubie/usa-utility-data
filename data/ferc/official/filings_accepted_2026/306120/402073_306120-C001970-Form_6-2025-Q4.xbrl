					&lt;span&gt;N/A&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:140pt; padding-left:4pt; font-family:'Times New Roman'; font-size:12pt"&gt;&#xD;
					&lt;span&gt;N/A&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:140pt; padding-left:4pt; font-family:'Times New Roman'; font-size:12pt"&gt;&#xD;
					&lt;span&gt;N/A&lt;/span&gt;&#xD;
