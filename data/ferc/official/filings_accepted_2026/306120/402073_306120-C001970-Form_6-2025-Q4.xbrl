							&lt;span style="font-family:Arial"&gt;$&lt;/span&gt;&lt;span style="width:29.88pt; display:inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;52,230,988&lt;/span&gt;&#xD;
