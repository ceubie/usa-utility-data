								&lt;span style="font-family:'Times New Roman'"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:74.15pt; padding:0.25pt 5.65pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;-&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:8.8pt; padding:0.25pt 5.65pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'"&gt;&amp;#160;&lt;/span&gt;&#xD;
