  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C012321</ferc:CompanyIdentifier>
  <ferc:ControlOverRespondentTextBlock id="HH603760CF1DD86B04F6DFD4ADAF9B592D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;Mid-Atlantic Offshore Development, LLC is jointly controlled through a 50/50 ownership arrangement between Shell New Energies US, LLC and EDF Renewables North America. Each joint venture member holds a 50 percent membership interest in MAOD and participates in governance consistent with joint control.&lt;/p&gt;&lt;/div&gt;</ferc:ControlOverRespondentTextBlock>
  <ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock id="HHD2B1DFDF71C7477E84AEA1D4D780024C" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock>
  <ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock id="HHB507706EE223692FB3CE9DE4D62FC621" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;Not applicable.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock>
  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="HH1C967D5CB7055C23C61684D3A8ADDA65" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
  <ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock id="HH3753C2D0F64441EEC1CB77241E2239DC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;See Subsequent Events footnote.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock>
  <ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock id="HHDB4E63D65FD21AE5462A8FBA840EA717" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock>
  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="HHEBA1CD44839C108D1DAFD6DE3427BE45" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;Not applicable.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock>
  <ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock id="HH22FBAEA0509E80B804A4341B1670898A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;On September 20, 2024, in docket ER24-2564-000 the Federal Energy Regulatory Commission approved the Company's transmission formula rate template and protocols (together the "Formula Transmission Rate") under section 205 of the Federal Power Act. Concurrently, the Formula Transmission Rate was remanded to settlement proceedings under section 206 of the Federal Power Act. The Company and other parties have entered into a settlement agreement in the Section 206 proceedings filed under FERC Docket ER24-137-000 that provides for adjustments to the Formula Transmission Rate. The settlement agreement is currently pending Commission approval. For purposes of these financial statements, the Company has reflected the effects of the adjusted Formula Rate consistent with the terms of the pending settlement agreement.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock>
  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="HH582A4E700260C05D782FA2D6F218758A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
  <ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock id="HHFB056E8F64ABA7B86B31B31B7725CE20" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;Not applicable.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;Not applicable.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock id="HHD790CCB2EDB33AB49E3957CEAFD4E7D7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;Not applicable.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;p style="margin-top: 11.2pt; margin-left: 35.95pt; margin-bottom: 0pt; text-indent: -17.95pt; line-height: 115%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;1.&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Organization&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;and&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.3pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Basis&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt;Presentation&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 5.15pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Mid-Atlantic Offshore Development LLC ("MAOD" or the "Company") is a limited liability company formed to develop offshore electric transmission facilities intended to interconnect offshore wind generation resources to the onshore transmission grid. MAOD&amp;#8217;s activities during the year ended December 31, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; consisted primarily of project development, permitting, engineering, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;procurement, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;and other &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;pre-&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;construction activities. The Company had no retail customers and did not deliver electricity during the year ended December 31, 2025.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company is subject to the accounting and reporting requirements of the Federal Energy Regulatory Commission ("FERC") and maintains its books and records in accordance with the FERC Uniform System of &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Accounts (&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#8220;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;USoA") prescribed for electric utilities. Accordingly, the accompanying financial statements are prepared in conformity with accounting requirements of FERC, which constitute a comprehensive basis of accounting other than accounting principles generally accepted in the United States of America ("U.S. GAAP").&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The accompanying financial statements are presented on a single-year basis for the year ended December 31, 2025. &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Management has evaluated subsequent events through April 29, 2026, the date the financial statements were available to be issued.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;A subsequent event occurring after December 31, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;2025&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; that requires disclosure is described in Note 8, Subsequent Event and Context.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 3.25pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 35.95pt; margin-bottom: 0pt; text-indent: -17.95pt; line-height: 115%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;2.&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Summary&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Significant&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.7pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Accounting&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt;Policies&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 3pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; color: #404040;"&gt;Use&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.15pt; color: #404040;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; color: #404040;"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.2pt; color: #404040;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.1pt; color: #404040;"&gt;Estimates&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 1.45pt 17.8pt 0pt 18pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Our financial statements are prepared &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;in conformity with FERC accounting requirements&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, which require management to make estimates in measuring assets and liabilities and related revenues and expenses. These estimates involve judgments with respect to, among other things, various future economic factors that are difficult to predict and are beyond our control; therefore, actual results could differ from these estimates. As additional information becomes available, or actual amounts are determined, recorded estimates are revised. Consequently, operating results can be affected by revisions to prior accounting estimates.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.7pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.1pt; color: #404040;"&gt;Utility Plant and &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.1pt; color: #404040;"&gt;Construction Work in Progress&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Utility &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;plant is&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; recorded at original cost, including direct labor, materials, third-party contractor costs, applicable overhead, and allowance for funds used during construction ("AFUDC"). During the year ended December 31, 2025, substantially all capitalized costs were recorded as construction work in progress ("CWIP") as the project had not yet been placed in service.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Expenditures related to preliminary surveying, environmental studies, engineering, permitting, and regulatory approvals that are directly attributable to the construction of utility &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;plants&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; are capitalized in accordance with FERC accounting guidance. Costs determined to be non-recoverable or no longer probable of inclusion in future rates would be expensed or written off in the period such determination is made.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.1pt; color: #404040;"&gt;Allowance for Funds Used During Construction&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0.05pt 17.8pt 0pt 17.95pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;AFUDC&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.3pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;represents&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.3pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;the&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;estimated&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;cost&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.35pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;funds,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;from&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;both&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.35pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;debt&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.3pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;and&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;equity&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;sources,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;used&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;to&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.35pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;finance&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;the&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;construction&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.35pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;of major projects.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt; letter-spacing: -0.3pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;AFUDC is capitalized &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;as a component of CWIP&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt; in accordance with FERC regulations&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;. &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The amounts of AFUDC capitalized were computed in accordance with the Settlement Agreement filed &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;with&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; FERC &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;for &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;approval on February 24, 2026, in Docket No. EL24-137-000. &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt;For the year ended December 31, 2025, we capitalized &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;$2,810,524.82 and $4,909,792.38&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-size: 10pt;"&gt; of AFUDC debt and AFUDC equity, respectively.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.7pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline;"&gt;Impairment&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline;"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.35pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline;"&gt;Long-lived&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.6pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.1pt;"&gt;Assets&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.75pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company evaluates long-lived assets for impairment whenever events or changes in circumstances indicate that the carrying amount of an asset may not be recoverable. Recoverability is assessed based on a comparison of the carrying &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;amount to the sum of the undiscounted expected future cash flows. No impairment indicators were &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;identified,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; and no impairment charges were recorded for the year ended December 31, 2025.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.75pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline;"&gt;Regulated&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.6pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.1pt;"&gt;Operations&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 1.45pt 17.75pt 0pt 18pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;We account for our operations in accordance with Financial Accounting Standards Board Accounting Standards Codification Topic &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;980&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, Regulated Operations, which includes accounting principles for companies whose rates are determined by independent third-party regulators. When setting rates, regulators often make decisions, the economics of which require companies to defer costs or revenues in different periods than may be appropriate for unregulated enterprises. When this situation occurs, a regulated company defers the associated costs as regulatory assets on the balance sheet and records them as expense on the income statement as it collects revenues. Further, regulators can also impose liabilities upon a regulated company for amounts previously collected from customers and for recovery of costs that are expected to be incurred in the future as regulatory liabilities. If we were required to terminate the application of these regulatory provisions to our regulated operations, all such deferred amounts would be recognized in the income statement at that time, which could have a material impact on our financial position, results of operations and cash flows.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.85pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 17.85pt 0pt 18pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;We monitor our regulatory and competitive environment to determine whether the recovery of our regulatory assets continues&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.05pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;to&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;be&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;probable.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;If&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;we were&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;to&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;determine&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;that&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;recovery&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.35pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;these&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;assets&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.05pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;is&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.05pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;no&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;longer&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;probable, we would write&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;off the assets against earnings. &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Management believes that the Company&amp;#8217;s costs incurred to date are probable &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; recovery through future regulatory mechanisms.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 17.85pt 0pt 18pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline;"&gt;Revenue&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.1pt;"&gt;Recognition&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.7pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company did not recognize operating revenues during the year ended December 31, 2025, as the transmission facilities were under development and not yet placed in service.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.7pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline;"&gt;Cash&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.3pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline;"&gt;and&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline;"&gt;Cash&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.1pt;"&gt;Equivalents&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.8pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Cash and cash equivalents consist of highly liquid investments with original maturities of three months or less at the time of purchase. Cash balances are maintained to fund ongoing development activities.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.9pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline;"&gt;Income&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.1pt;"&gt;Taxes&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.8pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company is treated as a pass-through entity for federal and state income tax purposes; accordingly, the Company is not subject to income taxes at the entity level and taxable &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;income,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; or loss is reportable by the Company&amp;#8217;s members. Notwithstanding its pass-through tax status, the Company is permitted, subject to regulatory approval, to include an income tax allowance in its cost of service to reflect the income taxes that would be payable by the Company&amp;#8217;s members on returns attributable to the Company&amp;#8217;s regulated activities.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.8pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.8pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Consistent with accounting guidance applicable to regulated utilities, the Company accounts for income taxes on a stand-alone, regulated-entity basis as if it were a taxable corporation, to the extent of the income tax allowance reflected in rates. Accordingly, the Company records current income tax expense (or benefit) and deferred income taxes associated with temporary differences arising from regulated activities for which an income tax allowance is provided. Deferred income taxes are recorded as accumulated deferred income taxes (&amp;#8220;ADIT&amp;#8221;) and measured using enacted tax rates expected to apply when such temporary differences reverse.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.8pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.8pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The income tax allowance and related tax accounting are limited to taxes associated with regulated operations and do not represent taxes payable by the Company. Any differences between the tax amounts recognized for regulatory accounting purposes and the actual taxes incurred by the Company&amp;#8217;s members are reflected &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;as&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; differences in the members&amp;#8217; capital accounts and are not recorded as liabilities of the Company.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.8pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.8pt; margin-left: 18pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company&amp;#8217;s income tax accounting is intended to comply with applicable normalization requirements&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; including the treatment of accelerated depreciation and related deferred taxes, to the extent such requirements are applicable to the Company&amp;#8217;s regulated operations and income tax allowance.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Consistent with applicable tax regulations and regulatory &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;precedent, normalization is not required for the tax effects associated with equity AFUDC, which are accounted for using flow&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#8209;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;through treatment.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline;"&gt;Financial&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.65pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; text-decoration: underline; letter-spacing: -0.1pt;"&gt;Instruments&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The carrying amounts of cash, accounts payable, and accrued liabilities approximate fair value due to the short-term nature of these instruments.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0.05pt; margin-left: 35.95pt; margin-bottom: 0pt; text-indent: -17.95pt; line-height: 115%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;3.&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt;Utility Plant&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 17.95pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 17.95pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Utility plant consisted entirely of construction work in progress related to the offshore transmission project as of December 31, 2025. The facilities ha&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;ve &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;not been placed in service, and no depreciation expense was recorded during the year.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 17.95pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0.05pt; margin-left: 35.95pt; margin-bottom: 0pt; text-indent: -17.95pt; line-height: 115%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;4.&lt;/span&gt;&lt;span style="font: 7pt 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt;Transaction&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt;with&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.1pt;"&gt;Affiliates&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 1.55pt; margin-bottom: 0pt; line-height: 115%; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Company receives administrative, management, accounting, legal, and other support services from affiliated entities. Costs are allocated based on direct charges consistent with FERC requirements. Amounts due to affiliates are recorded as accounts payable to &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;associated companies.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The table below shows the accounts payable for each affiliate for 2025.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 18pt; margin-bottom: 0pt; text-align: justify; line-height: 115%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
