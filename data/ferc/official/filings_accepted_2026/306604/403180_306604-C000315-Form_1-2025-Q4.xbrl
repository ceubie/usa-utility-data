							&lt;p style="margin-top:2.65pt; margin-bottom:1.5pt; text-align:center; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial; font-weight:bold"&gt;202&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;4&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
					&lt;/tr&gt;&#xD;
					&lt;tr style="height:12.75pt; -aw-height-rule:exactly"&gt;&#xD;
						&lt;td style="width:294.7pt; padding-right:2.65pt; padding-left:2.65pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:1.65pt; margin-left:6pt; margin-bottom:1.5pt; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial"&gt;Cash (Account 131)&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:64.5pt; border-top-style:solid; border-top-width:1pt; padding-right:0.75pt; vertical-align:bottom"&gt;&#xD;
							&lt;p style="margin-top:1.65pt; margin-bottom:1.5pt; text-align:right; page-break-after:avoid; line-height:120%; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Arial"&gt;$&lt;/span&gt;&lt;span style="width:31.44pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:36.45pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;3,03&lt;/span&gt;&lt;span style="font-family:Arial"&gt;9&lt;/span&gt;&lt;span style="width:2.88pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:61.85pt"&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
