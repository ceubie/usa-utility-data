      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH2824318B060F30DDDBE3B43058315BB9" xlink:to="HHA2F9ACDEF4E6DF8A532919A474FF526F" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHB49523B70441C97C65B9F060D0F6053A" xlink:label="HHB49523B70441C97C65B9F060D0F6053A" />
    <link:footnote xlink:type="resource" xlink:label="HHE4ECDD94E50D943338FA90880FB83E77" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>FICA Payroll Tax</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB49523B70441C97C65B9F060D0F6053A" xlink:to="HHE4ECDD94E50D943338FA90880FB83E77" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH81FB9D015D1D33E0FB0F512AC0A5B37C" xlink:label="HH81FB9D015D1D33E0FB0F512AC0A5B37C" />
    <link:footnote xlink:type="resource" xlink:label="HHEA0781ECEC534B32896167752E4502B7" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">
          <strong>
            <span style="font-size: 11.0pt; line-height: 115%;">TE </span>
          </strong>
          <span style="font-size: 11.0pt; line-height: 115%;">is included in the consolidated federal income tax return filed by <strong>FirstEnergy Corp. </strong>and is party to an intercompany income tax allocation agreement among the consolidated group members pursuant to which consolidated tax liability is allocated in accordance with IRC Section 1552 and Treasury Regulations 1.1502-33(d)(3) and 1.1552-1(a)(2).&#160; Each member&#8217;s federal income tax liability is determined as if such member filed a separate tax return and such tax is paid to the parent of the group.&#160; Members generating losses or credits are compensated by the parent in proportion to the amount of such member&#8217;s losses or credits used by other members of the consolidated group.&#160; In accordance with federal tax normalization rules, and for ratemaking purposes only, certain net operating loss carryforwards may be shown on a separate return basis without regard to any utilization by the consolidated income tax group.&#160; &#160;&#160;</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH81FB9D015D1D33E0FB0F512AC0A5B37C" xlink:to="HHEA0781ECEC534B32896167752E4502B7" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>