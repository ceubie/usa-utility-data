			&lt;p style="margin: 0pt; text-align: left; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;&lt;b&gt;12.&lt;/b&gt;&lt;/p&gt;
			&lt;/td&gt;
