&lt;/td&gt;
&lt;td style="width: 74.6525px; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial; padding: 0in 5.4pt; height: 13.2pt;" valign="bottom" nowrap="nowrap" width="44"&gt;
