  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; text-indent:-18pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Tahoma"&gt;1)&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Tahoma"&gt;None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; text-indent:-18pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Tahoma"&gt;2)&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Tahoma"&gt;None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
