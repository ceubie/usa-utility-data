			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; text-indent:-18pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Tahoma"&gt;4)&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Tahoma"&gt;None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; text-indent:-18pt; font-size:10pt"&gt;&#xD;
				&lt;span style="font-family:Tahoma"&gt;5)&lt;/span&gt;&lt;span style="font:7pt 'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Tahoma"&gt;N/A&lt;/span&gt;&#xD;
