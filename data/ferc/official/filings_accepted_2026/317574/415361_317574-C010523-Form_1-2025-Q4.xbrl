  <ferc:ControlOverRespondentTextBlock id="HH603760CF1DD86B04F6DFD4ADAF9B592D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;span style="font-size: 12.6px;"&gt;Control over the respondent is held by Vermont Electric Power Company, Inc. by ownership of 100% of the outstanding common stock, $100 par value.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:ControlOverRespondentTextBlock>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
