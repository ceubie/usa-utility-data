    <link:loc xlink:type="locator" xlink:href="#HHDE51493AC7D5EE350C22CB2EABE6CE96" xlink:label="HHDE51493AC7D5EE350C22CB2EABE6CE96" />
    <link:footnote xlink:type="resource" xlink:label="HH088385649954C0EE12D858F23C86B2BB" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 513pt;" border="0" width="684" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td class="xl109" style="height: 15.0pt; width: 436pt;" width="581" height="20">Heater fuel</td>
              <td class="xl110" style="width: 77pt;" width="103">199</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td class="xl109" style="height: 15.0pt;" height="20">M&amp;R fuel</td>
              <td class="xl110">1,087</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td class="xl109" style="height: 15.0pt;" height="20">O&amp;M gas loss</td>
              <td class="xl111">3,241</td>
            </tr>
            <tr style="mso-height-source: userset; height: 15.0pt;">
              <td class="xl109" style="height: 15.0pt;" height="20">&#160;&#160;&#160;&#160; Total</td>
              <td class="xl110">4,527</td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHDE51493AC7D5EE350C22CB2EABE6CE96" xlink:to="HH088385649954C0EE12D858F23C86B2BB" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0A4335631B6DBE94A8619F6FA50E02BE" xlink:label="HH0A4335631B6DBE94A8619F6FA50E02BE" />
    <link:footnote xlink:type="resource" xlink:label="HHB13DF9D28A3DBB343F6464C98CEE5008" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 436pt;" border="0" width="581" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="height: 37.5pt;">
              <td class="xl110" style="height: 37.5pt; width: 436pt;" width="581" height="50">The valuation of the net excesses or deficiencies which result from shipper supplied gas, as well as the valuation of the dispositions of excesses and the sources of deficiencies are reflected in the annual cashout report and refund plan filed pursuant to our tariff.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0A4335631B6DBE94A8619F6FA50E02BE" xlink:to="HHB13DF9D28A3DBB343F6464C98CEE5008" order="1" />
