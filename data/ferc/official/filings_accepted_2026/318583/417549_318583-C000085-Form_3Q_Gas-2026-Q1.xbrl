            </tr>
            <tr>
              <td style="width: 49.9315%;">Regulatory commission expense (ACA)</td>
              <td style="width: 49.9315%; text-align: right;">83,664</td>
            </tr>
            <tr>
              <td style="width: 49.9315%;">Regulatory liabilities-Rate Case Settlement Amortization</td>
