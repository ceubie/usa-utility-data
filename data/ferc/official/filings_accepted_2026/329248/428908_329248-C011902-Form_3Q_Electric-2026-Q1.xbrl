&lt;p style="margin-top: 0pt; margin-right: 5.05pt; margin-bottom: 0pt; text-align: right; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 7.25pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-right: 38.15pt; margin-bottom: 0pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr style="height: 14.05pt;"&gt;
&lt;td style="width: 312.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-right: 38.15pt; margin-bottom: 0pt; text-align: justify; line-height: 105%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;Derivative assets, ending balance&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 10.75pt; border-bottom-style: solid; border-bottom-width: 1.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-right: 1.45pt; margin-bottom: 0pt; text-align: right; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;$&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 68.1pt; border-bottom-style: solid; border-bottom-width: 1.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-right: 5.05pt; margin-bottom: 0pt; text-align: right; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;5,295,042&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 7.25pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-right: 38.15pt; margin-bottom: 0pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
