&lt;/tbody&gt;
&lt;/table&gt;
&lt;p style="margin-top: 0pt; margin-left: 35.8pt; margin-bottom: 0pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 35.8pt; margin-bottom: 0pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;Going&lt;/span&gt;&lt;span style="font-family: Arial; font-weight: bold; letter-spacing: -0.3pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial; font-weight: bold; letter-spacing: -0.1pt;"&gt;Concern&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0.5pt 38.15pt 0pt 36pt; text-align: justify; line-height: 104%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;The&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;Company&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;does&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;not&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;believe&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;that&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;any&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;conditions&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;or&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;events&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;exist&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;that&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;raise&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;substantial&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;doubt about the entity&amp;#8217;s ability to continue as a going concern for the next year.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 35.75pt; margin-bottom: 0pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;Concentrations&lt;/span&gt;&lt;span style="font-family: Arial; font-weight: bold; letter-spacing: -0.55pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;of&lt;/span&gt;&lt;span style="font-family: Arial; font-weight: bold; letter-spacing: -0.45pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;Credit&lt;/span&gt;&lt;span style="font-family: Arial; font-weight: bold; letter-spacing: -0.4pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial; font-weight: bold; letter-spacing: -0.2pt;"&gt;Risk&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0.5pt 38.15pt 0pt 36pt; text-align: justify; line-height: 104%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;Certain&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;financial&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.25pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;instruments&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;potentially&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;subject&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;the&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;Company&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;to&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;concentrations&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;of&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;credit&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;risk. These&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.05pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;financial&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;instruments consist&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.05pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;primarily of&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.05pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;cash and&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.05pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;cash&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.05pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;equivalents with one&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.05pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;financial institution in an account, which exceed FDIC limits.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 14pt 38.15pt 14pt 36pt; text-align: justify; font-size: 10pt;"&gt;&lt;span style="font-family: Arial; background-color: #ffffff;"&gt;The Company recognizes a concentration risk due to its exclusive reliance on sales to the California Independent System Operator (CAISO), which accounts for 100% of the Company's revenue. However, given CAISO's role as a central operator of the high-voltage power grid and its established position within California's energy market, the risk associated with this concentration is mitigated by CAISO's stable and critical operational nature.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 38.15pt 0pt 36pt; line-height: 104%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial; background-color: #ffffff;"&gt;While any changes in CAISO's purchasing policies, financial health, or regulatory environment could potentially impact the Company's financial position, results of operations, and cash flows, the essential services provided by CAISO and its regulatory oversight reduce the likelihood of significant adverse effects.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 35.75pt; margin-bottom: 0pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;Derivative&lt;/span&gt;&lt;span style="font-family: Arial; font-weight: bold; letter-spacing: -0.65pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial; font-weight: bold; letter-spacing: -0.1pt;"&gt;Instruments&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0.05pt 38.15pt 0pt 36pt; text-align: justify; line-height: 104%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;The Company uses variable rate debt to finance its construction. The debt obligations expose the Company to variability in interest&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;payments due to&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;changes in interest&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;rates.&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: 2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;To reduce the variability in interest payments, the Company has entered into an interest rate swap agreement to limit the fluctuations in cash flows resulting from the interest rate risk.&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: 2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;These swaps effectively change the variable-rate cash flow exposure on the debt obligations to fixed cash flows.&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: 2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;Under terms of the interest rate swap, the Company receives variable interest rate payments and makes fixed interest payments, thereby creating the equivalent of fixed rate debt for the notional amount.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0.05pt 33.8pt 0pt 35.8pt; text-align: justify; line-height: 104%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 38.15pt 0pt 36pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;The&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;Company accounts for this interest&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;rate&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;swap in accordance&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;with&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;the&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;authoritative guidance&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;for derivative instruments.&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: 2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;The Company has not elected hedge accounting treatment.&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: 2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;Because the Company expects to recover cash flows associated with the interest rate swap under FERC regulations, changes in the fair value of the interest rate swap are reflected in the corresponding regulatory asset or liability account during the applicable period.&lt;/span&gt;&lt;span style="font-family: Arial; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;The changes in the fair value of the interest rate swaps are included in regulatory assets and liabilities on the Balance Sheet. For the three months ended March 31, 2026 and the year ended December 31, 2025, the changes in the fair&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.05pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;value&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;of&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;the interest&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;rate swap included in regulatory assets are $343,936 and $1,718,984, respectively.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 38.15pt 0pt 36pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 38.15pt 0pt 36pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;ol style="margin: 0pt; padding-left: 0pt;" start="4" type="1"&gt;
&lt;li style="margin-left: 20.29pt; widows: 0; orphans: 0; padding-left: 15.46pt; font-family: Arial; font-size: 10pt; font-weight: bold; letter-spacing: -0.05pt;"&gt;&lt;span style="letter-spacing: normal;"&gt;Rates and Regulatory Matters&lt;/span&gt;&lt;/li&gt;
&lt;/ol&gt;
&lt;p style="margin-top: 0pt; margin-left: 36pt; margin-bottom: 0pt; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-left: 35.75pt; margin-bottom: 0pt; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;Rate Case&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 38.15pt 0pt 36pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;On June 29, 2023, the Company filed with FERC its initial general rate case, pursuant to section 205 of the Federal Power Act (&amp;#8220;FPA&amp;#8221;), in Docket No. ER23-2309-000.&lt;/span&gt;&lt;span style="font-family: Arial; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;In an order issued September&lt;/span&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Arial;"&gt;29, 2023, FERC accepted the Company&amp;#8217;s proposed TRR, suspended it for a nominal period, to be effective March 8, 2024, subject to refund, and set the matter for hearing and settlement procedures.&lt;/span&gt;&lt;span style="font-family: Arial; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;In a March 4, 2024, filing, DCRT informed FERC that, due to circumstances beyond its control, it would not achieve commercial operation by the originally anticipated date of March 8, 2024.&lt;/span&gt;&lt;span style="font-family: Arial; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;Subsequently, on June 6, 2024, DCRT notified the Commission that the Ten West Link&amp;#8217;s commercial operation date was expected to be June 12, 2024. On that date, operational control of the Ten West Link was turned over to the CAISO, and DCRT became a CAISO PTO.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-right: 38.15pt; margin-bottom: 0pt; line-height: 104%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-indent: 36pt; text-align: justify; page-break-after: avoid; line-height: 12pt;"&gt;&lt;span style="font-family: Arial; font-size: 10pt; font-weight: bold;"&gt;Transmission Revenue Balancing Account &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0pt 38.15pt 0pt 36pt; text-align: justify; line-height: 104%; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;Section 5.2 of DCRT&amp;#8217;s Transmission Owner Tariff provides for a true-up mechanism in which the CAISO calculates any over&lt;/span&gt;&lt;span style="font-family: Arial;"&gt;&amp;#8209;&lt;/span&gt;&lt;span style="font-family: Arial;"&gt;collection or under-collection of transmission revenues compared to the authorized TRR and either credits or charges the over or under collection transmission revenues in the subsequent year through its TRBA adjustment.&lt;/span&gt;&lt;span style="font-family: Arial; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;The TRBA is effective annually on January 1 based on the principal balance in the TRBA as of September 30 of the prior year and a forecast of transmission revenues for the next year. &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;As of March 31, 2026&lt;/span&gt;&lt;span style="font-family: Arial;"&gt; and December 31, 2025,&lt;/span&gt;&lt;span style="font-family: Arial; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;there were $4,593,523 and $2,325,422 in under/over-collected TRBA balances within regulatory assets/liabilities on the Balance Sheets, respectively.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;ol style="margin: 0pt; padding-left: 0pt;" start="5" type="1"&gt;
&lt;li style="margin-left: 20.29pt; widows: 0; orphans: 0; padding-left: 15.46pt; font-family: Arial; font-size: 10pt; font-weight: bold; letter-spacing: -0.05pt;"&gt;&lt;span style="letter-spacing: normal;"&gt;Regulatory Asset and&lt;/span&gt;&lt;span style="letter-spacing: -0.7pt;"&gt; &lt;/span&gt;&lt;span style="letter-spacing: -0.1pt;"&gt;Liability&lt;/span&gt;&lt;/li&gt;
&lt;/ol&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 1pt 38.15pt 0pt 36pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;The&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;Company&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;recorded&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;adjustments to&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;regulatory&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.15pt;"&gt; liabilities &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;of&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;$343,936 and $1,718,984&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;for the three months ended March 31, 2026 and year ended&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;December&lt;/span&gt;&lt;span style="font-family: Arial;"&gt; 31,&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;2025,&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; respectively, &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;related&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.1pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;to&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: -0.2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;the change in valuation of the interest rate swap (see Note 10).&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: 2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;The Company is able to recover amounts paid to the interest rate swap counterparty under FERC.&lt;/span&gt;&lt;span style="font-family: Arial; letter-spacing: 2pt;"&gt; &lt;/span&gt;&lt;span style="font-family: Arial;"&gt;As of March 31, 2026 and December 31, 2025, $5,295,042 and $4,951,106 are presented as net regulatory liabilities, respectively. &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 1pt 38.15pt 0pt 36pt; text-align: justify; widows: 0; orphans: 0; font-size: 10pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
