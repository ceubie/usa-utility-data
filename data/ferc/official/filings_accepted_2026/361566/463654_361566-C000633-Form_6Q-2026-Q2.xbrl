    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote2" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <xhtml:span style="font-size: 24px;">Pursuant to the Federal Energy Regulatory Commission's Order Denying Petition and Granting Remedies issued November 20, 2025, we have included in Page 300, in revenue </xhtml:span>
          </xhtml:span>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <xhtml:span style="font-size: 24px;">account 210, the amount of $3,035,036 related to correcting invoices from March 1, 2022 to September 30, 2024.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value2" xlink:to="footnote2" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="2" />
  </link:footnoteLink>
</xbrli:xbrl>
