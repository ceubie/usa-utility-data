t;Times New Roman&amp;quot;, serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="90" valign="top" style="width: 67.5pt; border-top: 1pt solid rgba(0, 0, 0, 1); border-right: none; border-bottom: none; border-left: none; padding: 0; height: 11.55pt"&gt;   &lt;p align="center" style="margin: 0 0.25pt 0.0001pt 0.7pt; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center; line-height: 10.55pt"&gt;&lt;b&gt;&lt;span style="font-size: 10pt"&gt;Significant&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="12" valign="top" style="width: 9pt; border-top: 1pt solid rgba(0, 0, 0, 1); border-right: none; border-bottom: none; border-left: none; padding: 0; height: 11.55pt"&gt;   &lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 8pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="96" valign="top" style="width: 1in; border-top: 1pt solid rgba(0, 0, 0, 1); border-right: none; border-bottom: none; border-left: none; padding: 0; height: 11.55pt"&gt;   &lt;p align="center" style="margin: 0 0.2pt 0.0001pt 0.55pt; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center; line-height: 10.55pt"&gt;&lt;b&gt;&lt;span style="font-size: 10pt"&gt;Significant&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="108" colspan="2" rowspan="2" valign="top" style="width: 81pt; border-top: 1pt solid rgba(0, 0, 0, 1); border-right: none; border-bottom: none; border-left: none; padding: 0; height: 11.55pt"&gt;   &lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.3pt"&gt;   &lt;td width="12" valign="top" style="width: 9pt; padding: 0; height: 12.3pt"&gt;   &lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 1pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="90" valign="top" style="width: 67.5pt; padding: 0; height: 12.3pt"&gt;   &lt;p align="center" style="margin: 0.2pt 0.05pt 0.0001pt 0.7pt; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center; line-height: 11.1pt"&gt;&lt;b&gt;&lt;span style="font-size: 10pt"&gt;Other&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="12" valign="top" style="width: 9pt; padding: 0; height: 12.3pt"&gt;   &lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 8pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="96" valign="top" style="width: 1in; padding: 0; height: 12.3pt"&gt;   &lt;p align="center" style="margin: 0.2pt 0 0.0001pt 0.55pt; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center; line-height: 11.1pt"&gt;&lt;b&gt;&lt;span style="font-size: 10pt"&gt;Other&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.3pt"&gt;   &lt;td width="180" valign="top" style="width: 134.65pt; padding: 0; height: 12.3pt"&gt;   &lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 8pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="12" valign="top" style="width: 9pt; padding: 0; height: 12.3pt"&gt;   &lt;p align="center" style="margin: 0.2pt 0 0.0001pt 0.6pt; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center; line-height: 11.1pt"&gt;&lt;b&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="78" valign="top" style="width: 58.5pt; padding: 0; height: 12.3pt"&gt;   &lt;p align="center" style="margin: 0.2pt 0 0.0001pt 0.6pt; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center; line-height: 11.1pt"&gt;&lt;b&gt;&lt;span style="font-size: 10pt"&gt;Quoted&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="12" valign="top" style="width: 9pt; padding: 0; height: 12.3pt"&gt;   &lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 8pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="90" valign="top" style="width: 67.5pt; padding: 0; height: 12.3pt"&gt;   &lt;p align="center" style="margin: 0.2pt 0.2pt 0.0001pt 0.7pt; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center; line-height: 11.1pt"&gt;&lt;b&gt;&lt;span style="font-size: 10pt"&gt;Observable&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="12" valign="top" style="width: 9pt; padding: 0; height: 12.3pt"&gt;   &lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 8pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="96" valign="top" style="width: 1in; padding: 0; height: 12.3pt"&gt;   &lt;p align="center" style="margin: 0.2pt 0.05pt 0.0001pt 0.55pt; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center; line-height: 11.1pt"&gt;&lt;b&gt;&lt;span style="font-size: 10pt"&gt;Unobservable&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="12" valign="top" style="width: 9pt; padding: 0; height: 12.3pt"&gt;   &lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 8pt; font-family: &amp;quot;Times New Roman&amp;quot;, s