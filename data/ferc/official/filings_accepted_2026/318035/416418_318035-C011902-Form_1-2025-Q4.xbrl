&lt;table border="0" cellspacing="0" cellpadding="0" style="margin-left: 0.5in; border: none" class="e-rte-paste-table"&gt;  &lt;tr style="height: 12.95pt"&gt;   &lt;td width="462" valign="top" style="width: 346.5pt; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p style="line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); margin: 0 38.15pt 0 0; text-align: justify"&gt;2026&lt;/p&gt;   &lt;/td&gt;   &lt;td width="24" valign="top" style="width: 17.75pt; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;$&lt;/p&gt;   &lt;/td&gt;   &lt;td width="94" valign="top" style="width: 70.7pt; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;8,241,953&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.95pt"&gt;   &lt;td width="462" valign="top" style="width: 346.5pt; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p style="line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); margin: 0 38.15pt 0 0; text-align: justify"&gt;2027&lt;/p&gt;   &lt;/td&gt;   &lt;td width="24" valign="top" style="width: 17.75pt; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="94" valign="top" style="width: 70.7pt; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;7,823,978&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.1pt"&gt;   &lt;td width="462" valign="top" style="width: 346.5pt; padding: 0 5.4pt; height: 12.1pt"&gt;   &lt;p style="line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); margin: 0 38.15pt 0 0; text-align: justify"&gt;2028&lt;/p&gt;   &lt;/td&gt;   &lt;td width="24" valign="top" style="width: 17.75pt; padding: 0 5.4pt; height: 12.1pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="94" valign="top" style="width: 70.7pt; padding: 0 5.4pt; height: 12.1pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;7,734,891&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.95pt"&gt;   &lt;td width="462" valign="top" style="width: 346.5pt; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p style="line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); margin: 0 38.15pt 0 0; text-align: justify"&gt;2029&lt;/p&gt;   &lt;/td&gt;   &lt;td width="24" valign="top" style="width: 17.75pt; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="94" valign="top" style="width: 70.7pt; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;235,175,732&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.95pt"&gt;   &lt;td width="462" valign="top" style="width: 346.5pt; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p style="line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); margin: 0 38.15pt 0 0; text-align: justify"&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="24" valign="top" style="width: 17.75pt; border-top: none; border-right: none; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="94" valign="top" style="width: 70.7pt; border-top: none; border-right: none; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.95pt"&gt;   &lt;td width="462" valign="top" style="width: 346.5pt; padding: 0 5.4pt; height: 12.95pt" class=""&gt;   &lt;p style="line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); margin: 0 38.15pt 0 0; text-align: justify"&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="24" valign="top" style="width: 17.75pt; border-top: none; border-right: none; border-bottom: 1.5pt solid rgba(0, 0, 0, 1); border-left: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;$&lt;/p&gt;   &lt;/td&gt;   &lt;td width="94" valign="top" style="width: 70.7pt; border-top: none; border-right: none; border-bottom: 1.5pt solid rgba(0, 0, 0, 1); border-left: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; line-height: 12pt; font-size: 10pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; color: rgba(0, 0, 0, 1); text-align: right"&gt;258,976,554&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt; &lt;/table&gt;&lt;p&gt;&lt;br /&gt;&lt;/p&gt;&lt;p&gt;9.  Interconnection&lt;/p&gt;&lt;p&gt;On January 10, 2021, the Company entered into a Large Generator Interconnection Agreement (&amp;quot;LGIA&amp;quot;) (the &amp;quot;First LGIA&amp;quot;) with an interconnection customer (the &amp;quot;First Customer&amp;quot;), whereby the Company became obligated to build a switchyard (the &amp;quot;Switchyard&amp;quot;) that would allow the First Customer (as well as other interconnecting utilities, subject to further investment for additional infrastructure at the Switchyard) to connect its solar facility (the &amp;quot;Solar Facility&amp;quot;), which is still under construction, to the grid through Ten West Link.&lt;/p&gt;&lt;p&gt;The form of this First LGIA and the Company's obligations thereunder are consistent with the Company's role as a CAISO PTO under the CAISO Open Access Transmission Tariff (&amp;quot;Tariff&amp;quot;), specifically the procedures specified for Network Upgrades, as defined in the CAISO Tariff. Under the LGIA, the First Customer is obligated to finance the Network Upgrades associated with the construction of the Switchyard. If the First Customer achieves commercial operation of the Solar Facility, the Company is obligated to reimburse the First Customer for eligible Network Upgrade amounts, together with applicable interest, in accordance with the repayment provisions of the LGIA. Repayment generally commences upon the commercial operation date of the Solar Facility for Network Upgrades placed in service on or before that date, and for any Network Upgrades placed in service after the commercial operation date, repayment commences no later than the later of (i) the first month of the calendar year following the year in which the Network Upgrade is placed into service or (ii) 90 days after the Network Upgrade is placed into service. Repayment is made on a dollar-for-dollar basis over a five-year period unless an alternative payment schedule is mutually agreed. If the Solar Facility does not achieve commercial operation, reimbursement may still be required if the Network Upgrades are later used by that facility or another generating facility, in each case in accordance with the LGIA. The Switchyard relating to the First LGIA was placed into service on January 31, 2025. As of December 31, 2025 and 2024, the First Customer advanced $65,427,000 (the &amp;quot;Gross Advance&amp;quot;) to the Company under the First LGIA. Of that amount, $61,671,000 (the &amp;quot;the Borrowed Amount&amp;quot;) is reimbursable under the First LGIA as costs related to Network Upgrades. The remainder amount (the &amp;quot;Premium&amp;quot;) is capitalized to the advance payable and amortized over the construction process using the effective interest method. Interest Payable represents accrued interest on the reimbursement obligation under the First LGIA.&lt;/p&gt;&lt;p&gt;As of December 31, 2025 and 2024, the advance payable under the First LGIA is as follows:&lt;/p&gt;&lt;table border="1" cellspacing="0" cellpadding="0" width="570" style="margin-left: 0.5in; border: none" class="e-rte-paste-table"&gt;  &lt;tr style="height: 12.95pt"&gt;   &lt;td width="342" valign="top" style="width: 256.5pt; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p style="margin: 0 38.15pt 0.0001pt 0.5in; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: justify"&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="102" valign="top" style="width: 76.5pt; border-top: none; border-right: none; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;b&gt;&lt;span style="font-size: 10pt"&gt;2025&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="24" valign="top" style="width: 0.25in; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center; line-height: 104%"&gt;&lt;b&gt;&lt;span style="font-size: 10pt; line-height: 104%"&gt;&amp;#160;&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="102" valign="top" style="width: 76.5pt; border-top: none; border-right: none; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="center" style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center; line-height: 104%"&gt;&lt;b&gt;&lt;span style="font-size: 10pt; line-height: 104%"&gt;2024&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.95pt"&gt;   &lt;td width="342" valign="top" style="width: 256.5pt; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p style="margin: 0 38.15pt 0 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="102" valign="top" style="width: 76.5pt; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0 5.05pt 0 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="24" valign="top" style="width: 0.25in; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &l