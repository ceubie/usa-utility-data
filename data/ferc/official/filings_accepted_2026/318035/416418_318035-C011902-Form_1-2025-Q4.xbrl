 height: 12.75pt"&gt;   &lt;p align="right" style="margin: 0 5.2pt 0 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right; line-height: 11.1pt"&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="18" valign="top" style="width: 13.5pt; padding: 0; height: 12.75pt"&gt;   &lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="12" valign="top" style="width: 9pt; border: none; padding: 0; height: 12.75pt"&gt;   &lt;p style="margin: 0 0 0 2.05pt; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; line-height: 11.1pt"&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="90" valign="top" style="width: 67.5pt; border: none; padding: 0; height: 12.75pt"&gt;   &lt;p align="right" style="margin: 0 5.05pt 0 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.75pt"&gt;   &lt;td width="354" valign="top" style="width: 265.4pt; padding: 0; height: 12.75pt"&gt;   &lt;p style="margin: 0 0 0 2.5pt; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; line-height: 11.1pt"&gt;&lt;span style="font-size: 10pt"&gt;Principal&lt;/span&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt"&gt;balance&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="12" valign="top" style="width: 9pt; padding: 0; height: 12.75pt"&gt;   &lt;p style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;$&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="90" valign="top" style="width: 67.5pt; padding: 0; height: 12.75pt"&gt;   &lt;p a