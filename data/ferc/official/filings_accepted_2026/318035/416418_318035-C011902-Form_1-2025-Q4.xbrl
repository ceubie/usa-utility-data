/p&gt;   &lt;/td&gt;   &lt;td width="102" valign="top" style="width: 76.5pt; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0 5.05pt 0 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.95pt"&gt;   &lt;td width="342" valign="top" style="width: 256.5pt; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p style="margin: 0 38.15pt 0 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="font-size: 10pt"&gt;Borrowed   Amount&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="102" valign="top" style="width: 76.5pt; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0 5.05pt 0 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="font-size: 10pt"&gt;$&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;6,301,000&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="24" valign="top" style="width: 0.25in; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="font-size: 10pt"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;   &lt;td width="102" valign="top" style="width: 76.5pt; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p align="right" style="margin: 0 5.05pt 0 0; font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span style="font-size: 10pt"&gt;$&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;6,301,000&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;  &lt;/tr&gt;  &lt;tr style="height: 12.95pt"&gt;   &lt;td width="342" valign="top" style="width: 256.5pt; border: none; padding: 0 5.4pt; height: 12.95pt"&gt;   &lt;p style="margin: 0 38.15pt 0 0; font