    <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="f-796" contextRef="c-77">&lt;div&gt;&lt;div style="font-family: Arial, Helvetica, sans-serif; font-size: small"&gt;  &lt;p style="margin: 6.95pt 0 0; font-size: small; font-family: Arial, Helvetica, sans-serif"&gt;&lt;br /&gt;&lt;/p&gt;&lt;/div&gt;&lt;p style="font-family: Arial, Helvetica, sans-serif; font-size: small"&gt;&lt;span style="font-size: small; line-height: 104%; font-family: Arial, Helvetica, sans-serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
    <ferc:Remarks id="f-798" contextRef="c-169">NA</ferc:Remarks>
