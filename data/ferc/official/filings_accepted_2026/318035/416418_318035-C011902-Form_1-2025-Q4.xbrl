    <ferc:ControlOverRespondentTextBlock id="f-295" contextRef="c-77">&lt;div class="Section_1"&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;img src="data:image/png;base64," width="624" height="535" alt="A diagram of a company  AI-generated content may be incorrect." style="" class="e-rte-image e-imginline" /&gt; 			&lt;/p&gt; 		&lt;/div&gt;</ferc:ControlOverRespondentTextBlock>
    <ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription id="f-298" contextRef="c-77" xsi:nil="true" />
    <ferc:GeneralInformationAboutCustodyOfTheCorporateBooksDescription id="f-300" contextRef="c-77">Corporate records are kept at 5 Greenwich Office Park, 2nd Floor, Greenwich, CT 06831.
Additional accounting records are kept by custodian PurEnergy at 115 Solar Street, Suite 100, Syracuse, NY 13204.</ferc:GeneralInformationAboutCustodyOfTheCorporateBooksDescription>
    <ferc:UsesFormulaRates id="f-306" contextRef="c-77">false</ferc:UsesFormulaRates>
    <ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock id="f-311" contextRef="c-77">&lt;p&gt;None.&lt;/p&gt;</ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock>
    <ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock id="f-312" contextRef="c-77">&lt;p&gt;None.&lt;/p&gt;</ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock>
    <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="f-313" contextRef="c-77">&lt;p&gt;None.&lt;/p&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
    <ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock id="f-314" contextRef="c-77">&lt;p&gt;None.&lt;/p&gt;</ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock>
    <ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock id="f-316" contextRef="c-77">&lt;p style="text-align: left"&gt;&lt;span style="color: rgba(0, 0, 0, 1); font-family: sans-serif; font-size: 13.3333px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal"&gt;On January 31, 2025 the Cielo Azul Switchyard was placed into service, and the associated costs were transferred from construction work in progress, FERC account 107, to utility plant in service, FERC account 101.&lt;/span&gt;&lt;br /&gt;&lt;/p&gt;</ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock>
    <ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock id="f-318" contextRef="c-77">&lt;p&gt;None.&lt;/p&gt;</ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock>
    <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="f-319" contextRef="c-77">&lt;p&gt;None.&lt;/p&gt;</ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock>
    <ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock id="f-320" contextRef="c-77">&lt;p&gt;None.&lt;/p&gt;</ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock>
    <ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock id="f-321" contextRef="c-77">&lt;p&gt;&lt;span style="font-size: 11pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;On June 29, 2023, the Company filed with FERC its initial general rate case, pursuant to section 205 of the Federal Power Act (&amp;quot;FPA&amp;quot;), in Docket No. ER23-2309-000.&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;In an order issued September29, 2023, FERC accepted the Company's proposed TRR, suspended it for a nominal period, to be effective March 8, 2024, subject to refund, and set the matter for hearing and settlement procedures.&lt;/span&gt;&lt;br /&gt;&lt;/p&gt;</ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock>
    <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="f-323" contextRef="c-77">&lt;p&gt;None.&lt;/p&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
    <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="f-324" contextRef="c-77">&lt;p&gt;None.&lt;/p&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
