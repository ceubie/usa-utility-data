&lt;/td&gt;
&lt;td style="width: 151.667px; border-top: none; border-left: none; border-bottom: 1pt solid windowtext; border-right: 1pt solid #9cc2e5; padding: 0in 5.4pt; height: 15pt;" valign="top" width="138"&gt;
&lt;p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal;" align="right"&gt;&lt;strong&gt;&lt;span style="font-size: 9pt; font-family: Arial, sans-serif;"&gt;$&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &amp;#160;15,683 &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 157.667px; border-top: none; border-right: none; border-left: none; border-image: initial; border-bottom: 1pt solid windowtext; padding: 0in 5.4pt; height: 15pt;" valign="top" nowrap="nowrap" width="144"&gt;
&lt;p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center"&gt;&lt;strong&gt;&lt;span style="font-size: 9pt; font-family: Arial, sans-serif;"&gt;&amp;#160;$&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; 15,990 &lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
