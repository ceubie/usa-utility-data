    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH64044B967BFBFB8DFD389E28E20824F7" xlink:to="HHD6630ECBBBA0DAE3573293DE7D2FEA78" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH599BE862C5B7A23834B8F2F0E2F13551" xlink:label="HH599BE862C5B7A23834B8F2F0E2F13551" />
    <link:footnote xlink:type="resource" xlink:label="HHDE3F1C5235F3453709F364FFA598F028" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="border-collapse: collapse; width: 100%;" border="1">
          <tbody>
            <tr>
              <td style="width: 49.9544%;">Deemed Contribution of Taxes Accrued</td>
              <td style="width: 49.9544%; text-align: right;">($20,196,310)</td>
