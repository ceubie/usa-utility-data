&lt;p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center"&gt;&lt;span style="font-size: 10.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-font-kerning: 0pt; mso-ligatures: none;"&gt;0.4&lt;/span&gt;&lt;/p&gt;
