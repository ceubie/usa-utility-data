  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH804E27F811FA12ABB210B316CDF7FC1C" xlink:label="HH804E27F811FA12ABB210B316CDF7FC1C" />
    <link:footnote xlink:type="resource" xlink:label="HHE8CD19F2000E91D086B4FB658A4E44AB" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
            <tr>
              <td style="width:1.0%" />
              <td style="width:79.108%" />
              <td style="width:0.1%" />
              <td style="width:1.0%" />
              <td style="width:18.692%" />
              <td style="width:0.1%" />
            </tr>
            <tr>
              <td colspan="6" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
                <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The July 18, 2018 Commission order in Docket No. PL17-1-001 provided guidance regarding the Commission&#8217;s income tax allowance policy for pipelines owned by master limited partnerships and the related deferred tax balances, including balances in Account 190 (Accumulated Deferred Taxes). The July 18 Order explained that MLP pipelines could elect to eliminate certain deferred tax balances. East Tennessee&#8217;s parent company, Spectra Energy Partners, LP, has a pending request with the FERC Chief Accountant to eliminate amounts recorded in Account 190, including amounts in Account 190 for East Tennessee. Certain amounts in Account 190 may be excluded in the development of jurisdictional recourse rates in the future.
                <br /></span>
              </td>
            </tr>
          </table>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH804E27F811FA12ABB210B316CDF7FC1C" xlink:to="HHE8CD19F2000E91D086B4FB658A4E44AB" order="1" />
