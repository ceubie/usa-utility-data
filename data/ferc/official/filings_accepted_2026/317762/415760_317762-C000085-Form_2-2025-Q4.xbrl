&lt;/td&gt;
&lt;td style="width: 1.0%; border: none; border-bottom: solid windowtext 1.0pt; padding: .7pt .7pt 0in 0in; height: 36.8pt;" valign="bottom" width="1%"&gt;
&lt;p class="MsoNormal" style="mso-margin-top-alt: auto; mso-margin-bottom-alt: auto; text-align: right; line-height: normal;" align="right"&gt;&lt;strong&gt;&lt;span style="font-size: 10pt; font-family: Arial, sans-serif;"&gt;&amp;#160;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
