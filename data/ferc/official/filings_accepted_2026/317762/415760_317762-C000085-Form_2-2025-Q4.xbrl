&lt;/td&gt;
&lt;td style="width: 2.7pt; border: none; border-bottom: solid black 1.0pt; mso-border-bottom-alt: solid black .75pt; padding: 0in 5.4pt 0in 5.4pt; height: 18.45pt;" width="4"&gt;
&lt;p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center"&gt;&lt;span style="font-size: 10.0pt; font-family: 'Times New Roman',serif; mso-fareast-font-family: 'Times New Roman'; mso-font-kerning: 0pt; mso-ligatures: none;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
