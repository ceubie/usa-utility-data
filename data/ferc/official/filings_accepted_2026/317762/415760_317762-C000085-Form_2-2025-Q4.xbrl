&lt;p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;"&gt;&lt;span style="font-size: 10.0pt; font-family: 'Arial',sans-serif; mso-fareast-font-family: 'Times New Roman'; mso-font-kerning: 0pt; mso-ligatures: none;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: .1in; border: none; border-bottom: solid black 1.0pt; mso-border-bottom-alt: solid black .75pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="10"&gt;
&lt;p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;"&gt;&lt;span style="font-size: 10.0pt; font-family: 'Arial',sans-serif; mso-fareast-font-family: 'Times New Roman'; mso-font-kerning: 0pt; mso-ligatures: none;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 67.25pt; border-top: none; border-left: none; border-bottom: solid black 1.0pt; border-right: solid black 1.0pt; mso-border-top-alt: double windowtext 1.5pt; mso-border-bottom-alt: solid black .75pt; mso-border-right-alt: solid black .75pt; padding: 0in 5.05pt 0in 5.4pt;" valign="top" width="90"&gt;
&lt;p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center"&gt;&lt;span style="font-size: 10.0pt; font-family: 'Arial',sans-serif; mso-fareast-font-family: 'Times New Roman'; mso-font-kerning: 0pt; mso-ligatures: none;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
