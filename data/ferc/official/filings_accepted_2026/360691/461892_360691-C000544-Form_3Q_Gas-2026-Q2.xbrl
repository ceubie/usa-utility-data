  <ferc:OrderNumber id="HHD8F79A4E88098CC3762461FCE501D47A" contextRef="HHE43A4CCC6635B936B07E899931CF9F27" decimals="0" unitRef="HHferc_us_Pure">5</ferc:OrderNumber>
  <ferc:OrderNumber id="HH577C0218ECA28630EB656218806FE086" contextRef="HH5AC417CA687A9B32D86565DDCF663ED6" decimals="0" unitRef="HHferc_us_Pure">6</ferc:OrderNumber>
  <ferc:OrderNumber id="HHDDE9CDE2DDC4252C4EE9DBE928FA4A87" contextRef="HHCAF179341490D3F304C9658470C329FD" decimals="0" unitRef="HHferc_us_Pure">7</ferc:OrderNumber>
  <ferc:OrderNumber id="HHD4D2A262CC845B3C1464F2B5A9181452" contextRef="HH0F0C90B879533CAA70C61034BEF4EA1B" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <ferc:OrderNumber id="HH97C0E06EECD9745EC2E0DB0A6566F7A6" contextRef="HHD801727324789074F396F8E166C70BFD" decimals="0" unitRef="HHferc_us_Pure">2</ferc:OrderNumber>
  <ferc:OrderNumber id="HHC6B616434082AEC9D522E8D33877BFC8" contextRef="HH96B496E229382FF76DBA6063CB03C775" decimals="0" unitRef="HHferc_us_Pure">3</ferc:OrderNumber>
  <ferc:OrderNumber id="HHE51E1DE5F811304B0F97DF508497FD9C" contextRef="HH5200294E1B58F5CAC6D2234ED163C988" decimals="0" unitRef="HHferc_us_Pure">1</ferc:OrderNumber>
  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH6E24C5DA2876AFDA84469FF01AB724F5" xlink:label="HH6E24C5DA2876AFDA84469FF01AB724F5" />
    <link:footnote xlink:type="resource" xlink:label="HHF1C41621B3214F5693F6012171764B27" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <div>
          <p>
            <span style="font-size: 12pt;">
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <strong>Schedule Page: 232 Line No.: 1 Column: a</strong>
              </span>
            </span>
          </p>
          <p>
            <span style="font-size: 12pt;">
              <span style="font-family: Arial, Helvetica, sans-serif;">As authorized by the FERC's order, EGT has a fuel tracker mechanism whereby it recovers gas used and lost on its system via in-kind receipts of volumes from its shippers. The fuel tracker mechanism for EGT has a true-up provision that any over/under recoveries of volumes are returned to or collected from shippers through prospective semi-annual adjustment to fuel tracker retention rates. A regulatory asset or regulatory liability is established for the volumes collected and the volumes actually used/lost on the system. The over/under recovered volumes are valued at market prices in effect at the time the net over/under recoveries were recognized in the regulatory asset or regulatory liability accounts.</span>
            </span>
          </p>
        </div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6E24C5DA2876AFDA84469FF01AB724F5" xlink:to="HHF1C41621B3214F5693F6012171764B27" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF58E69F589153B7D3618F8FFE30CA7EF" xlink:label="HHF58E69F589153B7D3618F8FFE30CA7EF" />
    <link:footnote xlink:type="resource" xlink:label="HH77E5F686B62423D28275DC58BE1E1782" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="color: rgba(0, 0, 0, 1); text-decoration: inherit;">
                <strong>Schedule Page: 232 Line No.: 2 Column: a</strong>
              </span>
            </span>
          </span>
        </p>
        <p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">As authorized by the FERC's order, EGT collects from its shippers costs incurred for electric power costs associated with compressor stations on its system. The collection is via an Electric Power Cost ("EPC") surcharge billed to customers. The provisions of the EPC tracker contain a true-up provision such that any over/under collections are returned to or collected from shippers through prospective semi-annual adjustments to the EPC rates. A regulatory asset or regulatory liability is established for the difference between the actual EPC incurred and the amount collected via the EPC surcharge.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF58E69F589153B7D3618F8FFE30CA7EF" xlink:to="HH77E5F686B62423D28275DC58BE1E1782" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF8E2CA7088BF1A08D499BA595BCF93CA" xlink:label="HHF8E2CA7088BF1A08D499BA595BCF93CA" />
    <link:footnote xlink:type="resource" xlink:label="HH049196A8C7F29DF39262B0964F121D84" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-weight: bold; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Schedule Page: 120 Line No.: 5.1 Column: b</span>
        </p>
        <p>
          <img title="Screenshot 2026-08-05 120719.gif" src="data:image/gif;base64," alt="" width="455" height="104" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF8E2CA7088BF1A08D499BA595BCF93CA" xlink:to="HH049196A8C7F29DF39262B0964F121D84" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7A275344624F0BEAE383337295179FAE" xlink:label="HH7A275344624F0BEAE383337295179FAE" />
    <link:footnote xlink:type="resource" xlink:label="HH601EBB76F96C55B30A2ABB4360D8A912" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-weight: bold; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Schedule Page: 120 Line No.: 16.1 Column: b</span>
        </p>
        <p>
          <img title="Screenshot 2026-08-05 120824.gif" src="data:image/gif;base64," alt="" width="455" height="164" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7A275344624F0BEAE383337295179FAE" xlink:to="HH601EBB76F96C55B30A2ABB4360D8A912" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE42A88354FE811940E49AF98CC4875FD" xlink:label="HHE42A88354FE811940E49AF98CC4875FD" />
    <link:footnote xlink:type="resource" xlink:label="HH4707E625A04C4391F3C16AC0FF62AD2B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-weight: bold;">Schedule Page: 521 Line No.: 7 Column: f</span>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">The basis for valuing the gas reported in columns (f), (g) and (h) is the weighted average rate for system gas.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE42A88354FE811940E49AF98CC4875FD" xlink:to="HH4707E625A04C4391F3C16AC0FF62AD2B" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF954BDD3127828E1BCA0358719386A04" xlink:label="HHF954BDD3127828E1BCA0358719386A04" />
    <link:footnote xlink:type="resource" xlink:label="HH6CFAB580728AA45352651A4DF614CA79" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-weight: bold;">Schedule Page: 521 Line No.: 22 Column: i</span>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Gas used for other operational purposes includes fuel and shrinkage of gas processed by others, blow-downs and other operational uses of gas other than compressor station fuel, and in-kind volumes of gas delivered to other pipelines in accordance with applicable transportation contracts.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF954BDD3127828E1BCA0358719386A04" xlink:to="HH6CFAB580728AA45352651A4DF614CA79" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH72C8E2B3CE25DF9A25D15201DE6A14FD" xlink:label="HH72C8E2B3CE25DF9A25D15201DE6A14FD" />
    <link:footnote xlink:type="resource" xlink:label="HHCDDA12EC5420663CB540689F58E869F9" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <strong style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; color: #000000;">Schedule Page: 520 Line No.: 3 Column: d</strong>
        </p>
        <p>
          <img title="Screenshot 2026-08-05 121038.gif" src="data:image/gif;base64," alt="" width="560" height="104" />
        </p>
        <p>
          <strong style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; color: #000000;">
            <strong style="font-size: 14px; font-family: Roboto;">
              <span style="font-family: Arial, Helvetica, sans-serif; font-weight: 400; font-size: 12pt;">This footnote also applies to column (c).</span>
            </strong>
          </strong>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH72C8E2B3CE25DF9A25D15201DE6A14FD" xlink:to="HHCDDA12EC5420663CB540689F58E869F9" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH53794BDB8837CB146C86FCFD72DF1B60" xlink:label="HH53794BDB8837CB146C86FCFD72DF1B60" />
    <link:footnote xlink:type="resource" xlink:label="HH4BBB2F6D8BB8B91ABF78A31754D65655" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 520 Line No.: 5 Column: d</strong>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Includes quantities processed by others to attain pipeline quality specifications. This footnote also applies to column (c).</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH53794BDB8837CB146C86FCFD72DF1B60" xlink:to="HH4BBB2F6D8BB8B91ABF78A31754D65655" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH133C6E5D12D47C5FA461015890F2BCA3" xlink:label="HH133C6E5D12D47C5FA461015890F2BCA3" />
    <link:footnote xlink:type="resource" xlink:label="HH41847F21FA02A79C6666058C3A4BF91E" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 520 Line No.: 12 Column: d</strong>
            </span>
          </span>
        </p>
        <p style="margin: 0px 0px 10px; color: #000000; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Represents gas withdrawn from storage to support system management activity. This footnote also applies to column (c).</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH133C6E5D12D47C5FA461015890F2BCA3" xlink:to="HH41847F21FA02A79C6666058C3A4BF91E" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH5A5D401C746D3B1BB69EDDA47324F07C" xlink:label="HH5A5D401C746D3B1BB69EDDA47324F07C" />
    <link:footnote xlink:type="resource" xlink:label="HH563A077ECA35CE20CEFA42386B48E72F" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
