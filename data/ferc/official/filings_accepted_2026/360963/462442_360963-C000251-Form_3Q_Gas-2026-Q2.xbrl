  <ferc:DisclosureOfRevenuesAndExpensesForTrackedCostAndSpecialSurchargeTextBlock id="HHE32A68D26BD7C268C18C3E25D34562AF" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfRevenuesAndExpensesForTrackedCostAndSpecialSurchargeTextBlock>
  <ferc:DisclosureOfRateTreatmentForUnamortizedLossOnReacquiredDebtAndUnamortizedGainOnReacquiredDebtTextBlock id="HHB4C2F5ED33AF365D6A63772234801965" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfRateTreatmentForUnamortizedLossOnReacquiredDebtAndUnamortizedGainOnReacquiredDebtTextBlock>
  <ferc:DisclosureOfRetainedEarningsRestrictionsTextBlock id="HH13943CA87094EFFC62CA0A4F73E8D15D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfRetainedEarningsRestrictionsTextBlock>
  <ferc:DisclosureOfSignificantFinancialChangesTextBlock id="HH768D5D4066691F2DD5E2FA0EE9BB7BA0" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfSignificantFinancialChangesTextBlock>
  <ferc:DisclosureOfUnsettledRateProceedingsTextBlock id="HH4BF49E161908A7C6C0D18BFC6FC7874B" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfUnsettledRateProceedingsTextBlock>
