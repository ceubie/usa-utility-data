    <link:loc xlink:type="locator" xlink:href="#HHC661AB4B70439B673E1505187595962D" xlink:label="HHC661AB4B70439B673E1505187595962D" />
    <link:footnote xlink:type="resource" xlink:label="HH63D73F7B6601C5B77A14ED5585DB1472" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <em>
                <span style="font-weight: bold;">Schedule Page: 520 Line No.: 12 Column: d</span>
              </em>
            </span>
          </span>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt;">Other gas withdrawn from storage represents withdrawals of system balancing gas. </span>
          <em style="font-weight: bold;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt;">
                <span style="font-style: normal; font-weight: 400;">This footnote also applies to column (c).</span>
              </span>
            </span>
          </em>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC661AB4B70439B673E1505187595962D" xlink:to="HH63D73F7B6601C5B77A14ED5585DB1472" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH8ABD479323E5DF690E14A9452059B9F9" xlink:label="HH8ABD479323E5DF690E14A9452059B9F9" />
    <link:footnote xlink:type="resource" xlink:label="HH47145609EA853F075CABED9A1C153922" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <em>
                <span style="font-weight: bold;">Schedule Page: 520 Line No.: 27 Column: d</span>
              </em>
            </span>
          </span>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Other gas delivered to storage represents injections of system balancing gas. </span>
          </span>
          <em style="font-weight: bold;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="font-size: 12pt;">
                <span style="font-style: normal; font-weight: 400;">This footnote also applies to column (c).</span>
              </span>
            </span>
          </em>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH8ABD479323E5DF690E14A9452059B9F9" xlink:to="HH47145609EA853F075CABED9A1C153922" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH4EBDF3B0FCF0F04711C8F3CB81657AB7" xlink:label="HH4EBDF3B0FCF0F04711C8F3CB81657AB7" />
    <link:footnote xlink:type="resource" xlink:label="HH385FC7E960166775C7FE5C4DCB5FC643" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
