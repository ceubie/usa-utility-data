					&lt;span style="font-family:Aptos"&gt;Deferred tax assets: &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $103.8 million and&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;105.0 &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Deferred tax liabilities: &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $103.8 million and&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;105.0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
