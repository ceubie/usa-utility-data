    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH3E7DBB770EA2ACD97AD6370F8164589B" xlink:to="HH79B32945A1E2EE01C586BE9BA48FEF0E" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH7CCD4794572FE10645AD0E7F463BA69E" xlink:label="HH7CCD4794572FE10645AD0E7F463BA69E" />
    <link:footnote xlink:type="resource" xlink:label="HHC2976FF26ED8348BAAE5BE7A2085371C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Page 300 Line 11 Column B</p>
        <table style="width: 569pt;" border="0" width="758" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 59.25pt;">
              <td class="xl69" style="height: 59.25pt; width: 569pt;" colspan="6" width="758" height="79">Pursuant to FERC Order 668, for FERC purposes MGE nets RTO day-ahead and real-time energy market activity separately on an hourly basis. For PSCW and SEC reporting, the RTO hourly day-ahead and real-time activity is combined for netting purposes. Due to the netting difference, Sales for Resale are <span class="font8" style="">$4,260,318</span><span class="font5" style=""> greater for FERC purposes than PSCW or SEC purposes for the </span><span class="font8" style="">three</span><span class="font5" style=""> months ended </span><span class="font8" style="">Mar 31, 2026</span><span class="font5" style="">.</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7CCD4794572FE10645AD0E7F463BA69E" xlink:to="HHC2976FF26ED8348BAAE5BE7A2085371C" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH9DEE2502BD5CAAE264B044B8DE093084" xlink:label="HH9DEE2502BD5CAAE264B044B8DE093084" />
    <link:footnote xlink:type="resource" xlink:label="HHC1A3935384F4443933CA7351EBF1102A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Page 300 Line 11 Column D</p>
        <table style="width: 569pt;" border="0" width="758" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 52.5pt;">
              <td class="xl69" style="height: 52.5pt; width: 569pt;" colspan="6" width="758" height="70">Pursuant to FERC Order 668, for FERC purposes MGE nets RTO day-ahead and real-time energy market activity separately on an hourly basis. For PSCW and SEC reporting, the RTO hourly day-ahead and real-time activity is combined for netting purposes. Due to the netting difference, Sales for Resale are<span class="font8"> 85,597</span><span class="font5">&#160;greater for FERC purposes than PSCW or SEC purposes for the </span><span class="font8">three</span><span class="font5"> months ended </span><span class="font8">Mar 31, 2026</span><span class="font5">.</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
