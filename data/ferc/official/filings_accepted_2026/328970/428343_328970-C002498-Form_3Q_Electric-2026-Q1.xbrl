					&lt;span style="font-family:Aptos"&gt;Operating revenues: Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;4.3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;2.8&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
