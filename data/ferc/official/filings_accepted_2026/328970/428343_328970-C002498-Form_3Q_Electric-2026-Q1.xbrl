        <p>
          <strong style="color: #000000; font-family: Roboto;">
            <em>
              <span style="text-decoration: underline;">Schedule Page: 120 Line No: 18 Column: b</span>
            </em>
          </strong>
        </p>
        <table style="border-collapse: collapse; width: 360pt;" border="0" width="479" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="height: 13.2pt;">
              <td class="xl82" style="height: 13.2pt; width: 280pt;" width="373" height="18">Provision for doubtful accounts</td>
              <td class="xl83" style="border-left: none; width: 80pt;" width="106">&#160;$&#160;&#160;&#160;&#160;&#160; 1,756,250</td>
            </tr>
            <tr style="height: 13.2pt;">
              <td class="xl82" style="height: 13.2pt; border-top: none;" height="18">Gain on Sale of PPE</td>
              <td class="xl84" style="border-top: none; border-left: none;">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; -</td>
            </tr>
            <tr style="height: 13.2pt;">
              <td class="xl82" style="height: 13.2pt; border-top: none;" height="18">Other items not affecting cash</td>
              <td class="xl84" style="border-top: none; border-left: none;">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 2,213,727</td>
            </tr>
            <tr style="height: 13.2pt;">
              <td class="xl82" style="height: 13.2pt; border-top: none;" height="18">Cash contributions to pension and other post-retirement plans</td>
              <td class="xl84" style="border-top: none; border-left: none;">&#160;&#160;&#160;&#160;&#160;&#160;&#160; (1,873,510)</td>
            </tr>
            <tr style="height: 13.2pt;">
              <td class="xl82" style="height: 13.2pt; border-top: none;" height="18">Other noncurrent items, net</td>
              <td class="xl84" style="border-top: none; border-left: none;">&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; (568,736)</td>
            </tr>
            <tr style="height: 13.8pt;">
              <td class="xl85" style="height: 13.8pt; border-top: none;" height="18">Total</td>
              <td class="xl83" style="border-top: none; border-left: none;">&#160;$&#160;&#160;&#160;&#160;&#160; 1,527,731</td>
            </tr>
          </tbody>
        </table>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0871A0AD31DECACB7E5FCE34BEF5BF9A" xlink:to="HH038E6ABE5FC74D8B5BFE85F1CC2DC38A" order="1" />
