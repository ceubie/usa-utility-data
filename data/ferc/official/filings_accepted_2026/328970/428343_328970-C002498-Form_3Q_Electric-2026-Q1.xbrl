						&lt;td style="width:15.06%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:bottom; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:center; font-size:9pt"&gt;&#xD;
