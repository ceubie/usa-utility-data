					&lt;span style="font-family:Aptos"&gt;Accumulated Depreciation: Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;18.2&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;17.5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Construction work in progress: Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;2.3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;2.2&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Other deferred assets: Increase &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$8.6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;8.7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
