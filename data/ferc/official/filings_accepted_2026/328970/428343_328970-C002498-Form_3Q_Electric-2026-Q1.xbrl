					&lt;span style="font-family:Aptos"&gt;Deferred tax assets: Increase $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0.9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
