						&lt;td style="width:19.94%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:top; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-left:5pt; margin-bottom:0pt; page-break-after:avoid; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Calibri"&gt;2025&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:1.86%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:bottom; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; page-break-after:avoid; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Calibri; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:38.18%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:bottom; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:center; page-break-after:avoid; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Calibri"&gt;($7.1)&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:1.86%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:bottom; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; page-break-after:avoid; font-size:9pt"&gt;&#xD;
