              <td class="xl67" style="font-size: 10pt; color: windowtext; font-family: Arial, sans-serif; border-width: medium medium 1pt; border-style: none none solid; border-color: currentcolor currentcolor black;">&#160;</td>
              <td class="xl70" style="font-size: 10pt; color: windowtext; font-family: Arial, sans-serif; border-width: 0.5pt medium 1pt; border-style: solid none; border-color: windowtext currentcolor black;">&#160;$&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160; 22,963</td>
