					&lt;span style="font-family:Aptos"&gt;Other regulatory assets:&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
