					&lt;span style="font-family:Aptos"&gt;Deferred income tax liabilities: Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1.6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1.5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Accrued taxes: Increase $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0.7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0.6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
