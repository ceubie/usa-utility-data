        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-756_lbl" order="0" xlink:to="ft-756_47027_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-760_lbl" order="0" xlink:to="ft-760_47028_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-768_lbl" order="0" xlink:to="ft-768_47438_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1007_lbl" order="0" xlink:to="ft-1007_47042_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1008_lbl" order="0" xlink:to="ft-1008_47043_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1016_lbl" order="0" xlink:to="ft-1016_47045_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1065_lbl" order="0" xlink:to="ft-1065_47047_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1092_lbl" order="0" xlink:to="ft-1092_47056_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1108_lbl" order="0" xlink:to="ft-1108_47049_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1136_lbl" order="0" xlink:to="ft-1136_47063_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1195_lbl" order="0" xlink:to="ft-1195_47066_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1208_lbl" order="0" xlink:to="ft-1208_47065_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-1223_lbl" order="0" xlink:to="ft-1223_47064_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2010_lbl" order="0" xlink:to="ft-2010_47093_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2135_lbl" order="0" xlink:to="ft-2135_47244_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2378_lbl" order="0" xlink:to="ft-2378_47245_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2384_lbl" order="0" xlink:to="ft-2384_47246_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2408_lbl" order="0" xlink:to="ft-2408_47247_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2495_lbl" order="0" xlink:to="ft-2495_47316_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2525_lbl" order="0" xlink:to="ft-2525_47360_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2557_lbl" order="0" xlink:to="ft-2557_47361_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2602_lbl" order="0" xlink:to="ft-2602_47424_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2650_lbl" order="0" xlink:to="ft-2650_47436_lbl" />
        <link:footnote xlink:label="ft-132_46919_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); text-align: left"><span style="color: rgba(51, 51, 51, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt"><span style="font-size: 12pt"><b style="font-weight: bold; background-color: rgba(255, 255, 255, 1)">Schedule Page: 278 Line No.: 1 Column: a</b></span></span></p><p style="margin: 0 0 8pt; line-height: 115%; font-size: 12pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Pursuant to Section 22.3 of the General Terms and Conditions of Gulf Run's FERC Gas Tariff, Original Volume No. 1, Docket No. RP24-747-000, as approved by FERCs order issued on May 15, 2024 and Docket No. RP25-875-000, as approved by FERC's order issued on May 14, 2025.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-134_46920_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"><span style="font-size: 12pt"><b style="font-weight: bold">Schedule Page: 278 Line No.: 2 Column: a</b></span></span></p><p style="margin: 0 0 10px; color: rgba(51, 51, 51, 1); font-family: Roboto"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">Pursuant to Section 9 of the General Terms and Conditions ("GT&amp;C") of Gulf Run's FERC Gas Tariff, Original Volume No. 1, Docket No. RP26-123-000 filed with FERC on October 31, 2025, Gulf Run </span><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">is required to credit to eligible firm<span> </span></span></span><span style="font-size: 12pt; font-family: Arial, Helvetica, sans-serif; background-color: unset; text-align: inherit">customers penalty revenues collected during the Penalty Base Period. The annual base period runs August 1 through July 31. Under the<span> </span></span><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">terms of Section 9.6 of the GT&amp;C, Gulf Run is not required to calculate revenue credits until the total penalty crediting revenues exceed<span> </span></span></span><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">$250,000.</span></span><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"><br/></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-756_47027_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 220 Line No.: 7 Column: e</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Gulf Run has no storage facilities, therefore account 117.4 is used to record operational fluctuations in line pack.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-760_47028_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 220 Line No.: 5 Column: i</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Gulf Run utilizes the fixed asset method of accounting for system line pack.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-768_47438_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 232 Line No.: 1 Column: e</b></span></span></p><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Includes $1,628,009 refunded to customers.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1007_47042_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span><b style="font-weight: bold">Schedule Page: 313 Line No.: 1 Column: c</b></span></span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold; color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"><span style="color: rgba(51, 51, 51, 1); background-color: rgba(255, 255, 255, 1)">The volumes in column (c) include discounted reservation contract quantities and commodity transactions.</span></span></b></p></div></link:footnote>
        <link:footnote xlink:label="ft-1008_47043_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span><b style="font-weight: bold">Schedule Page: 313 Line No.: 1 Column: e</b></span></span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold; color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important"><span style="color: rgba(51, 51, 51, 1); background-color: rgba(255, 255, 255, 1)">The volumes in column (e) include negotiated reservation contract quantities and commodity transactions.</span></span></b></p></div></link:footnote>
        <link:footnote xlink:label="ft-1016_47045_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 328 Line No.: 1 Column: a</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Gulf Run does not report imbalances by rate schedule because imbalances are calculated at the contract level and not rate schedule level.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1065_47047_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 520 Line No.: 3 Column: c</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">Gas purchase expense was booked to Natural gas transmission line purchases, Account 803. This footnote also applies to column (d).</span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1092_47056_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 7.5pt; font-family: Roboto"><span style="font-size: 12pt"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1)">Schedule Page: 520 Line No.: 20 Column: c</span></b></span></p><p style="margin: 0 0 7.5pt; font-family: Roboto"><span style="font-size: 12pt"><span><span style="font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1)">For the purpose of the Annual Charge Adjustment ("ACA") calculation, the throughput volume is 1,014,990,860 Dth as represented on line 20. </span><span style="font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1)"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">No additional volumes are needed to calculate total volumes eligible for the ACA surcharge.</span></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1108_47049_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><b style="font-weight: bold; color: rgba(51, 51, 51, 1)"><span style="font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1)">Schedule Page: 520 Line No.: 29.1 Column: d</span></b></span><span style="font-size: 12pt"><b style="font-weight: bold; color: rgba(51, 51, 51, 1)"><span style="font-family: Arial, Helvetica, sans-serif; color: rgba(0, 0, 0, 1)"><br /></span></b></span></p><p style="margin: 0; color: rgba(0, 0, 0, 1); font-family: Roboto"><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1410px; min-height: 0" alt="" /> </p></div></link:footnote>
        <link:footnote xlink:label="ft-1136_47063_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 521 Line No.: 7 Column: f</b></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">The basis for valuing the gas reported in columns (f), (g) and (h) is the weighted average rate for system gas.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1195_47066_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 521 Line No.: 51 and 65 Column: i</b></span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p><p style="margin: 0; font-family: Roboto"><em style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 700; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">Cumulative volumes of in-kind gas owed to or due from shippers are revalued to market price each month. The dollars reported reflects the net valuation for the current month volumes and excludes the revaluation adjustment.</span></em></p></div></link:footnote>
        <link:footnote xlink:label="ft-1208_47065_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 521 Line No.: 22 Column: i</b></span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br /></span></span></p><p style="margin: 0; font-family: Roboto"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">Gas used for other operational purposes includes blow-downs and other operational uses of gas other than compressor station fuel, and in-kind volumes of gas delivered to other pipelines in accordance with applicable transportation contracts.</span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1223_47064_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 521 Line No.: 7 Column: i</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><em style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-weight: 700; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">Gulf Run does not recognize revenues for shipper-supplied fuel and values only the net excess or deficiency volume as reported on line 37. The dollars reported for lines 1-30 on this page are allocated to these categories using current average market prices.</span></em></p></div></link:footnote>
        <link:footnote xlink:label="ft-2010_47093_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 350 Line No.: 1 Column: i</span></span></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Account 186, Miscellaneous deferred debits was used to record deferred charges for regulatory commission expense. This footnote applies to columns (i) and (l), line 1.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2135_47244_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><b style="font-weight: bold">Schedule Page: 336 Line No.: 10 Column: b</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">General plant is depreciated on a straight line basis per assigned FERC rates.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2378_47245_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 338 Line No.: 7 Column: b</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">The depreciation plant basis reflects a balance as of 12/31/2025. </span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">This footnote also applies to lines 8 and 9, column (b).</span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2384_47246_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 338 Line No.: 7 Column: c</b></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">The applied depreciation rate for Transmission Plant, General Plant and Intangibles is 2.5%. The n</span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">egative salvage rate for Transmission Plant is 0.25%. <span> </span></span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">This footnote also applies to lines 8 and 9, column (c).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2408_47247_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 120 Line No.: 16.1 Column: b</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold"><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1410px; min-height: 0" alt="" /> </b></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2495_47316_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-family: sans-serif; font-size: medium"><b style="font-weight: bold"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 218 Line No.: 5 Column: f</span></span></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Pursuant to certificate application to construct the pipeline, Docket No. CP20-68-000 approved by the FERC's order, issued on March 6, 2024, a 14% equity cost rate is used in calculating AFUDC.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2525_47360_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 358 Line No.: 2 Column: a</b></span></span></p><table cellpadding="0" cellspacing="0" width="1006" style="width: 755pt" class="e-rte-paste-table"> <tr style="height: 15.75pt">  <td height="21" colspan="3" width="901" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt; width: 676pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Allocation Basis:</span></span></td>  <td width="105" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; width: 79pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br/></span></span></td> </tr> <tr style="height: 15.75pt">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; text-align: ; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">(a)</span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; text-align: ; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><br/></span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: 