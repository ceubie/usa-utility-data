    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote1" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p style="line-height: 1;">Chain of Ownership:</xhtml:p>
        <xhtml:p style="line-height: 1;">PAA GP Holdings LLC - DE</xhtml:p>
        <xhtml:p style="line-height: 1;">Plains GP Holdings, L.P. - DE</xhtml:p>
        <xhtml:p style="line-height: 1;">Plains All American GP LLC - DE</xhtml:p>
