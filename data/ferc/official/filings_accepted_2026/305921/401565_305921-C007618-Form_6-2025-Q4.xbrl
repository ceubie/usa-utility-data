    <ferc:GrossAdditionsToCarrierPropertyInvestmentActivities id="f-478" contextRef="c-25" unitRef="u-02" decimals="0">12756915</ferc:GrossAdditionsToCarrierPropertyInvestmentActivities>
    <ferc:NetCashProvidedByUsedInOperatingActivities id="f-479" contextRef="c-25" unitRef="u-02" decimals="0">903004132</ferc:NetCashProvidedByUsedInOperatingActivities>
    <ferc:NetIncreaseDecreaseInCashAndCashEquivalents id="f-480" contextRef="c-25" unitRef="u-02" decimals="0">7722144</ferc:NetIncreaseDecreaseInCashAndCashEquivalents>
    <ferc:NetIncreaseDecreaseInPayablesAndAccruedExpensesOperatingActivities id="f-481" contextRef="c-25" unitRef="u-02" decimals="0">-17822408</ferc:NetIncreaseDecreaseInPayablesAndAccruedExpensesOperatingActivities>
    <ferc:NetIncreaseDecreaseInReceivablesOperatingActivities id="f-482" contextRef="c-25" unitRef="u-02" decimals="0">-22529172</ferc:NetIncreaseDecreaseInReceivablesOperatingActivities>
    <ferc:NoncashAdjustmentsToCashFlowsFromOperatingActivities id="f-484" contextRef="c-41" unitRef="u-02" decimals="0">83056</ferc:NoncashAdjustmentsToCashFlowsFromOperatingActivities>
    <ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities id="f-486" contextRef="c-43" unitRef="u-02" decimals="0">-1268471</ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities>
    <ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities id="f-487" contextRef="c-46" unitRef="u-02" decimals="0">-38343</ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities>
    <ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities id="f-488" contextRef="c-49" unitRef="u-02" decimals="0">-4448196</ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities>
    <ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities id="f-489" contextRef="c-51" unitRef="u-02" decimals="0">480491</ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities>
