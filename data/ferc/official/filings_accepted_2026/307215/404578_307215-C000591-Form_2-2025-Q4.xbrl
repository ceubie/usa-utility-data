  <ferc:GeneralInformationAboutCustodyOfTheCorporateBooksDescription id="f-1" contextRef="c-1">Christine Fernandez, Vice President, Controller and Chief Accounting Officer9 Greenway Plaza, Suite 2800, Houston, Texas 77046-0905</ferc:GeneralInformationAboutCustodyOfTheCorporateBooksDescription>
  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-2" contextRef="c-1">Christine Fernandez, Vice President, Controller and Chief Accounting Officer</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:GeneralInformationAboutIncorporationOfTheRespondentDescription id="f-3" contextRef="c-1">Delaware - December&#160;31, 2000 Effective January 1, 2020, Gulf South converted from a limited partnership to a limited liability company.</ferc:GeneralInformationAboutIncorporationOfTheRespondentDescription>
  <ferc:IncorporationDate id="f-4" contextRef="c-1">2000-12-31</ferc:IncorporationDate>
  <ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription id="f-5" contextRef="c-1">0000</ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription>
  <ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered id="f-6" contextRef="c-1">Gulf South Pipeline Company, LLC (Gulf South) is engaged in the storage of natural gas in the states of Louisiana and Mississippi; the gathering of natural gas in the states of Texas, Louisiana and Mississippi and the transportation of natural gas in the states of Texas, Louisiana, Mississippi, Alabama and northern Florida to distribution systems owned by others, to other pipeline companies and to electric utilities and industrial customers for their own use.</ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-7" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
  <ferc:EngagementDateOfIndependentAuditor id="f-8" contextRef="c-1" xsi:nil="true"></ferc:EngagementDateOfIndependentAuditor>
