  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:label="value3" xlink:href="#Tag210" />
    <link:loc xlink:type="locator" xlink:label="value5" xlink:href="#Tag215" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote3" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 10.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">
            <xhtml:span style="font-size: 16pt;">This balance relates to excess deferred income taxes created by the remeasurement of deferred income tax liabilities resulting from the reduction in U.S. federal tax rates from 35% to 21%, due to legislation referred to as the Tax Cuts and Jobs Act of 2017. This balance is currently expected to be amortized through approximately 2057.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value3" xlink:to="footnote3" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="3" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote5" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 16pt; line-height: 107%; font-family: Arial, sans-serif;">A CIAC in the amount of $1,529,056 from SWG and associated federal tax gross-up totaling $183,487 was recorded in the Companys records and through its intercompany accounts in June 2024. As of the second quarter of 2026 the accumulated amortization of the CIAC totaled $24,466.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value5" xlink:to="footnote5" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="5" />
  </link:footnoteLink>
</xbrli:xbrl>
