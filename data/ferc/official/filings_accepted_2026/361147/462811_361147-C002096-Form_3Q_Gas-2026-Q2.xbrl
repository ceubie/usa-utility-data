          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Recorded pursuant to Section 12.8 of the General Terms and Conditions of our FERC Gas Tariff.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value9" xlink:to="footnote9" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="9" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote11" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table class="MsoNormalTable" style="width: 4.0in; border-collapse: collapse; mso-yfti-tbllook: 1184; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="0" width="384" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 23.25pt;">
              <xhtml:td style="width: 463.5pt; padding: 0in 5.4pt 0in 5.4pt; height: 23.25pt;" colspan="2" nowrap="nowrap" width="618">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-fareast-font-family: 'Times New Roman';">Fuel recovery volumes (shipper supplied gas for storage):</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 1; height: 23.25pt;">
              <xhtml:td style="width: 463.5pt; padding: 0in 5.4pt 0in 5.4pt; height: 23.25pt;" colspan="2" nowrap="nowrap" width="618">
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 2; height: .1in;">
              <xhtml:td style="width: 348.75pt; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; mso-border-bottom-alt: solid windowtext .5pt; mso-border-right-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .1in;" nowrap="nowrap" width="465">
              </xhtml:td>
              <xhtml:td style="width: 114.75pt; border: solid windowtext 1.0pt; border-left: none; mso-border-left-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .1in;" valign="bottom" width="153">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: center; line-height: normal;" align="center">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-fareast-font-family: 'Times New Roman';">Dth</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 3; height: 1.0pt;">
              <xhtml:td style="width: 348.75pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: 1.0pt;" nowrap="nowrap" width="465">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif; mso-fareast-font-family: 'Times New Roman';">April activity</xhtml:span>
                </xhtml:p>
              </xhtml:td>
