    <link:footnoteArc xlink:type="arc" xlink:from="value11" xlink:to="footnote11" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="11" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote12" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level rather than by discounted, negotiated, or recourse rate contracts; therefore, the reported amounts have been allocated to discounted, negotiated, or recourse rate contracts based on reasonable assumptions. </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value12" xlink:to="footnote12" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="12" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote13" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">Line 14 dekatherms do not include electric compressor stations. This footnote applies to all periods within the quarter.</xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
