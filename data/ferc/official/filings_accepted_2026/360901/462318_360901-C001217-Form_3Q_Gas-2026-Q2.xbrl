			&lt;td style="font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt;"&gt;$&lt;/td&gt;
			&lt;td style="width: 12%; text-align: right; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt;"&gt;256,000&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt;"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt;"&gt;$&lt;/td&gt;
			&lt;td style="width: 12%; text-align: right; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt;"&gt;256,000&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt;"&gt;&amp;#xa0;&lt;/td&gt;
		&lt;/tr&gt;
		&lt;tr style="vertical-align: bottom; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;
			&lt;td style="font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;
			&lt;p style="font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt;"&gt;Less: Current portion&lt;/p&gt;
			&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; border-bottom: 1px solid rgb(0, 0, 0);"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 12%; text-align: right; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 1px solid rgb(0, 0, 0);"&gt;6,000&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; padding-bottom: 1px; margin-left: 0pt;"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; border-bottom: 1px solid rgb(0, 0, 0);"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 12%; text-align: right; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 1px solid rgb(0, 0, 0);"&gt;6,000&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; padding-bottom: 1px; margin-left: 0pt;"&gt;&amp;#xa0;&lt;/td&gt;
		&lt;/tr&gt;
		&lt;tr style="vertical-align: bottom; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;
			&lt;td style="font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;
			&lt;p style="font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; font-variant: normal; margin: 0pt;"&gt;Total long-term debt, net&lt;/p&gt;
			&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);"&gt;$&lt;/td&gt;
			&lt;td style="width: 12%; text-align: right; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);"&gt;250,000&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; padding-bottom: 3px; margin-left: 0pt;"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt;"&gt;&amp;#xa0;&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);"&gt;$&lt;/td&gt;
			&lt;td style="width: 12%; text-align: right; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; margin-left: 0pt; border-bottom: 3px double rgb(0, 0, 0);"&gt;250,000&lt;/td&gt;
			&lt;td style="width: 1%; font-family: &amp;quot;Times New Roman&amp;quot;, Times, serif; font-size: 10pt; padding-bottom: 3px; margin-left: 0pt;"&gt;&amp;#xa0;&lt;/td&gt;
		&lt;/tr&gt;
	
&lt;/tbody&gt;&lt;/table&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"&gt;On April 5, 2018, PNGTS entered into a revolving credit agreement which allows PNGTS to borrow up to $125.0 million with a variable interest rate based on LIBOR (Revolving Credit Facility). The Revolving Credit Facility is utilized by PNGTS primarily to fund the costs of its expansion projects and for general company purposes. The Revolving Credit Facility's original term was set to mature on April 5, 2023.&lt;/p&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"&gt;On January 31, 2023, PNGTS amended the Revolving Credit Facility to extend the term for an additional five-year term with a variable interest rate based on Secured Overnight Financing Rate (SOFR). During the year ended December 31, 2025 for both the Successor and Predecessor periods, the weighted average interest rate was 5.37%.&lt;/p&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"&gt;On July 17, 2024, PNGTS amended the Revolving Credit Facility to reduce the aggregate revolving commitment amount to $50.0 million and adjusted the Revolving Credit Facility to reflect new ownership structure as result of the Acquisition discussed in Note 1. As of December 31, 2025 (Successor), $44.0 million was available for future borrowings. Amounts outstanding under the Revolving Credit Facility as of December 31, 2025 are classified as current as the amount is required to be paid within the next year.&lt;/p&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"&gt;On October 8, 2020, PNGTS entered into a Note Purchase and Private Shelf Agreement, whereby PNGTS issued $125.0 million of 10-year Series A Senior Notes with a coupon of 2.84% per annum and entered into a 3-year private shelf agreement for an additional $125.0 million of Senior Notes (Private Shelf Facility). The Series A Notes do not require any principal payments until maturity on October 8, 2030. On October 29, 2021, PNGTS issued the remaining $125.0 million available under the Private Shelf Facility for 10-year Series B Senior Notes with a coupon of 2.68% per annum. The Series B Notes do not require any principal payments until maturity on October 29, 2031.&lt;/p&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"&gt;The Revolving Credit Facility and the Series A and B Notes require PNGTS to maintain a leverage ratio not greater than 5.00 to 1.00. The Series A Notes and Series B Notes also contain a covenant that limits total debt to no greater than 65 percent of PNGTS' total capitalization. As of June 30, 2026, PNGTS was in compliance with its financial covenants.&lt;/p&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;table border="0" cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px;"&gt;
	
		&lt;tbody&gt;&lt;tr style="vertical-align: top;"&gt;
			&lt;td style="width: 18pt;"&gt;
			&lt;p style="font-family: 'Times New Roman', Times, serif;font-size: 10pt;font-variant:normal;margin:0pt;"&gt;&lt;b&gt;6.&lt;/b&gt;&lt;/p&gt;
			&lt;/td&gt;
			&lt;td style="width: auto;"&gt;
			&lt;p style="font-family: 'Times New Roman', Times, serif;font-size: 10pt;font-variant:normal;margin:0pt;"&gt;&lt;b&gt;Transactions with Related Parties&lt;/b&gt;&lt;/p&gt;
			&lt;/td&gt;
		&lt;/tr&gt;
	
&lt;/tbody&gt;&lt;/table&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"&gt;At June 30, 2026 and December 31, 2025, the Company had an outstanding related party receivable of $7.4 million classified as Account Receivable from Associated Companies (146) on balance sheets.&lt;/p&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;table border="0" cellpadding="0" cellspacing="0" style="width: 100%; text-indent: 0px;"&gt;
	
		&lt;tbody&gt;&lt;tr style="vertical-align: top;"&gt;
			&lt;td style="width: 18pt;"&gt;
			&lt;p style="font-family: 'Times New Roman', Times, serif;font-size: 10pt;font-variant:normal;margin:0pt;"&gt;&lt;b&gt;7.&lt;/b&gt;&lt;/p&gt;
			&lt;/td&gt;
			&lt;td style="width: auto;"&gt;
			&lt;p style="font-family: 'Times New Roman', Times, serif;font-size: 10pt;font-variant:normal;margin:0pt;"&gt;&lt;b&gt;Subsequent Events&lt;/b&gt;&lt;/p&gt;
			&lt;/td&gt;
		&lt;/tr&gt;
	
&lt;/tbody&gt;&lt;/table&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"&gt;On July 15, 2026, PNGTS paid a cash distribution in the amount of $26.0 million to the members.&lt;/p&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;

&lt;p style="font-family:Times New Roman;font-size:10pt;font-variant:normal;text-align:justify;margin:0pt;"&gt;Subsequent events have been assessed through August 24, 2026, which is the date the financial statements were issued, and management concluded there were no events or transactions during this period that would require recognition or disclosure in the financial statements other than those already reflected here or in the preceding notes.&lt;/p&gt;

&lt;p style="font-family:'Times New Roman';font-size:10pt;font-variant:normal;margin:0pt;"&gt;&amp;#xa0;&lt;/p&gt;
</ferc:NotesToFinancialStatementsTextBlock>
<link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">

	    <link:footnote xlink:type="resource" xlink:label="ft-16383859514621_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">Property under Capital Leases - Right of Use Operating Leases</link:footnote>
		<link:loc xlink:type="locator" xlink:href="#f-303" xlink:label="f-303_lbl" />
		<link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-303_lbl" xlink:to="ft-16383859514621_lbl" order="1" />
		
		<link:footnote xlink:type="resource" xlink:label="ft-16383859514622_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">Accumulated Provision for Depreciation includes $288,064 for accumulated amortization of Right of Use Operating Leases. See Notes to Financial Statements.</link:footnote>
		<link:loc xlink:type="locator" xlink:href="#f-315" xlink:label="f-315_lbl" />
		<link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-315_lbl" xlink:to="ft-16383859514622_lbl" order="1" />
		
		<link:footnote xlink:type="resource" xlink:label="ft-16383859514623_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">ASC 740 considers the equity component of AFUDC a temporary difference for which deferred income taxes must be provided. The Respondent is required to record the deferred tax liability for AFUDC equity in Account 282 with a corresponding regulatory asset. The regulatory asset is itself a temporary difference for which deferred income taxes are recognized and recorded in Account 283. This accounting is also outlined in FERC Docket AI93-5-000.</link:footnote>
		<link:loc xlink:type="locator" xlink:href="#f-335" xlink:label="f-335_lbl" />
		<link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-335_lbl" xlink:to="ft-16383859514623_lbl" order="1" />
		
		<link:footnote xlink:type="resource" xlink:label="ft-16383859514624_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">Charged to account 282 - $25,927; Charged to account 283 - $10,059</link:footnote>
		<link:loc xlink:type="locator" xlink:href="#f-338" xlink:label="f-338_lbl" />
		<link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-338_lbl" xlink:to="ft-16383859514624_lbl" order="1" />
		
		<link:footnote xlink:type="resource" xlink:label="ft-16383859514625_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">Rate schedule PAL is a balancing service; therefore, quantities are excluded as associated Dths used for balancing do not represent gas delivered.</link:footnote>
		<link:loc xlink:type="locator" xlink:href="#f-387" xlink:label="f-387_lbl" />
		<link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-387_lbl" xlink:to="ft-16383859514625_lbl" order="1" />
		
</link:footnoteLink>
