            <td colspan="2" style="padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">(162,345)</span>
            </td>
            <td style="padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/>
            <td colspan="3" style="padding:0 1pt"/>
          </tr>
          <tr>
            <td colspan="3" style="padding:1.5pt 1pt;text-align:center;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">TOTAL</span>
            </td>
            <td colspan="2" style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 0 1.5pt 1pt;text-align:right;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%">(860,987)</span>
            </td>
            <td style="border-bottom:1pt solid #000;border-top:1pt solid #000;padding:1.5pt 1pt 1.5pt 0;text-align:right;vertical-align:bottom"/>
            <td colspan="3" style="padding:0 1pt"/>
          </tr>
        </table>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-21" id="fn-21" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">BASIS FOR VALUATION OF ALL GAS</span>
        <span style="color:#595959;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">:</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:10pt">
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">GAS IS VALUED MONTHLY AT A NGW INDEX PRICE WHEN THERE IS A NET EXCESS OF SHIPPER SUPPLIED GAS OR AT TRANSCO</span>
        <span style="color:#343434;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">'</span>
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">S MONTHLY WACOG WHEN THERE IS A DEFICIENCY OF SHIPPER SUPPLIED GAS</span>
        <span style="color:#595959;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-22" id="fn-22" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">THE FOLLOWING APPLIES TO ALL VOLUMES, FOR ALL MONTHS, IN LINES 11,</span>
        <span style="color:#212121;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">18,</span>
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">26, 34, 40</span>
        <span style="color:#343434;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">,</span>
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">AND 55.1:</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:10pt">
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">VOLUMES WERE ALLOCATED PRORATA TO</span>
        <span style="color:#212121;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">"DISCOUNTED</span>
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">RATE",</span>
        <span style="color:#212121;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">"NEGOTIATED</span>
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">RATE", AND</span>
        <span style="color:#212121;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">"RECOURSE</span>
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">RATE</span>
        <span style="color:#343434;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">"</span>
        <span style="color:#111111;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">BASED ON THE ACTUAL VOLUMES PRESENTED ON LINE</span>
        <span style="color:#212121;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">4</span>
        <span style="color:#444444;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">.</span>
      </div>
    </link:footnote>
