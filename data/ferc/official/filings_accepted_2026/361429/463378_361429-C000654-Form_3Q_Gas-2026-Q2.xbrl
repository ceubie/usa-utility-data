    <link:footnote xlink:type="resource" xlink:label="fn-18" id="fn-18" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:3pt">
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%">FOOTNOTE TO INSTRUCTION 5:</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:8pt">
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">TRANSCONTINENTAL GAS PIPE LINE COMPANY</span>
        <span style="color:#313131;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">,</span>
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">LLC DOES NOT BUNDLE SALES AND TRANSPORTATION SERVICES</span>
        <span style="color:#313131;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">.</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:8pt">
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%">FOOTNOTE TO INSTRUCTION 7:</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:8pt">
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">ALL QUANTITIES OF GAS WERE SUBJECT TO COMMISSION REGULATION.</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:8pt">
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%">FOOTNOTE TO INSTRUCTION 9 (3):</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:8pt">
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">CONTRACT STORAGE QUANTITIES ARE AS FOLLOWS:</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:8pt">
        <table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%">
          <tr>
            <td style="width:1.0%"/>
