    <link:footnote xlink:type="resource" xlink:label="fn-14" id="fn-14" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="text-align:justify">
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%">IN THE FIRST QUARTER, 21.34% OF THE TOTAL GAS RECEIVED FROM SHIPPERS AS FUEL REIMBURSEMENT WAS CALCULATED TO BE RECEIVED AS LOST AND UNACCOUNTED FOR</span>
        <span style="color:#4d4d4d;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%">.</span>
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%">THIS PERCENTAGE WAS DERIVED FROM THE DATA UNDERLYING THE 2026 FUEL TRACKER FILING</span>
        <span style="color:#4d4d4d;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%">.</span>
        <span style="color:#4d4d4d;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">.</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="text-align:justify">
        <span>
          <br/>
        </span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml" style="text-align:justify">
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%">IN THE SECOND QUARTER, 20.99% OF THE TOTAL GAS RECEIVED FROM SHIPPERS AS FUEL REIMBURSEMENT WAS CALCULATED TO BE RECEIVED AS LOST AND UNACCOUNTED FOR. THIS PERCENTAGE WAS DERIVED FROM THE DATA UNDERLYING THE 2026 FUEL TRACKER FILING.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-15" id="fn-15" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="text-align:justify">
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%">IN THE SECOND QUARTER, 20.99% OF THE TOTAL GAS RECEIVED FROM SHIPPERS AS FUEL REIMBURSEMENT WAS CALCULATED TO BE RECEIVED AS LOST AND UNACCOUNTED FOR</span>
        <span style="color:#4d4d4d;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%">.</span>
        <span style="color:#131313;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%">THIS PERCENTAGE WAS DERIVED FROM THE DATA UNDERLYING THE 2026 FUEL TRACKER FILING</span>
        <span style="color:#4d4d4d;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%">.</span>
      </div>
    </link:footnote>
