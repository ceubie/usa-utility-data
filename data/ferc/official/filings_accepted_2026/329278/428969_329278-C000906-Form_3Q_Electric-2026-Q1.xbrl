    <link:footnote xlink:type="resource" xlink:label="HH34DAE32DB80CF86B8EC4D3A400FE5ACF" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Expenses associated with Respondent's membership with PJM Interconnection, LLC as a Regional Transmission Operator.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHBAFCF886FEB10619A7FEF36D14DE6390" xlink:to="HH34DAE32DB80CF86B8EC4D3A400FE5ACF" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0B780BD22E0F049995011C2FC9ABED59" xlink:label="HH0B780BD22E0F049995011C2FC9ABED59" />
    <link:footnote xlink:type="resource" xlink:label="HHF6DD9D9858D3CBEA7E6BA82662583A0D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Column (b) reports the coincidental peak at the time of the Allegheny Power peak.&#160; Reports MW's of energy used for load integrated over the hour.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0B780BD22E0F049995011C2FC9ABED59" xlink:to="HHF6DD9D9858D3CBEA7E6BA82662583A0D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH194F229536B9C0A26814654D16FD3C7E" xlink:label="HH194F229536B9C0A26814654D16FD3C7E" />
    <link:footnote xlink:type="resource" xlink:label="HH01023AE97DF5124F8516DDCF7E27F049" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Column (g), it is assumed that PJM will report these.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH194F229536B9C0A26814654D16FD3C7E" xlink:to="HH01023AE97DF5124F8516DDCF7E27F049" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0C3AE22D2F62EA24E57862BC59902EA1" xlink:label="HH0C3AE22D2F62EA24E57862BC59902EA1" />
    <link:footnote xlink:type="resource" xlink:label="HH4ADFAC248566621F92E5EA3E56F46362" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Column (c) reports the coincidental peak at the time of the Allegheny Power peak.&#160;&#160;</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0C3AE22D2F62EA24E57862BC59902EA1" xlink:to="HH4ADFAC248566621F92E5EA3E56F46362" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHC028C9DF1313B0FDFAE2BFD4D348792F" xlink:label="HHC028C9DF1313B0FDFAE2BFD4D348792F" />
    <link:footnote xlink:type="resource" xlink:label="HH0A378924E042D631D9F2689111820E5C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Column (d) reports the coincidental peak at the time of the Allegheny Power peak.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC028C9DF1313B0FDFAE2BFD4D348792F" xlink:to="HH0A378924E042D631D9F2689111820E5C" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH5F3CE1971EBF3ECA4BFCD844F5BE815B" xlink:label="HH5F3CE1971EBF3ECA4BFCD844F5BE815B" />
    <link:footnote xlink:type="resource" xlink:label="HH6812825C97DF30A939B0F28273B0711B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Column (e) reports MW's of energy used for load integrated over the hour.&#160; Reports next-day settlement which is based on historical usage, as opposed to actual usage, with losses and adjustment factors applied.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH5F3CE1971EBF3ECA4BFCD844F5BE815B" xlink:to="HH6812825C97DF30A939B0F28273B0711B" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH1D6AC0DF20B59EE76A328DC4E3BCFFC7" xlink:label="HH1D6AC0DF20B59EE76A328DC4E3BCFFC7" />
    <link:footnote xlink:type="resource" xlink:label="HH8361EC3F99AE2D416B7DD46CEBD9BE88" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Column (f) reports MW's of energy used for load integrated over the hour.&#160; Reports next-day settlement which is based on historical usage, as opposed to actual usage, with losses and adjustment factors applied.</span>
        </p>
      </div>
    </link:footnote>
