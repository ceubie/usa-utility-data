&lt;td style="width: 254.2pt; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: top;" colspan="2"&gt;
&lt;p style="margin-top: 2.65pt; margin-left: 6pt; margin-bottom: 1.5pt; page-break-after: avoid; line-height: 115%; font-size: 9pt;"&gt;&lt;span style="font-family: Arial;"&gt;Temporary Cash Investments (Account 136)&lt;/span&gt;&lt;/p&gt;
