&lt;/td&gt;
&lt;td style="width: 154.427px; border: 0.75pt solid #000000; padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top; height: 18px;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; line-height: normal;"&gt;&lt;font style="text-decoration: underline; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/font&gt;&lt;font style="text-decoration: underline;"&gt;22,510&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
