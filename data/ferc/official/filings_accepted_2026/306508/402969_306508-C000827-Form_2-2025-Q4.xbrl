&lt;tr style="height: 18px;"&gt;
&lt;td style="width: 160.226px; border: 0.75pt solid #000000; padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top; height: 18px;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: normal;"&gt;Intangible Plant&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 148.49px; border: 0.75pt solid #000000; padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top; height: 18px;"&gt;
