  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="f-4" contextRef="c-1">&lt;div style="padding-right:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;4. None.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
  <ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock id="f-5" contextRef="c-1">&lt;div style="padding-right:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;5. None.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock>
  <ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock id="f-6" contextRef="c-1">&lt;div style="padding-right:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;6. None.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock>
  <ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock id="f-7" contextRef="c-1">&lt;div style="padding-right:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;7. None.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock>
  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="f-8" contextRef="c-1">&lt;div style="padding-right:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;8. None.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock>
  <ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock id="f-9" contextRef="c-1">&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:115%"&gt;9. None.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock>
  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="f-10" contextRef="c-1">&lt;div style="padding-right:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;10. None.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
  <ferc:DisclosureOfEstimatedIncreaseOrDecreaseInAnnualRevenuesCausedByImportantRateChangesTextBlock id="f-11" contextRef="c-1">&lt;div style="padding-right:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;11. None.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfEstimatedIncreaseOrDecreaseInAnnualRevenuesCausedByImportantRateChangesTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="f-12" contextRef="c-1">&lt;div style="padding-right:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;12. No change to the information reported in the Company's FERC Form No. 2/3-Q for the quarter ended March 31, 2026.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock id="f-13" contextRef="c-1">&lt;div style="padding-right:18pt;text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;13. None.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock>
  <ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock id="f-14" contextRef="c-1">&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt;A. Description of Business&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-style:italic;font-weight:400;line-height:120%"&gt;Nature of Business. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;Mountain Valley Pipeline, LLC (the Company) is a Delaware series limited liability company formed as a joint venture for the purpose of constructing and owning natural gas assets. The Company has three series, as follows (with each term defined below): MVP A, &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;which owns MVP Mainline; MVP B, which owns MVP Southgate; and MVP C, which owns certain assets associated with MVP Boost.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-style:italic;font-weight:400;line-height:120%"&gt;MVP LLC Agreement.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;The Company is organized under the Mountain Valley Pipeline, LLC Third Amended and Restated Limited Liability Company Agreement, dated April 6, 2018, as amended by that certain First Amendment, dated February 5, 2020, and that certain Second Amendment, dated November 1, 2025 (as amended, the MVP LLC Agreement)&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-style:italic;font-weight:400;line-height:120%"&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-style:italic;font-weight:400;line-height:120%"&gt;COM Agreements. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;MVP A and MVP C are parties to that certain Second Amended and Restated Construction, Operation and Management Agreement with EQM Gathering Opco, LLC (EQM Gathering), a wholly owned subsidiary of EQT Corporation (EQT), dated November 1, 2025 (the Series A and C COM Agreement). The Series A and C COM Agreement replaced that certain Amended and Restated Construction, Operation and Management Agreement, by and between MVP A and EQM Gathering, dated June 16, 2015.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;MVP B is party to that certain Construction, Operation and Management Agreement with EQM Gathering, dated April 6, 2018, as amended by that certain First Amendment thereto dated October 3, 2025 (the Series B COM Agreement and, together with the Series A and C COM Agreement, the COM Agreements).&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;Under the COM Agreements, EQM Gathering serves as the operator for each series of the Company and is responsible for construction, operation and management services with respect to MVP A, MVP B and MVP C. EQT's employees provide operational support and manage the Company's daily business operations. &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-style:italic;font-weight:400;line-height:120%"&gt;Mountain Valley Pipeline, LLC &#8211; Series A (MVP A).&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;MVP A&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;is a series of the Company formed for the purpose of constructing and owning the Mountain Valley Pipeline (MVP Mainline). MVP Mainline is a 303-mile long, 42-inch diameter natural gas interstate pipeline that spans from Wetzel County, West Virginia to Pittsylvania County, Virginia. MVP Mainline has a capacity of 2.0 billion cubic feet (Bcf) per day and is fully subscribed under 20-year firm commitments.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;The Company has applied for regulatory approval for a compression expansion project intended to increase capacity on the MVP Mainline. See discussion of MVP Boost below.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;As of June 30, 2026, MVP A's members consisted of PipeBox LLC (PipeBox), a joint venture in which a wholly owned subsidiary of EQT is a member, and affiliates of each of NextEra Energy, Inc. (NextEra), AltaGas Ltd. (AltaGas), RGC Resources, Inc. (RGC) and VED NPI IV, LLC (Vega). As of June 30, 2026, each member&#8217;s ownership interest in MVP A was as follows: PipeBox &#8211; 53.24%; NextEra &#8211; 36.03%; AltaGas &#8211; 10.00%; RGC &#8211; 0.73%; and Vega &#8211; 0.00%. Vega's interest in MVP A has limited rights and obligations relative to the other MVP A members, as set forth in the MVP LLC Agreement. See "MVP A and MVP C Interest Acquisitions" below for a discussion of changes in ownership interests that occurred during the first quarter of 2026.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-style:italic;font-weight:400;line-height:120%"&gt;Mountain Valley Pipeline, LLC &#8211; Series B (MVP B). &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;MVP B&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;is a series of the Company formed for the purpose of constructing and owning the MVP Southgate project (MVP Southgate). MVP &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;Southgate is an interstate pipeline project that is expected to extend approximately 31 miles from the terminus of MVP Mainline in Pittsylvania County, Virginia to planned new delivery points in Rockingham County, North Carolina using 30-inch diameter pipe, with a projected capacity of 0.55 Bcf per day.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;The FERC authorized the Company to proceed with construction of the MVP Southgate facilities in Virginia on March 23, 2026 and in North Carolina on June 18, 2026. As a result of the FERC authorizations, the Company&#8217;s performance guarantee requirements were updated (see Note "Guarantees"). MVP Southgate is expected to be placed into service by mid-2028.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;As of June 30, 2026, MVP B's members consisted of affiliates of each of EQT, NextEra, AltaGas and RGC. As of June 30, 2026, each member&#8217;s ownership interest in MVP B was as follows: EQT &#8211; 47.20%; NextEra &#8211; 47.20%; AltaGas &#8211; 5.10%; and RGC &#8211; 0.50%.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-style:italic;font-weight:400;line-height:120%"&gt;Mountain Valley Pipeline, LLC &#8211; Series C (MVP C). &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;MVP C&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;is a series of the Company formed on November 1, 2025 for the purpose of constructing and owning certain assets associated with the MVP Boost project (MVP Boost). MVP Boost is a contemplated project to add compression to MVP Mainline. MVP Boost is projected to increase the capacity on MVP Mainline by 0.6 Bcf per day. As designed, MVP Boost would add compression at three existing compressor stations in West Virginia and construct a new compressor station in Montgomery County, Virginia. &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;On October 23, 2025, the Company filed an application with the FERC for authorization to construct MVP Boost. Pending receipt of regulatory approvals, MVP Boost is expected to be placed into service by mid-2028. &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;As of June 30, 2026, MVP C's members consisted of affiliates of each of EQT, NextEra, AltaGas, RGC and Vega. As of June 30, 2026, each member's ownership interest in MVP C was as follows: EQT &#8211; 53.25%; NextEra &#8211; 36.02%; AltaGas &#8211; 10.00%; RGC &#8211; 0.73%; and Vega &#8211; 0.00%. Vega's interest in MVP C has limited rights and obligations relative to the other members, as set forth in the MVP LLC Agreement. See "MVP A and MVP C Interest Acquisitions" below for a discussion of changes in ownership interests that occurred during the first quarter of 2026.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-style:italic;font-weight:400;line-height:120%"&gt;MVP A and MVP C Interest Acquisitions. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;On January 20, 2026, NextEra completed its acquisition of an approximately 2.66% interest in each of MVP A and MVP C from an affiliate of Con Edison Gas Pipeline and Storage, LLC (ConEd). On March 30, 2026, PipeBox completed its acquisition of ConEd's remaining approximately 3.94% interest in MVP A, and EQT completed its acquisition of ConEd's remaining approximately 3.94% interest in MVP C. Following these acquisitions, ConEd is no longer a member of MVP A and MVP C.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-style:italic;font-weight:400;line-height:120%"&gt;Basis of Presentation. &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;These Financial Statements were prepared in accordance with the accounting requirements of the FERC as set forth in its Uniform System of Accounts and published accounting releases, which is a comprehensive basis of accounting other than generally accepted accounting principles (GAAP). Differences between the Financial Statements and GAAP include differences related to income taxes, purchase accounting and the classification of certain accounts in the Balance Sheets, Statements of Income and Statements of Cash Flows.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;Due to the seasonal nature of the Company's utility customer contracts, the results of operations for the three and six months ended June 30, 2026 are not necessarily indicative of the results that may be expected for the year ended December 31, 2026.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;--------------&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt;B. Rate and Other Regulatory Matters&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;On November 6, 2018, the Company filed an application in Docket No. CP19-14 under Section 7(c) of the Natural Gas Act to construct and operate MVP Southgate. MVP Southgate was originally designed to provide up to 375,000 Dekatherms (Dth) per day of firm transportation service to a delivery point with Public Service Company of North Carolina, Inc. (PSNC) near Graham, North Carolina. MVP Southgate originally proposed to consist of approximately 73 miles of pipe, one compressor station, associated valves, piping and appurtenant facilities commencing near Chatham, Virginia. FERC issued the Final Environmental Impact Statement on February 14, 2020, and the Company received its certificate on June 18, 2020. On December 19, 2023, the Company received a three-year extension of time, until June 18, 2026, to complete construction of MVP Southgate. In late December 2023, the Company entered into precedent agreements with PSNC and Duke Energy Carolinas, LLC. These precedent agreements contemplate an amended project (in lieu of the originally certificated project) for which the Amendment Application was filed with FERC on February 3, 2025 in Docket No. CP25-60. The amended project will extend approximately 31 miles from the terminus of MVP Mainline in Pittsylvania County, Virginia to planned new delivery points in Rockingham County, North Carolina using 30-inch diameter pipe. The new precedent agreements collectively provide for 550,000 Dth per day of firm capacity commitments. On October 3, 2025, FERC issued the Environmental Assessment for the amended project, and on December 18, 2025, FERC issued an Order Amending Certificate approving the amended project. On March 23, 2026, the FERC approved the Company's request to proceed with the construction of the MVP Southgate facilities in Virginia, and the Company commenced construction of the Virginia facilities on March 24, 2026. On June 24, 2026, the FERC approved the Company's request to proceed with the construction of the MVP Southgate facilities in North Carolina, and the Company commenced construction of the North Carolina facilities on June 30, 2026. The targeted completion timing for MVP Southgate is mid-2028.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;On October 23, 2025, the Company filed an application in Docket No. CP26-14 under Section 7(c) of the Natural Gas Act to construct and operate MVP Boost. MVP Boost is designed to provide up to 600,000 Dth per day of additional firm transportation service on MVP Mainline. MVP Boost would add compression at three existing compressor stations on MVP Mainline in West Virginia and construct a new compressor station in Montgomery County, Virginia. On August 7, 2026, FERC issued the Environmental Assessment for the project. MVP Boost is targeted to be in service by mid-2028.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#ffffff;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;--------------&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt;C. Related Party Transactions&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;In the ordinary course of business, the Company has transactions with related parties.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;The Company has entered into a 20-year transportation service agreement with each of its members or an affiliate of each member (excluding NextEra and Vega) to transport natural gas on MVP Mainline. Under these transportation service agreements, the Company has contracted firm transportation commitments totaling approximately 1.7 Bcf per day on MVP Mainline, subject to any future capacity releases.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="background-color:#ffffff;color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;The Company recognized revenues from MVP A members o&lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;f $127.1&#160;million for both the three months ended June 30, 2026 and 2025 and $263.9 million &lt;/span&gt;&lt;span style="background-color:#ffffff;color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;and $251.6 million for the &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;six&lt;/span&gt;&lt;span style="background-color:#ffffff;color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt; months ended &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;June 30, 2026&lt;/span&gt;&lt;span style="background-color:#ffffff;color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt; and &lt;/span&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;2025&lt;/span&gt;&lt;span style="background-color:#ffffff;color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;, respectively.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;Pursuant to the COM Agreements, EQM Gathering serves as operator of the Company, with EQT's employees providing operational support and managing the Company's daily business operations. Costs incurred by EQM Gathering and its affiliates related to the development, construction, marketing and operation of the Company's assets are reimbursable by the Company.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:120%"&gt;The tables below summarize the Company's related party amounts.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:100.000%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:36.995%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:13.780%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.395%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:13.780%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.395%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:13.780%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.395%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:14.380%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="9" style="padding:1.5pt 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt;Three Months Ended June 30,&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="9" style="padding:1.5pt 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:700;line-height:120%"&gt;Six Months Ended June 30,&lt;/span&gt;&lt;/td&gt;&lt;td colspan="3" style="display:none"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="3" style="border-top:1pt solid #000;padding:1.5pt 1pt;text-align:center;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12p