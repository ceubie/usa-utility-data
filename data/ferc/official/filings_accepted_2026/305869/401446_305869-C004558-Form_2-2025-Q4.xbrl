  <ferc:ComputationOfTax id="Tag1165" contextRef="C472" unitRef="USD" decimals="0">5461158</ferc:ComputationOfTax>
  <ferc:ComputationOfTaxDescription id="Tag1166" contextRef="C472">21% of Taxable Income</ferc:ComputationOfTaxDescription>
  <ferc:ComputationOfTax id="Tag1167" contextRef="C474" unitRef="USD" decimals="0">80</ferc:ComputationOfTax>
  <ferc:ComputationOfTaxDescription id="Tag1168" contextRef="C474">Return to Provision/Other</ferc:ComputationOfTaxDescription>
  <ferc:ComputationOfTax id="Tag1169" contextRef="C476" unitRef="USD" decimals="0">5461238</ferc:ComputationOfTax>
  <ferc:ComputationOfTaxDescription id="Tag1170" contextRef="C476">Federal Income Tax - Current</ferc:ComputationOfTaxDescription>
  <ferc:OrderNumber id="Tag1171" contextRef="C460" unitRef="Pure" decimals="0">5</ferc:OrderNumber>
  <ferc:OrderNumber id="Tag1172" contextRef="C461" unitRef="Pure" decimals="0">8</ferc:OrderNumber>
  <ferc:OrderNumber id="Tag1173" contextRef="C462" unitRef="Pure" decimals="0">9</ferc:OrderNumber>
  <ferc:OrderNumber id="Tag1174" contextRef="C463" unitRef="Pure" decimals="0">10</ferc:OrderNumber>
  <ferc:OrderNumber id="Tag1175" contextRef="C464" unitRef="Pure" decimals="0">11</ferc:OrderNumber>
