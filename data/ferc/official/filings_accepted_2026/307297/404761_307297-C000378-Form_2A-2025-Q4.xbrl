&lt;td style="width: 4.07272%; height: 27px; text-align: center;"&gt;&lt;font style="font-size: 16pt; font-family: arial, helvetica, sans-serif;"&gt;78,949&lt;/font&gt;&lt;/td&gt;
&lt;/tr&gt;
