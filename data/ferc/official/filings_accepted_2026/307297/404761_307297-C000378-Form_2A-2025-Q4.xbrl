&lt;td style="width: 3.88171%; height: 20px; text-align: center;"&gt;&lt;font style="font-size: 16pt; font-family: arial, helvetica, sans-serif;"&gt;21,117&lt;/font&gt;&lt;/td&gt;
&lt;td style="width: 4.07272%; height: 20px; text-align: center;"&gt;&lt;font style="font-size: 16pt; font-family: arial, helvetica, sans-serif;"&gt;(324,101)&lt;/font&gt;&lt;/td&gt;
