&lt;td style="width: 3.88171%; height: 27px; text-align: center;"&gt;&lt;font style="font-size: 16pt; font-family: arial, helvetica, sans-serif;"&gt;($3,122)&lt;/font&gt;&lt;/td&gt;
&lt;td style="width: 4.07272%; height: 27px; text-align: center;"&gt;&lt;font style="font-size: 16pt; font-family: arial, helvetica, sans-serif;"&gt;$322,971&lt;/font&gt;&lt;/td&gt;
