        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-2505_lbl" order="0" xlink:to="ft-2505_47403_lbl" />
        <link:footnote xlink:label="ft-37_46922_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 278 Line No.: 1 Column: a</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Pursuant to Section 36 of the General Terms and Conditions of Tiger's FERC Gas Tariff, First Revised Volume No. 1, Docket No. RP25-113-000, as approved by <span style="font-size: 12pt; line-height: 107%">FERC's order </span> issued on November 14, 2024, Docket No. RP25-857-000, as approved by <span style="font-size: 12pt; line-height: 107%">FERC's order </span> issued on May 21, 2025, and Docket No. RP26-121-000, as approved by <span style="font-size: 12pt; line-height: 107%">FERC's order </span> issued on November 18, 2025.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-122_46923_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource">Original value: N</link:footnote>
        <link:footnote xlink:label="ft-499_46987_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 220 Line No.: 7 Column: e</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Tiger has no storage facilities, therefore account 117.4 is used to record operational fluctuations in line pack.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-503_46986_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 220 Line No.: 5 Column: i</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Tiger utilizes the fixed asset method of accounting for system line pack.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-562_46991_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 313 Line No.: 1 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">The volumes in columns (c) and (e) include Contract Maximum Daily Quantities.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-591_46992_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 350 Line No.: 1 Column: e</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Account 186, Miscellaneous deferred debits was used to record deferred charges for regulatory commission expense. This footnote applies to columns (e), (i) and (l), lines 1 and 2.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-707_46994_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 118 Line No.: 14 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">ETC Tiger Pipeline, LLC, as a limited liability company, records member's equity in Other Paid-In Capital.</span></span></p><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Statement of Retained Earnings (unaudited).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-791_46995_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1404px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-845_47014_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 520 Line No.: 20 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">For the purposes of the Annual Charge Adjustment ("ACA") calculation, the throughput volume is 723,046,480 Dth as represented on line 20, column (c). No additional volumes are needed to calculate the volumes eligible for the ACA Surcharge.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-872_47013_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1404px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-924_47016_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 521 Line No.: 7 Column: f</span></span></h2><p><span style="font-size: 12pt; line-height: 107%; font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">The basis for valuing the gas reported in columns (f), (g) and (h) is the Gas Daily monthly average index at East Texas, North Louisiana, and Carthage Hub.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1055_47015_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 521 Line No.: 7 Column: e</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The allocation is derived by determining whether the reservation rate charged within the billing system is discounted, negotiated or recourse. This determination is applied to the retained fuel charged per contract scheduled path, and a pro rata allocation is derived and applied to all volumes and dollars. </span></span></p><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">T</span></span><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">he footnote also applies to column (e), lines 14, 22, 30, 37, 51, and 65.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2096_47051_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 336 Line No.: 10 Column: b</span></span></h2><p><span style="font-size: 12pt; line-height: 107%; font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">General plant is depreciated on a straight line basis per assigned FERC rates.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2103_47052_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 338 Line No.: 7 Column: b</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Depreciation plant basis reflects balance as of 12/31/2025. This footnote also applies to lines 8 and 9, column (b).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2137_47319_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1404px; min-height: 0" alt="" /> </p></link:footnote>
