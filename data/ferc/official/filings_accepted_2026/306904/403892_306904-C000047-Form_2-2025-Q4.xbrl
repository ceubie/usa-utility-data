              <xhtml:td class="xl119" style="width: 10.0469px; height: 15px;">
              </xhtml:td>
              <xhtml:td class="xl119" style="width: 133.609px; height: 15px; text-align: right;">$(4,016,351)<xhtml:br /><xhtml:br /></xhtml:td>
