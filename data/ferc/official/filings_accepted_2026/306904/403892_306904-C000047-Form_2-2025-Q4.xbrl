&lt;/td&gt;
&lt;td style="width: 3pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt;"&gt;&lt;font style="font-family: Arial; font-size: 10pt;"&gt; &amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 66.75pt; padding-right: 0.75pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; text-align: right; font-size: 10pt;"&gt;&lt;font style="font-size: 10pt;"&gt;&lt;font style="font-family: Arial;"&gt;$&lt;/font&gt;&lt;font style="width: 10.84pt; font-family: Arial; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 16.4pt;"&gt; &amp;#160;&lt;/font&gt;&lt;font style="font-family: Arial;"&gt;1,560,172&lt;/font&gt;&lt;font style="width: 3.21pt; font-family: Arial; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 64.1pt;"&gt; &amp;#160;&lt;/font&gt;&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
