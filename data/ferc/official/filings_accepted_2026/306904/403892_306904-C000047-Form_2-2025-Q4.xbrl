&lt;tr style="height: 14.25pt; -aw-height-rule: exactly;"&gt;
&lt;td style="width: 113.95pt; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 2.65pt; margin-left: 6pt; margin-bottom: 1.5pt; font-size: 10pt;"&gt;&lt;font style="font-family: Arial; font-size: 10pt;"&gt;Northern Access Project&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
