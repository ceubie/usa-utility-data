  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:label="value9" xlink:href="#Tag147" />
    <link:loc xlink:type="locator" xlink:label="value6" xlink:href="#Tag177" />
    <link:loc xlink:type="locator" xlink:label="value7" xlink:href="#Tag182" />
    <link:loc xlink:type="locator" xlink:label="value8" xlink:href="#Tag264" />
    <link:loc xlink:type="locator" xlink:label="value5" xlink:href="#Tag366" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote5" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Caddo Pipeline LLC is managed by its Members, who act through a Board. Each Member appoints two Board Members to act on its behalf. The Board Members are listed on page 105.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">The Board may designate and appoint one or more persons to serve as Officers of the Company with the authority to perform such duties as delegated by the Board. The Designated Officers are listed on page 104.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value5" xlink:to="footnote5" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="5" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote6" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Chain of Ownership: </xhtml:p>
        <xhtml:p>Delek US Holdings, Inc. - DE </xhtml:p>
        <xhtml:p>Delek US Energy, Inc . - DE </xhtml:p>
        <xhtml:p>Delek Logistics Services Company - DE </xhtml:p>
        <xhtml:p>Delek Logistics GP, LLC - DE </xhtml:p>
        <xhtml:p>Delek Logistics Partners, LP. - DE </xhtml:p>
        <xhtml:p>Delek Logistics Operating, LLC - DE </xhtml:p>
        <xhtml:p>DKL Caddo LLC - DE </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value6" xlink:to="footnote6" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="6" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote7" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Chain of Ownership: </xhtml:p>
        <xhtml:p>PAA GP Holdings LLC - DE </xhtml:p>
        <xhtml:p>Plains GP Holdings, L.P. - DE </xhtml:p>
        <xhtml:p>Plains All American GP LLC - DE </xhtml:p>
        <xhtml:p>Plains AAP, L.P. - DE </xhtml:p>
        <xhtml:p>PAA GP LLC - DE </xhtml:p>
        <xhtml:p>Plains All American Pipeline, L.P. - DE </xhtml:p>
        <xhtml:p>Plains GP LLC. - TX </xhtml:p>
        <xhtml:p>Plains Pipeline, L.P. - TX </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value7" xlink:to="footnote7" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="7" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote8" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p style="language: en-US; line-height: normal; text-indent: 0in; direction: ltr; unicode-bidi: embed; mso-vertical-align-alt: auto; mso-line-break-override: none; word-break: normal; punctuation-wrap: hanging; margin: 0pt 0in 0pt 0in;">
          <xhtml:span style="font-size: 12pt; font-family: arial, helvetica, sans-serif; color: black; font-weight: normal; font-style: normal; vertical-align: baseline;">Current year distributions were $21,655,000, which exceeded unappropriated retained income by $5,590,306 as of December 31, 2025.  Such excess was recorded against additional paid-in capital.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value8" xlink:to="footnote8" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="8" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote9" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p style="language: en-US; line-height: normal; text-indent: 0in; direction: ltr; unicode-bidi: embed; mso-vertical-align-alt: auto; mso-line-break-override: none; word-break: normal; punctuation-wrap: hanging; margin: 0pt 0in 0pt 0in;">
          <xhtml:span style="font-size: 11pt; font-family: arial, helvetica, sans-serif; color: black; font-weight: normal; font-style: normal; vertical-align: baseline;">Caddo Pipeline LLC has adopted the Association of Oil Pipelines Accounting Guideline 3-13, "Equity Reporting for Non-corporate Filers" (the "guideline").<xhtml:span style="mso-spacerun: yes;"></xhtml:span>The guideline suggests that any distributions in excess of the positive balance in unappropriated retained income should be recorded against additional paid-in capital.<xhtml:span style="mso-spacerun: yes;"></xhtml:span>Current year distributions were $21,655,000, which exceeded unappropriated retained income by $5,590,306 as of December 31, 2025.<xhtml:span style="mso-spacerun: yes;"></xhtml:span>Such excess was recorded against additional paid-in capital.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value9" xlink:to="footnote9" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="9" />
  </link:footnoteLink>
</xbrli:xbrl>
