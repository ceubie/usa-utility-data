  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-1" contextRef="c-1">Amy Perlman</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:TitleOfOfficerWithCustodyOfCorporateBooks id="f-2" contextRef="c-1">Vice President and Chief Accounting Officer - ITC Holdings Corp.</ferc:TitleOfOfficerWithCustodyOfCorporateBooks>
  <ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription id="f-3" contextRef="c-1">Not applicable</ferc:GeneralInformationAboutPropertyOfTheRespondentHeldByReceiverOrTrusteeDescription>
  <ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered id="f-4" contextRef="c-1">Transmission of electricity within the states of Kansas and Oklahoma.</ferc:GeneralInformationAboutStatesInWhichRespondentServicesWereRendered>
  <ferc:GeneralInformationChangeInAuditorFlag id="f-5" contextRef="c-1">false</ferc:GeneralInformationChangeInAuditorFlag>
  <ferc:NameOfOfficerWithCustodyOfCorporateBooks id="f-6" contextRef="c-1">Amy Perlman</ferc:NameOfOfficerWithCustodyOfCorporateBooks>
  <ferc:TitleOfOfficerWithCustodyOfCorporateBooks id="f-7" contextRef="c-1">Vice President and Chief Accounting Officer - ITC Holdings Corp.</ferc:TitleOfOfficerWithCustodyOfCorporateBooks>
