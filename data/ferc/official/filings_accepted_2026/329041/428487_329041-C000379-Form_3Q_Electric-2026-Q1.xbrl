&lt;td style="width: 1.68%; border-top-style: solid; border-top-width: 0.75pt; border-bottom-style: double; border-bottom-width: 2.25pt; padding-top: 0.32pt; padding-right: 0.7pt; vertical-align: bottom; background-color: #ffffff;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;$&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 21.42%; border-top-style: solid; border-top-width: 0.75pt; border-bottom-style: double; border-bottom-width: 2.25pt; padding-top: 0.32pt; padding-right: 0.7pt; vertical-align: bottom; background-color: #ffffff;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;(13&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 1.54%; border-top-style: solid; border-top-width: 0.75pt; border-bottom-style: double; border-bottom-width: 2.25pt; padding-top: 0.32pt; padding-right: 0.7pt; vertical-align: bottom; background-color: #ffffff;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;)&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
