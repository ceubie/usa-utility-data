&lt;/td&gt;
&lt;td style="width: 1.56%; padding-top: 0.7pt; padding-right: 0.7pt; vertical-align: bottom; background-color: #ffffff;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; page-break-after: avoid; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
