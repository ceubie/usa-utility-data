&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; page-break-after: avoid; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Fair Value&lt;/span&gt;&lt;br /&gt;&lt;span style="font-family: 'Times New Roman';"&gt;(Net) at&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
