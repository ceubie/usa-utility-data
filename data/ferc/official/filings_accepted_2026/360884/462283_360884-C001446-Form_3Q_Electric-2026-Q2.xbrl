&lt;p class="MsoNormal" style="text-align: right; tab-stops: 42.45pt 60.35pt; margin: 1.65pt 0in 1.5pt 0in;" align="right"&gt;&lt;strong style="mso-bidi-font-weight: normal;"&gt;&lt;font style="font-size: 9.0pt; mso-bidi-font-size: 12.0pt; font-family: 'Arial',sans-serif; mso-fareast-font-family: Arial; color: black;"&gt;$&lt;font style="mso-tab-count: 1;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/font&gt;100&lt;font style="mso-tab-count: 1;"&gt;&amp;#160; &lt;/font&gt;&lt;/font&gt;&lt;/strong&gt;&lt;/p&gt;
