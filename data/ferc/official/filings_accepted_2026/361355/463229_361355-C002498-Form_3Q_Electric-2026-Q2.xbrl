					&lt;span style="font-family:Aptos"&gt;Operating revenues:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5.5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
