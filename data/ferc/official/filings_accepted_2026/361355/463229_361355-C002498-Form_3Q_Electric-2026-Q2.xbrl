    <link:footnote xlink:type="resource" xlink:label="HH7818569F59E1F656EB28327A568C7369" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 182pt;" border="0" width="243" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 52.5pt;">
              <td class="xl67" style="height: 52.5pt; width: 182pt;" width="243" height="70">Page 300 Line 11 Column D</td>
            </tr>
          </tbody>
        </table>
        <table style="width: 569pt;" border="0" width="758" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 52.5pt;">
              <td class="xl69" style="height: 52.5pt; width: 569pt;" colspan="6" width="758" height="70">Pursuant to FERC Order 668, for FERC purposes MGE nets RTO day-ahead and real-time energy market activity separately on an hourly basis. For PSCW and SEC reporting, the RTO hourly day-ahead and real-time activity is combined for netting purposes. Due to the netting difference, Sales for Resale are<span class="font8" style=""> 143,103</span><span class="font5" style=""> &#160;greater for FERC purposes than PSCW or SEC purposes for the </span><span class="font8" style="">six</span><span class="font5" style=""> months ended </span><span class="font8" style="">Jun 30, 2026</span><span class="font5" style="">.</span></td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH9DEE2502BD5CAAE264B044B8DE093084" xlink:to="HH7818569F59E1F656EB28327A568C7369" order="1" />
