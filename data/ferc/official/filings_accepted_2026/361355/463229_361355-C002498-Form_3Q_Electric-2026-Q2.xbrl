  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="HH1C967D5CB7055C23C61684D3A8ADDA65" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
  <ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock id="HH3753C2D0F64441EEC1CB77241E2239DC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantExtensionOrReductionOfTransmissionOrDistributionSystemTextBlock>
  <ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock id="HH2FB9527C1D4BB25D79F1C0C76F5BC95D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;span style="font-family: Aptos, sans-serif; font-size: 14.6667px;"&gt;Docket No. 3270-SB-137 regarding short-term notes and commercial paper was issued by the PSCW on September 24, 2018, which authorizes the Company to issue and have outstanding short-term notes and commercial paper up to a maximum amount of $130 million principal amount. MGE had $34.75 million of&lt;/span&gt;&lt;strong style="font-family: Aptos, sans-serif; font-size: 14.6667px;"&gt; &lt;/strong&gt;&lt;span style="font-family: Aptos, sans-serif; font-size: 14.6667px;"&gt;commercial paper outstanding as of June 30, 2026.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfObligationsIncurredOrAssumedByRespondentAsGuarantorForThePerformanceByAnotherOfAnyAgreementOrObligationTextBlock>
  <ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock id="HHDB4E63D65FD21AE5462A8FBA840EA717" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInArticlesOfIncorporationOrAmendmentsToCharterTextBlock>
  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="HHEBA1CD44839C108D1DAFD6DE3427BE45" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock>
  <ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock id="HH22FBAEA0509E80B804A4341B1670898A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfStatusOfAnyMateriallyImportantLegalProceedingsTextBlock>
  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="HH582A4E700260C05D782FA2D6F218758A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
  <ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock id="HHFB056E8F64ABA7B86B31B31B7725CE20" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantChangesRelatedToRespondentCompanyAppearingInAnnualReportToStockholdersTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock id="HHD790CCB2EDB33AB49E3957CEAFD4E7D7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantEventThatRespondentParticipatesInACashManagementProgramsTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;ol type="1" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-top:6pt; margin-left:14.29pt; padding-left:10.21pt; font-family:Calibri; font-size:12pt; font-weight:bold"&gt;&#xD;
					&lt;span&gt;Summary of Significa&lt;/span&gt;&lt;span&gt;nt Accounting Policies.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ol&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; page-break-after:avoid; font-size:8pt"&gt;&#xD;
				&lt;span style="font-family:Calibri; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ol type="a" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:41.48pt; page-break-after:avoid; padding-left:3.87pt; font-family:Calibri; font-size:12pt; font-weight:bold"&gt;&#xD;
					&lt;span&gt;Basis of Presentation.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ol&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:18pt; margin-bottom:0pt; text-indent:-18pt; page-break-after:avoid; font-size:8pt"&gt;&#xD;
				&lt;span style="font-family:Calibri; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:45.35pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;This report is a combined report of Madison Gas and Electric Company (MGE), MGE Power West Campus, and MGE Power Elm Road.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:45.35pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;MGE Power Elm Road and MGE Power West Campus own electric generating assets and lease those assets to MGE. Both entities are variable interest entities under applicable authoritative guidance. MGE is considered the primary beneficiary of these entities as a result of contractual agreements. As a result, MGE has consolidated MGE Power Elm Road and MGE Power West Campus. See Footnote 3 of Notes to Consolidated Financial Statements of MGE's 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; FERC Form&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:45.35pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;The accompanying consolidated FERC financial statements as of &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, and for the&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;three&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;and six &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;months then ended are unaudited and include all adjustments MGE management considers necessary for a fair presentation of the financial statements. All adjustments are of a normal, recurring nature except as otherwise disclosed. These financial statements were prepared in accordance with the accounting requirements of the Federal Energy Regulatory Commission (FERC) as set forth in its applicable Uniform System of Accounts and published accounting releases, and as adopted by the Public Service Commission of Wisconsin (PSCW), which is a comprehensive basis of accounting other than generally accepted accounting principles (GAAP).&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:45.35pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;The following items represent the significant differences between the FERC Uniform System of Accounts and GAAP:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:55.87pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC accounting does not include current and long-term classification of the following assets and liabilities:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Regulatory assets/liabilities, unamortized debt expense, and the current portion of long-term debt.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:55.87pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC accounting does not require reporting certain information about operating segments in complete sets of FERC financial statements.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:55.87pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC accounting does not require the reclassification of asset retirement obligations. If such reclassifications were recognized according to GAAP, the following FERC account categories would be impacted as of &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, and December&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;31, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, respectively:&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:75.55pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Net plant assets:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase (via reduction in accumulated depreciation) $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;72.8&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;69.3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:75.55pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Regulatory liabilities:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;48.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;46.0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:75.55pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Regulatory assets:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;24.7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;23.3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:59.52pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC accounting allows all components of net benefit costs to be eligible for capitalization. GAAP only allows the service cost component. If this report were prepared according to GAAP, the following FERC account categories would be impacted as of &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, and December&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;31, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, respectively:&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Utility plant:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$22.8&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;21.9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Construction work in progress:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;2.0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Other deferred assets:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;2&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Regulatory liabilities:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;24.9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;23.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:59.52pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC accounting allows right of use finance and operating leases to be presented in property, plant, and equipment. GAAP only allows right of use finance leases. If this report were prepared according to GAAP, the following FERC account categories would be impacted as of &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, and December&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;31, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;:&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Utility plant:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$7.2 million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Other deferred assets:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$7.2 million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:59.52pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Debt issuance costs are reported as unamortized debt expense and are not netted into current and long-term debt as required by GAAP. If this report were prepared according to GAAP, the following FERC accounts would be impacted as of &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June 30&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, and December&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;31, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, respectively:&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Unamortized debt expenses:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;4.6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;4.2&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Unamortized discount on long-term debt:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;4.6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;4.2&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:59.52pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC accounting does not require netting of deferred tax assets and liabilities on the balance sheet. If this report were prepared according to GAAP, the following FERC account categories would be impacted as of &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June 30&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, and December&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;31, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5, respectively&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;:&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Deferred tax assets:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;119.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and $105.0 million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Deferred tax liabilities:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;119.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and $105.0 million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:59.52pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC accounting does not require recognition of uncertainty in income taxes for temporary tax differences. If this report were prepared according to GAAP, the following FERC account categories would be impacted as of &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June 30&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, and December&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;31, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, respectively:&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Deferred income tax liabilities:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1.7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1.5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Accrued taxes:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0.7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0.6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Deferred tax assets:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1.0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Other regulatory assets:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Accrued interest liabilities:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:59.52pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC accounting does not require the reclassification of cloud computing hosting arrangement costs. If such reclassifications were recognized according to GAAP, the following FERC account categories would be impacted as of &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;30&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, and December&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;31, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, respectively:&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Utility Plant:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;24.6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$24.0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Accumulated Depreciation:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;18.9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;17.5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Construction work in progress:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;3.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$2.2&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Other deferred assets:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$8.8&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;8.7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:59.52pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC Form No.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1 includes interdepartmental revenue accounts 4480001 (electric) and 4840001 (gas). These interdepartmental revenues are eliminated for GAAP reporting. Below are the account balances for the three months ended &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5,&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, respectively.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Interdepartmental sales (electric):&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Less than &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and $0.1 million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Interdepartmental sales (gas):&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;4.9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;2.5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:54pt; margin-bottom:0pt; text-indent:13pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;Below are the account balances for the six months ended June&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;30, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6,&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, respectively:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Interdepartmental sales (electric):&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Less than &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Interdepartmental sales (gas):&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;13.9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;9.0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:67pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:67pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;During 2005, there was an interdepartmental margin resulting from gas sales to MGE Power West Campus during the WCCF construction. If this report were prepared according to GAAP, the following FERC account categories would be impacted as of &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June 30&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6,&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and December&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;31, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Utility plant:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $0.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Retained earnings:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $0.1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:59.52pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC accounting allows payments of operating and finance leases to be recognized as operating expenses. GAAP reporting records finance lease payments to depreciation and interest expense, as applicable. If this report were prepared according to GAAP, the following FERC account categories would be impacted for&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;the three months ended &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June 30&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, and 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5, respectively&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;:&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Depreciation expense:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$0.4 million and &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Other interest expense:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$0.1 million and &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Operating expenses:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and $0.6 million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:67pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:67pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;If this report were prepared according to GAAP, the following FERC account categories would be impacted for the six months ended June&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;30, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, and 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5, respectively&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Depreciation expense:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and $0.9 million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Other interest expense:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $0.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and $0&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;3 million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Operating expenses:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $1.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and $1.2 million&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:59.52pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;All components of net benefit cost are reported in the same line item or items as other compensation costs arising from services rendered by the pertinent employees during the period. GAAP only allows the service cost component. All other components are recorded outside operating income. If this report &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;were prepared according to GAAP, the following FERC account categories would be impacted for the three months ended &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June 30&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;2026, and 2025, respectively:&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Miscellaneous non-operating income:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $1.9 million and $0.3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Operating expenses:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $1.9 million and&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$0.3&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:67pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;If this report was prepared according to GAAP, the following FERC account categories would be impacted for the six months ended June&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;30, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6,&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, respectively:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Miscellaneous non-operating income:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;4.2&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0.7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Operating expenses:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Increase $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;4.2&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;0.7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;ul type="disc" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:59.52pt; padding-left:7.48pt; font-family:serif; font-size:12pt; -aw-font-family:'Symbol'; -aw-font-weight:normal; -aw-number-format:'&amp;#xF0B7;'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;FERC accounting requires hourly transactions with an RTO administered energy market to be reported separately within their respective RTO markets (day ahead or real time). GAAP accounting combines the transactions within an hour. If this report were prepared for GAAP purposes, the following FERC account categories would be impacted for the three months ended &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;June 30&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;6,&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; and 202&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;5&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;, respectively:&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;ul type="circle" style="margin:0pt; padding-left:0pt"&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Operating revenues:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$1.9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;$2.7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
				&lt;li style="margin-left:79.2pt; padding-left:5.8pt; font-family:serif; font-size:12pt; -aw-font-family:'Courier New'; -aw-font-weight:normal; -aw-number-format:'o'"&gt;&#xD;
					&lt;span style="font-family:Aptos"&gt;Operating expenses:&lt;/span&gt;&lt;span style="font-family:Aptos; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;Decrease $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;1.9&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million and $&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;2.7&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;million.&lt;/span&gt;&#xD;
				&lt;/li&gt;&#xD;
			&lt;/ul&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:45.35pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Calibri; "&gt;&amp;#160;&lt;/span&gt;&#xD;
