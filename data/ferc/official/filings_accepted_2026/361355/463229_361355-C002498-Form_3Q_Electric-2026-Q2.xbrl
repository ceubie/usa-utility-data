						&lt;td style="width:1.28%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:bottom; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; page-break-after:avoid; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Calibri; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
