    <link:footnote xlink:type="resource" xlink:label="HH507C31FFAD91CFFF4C59374C8C1A0080" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 188px; height: 34px;" border="0" width="243" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 59.25pt;">
              <td class="xl67" style="height: 59.25pt; width: 187.656px;" width="243" height="79">Page 300 Line 11 Column B</td>
            </tr>
          </tbody>
        </table>
        <table style="width: 569pt;" border="0" width="758" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 59.25pt;">
              <td class="xl69" style="height: 59.25pt; width: 569pt;" colspan="6" width="758" height="79">Pursuant to FERC Order 668, for FERC purposes MGE nets RTO day-ahead and real-time energy market activity separately on an hourly basis. For PSCW and SEC reporting, the RTO hourly day-ahead and real-time activity is combined for netting purposes. Due to the netting difference, Sales for Resale are <span class="font8" style="">$6,050,124.00</span><span class="font5" style=""> greater for FERC purposes than PSCW or SEC purposes for the </span><span class="font8" style="">six</span><span class="font5" style=""> months ended </span><span class="font8" style="">Jun 30, 2026</span><span class="font5" style="">.</span></td>
            </tr>
          </tbody>
        </table>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH7CCD4794572FE10645AD0E7F463BA69E" xlink:to="HH507C31FFAD91CFFF4C59374C8C1A0080" order="1" />
