					&lt;tr&gt;&#xD;
						&lt;td style="width:19.94%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:top; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-left:5pt; margin-bottom:0pt; page-break-after:avoid; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Calibri"&gt;2025&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
