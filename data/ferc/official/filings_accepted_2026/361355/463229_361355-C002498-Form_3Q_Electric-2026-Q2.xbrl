						&lt;td style="width:1.38%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:bottom; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Calibri; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:10.56%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:bottom; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:right; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Calibri"&gt;10.5&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:1.38%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:bottom; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Calibri; "&gt;&amp;#160;&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:3.04%; padding-top:0.7pt; padding-right:0.7pt; vertical-align:bottom; background-color:#ffffff"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:right; font-size:9pt"&gt;&#xD;
								&lt;span style="font-family:Calibri"&gt;%&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
