    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH34DD5BE0AEEFFC4C6A544107792E4564" xlink:to="HHD201294779ACC8606409F1B2FC2F3522" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH048FC57C432C636EA8BA1173ADB39D23" xlink:label="HH048FC57C432C636EA8BA1173ADB39D23" />
    <link:footnote xlink:type="resource" xlink:label="HH8B649AE3B8E726277BF8D8FF0296814A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <strong>
            <em>
              <span style="text-decoration: underline;">Schedule Page: 332 Line No: 1 Column: g</span>
            </em>
          </strong>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">Distribution and Dynamic Scheduling Fees.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH048FC57C432C636EA8BA1173ADB39D23" xlink:to="HH8B649AE3B8E726277BF8D8FF0296814A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHA5E852F343E2C89799D346089C90B79B" xlink:label="HHA5E852F343E2C89799D346089C90B79B" />
    <link:footnote xlink:type="resource" xlink:label="HH625F31A0A406E5C40665AA5B83D03667" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <strong>
            <em>
              <span style="text-decoration: underline;">Schedule Page: 332 Line No: 3 Column: c</span>
            </em>
          </strong>
        </p>
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">MW's received by Midcontinent ISO as losses on the transmission provider's assets inside the MGE Control Area.</span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHA5E852F343E2C89799D346089C90B79B" xlink:to="HH625F31A0A406E5C40665AA5B83D03667" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH537334F2EDF64B2F684847208CD58C1E" xlink:label="HH537334F2EDF64B2F684847208CD58C1E" />
    <link:footnote xlink:type="resource" xlink:label="HHD961E52A7E8903EA0E4994894546540A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <strong>
            <em>
              <span style="text-decoration: underline;">Schedule Page: 332 Line No: 3 Column: d</span>
            </em>
          </strong>
        </p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">MW's delivered by Midcontinent ISO to the MGE Control Area for losses on the transmission provider's assets inside the Control Area.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH537334F2EDF64B2F684847208CD58C1E" xlink:to="HHD961E52A7E8903EA0E4994894546540A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH0E6ACFA80C4EC108713CC28415B98080" xlink:label="HH0E6ACFA80C4EC108713CC28415B98080" />
    <link:footnote xlink:type="resource" xlink:label="HH697AB2DA731CFE63D5CDF541CB14DB8B" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-size: medium; margin: 0px 0px 10px; font-family: Roboto;">
          <strong>
            <em>
              <span style="text-decoration: underline;">Schedule Page: 400 Line No: 1 Column b:</span>
            </em>
          </strong>
        </p>
        <p style="color: #000000; font-size: medium; margin: 0px; font-family: Roboto;">On January 1, 2001 Madison Gas and Electric Company (MGE) transferred substantially all of its electric transmission facilities to American Transmission Company, LLC. Therefore, this page is not applicable to MGE.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0E6ACFA80C4EC108713CC28415B98080" xlink:to="HH697AB2DA731CFE63D5CDF541CB14DB8B" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHA9049FC7A7B8B38F5218CD6A19115398" xlink:label="HHA9049FC7A7B8B38F5218CD6A19115398" />
    <link:footnote xlink:type="resource" xlink:label="HH7BBA806D780B0A0BF218FCAC2CBCA395" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <strong>
            <em>
              <span style="text-decoration: underline;">Schedule Page: 399 Line No: 8 Column: b</span>
            </em>
          </strong>
        </p>
        <div style="color: #000000; font-family: sans-serif; font-size: medium;">Pursuant to FERC Order 668, for FERC purposes, MGE nets RTO day-ahead and real-time energy market activity separately on an hourly basis. For PSCW and SEC reporting, the RTO hourly day-ahead and real-time activity is combined for netting purposes. Due to the netting difference, MWhs reported as Purchased Power are 57,506 greater for FERC purposes than PSCW or SEC purposes for the three months ended June 30, 2026.</div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHA9049FC7A7B8B38F5218CD6A19115398" xlink:to="HH7BBA806D780B0A0BF218FCAC2CBCA395" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHA1EEC62EEEC271DF1D933BA2013D758B" xlink:label="HHA1EEC62EEEC271DF1D933BA2013D758B" />
    <link:footnote xlink:type="resource" xlink:label="HHA1E4971AED911423FADBF154014B6C3C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">
          <strong>
            <em>
              <span style="text-decoration: underline;">Schedule Page: 399 Line No: 8 Column: c</span>
            </em>
          </strong>
        </p>
        <div style="color: #000000; font-family: sans-serif; font-size: medium;">Pursuant to FERC Order 668, for FERC purposes, MGE nets RTO day-ahead and real-time energy market activity separately on an hourly basis. For PSCW and SEC reporting, the RTO hourly day-ahead and real-time activity is combined for netting purposes. Due to the netting difference, MWhs reported as Sales for Resale are 57,506 greater for FERC purposes than PSCW or SEC purposes for the three months ended June 30, 2026.</div>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHA1EEC62EEEC271DF1D933BA2013D758B" xlink:to="HHA1E4971AED911423FADBF154014B6C3C" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>