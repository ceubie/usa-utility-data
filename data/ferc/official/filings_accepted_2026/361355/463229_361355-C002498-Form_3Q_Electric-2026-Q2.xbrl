    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHEB57FA550102BF27B17839E6639C852F" xlink:to="HH84EF642D3B82E71C599B34A2A937B716" order="1" />
