        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Pursuant to Section 14.12 of General Terms and Conditions of Northwest's Tariff.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-17" id="fn-17" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml" style="margin-top:5pt">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:105%">Pursuant of Section 15.5 of General Terms and Conditions of Northwest's Tariff.</span>
      </div>
    </link:footnote>
