  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C012890</ferc:CompanyIdentifier>
  <ferc:ReportYearPeriod id="HH6439FA2135BC4FC31DA52CEDA67ED097" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026/Q1</ferc:ReportYearPeriod>
  <ferc:ReportYear id="HH660FC444EE17A785BFF22BCDC6434313" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4" decimals="0" unitRef="HHferc_us_Pure">2026</ferc:ReportYear>
  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q1</ferc:ReportPeriod>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-03-31</ferc:ReportDate>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock id="HHD2B1DFDF71C7477E84AEA1D4D780024C" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;span style="font-family: sans-serif; font-size: medium;"&gt;1) None&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInAndImportantAdditionsToFranchiseRightsTextBlock>
  <ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock id="HH9BC0EFBCB25FD35BD21CC5095A000F66" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p class="MsoNormal" style="margin-top: 12.0pt;"&gt;&lt;span style="font-family: 'Proxima Nova';"&gt;2) None.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock>
  <ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock id="HHB507706EE223692FB3CE9DE4D62FC621" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;3.) In &lt;span style="text-indent: 0in; font-size: 0.9rem;"&gt;July 2024, NorthWestern Corporation entered into an Abandonment and Acquisition (A&amp;amp;A) Agreement with Puget Sound Energy (Puget) to acquire Puget&amp;#8217;s combined 370 megawatt interests in Units 3 and 4 of the Colstrip Generating Station (Colstrip) for $0. In December 2025, NorthWestern Corporation completed the assignment of its rights and obligations under the A&amp;amp;A Agreement to &lt;/span&gt;&lt;a style="text-indent: 0in; background-color: #ffffff; font-size: 0.9rem; color: #000000;"&gt;NorthWestern Colstrip 370Pu LLC &lt;/a&gt;&lt;span style="text-indent: 0in; font-size: 0.9rem;"&gt;(NW Colstrip 370). NW Colstrip 370 completed the acquisition of Puget&amp;#8217;s interests in Colstrip Units 3 and 4 on January 1, 2026.&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal" style="text-indent: 0in;"&gt;Puget will remain responsible for its respective pre-closing share of environmental, asset retirement obligations (AROs), and pension liabilities attributed to events or conditions existing prior to the closing of the transaction and for any future decommissioning and demolition costs associated with the existing Colstrip assets that comprised its interests. While Puget remains contractually obligated for the pre-closing share of AROs, NW Colstrip 370 remains the primary obligor. As such, as of March 31, 2026, NW Colstrip 370 has recorded a $23.4 million liability for these AROs and has recorded an indemnification asset of $23.4 million.&lt;/p&gt;
&lt;p class="MsoNormal" style="text-indent: 0in;"&gt;In October 2025, NW Colstrip 370 entered into a Master Power Purchase and Sale Agreement (PPA) and Confirmation Agreement with Mercuria Energy America, LLC (Mercuria) from the share of Colstrip that NW Colstrip 370 acquired from Puget on January 1, 2026. The delivery period of that agreement is January 1, 2026, through September 30, 2027. NW Colstrip 370 filed the PPA and Confirmation Agreement with FERC in Docket No. ER26-411. FERC accepted the PPA and Confirmation Agreement effective January 1, 2026. &lt;em&gt;See NorthWestern Colstrip 370Pu LLC&lt;/em&gt;, 194 FERC &amp;#182; 61,154 (2026).&lt;/p&gt;
&lt;p class="MsoNormal" style="text-indent: 0in;"&gt;Also in October 2025, NW Colstrip 370 submitted a request to FERC in Docket No. ER26-129 for approval of a Cost-Based Rate Tariff (CBR Tariff) for the purpose of making short-term sales of electricity produced by its share of Units 3 and 4 of Colstrip. FERC accepted the CBR Tariff effective January 1, 2026. &lt;em&gt;See NorthWestern Colstrip 370Pu LLC&lt;/em&gt;, 194 FERC &amp;#182; 61,153 (2026).&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfPurchaseOrSaleOfAnOperatingUnitOrSystemTextBlock>
  <ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock id="HH1C967D5CB7055C23C61684D3A8ADDA65" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;span style="font-size: 16px; font-family: 'Times New Roman';"&gt;&amp;#160;4.)&amp;#160;&lt;/span&gt;&lt;span style="font-size: 16px; font-family: 'Times New Roman';"&gt;None&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantLeaseholdsThatHaveBeenAcquiredOrGivenAssignedOrSurrenderedTextBlock>
