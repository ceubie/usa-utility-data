&lt;p style="font-family: sans-serif; font-size: 12pt; margin-top: 12pt; margin-bottom: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
