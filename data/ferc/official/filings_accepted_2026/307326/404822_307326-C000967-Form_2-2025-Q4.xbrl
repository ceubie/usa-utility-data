        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This amount would be excluded in the development of jurisdictional recourse rates.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value93" xlink:to="footnote93" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="93" />
