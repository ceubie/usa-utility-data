    <link:footnoteArc xlink:type="arc" xlink:from="value96" xlink:to="footnote96" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="96" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote101" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Accumulated depreciation has been allocated using the applicable FERC approved rate over time applied to gross plant for each incremental facility. We record and compute book depreciation on a composite basis. Our methodology for allocating depreciation to incremental facilities for cost allocation and rate design purposes in a Section 4 filing may differ from that displayed here.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value101" xlink:to="footnote101" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="101" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote103" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Operating expenses are allocated based on gross plant amounts. Our methodology for cost allocation and rate design purposes may differ in a Section 4 rate filing. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value103" xlink:to="footnote103" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="103" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote104" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Maintenance expenses are allocated based on gross plant amounts. Our methodology for cost allocation and rate design purposes may differ in a Section 4 rate filing. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value104" xlink:to="footnote104" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="104" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote109" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Default">
          <xhtml:span style="font-size: 18pt; color: windowtext; font-family: arial, helvetica, sans-serif;">Recorded pursuant to Docket No. AI93-5-000 issued April 23, 1993 (Accounting for Income Taxes). We estimate $0.6 million of the ending balance is associated with projects granted non-traditional rate treatment on page 217.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value109" xlink:to="footnote109" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="109" />
