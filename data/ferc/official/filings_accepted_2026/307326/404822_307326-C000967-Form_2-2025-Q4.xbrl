&lt;/td&gt;
&lt;td style="width: 125.6pt; border-top: 4.5pt solid #000000; border-right: 1pt solid #000000; border-bottom: 1pt solid #000000; padding-right: 3.9pt; padding-left: 5.65pt; vertical-align: bottom;" colspan="2"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 16pt;"&gt;&lt;font style="-aw-import: ignore;"&gt; &amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
