    <link:footnoteArc xlink:type="arc" xlink:from="value128" xlink:to="footnote128" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="128" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote129" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Excludes $1,266,613 that relates to fuel amounts paid by us to Mojave Pipeline Company, L.L.C. (Mojave) pursuant to our Firm Transportation contract with Mojave. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value129" xlink:to="footnote129" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="129" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote130" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Excludes 989,463 Dth that relates to fuel amounts paid by us to Mojave pursuant to our Firm Transportation contract with Mojave. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value130" xlink:to="footnote130" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="130" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote131" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Operational purchases recorded in Account 803.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value131" xlink:to="footnote131" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="131" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote132" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Operational purchases recorded in Account 803.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value132" xlink:to="footnote132" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="132" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote133" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">This project has separately tracked fuel retention rates. During 2025, we retained 605,747 Dth of gas from our shippers and we consumed 703,986 Dth of gas.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value133" xlink:to="footnote133" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="133" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote134" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">Accumulated deferred income tax is a computed amount representing the tax impact on the difference between allocated composite book depreciation amounts and tax depreciation for each incremental facility. We record and compute book depreciation on a composite basis. Our methodology for allocating deferred income taxes to incremental facilities for cost allocation and rate design purposes in a Section 4 filing may differ from that displayed here.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value134" xlink:to="footnote134" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="134" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote136" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">See Page 102, "Control Over Respondent" for a description of our ownership structure.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value136" xlink:to="footnote136" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="136" />
