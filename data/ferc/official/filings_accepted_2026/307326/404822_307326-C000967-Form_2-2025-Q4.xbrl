              <xhtml:td style="width: 566.75pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="756">
                <xhtml:p class="Normal">
                  <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">Net Park/(Loan) Balance - End of Quarter<xhtml:span style="mso-tab-count: 1;"></xhtml:span></xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border-top: none; border-left: none; border-bottom: solid windowtext 3.0pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: 2.25pt; mso-border-left-alt: .5pt; mso-border-bottom-alt: 3.0pt; mso-border-right-alt: .5pt; mso-border-color-alt: windowtext; mso-border-style-alt: solid; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="192">
                <xhtml:p class="Normal" style="text-align: right;" align="right">
                  <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">31,549,427</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
          </xhtml:tbody>
        </xhtml:table>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value30" xlink:to="footnote30" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="30" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote31" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">In accordance with FERC Order No. 581, we use the fixed asset method.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value31" xlink:to="footnote31" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="31" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote36" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Gas withdrawn from storage for system balancing purposes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value36" xlink:to="footnote36" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="36" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote37" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Gas withdrawn from storage for system balancing purposes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value37" xlink:to="footnote37" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="37" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote38" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Gas delivered to storage for system balancing purposes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value38" xlink:to="footnote38" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="38" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote39" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Gas delivered to storage for system balancing purposes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value39" xlink:to="footnote39" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="39" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote40" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-bidi-font-weight: bold;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level, rather than by discounted, negotiated or recourse rate contracts; therefore, the amounts reported have been allocated to discounted, negotiated or recourse rate contracts based on reasonable assumptions.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value40" xlink:to="footnote40" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="40" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote41" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">The value of this gas is based on the current month cash-out price provided for in our tariff. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value41" xlink:to="footnote41" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="41" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote42" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Shipper supplied gas and gas lost and unaccounted for are not directly charged to an account. As directed under FERC Order No. 581, we record "Other Regulatory Assets/Liabilities" (Accounts 182.3 / 254) through offsetting entries booked to "Regulatory Debits/Credits", (Accounts 407.3/.4) for any excess or deficiency in net shipper supplied gas (Line 37). This footnote applies to Lines 4 and 26 for all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value42" xlink:to="footnote42" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="42" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote43" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">The Certificated Storage Capacity was converted from Mcf to Dth using a 1.023 conversion factor.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value43" xlink:to="footnote43" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="43" />
