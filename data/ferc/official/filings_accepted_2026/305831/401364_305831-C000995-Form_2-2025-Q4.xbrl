      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Default">
          <xhtml:span style="font-size: 18.0pt; color: windowtext;">
            <xhtml:span style="font-family: arial, helvetica, sans-serif;">Recorded pursuant to Docket No. CP03-302. Revenue Sharing dollars are refunded annually.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value26" xlink:to="footnote26" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="26" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote27" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Default">
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <xhtml:span style="font-size: 18.0pt; color: windowtext;">Recorded pursuant to Docket No. RP09-566-001. </xhtml:span>
            <xhtml:span style="font-size: 18.0pt;">Remaining balance at end of current filing period will be refunded through adjustments to future period fuel retention rates.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value27" xlink:to="footnote27" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="27" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote28" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Recorded pursuant to Docket No. RP14-630. </xhtml:span>
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif; mso-fareast-font-family: 'Times New Roman'; color: black;">Remaining balance at end of current filing period will be refunded through adjustments to future period electric power cost rates.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value28" xlink:to="footnote28" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="28" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote30" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 16pt;">Use tax is distributed to various accounts based on the accounts charged for the originating invoice.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value30" xlink:to="footnote30" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="30" />
