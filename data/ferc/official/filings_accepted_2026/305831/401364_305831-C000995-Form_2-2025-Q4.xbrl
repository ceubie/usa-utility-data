    <link:footnoteArc xlink:type="arc" xlink:from="value62" xlink:to="footnote62" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="62" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote63" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 16pt;">Kinder Morgan, Inc. directly owns 38.06% of Kinder Morgan Energy Partners, L.P. and 100% of Kinder Morgan GP LLC and KM Energy Inc.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value63" xlink:to="footnote63" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="63" />
