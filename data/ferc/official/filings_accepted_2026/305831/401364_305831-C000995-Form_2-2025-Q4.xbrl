    <link:footnoteArc xlink:type="arc" xlink:from="value66" xlink:to="footnote66" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="66" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote67" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Rate for other funds actually used during the year is based upon the capital ratio of 31% common equity specified by a Commission Order dated October 22, 2003 pursuant to Docket No. CP03-302 multiplied by the 14% common equity cost rate percentage.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value67" xlink:to="footnote67" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="67" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote69" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Operating expenses are directly assigned and are associated with the capacity lease expense. Our methodology for cost allocation and rate design purposes may differ in a Section 4 or 5 rate filing.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
