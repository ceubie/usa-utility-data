      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">KM Energy LLC is a direct wholly-owned subsidiary of KM Energy Inc.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value64" xlink:to="footnote64" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="64" />
