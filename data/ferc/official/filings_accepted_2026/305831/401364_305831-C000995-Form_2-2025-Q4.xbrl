&lt;td style="width: 101.5pt; border-top: 2.25pt solid #000000; border-right: 0.75pt solid #000000; border-bottom: 2.25pt solid #000000; padding-right: 4.72pt; padding-left: 5.9pt; vertical-align: middle;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 16pt;"&gt;&lt;font style="font-family: Arial;"&gt;9.6&lt;/font&gt;&lt;/p&gt;
