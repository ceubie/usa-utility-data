      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 16pt;">Transferred to Account 211 "Miscellaneous Paid-in Capital."</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value31" xlink:to="footnote31" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="31" />
