    <link:footnoteArc xlink:type="arc" xlink:from="value54" xlink:to="footnote54" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="54" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote55" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: Arial, sans-serif; font-size: 18pt;">As of December 31, 2025, we estimate that the following deferred tax balance in Account 190 could be used in the development of jurisdictional recourse rates:</xhtml:span>
        </xhtml:p>
        <xhtml:table class="MsoNormalTable" style="border-collapse: collapse; mso-table-lspace: 9.0pt; margin-left: 6.75pt; mso-table-rspace: 9.0pt; margin-right: 6.75pt; mso-table-anchor-vertical: paragraph; mso-table-anchor-horizontal: margin; mso-table-left: left; mso-table-top: 8.4pt; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="0" cellspacing="0" cellpadding="0" align="left">
          <xhtml:tbody>
            <xhtml:tr>
              <xhtml:td style="width: 499.5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="666">
                <xhtml:p class="MsoNormal" style="line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: margin; mso-element-top: 8.4pt; mso-height-rule: exactly; margin: 0in 3.75pt 0in 0in;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Regulatory Liability - Deferred Income Tax Rate Adjustment</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 11.8pt; padding: 0in 5.4pt 0in 5.4pt;" valign="top" width="16">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: margin; mso-element-top: 8.4pt; mso-height-rule: exactly;">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 100.9pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="135">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal; tab-stops: 4.5pt .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in 7.0in; mso-layout-grid-align: none; text-autospace: none; mso-element: frame; mso-element-frame-hspace: 9.0pt; mso-element-wrap: around; mso-element-anchor-vertical: paragraph; mso-element-anchor-horizontal: margin; mso-element-top: 8.4pt; mso-height-rule: exactly;" align="right">
                  <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">1,318,847</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
          </xhtml:tbody>
        </xhtml:table>
        <xhtml:p class="MsoNormal">
        </xhtml:p>
        <xhtml:p class="MsoNormal">
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value55" xlink:to="footnote55" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="55" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote56" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 16pt;">As of December 31, 2025, we estimate that the following deferred tax balance in Account 282 could be used in the development of jurisdictional recourse rates:</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
        <xhtml:table class="MsoNormalTable" style="border-collapse: collapse; margin-left: 6.75pt; margin-right: 6.75pt;" border="0" cellspacing="0" cellpadding="0" align="left">
          <xhtml:tbody>
            <xhtml:tr>
              <xhtml:td style="width: 472.5pt; padding: 0in 5.4pt;" valign="bottom" width="630">
                <xhtml:p class="MsoNormal" style="margin: 0in 3.75pt 0in 0in; line-height: normal;">
                  <xhtml:span style="font-size: 18pt; font-family: Arial, sans-serif;">Property, Plant, and Equipment</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 38.6pt; padding: 0in 5.4pt;" valign="top" width="51">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal;">
                  <xhtml:span style="font-size: 18pt; font-family: Arial, sans-serif;">$</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 100.9pt; padding: 0in 5.4pt;" valign="bottom" width="135">
                <xhtml:p class="MsoNormal" style="margin-bottom: 0in; text-align: right; line-height: normal;" align="right">
                  <xhtml:span style="font-size: 18pt; font-family: Arial, sans-serif;">35,218,975</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
          </xhtml:tbody>
        </xhtml:table>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value56" xlink:to="footnote56" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="56" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote57" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Amounts charged are based on Kinder Morgan, Inc.'s other compensation and benefit expenses and are allocated to us based on the distribution of direct labor charges (excluding overtime and special pay).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value57" xlink:to="footnote57" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="57" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote59" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">Amounts charged by Kinder Morgan, Inc. through shared services are allocated using the modified Massachusetts Formula.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value59" xlink:to="footnote59" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="59" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote60" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 18pt;">See Page 218, "General Description of Construction Overhead Procedure" for the basis of allocation.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value60" xlink:to="footnote60" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="60" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote61" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">See Page 332 for additional details on Transmission and Compression of Gas by Others.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value61" xlink:to="footnote61" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="61" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote62" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="Normal">
          <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">These revenues are associated with park and loan agreements. The net monthly park and loan volume activity for the quarter is as follows:</xhtml:span>
        </xhtml:p>
        <xhtml:table class="MsoTableGrid" style="width: 710.75pt; border-collapse: collapse; border: none; mso-border-alt: solid windowtext .5pt; mso-padding-alt: 0in 5.4pt 0in 5.4pt;" border="1" width="948" cellspacing="0" cellpadding="0">
          <xhtml:tbody>
            <xhtml:tr style="mso-yfti-irow: 0; mso-yfti-firstrow: yes; height: 15.0pt; mso-row-margin-left: 566.75pt;">
              <xhtml:td style="mso-cell-special: placeholder; border: none; border-bottom: solid windowtext 1.0pt;" width="756">
                <xhtml:p class="MsoNormal">
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border: solid windowtext 1.0pt; border-bottom: solid windowtext 4.5pt; mso-border-alt: solid windowtext .5pt; mso-border-bottom-alt: solid windowtext 4.5pt; padding: 0in 5.4pt 0in 5.4pt; height: 15.0pt;" valign="top" width="192">
                <xhtml:p class="Normal" style="text-align: center;" align="center">
                  <xhtml:span style="font-family: arial, helvetica, sans-serif;">
                    <xhtml:strong style="mso-bidi-font-weight: normal;">
                      <xhtml:u>
                        <xhtml:span style="font-size: 18.0pt;">Dth</xhtml:span>
                      </xhtml:u>
                    </xhtml:strong>
                  </xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 1;">
              <xhtml:td style="width: 566.75pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="756">
                <xhtml:p class="Normal">
                  <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">Net Park/(Loan) Balance - Beginning of Quarter</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border-top: none; border-left: none; border-bottom: solid windowtext 4.5pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: 4.5pt; mso-border-left-alt: .5pt; mso-border-bottom-alt: 4.5pt; mso-border-right-alt: .5pt; mso-border-color-alt: windowtext; mso-border-style-alt: solid; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="192">
                <xhtml:p class="Normal" style="text-align: right;" align="right">
                  <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;">105,000</xhtml:span>
                </xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 2;">
              <xhtml:td style="width: 566.75pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="756">
                <xhtml:p class="Normal">
                  <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;"> Month 1 net activity</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext 4.5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="192">
                <xhtml:p class="Normal" style="text-align: right;" align="right">-</xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 3;">
              <xhtml:td style="width: 566.75pt; border: solid windowtext 1.0pt; border-top: none; mso-border-top-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="756">
                <xhtml:p class="Normal">
                  <xhtml:span style="font-size: 18pt; font-family: arial, helvetica, sans-serif;"> Month 2 net activity</xhtml:span>
                </xhtml:p>
              </xhtml:td>
              <xhtml:td style="width: 2.0in; border-top: none; border-left: none; border-bottom: solid windowtext 1.0pt; border-right: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; mso-border-left-alt: solid windowtext .5pt; mso-border-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt;" valign="bottom" width="192">
                <xhtml:p class="Normal" style="text-align: right;" align="right">-</xhtml:p>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="mso-yfti-irow: 4;">
