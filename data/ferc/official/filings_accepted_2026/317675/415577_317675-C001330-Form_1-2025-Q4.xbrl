&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;January &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;1,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;2025&lt;/span&gt;&lt;span style="width: 2.04pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;1,738,307&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
