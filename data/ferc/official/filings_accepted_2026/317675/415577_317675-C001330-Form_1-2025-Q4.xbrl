&lt;td style="width: 97.2pt; border-top-style: solid; border-top-width: 0.75pt; border-bottom-style: solid; border-bottom-width: 0.75pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 11pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;$&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold;"&gt;937,063 &lt;/span&gt;&lt;/p&gt;
