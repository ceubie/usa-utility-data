  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;ol style="margin: 0pt; padding-left: 0pt;" type="1"&gt;
&lt;li style="margin-left: 14pt; text-align: justify; padding-left: 4pt; font-family: 'Times New Roman'; font-size: 12pt;"&gt;None.&lt;/li&gt;
