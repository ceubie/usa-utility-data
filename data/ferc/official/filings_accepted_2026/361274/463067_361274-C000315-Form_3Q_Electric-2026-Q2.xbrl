  <ferc:DisclosureOfEstimatedAnnualEffectAndNatureOfAnyImportantWageScaleChangesTextBlock id="HHEBA1CD44839C108D1DAFD6DE3427BE45" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:8pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;Toledo Edison&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;employees, represented by IBEW Local&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;245, received&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;a general wage increase&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;of 3.5%&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;and a market adjustment for some classifications, effective&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;May,&lt;/span&gt;&lt;span style="font-family:Arial"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Arial"&gt;2026.&lt;/span&gt;&#xD;
