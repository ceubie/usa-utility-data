ical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;76&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div style="text-align:center"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;4-35&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Construction Work in Progress&lt;/span&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;75&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;74&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;td colspan="2" style="border-top:1pt solid #000;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;110,076&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="2" style="border-top:1pt solid #000;padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;109,972&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-top:1pt solid #000;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;Less accumulated depreciation:&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;(4,039)&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="2" style="padding:2px 0 2px 1pt;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;(3,386)&lt;/span&gt;&lt;/td&gt;&lt;td style="padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Property, Plant, and Equipment, net&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 0 2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 0;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;106,037&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 0 2px 1pt;text-align:left;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;$&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 0;text-align:right;vertical-align:top"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:112%"&gt;106,586&#160;&lt;/span&gt;&lt;/td&gt;&lt;td style="border-bottom:1pt solid #000000;border-top:1pt solid #000000;padding:2px 1pt 2px 0;text-align:right;vertical-align:top"/&gt;&lt;td colspan="3" style="padding:0 1pt"/&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;NOTE 2 - OPERATING REVENUES&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;Accounts Receivable and Revenue Recognition - Revenue is recognized when control of the promised goods or services is transferred to customers at an amount that reflects the consideration to which the entity expects to be entitled in exchange for those goods and services.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The Company's operating revenues are generated primarily from a non-affiliated party (the "power purchaser") under the terms of the Power Purchase Agreement ("PPA"). Revenue is recognized as energy is delivered based on rates stipulated in the PPA. The Company believes that the obligation to deliver energy is satisfied over time as the customer simultaneously receives and consumes benefits provided by the Company.&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;A PPA with a non-affiliated power purchaser stipulates the prices and terms upon which the project sells power. This arrangement is summarized below:&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:center"&gt;&lt;table style="border-collapse:collapse;display:inline-table;margin-bottom:5pt;vertical-align:text-bottom;width:98.065%"&gt;&lt;tr&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:39.112%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.406%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:21.510%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.406%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:8.156%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.406%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:11.343%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:0.406%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;td style="width:1.0%"/&gt;&lt;td style="width:11.955%"/&gt;&lt;td style="width:0.1%"/&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Calibri Light',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Project&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:0 1pt"/&gt;&lt;td colspan="3" style="border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Calibri Light',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Counterparty&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:0 1pt"/&gt;&lt;td colspan="3" style="border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Calibri Light',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Term in years&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:0 1pt"/&gt;&lt;td colspan="3" style="border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Calibri Light',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Expiration&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:0 1pt"/&gt;&lt;td colspan="3" style="border-left:1pt solid #bfbfbf;border-right:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Calibri Light',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;Price per MWh&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td colspan="3" style="background-color:#f2f2f2;border-bottom:1pt solid #bfbfbf;border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Calibri Light',sans-serif;font-size:11pt;font-weight:700;line-height:112%"&gt;FRP Tupelo Solar, LLC&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#f2f2f2;border-bottom:1pt solid #bfbfbf;border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:0 1pt"/&gt;&lt;td colspan="3" style="background-color:#f2f2f2;border-bottom:1pt solid #bfbfbf;border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Calibri Light',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Seminole Utilities Commission&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#f2f2f2;border-bottom:1pt solid #bfbfbf;border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:0 1pt"/&gt;&lt;td colspan="3" style="background-color:#f2f2f2;border-bottom:1pt solid #bfbfbf;border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div style="text-align:right"&gt;&lt;span style="color:#000000;font-family:'Calibri Light',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;25&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#f2f2f2;border-bottom:1pt solid #bfbfbf;border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:0 1pt"/&gt;&lt;td colspan="3" style="background-color:#f2f2f2;border-bottom:1pt solid #bfbfbf;border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div style="text-align:right"&gt;&lt;span style="color:#000000;font-family:'Calibri Light',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;2049&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;td colspan="3" style="background-color:#f2f2f2;border-bottom:1pt solid #bfbfbf;border-left:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:0 1pt"/&gt;&lt;td colspan="3" style="background-color:#f2f2f2;border-bottom:1pt solid #bfbfbf;border-left:1pt solid #bfbfbf;border-right:1pt solid #bfbfbf;border-top:1pt solid #bfbfbf;padding:2px 1pt;text-align:left;vertical-align:top"&gt;&lt;div style="text-align:right"&gt;&lt;span style="color:#000000;font-family:'Calibri Light',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;33.68&lt;/span&gt;&lt;/div&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;NOTE 3 - COMMITMENTS AND CONTINGENCIES&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The Company has no outstanding commitments and contingencies other than those occurring from normal operations which are properly reflected as liabilities within the project financials.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;NOTE 4 - RELATED PARTY TRANSACTIONS &lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The Company entered into Corporate Support Services Agreements with subsidiaries of NextEra Energy, Inc. ("NextEra Energy") whereby the Companies pay a certain annual fee plus actual costs incurred in connection with administrative services performed under these agreements. Income is recorded directly as a reduction to the expenses. Amounts for these costs are included in accounts payable to associated companies or accounts receivable from associated companies. The Company has a payable to NextEra Energy for income taxes and various other items which are included in accounts payable to associated companies.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:700;line-height:120%"&gt;NOTE 5 - SUBSEQUENT EVENTS&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style="text-align:justify"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;The Company's management has evaluated the recognition and disclosure of subsequent events for its March 31, 2026 financial statements through May&#160;27, 2026, noting no additional disclosures are required.&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock>
