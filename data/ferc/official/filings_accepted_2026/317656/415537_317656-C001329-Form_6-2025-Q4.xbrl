  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH1E761FD31E45E0BD93F812E0AFE4A471" xlink:label="HH1E761FD31E45E0BD93F812E0AFE4A471" />
    <link:footnote xlink:type="resource" xlink:label="HHEAA875D8BC41ED195B9A4BDD7742884F" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>2024 amounts have been restated to update the rate base calculation to reflect updated PP&amp;E retirements.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH1E761FD31E45E0BD93F812E0AFE4A471" xlink:to="HHEAA875D8BC41ED195B9A4BDD7742884F" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH42C15379C637EA3435E46833EB335ACE" xlink:label="HH42C15379C637EA3435E46833EB335ACE" />
    <link:footnote xlink:type="resource" xlink:label="HH901959EA70C71DDEC6786D340F1D0712" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Management believes that the information on this page has been prepared in accordance with the Commission's Opinion 154-B methodology. This presentation on page 700 is not necessarily in the form in which it would appear in connection with a challenge to a particular rate, or rates, and is therefore not intended to be binding in any specific rate litigation.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH42C15379C637EA3435E46833EB335ACE" xlink:to="HH901959EA70C71DDEC6786D340F1D0712" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH8CFE3BE03A46009158E9B077BCEC7C9E" xlink:label="HH8CFE3BE03A46009158E9B077BCEC7C9E" />
    <link:footnote xlink:type="resource" xlink:label="HH4ECE00C32402D4F787D98998C72F498F" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Pursuant to the Commission&#8217;s Remedial Order, issued on November 20, 2025, in Docket No. RM25-2-000, Total Interstate Operating Revenues include amounts recoverable during the Locked-In-Period from March 1, 2022, to September 17, 2024.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH8CFE3BE03A46009158E9B077BCEC7C9E" xlink:to="HH4ECE00C32402D4F787D98998C72F498F" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>