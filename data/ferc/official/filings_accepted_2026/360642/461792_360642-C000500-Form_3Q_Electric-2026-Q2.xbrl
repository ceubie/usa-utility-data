&lt;p style="margin-top: 2.75pt; margin-bottom: 1.5pt; text-align: right; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;$&lt;/span&gt;&lt;span style="width: 54.24pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 58.8pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;(5.2)&lt;/span&gt;&lt;/p&gt;
