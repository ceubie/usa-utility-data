&lt;p style="margin-top: 3.75pt; margin-bottom: 1.5pt; text-align: right; font-size: 9pt;"&gt;&lt;span style="width: 53.5pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 53.5pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;104.4&lt;/span&gt;&lt;span style="width: 2.7pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 76.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
