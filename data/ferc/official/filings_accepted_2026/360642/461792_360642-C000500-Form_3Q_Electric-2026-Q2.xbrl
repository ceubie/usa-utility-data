&lt;/td&gt;
&lt;td style="width: 74.95pt; border-bottom-style: solid; border-bottom-width: 1pt; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 3.75pt; margin-bottom: 1.5pt; text-align: center; page-break-inside: avoid; page-break-after: avoid; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;Other&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 3.75pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; page-break-inside: avoid; page-break-after: avoid; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 74.95pt; border-bottom-style: solid; border-bottom-width: 1pt; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 3.75pt; margin-bottom: 1.5pt; text-align: center; page-break-inside: avoid; page-break-after: avoid; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;Wisconsin Public Service Corporation&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
