&lt;p style="margin-top: 2.75pt; margin-bottom: 1.5pt; text-align: right; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;$&lt;/span&gt;&lt;span style="width: 58.04pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 62.6pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri; font-weight: bold;"&gt;2.2&lt;/span&gt;&lt;span style="width: 2.72pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 76.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
