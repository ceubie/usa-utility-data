&lt;p style="margin-top: 2.75pt; margin-bottom: 1.5pt; text-align: right; font-size: 9pt;"&gt;&lt;span style="font-family: Calibri;"&gt;$&lt;/span&gt;&lt;span style="width: 58.29pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 62.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Calibri;"&gt;2.1&lt;/span&gt;&lt;span style="width: 2.6pt; display: inline-block; -aw-tabstop-align: left; -aw-tabstop-pos: 76.85pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
