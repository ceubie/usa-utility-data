 background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 1pt; margin-left: 4.3pt; margin-bottom: 0; text-indent: -4.3pt; text-align: center; page-break-after: avoid; line-height: 1pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 52.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;div style="margin-top: 1pt; border-top: 2.25pt double rgba(0, 0, 0, 1); padding-top: 1pt"&gt; 							&lt;p style="margin-top: 0; margin-left: 4.3pt; margin-bottom: 0; text-indent: -4.3pt; text-align: center; page-break-after: avoid; line-height: 1pt"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/div&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 1pt; margin-left: 4.3pt; margin-bottom: 0; text-indent: -4.3pt; text-align: center; page-break-after: avoid; line-height: 1pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 43.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;div style="margin-top: 1pt; border-top: 2.25pt double rgba(0, 0, 0, 1); padding-top: 1pt"&gt; 							&lt;p style="margin-top: 0; margin-left: 4.3pt; margin-bottom: 0; text-indent: -4.3pt; text-align: center; page-break-after: avoid; line-height: 1pt"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/div&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The reported effective tax rates for 2025 and 2024 of 27.0% and 27.0%, respectively, differ from the U.S. federal statutory tax rate of 21% primarily due to the state taxes net of federal benefit. For the years ended December 31, 2025 and 2024, the reconciliation of taxes computed at the statutory federal income tax rate to the income tax provision is as follows (in thousands):&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 460.7pt; margin-left: 21.8pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr style="height: 16pt"&gt; 					&lt;td style="width: 328.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-left: 4.3pt; margin-bottom: 0.5pt; text-indent: -4.3pt; page-break-inside: avoid; page-break-after: avoid; font-size: 2pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 15.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 46.4pt; border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 							&lt;span style="font-weight: bold"&gt;2025&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 11.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.8pt; border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; page-break-after: avoid"&gt; 							&lt;span style="font-weight: bold"&gt;2