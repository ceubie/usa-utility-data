op: 0; margin-bottom: 0; text-align: left; font-size: 6pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 6pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 70.2pt; border-top: 2.25pt double rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 6pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="vertical-align: top"&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 0"&gt; 					&lt;td style="width: 12.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 12.65pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 207.3pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 18pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 76.5pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 13.5pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 81pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 22.55pt"&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;(5)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Contracts and Commitments&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(a)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Interconnection Agreements&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;CAISO approved in its 2022-2023 annual transmission planning process (TPP) certain southern Nevada area transmission upgrades to meet the future policy driven needs of the CAISO-controlled transmission grid.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;One of those approved TPP upgrades includes the addition of a 500/230 kV transformer at the existing GridLiance West Sloan Canyon substation (Sloan) and for construction to loop approximately one mile of the Company's existing Harry Allen to Eldorado 500 kV transmission line in/out of Sloan to mitigate deliverability constraints.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The Company is currently in the design phase and entering the construction phase of the project and began executing land crossing agreements in early 2025. Construction work is expected to begin in 2026 with final completion in 2027. The Company estimates total projects costs of $43.8 million. In 2025 and 2024, the Company incurred costs under this interconnection project which are included in Property and equipment on the accompanying balance sheets.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;In connection with this project, in June 2025, the Company and an unaffiliated third party entered into a Turnkey Engineering, Procurement and Construction Agreement for the design, engineering, procurement, construction, start-up and testing of a compensation reduction upgrade to the Company's existing 500 kV fixed series capacitor bank located at the NV Energy Crystal 500/230 kV substation in Nye County, Nevada. The upgrade will reduce the compensation of the existing fixed series capacitor from 23.5 Ohms to 20.277 Ohms. The unaffiliated third party agreed to perform all necessary work and services required for the design, engineering and permitting, the procurement of all materials and equipment, and the construction, assembly, installation, commissioning, start-up, testing and completion of the modified fixed series capacitor.&lt;/span&gt;&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(b)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Operation and Maintenance Agreements&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;In November 2019, the Company and an affiliated third party entered into an agreement for operation and maintenance where the affiliated third party will provide for the operation, maintenance, repair and restoration of the transmission facilities including vegetation management, routine maintenance, observation, inspection and assessment services to determine the physical condition of the transmission facilities, outage scheduling, security, maintenance, repair and restoration services that become necessary but are not scheduled, including switching and other services in the event of an emergency to isolate equipment in support of system restoration or to maintain safety until permanent repairs to the transmission facilities can be completed. The Company will reimburse the affiliated third party based on costs plus a certain adder for amounts incurred by or on behalf of affiliated third party in the performance of its obligations under this agreement.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;Pursuant to an executed change order in the original construction agreement between the Company and a separate unaffiliated third party, the Company authorized the unaffiliated third party to provide operations and maintenance services under a long-term maintenance program. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(c)&lt;/span&gt;&lt;span style="width: 15.14pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Land Rights&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt; text-indent: 0.35pt"&gt; 				&lt;span&gt;The Company has land rights that were obtained through various easements and licenses with governmental entities and private land owners. Most of these land rights required a one-time upfront payment, are perpetual in nature, and were recorded to Property and equipment, net as incurred. Several easements or land leases require annual payments as noted below.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt; text-indent: 0.35pt"&gt; 				&lt;span&gt;The Company has a license agreement with the U.S. Department of the Interior Bureau of Reclamation (BOR) granting a non-exclusive license to build and maintain transmission facilities on public land. The BOR agreement requires use fees as determined annually and will expire on December 31, 2044. The license may be renewed. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt; text-indent: 0.35pt"&gt; 				&lt;span&gt;The Company has a right-of-way grant with the U.S. Department of the Interior Bureau of Land Management (BLM) for 1,534acres. The BLM grant requires use fees as determined annually and will expire on December 31, 2044. The license may be renewed. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt; text-indent: 0.35pt"&gt; 				&lt;span&gt;The Company has a development rights agreement with Boulder City, Nevada, for easements on the city's land. This agreement requires annual payments and will continue concurrently with the terms of the easement granted by BLM. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The Company has various long term contractual and commercial commitments of which the significant contracts have been previously discussed in this note. The following table summarizes the obligations with respect to the significant contractual and commercial commitments as of December 31, 2025 (in thousands):&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 466.25pt; margin-left: 21.6pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr style="height: 7.35pt"&gt; 					&lt;td style="width: 118.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold; text-decoration: underline"&gt;Contractual obligations&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 46.65pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold; text-decoration: underline"&gt;Less than&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;1 year&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 46.65pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold; text-decoration: underline"&gt;2 to 3 years&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 38.55pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold; text-decoration: underline"&gt;4 to 5&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;years&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 46.65pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold; text-decoration: underline"&gt;More than 5 years&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 34.35pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span style="font-weight: bold; text-decoration: underline"&gt;Total&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 13.8pt"&gt; 					&lt;td style="width: 118.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt"&gt; 							&lt;span&gt;Land agreements&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt"&gt; 							&lt;span&gt;$&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 46.65pt; border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;273&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 46.65pt; border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;565&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 38.55pt; border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;592&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 46.65pt; border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;32,616&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 2.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 34.35pt; border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;34,046&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 22.45pt"&gt; 					&lt;td style="width: 118.5pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-left: 72pt; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;Total&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;$&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 46.65pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 1.5pt double rgba(0, 0, 0, 1); padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;273&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 1.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: middle"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 10pt; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 46.65pt; border-top: 0.7