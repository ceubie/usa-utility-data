bottom: 0; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 140.85pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;Total&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.7pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;$&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 73.5pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 2.25pt double rgba(0, 0, 0, 1); padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;86,800&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.7pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 70.7pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 2.25pt double rgba(0, 0, 0, 1); padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;89,300&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 7.7pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: right"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 67.9pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;At December 31,2025 and 2024, the unamortized debt issuance and deferred financing costs associated with the Senior Notes Facility totaled $0.7 million and $0.8 million, respectively. As of December 31, 2024, unamortized debt issuance and deferred financing costs associated with the Revolving Loan Facility totaled $18 thousand. These costs were fully amortized during 2025, resulting in no remaining balance as of December 31, 2025.The amortization of these costs is reflected as a component of Interest expense, net on the accompanying statements of operations. For the years ended December 31, 2025 and 2024, amortization of such costs was $43 thousand and $42 thousand, respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(a)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Note Purchase Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt; page-break-inside: avoid"&gt; 				&lt;span&gt;On December 17, 2020, the Company executed a note purchase agreement with a new group of lenders (Note Purchase Agreement), which consists of a $101.8 million Senior Notes Facility. Upon funding of the Note Purchase Agreement on December 18, 2020, all outstanding borrowings under the original Credit Agreement were repaid in full and the original Credit Agreement was cancelled. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;Under the Note Purchase Agreement, the principal balance will be repaid according to the amortization schedule with installment payments made on a semi-annual basis with the final balance due on the maturity date of December 17, 2050. During the years ended December 31, 2025 and 2024, the Company paid installment payments of $2.5 million and $2.8 million, respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;Interest is payable semi-annually under the Note Purchase Agreement with an interest rate of 2.57%. As of both December 31, 2025 and 2024, the Company recognized $2.3 million, in interest expense related to the Note Purchase Agreement. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The Company may, at its option, upon notice provided, prepay all or part of the senior notes in an amount not less than $1.0 million or a whole multiple of $0.5 million in excess thereof. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(b)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Credit Agreement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;On December 17, 2020, the Company executed a new credit agreement with a new group of lenders (Credit Agreement). The Credit Agreement includes a $15.0 million revolving and letter of credit facility (Revolving Loan Facility) to fund working capital expenditures and for other general corporate purposes and issuances of letters of credit (LOCs).The original maturity date of the Credit Agreement was the fifth anniversary of the closing date, December 17, 2025. In December 2025, the Company executed an amendment to the Credit Agreement extending the maturity date of the Revolving Loan Facility to March 31, 2026. The Company plans to renew the Credit Agreement in March 2026.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The Credit Agreement permits both Eurodollar and base rate loans. Interest rates on Eurodollar Loans are equal to the Eurodollar Base Rate for the applicable term of the loan with an applicable margin of 1.00%. Interest rates on base rate loans are equal to the greatest of (a) the rate that the administrative agent announces from time to time as its prime or base commercial lending rate, as in effect from time to time, (b) the sum of (i) the Federal Funds Effective Rate in effect on such day plus (ii) 0.50% and (c) the sum of (i) the Eurodollar rate for a one-month interest period commencing on such day plus (ii) 1.00%.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;LOCs accrue at the applicable margin rate of 1.0%. At December 31, 2025and 2024, there were no revolving loan borrowings or outstanding LOCs under this facility.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;The revolving loan facility carries a commitment fee of 0.1% per annum on the unused portion. Commitment fees are payable quarterly and, as of both December 31, 2025 and 2024, the Company recognized $15 thousand and $35 thousand, respectively, in commitment fee expense related to the Credit Agreement. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;(c)&lt;/span&gt;&lt;span style="width: 15.14pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold; font-style: italic"&gt;Common Terms Agreement &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.7pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;In connection with the Note Purchase Agreement and Credit Agreement, the Company entered into a Common Terms Agreement with the lenders. This agreement sets out certain provisions, conditions, representations and covenants under the Note Purchase Agreement and Credit Agreement. The Common Terms Agreement requires compliance with affirmative and negative covenants, including, among other things, financial statement reporting requirements and limitations or restrictions relating to the use of the proceeds, additional indebtedness and disposition of assets. The Company was in compliance with all covenants at December&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31, 2025 and 2024.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27pt; margin-bottom: 10pt; page-break-after: avoid"&gt; 				&lt;span&gt;As of December&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31, 2025, minimum principal payments under the Company's financing arrangements for the next five years are as follows (in thousands):&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 93.66%; margin-left: 21.6pt; border-collapse: collapse" class="e-rte-table"&gt; 				