0; text-align: center"&gt; 							&lt;span&gt;34,046&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 7pt; text-indent: -27.35pt; text-align: left; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;(6)&lt;/span&gt;&lt;span style="width: 14.52pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Financing Arrangements&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 27.35pt; margin-bottom: 10pt"&gt; 				&lt;span&gt;As of December 31, 2025 and 2024, outstanding principal balances under the Company's financing arrangements are as follows (in thousands):&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 476.65pt; margin-left: 24.45pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr style="height: 12.95pt"&gt; 					&lt;td style="width: 6.2pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6.2pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 6.2pt; padding-right: 2.9pt; padding-left: 2.9pt; vertical-align: bottom"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&l