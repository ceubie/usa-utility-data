			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; font-weight:bold"&gt;The Company&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;Enterprise TW Products Pipeline L.L.C. (the "Company"), a Texas limited liability company, is a wholly owned subsidiary of Enterprise Products Operating LLC, a Texas limited liability company ("EPOLLC"). EPOLLC in turn is wholly owned by Enterprise Products Partners L.P., a Delaware limited partnership, which is a publicly traded partnership.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; font-weight:bold"&gt;Description of the Property&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;The Company leases certain pipeline capacity from Mid-America Pipeline LLC that originates in Hobbs, Texas and delivers to terminal locations in New Mexico and Utah.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; font-weight:bold"&gt;Basis of Accounting&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;The accounting policies followed in preparation of these financial statements conform to those required by FERC.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; Financial statements are prepared on &lt;/span&gt;&lt;span style="font-family:Aptos"&gt;the accrual&lt;/span&gt;&lt;span style="font-family:Aptos"&gt; basis of accounting.&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Aptos"&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; font-weight:bold; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; font-weight:bold"&gt;Revenue Recognition&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;Revenues are derived from transportation of petroleum products under an interstate tariff. The tariff specifies the amounts to be paid by shippers for service between receipt and delivery locations and the general terms and conditions of transportation services on the pipeline system. Revenue is recognized upon delivery of products to shippers.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos; font-weight:bold"&gt;Income Taxes&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; line-height:116%; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Aptos"&gt;The Company is a limited liability company that passes income tax liability through the Company to EPOLLC and does not recognize this liability on the Company&amp;#x2019;s financial statements. For purposes of calculating income taxes for the annual cost of service (shown on page 700 of the Annual Report), the Company employs FERC's Policy Statement on Income Tax Allowances.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:8pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
