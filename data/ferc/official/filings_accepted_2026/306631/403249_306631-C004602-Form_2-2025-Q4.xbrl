nt-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;34%&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;     &lt;/tr&gt;  &lt;tr style="height: 0.25in"&gt;   &lt;td width="192" valign="top" style="width: 2in; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;Customer B&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="49" valign="top" style="width: 37pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="right" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="104" valign="top" style="width: 78.3pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="center" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;20%&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;            &lt;td width="115" valign="top" style="width: 86.6pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="center" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;20%&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;     &lt;/tr&gt;  &lt;tr style="height: 0.25in"&gt;   &lt;td width="192" valign="top" style="width: 2in; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;Customer C&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="49" valign="top" style="width: 37pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="right" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="104" valign="top" style="width: 78.3pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="center" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;14%&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;            &lt;td width="115" valign="top" style="width: 86.6pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="center" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;14%&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;     &lt;/tr&gt;  &lt;tr style="height: 0.25in"&gt;   &lt;td width="192" valign="top" style="width: 2in; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;Customer D&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="49" valign="top" style="width: 37pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="right" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="104" valign="top" style="width: 78.3pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="center" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&amp;lt;10%&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;            &lt;td width="115" valign="top" style="width: 86.6pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="center" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;10%&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;     &lt;/tr&gt; &lt;/table&gt;&lt;p style="margin: 0 0 12pt; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span&gt;Rover has the following transportation receivables from these customers at the dates indicated:&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;table border="0" cellspacing="0" cellpadding="0" width="532" style="width: 399.35pt; margin-left: 0.25in" class="e-rte-paste-table"&gt;  &lt;tr style="height: 0.25in"&gt;   &lt;td width="163" valign="bottom" style="width: 1.7in; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="369" colspan="3" valign="top" style="width: 276.95pt; border-top: none; border-right: none; border-bottom: 1pt solid rgba(0, 0, 0, 1); border-left: none; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="center" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;December 31,&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;     &lt;/tr&gt;  &lt;tr style="height: 0.25in"&gt;   &lt;td width="163" valign="bottom" style="width: 1.7in; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;sp