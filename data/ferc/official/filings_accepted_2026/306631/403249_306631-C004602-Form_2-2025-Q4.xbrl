        <link:footnote xlink:label="ft-207_46931_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource">Original value: N</link:footnote>
        <link:footnote xlink:label="ft-278_46927_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 278 Line No.:1 Column: a</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Pursuant to Section 22.1 of the General Terms and Conditions of Rover's FERC Gas Tariff, Volume No. 1, Docket No. RP25-662-000.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-597_47001_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 118 Line No.: 14 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Rover Pipeline LLC, as a limited liability company, records members' equity in Other Paid-in Capital.</span></span></p><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Statement of Retained Earnings (unaudited)</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-669_47004_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 220 Line No.: 6 Column: e</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Rover has no storage facilities, therefore account 117.4 is used to record operational fluctuations in line pack.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-672_47003_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 220 Line No.: 5 Column: i</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Rover uses the fixed asset method to account for gas owed to the system.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-680_47006_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 350 Line No.: 1 Column: e</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Account 186, Miscellaneous deferred debits was used to record deferred charges for regulatory commission expense. This footnote applies to columns (e), (i) and (l).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-982_47009_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Schedule Page: 262 Line No.:30 Column: i</span></span></h2><p><span style="font-size: 12pt; line-height: 107%; font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Reversals of prior year accruals.</span></span><span style="font-size: 12pt; line-height: 107%"> </span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1219_47083_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 313 Line No.: 1 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The volumes in column (c) include discounted reservation contract quantities and commodity transactions.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1220_47084_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 313 Line No.: 1 Column: e</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The volumes in column (e) include negotiated reservation contract quantities and commodity transactions.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1299_47087_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 520 Line No.: 20 Column: c</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">For the purpose of the Annual Charge Adjustment ("ACA") calculation, the throughput volume is 1,245,365,051 Dth as represented on line 20. No additional volumes are needed to calculate total volumes eligible for the ACA surcharge.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1314_47086_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1404px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-1368_47089_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 521 Line No.: 7 Column: f</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The basis for valuing the gas reported in columns (f), (g) and (h) is the weighted average rate for system gas.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1497_47088_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 521 Line No.: 7 Column: e</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The allocation is derived from the throughput volume of each contract within the billing system. A path to path calculation of the rate utilized within the contract billing is determined and a percentage for recourse rate, discount rate and negotiated rate is derived based on the rate charged within the paths.</span></span></p><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2038_47090_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1404px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-2051_47091_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1404px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-2337_47095_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 218 Line No.: 3 Column: e</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The rate for borrowed funds is 3.18% and rate of other funds is 6.50% based on the authorized capital structure of 50% equity and 50% debt reference in Docket No. CP15-93. The rate for borrowed funds is based upon an imputed weighted average cost of Members' debt, which is weighted based on each Members ownership percentage in Rover.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2400_47272_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 336 Line No.: 10 Column: b</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">General plant is depreciated on a straight line basis per assigned FERC rates.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2406_47098_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 338 Line No.: 7 Column: c</span></span></h2><p><span style="font-size: 12pt; line-height: 107%; font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">Depreciation rate was approved by FERC RP15-93-000 settlement.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2407_47097_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 338 Line No.: 7 Column: b</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Depreciation plant basis reflects balance as of 12/31/2025. This footnote also applies to lines 8 and 9, column (b).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2803_47322_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><h2 style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 218 Line No.: 5 Column: f</span></span></h2><p style="margin: 0 0 8pt; line-height: 107%; font-size: 12pt">Pursuant to certificate application, Docket No. CP15-93-000, a 13% equity cost rate is used in calculating AFUDC.</p></div></link:footnote>
        <link:footnote xlink:label="ft-2806_47327_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 358 Line No.: 2 Column: a</b></span></span></p><table cellpadding="0" cellspacing="0" width="1194" style="width: 895pt" class="e-rte-paste-table"> <tr style="height: 5.11727%">  <td colspan="2" height="21" width="1194" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt; width: 895pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Allocation Basis:</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">(a)</span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">MMF</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">(b)</span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap" class=""><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Direct charge</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">(c)</span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Meter count</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">(d)</span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Head count</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">(e)</span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">SCADA</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">(f)</span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap" class=""><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Growth capital</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">(g)</span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Horse power</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">(h)</span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Active directory of Information Technology users</span></span></td> </tr> <tr style="height: 4.47761%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><br/></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><br/></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Note:</span></span></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Modified Massachusetts Formula ("MMF") is a   combination of revenues, property, and direct labor costs</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><br/></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">to create an allocation base. The company uses an adjusted   MMF that utilizes a combination of gross</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><br/></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">margin (33%), gross property (33%), and direct labor (33%)   costs to create its allocation base.</span></span></td> </tr> <tr style="height: 4.26439%">  <td height="20" style="color: rgba(0, 0, 0, 1); font-family: Calibri, sans-serif; padding: 0; font-size: 11pt; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15pt"><br/></td>  <td style="color: rgba(0, 0, 0, 1); font-family: Calibri, sans-serif; padding: 0; font-size: 11pt; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><br/></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-family: Calibri, sans-serif; padding: 0; font-size: 11pt; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><br/></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Supervisory Control and Data Acquisition ("SCADA")   is the application used by Gas/Pipeline Control to monitor</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-family: Calibri, sans-serif; padding: 0; font-size: 11pt; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><br/></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">real time data and alarms on the system.</span></span></td> </tr> <tr style="height: 4.26439%">  <td height="20" style="color: rgba(0, 0, 0, 1); font-family: Calibri, sans-serif; padding: 0; font-size: 11pt; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15pt"><br/></td>  <td style="color: rgba(0, 0, 0, 1); font-family: Calibri, sans-serif; padding: 0; font-size: 11pt; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><br/></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-family: Calibri, sans-serif; padding: 0; font-size: 11pt; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><br/></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap" class=""><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Energy Transfer Employee Management Company, an affiliated   company of Rover, only processes the payroll</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-family: Calibri, sans-serif; padding: 0; font-size: 11pt; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><br/></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">for associated/affiliated companies and directly bills to   Rover the salaries, benefits and payroll taxes</span></span></td> </tr> <tr style="height: 5.11727%">  <td height="21" style="color: rgba(0, 0, 0, 1); font-family: Calibri, sans-serif; padding: 0; font-size: 11pt; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap; height: 15.75pt"><br/></td>  <td style="color: rgba(0, 0, 0, 1); font-size: 11pt; font-family: Calibri, sans-serif; padding: 0; font-weight: 400; font-style: normal; text-decoration: none; vertical-align: bottom; white-space: nowrap"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">of associated/affiliated company employees for services   provided by them to Rover.</span></span></td> </tr></table><p><br/></p></div></link:footnote>
        <link:footnote xlink:label="ft-2859_47337_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page 358 Line No.: 13 Column: b</b></span></span></p><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1410px; min-height: 0" alt="" /> <br /></p></div></link:footnote>
