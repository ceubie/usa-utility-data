an&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="369" colspan="3" style="width: 276.95pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="center" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: center"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;(In thousands)&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;     &lt;/tr&gt;  &lt;tr style="height: 0.25in"&gt;   &lt;td width="163" valign="bottom" style="width: 1.7in; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="163" valign="bottom" style="width: 1.7in; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="43" valign="bottom" style="width: 32.15pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="163" valign="bottom" style="width: 1.7in; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;     &lt;/tr&gt;  &lt;tr style="height: 0.25in"&gt;   &lt;td width="163" valign="top" style="width: 1.7in; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif"&gt;&lt;span&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;Customer A&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="163" valign="top" style="width: 1.7in; padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="right" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;$&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"&gt;&lt;span style="font-family: Arial, Helvetica, sans-serif"&gt;20,665&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="43" valign="top" style="width: 32.15pt; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="right" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&gt;&lt;span&gt;&lt;span style="color: rgba(0, 0, 0, 1)"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;   &lt;/td&gt;      &lt;td width="163" valign="top" style="width: 1.7in; background: rgba(255, 255, 255, 1); padding: 0 5.4pt; height: 0.25in"&gt;   &lt;p align="right" style="margin: 0 0 12pt 0.25in; font-size: 12pt; font-family: &amp;quot;Arial&amp;quot;, sans-serif; text-align: right"&