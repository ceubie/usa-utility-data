&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;26,632,495&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 422.5pt; margin-left: 85.45pt; border-collapse: collapse"&gt; 				&lt;tr style="height: 12.4pt"&gt; 					&lt;td style="width: 213.85pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.4pt"&gt; 							&lt;span&gt;Less current portion&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 128.8pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 5.35pt; margin-bottom: 0; text-align: right; line-height: 11.4pt"&gt; 							&lt;span style="text-decoration: underline"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 27.7pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;677,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.85pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 2.4pt; margin-bottom: 0; text-align: right; line-height: 11.4pt"&gt; 							&lt;span style="text-decoration: underline"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 27.7pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;651,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 13.45pt"&gt; 					&lt;td style="width: 213.85pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0.8pt; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.65pt"&gt; 							&lt;span&gt;Long-term debt, less current portion&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 128.8pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 5.35pt; margin-bottom: 0; text-align: right; line-height: 12.4pt"&gt; 							&lt;span&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 13.9pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;25,344,797&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.85pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 2.4pt; margin-bottom: 0; text-align: right; line-height: 12.4pt"&gt; 							&lt;span&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 13.9pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;25,981,495&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0.55pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 51.55pt; margin-bottom: 0; text-align: justify"&gt; 				&lt;span&gt;Principal payments on long-term debt are as follows for the years ending December 31:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.3pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="margin-left: 225.85pt; border-collapse: collapse"&gt; 				&lt;tr style="height: 12.4pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.4pt"&gt; 							&lt;span&gt;2026&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.4pt"&gt; 							&lt;span&gt;$&lt;/span&gt;&lt;span style="width: 30.45pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;677,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.6pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span&gt;2027&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span&gt;706,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.6pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span&gt;2028&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span&gt;735,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.55pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span&gt;2029&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span&gt;766,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.6pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span&gt;2030&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span&gt;798,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.6pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span&gt;Thereafter&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span&gt;23,297,000&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.6pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 11.6pt"&gt; 							&lt;span&gt;Unamortized debt issuance costs&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 2.4pt; margin-bottom: 0; text-align: right; line-height: 11.6pt"&gt; 							&lt;span style="text-decoration: underline"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 24pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;(957,203&lt;/span&gt;&lt;span&gt;)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 12.4pt"&gt; 					&lt;td style="width: 177.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 108.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-right: 6.1pt; margin-bottom: 0; text-align: right; line-height: 11.4pt"&gt; 							&lt;span&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 13.9pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;26,021,797&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0.45pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 8pt; margin-left: 58.8pt; margin-bottom: 4pt; text-indent: -18pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt"&gt; 				&lt;span&gt;&lt;span style="font-family: &amp;quot;Aptos Display&amp;quot;"&gt;5.&lt;/span&gt;&lt;span style="width: 1.58pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: &amp;quot;Aptos Display&amp;quot;"&gt;OPERATIONS AND MAINTENANCE&lt;/span&gt;&lt;span style="font-family: &amp;quot;Aptos Display&amp;quot;; letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: &amp;quot;Aptos Display&amp;quot;"&gt;AGREEMENT&lt;/span&gt; 			&lt;/h2&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 11.4pt 0 51.55pt; text-align: justify"&gt; 				&lt;span&gt;SDG&amp;amp;E is the ultimate owner of the leased transmission line. SDG&amp;amp;E is responsible for the operation and maintenance of the line during the Company's lease term. As part of the lease agreement, the Company pays SDG&amp;amp;E additional rent for relevant maintenance and operational costs. The Company incurred approximately $912,000 and $992,000 of maintenance and operation expenses from SDG&amp;amp;E&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;in the years ended December 31, 2025 and 2024,&lt;/span&gt;&lt;span style="letter-spacing: 0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.3pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 8pt; margin-left: 58.8pt; margin-bottom: 4pt; text-indent: -28.85pt; page-break-inside: avoid; page-break-after: avoid; font-size: 11pt"&gt; 				&lt;span&gt;&lt;span style="font-family: &amp;quot;Aptos Display&amp;quot;"&gt;6.&lt;/span&gt;&lt;span style="width: 12.43pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-family: &amp;quot;Aptos Display&amp;quot;"&gt;LOW-INCOME ASSISTANCE&lt;/span&gt;&lt;span style="font-family: &amp;quot;Aptos Display&amp;quot;; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: &amp;quot;Aptos Display&amp;quot;"&gt;ACTIVITIES&lt;/span&gt; 			&lt;/h2&gt; 			&lt;p style="margin-top: 0.55pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 11.25pt 0 51.55pt; text-align: justify"&gt; 				&lt;span&gt;During 2019, Citizens Energy Corporation (the Parent Company), began a program on the Company's behalf that provides assistance to low-income families in the service territory of the Company's partner in this project, San Diego Gas and Electric Company. The program will&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;increase access for low- income families to the benefits of the electrification of the transportation industry, initially by providing funding for electric vehicles (e.g. vans) and charging infrastructure to&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;non-profit organizations that serve low-income families. The funding of the program will be provided by the Company pursuant to&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;its agreement with SDG&amp;amp;E to apply one-half of the Company's adjusted profits derived from the Sycamore-Penasquitos Transmission Line Project to this&lt;/span&gt;&lt;span style="letter-spacing: 0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;purpose.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.1pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.05pt; margin-left: 51.55pt; margin-bottom: 0; text-align: justify; line-height: 12.6pt"&gt; 				&lt;span&gt;The funding obligations for the years ending December 31, 2025 and 2024 amounted to approximately $606,000 and $557,000 respectively, and is included in general and administrative expenses in the accompanying statements of income and member's deficit. As of December 31, 2025 and 2024, the accrued low-income assistance payable amounted to approximately $204,000 and $258,000, respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.05pt; margin-left: 51.55pt; margin-bottom: 0; text-align: justify; line-height: 12.6pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 4.6pt; margin-left: 58.8pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;7.&lt;/span&gt;&lt;span style="width: 2.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;RELATED PARTY&lt;/span&gt;&lt;span style="font-weight: bold; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;TRANSACTIONS&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.55pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 11.45pt 0 51.55pt; text-align: justify"&gt; 				&lt;span&gt;Under an administrative service agreement entered into between the Company and Citizens Enterprises Corporation, certain management and administrative services were provided to the Company. For the years ended December 31, 2025 and 2024, the aggregate fees charged to the Company were approximately $236,000 and $257,000, respectively. Amounts outstanding in the balance sheets at December 31, 2025 and 2024, were approximately $173,000 and $151,000, respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 		&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
    <ferc:AuthorityByWhichTheReceivershipOrTrusteeshipWasCreated id="f-910" contextRef="c-51">NA</ferc:AuthorityByWhichTheReceivershipOrTrusteeshipWasCreated>
