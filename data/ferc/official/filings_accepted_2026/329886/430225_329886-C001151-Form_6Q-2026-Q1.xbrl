  <link:footnoteLink xlink:role="http://www.xbrl.org/2003/role/link" xlink:type="extended">
    <link:footnote xlink:type="resource" xlink:label="fn-1" id="fn-1" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <span xmlns="http://www.w3.org/1999/xhtml" style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:115%">Rental income was overstated in prior periods due to duplicate recognition under both operating lease and sales-type (financing) lease accounting. The lease is appropriately accounted for as a sales-type (financing) lease. The amounts are non-jurisdictional and immaterial. The error has been corrected prospectively effective January 1, 2026.</span>
    </link:footnote>
    <link:loc xlink:type="locator" xlink:label="f-167" xlink:href="#f-167"/>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-167" xlink:to="fn-1" order="1"/>
  </link:footnoteLink>
</xbrli:xbrl>
