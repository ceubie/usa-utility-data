  <ferc:FormType id="HHF7EC89F6B6814CD2CC1C6928B801FC93" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">6</ferc:FormType>
  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C008923</ferc:CompanyIdentifier>
  <ferc:ReportYearPeriod id="HH6439FA2135BC4FC31DA52CEDA67ED097" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2025/Q4</ferc:ReportYearPeriod>
  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q4</ferc:ReportPeriod>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;1.&amp;#160; None&lt;/p&gt;
&lt;p&gt;2.&amp;#160;&amp;#160;&lt;span style="font-size: 0.9rem;"&gt;The equity partners of EPIC Y-Grade, LP (the ultimate parent company of EPIC Y-Grade Pipeline, LP) entered into an agreement to sell 100% of their partnership interests in EPIC Y-Grade, LP to Phillips 66, Inc ("P66"). The transaction closed April 1, 2025. On April 2, 2025 P66 changed the name to Coastal Bend Y-Grade Pipeline, LP.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;3.&amp;#160; None&lt;/p&gt;
&lt;p style="text-align: left;"&gt;4.&amp;#160; The Company is involved in various litigation arising from the normal operations of its pipeline business.&amp;#160; The Company, based on advice of counsel, believes that any adverse findings with respect to such legal actions will not result in a material effect on the financial position of the Company.&amp;#160;&amp;#160;&lt;/p&gt;
&lt;p&gt;5.&amp;#160; Not Applicable&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
  <ferc:DisclosureOfEventsThatHaveAMaterialEffectToRespondentsTextBlock id="HH11476EB422E065C84DE3B12A8533C405" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfEventsThatHaveAMaterialEffectToRespondentsTextBlock>
  <ferc:DisclosureOfRespondentAppearingInAnnualReportToTheStockholdersTextBlock id="HH5E4D37729B3C0D95B1347B63AFD3C1FF" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfRespondentAppearingInAnnualReportToTheStockholdersTextBlock>
  <ferc:DisclosureOfSignificantCommitmentsOrContingentAssetsOrLiabilitiesTextBlock id="HHE3435BEE8D99B1EAE3E25F0CB688A474" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;2.&amp;#160; Not Applicable&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantCommitmentsOrContingentAssetsOrLiabilitiesTextBlock>
  <ferc:DisclosureOfAccountingForTheRespondentSPensionsAndPostretirementBenefitsTextBlock id="HHF8BB3A9A670D2645273296C015F63526" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;3.&amp;#160;&amp;#160;&lt;span style="font-size: 0.9rem;"&gt;Not Applicable&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfAccountingForTheRespondentSPensionsAndPostretirementBenefitsTextBlock>
  <ferc:DisclosureOfDetailsOnAccountingForIncomeTaxesTextBlock id="HHA0DCC38EA11403A96F5600BF710C5197" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;5.&amp;#160;&amp;#160;&lt;span style="font-size: 0.9rem;"&gt;Not Applicable&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfDetailsOnAccountingForIncomeTaxesTextBlock>
  <ferc:ReportYear id="HH660FC444EE17A785BFF22BCDC6434313" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4" decimals="0" unitRef="HHferc_us_Pure">2025</ferc:ReportYear>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-04-20</ferc:ReportDate>
  <ferc:IndicatorStockholdersReportSubmittedOrNotPrepared id="HH338A37446FF58C0756F3AE1CD8A44F64" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Copies Submitted</ferc:IndicatorStockholdersReportSubmittedOrNotPrepared>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p class="MsoNormal"&gt;&lt;strong&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: 'Aptos Display',sans-serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin;"&gt;Basis of Accounting&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoNormal"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: 'Aptos Display',sans-serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin;"&gt;Coastal Bend Y-Grade Pipeline, LP (Company) is subject to regulation by the Federal Energy Regulatory Commission("FERC").&amp;#160; The accounting policies followed in preparation of these financial statements generally conform to those required by FERC.&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: 'Aptos Display',sans-serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p class="MsoNormal"&gt;&lt;strong&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: 'Aptos Display',sans-serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin;"&gt;Participation in a Cash Management Program&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p class="MsoNormal"&gt;&lt;span style="font-size: 10.0pt; line-height: 115%; font-family: 'Aptos Display',sans-serif; mso-ascii-theme-font: major-latin; mso-hansi-theme-font: major-latin;"&gt;The respondent may report on the Balance Sheet and Statement of Cash Flows a zero cash balance due to participation in a cash management program.&amp;#160; Cash Management or "money pool" programs typically concentrate affiliates' cash assets in joint accounts for the purpose of providing financial flexibility and lowering the cost of borrowing.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
  <ferc:DisclosureOfImportantNotesRegardingFinancialStatementsTextBlock id="HHCA5ED8FA45B245705E52E9F0E61FB5CB" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;1.&amp;#160;&amp;#160;&lt;span style="font-size: 0.9rem;"&gt;Not Applicable&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantNotesRegardingFinancialStatementsTextBlock>
  <ferc:DisclosureOfSignificantChangesInOperationsDuringTheYearTextBlock id="HH9B6DE7359654CD51EF2A1E85159D3800" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;4.&amp;#160; The equity partners of EPIC Y-Grade, LP (the ultimate parent company of EPIC Y-Grade Pipeline, LP) entered into an agreement to sell 100% of their partnership interests in EPIC Y-Grade, LP to Phillips 66, Inc ("P66"). The transaction closed April 1, 2025. On April 2, 2025 P66 changed the name to Coastal Bend Y-Grade Pipeline, LP.&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantChangesInOperationsDuringTheYearTextBlock>
  <ferc:DisclosureOfSignificantRateOrOtherRegulatoryMattersTextBlock id="HHDDA657A075463DDF9B45E45AB954A4B4" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;6.&amp;#160;&amp;#160;&lt;span style="font-size: 0.9rem;"&gt;Not Applicable&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfSignificantRateOrOtherRegulatoryMattersTextBlock>
