    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote1" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-left: .25in; tab-stops: .25in .5in 1.0in 1.5in 2.0in 2.5in 3.0in 3.5in 4.0in 4.5in 5.0in 5.5in 6.0in 6.5in; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 10.0pt; font-family: 'Arial',sans-serif;">
            <xhtml:span style="font-size: 16pt;">Represents primarily legal and professional services incurred in association with the 2024 rate case.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value1" xlink:to="footnote1" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="1" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote2" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 16pt;">Amount represents a tax return to provision adjustment.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value2" xlink:to="footnote2" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="2" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote3" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 16pt;">This balance relates to a deferred tax asset associated with gross-up amounts on excess deferred income taxes created by the enactment of the Tax Cuts and Jobs Act of 2017.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value3" xlink:to="footnote3" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="3" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote4" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 16pt;">This balance relates to the excess deferred income taxes created by the revaluation of deferred income tax liabilities due to the reduction in U.S. federal income tax rates from 35% to 21% caused by enactment of the Tax Cuts and Jobs Act of 2017.<xhtml:span style="mso-spacerun: yes;"></xhtml:span>This balance is being amortized to account 411. The amortization is expected to extend through approximately 2057.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value4" xlink:to="footnote4" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="4" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote5" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 10.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">
            <xhtml:span style="font-size: 16pt;">Amount represents non-service-related pension costs that are negative overall and not included in overhead loadings.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value5" xlink:to="footnote5" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="5" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote6" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 10.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">
            <xhtml:span style="font-size: 16pt;">Various charges include labor loadings, general and administrative allocations, professional services, and facility allocations. Amounts are not related to goods and services offered for sale in the normal course of the affiliate's business. Amounts, instead, are costs incurred on behalf of the Company, reimbursable to the incurring affiliate.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value6" xlink:to="footnote6" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="6" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote9" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 16pt; font-family: arial, helvetica, sans-serif;">This volume represents the amount of gas recorded by Great Basin. This amount is recorded on a one-month lag basis and will, therefore, be different from the scheduled monthly volumes reported on page 301, Line 10, Column (j).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value9" xlink:to="footnote9" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="9" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote10" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 16pt; font-family: arial, helvetica, sans-serif;">Includes boil-off, flash, and gas vaporized from Great Basin's LNG facility.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value10" xlink:to="footnote10" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="10" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote11" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 16pt; font-family: arial, helvetica, sans-serif;">Includes the volumes liquefied at Great Basin's LNG Plant.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value11" xlink:to="footnote11" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="11" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote12" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-size: 16pt; font-family: arial, helvetica, sans-serif;">LNG Plant Fuel</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value12" xlink:to="footnote12" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="12" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote13" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 21.3333px;">LNG Plant Fuel</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value13" xlink:to="footnote13" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="13" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote14" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 21.3333px;">LNG Plant Fuel</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value14" xlink:to="footnote14" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="14" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote15" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 21.3333px;">LNG Plant Fuel</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value15" xlink:to="footnote15" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="15" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote16" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 21.3333px;">LNG Plant Fuel</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value16" xlink:to="footnote16" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="16" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote17" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif; font-size: 21.3333px;">LNG Plant Fuel</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value17" xlink:to="footnote17" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="17" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote18" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 16pt; font-family: arial, helvetica, sans-serif;">In 2025 Great Basin Gas Transmission Company received 1,003,576 dekatherms associated with the 2015 Elko area expansion (which has a separate lost and unaccounted for rate).<xhtml:span style="mso-spacerun: yes;"></xhtml:span>The Gas Used by Great Basin that was received from the shippers in 2025 was 91 dekatherms.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value18" xlink:to="footnote18" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="18" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote19" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 16pt; color: black; background: white; font-family: arial, helvetica, sans-serif;">Great Basin recovers Gas Used by Great Basin as in-kind gas from Shippers. This includes compressor station fuel, lost and unaccounted for gas, and LNG Plant fuel. For FERC Form 3Q/2A, Great Basin calculates the value of the Gas Used by Great Basin, which is also recognized as transmission expenses. The resulting overall net income effect is zero. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value19" xlink:to="footnote19" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="19" />
  </link:footnoteLink>
</xbrli:xbrl>
