&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center;"&gt;&lt;font style="font-family: arial, helvetica, sans-serif; font-size: 16pt;"&gt;(3,612,837)&lt;/font&gt;&lt;/p&gt;
