&lt;/td&gt;
&lt;td style="width: 118.617px; border-top: 0.75pt solid #000000; border-bottom: 0.75pt solid #000000; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top; height: 27px;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center;"&gt;&lt;font style="font-family: arial, helvetica, sans-serif; font-size: 16pt;"&gt;$19,500,691&lt;/font&gt;&lt;/p&gt;
&lt;/td&gt;
