&lt;p class="MsoNormal"&gt;&lt;span style="font-size: 10pt; font-family: Arial, sans-serif;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 72.55pt; border: none; mso-border-top-alt: none black 0in; mso-border-top-themecolor: text1; padding: 2.0pt .25pt 1.75pt .25pt; height: 16.15pt;" valign="bottom" width="97"&gt;
&lt;p class="MsoNormal" style="text-align: right;" align="right"&gt;&lt;span style="font-size: 10pt; font-family: Arial, sans-serif;"&gt;3.8&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
