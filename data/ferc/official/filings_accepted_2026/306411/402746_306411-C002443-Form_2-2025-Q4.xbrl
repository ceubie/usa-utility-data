    <link:loc xlink:type="locator" xlink:href="#HHAF546D6F3C0ED7698B0F0CBB478CE563" xlink:label="HHAF546D6F3C0ED7698B0F0CBB478CE563" />
    <link:footnote xlink:type="resource" xlink:label="HH379C0DA924AB39FEBC9B2301D90D2B4A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Balance included $26,223,615 non cash advance receivable distribution to Spectra Energy Partners LP.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHAF546D6F3C0ED7698B0F0CBB478CE563" xlink:to="HH379C0DA924AB39FEBC9B2301D90D2B4A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH8049A4E30CC57A8FA9FE917432A5E488" xlink:label="HH8049A4E30CC57A8FA9FE917432A5E488" />
    <link:footnote xlink:type="resource" xlink:label="HH325B6DE31F8A71C18649CECB76CB1F4A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Our valuation of the net excesses or deficiencies which result from shipper supplied gas,as well as the valuation of the dispositions of excesses and the sources of deficiencies,is based upon the monthly index prices from the Upstream Cashout Rate Calculation for the Appalacia Indexes Market Area.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH8049A4E30CC57A8FA9FE917432A5E488" xlink:to="HH325B6DE31F8A71C18649CECB76CB1F4A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH58EBFFA9F14AD134F297333DD4D577ED" xlink:label="HH58EBFFA9F14AD134F297333DD4D577ED" />
    <link:footnote xlink:type="resource" xlink:label="HH444EF00647C5589D57552F6A331CCBD4" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Our valuation of the net excesses or deficiencies which result from shipper supplied gas,as well as the valuation of the dispositions of excesses and the sources of deficiencies,is based upon the monthly index prices from the Upstream Cashout Rate Calculation for the Appalacia Indexes Market Area.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH58EBFFA9F14AD134F297333DD4D577ED" xlink:to="HH444EF00647C5589D57552F6A331CCBD4" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHC4679100D78F1769781B6D4293D51B1E" xlink:label="HHC4679100D78F1769781B6D4293D51B1E" />
    <link:footnote xlink:type="resource" xlink:label="HHB54336ACEC38025420D84EF12B00F784" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Our valuation of the net excesses or deficiencies which result from shipper supplied gas,as well as the valuation of the dispositions of excesses and the sources of deficiencies,is based upon the monthly index prices from the Upstream Cashout Rate Calculation for the Appalacia Indexes Market Area.</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHC4679100D78F1769781B6D4293D51B1E" xlink:to="HHB54336ACEC38025420D84EF12B00F784" order="1" />
