    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH73B831578FEBA2BD8FF945A9378D214E" xlink:to="HH7F368DC3106ADCB214AB028E1EDFC5E0" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE51ECA036077ED1A8C3A6072399A47CB" xlink:label="HHE51ECA036077ED1A8C3A6072399A47CB" />
    <link:footnote xlink:type="resource" xlink:label="HH6E857788633BA785FCE0C9A0E4E379CB" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <table style="width: 412pt;" border="0" width="549" cellspacing="0" cellpadding="0">
          <tbody>
            <tr style="mso-height-source: userset; height: 27.2pt;">
              <td class="xl77" style="height: 27.2pt; width: 412pt;" width="549" height="36">Gas receipts to eliminate Imbalances are recorded in FERC Account 803; gas deliveries to eliminate Imbalances are recorded in FERC Account 495.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE51ECA036077ED1A8C3A6072399A47CB" xlink:to="HH6E857788633BA785FCE0C9A0E4E379CB" order="1" />
