    <link:loc xlink:type="locator" xlink:label="value4" xlink:href="#Tag93" />
    <link:loc xlink:type="locator" xlink:label="value5" xlink:href="#Tag105" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote4" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>Current year distributions were $71,562,000 which exceeded unappropriated retained income by $11,125,670 as of June 30, 2026. Such excess was recorded against additional paid-in capital.</xhtml:p>
      </xhtml:div>
    </link:footnote>
