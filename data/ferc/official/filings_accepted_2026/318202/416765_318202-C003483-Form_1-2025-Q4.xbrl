 inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 15.75pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;174,072&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 152.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="text-decoration: underline"&gt;Liabilities:&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 83.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 60.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 152.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span&gt;Asset retirement obligation (Note F)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="width: 12.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 46.5pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;-&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 83.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="width: 12.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 46.5pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;-&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 60.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="width: 12.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 6.75pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;224,772&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="width: 13.35pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="width: 15.75pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;224,772&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 				&lt;span style="font-size: 9pt"&gt;(a)&lt;/span&gt;&lt;span style="width: 26.01pt; font-size: 9pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;This category includes investments in equity securities of large-, small-, and medium-sized companies.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 				&lt;span style="font-size: 9pt"&gt;(b)&lt;/span&gt;&lt;span style="width: 7.51pt; text-indent: 0; font-size: 9pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;This category includes equity securities of foreign companies, including those in developing countries.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 				&lt;span style="font-size: 9pt"&gt;(c)&lt;/span&gt;&lt;span style="width: 8.01pt; text-indent: 0; font-size: 9pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;This category includes investments in domestic corporate and/or government investment grade fixed-income instruments.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 				&lt;span style="font-size: 9pt"&gt;(d)&lt;/span&gt;&lt;span style="width: 7.51pt; text-indent: 0; font-size: 9pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;This category includes investments in debt securities of foreign companies.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 				&lt;span style="font-size: 9pt"&gt;(e)&lt;/span&gt;&lt;span style="width: 8.01pt; text-indent: 0; font-size: 9pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;This category includes investments in pooled funds which can include both domestic and foreign equity securities and debt instruments.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 				&lt;span style="font-size: 9pt"&gt;(f)&lt;/span&gt;&lt;span style="width: 9.01pt; text-indent: 0; font-size: 9pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;This category consists of cash and cash equivalents.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; line-height: 10pt"&gt; 				&lt;span style="font-size: 9pt"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 37.5pt"&gt; 				&lt;span&gt;Investments in the plant decommissioning trust, other trusts, and the Company's asset retirement obligation are presented at fair value. Investments are exposed to various risks, such as interest rates, credit and overall market volatility. As such, it is reasonably possible that changes in the values of investment will occur in the near term and that such changes could materially affect the amounts reported in the balance sheets.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; line-height: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;7.&lt;/span&gt;&lt;span style="width: 10.5pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Use of Estimates&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; line-height: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The preparation of financial statements in conformity with accounting principles generally accepted in the United States of America requires management to make estimates and assumptions that affect the reported amounts of assets, liabilities, disclosure of contingent assets and liabilities at the date of the financial statements, and the reported amounts of revenues and expenses during the reporting period. Significant estimates include assumptions used to determine accumulated plan benefits, future estimates of market values of investments, closure costs, asset retirement obligations and the deferred tax valuation allowances. Actual results could differ from those estimates.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt; page-break-inside: avoid; page-break-after: avoid; line-height: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt; page-break-inside: avoid; page-break-after: avoid; line-height: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;8.&lt;/span&gt;&lt;span style="width: 10.5pt; text-indent: 0; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Benefit Plan Risks&lt;/span&gt;&lt;span style="font-weight: bold"&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; line-height: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 10pt"&gt; 				&lt;span&gt;The actuarial present value of accumulated plan benefits is prepared based on certain assumptions pertaining to interest rates, inflation rates, and employee demographics, all of which are subject to change. Due to uncertainties inherent in the estimation and assumption process, it is at least reasonably possible that changes in these estimates and assumptions in the near term could be material to the financial statements.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; line-height: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;9.&lt;/span&gt;&lt;span style="width: 10.5pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Affiliated Services&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 				&lt;span style="font-size: 8pt"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 10pt"&gt; 				&lt;span&gt;In 2025 and 2024, Yankee Atomic Electric Company (&amp;quot;YA&amp;quot;), Connecticut Yankee Atomic Power Company (&amp;quot;CY&amp;quot;), and MY (collectively, the Yankees) shared financial, technical and management services. The following table represents the costs of services shared among MY, CY, and YA. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 10pt"&gt; 				&lt;span style="font-size: 4pt"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="margin-left: 108.9pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="font-size: 9pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; line-height: 10pt"&gt; 							&lt;span style="font-size: 9pt; font-weight: bold; text-decoration: underline"&gt;2025&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; line-height: 10pt"&gt; 							&lt;span style="font-size: 9pt; text-decoration: underline"&gt;2024&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="font-size: 9pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="font-size: 9pt; font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="font-size: 9pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="font-size: 9pt"&gt;MY to CY&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 10pt"&gt; 							&lt;span style="width: 0; font-size: 9pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt; font-weight: bold"&gt;$0.4 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 10pt"&gt; 							&lt;span style="width: 5.2pt; font-size: 9pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;$0.3 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="font-size: 9pt"&gt;MY to YA&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 10pt"&gt; 							&lt;span style="width: 0; font-size: 9pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt; font-weight: bold"&gt;$0.5 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 10pt"&gt; 							&lt;span style="width: 5.2pt; font-size: 9pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;$0.3 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="font-size: 9pt"&gt;CY to MY&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 10pt"&gt; 							&lt;span style="width: 0; font-size: 9pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt; font-weight: bold"&gt;$0.8 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 10pt"&gt; 							&lt;span style="width: 5.2pt; font-size: 9pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;$0.6 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 154.8pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 10pt"&gt; 							&lt;span style="font-size: 9pt"&gt;YA to MY&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 10pt"&gt; 							&lt;span style="width: 0; font-size: 9pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt; font-weight: bold"&gt;$1.0 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; line-height: 10pt"&gt; 							&lt;span style="width: 5.2pt; font-size: 9pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;$1.1 million&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; line-height: 10pt"&gt; 				&lt;span style="font-size: 8pt; font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; line-height: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;10.&lt;/span&gt;&lt;span style="width: 5.5pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Regulatory Accounting and Assets&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; line-height: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The accounting policies of the Company and the accompanying financial statements conform to accounting principles generally accepted in the United States of America applicable to rate-regulated enterprises and reflect the effects of the ratemaking process in accordance with FASB ASC 980, &lt;/span&gt;&lt;span style="font-style: italic"&gt;Regulated Operations&lt;/span&gt;&lt;span&gt;. Assuming a cost-of-service based regulatory structure, regulators may permit incurred costs, normally treated as expenses, to be deferred and recovered through future rates. Through their actions, regulators may also reduce or eliminate the value of an asset or create a liability. If any portion of the Company's operations were no longer subject to the provisions of ASC 980 as a result of a change in the cost-of-service based regulatory structure, the Company would be required to write off related regulatory assets and liabilities. Based on current regulation, the Company believes that its use of regulatory accounting remains appropriate.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;11.&lt;/span&gt;&lt;span style="width: 5.5pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Subsequent Events&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;For purposes of the preparation of these financial statements in conformity with U.S. generally accepted accounting principles, the Company has considered transactions or events occurring through, April 22, 2026, which was the date that the financial statements were available to be issued.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE B - CONCLUSION OF PHASE I, PHASE II PHASE III AND PHASE IV LITIGATION WITH THE U.S. DEPARTMENT OF ENERGY (DOE)&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;Since 1998, MY, along with CY and YA, have sought damages from the DOE related to breach of contract.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase I&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On December 5, 2012, the DOE's right to appeal the Judgment in the Company's Phase I Litigation expired and the Judgment became final. The damages awarded to the Company for Phase I Litigation were $81.7 million. In December 2012, the Department of Justice submitted the required paperwork to the United States Treasury to initiate payment to the Company. A receivable for the award was recorded for both financial statement and tax reporting in December 2012. The proceeds were received on January 30, 2013, and deposited into the Nonqualified Nuclear Decommissioning Trust (&amp;quot;NDT&amp;quot;) pending the outcome of the Company's 2013 FERC Filing. The FERC filing was approved on June 27, 2013 and resulted in a return of $74.3 million of the proceeds to wholesale customers over a three-year period. The first return of proceeds occurred in October 2013 in the amount of $27.7 million. The second payment of $27.0 million was made in September 2014. The final payment of $19.6 million was paid in September 2015. As required by FERC, the liability for these payments was included in regulatory liabilities - customer refunds in the balance sheet. The FERC filing also approved the transfer of $28.3 million from the Spent Fuel Trust to be used to meet ISFSI operations costs; see Note C - &amp;quot;Rate Proceedings.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase II&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On January 14, 2014, the DOE's right to appeal the Judgment in the Company's Phase II Litigation expired and the Judgment became final. The damages awarded to the Company for Phase II Litigation were $35.8 million. In January 2014, the Department of Justice submitted the required paperwork to the United States Treasury to initiate payment to the Company. The Company recorded the receivable in January 2014 when the period for appeals passed and it became likely that such damages would be paid. The damages proceeds of $35.8 million were received on March 28, 2014. On June 5, 2014, the full amount of the $35.8 million proceeds was returned to the Company's wholesale customers in accordance with the Company's 2014 FERC Filing; see Note C - &amp;quot;Rate Proceedings.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase III&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On July 18, 2016, the DOE's right to appeal the Judgment in the Company's Phase III Litigation expired and the Judgment become final. The damages awarded to the Company for Phase III Litigation were $24.6 million. In July 2016, the Department of Justice submitted the required paperwork to the United States Treasury to initiate payment to the Company. The Company recorded the receivable in July 2016 when the period for appeals passed and it became likely that such damages would be paid. The damage proceeds of $24.6 million were received on October 14, 2016. In accordance with the Company's October 2016 Informational FERC Filing, $3.6 million of the proceeds were returned to the Company's wholesale customers on December 15, 2016. The remaining proceeds were deposited into the Decommissioning Trust Fund to fund long-term ISFSI operations and decommissioning costs; see Note C - &amp;quot;Rate Proceedings.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;Phase IV&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On February 21, 2019, the United States Court of Federal Claims rendered a summary judgment associated with uncontested damages in the Phase IV litigation with the DOE and awarded the Company $34.4 million. This left $.4 million remaining in dispute for resolution at trial which was scheduled for June 2019. On April 23, 2019, the DOE's right to appeal the Judgment related to the uncontested damages in the Company's Phase IV Litigation expired and the Judgment become final. The Company recorded the receivable in April 2019 when the period for appeals passed and it became likely that such damages would be paid. The uncontested damage proceeds of $34.4 million were received on June 11, 2019. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Additionally, in lieu of incurring the expense of a trial, the Company and the DOE negotiated an Offer of Settlement associated with the contested damages. On June 12, 2019, the court accepted the Offer of Settlement which entitled the Company to additional proceeds in the amount of $.16 million. The Company recorded this receivable in June 2019 when the court accept the Offer of Settlement. These additional proceeds were received on July 16, 2019.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Following FERC's acceptance of the Company's rate filings as required upon receipt of DOE proceeds, on December 17, 2019, $21 million of the proceeds was returned to the Company's wholesale customers. Of the remaining proceeds, $12.8 million was transferred to the Decommissioning Trust Fund to fund long term ISFSI Operations and Decommissioning costs; $.7 million was used to offset the regulatory asset that was established as a result of the permanent loss of deferred income tax assets that the Company recorded when implementing the Tax Cut and Jobs Act (TCJA); and, $.1 million for lobbying expense was credited to the Statement of Income to reimburse Sponsor Companies for these previously incurred costs; see Note C - &amp;quot;Rate Proceedings.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 12pt"&gt; 				&lt;span style="font-size: 10pt"&gt;For further discussion of litigation that resulted from DOE's failure to assume responsibility for disposal of such spent fuel; see Note I &amp;quot;Commitments and Contingencies&amp;quot; - &amp;quot;DOE Spent&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 10pt"&gt;Fuel Litigation.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE C - RATE PROCEEDINGS&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;After MY's Board of Directors voted to permanently cease power operations and commence decommissioning, the Company filed general rate cases with FERC that resulted in settlements approved in 1999 and 2004. MY's last rate proceeding began July 31, 2008, when the Company submitted tariff modifications in order to replenish the Spent Fuel Disposal Trust (&amp;quot;SFDT&amp;quot;) Fund. MY proposed a five-year recovery period and collections of $6.4 million annually. MY also proposed to transfer excess amounts from its nuclear decommissioning trust (&amp;quot;NDT&amp;quot;) into the SFDT. As the Company explained, this transfer would constitute a &amp;quot;Regulatory Refund&amp;quot; to customers of the excess NDT amounts, while simultaneously billing for the SFDT's replenishment. Finally, MY proposed to maintain the 6.5 percent return on equity that FERC approved in 1999. MY proposed an effective date of November 1, 2008, one month after it completed decommissioning collections. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;FERC assigned Docket No. ER08-1356-000 to the filing, and set a deadline of August 22, 2008 for comments or protests. On August 13, 2008, the Maine Office of Public Advocate provided a letter expressing its concurrence with MY's filing. Shortly after MY's filing, staff from the Maine Public Utilities Commission (&amp;quot;MPUC&amp;quot;) notified MY of their concern over continuing the 6.5 percent ROE level, in light of lower U.S. Treasury bill rates. MY and MPUC subsequently agreed to an ROE of 5.5 percent. On August 22, 2008, MPUC submitted a notice of intervention and comments informing FERC of these developments. On August 26, 2008, MY submitted a filing amendment to reflect the reduced ROE. Finally, on October 16, 2008, MY amended its earlier filings to conform its rate schedule with FERC's designation requirements. FERC issued a letter order accepting the filing on October 30, 2008. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;br style="page-break-before: always; clear: both" /&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On May 1, 2013, MY submitted an application to reduce its wholesale rates under its wholesale power contract to reflect the combined effect of MY's receipt of a damage award in litigation with DOE and a projected increase in decommissioning costs due primarily to the extension of the period during which MY must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance of its obligation to remove that material. MY's application proposed to add a fifteen-year funding mechanism to its wholesale power contract to permit the flow through to customers of additional damage awards that it may receive in further litigation with DOE that are in excess of fifteen-year funding requirements for projected decommissioning costs. MY also proposed to provide credits to purchasers totaling $74.3 million, to be paid in three annual installments over the period 2013-2015. MY's application was based, among other things, on the transfer of certain amounts from MY's spent fuel disposal trust fund to meet ISFSI operating expenses, reducing the need to fund those expenditures from MY's nuclear decommissioning trust fund. MY requested an effective date of July 1, 2013 for its application. MY's filing was supported by a stipulation and agreement among MY, the Connecticut Public Utilities Regulatory Authority, the Connecticut Office of Consumer Counsel, the Maine Public Utilities Commission, the Maine Office of Public Advocate, the Massachusetts Department of Public Utilities, and the Massachusetts Attorney General. On June 27, 2013, FERC issued an order in Docket No. ER13-1395-000 granting MY's application to reduce its rates under the wholesale power contract and approving MY's proposed mechanism to maintain financial assurance and address future DOE recoveries. FERC noted that MY's application was unopposed and supported by state agencies and many other stakeholders.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The receipt of DOE Phase II Litigation proceeds of $35.8 million on March 28, 2014 triggered the requirement approved in the 2013 FERC Order for MY to review its funding needs for a fifteen-year period upon receipt of DOE Proceeds. The review is required to determine the excess (if any) that could flow back to Sponsor Companies as a result of the receipt of the proceeds. Accordingly, the Company conducted the required financial analysis, which was reviewed with and supported by Stakeholders from Maine (ME), Connecticut (CT) and Massachusetts (MA). The results of the financial analysis were submitted to FERC in an Informational Filing on April 29, 2014. The Informational Filing provided for the return of the $35.8 million to the Company's wholesale customers with a rate effective date of June 1, 2014.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;In July 2016, the damage award to MY in Phase III of its litigation against DOE in the amount of $24.6 million became final and no longer subject to appeal. In anticipation of the payment of that damage award, MY performed the financial analysis required by the 2013 FERC Order. As part of that analysis, MY reviewed the decommissioning cost estimate and related financial assumptions that it filed with the Commission in 2013 and determined, as discussed below, that updates were required. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On August 22, 2016, MY provided its financial analysis together with supporting work papers to Stakeholders from CT, MA, and ME including the representatives of the state agencies that executed the stipulation and agreement, submitted in 2013 in Docket No. ER13-1395-000.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;None of the Signatories objected to MY's calculation of its financial analysis, or MY's proposal to credit both a portion of the Phase III DOE damage award and the estimated SFDT surplus to wholesale customers after payment of the DOE pre-1983 spent fuel disposal obligation.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On September 30, 2016, MY submitted a filing in Docket No. ER16-2726-000 updating the decommissioning cost estimate and the related financial assumptions MY used to calculate the financial analysis required by the 2013 FERC Order.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The updated decommissioning estimate reflected a projected increase in decommissioning costs due to a number of factors, including a three-year extension of the period during which MY must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance and increased staffing requirements. MY also proposed to modify its periodic review mechanism in the Power Contracts to allow MY to use DOE proceeds to fund post-retirement benefits other than pension (&amp;quot;PBOP&amp;quot;) expenses, rather than collecting funds for that purpose from its customers.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;MY requested a rate effective date of December 1, 2016 for its application. The proposed changes, submitted in Docket No. ER16-2726-000, did not require new or increased charges to customers. MY proposed that it apply the revisions to the financial analysis to determine what portion of the Phase III DOE award is required to be retained to meet its financial obligations for decommissioning and other matters and what portion, if any, may be credited to wholesale customers. The application was unopposed and supported by state agencies including the Connecticut Public Utilities Regulatory Authority, the Connecticut Office of Consumer Counsel, the Maine Public Utilities Commission, the Maine Office of Public Advocate, the Massachusetts Department of Public Utilities, and the Massachusetts Attorney General. On November 15, 2016, the FERC issued an order accepting the filing of Docket No. ER16-2726-000 with an effective date of December 1, 2016 as requested.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;br style="page-break-before: always; clear: both" /&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The receipt of DOE Phase III Litigation proceeds of $24.6 million on October 14, 2016 triggered the requirement approved in the 2013 FERC Order for MY to review its funding needs for a fifteen-year period upon receipt of DOE proceeds. The review is required to determine the excess (if any) that could flow back to wholesale customers as a result of the receipt of the proceeds. Accordingly, the Company conducted the required financial analysis, which was previously reviewed with and supported by Stakeholders.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The results of the financial analysis were submitted to FERC in an Informational Filing on October 28, 2016.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;In accordance with that filing, $3.6 million of the proceeds were returned to the Company's wholesale customers on December 15, 2016. The remaining proceeds were deposited into the Decommissioning Trust Fund to fund long-term ISFSI operations and decommissioning costs. In addition, on December 15, 2016, the Company returned to wholesale customers $56.5 million of SFT surplus funds following payment to the DOE of the pre-1983 spent fuel disposal obligation. In 2017, after the final payment of taxes and fees associated with the SFT, the remaining balance of $9.6 million was transferred to the Decommissioning Trust Fund for the benefit of the Company's wholesale customers to offset future long-term ISFSI operations and decommissioning costs. The SFT was formally dissolved on September 26, 2017.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;By July 16, 2019, the aggregate $34.6 million of proceeds awarded to the Company in Phase IV of its litigation against DOE was received. As required by the Company's 2013 FERC Order upon receipt of DOE proceeds, a financial analysis was conducted. As part of the analysis, Maine Yankee reviewed the decommissioning cost estimate and related financial assumptions that it last filed with the Commission in 2016 and determined that updates were required. Prior to submitting a 205 Filing to FERC to update the decommissioning cost estimate, Maine Yankee provided its financial analysis together with supporting work papers to Stakeholders from ME, CT, and MA, including the representatives of the state agencies that executed the stipulation and agreement, submitted in 2013 in Docket No. ER13-1395-000. None of the Signatories objected to Maine Yankee's calculation of its financial analysis.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On September 23, 2019, Maine Yankee submitted a 205 filing in Docket No. ER19-2855-000 updating the decommissioning cost estimate and the related financial assumptions Maine Yankee used to calculate the financial analysis required by the 2013 FERC Order. The updated decommissioning cost estimate reflected a projected increase in decommissioning costs due to a number of factors, including a three-year extension of the period during which Maine Yankee must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance, and increased staffing requirements to address succession planning. Maine Yankee also proposed to extend the &amp;quot;sunset&amp;quot; provision of the Power Contract, which specifies when Maine Yankee must submit a filing to initiate a review of the financial assurance mechanism.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 18pt"&gt; 				&lt;span&gt;Maine Yankee requested a rate effective date of December 1, 2019 for its application. The proposed changes, submitted in Docket No. ER19-2855-000, did not require new or increased charges to customers. The application was unopposed and supported by state agencies including the Connecticut Public Utilities Regulatory Authority, the Connecticut Office of Consumer Counsel, the Maine Public Utilities Commission, the Maine Office of Public Advocate, the Massachusetts Department of Public Utilities, and the Massachusetts Attorney General. On November 7, 2019, the FERC issued an order accepting the filing of Docket No. ER19-2854-000 with&lt;/span&gt;&lt;span style="font-size: 9pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;an effective date of December 1, 2019 as requested.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The receipt of DOE Phase IV Litigation proceeds of $34.6 million also triggered the requirement approved in the 2013 FERC Order for MY to review its funding needs for a fifteen-year period upon receipt of DOE proceeds. The review is required to determine the excess (if any) that could flow back to wholesale customers as a result of the receipt of the proceeds. Accordingly, the Company conducted the required financial analysis, which was previously reviewed with and supported by Stakeholders as discussed above. The results of the financial analysis were submitted to FERC in an Informational Filing on September 23, 2019. In accordance with that filing, on December 17, 2019, $21.0 million of the proceeds was returned to the Company's wholesale customers. Of the remaining proceeds, $12.8 million was transferred to the Decommissioning Trust Fund to fund long term ISFSI Operations and Decommissioning costs; $.7 million was used to offset the regulatory asset that was established as a result of the permanent loss of deferred income tax assets that the Company recorded when implementing the TCJA of 2017; &lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and, $.1 million for lobbying expense was credited to the Statement of Income to reimburse Sponsor Companies for these previously incurred costs.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In September 2024, the Company's DOE Phase V litigation was ongoing. See Note I - Commitments and Contingencies. As required by the Company's 2013 FERC Order, due to the passage of five years from its most recent informational filing and absent the receipt of DOE proceeds, a financial analysis was conducted. As part of the analysis, Maine Yankee reviewed the decommissioning cost estimate and related financial assumptions that it last filed with the Commission in 2019 and determined that updates were required. Prior to submitting a 205 Filing to FERC to update the decommissioning cost estimate, Maine Yankee provided its financial analysis together with supporting work papers to Stakeholders from CT, MA, and ME, including the representatives of the state agencies that executed the stipulation and agreement, submitted in 2013 in Docket No. ER13-1395-000. None of the Signatories objected to Maine Yankee's calculation of its financial analysis.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;On September 18, 2024, the Company submitted FERC informational and 205 filings in Docket No. ER24-3068-000 updating the decommissioning cost estimate and the related financial assumptions Maine Yankee used to calculate the financial analysis required by the 2013 FERC Order. The updated decommissioning cost estimate reflected a projected increase in decommissioning costs due to a number of factors, including a five-year extension of the period during which Maine Yankee must store spent nuclear fuel and high-level waste on-site because of DOE's continued non-performance, an increase in the cost escalation rate and increased staffing requirements to address succession planning.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 12pt; text-indent: 36pt"&gt; 				&lt;span&gt;The proposed changes did not require new or increased charges to customers. Maine Yankee requested a rate effective date of November 18, 2024 for its application.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;On November 14, 2024, the FERC issued an order accepting the filing of Docket No. ER24-3068-000 with an effective date of November 18, 2024 as requested. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Maine Yankee will continue to allocate prior DOE litigation damages to fund projected decommissioning costs, which will be based on the 2024 Estimate. Upon receipt of any future damage awards resulting from its litigation with the DOE, Maine Yankee will prepare an updated financial analysis and credit any balance not necessary to fund projected decommissioning costs back to its customers.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;See discussion of DOE Phase V Litigation in Note I - Commitments and Contingencies.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE D - NUCLEAR FUEL&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;The Energy Policy Act of 1992, enacted October 24, 1992, established the Uranium Enrichment Decontamination and Decommissioning (&amp;quot;UED&amp;amp;D&amp;quot;) Fund and authorized the collection of a special assessment for domestic utilities over a fifteen-year period. The Company made the final payment of $2.2 million in 2006. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;On January 8, 2026, the House adopted a three-bill minibus Appropriations Package that included the FY 2026 Energy and Water Development and Related Agencies (E&amp;amp;WD) appropriations bill (H.R. 6938). This appropriations package did not include reinstatement of the UED&amp;amp;D fee on domestic utilities. The Senate passed that Appropriations Package on January 15, 2026, and presented it to the President on January 22, 2026. The President signed the appropriations package into law on January 23, 2026.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;No amount has been accrued for this matter as of December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 98%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; line-height: 98%"&gt; 				&lt;span&gt;For discussion of litigation that resulted from DOE's refusal to assume responsibility for disposal of such spent fuel, see Note I, &amp;quot;Commitments and Contingencies&amp;quot; - &amp;quot;DOE Spent Fuel Litigation.&amp;quot;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE E - INCOME TAXES&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; font-size: 7pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Income tax expense (benefit) consists of the following components:&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 453.2pt; margin-left: 18pt; border-collapse: collapse" class="e-rte-table"&gt; 				 					&lt;tr&gt; 						&lt;td style="width: 264.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; widows: 0; orphans: 0"&gt; 								&lt;span style="font-weight: bold; text-decoration: underline"&gt;2025&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 77pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; widows: 0; orphans: 0"&gt; 								&lt;span style="text-decoration: underline"&gt;2024&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 				 				 					&lt;tr style="height: 4.05pt"&gt; 						&lt;td style="width: 264.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0; font-size: 9pt"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 167pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; widows: 0; orphans: 0; font-size: 9pt"&gt; 								&lt;span&gt;(Dollars in Thousands)&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 264.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span&gt;Income taxes charged to operations&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; widows: 0; orphans: 0"&gt; 								&lt;span style="width: 18.6pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold"&