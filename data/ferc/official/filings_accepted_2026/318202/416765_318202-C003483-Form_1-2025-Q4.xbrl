    <ferc:DeductionsRecordedOnBooksNotDeductedForReturnDescription id="f-719" contextRef="c-236">Book Tax Expense</ferc:DeductionsRecordedOnBooksNotDeductedForReturnDescription>
    <ferc:DeductionsRecordedOnBooksNotDeductedForReturnDescription id="f-720" contextRef="c-239">Deferred Officer Medical &amp; Life</ferc:DeductionsRecordedOnBooksNotDeductedForReturnDescription>
    <ferc:DeductionsRecordedOnBooksNotDeductedForReturnDescription id="f-721" contextRef="c-233">Lobbying</ferc:DeductionsRecordedOnBooksNotDeductedForReturnDescription>
    <ferc:DeductionsRecordedOnBooksNotDeductedForReturnDescription id="f-722" contextRef="c-234">Meals &amp; Entertainment</ferc:DeductionsRecordedOnBooksNotDeductedForReturnDescription>
    <ferc:DeductionsRecordedOnBooksNotDeductedForReturnDescription id="f-723" contextRef="c-237">NQ Fund W/D - State only</ferc:DeductionsRecordedOnBooksNotDeductedForReturnDescription>
