t;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;27,251&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 42pt; padding-right: 6pt; padding-left: 6pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 							&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;1,467&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 42pt; padding-right: 6pt; padding-left: 6pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 							&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;263&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 0"&gt; 					&lt;td style="width: 67.5pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 54pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 59.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 50.4pt"&gt; 					&lt;/td&gt; 					&lt;td style="width: 3.6pt"&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Nonqualified Trust Fund is a &amp;quot;Grantor&amp;quot; Trust and any federal income tax resulting from earnings of the Trust is reported on the Company's tax return. The Nonqualified Trust Fund reimburses the Company for any income tax liabilities created by the taxable earnings of the Nonqualified Trust Fund investments. The Qualified Trust Fund is a separate taxable entity for federal income tax purposes. Contributions by the Company to the Qualified Trust Fund are deductible, subject to the IRS Approved Schedule of Ruling Amounts; and decommissioning expense withdrawals by the Company represent taxable income.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE H - EMPLOYEE BENEFITS&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span style="font-weight: bold"&gt;Post-Retirement Benefits Other Than Pension&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company maintains a post-retirement welfare benefit plan for employees who retire from active service after meeting specified age and service requirements. Beginning January 1, 2025, the Company pays 100% of the medical premiums for retirees. In 2024, the Company paid 100% of the premiums for certain retirees and other retirees contributed to the cost of the medical premiums. At age 65, the medical insurance converts to Medicare Advantage Plan.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;MY's post-retirement welfare benefit plan is funded through non-union (&amp;quot;NU&amp;quot;) and union subaccounts in a trust that is intended to qualify as a voluntary employee beneficiary association (&amp;quot;VEBA&amp;quot;) under IRC Section 501(c)(9). The VEBA trust funds the benefits for non-key employees. The benefits for key employees (as defined in IRC Section 416) are paid out of Company assets. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Accrued and prepaid benefit costs recognized in the balance sheets at December 31, 2025 and 2024 have offsetting regulatory assets and liabilities, respectively, as they are expected to be included in billing in future years.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;In accordance with FASB ASC 715, &lt;/span&gt;&lt;span style="font-style: italic"&gt;Compensation--Retirement Benefits&lt;/span&gt;&lt;span&gt;, the Company recognizes an asset or liability in its balance sheet for the over-funded or under-funded status of its post-retirement plan. The post-retirement asset or liability is the difference between the fair value of the plans' assets and the projected benefit obligations as of year-end. In accordance with ASC 980, the Company has recorded regulatory assets or liabilities in lieu of taking a charge or credit to accumulated other comprehensive income.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt; text-align: left"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt; text-align: left"&gt; 				&lt;span&gt;The following tables represent the plan's beginning benefit obligation balance reconciled to the ending benefit obligation balance, beginning fair value of plan assets balance reconciled to the ending fair value of plan assets balance and the respective funds funded status reconciled to the balance sheets, along with other information about the plan:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 463.5pt; margin-left: 36pt; border-collapse: collapse" class="e-rte-table"&gt; 				 					&lt;tr&gt; 						&lt;td style="width: 189pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-left: 34.65pt; margin-bottom: 0; text-indent: -34.65pt; text-align: left"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="4" style="width: 274.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-left: 135pt; margin-bottom: 0; text-align: center"&gt; 								&lt;span style="text-decoration: underline"&gt;December 31,&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr style="height: 15.7pt"&gt; 						&lt;td style="width: 189pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 135pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td colspan="2" style="width: 139.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 								&lt;span style="text-decoration: underline"&gt;Post-Retirement Benefits&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 					&lt;/tr&gt; 					&lt;tr&gt; 						&lt;td style="width: 189pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 								&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 67.5pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center"&gt; 								&lt;span&gt;&amp;#160;&lt;/span&gt; 							&lt;/p&gt; 						&lt;/td&gt; 						&lt;td style="width: 72pt; vertical-align: top"&gt; 							&lt;p style="margin-top: 0; ma