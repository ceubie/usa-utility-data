    <ferc:ControlOverRespondentTextBlock id="f-693" contextRef="c-25">&lt;div class="Section_1"&gt; 			&lt;table cellspacing="0" cellpadding="0" style="border: 0.75pt solid rgba(0, 0, 0, 1); border-collapse: collapse"&gt; 				&lt;tr&gt; 					&lt;td style="width: 222.95pt; border-right: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;Central Maine Power Company&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 222.95pt; border-left: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;38%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-right: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;New England Power Company&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-left: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;24%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-right: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;Connecticut Light and Power Company&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-left: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;12%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-right: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;Versant Power&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-left: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;12%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-right: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;Public Service Company of New Hampshire&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-left: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;5%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-right: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;NSTAR Electric &amp;amp; Gas Corporation&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-left: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;7%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-right: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;Green Mountain Power Corporation&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-left: 0.75pt solid rgba(0, 0, 0, 1); border-bottom: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span style="text-decoration: underline"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;2%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-right: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;Total&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 222.95pt; border-top: 0.75pt solid rgba(0, 0, 0, 1); border-left: 0.75pt solid rgba(0, 0, 0, 1); padding-right: 5.03pt; padding-left: 5.03pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; line-height: normal"&gt; 							&lt;span&gt;100%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 		&lt;/div&gt;</ferc:ControlOverRespondentTextBlock>
    <ferc:NotesToFinancialStatementsTextBlock id="f-695" contextRef="c-25">&lt;div&gt;&lt;div class="Section_1"&gt; 			&lt;h1 style="margin-top: 18pt; margin-bottom: 4pt; page-break-inside: avoid; page-break-after: avoid; font-size: 12pt"&gt; 				&lt;span style="font-family: &amp;quot;Aptos Display&amp;quot;; font-weight: normal; color: rgba(15, 71, 97, 1)"&gt;Notes to Financial Statements&lt;/span&gt; 			&lt;/h1&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE A - SUMMARY OF SIGNIFICANT ACCOUNTING POLICIES&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;1.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;System of Accounts&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company is subject to regulations prescribed by the Federal Energy Regulatory Commission (the &amp;quot;FERC&amp;quot;) with respect to accounting and other matters. The Company is also subject to regulations by the NRC for nuclear plant licensing and safety and by federal and state agencies for environmental matters such as air quality, water quality, and independent spent fuel storage. The Company has contracts with its Shareholders/Sponsors. Under the terms of the contracts, each Shareholder/Sponsor is required to pay the Company an amount equal to its entitlement percentage of the Company's total operating expenses, including a return on investment and payment of decommissioning costs. The balance sheet accounts of the MY Decommissioning Trust are included in the Company's balance sheet.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The accompanying financial statements of the Company were prepared in accordance with the accounting requirements of the FERC as set forth in the applicable Uniform System of Accounts and published accounting releases, which is a comprehensive basis of accounting other than generally accepted accounting principles.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;2.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Utility Plant&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On January 15, 1998, the net balance of utility plant was reclassified to net unrecovered assets, except for the book value of land.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;3.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Nuclear Decommissioning&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company collected the costs of funding the decommissioning of its plant and long-term fuel storage costs through the period ended October 2008, as approved in the Company's FERC rate filings. From November 1, 2008 through October 31, 2013, the Company collected the amounts necessary to replenish its Spent Fuel Disposal Trust for funds previously used for ISFSI construction and fuel transfers.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company recognizes the relative uncertainties associated with decommissioning and long-term ISFSI operations, including changing technology and the possibility of new requirements of law, and therefore recognizes the need to monitor and adjust decommissioning collections through supplemental rate filings with the FERC. In addition, the Company acknowledges the uncertainties associated with investment earnings on the Decommissioning Trust and with projecting decommissioning costs and in particular with the number of years it will take before it is relieved of the costs and burdens of storing nuclear fuel and high level waste.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;4.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Income Taxes&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The tax effect of the temporary differences (differences between the periods in which transactions affect income in the financial statements and the periods in which they affect the determination of income subject to tax) is accounted for in accordance with regulatory approval.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company follows accounting guidance for uncertainty in income taxes which is part of Financial Standards Accounting Board (&amp;quot;FASB&amp;quot;) Accounting Standards Codification (&amp;quot;ASC&amp;quot;) 740, &lt;/span&gt;&lt;span style="font-style: italic"&gt;Income Taxes&lt;/span&gt;&lt;span&gt;. The guidance prescribes a recognition threshold and measurement attributes for financial statement recognition of a tax position taken or expected to be taken on a tax return. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;5.&lt;/span&gt;&lt;span style="width: 10.5pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; letter-spacing: -0.15pt"&gt;Cash and Cash Equivalents&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; letter-spacing: -0.15pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;All liquid investments with an original maturity of three months or less are considered to be cash equivalents.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 37.5pt; margin-bottom: 0"&gt; 				&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="width: 36pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The Company maintains its cash in bank accounts which may exceed federally insured limits. The Company has not experienced any losses in such accounts, and believes it is not exposed to any significant risk with respect to these accounts.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;br style="page-break-before: always; clear: both" /&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold; letter-spacing: -0.15pt"&gt;6.&lt;/span&gt;&lt;span style="width: 10.5pt; font-weight: bold; letter-spacing: -0.15pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; letter-spacing: -0.15pt"&gt;Fair Value Measurement&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company adopted the provisions of FASB ASC 820, &lt;/span&gt;&lt;span style="font-style: italic"&gt;Fair Value Measurement&lt;/span&gt;&lt;span&gt;. ASC 820 defines fair value as the exchange price that would be received for an asset or paid to transfer a liability (an exit price) in the principal or most advantageous market for the asset or liability in an orderly transaction between market participants on the measurement date. ASC 820 also establishes a fair value hierarchy which requires an entity to maximize the use of observable inputs and minimize the use of unobservable inputs when measuring fair value. The standard describes three levels of inputs that may be used to measure fair value: &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;Level 1: &lt;/span&gt;&lt;span style="width: 18.46pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Quoted prices (unadjusted) for identical assets or liabilities in active markets that the entity has the ability to access as of the measurement date.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: 36pt; font-size: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;Level 2: &lt;/span&gt;&lt;span style="width: 18.46pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Significant other observable inputs other than Level 1 prices, such as quoted prices for similar assets or liabilities, quoted prices in markets that are not active, and other inputs that are observable or can be corroborated by observable market data. The Company uses quoted prices for similar assets for Level 2 values.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: 36pt; font-size: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;Level 3: &lt;/span&gt;&lt;span style="width: 18.46pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Significant unobservable inputs that reflect an entity's own assumptions about the assumptions that market participants would use in pricing an asset or liability.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: 72pt; font-size: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;The following table presents the assets and liabilities measured on a recurring basis at fair value as of December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 8pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="width: 501.3pt; border-collapse: collapse" class="e-rte-table"&gt; 				&lt;tr&gt; 					&lt;td style="width: 152.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span&gt;Quoted Prices in Active Markets for Identical Assets &lt;/span&gt;&lt;span style="text-decoration: underline"&gt;(Level 1)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 83.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span&gt;Significant Other Observable Inputs &lt;/span&gt;&lt;span style="text-decoration: underline"&gt;(Level 2)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 60.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;br /&gt;&lt;span&gt;Unobservable Inputs&lt;/span&gt;&lt;br /&gt;&lt;span style="text-decoration: underline"&gt;(Level 3)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span&gt;Balance as of December 31, &lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span style="text-decoration: underline"&gt;2025&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 152.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="4" style="width: 327.6pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span&gt;(Dollars in Thousands)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 152.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 9pt"&gt; 							&lt;span style="text-decoration: underline"&gt;Assets:&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 83.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 60.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 152.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 9pt"&gt; 							&lt;span&gt;Plant decommissioning&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 83.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 60.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: center; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 152.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; text-indent: -18pt; text-align: left; font-size: 9pt"&gt; 							&lt;span style="width: 18pt; text-indent: 0; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;State and local government debt &lt;/span&gt;&lt;span style="width: 7.79pt; text-indent: 0; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;securities (c)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="width: 12.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$&lt;/span&gt;&lt;span style="width: 24.75pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;26,574&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 83.7pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="width: 12.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$&lt;/span&gt;&lt;span style="width: 29.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;3,349&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 60.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="width: 12.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$&lt;/span&gt;&lt;span style="width: 33pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;-&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 71.85pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="width: 13.35pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$&lt;/span&gt;&lt;span style="width: 20.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;29,923&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 152.1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 9pt"&gt; 							&lt;span style="width: 18pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Domestic corporate bonds (c)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 79.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 							&lt;span style="width: 12.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 51pt; display: inline-block"&gt;&