ak-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span style="width: 13.95pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 14.27pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;46%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 176.75pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span style="width: 18.8pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cash and equivalents&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span style="width: 13.95pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 16.35pt; font-family: &amp;quot;Lucida Console&amp;quot;; font-weight: bold; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;1%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span style="width: 13.95pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 18.62pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;1%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span style="width: 13.95pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 18.2pt; font-family: &amp;quot;Lucida Console&amp;quot;; font-weight: bold; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;1%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span style="width: 13.95pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 19.27pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;1%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr&gt; 					&lt;td style="width: 176.75pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span&gt;Total&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span style="width: 13.95pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 6.35pt; font-family: &amp;quot;Lucida Console&amp;quot;; font-weight: bold; text-decoration: underline; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;100%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span style="width: 13.95pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 8.62pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;100%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span style="width: 13.95pt; font-weight: bold; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 6.35pt; font-family: &amp;quot;Lucida Console&amp;quot;; font-weight: bold; text-decoration: underline; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-weight: bold; text-decoration: underline"&gt;100%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 61.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid; widows: 0; orphans: 0"&gt; 							&lt;span style="width: 13.95pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="width: 9.27pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;100%&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The current asset allocation target for the nonunion and union subaccounts in MY's post-retirement benefit plan is 50% equity and 50% fixed income. This target allocation reflects the long-term nature of the liabilities associated with these subaccounts. The primary goals in the management of these subaccount assets are to maintain the funds' purchasing power and to maximize the long-term after-tax total return within the context of a moderate-risk environment.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;NOTE I - COMMITMENTS AND CONTINGENCIES&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;1.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Nuclear Liability Insurance&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Price-Anderson Act (the &amp;quot;Act&amp;quot;) is a federal statute that mandates an industry-wide program of nuclear liability insurance for nuclear facilities. Under the Act, the requirement to provide Primary Financial Protection is provided for by commercial insurance companies and Secondary Financial Protection is provided through a retrospective assessment levied on each of the units licensed to operate in the United States. The Act was extended through 2025 by the Energy Policy Act of 2005.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On January 20, 1998, the Company submitted to the NRC a request for a reduction of the Primary Financial Protection layer and withdrawal from the Secondary Financial Protection program. The exemption was granted on January 7, 1999. The required level of Primary Financial Protection was reduced to $100 million and the Company is no longer a participant in the Secondary Financial Protection program. The Company remains liable for any retrospective premium assessments arising from nuclear incidents occurring during the period the Company participated in the Secondary Financial Protection program. Under the billing provisions of the Power Contracts, these assessments, if any, would be included in the cost of power. An indemnity agreement with the NRC provides for protection above the primary coverage layer up to $560 million.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt; page-break-inside: avoid; page-break-after: avoid"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;2.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;DOE Spent Fuel Litigation&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In the Nuclear Waste Policy Act of 1982 (&amp;quot;the Act&amp;quot;), Congress provided for the DOE to dispose of spent nuclear fuel and other high-level waste, including GTCC waste (hereinafter &amp;quot;Nuclear Waste&amp;quot;), from nuclear generating plants and, in 1983, MY and the DOE entered into a standard disposal contract mandated by the Act. The contract required DOE to begin disposing of MY's Nuclear Waste by the end of January 1998. As of this date, the DOE has failed to even begin to honor its contract obligation to dispose of MY's Nuclear Waste, and due to the ongoing political and regulatory uncertainties associated with the DOE nuclear waste program, the Company cannot predict when the DOE may begin performance of its obligations. As an interim measure, until the DOE complies with its contractual obligation to dispose of MY's Nuclear Waste, the Company constructed an ISFSI, utilizing dry-cask storage, on the Plant site and completed the transfer of its Nuclear Waste to the ISFSI in 2004. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In the Spring of 1998, MY, along with CY and YA, two other New England-based shut-down nuclear generating plants (collectively &amp;quot;the Yankees&amp;quot;), filed claims in the United States Court of Federal Claims seeking damages resulting from the breach of the 1983 contracts by the DOE. In November 1998, the Court ruled that the DOE had breached the contracts and was liable for damages but left the amount of damages to be determined after a trial on the evidence. The ruling was affirmed by the United States Court of Appeals for the Federal Circuit in August of 2000.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In another damages case (Indiana Michigan), the appellate court also ruled that a utility could not recover future damages under the Standard Contract. The effect of this ruling was to require utilities to bring periodic suits to recover past damages. The Yankees' initial suit against the DOE for damages under the Standard Contract was for all damages incurred prior to December 31, 2002 for MY and December 31, 2001 for YA and CY. These cases are referred to as the Phase I cases. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The consolidated trial in the Claims Court to determine damages in the Phase I cases lasted seven weeks and concluded in August 2004. At the trial and in post-trial briefing, the DOE contended that the costs associated with the storage of the Nuclear Waste were not covered by the Company's contract and they challenged a number of additional positions taken by the Yankees, including the rate at which the DOE was required to accept the fuel, whether the Company's pre-1983 monetary obligation for fuel disposal should be treated as an offset to any damages, and whether an exchange program would have developed that would change the order in which the fuel would be picked up from the various sites by the DOE.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On October 4, 2006, the Claims Court issued judgment for MY in the amount of $75.8 million for its spent-fuel-related costs through 2002, ruling in favor of the Company on substantially all of the major issues, and entered judgments in different amounts in favor of CY and YA. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The decision also awarded the Company substantially all of its costs of the mid-1990s re-racking of its spent fuel pool, in which spent fuel was stored until its transfer to the ISFSI. The decision, however, denied recovery of costs incurred through 2002 associated with spent-fuel-pool storage and called into question claims for recovery of such costs for an unspecified period after 2002. The Court based those conclusions on its findings that MY would have had to incur fuel storage costs through 2002 and for some time thereafter even if DOE had performed its contract obligations, and therefore those costs did not constitute recoverable damages at least through the period covered by the decision. In addition to ISFSI construction costs, the Court also found both Nuclear Waste and &amp;quot;failed fuel&amp;quot; to be covered under the Standard Contract as claimed by the Company but left undetermined whether additional fees might be imposed for disposal of Nuclear Waste. In calculating its costs of closure, the Company has assumed that no additional Nuclear Waste disposal costs are required under the contract.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On December 4, 2006, the DOE appealed the Phase I decision to the United States Court of Appeals for the Federal Circuit, which heard oral arguments on the cases on February 4, 2008. In the Court of Appeals, two other appeals involving issues similar to those of the three Yankees' cases, Pacific Gas &amp;amp; Electric Co. v. United States and Sacramento Public Utility District v. United States, were consolidated for argument purposes before the same three-judge panel. The trial courts in those cases had reached conclusions that appeared to be in conflict with the MY Claims Court decision on several issues common to those cases. On August 7, 2008, the Court of Appeals issued its decisions on the five appeals, vacating some of the findings of the trial courts and remanding the cases to the trial courts with instructions to apply the 1987 ACR acceptance rates to assess causation for the ISFSI and re-racking costs awarded in the Phase I cases. In addition, the Court of Appeals affirmed that the proper value of the cost of GTCC waste disposal remained open for adjudication in future proceedings. The Court of Appeals also affirmed the lower court's position that pre-1983 monetary obligations for fuel disposal should not be treated as an offset to money damages. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The remanded trial case was presented to the judge the week of August 10, 2009, and post-trial briefing and argument was concluded by December 10, 2009. The Court filed its decision in the remanded cases on September 7, 2010, awarding MY $81.7 million, which was more than was awarded the Company in the first trial. The principal reasons for the increase were the awards for fuel loading and crane upgrade costs, which were not awarded to the Company in the first decision.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The government appealed the Judge's decision claiming, among other reasons, that he misinterpreted the mandate rule by expanding the scope of the issues to be considered in the remanded case. On May 18, 2012, the appellate court affirmed most of the trial judge's decision. The government then filed a timely petition for reconsideration and rehearing en banc. In early September 2012, the appellate court denied these petitions. The government decided not to appeal further and these Phase I decisions became final in early December 2012. The Company received the awarded damages in the amount of $81.7 million in January 2013.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In December 2007, the Yankees filed a complaint against the government for damages sustained since January 1, 2002, for CY and YA, and since January 1, 2003 for MY (hereinafter the &amp;quot;Phase II cases&amp;quot;). In early July 2009, MY notified the government that it would seek approximately $35 million in damages from the government in this Phase II case, adding damages from 2008 to the claim. In early February 2010, the government began its discovery into the Yankees' claimed damages. The Phase II trial occurred in early October 2011. In October 2012, the trial Judge issued an Order that allowed the parties to file supplemental briefs on relevant case law that arose following the close of the trial. Both parties submitted additional briefing. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On November 1, 2013, the Claims Court issued judgment for MY in the amount of $35.8 million for its spent-fuel-related costs through 2008, ruling in favor of the Company on most of the major issues, and entered judgments in different amounts in favor of CY and YA. On January 14, 2014, the DOE's right to appeal the Judgment in the Company's Phase II litigation expired and the Judgment became final. The Company received the awarded damages. On June 5, 2014, the full amount of the proceeds of $35.8 million was returned to the Company's wholesale customers in accordance with the Company's 2014 FERC Filing (see Note C - &amp;quot;Rate Proceedings&amp;quot;).&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid; font-size: 9pt"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; page-break-after: avoid"&gt; 				&lt;span&gt;In August 2013, the Yankees filed another complaint against the government for damages sustained from January 1, 2009, through December 31, 2012 (&amp;quot;Phase III cases&amp;quot;). In December 2013, MY notified the government that it believed the amount of damages it would seek in this case was approximately $25.2 million. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In a pre-trial order, the Judge directed the parties to pursue settlement discussions. The parties met in May 2014 to begin these discussions and exchanged proposals during the year but were unable to settle their dispute. In September 2014, the Judge issued an order setting the Phase III cases for trial from June 30 to July 2, 2015. The trial concluded on July 1, 2015. The trial Judge ultimately requested two rounds of post-trial briefing. The final round concluded on February 12, 2016. An oral argument on the second round was held on February 19, 2016. Judge Merow issued his decision under seal on March 25, 2016. The seal was removed, and the decision reissued on April 7, 2016. The decision awarded Yankee Atomic $19.6 million; Maine Yankee $24.6 million; and Connecticut Yankee $32.6 million, which totals approximately 98.6% of the damages sought. On April 21, 2016, the Yankees filed a motion for clarification, which requested that Judge Merow explain a statement in his opinion that implies that the Companies would not be entitled to recover the costs of benefits administration going forward. The motion was denied.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On July 18, 2016, the DOE's right to appeal the Judgment in the Company's Phase III Litigation expired and the Judgment became final. The Company received the awarded damages of $24.6 million on October 14, 2016, returned $3.6 million to its wholesale customers and deposited the balance in the Decommissioning Trust Fund to fund long-term ISFSI operations and decommissioning costs in accordance with the Company's FERC filings. (See Note C - &amp;quot;Rate Proceedings.&amp;quot;)&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company filed its next case, Phase IV, on May 22, 2017, in the Federal Court of Claims, seeking damages for the period from January 1, 2013, through December 31, 2016. As a result of the death of Judge James Merow, who had heard and decided the first three Yankees' damages cases, the Phase IV case was assigned to Senior Judge Nancy Firestone. The Yankees submitted their claimed Phase IV damages to the government in late August 2017. Maine Yankee sought approximately $34.8 million in damages for the Phase IV period. On July 24, 2018, the Yankees filed a motion seeking partial summary judgment of $103.2 million in uncontested damages.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The remaining approximately $1.1 million in contested damages remained on schedule for trial.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The parties had several pre-trial conferences with Judge Firestone on a variety of issues including uncontested damages and scheduling. Discovery was set to close originally on August 15, 2018, but later extended to October 15, 2018.Trial was set for January 29 and 30, 2019. However, because of the partial government shutdown at the end of 2018 and into most of January 2019, Judge Firestone stayed all pre-trial actions in early January 2019, effectively delaying the trial. Following the reopening of the government at the end of January 2019, Judge Firestone issued a new Order setting trial for June 2019. On February 21, 2019, Judge Firestone ruled in the Yankees' favor on their pending Motion for Partial Summary Judgment. The Judge's ruling awarded Maine Yankee $34.4 million in uncontested damages, while Connecticut Yankee was awarded $40.7 million, and Yankee Atomic $28.1 million. The government had 60 days to appeal this decision. On April 23, 2019, the government's right to appeal expired, the decision became final and a request for payment was sent to the U.S. Department of the Treasury. Payment was received on June 11, 2019. &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;Of the remaining approximately $1.1 million in total Yankees contested damages, Judge Firestone held a pre-trial hearing on a specific legal question regarding approximately $.1 million in total Yankees legal expenses related to the DOE litigation. Following briefing and oral argument on the issue, Judge Firestone denied the Yankees' claim for these damages. Of the remaining approximately $1 million in total Yankees contested damages, rather than go to trial on these issues, the parties negotiated an Offer of Settlement splitting the difference so that the Yankees ultimately received an additional $.5 million of total Yankees contested damages. Maine Yankee's share of these damages totaled $.2 million. The acceptance of the Offer of Settlement by the Court ended the Phase IV cases.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company filed its Phase V case on March 25, 2021, in the Federal Court of Claims, seeking damages for the period from January 1, 2017 through December 31, 2020. The Phase V case was assigned to Judge Carolyn Lerner, a new judge who was confirmed at the end of 2021. The Company submitted its Phase V damages claim to the government in October 2021. The Court had set July 25, 2023 as the date for trial.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;In June 2022 Judge Lerner issued an Order that, among other things, allowed the Yankees to amend their Complaint to add 2021 damages to the case.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;In November 2022 the case was reassigned to Judge Thompson Dietz who had been appointed to the Court in December 2020.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;In January 2023, at the request of all parties, Judge Dietz rescheduled the trial for the last two weeks of October 2023.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt; text-indent: 36pt; line-height: 105%"&gt; 				&lt;span&gt;During a pre-trial conference in the late Summer of 2023, Judge Dietz informed the parties that he did not want to hold the trial until after he had considered and ruled on the competing Summary Judgment Motions that had been filed.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;He scheduled oral argument on the Motions for November 2, 2023, and asked the parties to confer and agree to a trial that could be held in the Spring of 2024.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The parties informed the Court that they agreed to a trial that could be held during the last two weeks of March 2024.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;Following the hearing on the Summary Judgment Motions, Judge Dietz informed the parties that he would rule on the Motions soon. On February 7, 2024, Judge Dietz ruled in favor of the Yankees on the competing Summary Judgment Motions finding, in essence, that the government could not use trust fund earnings as a set off to damages.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 8pt; text-indent: 36pt; line-height: 105%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Judge Dietz held a status conference with the parties on February 22, 2024, to discuss next steps, including the consideration of pending discovery motions by both parties.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;On March 13, 2024, Judge Dietz issued an Order establishing a schedule to resolve the discovery disputes by June 10, 2024.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The Order also states that the Court will contact the parties to schedule a post discovery conference to set dates for further proceedings.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;In late June 2024, Judge Dietz set the Phase V trial to occur during a two-week period beginning in late October through early November.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;In mid-September 2024, the parties reached a verbal agreement to settle the Phase V case subject to certain conditions.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The Yankees would receive $145 million of the approximately $149 million they would seek at trial, the Yankees' Boards of Directors and the senior management of the Department of Justice (&amp;quot;DOJ&amp;quot;) had to agree to the settlement amount, and the DOJ reserved the right to appeal Judge Dietz's Summary Judgment trust fund off-set decision in favor of the Yankees.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;All needed approvals were obtained and Judge Dietz issued an Order approving the settlement in mid-November 2024.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;On January 17, 2025, the DOJ filed an appeal of Judge Dietz's Summary Judgment decision.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;As of this writing, no schedule has been established for the oral argument in the Federal Circuit Court of Appeals.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company filed its Phase VI case on March 31, 2026, in the Federal Court of Claims, seeking damages for the period January 1, 2022 through December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 105%"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;The Company believes it is entitled to continue to recover substantial damages for the DOE's ongoing breach of its contractual obligations and intends to vigorously pursue such recoveries.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.15pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;3.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Jurisdictional Issues&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;At its 2000 session, the Maine Legislature enacted a bill to create new radiological standards that are more stringent than NRC standards. The legislation also provided for evaluating a cumulative risk assessment and provided the state with additional power to monitor activities and radioactive waste at the MY site. State review of MY's site release documentation is still underway as of December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54.15pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span style="font-weight: bold"&gt;4.&lt;/span&gt;&lt;span style="width: 10.5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span style="font-weight: bold"&gt;Other Matters&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 9pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;The Company has been involved in certain other legal matters in the regular course of business, including defending cases where former non-employee workers at the site have sued Maine Yankee for damages for alleged injuries related to exposure to asbestos.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;One such asbestos case is pending against the Company from a complaint received on March 19, 2026.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;This case is not expected to have a material financial impact on the Company. Accordingly, no amount has been accrued for this matter as of December 31, 2025.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 36pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;In 2023, the real estate tax agreement that the Company and the Town of Wiscasset (&amp;quot;Town&amp;quot;) signed in 2004 expired.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The parties could not reach an extension agreement and, as a result, the Company filed for and received a pollution control abatement from real estate taxes for certain improvements related to the storage of spent nuclear fuel at the ISFSI.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The Town appealed the grant of the abatement to the State Board of Environmental Protection.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The Town lost their appeal.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The Town appealed the Board's decision to the Superior Court.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;In a related action, a bill was filed in the Maine Legislature seeking, in effect, to eliminate Maine Yankee's real estate tax exemption for its pollution control equipment.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The Company lobbied against the proposed bill, but it was passed by the State Legislature and signed by the Governor of Maine in April 2024.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;As a result, the Town's Superior Court appeal was dismissed as moot and the exemption was rescinded by the State ultimately.&lt;/span&gt;&lt;span&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;The Town could now assess the Company for taxes on the real estate value of the pollution control equipment.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;Additionally, following the termination of the 20-year property tax agreement in 2023, the Town reassessed Maine Yankee's property values increasing the total assessed value from approximately $30 million to $90 million, which values did not include the property associated with the pollution control exemption. The Company disputed this reassessment as inaccurate and based on incorrect assessment methodology.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-indent: 18pt"&gt; 				&lt;span&gt;The parties held a non-binding mediation session on October 7, 2024, and reached a settlement on the contested property values subject to Board approvals. The MY Board approved the proposed settlement at their meeting on October 9, 2024. On October 16, 2024, representatives from the Town of Wiscasset informed MY that the Select Board approved the proposed settlement of the tax dispute. The parties have negotiated and signed the Settlement Agreement ending this matter. The Company has paid the initial payment pursuant to the agreement, which covers tax years 2023 through 2029.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 		&lt;/div&gt;&lt;p&gt;&lt;br /&gt;&lt;/p&gt;&lt;hr style="width: 33%; height: 1px; text-align: left" /&gt;&lt;p&gt;&lt;br /&gt;&lt;/p&gt;&lt;div&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; text-align: left"&gt;&lt;br /&gt;&lt;/p&gt; 		&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
