  <ferc:ObligationsUnderCapitalLeaseNoncurrent id="HHBF7F77689DC4005C369A5D815859978E" contextRef="HH7B7758B43D530B049277B7E198A48CAD" decimals="0" unitRef="HHferc_us_Currency">1031500</ferc:ObligationsUnderCapitalLeaseNoncurrent>
