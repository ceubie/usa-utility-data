  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH8291874A33D45F87FEFD0AB18EFA6A60" xlink:label="HH8291874A33D45F87FEFD0AB18EFA6A60" />
    <link:footnote xlink:type="resource" xlink:label="HHD9B74023D23E28CA06D08E68E36865F1" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">Contains both revenue earned from NYISO per the revenue requirement for transmission service filed with FERC and proceeds from TCC revenues as shown in the table below.&#160;</span>
        </p>
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">1.) $18,147,521 - Transmission Revenue</span>
        </p>
        <p>
          <span style="color: #000000; font-family: sans-serif; font-size: medium;">2.) $1,384,126 - TCC Revenue&#160;</span>
        </p>
        <p>&#160;</p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH8291874A33D45F87FEFD0AB18EFA6A60" xlink:to="HHD9B74023D23E28CA06D08E68E36865F1" order="1" />
