  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH6ADFC3BDDAD399BBBF3B0FF20E3DE350" xlink:label="HH6ADFC3BDDAD399BBBF3B0FF20E3DE350" />
    <link:footnote xlink:type="resource" xlink:label="HH01A37F6B5068D6192ED7FA9A31221DFB" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>Represents proceeds from the disposal of fixed assets.<br /></p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6ADFC3BDDAD399BBBF3B0FF20E3DE350" xlink:to="HH01A37F6B5068D6192ED7FA9A31221DFB" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH43CDAB98A7B57D2BD9ED153111CF45CA" xlink:label="HH43CDAB98A7B57D2BD9ED153111CF45CA" />
    <link:footnote xlink:type="resource" xlink:label="HH7C2D2005527034271446EB0EC8A5765E" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">Contains both revenue earned from NYISO per the revenue requirement for transmission service filed with FERC and proceeds from TCC revenues as shown in the table below.&#160;</p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">1.)&#160;<span class="cf0">$36,589,606</span>&#160;- Transmission Revenue</p>
        <p style="color: #000000; font-family: sans-serif; font-size: medium;">2.)&#160;<span class="cf0">$1,842,295 </span>&#160;- TCC Revenue&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH43CDAB98A7B57D2BD9ED153111CF45CA" xlink:to="HH7C2D2005527034271446EB0EC8A5765E" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>