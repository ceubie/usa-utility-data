    <ferc:EquityInEarningsLossesOfAffiliatedCompanies id="f-300" contextRef="c-65" unitRef="u-02" decimals="0">0</ferc:EquityInEarningsLossesOfAffiliatedCompanies>
    <ferc:UnappropriatedRetainedIncome id="f-301" contextRef="c-65" unitRef="u-02" decimals="0">16229344</ferc:UnappropriatedRetainedIncome>
    <ferc:CashAndCashEquivalents id="f-303" contextRef="c-65" unitRef="u-02" decimals="0">23482856</ferc:CashAndCashEquivalents>
    <ferc:CashFlowsProvidedFromUsedInFinancingActivities id="f-304" contextRef="c-15" unitRef="u-02" decimals="0">0</ferc:CashFlowsProvidedFromUsedInFinancingActivities>
    <ferc:CashFlowsProvidedFromUsedInInvestmentActivities id="f-305" contextRef="c-15" unitRef="u-02" decimals="0">-744757</ferc:CashFlowsProvidedFromUsedInInvestmentActivities>
    <ferc:CashOutflowsForPlant id="f-306" contextRef="c-15" unitRef="u-02" decimals="0">744757</ferc:CashOutflowsForPlant>
    <ferc:CashProvidedByOutsideSources id="f-307" contextRef="c-15" unitRef="u-02" decimals="0">0</ferc:CashProvidedByOutsideSources>
    <ferc:DepreciationAndDepletion id="f-308" contextRef="c-15" unitRef="u-02" decimals="0">3923496</ferc:DepreciationAndDepletion>
    <ferc:GrossAdditionsToCarrierPropertyInvestmentActivities id="f-309" contextRef="c-15" unitRef="u-02" decimals="0">744757</ferc:GrossAdditionsToCarrierPropertyInvestmentActivities>
    <ferc:NetCashProvidedByUsedInOperatingActivities id="f-310" contextRef="c-15" unitRef="u-02" decimals="0">15322092</ferc:NetCashProvidedByUsedInOperatingActivities>
    <ferc:NetIncreaseDecreaseInCashAndCashEquivalents id="f-311" contextRef="c-15" unitRef="u-02" decimals="0">14577335</ferc:NetIncreaseDecreaseInCashAndCashEquivalents>
    <ferc:NetIncreaseDecreaseInInventoryOperatingActivities id="f-312" contextRef="c-15" unitRef="u-02" decimals="0">-2762698</ferc:NetIncreaseDecreaseInInventoryOperatingActivities>
    <ferc:NetIncreaseDecreaseInPayablesAndAccruedExpensesOperatingActivities id="f-313" contextRef="c-15" unitRef="u-02" decimals="0">351306</ferc:NetIncreaseDecreaseInPayablesAndAccruedExpensesOperatingActivities>
    <ferc:NetIncreaseDecreaseInReceivablesOperatingActivities id="f-314" contextRef="c-15" unitRef="u-02" decimals="0">-3299550</ferc:NetIncreaseDecreaseInReceivablesOperatingActivities>
    <ferc:NoncashAdjustmentsToCashFlowsFromOperatingActivities id="f-316" contextRef="c-32" unitRef="u-02" decimals="0">83739</ferc:NoncashAdjustmentsToCashFlowsFromOperatingActivities>
    <ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities id="f-318" contextRef="c-05" unitRef="u-02" decimals="0">-339349</ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities>
    <ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities id="f-319" contextRef="c-18" unitRef="u-02" decimals="0">8334</ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities>
    <ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities id="f-320" contextRef="c-24" unitRef="u-02" decimals="0">0</ferc:OtherAdjustmentsToCashFlowsFromOperatingActivities>
    <ferc:NotesToFinancialStatementsTextBlock id="f-322" contextRef="c-15">&lt;p style="margin: 0; color: rgba(73, 80, 87, 1); font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;br /&gt;&lt;/p&gt;</ferc:NotesToFinancialStatementsTextBlock>
    <ferc:DisclosureOfImportantNotesRegardingFinancialStatementsTextBlock id="f-324" contextRef="c-15">&lt;div&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;b style="font-weight: bolder"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;ORGANIZATION AND OPERATIONS&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Beta Crude Connector, LLC (&amp;quot;BCC&amp;quot; or &amp;quot;the Company&amp;quot;), a Delaware limited liability company, was formed on March 21, 2019, and is a wholly owned subsidiary of Beta Holding Company, LLC (&amp;quot;BHC&amp;quot;). On March 27, 2023, COG Operating, LLC (&amp;quot;COG&amp;quot;), a 50% owner of BHC, acquired the interest of FMS IV, LLC, the remaining 50% owner of BHC.&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;After this transaction, BHC became a wholly owned subsidiary of COG.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;BCC's business is to design, engineer, install, own and operate midstream facilities for crude petroleum pipeline transportation and terminalling services in the Midland Basin of West Texas. The Company's headquarters is in Houston, TX and began jurisdictional service and commenced common carrier operations on July 1, 2019.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;The accompanying financial statements are presented in accordance with the Uniform System of Accounts as prescribed by the Federal Energy Regulatory Commission (&amp;quot;FERC&amp;quot;). The preparation of the financial statements requires use of estimations and assumptions that affect the reported assets and liabilities at the date of the financial statements and the reported amount of revenues and expense during the reporting period.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;The Company's activities are subject to significant risks and uncertainties, including decreases in the production of crude oil due to volatility in commodity prices.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;b style="font-weight: bolder"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;COMPARATIVE BALANCE SHEET STATEMENT&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;CASH&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;PAGE 110, LINE 1&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Cash consists of cash in noninterest-bearing accounts.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;ACCOUNTS RECEIVABLE&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;PAGE 110, LINE 6&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Accounts receivable represent valid claims against customers. Under the transportation agreements with BCC's third-party shippers, the Company invoices its customers after its performance obligations have been satisfied at which point payment is unconditional. The performance obligation is completed when the Company re-delivers the crude oil to the customer at their specified delivery point. This obligation is satisfied daily, as such, the transportation agreements do not give rise to contract assets or liabilities.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;The Company extends credit terms to certain customers based on historical dealings and to other customers after a review of various credit indicators and generally does not require collateral for credit extended to its customers.&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;An allowance for doubtful accounts is provided, when necessary, to cover estimated credit losses. Such an allowance is based upon management's knowledge of customer accounts, economic conditions and aging analysis.&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;At December 31, 2025 and 2024, there were no allowances for doubtful accounts. The Company writes off accounts receivable when it deems an account uncollectible.&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;There were no write offs of accounts receivable during the three-month periods ended December 31, 2025 and 2024. For the Company's accounts receivable, the carrying value is a reasonable estimate of fair value because of the short-term nature of the instruments.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;PREPAYMENT&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;PAGE 110, LINE 11&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;At December 31, 2025, the majority of the prepayments balance related to prepaid insurance premiums which are amortized over the term of the policies.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;OIL INVENTORY, ALLOWANCE FOR OIL REVENUE AND OIL LOSSESS AND SHORTAGES&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;PAGE 110 - LINE 9, PAGE 301 - LINE 4 AND PAGE 302 - LINE 5&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;The Company does not purchase crude oil but may experience an actual long or short at the end of a period as a result of variances in meter readings and other measurement methods, volume fluctuations within the pipeline due to pressure and temperature changes, evaporation and other factors.&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;These actual volumetric gains or losses are valued at the period-end estimated average net realizable value of crude oil (&amp;quot;Net Realizable Value&amp;quot;) and recorded as either increases or decreases to &amp;quot;Oil Inventory&amp;quot; - account 16 and &amp;quot;Oil Losses and Shortages&amp;quot; - account 340.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Independent of the actual monthly gains or losses and as is common in the pipeline industry, the Company, through its tariff, is provided a pipeline loss allowance (&amp;quot;PLA&amp;quot;) to offset pipeline losses due to evaporation, handling, measurement, and other losses in transit.&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;The PLA, which is incurred by the shipper, is valued at the Net Realizable Value and recorded as an increase to &amp;quot;Oil Inventory&amp;quot; - account 16 and &amp;quot;Allowance Oil Revenue&amp;quot; - account 230.&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;Occasionally, the Company may sell excess PLA at the current market price and record the difference between the proceeds received from the sale and the associated Net Realizable value in &amp;quot;Allowance Oil Revenue&amp;quot; - account 230.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;TANGIBLE PROPERTY&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;PAGE 110 - LINE 28&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;At December 31, 2025, the Company had approximately 76 miles of pipeline under FERC jurisdictional service and common carrier operations with three pipeline delivery points (Plains Midland South Facility, Oryx Midland Express BCC Connection and Centurion Pipeline L.P. Mabee Ranch Station) and two 100,000-barrel storage tanks located at its Martin County, TX Breakout Facility.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;PAGE 110 - LINE 29&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;On November 20, 2019, BCC submitted its request for approval of initial property account depreciation rates to be effective July 1, 2019. On January 30, 2020, FERC accepted the proposed depreciation rates, Depreciation Order Docket No. DO20-7-000. BCC applied those rates retroactively to July 1, 2019.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;br /&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;OTHER NONCURRENT LIABILITIES&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;PAGE 110 - LINE 61&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify; line-height: 17.44px"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;At December 31, 2025, the Company had capital lease arrangements and accordingly recorded capital assets and the related lease liabilities based on the present value of the remaining minimum fixed rental payments (which includes payments for the primary lease term as well as renewal options that are probable to be exercised), using a discount rate that the Company would have to pay to borrow on a collateralized basis over a similar term.&lt;span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;/span&gt;The rentals are prepaid at the beginning of the lease term.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify; line-height: 17.44px"&gt;&lt;span style="font-size: 10pt; line-height: 14.5333px"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 0.5in; font-style: normal; font-weight: 400; text-align: left; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-indent: -34.55pt"&gt;&lt;b style="font-weight: bolder"&gt;&lt;span style="font-size: 12pt; font-family: Arial, sans-serif"&gt;INCOME STATEMENT&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;OPERATING REVENUES&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;PAGE 114, LINE 1 AND PAGE 300, LINE 2&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&lt;br /&gt;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Revenues generally consist of fee-based activities associated with transporting crude oil on the Company's pipeline transportation system typically based on published tariffs. Pipeline tariff and fee revenues are recognized over time as services are rendered, based on the volumes received into the Pipeline for transportation and re-delivered back to the shipper or its designee. The fee is calculated by multiplying the volume of barrels received into the Pipeline for transportation times the agreed upon tariff or fee per barrel. The Company has multi-year contractual arrangements with all shippers on its Pipeline&lt;/span&gt;&lt;span style="font-size: 10pt"&gt;.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify; line-height: 17.44px"&gt;&lt;span style="font-size: 10pt; line-height: 14.5333px"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;As of December 31&lt;/span&gt;&lt;span style="font-family: Arial, sans-serif"&gt;, 2025, BCC had one reportable segment and provides only crude oil transportation services.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 0.5in; font-style: normal; font-weight: 400; text-align: left; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 10pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-indent: -34.55pt"&gt;&lt;span style="font-size: 12pt; font-family: Arial, sans-serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;b style="font-weight: bolder"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;OTHER&lt;/span&gt;&lt;/b&gt;&lt;/p&gt;&lt;p style="margin: 0; font-style: normal; font-weight: 400; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify; text-indent: 9pt"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Commitments and Contingencies&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 0.25in; font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;Right of Way (&amp;quot;ROW&amp;quot;) - BCC, as part of its pipeline construction process, must obtain certain ROW agreements from landowners whose property the pipeline will cross. All ROW obtained by BCC are capitalized as part of property, plant and equipment.&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 0 9pt; font-style: normal; font-weight: 400; white-space: normal; color: rgba(73, 80, 87, 1); background-color: rgba(255, 255, 255, 1); font-size: 12pt; font-family: &amp;quot;Times New Roman&amp;quot;, serif; text-align: justify; text-indent: 9pt"&gt;&lt;span style="font-family: Arial, sans-serif"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;&lt;p style="margin: 0 0 1rem; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; color: rgba(73, 80, 87, 1); font-family: sans-serif; background-color: rgba(255, 255, 255, 1)"&gt;&lt;span style="font-size: 12pt; font-family: Arial, sans-serif"&gt;There were no loss contingencies at December 31, 2025 and 2024.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfImportantNotesRegardingFinancialStatementsTextBlock>
    <ferc:DisclosureOfAccountingForTheRespondentSPensionsAndPostretirementBenefitsTextBlock id="f-326" contextRef="c-15">&lt;p&gt;N/A&lt;/p&gt;</ferc:DisclosureOfAccountingForTheRespondentSPensionsAndPostretirementBenefitsTextBlock>
    <ferc:DisclosureOfSignificantCommitmentsOrContingentAssetsOrLiabilitiesTextBlock id="f-327" contextRef="c-15">&lt;p style="text-align: left"&gt;&lt;span style="color: rgba(73, 80, 87, 1); font-family: sans-serif; font-size: 14px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); display: inline !important; float: none"&gt;SEE NOTES TO FINANCIAL STATEMENTS - &amp;quot;ORGANIZATION AND OPERATIONS&amp;quot;&lt;/span&gt;&lt;br /&gt;&lt;/p&gt;</ferc:DisclosureOfSignificantCommitmentsOrContingentAssetsOrLiabilitiesTextBlock>
