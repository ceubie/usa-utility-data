&lt;p class="MsoNormal" style="page-break-after: avoid; border: none; mso-padding-alt: 31.0pt 31.0pt 31.0pt 31.0pt; mso-border-shadow: yes;"&gt;&lt;span style="font-size: 8pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
