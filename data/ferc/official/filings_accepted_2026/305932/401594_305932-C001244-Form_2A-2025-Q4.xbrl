&lt;p class="MsoNormal"&gt;&lt;strong&gt;&lt;span style="font-size: 9.0pt; font-family: 'Arial',sans-serif; layout-grid-mode: line;"&gt;Year Ending December 31,&amp;#160; &amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
