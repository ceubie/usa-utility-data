  <ferc:DescriptionOfPlantAndOperationsOfRespondentTextblock id="HH6CC6D2760132B8FA11CA169AC5DFBDF8" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DescriptionOfPlantAndOperationsOfRespondentTextblock>
  <ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock id="HH582A4E700260C05D782FA2D6F218758A" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;None&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfMateriallyImportantTransactionsOfTheRespondentNotDisclosedElsewhereTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;&lt;span style="font-size: 12.6px;"&gt;Effective April 30, 2025, Katherine Kountze was elected as a Director of Granite State Gas Transmission, Inc. (Grantite State). Effective April 30, 2025, Edward Godfrey retired as a Director of Granite State. Effective April 30, 2025, Dan Hurstak was elected as Senior Vice President &amp;amp; Treasurer of Granite State. Effective October 29, 2025, Kumiko Shortill was elected as Assistant Secretary of Granite State. Effective October 29, 2025 Carleton Simpson was elected as Senior Vice President of Granite State. Effective December 31, 2025, Sandra Whitney retired as Secretary of Granite State.&lt;/span&gt;&lt;/p&gt;&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock id="HH26F298D96F05ADD051F0C74B218AC0A3" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock>
  <ferc:DisclosureOfSignificantContingentAssetsOrLiabilitiesTextBlock id="HHBF53398AA5137162F0C0A6B245F0BF61" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfSignificantContingentAssetsOrLiabilitiesTextBlock>
  <ferc:DisclosureOfSignificantFinancialChangesTextBlock id="HH768D5D4066691F2DD5E2FA0EE9BB7BA0" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfSignificantFinancialChangesTextBlock>
  <ferc:DisclosureOfUnsettledRateProceedingsTextBlock id="HH4BF49E161908A7C6C0D18BFC6FC7874B" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfUnsettledRateProceedingsTextBlock>
  <ferc:GeneralInformationOnPlantAndOperationsTextblock id="HHC332833881D2580C544BE05EFCF2D545" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p class="MsoNormal"&gt;Granite State Gas Transmission, Inc., a subsidiary of Unitil Corp., operates an 85-mile pipeline, transporting natural gas to Northern Utilities, Inc., and to third-party marketers.&amp;#160; Respondent&amp;#8217;s system extends from Haverhill, Massachusetts through New Hampshire to Portland, Maine.&amp;#160; The system has four receipt points and twenty-eight delivery points.&amp;#160; Granite State Gas has no on-system storage or compressor stations.&lt;/p&gt;&lt;/div&gt;</ferc:GeneralInformationOnPlantAndOperationsTextblock>
