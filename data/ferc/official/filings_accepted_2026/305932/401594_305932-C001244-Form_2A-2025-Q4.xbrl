&lt;/td&gt;
&lt;td style="width: 70.1pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .1in; mso-height-rule: exactly;" valign="top" width="93"&gt;
&lt;p class="MsoNormal"&gt;&lt;span style="font-size: 9.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 70.1pt; border: none; border-top: solid windowtext 1.0pt; mso-border-top-alt: solid windowtext .5pt; padding: 0in 5.4pt 0in 5.4pt; height: .1in; mso-height-rule: exactly;" colspan="2" valign="top" width="93"&gt;
&lt;p class="MsoNormal"&gt;&lt;span style="font-size: 9.0pt; font-family: 'Arial',sans-serif; mso-bidi-font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
