    <link:loc xlink:type="locator" xlink:label="value12" xlink:href="#Tag376" />
    <link:loc xlink:type="locator" xlink:label="value14" xlink:href="#Tag382" />
    <link:loc xlink:type="locator" xlink:label="value15" xlink:href="#Tag408" />
    <link:loc xlink:type="locator" xlink:label="value16" xlink:href="#Tag417" />
    <link:loc xlink:type="locator" xlink:label="value17" xlink:href="#Tag452" />
    <link:loc xlink:type="locator" xlink:label="value18" xlink:href="#Tag460" />
    <link:loc xlink:type="locator" xlink:label="value19" xlink:href="#Tag470" />
    <link:loc xlink:type="locator" xlink:label="value20" xlink:href="#Tag479" />
    <link:loc xlink:type="locator" xlink:label="value21" xlink:href="#Tag488" />
    <link:loc xlink:type="locator" xlink:label="value22" xlink:href="#Tag549" />
    <link:loc xlink:type="locator" xlink:label="value26" xlink:href="#Tag556" />
    <link:loc xlink:type="locator" xlink:label="value27" xlink:href="#Tag562" />
    <link:loc xlink:type="locator" xlink:label="value42" xlink:href="#Tag846" />
    <link:loc xlink:type="locator" xlink:label="value41" xlink:href="#Tag847" />
    <link:loc xlink:type="locator" xlink:label="value23" xlink:href="#Tag870" />
    <link:loc xlink:type="locator" xlink:label="value24" xlink:href="#Tag882" />
    <link:loc xlink:type="locator" xlink:label="value25" xlink:href="#Tag886" />
    <link:loc xlink:type="locator" xlink:label="value47" xlink:href="#Tag1233" />
    <link:loc xlink:type="locator" xlink:label="value46" xlink:href="#Tag1247" />
    <link:loc xlink:type="locator" xlink:label="value48" xlink:href="#Tag1275" />
    <link:loc xlink:type="locator" xlink:label="value40" xlink:href="#Tag1276" />
    <link:loc xlink:type="locator" xlink:label="value39" xlink:href="#Tag1318" />
    <link:loc xlink:type="locator" xlink:label="value28" xlink:href="#Tag1340" />
    <link:loc xlink:type="locator" xlink:label="value29" xlink:href="#Tag1346" />
    <link:loc xlink:type="locator" xlink:label="value30" xlink:href="#Tag1352" />
    <link:loc xlink:type="locator" xlink:label="value49" xlink:href="#Tag1358" />
    <link:loc xlink:type="locator" xlink:label="value32" xlink:href="#Tag1364" />
    <link:loc xlink:type="locator" xlink:label="value33" xlink:href="#Tag1369" />
    <link:loc xlink:type="locator" xlink:label="value34" xlink:href="#Tag1375" />
    <link:loc xlink:type="locator" xlink:label="value35" xlink:href="#Tag1390" />
    <link:loc xlink:type="locator" xlink:label="value50" xlink:href="#Tag1396" />
    <link:loc xlink:type="locator" xlink:label="value37" xlink:href="#Tag1401" />
    <link:loc xlink:type="locator" xlink:label="value38" xlink:href="#Tag1407" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote1" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Net activity for the quarter (column d) and year (column c), including gas retainage charged and fuel use, increased inventory by 900,377 dth for the year (column c) and increased inventory by 338,948 dth for the quarter (column d).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value1" xlink:to="footnote1" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="1" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote2" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">This line item includes Gas Received from Shippers as Fuel and Company Use &amp; Surface Operating Allowance. The majority is Fuel and Company Use.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value2" xlink:to="footnote2" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="2" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote3" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">The line item represents gas received from shippers as Transportation and Storage Lost &amp; Unaccounted For.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value3" xlink:to="footnote3" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="3" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote4" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Net negative imbalances decreased inventory by 36,700 dth for the year (column c) and 18,941 dth for the quarter (column d).</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value4" xlink:to="footnote4" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="4" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote5" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Total Receipts for Lines 4, 5 and 7 reflect the flow period of 1/1/26 through 6/30/26 for the year (column c) and 4/1/26 through 6/30/26 for the quarter (column d). All other lines reflect the flow period of 12/1/25 through 5/31/26 for the year and 3/1/26 through 5/31/25 for the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value5" xlink:to="footnote5" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="5" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote6" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Interruptible commodity volumes of 679,273 dth for the year (column c) and 360,124 for the quarter (column d). The total volume of 792,483 dth for the year and 407,647 for the quarter are not subject to ACA.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value6" xlink:to="footnote6" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="6" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote7" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Includes volumes related to lease agreements with Empire Pipeline, Tennessee Gas Pipeline and Transcontinental Gas Pipeline totaling 36,997,153 dth for the year (column c) and 15,290,364 dth for the quarter (column d) which are not subject to ACA.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value7" xlink:to="footnote7" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="7" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote8" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Includes volumes related to a lease agreement with Empire Pipeline totaling 2,254,624 dth for the year (column c) and 25,292 dth for the quarter (column d) which are not subject to ACA.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value8" xlink:to="footnote8" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="8" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote9" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">These volumes are also included in the volumes on line 20. These volumes are not subject to ACA.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value9" xlink:to="footnote9" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="9" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote10" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">This line represents all fuel used by Supply Corporation. These volumes are not subject to ACA.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value10" xlink:to="footnote10" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="10" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote11" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">These volumes represent other measurement adjustments. These volumes are not subject to ACA.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value11" xlink:to="footnote11" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="11" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote12" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Total Deliveries &amp; Unaccounted For for Lines 19, 20 and 22 reflect the flow period of 1/1/26 through 6/30/26 for the year (column c) and 4/1/26 through 6/30/26 for the quarter (column d). All other lines reflect the flow period of 12/1/25 through 5/31/26 for the year and 3/1/26 through 5/31/26 for the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value12" xlink:to="footnote12" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="12" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote13" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:table style="border-collapse: collapse; width: 28.4782%; height: 120px;" border="0">
          <xhtml:tbody>
            <xhtml:tr style="height: 20px;">
              <xhtml:td style="width: 32.8632%; height: 20px; text-align: center;">
              </xhtml:td>
              <xhtml:td style="width: 16.4261%; height: 20px; text-align: center; border-bottom-width: 1pt; border-bottom-style: solid; border-bottom-color: #000000;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the year (column c)</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 18.6622%; height: 20px; text-align: center; border-bottom: 1pt solid #000000;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the quarter (column d)</xhtml:span>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="height: 20px;">
              <xhtml:td style="width: 32.8632%; height: 20px;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">Gathering System Losses</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 16.4261%; height: 20px; text-align: right;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">166,185</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 18.6622%; height: 20px; text-align: right;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">95,169 </xhtml:span>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="height: 20px;">
              <xhtml:td style="width: 32.8632%; height: 20px;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">Transmission System Losses</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 16.4261%; height: 20px; text-align: right;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">969,500</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 18.6622%; height: 20px; text-align: right;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">450,753 </xhtml:span>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="height: 20px;">
              <xhtml:td style="width: 32.8632%; height: 20px;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">Storage Losses</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 16.4261%; height: 20px; text-align: right;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">113,780</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 18.6622%; height: 20px; text-align: right;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">45,383 </xhtml:span>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="height: 20px;">
              <xhtml:td style="width: 32.8632%; height: 20px;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">Other Losses/(Gains)</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 16.4261%; height: 20px; text-align: right; border-bottom-width: 1pt; border-bottom-style: solid; border-bottom-color: #000000;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">        6,199</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 18.6622%; height: 20px; text-align: right; border-bottom: 1pt solid #000000;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">    (10,339)</xhtml:span>
              </xhtml:td>
            </xhtml:tr>
            <xhtml:tr style="height: 20px;">
              <xhtml:td style="width: 32.8632%; height: 20px;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">Total Gas Losses and Gas Unaccounted For</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 16.4261%; height: 20px; text-align: right; border-bottom-width: 1pt; border-bottom-style: solid; border-bottom-color: #000000;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;"> 1,255,664</xhtml:span>
              </xhtml:td>
              <xhtml:td style="width: 18.6622%; height: 20px; text-align: right; border-bottom: 1pt solid #000000;">
                <xhtml:span style="font-family: arial, helvetica, sans-serif;">    580,966</xhtml:span>
              </xhtml:td>
            </xhtml:tr>
          </xhtml:tbody>
        </xhtml:table>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">"Gathering System Losses" shown here are a combination of system losses and measurement error. Quantities of each of these system losses and measurement errors cannot be determined separately.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">
            <xhtml:span style="font-family: arial, helvetica, sans-serif;">"Transmission System Losses" shown here are a combination of system losses and measurement error. Quantities of each of these system losses and measurement errors cannot be determined separately.</xhtml:span>
          </xhtml:span>
        </xhtml:p>
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">"Other Losses/(Gains)" represent measurement adjustments (related to transmission, storage and gathering losses/(gains)) made to the 12/1/25 through 5/31/26 flow period for the year (6,199 dth loss [column c]). For the quarter, there </xhtml:span>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">were measurement adjustments (10,339 dth gain) made to the 3/1/26 through 5/31/26 flow period for the quarter (column d).</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value13" xlink:to="footnote13" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="13" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote14" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the months of April, May and June, transmission volumes also includes gas coming on to the transmission system from gathering since there is no separate shrinkage retained on gathering volumes.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value14" xlink:to="footnote14" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="14" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote15" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the months of April, May and June, gas used in transmission compressors is allocated between the rate types (columns b, c and d) based on the percentage of gas transported for transmission per line 4 on page 521.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value15" xlink:to="footnote15" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="15" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote16" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the months of April, May and June, gas used in storage compressors is allocated between rate types (columns b, c and d) based on the percentage of gas transported for storage per line 6 on page 521.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value16" xlink:to="footnote16" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="16" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote17" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the months of April, May and June, total gas used for other deliveries and gas used for other operations is allocated between rate types (column b, c, and d) based on the percentage of gas transported for each contract type per lines 2-6 on page 521. These amounts are due to measurement adjustments.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value17" xlink:to="footnote17" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="17" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote18" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the months of April, May and June, gathering losses are allocated between the rate types (columns b, c and d) based on percentage of gas transported for transmission per line 4 on page 521.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value18" xlink:to="footnote18" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="18" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote19" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the months of April, May and June, transmission losses are allocated between the rate types (column b, c and d) based on the percentage of gas transported for transmission per line 4 on page 521.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value19" xlink:to="footnote19" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="19" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote20" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the months of April, May and June, storage losses are allocated between the rate types (column b, c and d) based on the percentage of gas transported for storage per line 6 on page 521.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value20" xlink:to="footnote20" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="20" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote21" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the months of April, May and June, other losses (gains) represent measurement adjustments (related to transmission, storage and gathering losses (gains)) made to the 3/1/26 through 5/31/26 flow period subsequent to 5/31/26, and as a result, are allocated between the rate types (column b, c and d) based on the percentage of total shipper supplied gas transported per line 7 on page 521.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value21" xlink:to="footnote21" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="21" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote22" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">For the months of April, May and June, excess gas retained for each month is valued at 100% of the monthly cashout index rate for the respective month for columns f, g, h and i.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value22" xlink:to="footnote22" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="22" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote23" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">In February 2026, Supply Corporation transferred 6,283,000 Dth of base gas deemed non-recoverable from account 117.1 - Gas Stored-Base Gas to account 352.3 - Non-Recoverable Natural Gas, a component of Utility Plant on the balance sheet. The book value of this transaction was $5,449,246.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value23" xlink:to="footnote23" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="23" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote24" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">In February 2026, Supply Corporation transferred 6,283,000 Dth of base gas deemed non-recoverable from account 117.1 - Gas Stored-Base Gas to account 352.3 - Non-Recoverable Natural Gas, a component of Utility Plant on the balance sheet. The book value of this transaction was $5,449,246.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value24" xlink:to="footnote24" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="24" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote25" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Supply Corporation uses the fixed asset model provisions of FERC Order 581 in accounting for its storage gas recorded in Account 117.4.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value25" xlink:to="footnote25" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="25" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote26" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Amount represents the cumulative FAS158 adjustment to record the actuarial determined Pension Benefit Obligation (PBO) adjustment for Supply's portion of National Fuel Gas Company's Executive Retirement Plan and Tophat Plan, which are non-qualified plans.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value26" xlink:to="footnote26" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="26" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote27" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Amount represents the cumulative FAS158 adjustment to record the actuarial determined Pension Benefit Obligation (PBO) adjustment for Supply's portion of National Fuel Gas Company's Executive Retirement Plan and Tophat Plan, which are non-qualified plans.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value27" xlink:to="footnote27" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="27" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote28" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">AI93-5-000 provided the authorization for this deferral.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value28" xlink:to="footnote28" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="28" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote29" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">18 CFR Section 154.402 provided the authorization for this deferral.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value29" xlink:to="footnote29" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="29" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote30" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">RS92-21-004, 006, 007, 008 &amp; 009 provided the authorization for this deferral.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value30" xlink:to="footnote30" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="30" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote32" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">AI07-1-000 provided the authorization for this deferral.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value32" xlink:to="footnote32" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="32" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote33" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">The Stipulation and Agreement filed on May 22, 2012 under Docket No. RP12-88-000 and subsequently approved by the Commission on August 6, 2012 provided authorization for this deferral. Activity for the year includes any over-collection or under-collection of retained quantities as well as an adjustment to revalue the liability at the June 30, 2026 100% cashout index rate.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value33" xlink:to="footnote33" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="33" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote34" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Supply Corporation reclassifies regulatory assets in Account 182.3 that have credit balances to regulatory liabilities in Account 254.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value34" xlink:to="footnote34" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="34" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote35" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">AI93-5-000 provides the regulatory authority for this deferral and was reaffirmed by Docket No. PL19-2-000.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value35" xlink:to="footnote35" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="35" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote37" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">RM95-4-000 provided the authorization for this deferral.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value37" xlink:to="footnote37" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="37" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote38" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Supply Corporation reclassifies regulatory assets in Account 182.3 that have credit balances to regulatory liabilities in Account 254.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value38" xlink:to="footnote38" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="38" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote39" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">In February 2025, Supply Corporation recorded a base gas sale of 126,957dth at a gain of $322,437. Supply Corporation received $412,610 in proceeds from this sale. This sale was authorized by FERC in Docket No. CP22-482-000.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value39" xlink:to="footnote39" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="39" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote40" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Supply Corporation redeemed $125,000,000 of 5.358% notes and $150,000,000 of 5.779% notes with the proceeds received from Associated Companies in March 2025. The 5.358% and 5.779% notes were redeemed for $125,271,363 and $151,405,826, respectively, plus accrued interest. The call premiums were recorded in Account 189, Unamortized Loss on Reacquired Debt, in March 2025.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value40" xlink:to="footnote40" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="40" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote41" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">On March 6, 2025, Supply Corporation borrowed $25,000,000 from the Company at an interest rate of 5.708%. The note matures on March 15, 2030. On the same date, Supply Corporation also borrowed $275,000,000 from the Company at an interest rate of 6.119%. This note matures on March 15, 2035.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value41" xlink:to="footnote41" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="41" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote42" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">On June 10, 2026, Supply Corporation borrowed </xhtml:span>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">$100,000,000 from the Company at an interest rate of 5.292%. This note matures on October 15, 2031. </xhtml:span>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">On the same date, Supply Corporation also borrowed </xhtml:span>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">$75,000,000 from the Company at an interest rate of 5.723%. The note matures on May 15, 2036.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value42" xlink:to="footnote42" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="42" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote46" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">On June 11, 2026, Supply Corporation redeemed a 5.801% note in the amount of $50,000,000 that was originally scheduled to mature on October 1, 2026 and had been reclassified to Account 233 at December 31, 2025 in recognition of the current status of the loan. The 5.801% note was redeemed for $50,246,630, plus accrued interest. The call premium was recorded to Account 189, Unamortized Loss on Reacquired Debt, in June 2026.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value46" xlink:to="footnote46" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="46" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote47" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">On June 10, 2026, Supply Corporation borrowed $100,000,000 from the Company at an interest rate of 5.292%. This note matures on October 15, 2031. On the same date, Supply Corporation also borrowed $75,000,000 from the Company at an interest rate of 5.723%. The note matures on May 15, 2036.</xhtml:span>
        </xhtml:p>
        <xhtml:p>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value47" xlink:to="footnote47" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="47" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote48" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">Supply Corporation redeemed $50,000,000 of 5.801% notes with the proceeds received from Associated Companies in June 2026. The notes were redeemed for $50,246,630, plus accrued interest. The call premiums were recorded in Account 189, Unamortized Loss on Reacquired Debt, in June 2026.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value48" xlink:to="footnote48" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="48" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote49" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">RM02-7-000 provides the authorization for this deferral.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value49" xlink:to="footnote49" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="49" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote50" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p>
          <xhtml:span style="font-family: arial, helvetica, sans-serif;">RM02-7-000 provides the authorization for this deferral.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value50" xlink:to="footnote50" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="50" />
  </link:footnoteLink>
</xbrli:xbrl>
