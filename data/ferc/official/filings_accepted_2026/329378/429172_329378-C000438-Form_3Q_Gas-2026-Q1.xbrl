							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
						&lt;td style="width:95.5pt; border-right-style:solid; border-right-width:1pt; border-bottom-style:solid; border-bottom-width:1pt; padding-right:5.4pt; padding-left:5.4pt; vertical-align:top"&gt;&#xD;
							&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
								&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;$0.3503&lt;/span&gt;&#xD;
							&lt;/p&gt;&#xD;
						&lt;/td&gt;&#xD;
					&lt;/tr&gt;&#xD;
				&lt;/table&gt;&#xD;
			&lt;/div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Based on long-term firm contracts in place on September 1, 2022, the settlement resulted in incremental reductions in revenues of $2.8 million in 2024 and $1.8 million in 2025. &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:8pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:DisclosureOfEstimatedIncreaseOrDecreaseInAnnualRevenuesCausedByImportantRateChangesTextBlock>
