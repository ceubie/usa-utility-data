    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH2556C001C8AC2E8401F0B20424A18C43" xlink:to="HH727C71B8065FE7983A3D6E72802B265A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHAF33AEEDAD9E15BAF78C69B29101F714" xlink:label="HHAF33AEEDAD9E15BAF78C69B29101F714" />
    <link:footnote xlink:type="resource" xlink:label="HH4B5A77EC04B35ADB1F24F6E28A4B6C0A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
