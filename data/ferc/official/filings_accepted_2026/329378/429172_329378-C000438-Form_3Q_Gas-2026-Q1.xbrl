  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C000438</ferc:CompanyIdentifier>
  <ferc:DisclosureOfInterimDisclosureTextBlock id="HHBD3FB81A19097E05744DB228EFAAF64C" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfInterimDisclosureTextBlock>
  <ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock id="HHC9E9219375AC2F82A8CDFAF00D88FECC" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Effective January 15, &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;2026&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt; Michelle Wieler, Senior Director, Financial Services and Chief Financial Officer retired from Iroquois Pipeline Operating Company, agent of IGTS.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Effective January 16, &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;2026&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt; Christopher Lown was appointed Director, Financial Services and Corporate Controller of Iroquois Pipeline Operating Company, agent of IGTS.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:DisclosureOfChangesInOfficersDirectorsMajorSecurityHoldersAndVotingPowersOfTheRespondentTextBlock>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;table style="border-collapse: collapse;" cellspacing="0" cellpadding="0"&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="width: 468pt; border-bottom-style: solid; border-bottom-width: 1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 14pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-variant: small-caps; letter-spacing: -0.6pt;"&gt;Note 1&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; line-height: 150%; font-size: 3pt;"&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.6pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 14pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic; font-variant: small-caps;"&gt;Description of Partnership:&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 5pt;"&gt;&lt;span style="font-family: 'Times New Roman'; letter-spacing: -0.6pt;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-right: 9.35pt; margin-bottom: 12pt; line-height: 150%; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Iroquois Gas Transmission System, L.P. (the Partnership or Iroquois) is a Delaware limited partnership that owns and operates a natural gas transmission pipeline that extends from the Canada-United States border near Waddington, New York through the states of New York (NY) and Connecticut to South Commack, NY on Long Island and Hunts Point, NY in the Bronx.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;In accordance with the limited partnership agreement, the Partnership shall continue in existence until &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;October 31, 2089&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, and from year to year thereafter, until the partners elect to dissolve the Partnership and terminate the&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; limited partnership agreement.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-right: 9.35pt; margin-bottom: 12pt; line-height: 150%; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;As of &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;March 31, 2026&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;the partners consist of TCP&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;(TC&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; Energy) &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;(49.34%), Iroquois GP Holding Company, LLC &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;(BHE)&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; (25.93%), Iroquois, Inc. (&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;BHE&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;) (24.07%), and TransCanada Iroquois Ltd. (&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;TC Energy&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;) (0.66%). &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The ultimate parent company for TransCanada Iroquois Ltd. and &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;TC &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;PipeLines&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; LP&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; is TC Energy Corporation (TC Energy).&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Iroquois GP Holding Company, LLC and Iroquois, Inc are ultimately owned by subsidiaries of BHE GT&amp;amp;S, LLC, a &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Berkshire Hathaway Energ&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;y&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; company (BHE).&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Iroquois Pipeline Operating Company, a wholly owned subsidiary, is the administrative operator of the pipeline.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;IGTS, Inc. of Connecticut is an additional wholly owned subsidiary formed to hold title to certain Connecticut property interests.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; line-height: 150%; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;Income and expenses are allocated to the partners and credited to their respective equity accounts in accordance with the partnership agreements and their respective percentage interests. Distributions to partners are made concurrently to all partners in proportion to their respective partnership interests. &lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; -aw-import: spaces;"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Partnership made cash distributions to the partners &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;of $&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;18&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;3&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; million &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;and $&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;29.1&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; million&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; during &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;the first three months of &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;20&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;26&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; and 20&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;25&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;, respectively.&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 7pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; line-height: 150%; font-size: 14pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic; font-variant: small-caps;"&gt;Subsequent Events:&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic; font-variant: small-caps;"&gt; &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-right: 9.35pt; margin-bottom: 0pt; line-height: 150%; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;The Partnership has evaluated all subsequent events &lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;through June&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; 1, 2026&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt;,&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; which&lt;/span&gt;&lt;span style="font-family: 'Times New Roman';"&gt; represents the date the financial statements were available to be issued. &lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 0pt; margin-right: 9.35pt; margin-bottom: 0pt; line-height: 150%; font-size: 5pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;table style="border-collapse: collapse;" cellspacing="0" cellpadding="0"&gt;
&lt;tbody&gt;
&lt;tr&gt;
&lt;td style="width: 468pt; border-bottom-style: solid; border-bottom-width: 1pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 14pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-variant: small-caps; letter-spacing: -0.6pt;"&gt;Note&lt;/span&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-variant: small-caps; letter-spacing: -0.6pt;"&gt; 2&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;/tbody&gt;
&lt;/table&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 3pt;"&gt;&lt;span style="font-family: 'Times New Roman'; font-weight: bold; font-style: italic; font-variant: small-caps;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
