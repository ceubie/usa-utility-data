		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
