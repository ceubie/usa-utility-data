  <ferc:DocumentDate id="Tag4375" contextRef="C482">2023-12-31</ferc:DocumentDate>
  <ferc:DescriptionOfFiling id="Tag4376" contextRef="C482">No revisions were made during 2023.</ferc:DescriptionOfFiling>
