  <ferc:DocumentDate id="Tag4372" contextRef="C481">2022-12-31</ferc:DocumentDate>
  <ferc:DescriptionOfFiling id="Tag4373" contextRef="C481">No revisions were made during 2022.</ferc:DescriptionOfFiling>
