&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: right; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
