&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 22.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 21.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 33.45pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: bottom;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 12pt;"&gt;&lt;span style="font-family: 'Times New Roman';"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
