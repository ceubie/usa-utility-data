&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: center; font-size: 10pt;"&gt;&lt;span style="font-family: Arial; -aw-import: spaces;"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-family: Arial;"&gt;3,853,775&lt;/span&gt;&lt;/p&gt;
