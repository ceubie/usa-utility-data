  <ferc:FormType id="HHF7EC89F6B6814CD2CC1C6928B801FC93" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">60</ferc:FormType>
  <ferc:CompanyIdentifier id="HHF0B6C5A33D1162349A8B0E1DF4C7C02D" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">C011466</ferc:CompanyIdentifier>
  <ferc:ReportYear id="HH660FC444EE17A785BFF22BCDC6434313" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4" decimals="0" unitRef="HHferc_us_Pure">2025</ferc:ReportYear>
  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q4</ferc:ReportPeriod>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2025-12-31</ferc:ReportDate>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:NotesToFinancialStatementsTextBlock>
  <ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock id="HH26F298D96F05ADD051F0C74B218AC0A3" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfImportantDisclosuresRegardingTheFinancialStatementsTextBlock>
  <ferc:DisclosureOfSignificantContingentAssetsOrLiabilitiesTextBlock id="HHBF53398AA5137162F0C0A6B245F0BF61" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfSignificantContingentAssetsOrLiabilitiesTextBlock>
  <ferc:DisclosureOfSignificantIncreasesInServicesRenderedOrExpensesIncurredTextBlock id="HH7FCC34467929435B84A07016BEF0A1B8" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfSignificantIncreasesInServicesRenderedOrExpensesIncurredTextBlock>
  <ferc:DisclosureOfExtraordinaryIncomeOrExtraordinaryDeductionAmountsTextBlock id="HHE4CEA624F811CC9AADD2BDF89F8D6E56" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfExtraordinaryIncomeOrExtraordinaryDeductionAmountsTextBlock>
  <ferc:DisclosureOfReferencesToFinancialStatementNotesTextBlock id="HHBB3BC4E20287A67645AF2AEB0A930AD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;1.&lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt; &lt;/span&gt;&lt;span style="font-family:Arial; font-weight:bold"&gt;SUMMARY OF SIGNIFICANT ACCOUNTING POLICIES: &lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Organization and System of Accounts&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;FirstEnergy Service Company (FESC) is a wholly owned subsidiary of FirstEnergy Corp. (FE), a public utility holding company as defined in the Federal Energy Regulatory Commission&amp;#x2019;s (FERC) Order No. 667. FESC was authorized to conduct business as a service company for FirstEnergy and its various subsidiaries by order of the Securities and Exchange Commission (SEC) dated June 30, 2003. FESC provides certain administrative, management, and support services to affiliated companies in the FirstEnergy system.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;The Form 60 is prepared in accordance with the Uniform System of Accounts (&lt;/span&gt;&lt;span style="font-family:Arial"&gt;USofA&lt;/span&gt;&lt;span style="font-family:Arial"&gt;) for Centralized Service &lt;/span&gt;&lt;span style="font-family:Arial"&gt;Companies&lt;/span&gt;&lt;span style="font-family:Arial"&gt; subject to the provisions of the Public Utility Holding Company Act of 2005 (PUHCA 2005) as prescribed by the FERC in 18 CFR Part 367.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;FESC has no earnings since it renders services at cost to its parent company, FE, and other affiliates.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Use of Estimates&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;The preparation of these financial statements require management to make periodic estimates and assumptions that affect the reported amounts of assets, liabilities, revenues and expenses and the disclosure of contingent assets and liabilities. Actual results could differ from these estimates.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Operating Revenues and Expenses&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;Services rendered to affiliated companies are provided at cost. The cost of services is determined on a direct charge basis to the extent practicable and where not practicable, on a reasonable basis of allocation for indirect costs.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Property, Equipment and Depreciation&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;Property and equipment are recorded at cost. Depreciation is provided on a straight-line basis at various rates over the estimated lives of various classes of property. The average depreciation &lt;/span&gt;&lt;span style="font-family:Arial"&gt;rate was &lt;/span&gt;&lt;span style="font-family:Arial"&gt;7.4&lt;/span&gt;&lt;span style="font-family:Arial"&gt;% and &lt;/span&gt;&lt;span style="font-family:Arial"&gt;7&lt;/span&gt;&lt;span style="font-family:Arial"&gt;.3&lt;/span&gt;&lt;span style="font-family:Arial"&gt;% in &lt;/span&gt;&lt;span style="font-family:Arial"&gt;202&lt;/span&gt;&lt;span style="font-family:Arial"&gt;5&lt;/span&gt;&lt;span style="font-family:Arial"&gt; and&lt;/span&gt;&lt;span style="font-family:Arial"&gt; 202&lt;/span&gt;&lt;span style="font-family:Arial"&gt;4&lt;/span&gt;&lt;span style="font-family:Arial"&gt;,&lt;/span&gt;&lt;span style="font-family:Arial"&gt; respectively.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Income Taxes&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;FESC records income taxes in accordance with the liability method of accounting. Deferred income taxes reflect the net tax effect of temporary differences between the carrying amounts of assets and liabilities for financial reporting purposes and the amounts recognized for tax purposes. Deferred income tax liabilities related to temporary tax and accounting basis differences are recognized at the statutory income tax rates in effect when the liabilities are expected to be paid. Deferred tax assets are recognized based on income tax rates expected to be in effect when they are settled.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial; font-weight:bold"&gt;Operating and Finance Lease Commitments&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;Finance and operating leases are recorded on a net basis in Property Under Capital Leases on the FERC balance sheet.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:justify; font-size:9pt"&gt;&#xD;
				&lt;span style="font-family:Arial"&gt;FESC adopted ASU 2016-02, "Leases (Topic 842)" on January 1, 2019. Adoption of the accounting guidance had no impact on FESC&amp;#x2019;s existing ratemaking treatment or FERC jurisdiction cost-of-service rates. Amounts included in the capital lease balance sheet accounts that relate to operating leases are as follows:&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;table cellspacing="0" cellpadding="0" style="width:99.86%; border-collapse:collapse"&gt;&#xD;
				&lt;tr&gt;&#xD;
					&lt;td style="width:1%; padding:1pt; vertical-align:middle"&gt;&#xD;
						&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
							&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
						&lt;/p&gt;&#xD;
					&lt;/td&gt;&#xD;
					&lt;td style="width:50.02%; padding:1pt; vertical-align:middle"&gt;&#xD;
						&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
							&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
						&lt;/p&gt;&#xD;
					&lt;/td&gt;&#xD;
					&lt;td style="width:0.1%; padding:1pt; vertical-align:middle"&gt;&#xD;
						&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
							&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
						&lt;/p&gt;&#xD;
					&lt;/td&gt;&#xD;
					&lt;td style="width:0.1%; padding:1pt; vertical-align:middle"&gt;&#xD;
						&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
