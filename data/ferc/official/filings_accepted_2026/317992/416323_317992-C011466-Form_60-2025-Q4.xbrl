					&lt;td style="border-top-style:solid; border-top-width:1pt; border-bottom-style:solid; border-bottom-width:1pt; padding:1.5pt 1.25pt 1.5pt 0.25pt; vertical-align:bottom"&gt;&#xD;
						&lt;p style="margin-top:0pt; margin-bottom:0pt; text-align:right; font-size:12pt"&gt;&#xD;
