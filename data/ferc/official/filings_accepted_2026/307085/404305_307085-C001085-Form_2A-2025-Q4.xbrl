&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; widows: 0; orphans: 0; font-size: 11pt;"&gt;&lt;font style="font-family: Garamond; -aw-import: ignore;"&gt; &amp;#160;&lt;/font&gt;&lt;/p&gt;
&lt;table style="width: 596.25pt; border-collapse: collapse;" cellspacing="0" cellpadding="0"&gt;

&lt;tr style="height: 15pt;"&gt;
&lt;td style="width: 17pt; vertical-align: middle;"&gt;
