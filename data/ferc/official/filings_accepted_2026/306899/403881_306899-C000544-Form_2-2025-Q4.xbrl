        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3020_lbl" order="0" xlink:to="ft-3020_47210_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3021_lbl" order="0" xlink:to="ft-3021_47211_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3029_lbl" order="0" xlink:to="ft-3029_47212_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3435_lbl" order="0" xlink:to="ft-3435_47335_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3465_lbl" order="0" xlink:to="ft-3465_47349_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3533_lbl" order="0" xlink:to="ft-3533_47350_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3564_lbl" order="0" xlink:to="ft-3564_47351_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3623_lbl" order="0" xlink:to="ft-3623_47364_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-3689_lbl" order="0" xlink:to="ft-3689_47425_lbl" />
        <link:footnote xlink:label="ft-87_46914_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 278 Line No.: 2 Column: a</b></span></span></p><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">As authorized by the Commission, EGT collects from its shippers costs incurred for electric power costs associated with compressor stations on its system. The collection is via an Electric Power Cost ("EPC") surcharge billed to customers. The provisions of the EPC tracker contain a true-up provision such that any over/under collections are returned to or collected from shippers through prospective semi-annual adjustments to the EPC rates. A regulatory asset or regulatory liability is established for the difference between the actual EPC incurred and the amount collected via the EPC surcharge.</span></span></p><p style="margin: 0 0 8pt; line-height: 115%; font-size: 12pt"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Pursuant to Sections 27 and 28 of the General Terms and Conditions of EGT's FERC Gas Tariff, Tenth Revised Volume No. 1, Docket No. RP24-1101-000, as approved by FERCs order issued of October 17, 2024, Docket No. RP25-761- 000, as approved by FERC's order issued on April 17, 2025, and Docket No. RP25-1187-000, as approved by FERC's order issued on October 16, 2025.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-272_46912_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource">Original value: N</link:footnote>
        <link:footnote xlink:label="ft-274_46915_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 232 Line No.: 1 Column: a</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">As authorized by the Commission, EGT has a fuel tracker mechanism whereby it recovers gas used and lost on its system via in-kind receipts of volumes from its shippers. The fuel tracker mechanism for EGT has a true-up provision that any over/under recoveries of volumes are returned to or collected from shippers through prospective semi-annual adjustment to fuel tracker retention rates. A regulatory asset or regulatory liability is established for the volumes collected and the volumes actually used/lost on the system. The over/under recovered volumes are valued at market prices in effect at the time the net over/under recoveries were recognized in the regulatory asset or regulatory liability accounts.</span></span> <br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-405_47113_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 220 Line No.: 1 Column: i</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Non-current inventory represents the cost of the recoverable quantity of gas necessary to maintain pressure and deliverability for each storage facility. Current inventory represents the value of company-owned gas which is in excess of the quantity classified as non-current. The inventory method is used to report storage.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-407_47164_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 350 Line No.: 1 Column: e</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Account 186, Miscellaneous deferred debits, was used to record deferred charges for regulatory commission expense. This footnote applies to columns (e), (i) and (l), lines 1 and 2. </span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-530_46982_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 114 Line No.: 16 Column: c</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Credit balance due to overpaid taxes in the prior year. </span></span> </p></div></link:footnote>
        <link:footnote xlink:label="ft-666_46990_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 230a Line No.: 5 Column: b</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Prepaid demand fees.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1117_47162_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 262 Line No.: 20 Column: i</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Reversals of prior year accruals.</span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">This footnote also applies to line 22.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1231_47114_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><b style="font-weight: bold">Schedule Page: 232 Line No.: 2 Column: a</b></span></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit">As authorized by the Commission, EGT collects from its shippers costs incurred for electric power costs associated with compressor stations on its system. The collection is via an Electric Power Cost ("EPC") surcharge billed to customers. The provisions of the EPC tracker contain a true-up provision such that any over/under collections are returned to or collected from shippers through prospective semi-annual adjustments to the EPC rates. A regulatory asset or regulatory liability is established for the difference between the actual EPC incurred and the amount collected via the EPC surcharge.</span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1524_47139_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 520 Line No.: 5 Column: d</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Includes quantities processed by others to attain pipeline quality specifications. This footnote also applies to column (c).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1525_47138_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-style: normal; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)">Schedule Page: 520 Line No.: 3 Column: d</b></span></span></p><p><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-family: Roboto"><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1410px; min-height: 0" alt="" /></b></p><p style="text-align: left"><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="color: rgba(0, 0, 0, 1); font-family: Arial, Helvetica, sans-serif; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); font-size: 12pt">This footnote also applies to column (c).</span><br /></b></p></div></link:footnote>
        <link:footnote xlink:label="ft-1532_47141_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 520 Line No.: 20 Column: c</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">For the purpose of the Annual Charge Adjustment ("ACA") calculation, the throughput volume is 731,919,543 Dth as represented on line 20. No additional volumes are needed to calculate total volumes eligible for the ACA surcharge.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1551_47142_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 520 Line No.: 27 Column: d</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Represents gas delivered to storage to support system management activity. This footnote also applies to column (c).</span></span> </p></div></link:footnote>
        <link:footnote xlink:label="ft-1555_47140_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 520 Line No.: 12 Column: d</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Represents gas withdrawn from storage to support system management activity. This footnote also applies to column (c).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1561_47143_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 520 Line No.: 29.1 Column: d</b></span></span></p><p><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-family: Roboto"><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1410px; min-height: 0" alt="" /> </b></p></div></link:footnote>
        <link:footnote xlink:label="ft-1828_47155_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 521 Line No.: 7 Column: f</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">The basis for valuing the gas reported in columns (f), (g) and (h) is the weighted average rate for system gas.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-1909_47156_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 521 Line No.: 22 Column: i</b></span></span></p><p style="margin: 0 0 10px"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Gas used for other operational purposes includes fuel and shrinkage of gas processed by others, blow-downs and other operational uses of gas other than compressor station fuel, and in-kind volumes of gas delivered to other pipelines in accordance with applicable transportation contracts.</span></span><br style="color: rgba(0, 0, 0, 1); font-family: Roboto" /></p></div></link:footnote>
        <link:footnote xlink:label="ft-2037_47157_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 521 Line No.: 55.1 Column: i</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Cumulative volumes of in-kind gas owed to or due from shippers are valued at market price in the month over/under collection occurs.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2592_47203_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 328 Line No.: 1 Column: a</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">EGT does not report imbalances by rate schedule because imbalances are calculated at the contract level and not rate schedule level.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-2618_47204_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1410px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-2629_47205_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1410px; min-height: 0" alt="" /> </p></link:footnote>
        <link:footnote xlink:label="ft-3020_47210_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 336 Line No.: 5 Column: b</b></span></span></p><p style="margin: 0 0 10px"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Underground Gas Storage Plant is depreciated on a composite allocation basis per assigned FERC rates. This footnote also applies to line 5, column (e).</span></span><br style="color: rgba(0, 0, 0, 1); font-family: Roboto" /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3021_47211_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 219 Line No.: 10 Column: b</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">General Plant is depreciated on a straight line basis per assigned FERC rates.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3029_47212_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 338 Line No.: 4 Column: b</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">The depreciation plant basis reflects a balance as of 12/31/2025. This footnote also applies to lines 7, 8 and 9, column (b).</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3435_47335_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 218 Line No.: 5 Column: f</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">The reported rate is a calculated black-box settlement rate from EGT's last rate case proceeding Docket No. RP94-343-000.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3465_47349_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><b style="font-weight: bold"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 358 Line No.: 2 Column: a</span></span></b><br /></p><p> <img src="data:image/gif;base64," class="e-rte-image e-imginline" width="817" height="413" style="min-width: 0; max-width: 1580px; min-height: 0" alt="" /></p><p><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3533_47350_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 358 Line No.: 20 Column: b</b></span></span></p><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="867" height="221" style="min-width: 0; max-width: 1580px; min-height: 0" alt="" /> <br /></p><p> <br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3564_47351_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b>Schedule Page: 358 Line No.: 25 Column: b</b></span></span></p><p><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="868" height="345" style="min-width: 0; max-width: 1395px; min-height: 0" alt="" /></p><p><br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-3623_47364_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 262 Line No.: 20 Column: i</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Prior year estimated tax refunds.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-3689_47425_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><b style="font-weight: bold">Schedule Page: 518 Line No.: 20 Column: a</b></span></span></p><p style="margin: 0; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">Date range: 1/17/2026-1/19/2026</span></span></p></div></link:footnote>
    </link:footnoteLink>
</xbrl>