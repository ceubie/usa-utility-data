			&lt;/ol&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:54pt; margin-bottom:0pt; text-indent:-36pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:Tahoma"&gt;5.&lt;/span&gt;&lt;span style="width:25.82pt; text-indent:0pt; display:inline-block; -aw-tabstop-align:left; -aw-tabstop-pos:54pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:Tahoma"&gt;N/A&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-left:36pt; margin-bottom:0pt; text-indent:-36pt; font-size:12pt"&gt;&#xD;
