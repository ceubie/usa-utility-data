  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;The Company&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Seminole Pipeline Company LLC (&amp;#x201C;Seminole&amp;#x201D; or the &amp;#x201C;Company&amp;#x201D;) is a Delaware limited liability company and a wholly owned subsidiary of Enterprise Products Operating LLC (&amp;#x201C;EPOLLC&amp;#x201D;), a Texas limited liability company. &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;EPOLLC in turn is wholly&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;owned by Enterprise Products Partners L.P., &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;a Delaware limited partnership, which is &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;a publicly traded partnership&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;EPOLLC is the operator of Seminole.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Description of Property&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Seminole is a natural gas liquids &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;(&amp;#x201C;NGL&amp;#x201D;) &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;pipeline system, consisting primarily of two 14-inch pipelines that extend from the Hobbs hub and the Permian Basin area of west Texas to markets in southeastern Texas. Total system mileage is approximately 1,200 miles.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Starting in January 2026, Seminole leased certain capacity to its affiliate, Enterprise Crude Pipeline LLC, for crude oil transportation service.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Basis of Accounting&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;The accounting policies followed in preparation of these financial statements conform to those required by FERC. Financial statements are prepared on the accrual basis of accounting.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; Property, plant and equipment assets are recorded at original cost.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Revenue Recognition&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Revenues are primarily derived from transportation of NGLs under intrastate and interstate tariffs. The tariffs specify the amounts to be paid by shippers for service between receipt and &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;delivery locations and the general terms and conditions of transportation services on the pipeline system. Revenues are recognized upon delivery of product&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;s&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; to its shippers.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Income Taxes&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Seminole is a limited liability company that passes income tax liability through the Company to &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;EPOLLC&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt; and, with the exception of the Texas Franchise Tax, &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;if applicable, &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;does not recognize this liability on the Company's financial statements. For purposes of calculating income taxes for the annual cost of service (shown on page 700 of the Annual Report), Seminole employs FERC's Policy Statement on Income Tax Allowances.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; font-weight:bold"&gt;Employees&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;Seminole has no employees of its own. &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;All operations, management, and administrative functions are performed by employees of Enterprise Products Company on behalf of &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;EPOLLC, the operator&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;.&lt;/span&gt;&lt;span style="font-family:'Times New Roman'; -aw-import:spaces"&gt;&amp;#160; &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;Seminole reimburses EPOLLC for management and administrative functions under the terms of an &lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;operating agreement&lt;/span&gt;&lt;span style="font-family:'Times New Roman'"&gt;.&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:8pt"&gt;&#xD;
				&lt;span style="font-family:Arial; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'; "&gt;&amp;#160;&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
		&lt;/div&gt;&#xD;
	&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
  <ferc:DisclosureOfEventsThatHaveAMaterialEffectToRespondentsTextBlock id="HH11476EB422E065C84DE3B12A8533C405" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfEventsThatHaveAMaterialEffectToRespondentsTextBlock>
