  <ferc:DisclosureOfReferencesToFinancialStatementNotesTextBlock id="f-15" contextRef="c-1">&lt;div style="margin-top:6pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt;Organization Chart&lt;/span&gt;&lt;/div&gt;&lt;div style="margin-top:6pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;Chairman, President, &amp;amp; CEO&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;EVP - Chief Nuclear Officer&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-indent:9pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;VP - Nuclear Plant Site - Vogtle 1&amp;amp;2&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-indent:9pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;VP - Nuclear Plant Site - Vogtle 3&amp;amp;4&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-indent:9pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;VP - Nuclear Plant Site &#8211; Farley&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-indent:9pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;VP - Nuclear Plant Site &#8211; Hatch&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;SVP - Technical Services &amp;amp; External Affairs&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-indent:9pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;VP - Regulatory Affairs&lt;/span&gt;&lt;/div&gt;&lt;div style="padding-left:36pt;text-indent:9pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;VP- Operations Support&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;VP, General Counsel &amp;amp; Compliance Officer&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;VP - Human Resource&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;Treasurer&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;Comptroller&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;Secretary&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:18pt"&gt;&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:11pt;font-weight:400;line-height:115%"&gt;Assistant Secretary&lt;/span&gt;&lt;/div&gt;</ferc:DisclosureOfReferencesToFinancialStatementNotesTextBlock>
