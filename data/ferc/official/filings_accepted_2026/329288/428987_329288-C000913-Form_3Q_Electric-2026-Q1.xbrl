  <ferc:DisclosureOfAcquisitionOfOwnershipInOtherCompaniesByReorganizationMergerOrConsolidationWithOtherCompaniesTextBlock id="HH9BC0EFBCB25FD35BD21CC5095A000F66" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
