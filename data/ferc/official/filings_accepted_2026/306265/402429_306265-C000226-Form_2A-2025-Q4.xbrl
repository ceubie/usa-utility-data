    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote24" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">Volumes are on a flow month basis. </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value24" xlink:to="footnote24" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="24" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote25" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level rather than by discounted, negotiated, or recourse rate contracts; therefore, the reported amounts have been allocated to discounted, negotiated, or recourse rate contracts based on reasonable assumptions. </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value25" xlink:to="footnote25" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="25" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote26" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <!--?xml version="1.0" encoding="utf-8" standalone="no"?-->
        <xhtml:div style="font-family: Calibri; font-size: 11pt;">
          <xhtml:div class="Section_1">
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt;">
              <xhtml:span style="-aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt;">
              <xhtml:span style="-aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial;">The value of this gas is based on the Average Monthly Index Price provided for in our tariff. This footnote applies to all periods within the quarter. </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="-aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
            <xhtml:p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 18pt;">
              <xhtml:span style="font-family: Arial; -aw-import: ignore;">
              </xhtml:span>
            </xhtml:p>
          </xhtml:div>
        </xhtml:div>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value26" xlink:to="footnote26" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="26" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote43" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal" style="margin-bottom: 0in; line-height: normal; mso-layout-grid-align: none; text-autospace: none;">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">We are operated by Natural Gas Pipeline Company of America LLC (NGPL). General and administrative services are provided by NGPL and charged to Horizon pursuant to an Administrative Services Agreement.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value43" xlink:to="footnote43" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="43" />
