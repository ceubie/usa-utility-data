  <ferc:ReportYear id="HH660FC444EE17A785BFF22BCDC6434313" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4" decimals="0" unitRef="HHferc_us_Pure">2026</ferc:ReportYear>
  <ferc:ReportDate id="HH8FD963CECD5B15C379755C94FECA9889" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">2026-06-08</ferc:ReportDate>
  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p&gt;1) None&lt;/p&gt;
&lt;p&gt;2) None&lt;/p&gt;
&lt;p&gt;3) None&lt;/p&gt;
&lt;p&gt;4) The Company is involved in various litigation arising from the normal operations of its pipeline business. The Company, based on the advice of counsel, believes that any adverse findings with respect to such legal actions will not result in a material effect on the financial position of the Company.&lt;/p&gt;
&lt;p&gt;5) Not Applicable&lt;/p&gt;
&lt;h6&gt;&amp;#160;&lt;/h6&gt;&lt;/div&gt;</ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock>
