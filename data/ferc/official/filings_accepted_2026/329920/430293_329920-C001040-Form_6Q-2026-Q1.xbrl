  <ferc:ReportPeriod id="HHBD1AFC97EAE2BF213BAE5A53CD7CEAC7" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">Q1</ferc:ReportPeriod>
  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;p style="margin: 0in; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"&gt;&lt;strong&gt;&lt;span style="font-size: 9.5pt; font-family: 'Segoe UI', sans-serif;"&gt;Basis of Accounting&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style="margin-top: 0in; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"&gt;&lt;span style="font-size: 9.5pt; font-family: 'Segoe UI', sans-serif;"&gt;Pioneer Pipe Line Company (Company) is subject to regulation by the Federal Energy Regulatory Commission(FERC). The accounting policies followed in preparation of these financial statements generally conform to those required by FERC.&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin: 0in; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"&gt;&lt;strong&gt;&lt;span style="font-size: 9.5pt; font-family: 'Segoe UI', sans-serif;"&gt;Pipeline Operator&lt;/span&gt;&lt;/strong&gt;&lt;/p&gt;
&lt;p style="margin: 0in; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;"&gt;&lt;span style="font-size: 9.5pt; font-family: 'Segoe UI', sans-serif;"&gt;Respondent has no employees.&lt;/span&gt;&lt;span style="font-size: 12.6px;"&gt; &amp;#160;&lt;/span&gt;&lt;span style="font-family: 'Segoe UI', sans-serif; font-size: 9.5pt;"&gt;Respondent's properties are operated by Phillips 66 Pipeline LLC as agent.&lt;/span&gt;&lt;/p&gt;
&lt;p&gt;&amp;#160;&lt;/p&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
  <ferc:DisclosureOfEventsThatHaveAMaterialEffectToRespondentsTextBlock id="HH11476EB422E065C84DE3B12A8533C405" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4"></ferc:DisclosureOfEventsThatHaveAMaterialEffectToRespondentsTextBlock>
