    <link:loc xlink:type="locator" xlink:label="value32" xlink:href="#Tag936" />
    <link:loc xlink:type="locator" xlink:label="value43" xlink:href="#Tag977" />
    <link:loc xlink:type="locator" xlink:label="value44" xlink:href="#Tag991" />
    <link:loc xlink:type="locator" xlink:label="value45" xlink:href="#Tag998" />
    <link:loc xlink:type="locator" xlink:label="value46" xlink:href="#Tag1010" />
    <link:loc xlink:type="locator" xlink:label="value47" xlink:href="#Tag1015" />
    <link:loc xlink:type="locator" xlink:label="value48" xlink:href="#Tag1020" />
    <link:loc xlink:type="locator" xlink:label="value49" xlink:href="#Tag1026" />
    <link:loc xlink:type="locator" xlink:label="value50" xlink:href="#Tag1030" />
    <link:loc xlink:type="locator" xlink:label="value52" xlink:href="#Tag1160" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote20" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">The volume reported is related to account 803 "Natural Gas Transmission Line Purchases".</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value20" xlink:to="footnote20" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="20" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote21" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Gas withdrawn for operational balancing purposes. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value21" xlink:to="footnote21" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="21" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote22" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNormal">
          <xhtml:span style="font-size: 18.0pt; line-height: 107%; font-family: 'Arial',sans-serif;">Gas injected for operational balancing purposes. </xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value22" xlink:to="footnote22" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="22" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote23" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Many of the natural gas volumes required to be reported on this page are tracked at the entity level rather than by discounted, negotiated or recourse rate contracts; therefore, the amounts reported have been allocated to discounted, negotiated or recourse rate contracts based on reasonable assumptions.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value23" xlink:to="footnote23" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="23" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote24" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">The value of this gas is based on the current month cash-out price and it is not adjusted to reflect a change in pricing subsequent to the month shipper supplied gas is retained. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value24" xlink:to="footnote24" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="24" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote25" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">A non-revenue recognition method for shipper supplied gas is used which results in accounting entries for net fuel over or under collected rather than separate revenue entries for shipper supplied gas and expenses for gas used in compressors. This footnote applies to lines 4 and 6 for all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value25" xlink:to="footnote25" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="25" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote26" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Accounts 819 and 854 are debited for gas used for compressor station fuel. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value26" xlink:to="footnote26" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="26" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote27" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Line 14 Dekatherms do not include electric compressor stations. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value27" xlink:to="footnote27" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="27" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote28" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Gas supplied as operational gas for "Transportation by Others." This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value28" xlink:to="footnote28" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="28" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote29" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Accounts 817, 823, and 825 are recorded for gas used for other operational purposes. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value29" xlink:to="footnote29" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="29" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote30" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">This line includes operation and maintenance fuel and known losses due to blowdowns, emergency shut downs, compressor start-ups, flares, line purges, tube inspections and relief valves. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value30" xlink:to="footnote30" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="30" />
    <link:footnote xlink:type="resource" xml:lang="en-US" xlink:label="footnote31" xlink:role="http://www.xbrl.org/2003/role/footnote" xmlns="http://www.w3.org/1999/xhtml">
      <xhtml:div xmlns="http://www.w3.org/1999/xhtml">
        <xhtml:p class="MsoNoSpacing">
          <xhtml:span style="font-size: 18.0pt; font-family: 'Arial',sans-serif;">Accounts 855, 856 and 863 are debited for gas used for other operational purposes. This footnote applies to all periods within the quarter.</xhtml:span>
        </xhtml:p>
      </xhtml:div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:from="value31" xlink:to="footnote31" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" order="31" />
