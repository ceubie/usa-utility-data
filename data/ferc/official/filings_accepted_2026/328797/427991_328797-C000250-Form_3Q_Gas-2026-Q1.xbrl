    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0B74F6C20A290CE638823BCD776E62A9" xlink:to="HH69A399259BDE8D1306439BD83F368AE5" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH1868017DCB5B19F5658CA1C6F3E1A0A9" xlink:label="HH1868017DCB5B19F5658CA1C6F3E1A0A9" />
    <link:footnote xlink:type="resource" xlink:label="HH11090E90DBBA3E86EE0F159EA5877090" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">
              <strong>Schedule Page: 520 Line No.: 12 Columns: c and d</strong>
            </span>
          </span>
        </p>
        <p>
          <span style="font-weight: bold; white-space: nowrap; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">
            <span style="font-size: 12pt; font-weight: 400;">Other gas withdrawn from storage represents withdrawals of system balancing gas.</span>
          </span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH1868017DCB5B19F5658CA1C6F3E1A0A9" xlink:to="HH11090E90DBBA3E86EE0F159EA5877090" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH9EC68AA1E2DCDC7F5A07080D611DDF7D" xlink:label="HH9EC68AA1E2DCDC7F5A07080D611DDF7D" />
    <link:footnote xlink:type="resource" xlink:label="HH227C1EB20EFFC6A900EE47F4AEE3443E" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">
              <span style="font-weight: bold;">Schedule Page: 520 Line No.: 27 Columns: c and d</span>
            </span>
          </span>
        </p>
        <p>
          <span style="font-family: Arial, Helvetica, sans-serif; font-size: 12pt; white-space: nowrap;">Other gas delivered to storage represents injections of system balancing gas.</span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH9EC68AA1E2DCDC7F5A07080D611DDF7D" xlink:to="HH227C1EB20EFFC6A900EE47F4AEE3443E" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH5DC6FE57D8B1DF1488F7CD7F699634CC" xlink:label="HH5DC6FE57D8B1DF1488F7CD7F699634CC" />
    <link:footnote xlink:type="resource" xlink:label="HH8A6623ED0A3CCC77E6D24F396E95B12D" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="color: #000000; font-family: Roboto, 'Segoe UI', GeezaPro, 'DejaVu Serif', 'sans-serif', -apple-system, BlinkMacSystemFont; font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>&#8203;</strong>
            </span>
          </span>
          <span style="color: #000000; font-family: Roboto, 'Segoe UI', GeezaPro, 'DejaVu Serif', 'sans-serif', -apple-system, BlinkMacSystemFont; font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 520 Line No.: 29.1 Columns: c and d</strong>
            </span>
          </span>
        </p>
        <p>
          <img title="pepl pg 520 lin 29.1.gif" src="data:image/gif;base64," alt="" width="452" height="191" />
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH5DC6FE57D8B1DF1488F7CD7F699634CC" xlink:to="HH8A6623ED0A3CCC77E6D24F396E95B12D" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:label="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" />
    <link:footnote xlink:type="resource" xlink:label="HH616FE26807394171E3065C0FB140630A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-size: 12pt;">
            <span style="text-decoration: inherit;">
              <span style="font-family: Arial, Helvetica, sans-serif;">
                <strong>Schedule Page: 521 Line No: 7 Column: e</strong>
              </span>
            </span>
          </span>
        </p>
        <p>
          <span style="font-size: 12pt;">
            <span style="text-decoration: inherit;">
              <span style="font-family: Arial, Helvetica, sans-serif;">The allocation is derived from the throughput volume of each contract within the billing system. A path to path calculation of the rate utilized within the contract billing is determined and a percentage for recourse rate, discount rate and negotiated rate is derived based on the rate charged within the paths. This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span>
            </span>
          </span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:to="HH616FE26807394171E3065C0FB140630A" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHE42A88354FE811940E49AF98CC4875FD" xlink:label="HHE42A88354FE811940E49AF98CC4875FD" />
    <link:footnote xlink:type="resource" xlink:label="HH26C7FF959DEAFBAEBE2A1E54F4318FED" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 521 Line No.: 7 Column: f</strong>
            </span>
          </span>
        </p>
        <p>
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">The basis for valuing the gas reported in columns (f), (g), and (h) is the weighted average rate for system gas.</span>
          </span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHE42A88354FE811940E49AF98CC4875FD" xlink:to="HH26C7FF959DEAFBAEBE2A1E54F4318FED" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH22BE4ACE26AE5A4E4ED9482C5DC545FD" xlink:label="HH22BE4ACE26AE5A4E4ED9482C5DC545FD" />
    <link:footnote xlink:type="resource" xlink:label="HHFCFF5FCBABD26BFFFE712EBE335EF433" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p>
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <strong>Schedule Page: 521 Line No.: 21 Column: b</strong>
            </span>
          </span>
        </p>
        <p>
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Other Deliveries are unmetered gas losses. This footnote applies to all columns line 21 - Other Deliveries.</span>
          </span>
        </p>
        <p>&#160;</p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH22BE4ACE26AE5A4E4ED9482C5DC545FD" xlink:to="HHFCFF5FCBABD26BFFFE712EBE335EF433" order="1" />
  </link:footnoteLink>
