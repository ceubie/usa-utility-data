    <link:footnote xlink:type="resource" xlink:label="fn-10" id="fn-10" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Miscellaneous Income/(Loss) relates to excess servicing revenue from non-associate companies included in Account 458.4.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-11" id="fn-11" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Services rendered in support of corporate strategies for managing relationships with federal, state and local governments, agencies and legislative bodies. Formulate and assist with public relations, advertising, and external/internal communications programs, and with the administration of corporate contribution and community affairs programs.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-12" id="fn-12" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Services rendered in support of accounting, external affairs &amp; corporate communication, legal, human resources, business services, and information technology, electronic transmission, and computer services.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-13" id="fn-13" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Transaction services rendered including accounting, audit, business services, human resources, information technology, electronic transmission and computer services, corporate planning, customer services, external affairs &amp; corporate communication, energy marketing, executive and administrative, environmental compliance, legal, rates &amp; regulatory, risk management, operations, supply chain, tax, and treasury/finance.</span>
      </div>
    </link:footnote>
