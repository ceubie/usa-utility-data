        <link:footnote xlink:label="ft-325_47323_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-style: normal; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)">Schedule Page: 520 line No: 29.1 Column: d</b></span></span></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><img src="data:image/gif;base64," class="e-rte-image e-imginline" width="auto" height="auto" style="min-width: 0; max-width: 1265px; min-height: 0" alt="" />   <br /></p></div></link:footnote>
        <link:footnote xlink:label="ft-330_47012_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; font-family: sans-serif; font-size: medium; background-color: rgba(255, 255, 255, 1)"><b style="font-weight: bold"><em><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">Schedule Page: 313 Line No.: 2 Column: c</span></span></em></b></p><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-style: normal; font-weight: 400; text-indent: 0; white-space: normal; font-family: sans-serif; font-size: medium; background-color: rgba(255, 255, 255, 1)"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt">The volumes in column (c) include Contract Maximum Daily Quantities.</span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-375_47283_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold; color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)">Schedule Page: 521 Line No.: 7 Column: h</b><br /></p><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: bold; color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">The basis for valuing the gas reported in column (h) is the Gas Daily month average for the East Texas, North Louisiana, NGPL Texok zone.</span></b></p></div></link:footnote>
        <link:footnote xlink:label="ft-490_47282_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><b style="font-weight: 700"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">Schedule Page: 521 Line No.: 7 Column: e</span></span></span></b></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif">The allocation is derived by determining whether the reservation rate charged within the billing system is discounted, negotiated or recourse. This determination is applied to the retained fuel charged per contract scheduled path, and a pro rata is derived and applied to all volumes and dollars. <span> </span></span></span></span><span style="background-color: unset; text-align: inherit"><span style="font-size: 12pt; background-color: unset"><span style="color: rgba(0, 0, 0, 1); text-decoration: inherit"><span style="font-family: Arial, Helvetica, sans-serif; background-color: unset">This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span></span></span></span></p></div></link:footnote>
        <link:footnote xlink:label="ft-817_47181_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-weight: 700"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span><span><span>Schedule Page: 118 Line No.: 14 Column: c</span></span></span></span></span></span><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span><span><br /></span></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span><span>Fayetteville Express Pipeline LLC, as a limited liability company, records members' equity in Other Paid-In Capital.</span></span></span></span></p><p style="margin: 0 0 10px; font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif"><span><span>Statement of Retained Earnings (unaudited)</span></span></span></span></p></div></link:footnote>
