			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;4. None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;5. Not Applicable &lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:0pt; font-size:12pt"&gt;&#xD;
