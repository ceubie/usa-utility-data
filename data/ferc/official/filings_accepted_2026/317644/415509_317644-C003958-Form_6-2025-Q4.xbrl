  <link:footnoteLink xlink:type="extended" xlink:role="http://www.xbrl.org/2003/role/link">
    <link:loc xlink:type="locator" xlink:href="#HH0DB1D96ED958488DD1003D9190059479" xlink:label="HH0DB1D96ED958488DD1003D9190059479" />
    <link:footnote xlink:type="resource" xlink:label="HH3F576488ECEBABA6E39BE1A142259CB9" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p class="MsoNormal">
          <span style="mso-fareast-font-family: 'Times New Roman'; color: black;">
            <span style="color: #000000;">During the year, </span>
            <span style="color: #000000;">Bakken Pipeline Company LP</span>
            <span style="color: #000000;"> recorded a one&#8209;time credit related to FERC recoupment revenue in account 645 - unusual or infrequent items. As the credit is reported after net carrier operating income (Line Number 3) it has not been included in page 700 annual cost of service within total interstate operating revenue.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH0DB1D96ED958488DD1003D9190059479" xlink:to="HH3F576488ECEBABA6E39BE1A142259CB9" order="1" />
