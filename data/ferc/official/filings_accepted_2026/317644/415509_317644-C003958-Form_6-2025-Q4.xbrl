  <ferc:StatementAboutImportantChangesDuringTheQuarterYearTextBlock id="HHFF9F4E3640A578CDF5DE55A091A9A0F9" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&#xD;
		&lt;div&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;1. None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
			&lt;p style="margin-top:0pt; margin-bottom:8pt; font-size:12pt"&gt;&#xD;
				&lt;span style="font-family:'Times New Roman'"&gt;2. None&lt;/span&gt;&#xD;
			&lt;/p&gt;&#xD;
