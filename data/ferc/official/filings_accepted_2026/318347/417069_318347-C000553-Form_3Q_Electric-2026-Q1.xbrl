    <link:footnote xlink:type="resource" xlink:label="fn-7" id="fn-7" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The information below includes the rate order or document number, if applicable and the period of amortization for each regulatory asset listed on page 232.</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
