    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH6D09B49321ED2F9175728B9D8D482ABE" xlink:to="HH425011D6717579FB65FB4D2E6E0E69F6" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH89DF1DB347118010DFB99A082CBB3975" xlink:label="HH89DF1DB347118010DFB99A082CBB3975" />
    <link:footnote xlink:type="resource" xlink:label="HH0A0AE0E65619EF5C3B92BCB3C61C703C" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="font-size: medium; margin: 0px 0px 10px; color: #333333; font-family: Roboto;">
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">
              <strong>
                <em>
                  <span style="color: #000000; text-decoration: inherit;">Schedule Page: 278 Line No.: 1 Column: a</span>
                </em>
              </strong>
            </span>
          </span>
        </p>
        <p style="font-size: medium; margin: 0px 0px 10px; color: #333333; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="color: #000000; text-decoration: inherit;">In December 2017, the "Tax Cuts and Jobs Act" was signed into law. Among other provisions, the highest corporate federal income tax rate was reduced from 35% to 21% for taxable years beginning after December 31, 2017. Under regulatory accounting, the effect on deferred tax assets and liabilities of a change in tax rate is recognized as a regulatory asset or regulatory liability in the period that includes the enactment date. </span>
            </span>
          </span>
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="color: #000000; text-decoration: inherit;">Docket No. PL19-21-000 dated November 15, 2018. </span>
            </span>
          </span>
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">
              <span style="color: #000000; text-decoration: inherit;">The amortization period is 26 years.</span>
            </span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH89DF1DB347118010DFB99A082CBB3975" xlink:to="HH0A0AE0E65619EF5C3B92BCB3C61C703C" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHF04F102C65002CFE4128CB674BB4E283" xlink:label="HHF04F102C65002CFE4128CB674BB4E283" />
    <link:footnote xlink:type="resource" xlink:label="HH8AE8865B8451021EC97B82838D4BC1F2" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="font-size: medium; margin: 0px 0px 10px; color: #333333; font-family: Roboto;">
          <span style="font-family: Arial, Helvetica, sans-serif;">
            <span style="font-size: 12pt;">
              <strong>
                <em>Schedule Page: 278 Line No.: 2 Column: a</em>
              </strong>
            </span>
          </span>
        </p>
        <p style="font-size: medium; margin: 0px 0px 10px; color: #333333; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="font-family: Arial, Helvetica, sans-serif;">Pursuant to Section 36 of the General Terms and Conditions of Fayetteville Express Pipeline LLC's FERC Gas Tariff, First Revised Volume No. 1, Docket No. RP26-120-000, as approved by FERC's order issued on November 18, 2025, and Docket No. RP26-828-000, as approved by FERC's order issued on May 21, 2026.</span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHF04F102C65002CFE4128CB674BB4E283" xlink:to="HH8AE8865B8451021EC97B82838D4BC1F2" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:label="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" />
    <link:footnote xlink:type="resource" xlink:label="HHC5D7200035ACE37C80509E1D94BD7122" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-size: medium; margin: 0px 0px 10px; font-family: Roboto;">
          <span style="font-weight: bold;">
            <span style="font-size: 12pt;">
              <span style="text-decoration: inherit;">
                <span style="font-family: Arial, Helvetica, sans-serif;">Schedule Page: 521 Line No.: 7 Column: e</span>
              </span>
            </span>
          </span>
        </p>
        <p style="color: #000000; font-size: medium; margin: 0px 0px 10px; font-family: Roboto;">
          <span style="font-size: 12pt;">
            <span style="text-decoration: inherit;">
              <span style="font-family: Arial, Helvetica, sans-serif;">The allocation is derived by determining whether the reservation rate charged within the billing system is discounted, negotiated or recourse. This determination is applied to the retained fuel charged per contract scheduled path, and a pro rata is derived and applied to all volumes and dollars.<br /></span>
            </span>
          </span>
        </p>
        <p style="color: #000000; font-size: medium; margin: 0px 0px 10px; font-family: Roboto;">
          <span style="background-color: unset; text-align: inherit;">
            <span style="font-size: 12pt; background-color: unset;">
              <span style="text-decoration: inherit;">
                <span style="font-family: Arial, Helvetica, sans-serif; background-color: unset;">This footnote also applies to column (e), lines 14, 22, 30, 37, 51 and 65.</span>
              </span>
            </span>
          </span>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HHB70FDD91B1C2BBB59230D1D1D9D52CC3" xlink:to="HHC5D7200035ACE37C80509E1D94BD7122" order="1" />
    <link:loc xlink:type="locator" xlink:href="#HH199F890BD393249CB561B3A7C98E40EB" xlink:label="HH199F890BD393249CB561B3A7C98E40EB" />
    <link:footnote xlink:type="resource" xlink:label="HHDC25491734F8FC2618D76439D44AB34A" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <p style="color: #000000; font-size: medium; margin: 0px 0px 10px; font-family: Roboto;">
          <strong style="color: #333333; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">Schedule Page: 521 Line No.: 7 Column: h</strong>
        </p>
        <p style="color: #000000; font-size: medium; margin: 0px 0px 10px; font-family: Roboto;">
          <strong style="color: #333333; font-family: Arial, Helvetica, sans-serif; font-size: 16px;">
            <span style="font-weight: 400;">The basis for valuing the gas reported in column (h) is the Gas Daily month average for the East Texas, North Louisiana, NGPL Texok zone.</span>
          </strong>
        </p>
      </div>
    </link:footnote>
    <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="HH199F890BD393249CB561B3A7C98E40EB" xlink:to="HHDC25491734F8FC2618D76439D44AB34A" order="1" />
  </link:footnoteLink>
</xbrli:xbrl>