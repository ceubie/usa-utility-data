 style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;and&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;retained&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;earnings&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;balances.&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Common&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;stock and retained earnings approximated $46,275,382 million as of December 31, 2025.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:39.5pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:1