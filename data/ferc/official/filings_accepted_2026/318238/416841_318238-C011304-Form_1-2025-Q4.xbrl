000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;application&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;is not expected to differ materially from a lease-by-lease approach.&lt;/span&gt;&lt;/div&gt;&lt;div style="text-indent:39.55pt"&gt;&lt;span&gt;&lt;br/&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;The&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;Companies&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;have&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;finance&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:11pt;font-weight:400;line-height:112%"&gt;leases&lt;/span&gt;&lt;span style="color:#000000;font-family:'Calibri',sans-serif;font-size:12pt;font-weight:400;line-height:112%"&gt; &lt;/span&gt;&lt;span 