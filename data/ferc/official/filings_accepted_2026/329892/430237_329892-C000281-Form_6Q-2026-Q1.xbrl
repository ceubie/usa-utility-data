  <ferc:ReportDate id="f-1" contextRef="c-1">2026-06-09</ferc:ReportDate>
  <ferc:NameOfPipelineCompanyMakingReport id="f-2" contextRef="c-1">Colonial Pipeline Company</ferc:NameOfPipelineCompanyMakingReport>
  <ferc:RespondentLegalName id="f-3" contextRef="c-1">Colonial Pipeline Company</ferc:RespondentLegalName>
  <ferc:IncorporationDate id="f-4" contextRef="c-1">1961-06-08</ferc:IncorporationDate>
  <ferc:NameOfPipelineCompanyMakingReport id="f-5" contextRef="c-1">Colonial Pipeline Company</ferc:NameOfPipelineCompanyMakingReport>
  <ferc:RespondentLegalName id="f-6" contextRef="c-1">Colonial Pipeline Company</ferc:RespondentLegalName>
  <ferc:SpecialLawRespondentIncorporatedUnder id="f-7" contextRef="c-1">State of DE-Sec. 101-110-Title 8, General Corp. Law of State of DE, code of Commonwealth of VA, Title 13.1, Ch 9, VA Stock Corp. Act Charter Amendments 03-2-62; 06-28-62; 07-29-66; 04-19-71; 19-18-86</ferc:SpecialLawRespondentIncorporatedUnder>
  <ferc:NamesOfConstituentAndMergedCompanies id="f-8" contextRef="c-1">None</ferc:NamesOfConstituentAndMergedCompanies>
