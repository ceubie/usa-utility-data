    <link:footnote xlink:type="resource" xlink:label="fn-21" id="fn-21" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">As a member participant in PJM regional transmission operations, Virginia Power is invoiced for Regional Transmission Expansion Plan (RTEP) charges and receives RTEP credits.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-22" id="fn-22" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">Effective with Joining PJM on May 1, 2005, Virginia Power no longer has &#8220;Transmission System Peak Load&#8221; data</span>
      </div>
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">available.</span>
      </div>
    </link:footnote>
