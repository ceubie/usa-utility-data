 -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;date&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;which&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;financial statements were available to be issued.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.05pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;advanced&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;remaining&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;$4,500,000&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;long-term&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;debt&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;on&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;their&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;CFC&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;facility&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;loan&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;9034.&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The Cooperative has also drawn down $10,150,000 of funds on their line of credit.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 13.4pt 19.2pt 0 18pt; font-size: 14pt"&gt; 				&lt;span style="font-size: 11pt"&gt;In&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;addition,&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;the&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;Cooperative&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;has&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;executed&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;CFC&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;facility&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;loan&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;9035&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;for&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;$45,000,000,&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;which&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;was&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;available&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;to&lt;/span&gt;&lt;span style="font-size: 11pt; letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 11pt"&gt;draw funds as of March 4, 2026. The Cooperative has not drawn any funds as of report issuance date.&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 6%; font-size: 10pt"&gt; 					&lt;span style="height: 0; display: block; position: absolute; z-index: -65537"&gt;&lt;img src="data:image/png;base64," width="25" height="18" alt="" style="margin-top: -10.26pt; margin-left: 507.84pt; position: absolute" /&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 				&lt;/p&gt; 			&lt;/div&gt; 		&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
