9.35pt; margin-left: 4.9pt; margin-bottom: 0"&gt; 							&lt;span&gt;2023-2025 capital&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;credit allocation&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt; correction&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 75.9pt; border-top: 1pt solid rgba(0, 0, 0, 1); border-bottom: 1pt solid rgba(0, 0, 0, 1); vertical-align: top"&gt; 						&lt;p style="margin-top: 9.35pt; margin-right: 1.9pt; margin-bottom: 0; text-align: center"&gt; 							&lt;span style="text-decoration: underline; letter-spacing: 2.8pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: -0.5pt"&gt;$&lt;/span&gt;&lt;span style="width: 14.19pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: -0.1pt"&gt;(6,075,616)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 15.6pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 75.9pt; border-top: 1pt solid rgba(0, 0, 0, 1); border-bottom: 1pt solid rgba(0, 0, 0, 1); vertical-align: top"&gt; 						&lt;p style="margin-top: 9.35pt; margin-bottom: 0; text-align: center"&gt; 							&lt;span style="text-decoration: underline; letter-spacing: 2.75pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: -0.5pt"&gt;$&lt;/span&gt;&lt;span style="width: 59.04pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: -0.5pt"&gt;-&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: 4pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 38.75pt"&gt; 					&lt;td style="width: 340.35pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 9.65pt; margin-bottom: 0; font-size: 12pt"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 						&lt;p style="margin-top: 0.05pt; margin-left: 2.5pt; margin-bottom: 0; line-height: 13.45pt"&gt; 							&lt;span style="font-size: 12pt; font-weight: bold"&gt;Note&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold"&gt;17&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold"&gt;-&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: 3.95pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold"&gt;Regional&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold"&gt;Transmission&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: -0.1pt"&gt; Revenue&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 75.9pt; border-top: 1pt solid rgba(0, 0, 0, 1); vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 15.6pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 75.9pt; border-top: 1pt solid rgba(0, 0, 0, 1); vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 0.5pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 19.2pt 0 17.95pt"&gt; 				&lt;span&gt;As of July 1, 2017, the Cooperative entered into an agreement with Southwest Power Pool, Inc. whereby Southwest Power Pool Inc. will make available certain transmission line and transmission substations from the Cooperative. The agreement was executed for the purpose of including the leased facilities in the Open Access Transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Tariff&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Integrated&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;System.&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Payment&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;amounts&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;are&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;adjusted&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;annually&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;on&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;July&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;1st which is based on the Cooperative's qualified transmission and substation plant as of December 31, 2024. The agreement calls for the Cooperative to receive minimum monthly payments of approximately $1,488,620 and&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;$1,388,693&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;from&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Southwest&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Power&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Pool,&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Inc&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2025&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;2024.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 13.4pt 23.35pt 0 18pt"&gt; 				&lt;span&gt;Payments continue for as long as the Cooperative remains a member of Southwest Power Pool, Inc. The Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;will&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;maintain&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;ownership&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;plant&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;will&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;be&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;responsible&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;maintenance,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;repairs and taxes. Payments include reimbursements for actual maintenance costs incurred in the previous year. In 2025 and 2024, the Cooperative recognized regional transmission revenue from Southwest Power Pool and Basin Electric totaling $18,115,243 and $16,849,458, respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 6%; font-size: 10pt"&gt; 					&lt;span style="height: 0; display: block; position: absolute; z-index: -65537"&gt;&lt;img src="data:image/png;base64," width="25" height="18" alt="" style="margin-top: -10.26pt; margin-left: 507.84pt; position: absolute" /&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 				&lt;/p&gt; 			&lt;/div&gt; 		&lt;/div&gt; 		&lt;br style="page-break-before: always; clear: both" /&gt; 		&lt;div class="Section_33"&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 6%; font-size: 10pt"&gt; 					&lt;span style="height: 0; display: block; position: absolute; z-index: -65538"&gt;&lt;img src="data:image/png;base64," width="306" height="58" alt="" style="margin-top: -1.02pt; margin-left: 294.02pt; position: absolute" /&gt;&lt;/span&gt;&lt;span style="height: 0; display: block; position: absolute; z-index: -65539"&gt;&lt;img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAqQAAAACCAYAAACOnM5zAAAABHNCSVQICAgIfAhkiAAAAAlwSFlzAAAOxAAADsQBlSsOGwAAACRJREFUWIXtzkEBAAAEBLCjf2dieNgSrJJMAADgSF8HAAD4bQFJgwEDjhoKJQAAAABJRU5ErkJggg==" width="676" height="2" alt="" style="margin-top: 42.08pt; margin-left: 16.5pt; position: absolute" /&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 				&lt;/p&gt; 			&lt;/div&gt; 			&lt;p style="margin-top: 12.1pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 0.05pt; margin-left: 18pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;Note&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;18&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span style="letter-spacing: 1.3pt"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Commitments&lt;/span&gt; 			&lt;/h2&gt; 			&lt;h3 style="margin-top: 13.45pt; margin-left: 18pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span&gt;Wholesale&lt;/span&gt;&lt;span style="letter-spacing: -0.45pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Firm&lt;/span&gt;&lt;span style="letter-spacing: -0.5pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;Power&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin-top: 0.05pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 19.2pt 0 18pt"&gt; 				&lt;span&gt;Under&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;its&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;wholesale&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;power&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;agreement,&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;is&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;committed&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;purchase&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;its&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;electric&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;power&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;energy requirements from Upper Missouri G &amp;amp; T Electric Cooperative, Inc. (Upper Missouri), until December 31, 2075. The rates paid therefore are subject to review by the seller at such intervals as it deems appropriate.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 13.4pt; margin-left: 18pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span&gt;Concentration&lt;/span&gt;&lt;span style="letter-spacing: -0.5pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.45pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Sources&lt;/span&gt;&lt;span style="letter-spacing: -0.45pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.4pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;Labor&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0.05pt 19.2pt 0 18pt"&gt; 				&lt;span&gt;At December 31, 2025, the Cooperative had approximately 71.1% of its employees covered by a collective bargaining&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;agreement.&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;entered&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;into&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;new&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;collective&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;bargaining&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;agreement&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;November&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;1,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2023, which expires on October 31, 2027.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 13.4pt; margin-left: 18pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span&gt;Contingent&lt;/span&gt;&lt;span style="letter-spacing: -0.6pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Liability&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin: 13.4pt 19.2pt 0 18pt"&gt; 				&lt;span&gt;During 2021, the Cooperative provided to National Rural Utilities Cooperative Finance Corporation (CFC), a guarantee of up to $250,000 of indebtedness for the North Dakota Association of Rural Electric Cooperatives (NDAREC).&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;This&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;guarantee&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;would&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;become&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;payable&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;only&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in the&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;event&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;default&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;on&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;loan&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;by NDAREC,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;which&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;is remote. Thus, a liability is not recorded.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span style="letter-spacing: -0.1pt"&gt;Litigation&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0.05pt 19.2pt 0 18pt"&gt; 				&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;is&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;an&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;intervening&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;party&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;pending&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;lawsuit&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;brought&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;by&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;McKenzie&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Electric&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;against Basin&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Electric&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Power&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and Upper&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Missouri&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;G&amp;amp;T Electric&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative.&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;continues&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to participate in that litigation as an intervenor to ensure members continue to be provided reliable energy at competitive and stable rates.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 13.35pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;Note&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;19&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span style="letter-spacing: 1.35pt"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;FEMA&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt; Receivable&lt;/span&gt; 			&lt;/h2&gt; 			&lt;p style="margin: 13.5pt 23.35pt 0 18pt"&gt; 				&lt;span&gt;During 2022, the Cooperative experienced total costs of $21,184,030 associated with the April 2022 winter storm damage. The winter storm was declared a disaster with the incident period of April 2022 through May 2022. The cost share percentage is 75% from the federal government and 10% from the state. All outstanding receipts&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;on&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2022&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;storm&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;were&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;reimbursed&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;during&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2025.&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;During&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2025,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;additional&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;FEMA&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;grant&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;funding&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;was obligated to the Cooperative for 2024 wildfires. The receivables outstanding from FEMA amounted to $0 and&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 17.95pt; margin-bottom: 0"&gt; 				&lt;span&gt;$2,118,403&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;as&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;December&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31,&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2025&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;December&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31,&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2024,&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 6%; font-size: 10pt"&gt; 					&lt;span style="height: 0; display: block; position: absolute; z-index: -65537"&gt;&lt;img src="data:image/png;base64," width="25" height="18" alt="" style="margin-top: -10.26pt; margin-left: 507.84pt; position: absolute" /&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 				&lt;/p&gt; 			&lt;/div&gt; 		&lt;/div&gt; 		&lt;br style="page-break-before: always; clear: both" /&gt; 		&lt;div class="Section_34"&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 6%; font-size: 10pt"&gt; 					&lt;span style="height: 0; display: block; position: absolute; z-index: -65538"&gt;&lt;img src="data:image/png;base64," width="306" height="58" alt="" style="margin-top: -1.02pt; margin-left: 294.02pt; position: absolute" /&gt;&lt;/span&gt;&lt;span style="height: 0; display: block; position: absolute; z-index: -65539"&gt;&lt;img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAqQAAAACCAYAAACOnM5zAAAABHNCSVQICAgIfAhkiAAAAAlwSFlzAAAOxA