21.05pt"&gt; 					&lt;td style="width: 251.7pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 168.3pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 4.75pt; margin-right: 7.7pt; margin-bottom: 0; text-align: right"&gt; 							&lt;span style="height: 0; margin-top: -4.75pt; text-align: left; display: block; position: absolute; z-index: 21"&gt;&lt;img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAGUAAAACCAYAAABBjRItAAAABHNCSVQICAgIfAhkiAAAAAlwSFlzAAAOxAAADsQBlSsOGwAAAB9JREFUKJFjZGBg+M8wCgYT+MrIwMDgMNCuGAUo4C8AFNkDNH4Bq8UAAAAASUVORK5CYII=" width="101" height="2" alt="" style="margin-top: 20.08pt; margin-left: 84.79pt; position: absolute" /&gt;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: 2.75pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: 1.9pt"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: -0.1pt"&gt;47,551,639&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: 4pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 86.05pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 4.75pt; margin-right: 2.4pt; margin-bottom: 0; text-align: right"&gt; 							&lt;span style="height: 0; margin-top: -4.75pt; text-align: left; display: block; position: absolute; z-index: 22"&gt;&lt;img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAGUAAAACCAYAAABBjRItAAAABHNCSVQICAgIfAhkiAAAAAlwSFlzAAAOxAAADsQBlSsOGwAAAB9JREFUKJFjZGBg+M8wCgYT+MrIwMDgMNCuGAUo4C8AFNkDNH4Bq8UAAAAASUVORK5CYII=" width="101" height="2" alt="" style="margin-top: 20.08pt; margin-left: 7.83pt; position: absolute" /&gt;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: 2.75pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline"&gt;$&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: 1.9pt"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: -0.1pt"&gt;18,739,689&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: 4pt"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin: 11.2pt 17.35pt 0 18pt"&gt; 				&lt;span&gt;Customer&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;construction&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;prepayments&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;are&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;funds&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;received&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;construction&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;excess&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;completed&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;construction costs. Deferred compensation includes additions for participants total compensation. Customer energy prepayments include payments received in advance of electric billings.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 13.4pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;Note&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;8&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.5pt"&gt;-&lt;/span&gt;&lt;span style="width: 14.21pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Deferred&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Revenue&lt;/span&gt; 			&lt;/h2&gt; 			&lt;p style="margin: 13.5pt 19.2pt 0 17.95pt"&gt; 				&lt;span&gt;In 2016, the Board of Directors established a deferred revenue plan in anticipation of increasing power costs from the Cooperative's power supplier. The Cooperative plans on amortizing the deferral back into revenue in amounts&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;needed&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;meet&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative's&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;obligations,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;mortgage&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;requirements,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;maintain&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;financial&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;viability. For the years ended December 31, 2025 and 2024, the balance in the deferred revenue was $12,000,000.&lt;/span&gt;&lt;span style="letter-spacing: 2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The Cooperative plans to recognize the deferred revenue in early 2027 to offset a rate increase from the power supplier that will not be passed on to members.&lt;/span&gt; 			&lt;/p&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 6%; font-size: 10pt"&gt; 					&lt;span style="height: 0; display: block; position: absolute; z-index: -65537"&gt;&lt;img src="data:image/png;base64," width="25" height="18" alt="" style="margin-top: -10.26pt; margin-left: 507.84pt; position: absolute" /&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 				&lt;/p&gt; 			&lt;/div&gt; 		&lt;/div&gt; 		&lt;br style="page-break-before: always; clear: both" /&gt; 		&lt;div class="Section_25"&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 6%; font-size: 10pt"&gt; 					&lt;span style="height: 0; display: block; position: absolute; z-index: -65538"&gt;&lt;img src="data:image/png;base64," width="306" height="58" alt="" style="margin-top: -1.02pt; margin-left: 294.02pt; position: absolute" /&gt;&lt;/span&gt;&lt;span style="height: 0; display: block; position: absolute; z-index: -65539"&gt;&lt;img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAqQAAAACCAYAAACOnM5zAAAABHNCSVQICAgIfAhkiAAAAAlwSFlzAAAOxAAADsQBlSsOGwAAACRJREFUWIXtzkEBAAAEBLCjf2dieNgSrJJMAADgSF8HAAD4bQFJgwEDjhoKJQAAAABJRU5ErkJggg==" width="676" height="2" alt="" style="margin-top: 42.08pt; margin-left: 16.5pt; position: absolute" /&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 				&lt;/p&gt; 			&lt;/div&gt; 			&lt;p style="margin-top: 12.1pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h2 style="margin-top: 0.05pt; margin-left: 18pt; margin-bottom: 0; font-size: 12pt"&gt; 				&lt;span&gt;Note&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;9&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.5pt"&gt;-&lt;/span&gt;&lt;span style="width: 14.21pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Plant&lt;/span&gt;&lt;span style="letter-spacing: -0.45pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Retirement&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Reserve&lt;/span&gt; 			&lt;/h2&gt; 			&lt;p style="margin-top: 13.45pt; margin-left: 18pt; margin-bottom: 0"&gt; 				&lt;span&gt;From&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2005&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;through&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2025,&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;has&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;received&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;contribution&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;aid&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;construction&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;funds&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;totaling&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;over&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0.05pt 23.35pt 0 17.95pt"&gt; 				&lt;span&gt;$551 million to build electric plant. Under ASC 980, the Cooperative properly netted the contributions received against the cost to build the plant and did not depreciate the plant over its useful life. The Cooperative is responsible&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;retirement&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;this&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;plant&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;upon&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;termination.&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;During&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2014,&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;began&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;reserve&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for plant retirement to accrue for this eventual plant retirement. The Cooperative has estimated a cumulative cost to retire the contribution in aid of construction plant and will accrue the cost over the remaining estimated service life of the plant. The Cooperative accrued $3,100,523 and $2,665,377 during 2025 and 2024, respectively. The cumulative balance of the plant retirement reserve is $30,905,150 and $27,804,627 as of December 31, 2025 and 2024, respectively.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 4.8pt; margin-bottom: 0; font-size: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;table cellspacing="0" cellpadding="0" style="margin-left: 15.85pt; border-collapse: collapse"&gt; 				&lt;tr style="height: 19.25pt"&gt; 					&lt;td style="width: 339.35pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-left: 2.5pt; margin-bottom: 0; line-height: 12.2pt"&gt; 							&lt;span style="font-size: 12pt; font-weight: bold"&gt;Note&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold"&gt;10&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold"&gt;-&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: 1.35pt"&gt;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold"&gt;Cash&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold"&gt;and&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold"&gt;Cash&lt;/span&gt;&lt;span style="font-size: 12pt; font-weight: bold; letter-spacing: -0.1pt"&gt; Equivalents&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="3" style="width: 166.85pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 24.75pt"&gt; 					&lt;td style="width: 339.35pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span style="font-family: &amp;quot;Times New Roman&amp;quot;"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 75.65pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 5.05pt; margin-bottom: 0; text-align: right"&gt; 							&lt;span style="width: 26.95pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-decoration: underline; letter-spacing: -0.2pt"&gt;2025&lt;/span&gt;&lt;span style="width: 26.4pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td colspan="2" style="width: 91.2pt; vertical-align: top"&gt; 						&lt;p style="margin-top: 5.05pt; margin-left: 15.5pt; margin-bottom: 0"&gt; 							&lt;span style="width: 26.95pt; font-family: &amp;quot;Lucida Console&amp;quot;; text-decoration: underline; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span style="text-de