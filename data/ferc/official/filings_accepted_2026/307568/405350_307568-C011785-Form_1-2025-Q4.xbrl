 19.2pt 0 18pt; text-indent: -0.05pt"&gt; 				&lt;span&gt;Investments in associated companies and other investments include investments in other cooperatives and other&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;investments.&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;has&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;determined&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;that&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;these&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;investments&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;do&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;not&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;have&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;readily&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;determinable fair value and records these investments at the Cooperative's share of allocated patronage capital. These investments are assessed for impairment, if any, and adjusted for changes resulting from observable price changes&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;orderly&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;transactions&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;identical&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;or&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;similar&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;investment&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;same&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;issuer.&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;has not identified any impairments and there has not been observable price changes during the years ended December 31, 2025 and 2024.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 19.2pt 0 17.95pt"&gt; 				&lt;span&gt;Capital Term certificates are a condition of loans from the National Rural Utilities Cooperative Finance Corporation,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;which&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;is&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;believed&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;by&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;management&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;have&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;strong&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;credit&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;quality.&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Capital&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;term&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;certificates&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;are&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;debt securities and are accounted for at amortized cost, net of any impairment or allowances for credit losses. The allowance for credit losses is influenced by a variety of factors, including credit quality and general economic conditions. At December 31, 2025 and 2024, the allowance for credit losses were $0.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 0; margin-left: 17.95pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span&gt;Material&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Supplies&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 17.95pt; margin-bottom: 0"&gt; 				&lt;span&gt;Material&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;supplies&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;are&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;stated&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;at&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;lower&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;average&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;cost&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;or&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;net&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;realizable&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;value.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 0; margin-left: 17.95pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span&gt;Cash&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cash&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Equivalents&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0.05pt; margin-left: 17.95pt; margin-bottom: 0"&gt; 				&lt;span&gt;For&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;purposes&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;reporting&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;cash&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;flows,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;considers&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;all&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;highly&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;liquid&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;investments&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;purchased&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;with&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a maturity of three months or less to be cash equivalents.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 13.4pt; margin-left: 17.95pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span&gt;Temporary&lt;/span&gt;&lt;span style="letter-spacing: -0.55pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cash&lt;/span&gt;&lt;span style="letter-spacing: -0.5pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Investments&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin: 13.4pt 49.45pt 0 17.95pt"&gt; 				&lt;span&gt;Temporary&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;cash&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;investments&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;include&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;all&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;highly&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;liquid&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;investments&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;purchased&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;with&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;remaining&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;maturity&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of greater than 90 days, but no more than twelve months as of the balance sheet date.&lt;/span&gt; 			&lt;/p&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 6%; font-size: 10pt"&gt; 					&lt;span style="height: 0; display: block; position: absolute; z-index: -65540"&gt;&lt;img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABkAAAASCAYAAACuLnWgAAAABHNCSVQICAgIfAhkiAAAAAlwSFlzAAAOxAAADsQBlSsOGwAAAFJJREFUOI1jYBgFQwHoMDAw/MeByQIsWMSuMDAwMKKJlZBrAbFAlAHiCx1aWlLCwMAwkZYW0MUX0QwMDFtoaQEDA8QXzrS0gG6+iKa1JaNgGAMAv0cPszSzNl0AAAAASUVORK5CYII=" width="25" height="18" alt="" style="margin-top: -10.26pt; margin-left: 507.84pt; position: absolute" /&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 				&lt;/p&gt; 			&lt;/div&gt; 		&lt;/div&gt; 		&lt;br style="page-break-before: always; clear: both" /&gt; 		&lt;div class="Section_16"&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 6%; font-size: 10pt"&gt; 					&lt;span style="height: 0; display: block; position: absolute; z-index: -65541"&gt;&lt;img src="data:image/png;base64," width="306" height="22" alt="" style="margin-top: -1.02pt; margin-left: 294.02pt; position: absolute" /&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 				&lt;/p&gt; 			&lt;/div&gt; 			&lt;p style="margin: 0.25pt 17.85pt 0 390.45pt; text-indent: -2.35pt; text-align: right"&gt; 				&lt;img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAqQAAAACCAYAAACOnM5zAAAABHNCSVQICAgIfAhkiAAAAAlwSFlzAAAOxAAADsQBlSsOGwAAACRJREFUWIXtzkEBAAAEBLCjf2dieNgSrJJMAADgSF8HAAD4bQFJgwEDjhoKJQAAAABJRU5ErkJggg==" width="676" height="2" alt="" /&gt;&lt;br /&gt;&lt;span&gt;Notes&lt;/span&gt;&lt;span style="letter-spacing: -0.65pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.6pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Financial&lt;/span&gt;&lt;span style="letter-spacing: -0.6pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Statements December&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;31,&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;2025&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.25pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;2024&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 13.4pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span&gt;Restricted&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cash&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;-&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Special&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Funds&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0.05pt 56.7pt 0 18pt"&gt; 				&lt;span&gt;Amounts&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;included&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;restricted&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;cash&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;represent&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;funds&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;held&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative's&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;approved&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;deferred compensation plan.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 13.4pt; margin-left: 18pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span style="letter-spacing: -0.1pt"&gt;Deferred&lt;/span&gt;&lt;span style="letter-spacing: 0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Debits&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 19.2pt 0 18pt"&gt; 				&lt;span&gt;Deferred&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;debits&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;consist&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;unrecovered&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;plant&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;costs&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;loss&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;on&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;early&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;extinguishment&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;long-term&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;debt.&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Other deferred debits are amortized over the period in which the related revenues are generated. See Note 6 for further detail of deferred debits.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span style="letter-spacing: -0.1pt"&gt;Patronage&lt;/span&gt;&lt;span style="letter-spacing: 0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Capital&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0.05pt 23.35pt 0 18pt"&gt; 				&lt;span&gt;The Cooperative operates on a nonprofit basis. Amounts received from the furnishing of electric energy in excess of operating costs and expenses are assigned to patrons on a patronage basis. Currently, amounts received&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;from&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Generation&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;(G&amp;amp;T)&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;other&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;patronage&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;capital&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;are&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;allocated&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;membership&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to the extent that they are not needed to offset current and prior losses.&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 13.4pt; margin-left: 18pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span&gt;Participation&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.4pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;a&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Regional&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.35pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Organization&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin: 13.4pt 19.2pt 0 18pt"&gt; 				&lt;span&gt;The Cooperative has qualified facilities within the footprint of the Southwest Power Pool (SPP), a Regional Transmission Organization (RTO). An RTO is an independent, not-for-profit, member-based organization responsible&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;electric&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;transmission&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;system&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;operations,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;energy&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;markets,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;system&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;reliability,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;coordinated&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;system planning, and transmission services within a multi-state region. RTOs do not own any power grid facilities, but independently operate the system to ensure reliable, least cost delivery of electricity to consumers.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 19.2pt 0 18pt"&gt; 				&lt;span&gt;The Cooperative is a transmission owner member in SPP. Revenues from SPP are initially recorded based on projected&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;costs&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;associated&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;with&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;qualifying&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;plant&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;assets.&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;An&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;annual&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;true-up&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;for&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;revenue&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;will&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;be&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;recognized&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;based on actual costs.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;h3 style="margin-top: 0; margin-left: 18pt; margin-bottom: 0; font-size: 11pt"&gt; 				&lt;span&gt;Revenue&lt;/span&gt;&lt;span style="letter-spacing: -0.45pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Recognition&lt;/span&gt;&lt;span style="letter-spacing: -0.45pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.4pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Unbilled&lt;/span&gt;&lt;span style="letter-spacing: -0.4pt"&gt;&amp;#160;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;Revenues&lt;/span&gt; 			&lt;/h3&gt; 			&lt;p style="margin-top: 0.05pt; margin-bottom: 0"&gt; 				&lt;span style="font-weight: bold"&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 19.2pt 0 18pt"&gt; 				&lt;span&gt;The Cooperative's performance obligation related to the sale of energy is satisfied as energy is delivered to customers;&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;therefore,&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;revenue&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;from&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;delivery&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;energy&lt;/span&gt;&lt;span style="letter-spacing: -0.3pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;is&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;recognized&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;over&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;time&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;as&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;energy&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;is&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;delivered&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the customers.&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;reads&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;customer&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;meters and&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;bills customers&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;each month&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;based.&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Accordingly,&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;at the end of each month, there is energy delivered to customers for which customers have not been billed. The Cooperative records an estimate of the unbilled revenues each month.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 31.35pt 0 18pt; text-align: justify"&gt; 				&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative's&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;performance&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;obligation&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;related&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;merchandising&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;and&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;electrical&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;services&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;are&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;satisfied&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;at&lt;/span&gt;&lt;span style="letter-spacing: -0.05pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the point&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;in&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;time&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;when&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;projects&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;have&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;been&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;completed;&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;therefore,&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;revenue&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;is&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;recorded&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;upon&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;completion&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;of&lt;/span&gt;&lt;span style="letter-spacing: -0.2pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;the &lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;service.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin: 0 19.2pt 0 18pt"&gt; 				&lt;span&gt;The&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;Cooperative&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;does&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;not&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;have&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;any&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;significant&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;financing&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;components&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;related&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;to&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;contracts&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;with&lt;/span&gt;&lt;span style="letter-spacing: -0.15pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;customers&lt;/span&gt;&lt;span style="letter-spacing: -0.1pt"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;as payment is received shortly after being billed to customers.&lt;/span&gt; 			&lt;/p&gt; 			&lt;div style="clear: both"&gt; 				&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 6%; font-size: 10pt"&gt; 					&lt;span style="height: 0; display: block; position: absolute; z-index: -65540"&gt;&lt;img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAABkAAAASCAYAAACuLnWgAAAABHNCSVQICAgIfAhkiAAAAAlwSFlzAAAOxAAADsQBlSsOGwAAAFJJREFUOI1jYBgFQwHoMDAw/MeByQIsWMSuMDAwMKKJlZBrAbFAlAHiC