    <ferc:NotesToFinancialStatementsTextBlock id="f-464" contextRef="c-08">&lt;div&gt;&lt;div class="Section_1"&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -14pt"&gt; 				&lt;span&gt;&lt;span&gt;1.&lt;/span&gt;&lt;span style="width: 5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;N/A&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -14pt"&gt; 				&lt;span&gt;&lt;span&gt;2.&lt;/span&gt;&lt;span style="width: 5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;N/A&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -14pt"&gt; 				&lt;span&gt;&lt;span&gt;3.&lt;/span&gt;&lt;span style="width: 5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span&gt;A.&lt;/span&gt;&lt;span style="width: 6.33pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;The company recognized net periodic costs as follows:&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 72pt; margin-bottom: 0; text-indent: -14pt"&gt; 				&lt;span&gt;&lt;span&gt;1.&lt;/span&gt;&lt;span style="width: 5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;Pension Cost ($302,999)&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 72pt; margin-bottom: 12pt; text-indent: -14pt"&gt; 				&lt;span&gt;&lt;span&gt;2.&lt;/span&gt;&lt;span style="width: 5pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;Postretirement Benefits $219,000&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span&gt;B.&lt;/span&gt;&lt;span style="width: 7pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;Fair Value of Pension Plan Assets at Year-End $12,706,092&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0"&gt; 				&lt;span&gt;Projected Pension Benefit Obligation $9,333,146&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0"&gt; 				&lt;span&gt;Projected Postretirement Obligation $7,027,000&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 54pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span&gt;4.&lt;/span&gt;&lt;span style="width: 9pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;N/A&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span&gt;5.&lt;/span&gt;&lt;span style="width: 9pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;The company applies a more-likely-than-not recognition threshold for all tax uncertainties. The Company only recognizes tax benefits that have a greater than 50% likelihood of being sustained upon examination by the taxing authorities. Based on its evaluation, the Company has concluded there are no significant uncertain tax positions requiring recognition in its financial statements. The company provides for deferred taxes on temporary differences between amounts reported for financial and income tax purposes. Such differences relate principally to depreciation, pension, and post-retirement expense.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-left: 36pt; margin-bottom: 0; text-indent: -18pt"&gt; 				&lt;span&gt;&lt;span&gt;6.&lt;/span&gt;&lt;span style="width: 9pt; font: 7pt &amp;quot;Times New Roman&amp;quot;; display: inline-block"&gt;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;/span&gt;&lt;span&gt;N/A&lt;/span&gt; 			&lt;/p&gt; 		&lt;/div&gt;&lt;/div&gt;</ferc:NotesToFinancialStatementsTextBlock>
