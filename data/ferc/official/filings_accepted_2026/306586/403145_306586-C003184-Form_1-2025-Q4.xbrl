          </tr>
          <tr>
            <td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:top">
              <div>
                <span style="color:#000000;font-family:'Arial Narrow',sans-serif;font-size:9pt;font-weight:700;line-height:112%">Type</span>
              </div>
            </td>
            <td colspan="3" style="background-color:#cceeff;padding:0 1pt"/>
            <td colspan="3" style="background-color:#cceeff;padding:2px 1pt;text-align:left;vertical-align:top">
