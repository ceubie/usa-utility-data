    <link:footnote xlink:type="resource" xlink:label="fn-11" id="fn-11" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:9pt;font-weight:400;line-height:120%">The depreciable plant base is the November 30, 2025 total company depreciable plant.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-12" id="fn-12" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The Rockport Plant is a two unit coal fired generating facility. Units 1 and 2 are jointly owned by the Respondent and Indiana Michigan Power Company. Column (b) represents Respondent's 50% share of Unit 1 and column (c) represents Respondent's 50% share of Unit 2. Column (d) represents Respondent's total share of Rockport Plant and column (e) represents Total Rockport Plant owned by Respondent and Indiana Michigan Power Company.</span>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-13" id="fn-13" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
      <div xmlns="http://www.w3.org/1999/xhtml">
        <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">The Rockport Plant is owned 50% by I&amp;M and 50% by AEG. I&amp;M is the operator of the plant and most charges originate on I&amp;M's general ledger. A joint books process then allocates 50% of those charges to AEG</span>
        <span style="color:#000000;font-family:'Courier New',serif;font-size:10pt;font-weight:400;line-height:120%">.</span>
      </div>
    </link:footnote>
