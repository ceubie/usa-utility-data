        <link:loc xlink:href="#f-923" xlink:label="f-923_lbl" xlink:type="locator" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-428_lbl" order="0" xlink:to="ft-428_46908_lbl" />
        <link:footnoteArc xlink:type="arc" xlink:arcrole="http://www.xbrl.org/2003/arcrole/fact-footnote" xlink:from="f-923_lbl" order="0" xlink:to="ft-923_47411_lbl" />
        <link:footnote xlink:label="ft-428_46908_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><p style="text-align: left"><span style="color: rgba(51, 51, 51, 1); font-family: Arial, Helvetica, sans-serif; font-size: 12pt; font-style: normal; font-weight: 400; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1); float: none; display: inline !important">Cash management program with Energy Transfer LP.</span><br /></p></link:footnote>
        <link:footnote xlink:label="ft-923_47411_lbl" xlink:role="http://www.xbrl.org/2003/role/footnote" xml:lang="en-US" xlink:type="resource" xmlns="http://www.w3.org/1999/xhtml"><div><p style="margin: 0 0 10px; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-family: Arial, Helvetica, sans-serif"><span style="font-size: 12pt"><b style="font-weight: bold; color: rgba(0, 0, 0, 1); font-style: normal; text-align: left; text-indent: 0; white-space: normal; background-color: rgba(255, 255, 255, 1)">Schedule Page 700 Line No.: 9 Column: b</b></span></span></p><p style="margin: 0; color: rgba(0, 0, 0, 1); font-family: Roboto"><span style="font-size: 12pt"><span style="font-family: Arial, Helvetica, sans-serif">The cost of service results were calculated using the Cost of Service Model. This model calculates cost of service using the Trended Original Cost methodology promulgated by the FERC in Opinion No. 154-B, 31 FERC 61,377 (1985), as modified and clarified by subsequent rulings.</span></span></p></div></link:footnote>
