&lt;td style="width: 97.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;ZEC&lt;/span&gt;&lt;/p&gt;
