&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 97.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;ATSI&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 349.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;American Transmission Systems, Incorporated, a wholly owned transmission subsidiary of FET&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 97.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;Brookfield&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 349.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;North American Transmission Company II L.P., a controlled investment vehicle entity of Brookfield Super-Core Infrastructure Partners&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 97.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;Brookfield Guarantors&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 349.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;Brookfield Super-Core Infrastructure Partners L.P., Brookfield Super-Core Infrastructure Partners (NUS) L.P., and Brookfield Super-Core Infrastructure Partners (ER) SCSp&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;/tr&gt;
&lt;tr&gt;
&lt;td style="width: 97.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;CEI&lt;/span&gt;&lt;/p&gt;
