&lt;p style="margin-top: 0pt; margin-bottom: 0pt; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;&amp;#160;&lt;/span&gt;&lt;/p&gt;
&lt;/td&gt;
&lt;td style="width: 349.2pt; padding-right: 5.4pt; padding-left: 5.4pt; vertical-align: top;"&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; font-size: 8pt;"&gt;&lt;span style="font-family: Arial;"&gt;Zero Emission Certificate&lt;/span&gt;&lt;/p&gt;
