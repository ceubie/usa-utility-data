  <ferc:NotesToFinancialStatementsTextBlock id="HHFB845F6A13C048AB10E053139FD9FDD6" contextRef="HH6F430EA68AFC29D1DD829B0DDD45FFF4">&lt;div&gt;&lt;div&gt;
&lt;p style="margin-top: 0pt; margin-bottom: 0pt; text-align: justify; line-height: 120%; font-size: 9pt;"&gt;&lt;span style="font-family: Arial; font-weight: bold;"&gt;GLOSSARY OF TERMS&lt;/span&gt;&lt;/p&gt;
&lt;p style="margin-top: 10pt; margin-bottom: 0pt; text-align: justify; line-height: 120%; font-size: 9pt;"&gt;&lt;span style="font-family: Arial;"&gt;The following abbreviations and acronyms may be used in these financial statements to identify The Potomac Edison Company and its current and former affiliated companies:&lt;/span&gt;&lt;/p&gt;
