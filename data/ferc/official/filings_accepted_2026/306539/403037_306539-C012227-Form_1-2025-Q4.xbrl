            <td style="width:0.1%"/>
          </tr>
          <tr>
            <td colspan="3" style="padding:2px 1pt;text-align:left;vertical-align:bottom">
              <span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%">In December 2024, NEET MA repaid $26.5M on the loan from NextEra Energy Capital Holdings, Inc.</span>
            </td>
          </tr>
        </table>
      </div>
    </link:footnote>
    <link:footnote xlink:type="resource" xlink:label="fn-16" id="fn-16" xml:lang="en" xlink:role="http://www.xbrl.org/2003/role/footnote">
