  <ferc:ControlOverRespondentTextBlock id="f-17" contextRef="c-1">&lt;span style="color:#000000;font-family:'Arial',sans-serif;font-size:10pt;font-weight:400;line-height:120%"&gt;FRP Tupelo Solar, LLC, a Delaware limited liability company, is an indirect subsidiary of NextEra Energy Resources, LLC ("NEER"). NEER is a wholly-owned subsidiary of NextEra Energy Capital Holdings, Inc. ("Capital Holdings"), which is a wholly-owned subsidiary of NextEra Energy, Inc., a company listed on the New York Stock Exchange.&lt;br/&gt;&lt;/span&gt;</ferc:ControlOverRespondentTextBlock>
