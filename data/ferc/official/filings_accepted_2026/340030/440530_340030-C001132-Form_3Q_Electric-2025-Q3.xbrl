border-top: 3pt double rgba(0, 0, 0, 1); vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 15pt; vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 93pt; border-top: 3pt double rgba(0, 0, 0, 1); vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 15.75pt; page-break-inside: avoid"&gt; 					&lt;td style="width: 261.7pt; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: bottom; background-color: rgba(219, 219, 219, 1)"&gt; 						&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; page-break-after: avoid; font-size: 10pt"&gt; 							&lt;span&gt;&amp;#160;&amp;#160;&amp;#160;&lt;/span&gt;&lt;span&gt;Income taxes&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 92.25pt; padding-right: 0.75pt; vertical-align: bottom; background-color: rgba(219, 219, 219, 1)"&gt; 						&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; text-align: right; page-break-after: avoid; font-size: 10pt"&gt; 							&lt;span&gt;$&lt;/span&gt;&lt;span style="width: 32.05pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;(13,898,116)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 15pt; vertical-align: bottom; background-color: rgba(219, 219, 219, 1)"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt