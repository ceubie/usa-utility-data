 font-size: 10pt"&gt; 							&lt;span style="width: 63.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;--&lt;/span&gt;&lt;span style="width: 3.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 5.25pt; vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 59.25pt; padding-right: 0.75pt; vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; text-align: right; page-break-after: avoid; font-size: 10pt"&gt; 							&lt;span style="width: 39.05pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;(52)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 5.25pt; vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 59.25pt; padding-right: 0.75pt; vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; text-align: right; page-break-after: avoid; font-size: 10pt"&gt; 							&lt;span style="width: 39.05pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;(52)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 15pt; page-break-inside: avoid"&gt; 					&lt;td style="width: 125.2pt; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: bottom; background-color: rgba(239, 239, 239, 1)"&gt; 						&lt;p style="margin-top: 2.65pt; margin-left: 11.25pt; margin-bottom: 1.5pt; font-size: 10pt"&gt; 							&lt;span&gt;Net income&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				