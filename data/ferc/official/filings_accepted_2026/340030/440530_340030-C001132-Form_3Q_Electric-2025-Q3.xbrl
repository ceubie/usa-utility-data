 68.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;16,406&lt;/span&gt;&lt;span style="width: 3.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 9.75pt; vertical-align: bottom; background-color: rgba(239, 239, 239, 1)"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 95.25pt; border-top: 1pt solid rgba(0, 0, 0, 1); padding-right: 0.75pt; vertical-align: bottom; background-color: rgba(239, 239, 239, 1)"&gt; 						&lt;p style="margin-top: 1.65pt; margin-bottom: 1.5pt; text-align: right; page-break-after: avoid; font-size: 10pt"&gt; 							&lt;span style="width: 61.85pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;15,682&lt;/span&gt;&lt;span style="width: 3.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 23.25pt; page-break-inside: avoid"&gt; 					&lt;td style="width: 227.95pt; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; page-break-after: avoid; font-size: 10pt"&gt; 							&lt;span&gt;Less: Accumulated Provision for Depreciation, Amortization, and Depletion&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 102pt; border-bottom: 1pt solid rgba(0, 0, 0, 1); padding-right: 0.75pt; vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; text-align: right; page-break-after: avoid; font-size: 10pt"&gt; 							&lt;span style="width: 69.3pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;(6,514)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 9.75pt; vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0; page-break-after: avoid"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 95.25pt; border-bottom: 1pt solid rgba(0, 0, 0, 1); padding-right: 0.75pt; vertical-align: bottom; background-color: rgba(255, 255, 255, 1)"&gt; 						&lt;p style="margin-top: 2.65pt; margin-bottom: 1.5pt; text-align: right; page-break-after: avoid; font-size: 10pt"&gt; 							&lt;span style="width: 62.55pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;(6,196)&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 				&lt;tr style="height: 15pt; page-break-inside: avoid"&gt; 					&lt;td style="width: 227.95pt; padding-right: 2.65pt; padding-left: 2.65pt; vertical-align: bottom; background-color: rgba(239, 239, 239, 1)"&gt; 						&lt;p style="margin-top: 1.65pt; margin-left: 11.25pt; margin-bottom: 1.5pt; font-size: 10pt"&gt; 							&lt;span&gt;Net Utility Plant&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 102pt; border-top: 1pt solid rgba(0, 0, 0, 1); border-bottom: 3pt double rgba(0, 0, 0, 1); padding-right: 0.75pt; vertical-align: bottom; background-color: rgba(239, 239, 239, 1)"&gt; 						&lt;p style="margin-top: 1.65pt; margin-bottom: 1.5pt; text-align: right; font-size: 10pt"&gt; 							&lt;span&gt;$&lt;/span&gt;&lt;span style="width: 68.6pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;9,892&lt;/span&gt;&lt;span style="width: 3.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 9.75pt; vertical-align: bottom; background-color: rgba(239, 239, 239, 1)"&gt; 						&lt;p style="margin-top: 0; margin-bottom: 0"&gt; 							&lt;span&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 					&lt;td style="width: 95.25pt; border-top: 1pt solid rgba(0, 0, 0, 1); border-bottom: 3pt double rgba(0, 0, 0, 1); padding-right: 0.75pt; vertical-align: bottom; background-color: rgba(239, 239, 239, 1)"&gt; 						&lt;p style="margin-top: 1.65pt; margin-bottom: 1.5pt; text-align: right; font-size: 10pt"&gt; 							&lt;span&gt;$&lt;/span&gt;&lt;span style="width: 61.85pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;9,486&lt;/span&gt;&lt;span style="width: 3.25pt; display: inline-block"&gt;&amp;#160;&lt;/span&gt; 						&lt;/p&gt; 					&lt;/td&gt; 				&lt;/tr&gt; 			&lt;/table&gt; 			&lt;p style="margin-top: 1pt; margin-bottom: 1pt; text-align: center; line-height: 120%; font-size: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 1pt; line-height: 120%; font-size: 10pt"&gt; 				&lt;span&gt;Accumulated Provision for Depreciation, Amortization, and Depletion in the table above includes accumulated amortization related to intangible assets of $667 million and $611 million as of September 30, 2025 and December 31, 2024, respectively. Amortization expense related to intangible assets was $19&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;million for both the three months ended September 30, 2025 and 2024, and $57&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;million and $55&lt;/span&gt;&lt;span&gt;&amp;#160;&lt;/span&gt;&lt;span&gt;million for the nine months ended September 30, 2025 and 2024, respectively. The Company's intangible assets primarily consist of computer software development and hydro licensing costs.&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 120%; font-size: 10pt"&gt; 				&lt;span&gt;&amp;#160;&lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; line-height: 120%; font-size: 10pt"&gt; 				&lt;span style="font-weight: bold"&gt;Other Regulatory Assets and Liabilities &lt;/span&gt; 			&lt;/p&gt; 			&lt;p style="margin-top: 0; margin-bottom: 0; page-break-inside: avoid; line-height: 120%; widows: 0; orphans: 0; font-size: 10pt