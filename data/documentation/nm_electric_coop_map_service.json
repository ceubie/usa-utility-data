uropean)&quot;, &quot;Segoe UI&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; margin-top:0px; margin-bottom:0px;'>\u2002\u2002\u2002\u2002\u2002\u2002\u2022\u2002\u2002\u2002\u2002\u2002Northern Río Arriba Electric<\/p><p style='color:rgb(66, 66, 66); font-family:&quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, &quot;Segoe UI&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; margin-top:0px; margin-bottom:0px;'>\u2002\u2002\u2002\u2002\u2002\u2002\u2022\u2002\u2002\u2002\u2002\u2002Otero County Electric<\/p><p style='color:rgb(66, 66, 66); font-family:&quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, &quot;Segoe UI&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; margin-top:0px; margin-bottom:0px;'>\u2002\u2002\u2002\u2002\u2002\u2002\u2022\u2002\u2002\u2002\u2002\u2002Roosevelt County Electric<\/p><p style='color:rgb(66, 66, 66); font-family:&quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, &quot;Segoe UI&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; margin-top:0px; margin-bottom:0px;'>\u2002\u2002\u2002\u2002\u2002\u2002\u2022\u2002\u2002\u2002\u2002\u2002Southwestern Electric<\/p><p style='color:rgb(66, 66, 66); font-family:&quot;Segoe UI&quot;, &quot;Segoe UI Web (West European)&quot;, &quot;Segoe UI&quot;, -apple-system, BlinkMacSystemFont, Roboto, &quot;Helvetica Neue&quot;, sans-serif; margin-top:0px; margin-bottom:0px;'>\u2002\u2002\u2002\u2002\u2002\u2002\u2022\u2002\u2002\u2002\u2002\u2002Springer Electric<\/p><\/div>",
